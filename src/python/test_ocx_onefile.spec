# -*- mode: python ; coding: utf-8 -*-

# onefile fallback build (single exe, no _internal folder).
# Main build is test_ocx.spec (onedir). Use this one only when _internal modules are broken.
# Deploy next to the onedir exe in <home>\exe\ under a different name.

a = Analysis(
    ['test_ocx.py'],
    pathex=[],
    binaries=[],
    datas=[],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='IBKs_openAPI_python_onefile',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    uac_admin=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
