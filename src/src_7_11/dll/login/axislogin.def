; axislogin.def : Declares the module parameters for the DLL.

LIBRARY      "axislogin"
DESCRIPTION  'axislogin Windows Dynamic Link Library'

EXPORTS
    ; Explicit exports can go here
	axLogin
	axLoginLedger
	axLedger
	axGetLedger
	axSetLedger
	axGetLedgerEx
	axGetLedgerData
	axLoginData	
	
	DllCanUnloadNow PRIVATE
	DllGetClassObject PRIVATE
	DllRegisterServer PRIVATE
