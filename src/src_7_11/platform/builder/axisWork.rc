/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "New..."
        BEGIN
            MENUITEM "Map",                         ID_APP_NEW
            MENUITEM "Template",                    ID_APP_NEWTMPL
            MENUITEM "Procedures",                  ID_APP_NEWSC
        END
        MENUITEM "&Open...\tCtrl+O",            ID_APP_OPENPC
        MENUITEM "&Close",                      ID_APP_MAPCLOSE
        MENUITEM SEPARATOR
        MENUITEM "&Save\tCtrl+S",               ID_APP_SAVEPC
        MENUITEM "Save &As...",                 ID_APP_SAVEPATH
        MENUITEM "Save to Server\tCtrl+R",      ID_APP_SAVESERVER
        MENUITEM SEPARATOR
        POPUP "Convert..."
        BEGIN
            MENUITEM "2.0 �� 3.0",                  ID_CONVERT_30
        END
        MENUITEM "Settings...",                 ID_APP_SETTING
        MENUITEM SEPARATOR
        MENUITEM "Save Position",               ID_APP_SAVETOOLBAR
        MENUITEM "Default Position",            ID_APP_DEFAULTTOOLBAR
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Undo\tCtrl+Z",                ID_EDIT_MAPUNDO
        MENUITEM "Redo\tCtrl+Y",                ID_EDIT_MAPREDO
        MENUITEM SEPARATOR
        MENUITEM "Cut\tCtrl+X",                 ID_APP_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_APP_COPY
        MENUITEM "Paste\tCtrl+V",               ID_APP_PASTE
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",            ID_EDIT_FIND
        MENUITEM "Replace...\tCtrl+H",          ID_EDIT_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "Tab Order",                   ID_EDIT_TABORDER
        MENUITEM "I/O Order",                   ID_EDIT_IOORDER
        MENUITEM SEPARATOR
        MENUITEM "Edit I/O Order\tCtrl+E",      ID_APP_ORDER
        MENUITEM "Edit Tab Order",              ID_APP_EDITTABORDER
        MENUITEM SEPARATOR
        MENUITEM "Go To...\tCtrl+G",            ID_EDIT_GOTO
    END
    POPUP "&View"
    BEGIN
        POPUP "Toolbars..."
        BEGIN
            MENUITEM "Standard",                    ID_VIEW_MAINBAR
            MENUITEM "Draw",                        ID_VIEW_DRAWBAR
            MENUITEM "Align",                       ID_VIEW_ALIGNBAR
            MENUITEM "Addition",                    ID_VIEW_EXBAR
        END
        MENUITEM SEPARATOR
        MENUITEM "Workspace\tF4",               ID_VIEW_WORKSPACE
        MENUITEM "Properties\tF5",              ID_VIEW_PROPERTIES
        MENUITEM "Script\tF6",                  ID_EDIT_SCRIPT
        MENUITEM "Trace\tF8",                   ID_VIEW_DEBUG
        MENUITEM "Preview",                     ID_VIEW_RUN
        MENUITEM "Selection",                   ID_VIEW_SELECTIONBAR
        MENUITEM "Window Tab",                  ID_VIEW_WNDTAB
        MENUITEM SEPARATOR
        MENUITEM "Reload...",                   ID_APP_RELOAD
        MENUITEM "Show Hidden Form",            ID_HIDE_FORM, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "Edit Source\tAlt+F1",          ID_VIEW_SOURCE
        MENUITEM "Set Edit Tool",               ID_VIEW_SOURCE_VIEWER
        MENUITEM SEPARATOR
        MENUITEM "Refresh...",                  ID_APP_REFRESH
    END
    POPUP "&Compile"
    BEGIN
        MENUITEM "Generate Source",             ID_APP_SOURCE
        MENUITEM "Compile",                     ID_APP_COMPILE
        MENUITEM "Compile All",                 ID_APP_ALLCOMPILE
        MENUITEM SEPARATOR
        MENUITEM "Batch Compile",               ID_APP_BATCH
        MENUITEM "Run\tF9",                     ID_APP_PREVIEW
        MENUITEM SEPARATOR
        MENUITEM "Move To Axis",                ID_APP_MOVE_AXIS
        MENUITEM "Move All To Axis",            ID_APP_ALLMOVEAXIS
    END
    POPUP "&Addition"
    BEGIN
        MENUITEM "Edit Mask Format",            ID_EX_FORMAT
        MENUITEM "Conditional Color",           ID_EX_RGB
    END
    POPUP "&Windows"
    BEGIN
        MENUITEM "Close...",                    ID_APP_MAPCLOSE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Contents\tF1",                ID_APP_HELP
        MENUITEM "Axis Help\tCtrl+F1",          ID_APP_AXHELP
        MENUITEM "VB Help\tCtrl+Shift+F1",      ID_APP_VBHELP
        MENUITEM SEPARATOR
        MENUITEM "About Builder",               ID_APP_ABOUT
    END
END


