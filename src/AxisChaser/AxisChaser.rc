/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "Setup(&S)"
    BEGIN
        MENUITEM "Save",                        ID_SAVE
        MENUITEM "Save As...",                  ID_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "Change background color",     ID_SETBKCOLOR
        MENUITEM "Change text color",           ID_SETTEXTCOLOR
        MENUITEM "Change font",                 ID_SETFONT
        MENUITEM "Display Options....",         ID_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "AxisChaser Infomation(&A)...", ID_APP_ABOUT
        MENUITEM "Exit(&X)",                    ID_APP_EXIT
    END
    POPUP "Edit(&E)"
    BEGIN
        MENUITEM "Copy              Ctrl+C",    ID_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "Find              Alt+F3",    ID_STRING_FIND
        MENUITEM "Next find            F3",     ID_NEXT_FIND
        MENUITEM "Prev find  SHIFT+F3",         ID_PREV_FIND
    END
    POPUP "View(&V)"
    BEGIN
        MENUITEM "Toolbar(&T)",                 ID_VIEW_TOOLBAR
        MENUITEM SEPARATOR
        MENUITEM "Binary Mode",                 ID_MODE_BINARY
        MENUITEM "Text Mode",                   ID_MODE_TEXT
        MENUITEM SEPARATOR
        MENUITEM "Send/Receive Data",           ID_SNDRCV
        MENUITEM "RTS Data",                    ID_RTM
        MENUITEM "System Trace",                ID_SYSTEMTRACE
        MENUITEM "Report Data",                 ID_REPORTFORMAT
        MENUITEM "Screen Clear",                ID_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "No Scroll",                   ID_NOSCROLL
        MENUITEM "Stay on top",                 ID_STAYONTOP
    END
END


