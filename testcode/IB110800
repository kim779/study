'***************************************************************
'NAME: chk_elw_price
'DESC: ELW종목 주문착오방지.
'      현재가격대비 -50% ~ 100% 를 벗어나는 주문에 대해 확인창 띄움
'***************************************************************
Function s_chk_elw_price(mkgb2, code, rgrid, ii)
	Dim	cprice, jprice, prc_a, prc_b
	Dim	sdata, rcv_curr, dmsg
	s_chk_elw_price = True
	If mkgb2 <> "1" Then
		Exit Function
	End If

	Select Case Mid(code, 2, 1)
	Case "5", "6", "7", "8"			'ELW종목
		sdata = "1301" & Chr(127) & Mid(code, 2) & vbTab & "2023" & vbTab
		rcv_curr = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
		cprice = Abs(Int(rcv_curr))
		jprice = Int(rgrid.GetGridCell(ii, 11))
		'호가한도가격설정기준(현재가) 500원 미만일 경우
		'상한은 MAX(상한값, 500원), 하한은 적용 배제
		prc_a = (Int(cprice) *0.5)
		prc_b = (Int(cprice) * 2)
		If cprice < 500 Then
			prc_a = 0
			If prc_b < 500 Then prc_b = 500
		End If

		If jprice < prc_a Or jprice > prc_b Then
			dmsg = vbLf & code & " [" & RTrim(rgrid.GetGridCell(ii, 5)) & "]" & vbLf
			If jprice > prc_b Then
				dmsg = dmsg & vbLf & "고객님의 주문가격은 현재가격과 비교하여 현저히 높습니다.   "
			ElseIf jprice < prc_a Then
				dmsg = dmsg & vbLf & "고객님의 주문가격은 현재가격과 비교하여 현저히 낮습니다.   "
			End If
			dmsg = dmsg & vbLf & Space(58) & "~~~~~~~~~~" & _
					vbLf & "착오주문여부를 한 번 더 확인하시기 바랍니다." & _
					vbLf & vbLf & vbLf & "주문을 전송하시겠습니까?"
			If MsgBox(dmsg, vbYesNo + vbInformation, "ELW종목 주문착오방지") = 7 Then
				s_chk_elw_price = False
			End If
		End If
	End Select
End Function

'***************************************************************
'NAME: P_pswdConfirm()
' 기능      : 패스워드 체크
'**********************************************************************
Function P_pswdConfirm(accn, pswd, msg)
	Dim ret, sdata

	P_pswdConfirm = False

	SYSTEM.Trace "P_pswdConfirm = False"
	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(accn)) <> 11 Then Exit Function
		If Len(Trim(pswd)) > 8 Then Exit Function
		SYSTEM.Trace "P_pswdConfirm = 1 "
		msg = ""
		sdata = accn&pswd
		ret = SCREEN.ServiceEx("pibopswd", accn&pswd, Len(sdata), 0, 600000)
		If Left(ret,1) <> "1" Then
			msg = Mid(ret,2,99)
			If Trim(msg) = "" Then
				msg = "대기 시간 초과입니다. 결과를 꼭 확인 바랍니다."
			End If
			If InStr(msg, "3669") > 0 Then
				MsgBox msg, , "IBK투자증권"
			End If
			Exit Function
		End If
	End If
	SYSTEM.Trace "P_pswdConfirm = True "
	P_pswdConfirm = True
End Function

Function zeropad(str, length)
	Dim strTemp
	strTemp = Trim(str)
	If strTemp = "" Then
		zeropad = ""
		Exit Function
	End If
	zeropad = String(length - Len(strTemp), "0") & strTemp
End Function

