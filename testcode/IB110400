'         그리드 제일 앞부분 checkbox 삭제

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN1A.Name
	zPwd.Data = AN1A.Password

	GUIDE.Text = ""
	jmcd1104.Clear
	obj_hnam.Send

	If Len(Trim(AN1A.Data)) <> 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'***************************************************************************
' DESC: 가변로우일때 처음에 checkbox 0 으로 세팅
'***************************************************************************
Sub set_check()
	allCheck.Checked = False
	For ii = 1 To GRID0.Rows
		GRID0.SetGridCell ii, 1,"0"
	Next
End Sub


'***************************************************************************
' DESC: chk info
'***************************************************************************
Function chkcnt()
	Dim gcnt
	gcnt = 0

	chkcnt = False
	For ii = 1 To 500
		If Trim(GRID0.GetGridCell(ii, 1)) = 1 Then
			gcnt = gcnt + 1
		End If
	Next

	If gcnt > 0 Then
		chkcnt = True
	End If
End Function

'***************************************************************************
' DESC: clear_check
'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell (ii, 8)) = "" Then
			Exit Sub
		End If
		If GRID0.GetGridCell(ii, 1) = "1" Then
			GRID0.SetGridCell ii, 1,"0"
		End If
	Next
End Sub

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)
	For ii = 1 To 150
		If Trim(GRID0.GetGridCell (ii, 5)) = "" Then
			Exit Sub
		End If
		GRID0.SetGridCell ii, 1, Flag
	Next
End Sub

'***************************************************************
'NAME: chk_elw_price
'DESC: ELW종목 주문착오방지.
'      현재가격대비 -50% ~ 100% 를 벗어나는 주문에 대해 확인창 띄움
'***************************************************************
Function s_chk_elw_price(mkgb2, code, rgrid, ii)
	Dim	cprice, jprice, prc_a, prc_b
	Dim	sdata, rcv_curr, dmsg
	s_chk_elw_price = True
	If mkgb2 <> "1" Then
		Exit Function
	End If

	Select Case Mid(code, 2, 1)
	Case "5", "6", "7", "8"			'ELW종목
		sdata = "1301" & Chr(127) & Mid(code, 2) & vbTab & "2023" & vbTab
		rcv_curr = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
		cprice = Abs(Int(rcv_curr))
		jprice = Int(rgrid.GetGridCell(ii, 11))
		'호가한도가격설정기준(현재가) 500원 미만일 경우
		'상한은 MAX(상한값, 500원), 하한은 적용 배제
		prc_a = (Int(cprice) *0.5)
		prc_b = (Int(cprice) * 2)
		If cprice < 500 Then
			prc_a = 0
			If prc_b < 500 Then prc_b = 500
		End If

		If jprice < prc_a Or jprice > prc_b Then
			dmsg = vbLf & code & " [" & RTrim(rgrid.GetGridCell(ii, 5)) & "]" & vbLf
			If jprice > prc_b Then
				dmsg = dmsg & vbLf & "고객님의 주문가격은 현재가격과 비교하여 현저히 높습니다.   "
			ElseIf jprice < prc_a Then
				dmsg = dmsg & vbLf & "고객님의 주문가격은 현재가격과 비교하여 현저히 낮습니다.   "
			End If
			dmsg = dmsg & vbLf & Space(58) & "~~~~~~~~~~" & _
					vbLf & "착오주문여부를 한 번 더 확인하시기 바랍니다." & _
					vbLf & vbLf & vbLf & "주문을 전송하시겠습니까?"
			If MsgBox(dmsg, vbYesNo + vbInformation, "ELW종목 주문착오방지") = 7 Then
				s_chk_elw_price = False
			End If
		End If
