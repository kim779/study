	Select Case CONTROL0.Flag
		Case "I"						'insert
				VIEWGRID.InsertRow row
				VIEWGRID.Update row, Right(dataList, dataLen - gubn_code_len)
				'SetCreditGubn()
				Call SetDic()

		Case "D"						'delete
				If row < 1 Then
					Exit Sub
				End If

				VIEWGRID.RemoveRow row-1
				'SetCreditGubn()
				Call SetDic()

		Case "U"						'update
				If row < 1 Then
					Exit Sub
				End If

				VIEWGRID.Update row-1, Right(dataList, dataLen - gubn_code_len)
				CONTROL1.SetUpdate "U", dataList
				'SetCreditGubn()
		Case Else
				SCREEN.Object("Main.GUIDE").Text = GUIDE.Text
'				SYSTEM.Trace "Guide2 : " & Trim(GUIDE.Text)
				tmp = GUIDE.Text

				If (Mid(tmp,1,4) = "3669" Or Mid(tmp,1,4) = "1801") Then
				  MsgBox(Trim(GUIDE.Text))
				End If
				Exit Sub				'CONTROL0.Flag = "E"(error flag)
	End Select


	CONTROL1.SetUpdate CONTROL0.Flag, dataList
End If

