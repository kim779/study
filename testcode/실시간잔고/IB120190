RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, "userconf.ini", Trim(mapName.Data), "tax", cbo_tax.Index
		INFO.pushData LOGIN.Name, "userconf.ini", Trim(mapName.Data), "mcgb", cbo_mmd.Index
		INFO.pushData LOGIN.Name, "userconf.ini", Trim(mapName.Data), "bep", cbo_bep.Index
		INFO.PushData LOGIN.Name, "userconf.ini", Trim(mapName.Data), "type", cbo_type.Data
		INFO.PushData LOGIN.Name, "userconf.ini", Trim(mapName.Data), "renewal", cbo_renewal.Data

'		SYSTEM.Trace "[" & Trim(mapName.Data) & "]" & cbo_tax.Index & " , " & cbo_mmd.Index & " , " & cbo_bep.Index & " , " & cbo_type.Data
'		MsgBox cbo_tax.Index & " , " & cbo_mmd.Index & " , " & cbo_bep.Index & " , " & cbo_type.Data
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim tax, mcgb, bep, ctype, renewal
		tax = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", Trim(mapName.Data), "tax"))
		mcgb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", Trim(mapName.Data), "mcgb"))
		bep = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", Trim(mapName.Data), "bep"))
		ctype = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", Trim(mapName.Data), "type"))
		renewal = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", Trim(mapName.Data), "renewal"))

'		MsgBox tax & " , " & mcgb & " , " & bep & " , " & ctype
'		SYSTEM.Trace "[" & Trim(mapName.Data) & "]" & tax & " , " & mcgb & " , " & bep & " , " & ctype
		If tax <> "" Then
			cbo_tax.Index = tax
		Else
			cbo_tax.Index = 0
		End If

		If cbo_tax.Data = 0 Then
			cbo_mmd.Enable = False
		Else
			cbo_mmd.Enable = True
		End If

		If mcgb <> "" Then
			cbo_mmd.Data = mcgb
		Else
			cbo_mmd.Data = 0
		End If

		If bep <> "" Then
			cbo_bep.Data = bep
		Else
			cbo_mmd.Data = 0
		End If

		If ctype<>"" Then
			cbo_type.Data = ctype
		Else
			cbo_type.Data = "0"
		End If

		If renewal<>"" Then
			cbo_renewal.Data = renewal
		Else
			cbo_renewal.Data = "0"
		End If
		

	End If
End Sub

_AW_ONSTART_AW_
Call p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If SCREEN.Key = "13" Then
	SCREEN.CloseWindow
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call p_write_ini()

SYSTEM.Push "SettingOk", "OK"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SYSTEM.Push "SettingOk", "Cancel"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cbo_tax)
_AW_ONCHANGE_AW_
If cbo_tax.Data = 0 Then
	cbo_mmd.Enable = False
Else
	cbo_mmd.Enable = True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



