RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SYSTEM.Push "bankno", "NO"
LEDGER.Rcnt = "0050"
send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim MapName, strTemp
MapName = SCREEN.GetMapName(1)

If LEDGER.Next = "Y" Then
	Call send_c()
End If

If MapName = "IB498925" Or MapName = "IB498900" Or MapName = "IB49892H" Or MapName = "IB498725" Then

	strTemp = "003"	'콤보박스에서 003 코드 선택

	For ii = 1 To GRID0.Rows
		'이체시 IBK투자증권 제외
		If Trim(GRID0.GetGridCell(ii , 1)) <> "225" Then
			strTemp = strTemp & vbTab & GRID0.GetGridCell(ii , 1) & GRID0.GetGridCell(ii , 2)
		End If
	Next

	SCREEN.Object("Parent.zBnkCode").Clear
	SCREEN.Object("Parent.zBnkCode").SetItems(strTemp)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim msg
msg = GRID0.GetGridCell(GRID0.row, 1) & "|" & _
	GRID0.GetGridCell(GRID0.row, 2)

SYSTEM.Push "bankno", msg

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim name
name = GRID0.GetGridCell(GRID0.row, 3)

SYSTEM.Push "KNAME", name

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



