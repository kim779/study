_AW_ONDECLARE_AW_
Sub InitConfig()
	Dim sVal

	Cfg.LoadDefaultCfg()
	SetCfg()
End Sub

Sub SetCfg()
	sVal = Cfg.ReadCfg("BPType")
	Select Case sVal
	Case "1"
		R0_1.Checked = True
	Case "2"
		R0_2.Checked = True
	Case "3"
		R0_3.Checked = True
	'Case "0"
	Case Else
		R0_0.Checked = True
	End Select
	ChangeBPType()

	sVal = Cfg.ReadCfg("K200Rate")
	If CLng(sVal) > 100 Then
		sVal = "100"
	ElseIf CLng(sVal) < 0 Then
		sVal = "0"
	End If
	edK200Rate.Data = sVal
	SetFutureRate()
'변동성설정(0:종목별내재변동성, 1:콜풋ATM내재변동성, 3:사용자정의, 4: 역사적변동성 HVDay적용)

	sVal = Cfg.ReadCfg("VolType")
	Select Case sVal
	Case "2"
		R1_0.Checked = True
	'Case "3" '역사적 내재변동성
	Case Else
		R1_1.Checked = True
	End Select
	ChangeVolType()

	edUserCall.Data = Cfg.ReadCfg("UserCallIV")
	edUserPut.Data = Cfg.ReadCfg("UserPutIV")
	sVal = Cfg.ReadCfg("HVDay")
	Select Case CLng(sVal)
	Case 60
		R3_1.Checked = True
	Case 30
		R3_2.Checked = True
	Case 21
		R3_3.Checked = True
	Case Else '90일
		R3_0.Checked = True
	End Select

	sVal = Cfg.ReadCfg("RDType")
	Select Case sVal
	Case "0"
		R2_0.Checked = True
	Case "1"
		R2_1.Checked = True
	End Select

	sVal = Cfg.ReadCfg("TimeValue")
	If sval = "1" Then
		chkTimeValue.Checked = True
	End If
	CheckTimeValue()
	edTimeStart.Data = Cfg.ReadCfg("TimeStart")
	edTimeEnd.Data = Cfg.ReadCfg("TimeEnd")
End Sub

Sub ChangeBPType()
	edK200Rate.Enable = R0_2.Checked
End Sub

Sub ChangeVolType()
	edUserCall.Enable = R1_0.Checked
	edUserPut.Enable = R1_0.Checked
	R3_0.Enable = R1_1.Checked
	R3_1.Enable = R1_1.Checked
	R3_2.Enable = R1_1.Checked
	R3_3.Enable = R1_1.Checked
End Sub

Sub CheckTimeValue()
	edTimeStart.Enable = chkTimeValue.Checked
	edTimeEnd.Enable = chkTimeValue.Checked
End Sub

Sub SaveCfg()
	Dim sVal

	If R0_1.Checked Then
		sVal = "1"
	ElseIf R0_2.Checked Then
		sVal = "2"
	ElseIf R0_3.Checked Then
		sVal = "3"
	Else
		sVal = "0"
	End If
	Cfg.WriteCfg "BPType", sVal
	Cfg.WriteCfg "K200Rate", Trim(edK200Rate.Data)

	If R1_0.Checked Then
		sVal = "2"
	Else
		sVal = "3"
	End If
	Cfg.WriteCfg "VolType", sVal
	Cfg.WriteCfg "UserCallIV", edUserCall.Data
	Cfg.WriteCfg "UserPutIV", edUserPut.Data

	If R3_1.Checked Then
		sVal = "60"
	ElseIf R3_2.Checked Then
		sVal = "30"
	ElseIf R3_3.Checked Then
		sVal = "21"
	Else
		sVal = "90"
	End If
	Cfg.WriteCfg "HVDay", sVal

	If R2_1.Checked Then
		sVal = "1"
	Else
		sVal = "0"
	End If
	Cfg.WriteCfg "RDType", sVal

	If chkTimeValue.Checked Then
		sVal = "1"
	Else
		sVal = "0"
	End If
	Cfg.WriteCfg "TimeValue", sVal

	Cfg.WriteCfg "TimeStart", edTimeStart.Data
	Cfg.WriteCfg "TimeEnd", edTimeEnd.Data

	Cfg.SaveCfg()
End Sub

Sub SetFutureRate()
	Dim sVal
	sVal = edK200Rate.Data

	If CLng(sVal) > 100 Then
		sVal = "100"
		edK200Rate.Data = sVal
	ElseIf CLng(sVal) < 0 Then
		sVal = "0"
		edK200Rate.Data = sVal
	End If

	edFutureRate.Data = CStr(100 - CLng(sVal))
End Sub

