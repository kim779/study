RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim runMingam
Const pos_c = 1, c_cu = 18, c_iv = 2, c_d = 7, c_g = 6, c_v = 4, c_r = 3, c_t = 5, c_k = 11, c_i = 12, c_time = 13
Const pos_p = 21, p_cu = 22, p_iv = 38, p_d = 33, p_g = 34, p_v = 36, p_r = 37, p_t = 35, p_k = 29, p_i = 28, p_time = 27
Const	pos_hs = 19
Dim g_BefK200Time

g_BefK200Time = "0"
'-----------------------------------------------------------------------------
Function GetInt(StrData)
	Dim Data
	GetInt = 0

	If Len(StrData) > 6 Then
		Data = Mid(StrData, 1, 2) & Mid(StrData, 4, 2) & Mid(StrData, 7, 2)
	Else
		Data = StrData
	End If
	'LABEL2.Data = Data
	If IsNumeric(Data) Then
		GetInt = CLng(Data)
	Else
		Exit Function
	End If

End Function
'-----------------------------------------------------------------------------
If SCREEN.CreateObject("DX_OPSENSCAL") = False Then
	runMingam = False
Else
	runMingam = True
	DX_OPSENSCAL.UserName 	= LOGIN.Name 								'ReadCfg작업을 위해 UserName 필요
	DX_OPSENSCAL.ReadCfg
End If

Sub OnAlert()
	Dim tmp, ii, sCode, curr
	Dim gubn

	If runMingam = False Or Trim(S40301.Data) = "" Then
		Exit Sub
	End If

	If g_BefK200Time = S20034.Data Then
		Exit Sub
	End If

	If Mid(S20034.Data, 1, 1) <> "장" Then
		If GetInt(Trim(S20034.Data)) - GetInt(g_BefK200Time) <= 1 And g_BefK200Time <> "0" Then
			'g_BefK200Time = S20034.Data
			Exit Sub
		End If
	End If
	g_BefK200Time = Trim(S20034.Data)

	For ii = 1 To SCREEN.Object("parent.410").rows
		' 콜옵션
		sCode = SCREEN.Object("parent.410").getgridcell(ii,	pos_c)
		If Trim(sCode) = "" Then
			Exit For
		End If

		DX_OPSENSCAL.Strike     = SCREEN.Object("parent.410").getgridcell(ii, pos_hs)	'행사가
		DX_OPSENSCAL.JCode      = sCode		'종목코드
		curr = SCREEN.Object("parent.410").getgridcell(ii,	c_cu)'현재가
		DX_OPSENSCAL.CurrValue  = Abs(curr)
		If rts_yn.Text = "Y" Then
			' IV, Delta, Gamma, Theta, Vegga, Rho 계산
			' 입력인자 : 현재가, K200, 선물최근월물, 장시간
			DX_OPSENSCAL.CalcEx Abs(TABLE3.GetTableText(3)), S20023.Data, S31023.Data, S20034.Data

			SCREEN.Object("parent.410").setgridcell ii,	c_iv, DX_OPSENSCAL.IV
			SCREEN.Object("parent.410").setgridcell ii,	c_i, DX_OPSENSCAL.TheoryValue
			tmp = Abs(curr) - FormatNumber(DX_OPSENSCAL.TheoryValue, 2)
			SCREEN.Object("parent.410").setgridcell ii,	c_k, FormatNumber(tmp, 2)

			SCREEN.Object("parent.410").setgridcell ii,	c_d, DX_OPSENSCAL.Delta
			SCREEN.Object("parent.410").setgridcell ii,	c_g, DX_OPSENSCAL.Gamma
			SCREEN.Object("parent.410").setgridcell ii,	c_v, DX_OPSENSCAL.Vegga
			SCREEN.Object("parent.410").setgridcell ii,	c_r, DX_OPSENSCAL.Rho
			SCREEN.Object("parent.410").setgridcell ii,	c_t, DX_OPSENSCAL.Theta
		End If
		'시간가치 : 콜옵션 가격 - (KOSPI200 지수 현재가 - 옵션행사가)
		tmp = Abs(S20023.Data) - DX_OPSENSCAL.Strike
		If tmp < 0 Then
			tmp = 0
		End If
		tmp = Abs(curr) - tmp
		SCREEN.Object("parent.410").setgridcell ii,	c_time, FormatNumber(tmp, 2)

		' 풋옵션
		sCode = SCREEN.Object("parent.410").getgridcell(ii,	pos_p)
		If Trim(sCode) = "" Then
			Exit For
		End If

		DX_OPSENSCAL.JCode      = sCode		'종목코드
		curr = SCREEN.Object("parent.410").getgridcell(ii,	p_cu)'현재가
		DX_OPSENSCAL.CurrValue  = Abs(curr)
		DX_OPSENSCAL.Strike     = SCREEN.Object("parent.410").getgridcell(ii, pos_hs)	'행사가
		If rts_yn.Text = "Y" Then
			' IV, Delta, Gamma, Theta, Vegga, Rho 계산
			' 입력인자 : 현재가, K200, 선물최근월물, 장시간
			DX_OPSENSCAL.CalcEx Abs(TABLE3.GetTableText(3)), S20023.Data, S31023.Data, S20034.Data

			SCREEN.Object("parent.410").setgridcell ii,	p_iv, DX_OPSENSCAL.IV
			SCREEN.Object("parent.410").setgridcell ii,	p_i, DX_OPSENSCAL.TheoryValue
			tmp = Abs(curr) - FormatNumber(DX_OPSENSCAL.TheoryValue, 2)
			SCREEN.Object("parent.410").setgridcell ii,	p_k, FormatNumber(tmp, 2)
			SCREEN.Object("parent.410").setgridcell ii,	p_d, DX_OPSENSCAL.Delta
			SCREEN.Object("parent.410").setgridcell ii,	p_g, DX_OPSENSCAL.Gamma
			SCREEN.Object("parent.410").setgridcell ii,	p_v, DX_OPSENSCAL.Vegga
			SCREEN.Object("parent.410").setgridcell ii,	p_r, DX_OPSENSCAL.Rho
			SCREEN.Object("parent.410").setgridcell ii,	p_t, DX_OPSENSCAL.Theta
		End If
		'시간가치 :
		tmp = DX_OPSENSCAL.Strike - Abs(S20023.Data)
		If tmp < 0 Then
			tmp = 0
		End If
		tmp = Abs(curr) - tmp
		SCREEN.Object("parent.410").setgridcell ii,	p_time, FormatNumber(tmp, 2)

	Next

	rts_yn.Text = "N"
End Sub

_AW_ONSEND_AW_
S20301.Data = "101"
S30303.Data = "1"
g_BefK200Time = "0"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If SCREEN.CreateObject("DX_OPSENSCAL") Then
	DX_OPSENSCAL.CD         = TABLE3.GetTableCell(1)				'CD 금리
	DX_OPSENSCAL.BedangJisu = TABLE3.GetTableCell(2) / 1000000	'배당지수
	DX_OPSENSCAL.BzRemainDays = TABLE3.GetTableCell(4)			'영업일
	DX_OPSENSCAL.CalRemainDays = TABLE3.GetTableCell(3)			'달력일
	DX_OPSENSCAL.SetHv TABLE3.GetTableCell(5), TABLE3.GetTableCell(6), TABLE3.GetTableCell(7), TABLE3.GetTableCell(8) '역사적변동성
End If
OnAlert()

_AW_ONENDSUB_AW_
}



