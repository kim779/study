_AW_ONDECLARE_AW_
Sub Set_code()
	Dim code
	code = S100301.Data

	code1.Data = "1" & Mid(code,2,2) & Mid(code,4,2) & "000"
	code2.Data = "1" & Mid(code,2,2) & Mid(code,6,2) & "000"

	SCREEN.Object("obj_1.100301").Data = code1.Data
	SCREEN.Object("obj_1.tPANEL").Text = code1.Data
	obj_1.Send

	SCREEN.Object("obj_2.100301").Data = code2.Data
	SCREEN.Object("obj_2.tPANEL").Text = code2.Data
	obj_2.Send
End Sub

Function make_cal( a )
	If CDbl(a) > 0 Then
		make_cal = "+" & a
	Else
		make_cal = a
	End If
End Function

Sub cal()
	Dim a, b

	' 이론가 SP
	a = Trim(SCREEN.Object("obj_1.101202").Data)
	b = Trim(SCREEN.Object("obj_2.101202").Data)

	If Len(Trim(a)) < 1 Then
		a = 0
	End If

	If Len(Trim(b)) = 0 Then
		SYSTEM.Trace("Exit Sub")
	 	Exit Sub
	End If

	out1.Data = make_cal( CStr( Round(CDbl(a)-CDbl(b),2) ) )

	' 현재가 SP
	a = Trim(SCREEN.Object("obj_1.101023").Data)
	b = Trim(SCREEN.Object("obj_2.101023").Data)

	If Len(Trim(a)) < 1 Then
		a = 0
	End If

	out4.Data = make_cal( CStr( Round(CDbl(a)-CDbl(b),2) ) )

	' 매수 SP
	a = Trim(SCREEN.Object("obj_1.102071").Data)
	b = Trim(SCREEN.Object("obj_2.102071").Data)

	If Len(Trim(a)) < 1 Then
		a = 0
	End If

	If Len(Trim(b)) = 0 Then
		b = 0
	End If

	out2.Data = make_cal( CStr( Round(CDbl(a)-CDbl(b),2) ) )

	' 매도 SP
	a = Trim(SCREEN.Object("obj_1.102051").Data)
	b = Trim(SCREEN.Object("obj_2.102051").Data)

	If Len(Trim(a)) < 1 Then
		a = 0
	End If

	If Len(Trim(b)) = 0 Then
		b = 0
	End If

	a = Replace(a, "0+", "+")
	b = Replace(b, "0+", "+")

	a = Replace(a, "0-", "-")
	b = Replace(b, "0-", "-")
	
	out3.Data = make_cal( CStr( Round(CDbl(a)-CDbl(b),2) ) )
End Sub

