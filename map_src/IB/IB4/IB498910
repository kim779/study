		End If

		GRID0.SetGridCell ii, 24, tmpFundBalQty

		If chkNumericData(tmpPayAmt) = True Then
			TotPayAmt = TotPayAmt + tmpPayAmt
		End If


	Next

	For ii = 1 To GRID0.Rows
		gridData1 = Trim(GRID0.GetGridCell(ii, 11))		'세전평가금액
		gridData2 = Trim(GRID0.GetGridCell(ii, 12))		'투자원금
		gridData3 = Trim(GRID0.GetGridCell(ii, 19))		'수익금

		If chkNumericData(gridData1) = True Then
			sum1 = sum1 + gridData1
		End If

		If chkNumericData(gridData2) = True Then
			sum2 = sum2 + gridData2
		End If

		If chkNumericData(gridData3) = True Then
			sum3 = sum3 + gridData3
		End If
	Next

	out1.Data = sum1
	out2.Data = sum2
	out3.Data = sum3

	Total_PayAmt.Data = TotPayAmt
	gridPos = ii
