		tmptujaNM = ""
		tmpinfoYN = "미제공"
		'check_char = 7
	Else
		tmpinfoYN = "제공"
	End If

	Select Case check_char
		Case 1 :
			tmptujaGD = "매우낮은위험이하"
		Case 3 :
			tmptujaGD = "보통위험이하"
		Case 4 :
			tmptujaGD = "다소높은위험이하"
		Case 5 :
			tmptujaGD = "높은위험이하"
		Case 6 :
			tmptujaGD = "매우높은위험이하"
		Case 7 :
			tmptujaGD = ""
	End Select

