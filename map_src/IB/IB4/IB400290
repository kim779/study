RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim row
row = 1

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim str, indx, title
Dim ii, hsga

'같은화면에서 send는 skip
If (FIRST.Text = "1") Then
	FIRST.Text = "0"
	SCREEN.OnSend = False
	Exit Sub
End If

cod2.Data = SCREEN.Object("main.40301").data
If Left(cod2.Data, 1) = "2" Or Left(cod2.Data, 1) = "B" Then
	LB_chk.Data = "PUT 종목"
Else
	LB_chk.Data = "CALL 종목"
End If
\

'체크박스 선택되면 콜/풋 반대로 보여주기
If CHK1.Checked = True Then
	If Left(cod2.Data, 1) = "2"  Then
		cod2.Data = "3" & Mid(cod2.Data, 2)
    End If
	If Left(cod2.Data, 1) = "3"  Then
		cod2.Data = "2" & Mid(cod2.Data, 2)
	End If
End If

'체크박스 선택되면 콜/풋 반대로 보여주기
If CHK1.Checked = True Then
	If Left(cod2.Data, 1) = "B"  Then
		cod2.Data = "C" & Mid(cod2.Data, 2)
    End If
	If Left(cod2.Data, 1) = "C"  Then
		cod2.Data = "B" & Mid(cod2.Data, 2)
	End If
End If


If (Left(cod2.Data, 1) = "2" Or Left(cod2.Data, 1) = "B") Then		'Call
	title = " CALL 옵션 월물별"
End If

If (Left(cod2.Data, 1) = "3" Or Left(cod2.Data, 1) = "C") Then		'Call
	title = " PUT 옵션 월물별"
End If


titl.Text = title
hsga = Trim(HSGA_INDX.Text)
If (hsga <> "") Then
	grd.SetPRgb hsga, 2, 62
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, hsga
For ii = 1 To grd.Rows
	hsga = Left(Trim(grd.GetGridCell(ii,2)),1)
	If (hsga = "+") Then
		HSGA_INDX.Text = ii
		hsga = Mid(Trim(grd.GetGridCell(ii,2)), 2, 8)
		grd.SetGridCell ii, 2, hsga
		grd.SetPRgb ii, 2, 211
		Exit Sub
	Else
		grd.SetPRgb ii, 2, 68
	End If
Next

For ii = 1 To grd.Rows
	hsga = grd.GetPRgb(ii, 2)

	If hsga <> 68 Then
		If hsga <> 211 Then
			grd.SetPRgb ii, 2, 68
		End If
	End If
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(grd)
_AW_ONDBLCLK_AW_
Dim ocod
If (grd.HitPos <> 3) Then
	Exit Sub
End If
ocod = grd.GetGridCell(grd.Row, 1)
ocod = Trim(ocod)
If (ocod = "") Then
	Exit Sub
End If
FIRST.Text = "1"
codx.Data = ocod
codx.Trigger "40301", False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHK1)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



