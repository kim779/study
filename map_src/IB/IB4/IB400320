RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim runMingam
Dim k2

If SCREEN.CreateObject("DX_OPSENSCAL") = False Then
	runMingam = False
Else
	runMingam = True
	DX_OPSENSCAL.UserName 	= LOGIN.Name 								'ReadCfg작업을 위해 UserName 필요
	DX_OPSENSCAL.ReadCfg
End If

Sub OnAlert()
	If runMingam = False Or Trim(S40301.Data) = "" Then
		Exit Sub
	End If

	If k2 <> S20034.Data Then
		' IV, Delta, Gamma, Theta, Vegga, Rho 계산
		' 입력인자 : 현재가, K200, 선물최근월물, 장시간
		DX_OPSENSCAL.CalcEx Abs(TABLE3.GetTableText(3)), S20023.Data, S31023.Data, S20034.Data

		iv.Data = DX_OPSENSCAL.iv
		delta.Data = DX_OPSENSCAL.delta
		gamma.Data = DX_OPSENSCAL.gamma
		theta.Data = DX_OPSENSCAL.theta
		vega.Data = DX_OPSENSCAL.Vegga
		rho.Data = DX_OPSENSCAL.rho
		irga.Data = DX_OPSENSCAL.TheoryValue
	End If
	k2 = S20034.Data
End Sub

_AW_ONSEND_AW_
S20301.Data = "101"
S30303.Data = "1"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If SCREEN.CreateObject("DX_OPSENSCAL") Then
	DX_OPSENSCAL.JCode      = S40301.Text								'종목코드
	DX_OPSENSCAL.Strike     = Abs(TABLE3.GetTableCell(4))		'행사가
	DX_OPSENSCAL.CD         = TABLE3.GetTableCell(1)				'CD 금리
	DX_OPSENSCAL.BedangJisu = TABLE3.GetTableCell(2) / 1000000	'배당지수
	DX_OPSENSCAL.BzRemainDays = TABLE3.GetTableCell(6)			'영업일
	DX_OPSENSCAL.CalRemainDays = TABLE3.GetTableCell(5)			'달력일
	DX_OPSENSCAL.SetHv TABLE3.GetTableCell(7), TABLE3.GetTableCell(8), TABLE3.GetTableCell(9), TABLE3.GetTableCell(10) '역사적변동성
End If
OnAlert()

