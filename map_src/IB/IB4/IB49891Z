RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Function FormatDateYYYYMMDD(s)
 s = Trim(CStr(s))
	If Len(s) <> 8 Or Not IsNumeric(s) Then
	 	FormatDateYYYYMMDD = s
	 	Exit Function
	End If

	FormatDateYYYYMMDD = _
	Left(s, 4) & "." & Mid(s, 5, 2) & "." & Right(s,2)
End Function

_AW_ONSTART_AW_

Dim szOfrSetupDt
szOfrSetupDt = SYSTEM.Pop("OBJ_mj_zOfrSetupDt")
szOfrSetupDt = FormatDateYYYYMMDD(szOfrSetupDt)
lbInfo.Text = "현재는 모집매수 기간으로 매수 신청 시 펀드의\n최초설정일인 " & szOfrSetupDt & " 매수 완료됩니다."
SYSTEM.Push "OBJ_mj_zOfrSetupDt", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(btnOk)
_AW_ONCLICK_AW_
SYSTEM.Push "OBJ_mj_OK", "1"
SCREEN.CloseWindow()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btnClose)
_AW_ONCLICK_AW_
SYSTEM.Push "OBJ_mj_OK", "0"
SCREEN.CloseWindow()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



