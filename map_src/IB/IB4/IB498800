Sub inqueryMadoInfo()
	SCREEN.Object("obj.SubAcntNo").data = Trim(GRID0.GetgridCell(GRID0.row, 3))
	SCREEN.Object("obj.fundCode").data = Trim(GRID0.GetgridCell(GRID0.row, 5))

	SCREEN.Object("obj.QryDt").data = getCurrDay()
	SCREEN.Object("obj.SubAcntNo").data = Trim(GRID0.GetgridCell(GRID0.row, 3))
	SCREEN.Object("obj.fundCode").data = Trim(GRID0.GetgridCell(GRID0.row, 5))
	SCREEN.Object("obj.fundNm").data = Trim(GRID0.GetgridCell(GRID0.row, 8))
	SCREEN.Object("obj.zPwd").data = zPwd.data

	fundcode.Data = Trim(GRID0.GetGridCell(GRID0.Row, 5))
	FundName.Text = Trim(GRID0.GetGridCell(GRID0.Row, 8))

	If Trim(GRID0.GetgridCell(GRID0.row, 12)) <> "" And SCREEN.Object("obj.RADIO0").Checked = True Then
		SCREEN.Object("obj.TrdQty").data = Trim(GRID0.GetgridCell(GRID0.row, 39))
	End If

	If SCREEN.Object("obj.RADIO1").Checked = True Then
		GUIDE.Text = ""
		SCREEN.Object("obj.SellAmt").SetFocus
	ElseIf SCREEN.Object("obj.RADIO2").Checked = True Then
		GUIDE.Text = ""
		SCREEN.Object("obj.TrdQty").SetFocus
	Else
		SCREEN.Proc "obj.send_f", ""
	End If

	BUTTON0.SetFocus
End Sub

Sub Set_account()
	Dim Today
	Today = getCurrDay()
	SCREEN.ClearAll 0, 2

	zBaseDt.Data = Today
	SCREEN.Object("obj.SubAcntNo").Data = ""
	SCREEN.Object("obj.RADIO0").Checked = True
	SCREEN.Object("obj.RpPrslPtnTp").Data = "3"
	SCREEN.Object("obj.TrdQty").Data = ""
	SCREEN.Object("obj.TrdQty").Enable = False
	SCREEN.Object("obj.SellAmt").Data = ""
	SCREEN.Object("obj.SellAmt").Enable = False
	SCREEN.Object("obj.RADIO3").Checked = True
	SCREEN.Object("obj.SpclMidwRpYn").Data = "0"
	SCREEN.Object("obj.fundCode").Data = ""
	SCREEN.Object("obj.fundNm").Data = ""
	SCREEN.Object("obj").ClearAll 2

	ACNM.Data = AN55.name
	zPwd.Data = AN55.Password
	zAcntNo.Data = AN55.data

	If Trim(AN55.data) = "" Then
	   AN55.Setfocus
	   Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If
End Sub

