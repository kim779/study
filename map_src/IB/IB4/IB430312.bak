_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

vagb.Data = 1 '수량

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If SCREEN.Object("main.RDAT").Checked = False Then '순매수누적데이타가 아닌경우만.
	If SCREEN.Object("main.rdt1").Checked = True Then '전일+당일
	   SCREEN.SetTimer 10, False
	Else  '실시간
	   Data_move()
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Data_add()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


