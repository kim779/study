RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub OnAlert()
  If SCREEN.Object("main.RDAT").Checked = False Then '누적데이타가 아닌 경우 (실시간인 경우만 해당)
	  If SCREEN.Object("main.rdt1").Checked = True Then '전일+당일
	     Data_add()
	  Else
	     Data_move()
	  End If
  End If
End Sub

Sub data_add()
  If SCREEN.Object("main.R1").Checked = True Then '거래소
     SCREEN.Object("main.t00").SetTableCell 1, CDbl(fn_nvl(t00.GetTableCell(2)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t00").GetTableCell(1)))
     SCREEN.Object("main.t00").SetTableCell 2, CDbl(fn_nvl(t00.GetTableCell(4)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t00").GetTableCell(2)))
     SCREEN.Object("main.t00").SetTableCell 3, CDbl(fn_nvl(t00.GetTableCell(6)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t00").GetTableCell(3)))
     SCREEN.Object("main.t01").SetTableCell 1, CDbl(fn_nvl(t01.GetTableCell(2)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t01").GetTableCell(1)))
     SCREEN.Object("main.t01").SetTableCell 2, CDbl(fn_nvl(t01.GetTableCell(4)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t01").GetTableCell(2)))
     SCREEN.Object("main.t01").SetTableCell 3, CDbl(fn_nvl(t01.GetTableCell(6)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t01").GetTableCell(3)))
     SCREEN.Object("main.t02").SetTableCell 1, CDbl(fn_nvl(t02.GetTableCell(2)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t02").GetTableCell(1)))
     SCREEN.Object("main.t02").SetTableCell 2, CDbl(fn_nvl(t02.GetTableCell(4)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t02").GetTableCell(2)))
     SCREEN.Object("main.t02").SetTableCell 3, CDbl(fn_nvl(t02.GetTableCell(6)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t02").GetTableCell(3)))
     SCREEN.Object("main.t03").SetTableCell 1, CDbl(fn_nvl(t03.GetTableCell(2)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t03").GetTableCell(1)))
     SCREEN.Object("main.t03").SetTableCell 2, CDbl(fn_nvl(t03.GetTableCell(4)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t03").GetTableCell(2)))
     SCREEN.Object("main.t03").SetTableCell 3, CDbl(fn_nvl(t03.GetTableCell(6)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t03").GetTableCell(3)))
     SCREEN.Object("main.t04").SetTableCell 1, CDbl(fn_nvl(t04.GetTableCell(2)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t04").GetTableCell(1)))
     SCREEN.Object("main.t04").SetTableCell 2, CDbl(fn_nvl(t04.GetTableCell(4)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t04").GetTableCell(2)))
     SCREEN.Object("main.t04").SetTableCell 3, CDbl(fn_nvl(t04.GetTableCell(6)))+CDbl(fn_nvl(SCREEN.Object("main.obj2.t04").GetTableCell(3)))
