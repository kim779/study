RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub radio_switch()
	If SCREEN.Object("main.OBJECT1.RISKYN").Data = "Y" Then '숙려대상자 일경우
		joinAmt.Visible = True
		LABEL6.Visible = True
		LABEL7.Visible = True
		PANEL3.Visible = True
		PANEL7.Visible = True
		PANEL5.Visible = True
	Else
		joinAmt.Visible = False
		LABEL6.Visible = False
		LABEL7.Visible = False
		PANEL3.Visible = False
		PANEL7.Visible = False
		PANEL5.Visible = False
	End If

	If radio21.Checked Then
		'저축기간 셋팅
		month.text = ""
	Else
		'저축기간 셋팅
		month.text = "36개월이상"
	End If
End Sub


Sub CheckNext()
	If Int(joinAmt.Data) < 1000 And joinAmt.Visible = True Then
		MsgBox "가입금액을 1,000원 이상으로 입력해 주세요 (기준가에 따라 매수금액이 상이할 수 있음)"
	Else
		'주문데이터 셋팅
		SCREEN.Object("main.OBJECT1.R2").Checked = True '벤처투자

		If radio21.Checked Then
			SCREEN.Object("main.OBJECT1.JY1").Checked = True'임의식
			SCREEN.Object("main.OBJECT1.nyear").Data = "" '저축기간

		Else
			SCREEN.Object("main.OBJECT1.JB2").Checked = True'자유적립식
			SCREEN.Object("main.OBJECT1.nyear").Data = "36" '저축기간
		End If

		If joinAmt.Visible = True Then
			SCREEN.Object("main.OBJECT1.Fund_Reserve_prc").Data	= joinAmt.Data '숙려대상자는 펀드매수예약을 바로 진행한다.
			SCREEN.Object("main.OBJECT1.Fund_Reserve_prc").Visible = True
		End If
		'화면변경
		SCREEN.Proc "main.changeStep", "3"
	End If

End Sub

_AW_ONSTART_AW_
radio_switch()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(radio21)
_AW_ONCLICK_AW_
radio_switch()
