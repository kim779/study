_AW_ONDECLARE_AW_
Dim read_f
'== 계좌명, 비밀번호 설정
Sub combosetting(data)
	sub_account.Clear
	sub_account.Setitems(data)
End Sub

Sub Set_account()
	ACNM.Data = AN55.Name
	zPwd.Data = AN55.Password
	If Trim(AN55.Data) = "" Then
		AN55.SetFocus
		Exit Sub
	End If

	If read_f = 1 Then
		If Trim(zIvstfndCode.Data) <> "" Then
			sub_account.SetItems("")
			memsub.Data = ""
			OBJECT0.Proc "send_f", ""
		End If
	Else
		read_f = 1
	End If
	If Trim(zPwd.Data) = "" Then
		If zPwd.Enable = True Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	If Trim(zBnkAcntNo.Data) = "" Then '자동조회 패스
		Exit Sub
	End If

	SCREEN.Send 0
End Sub

Sub Sub_send()
	OBJECT0.Proc "send_f", ""
End Sub

Sub Set_memsub()
	If Trim(memsub.Data) <> "" Then
		sub_account.Data = l_zeropad(memsub)
	End If
End Sub

Sub fullpass_send()
	SCREEN.Send 0
End Sub

