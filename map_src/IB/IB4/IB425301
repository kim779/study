Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)

Sub write_combo_history()
	Dim item, sVal, nRows, arr, stmp

	version =  Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "version"))

	If version <> "1" Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "version", "1"
		INFO.pushData LOGIN.Name, myFILE, myMAP, "combohistory", ""
	End If

	If SCREEN.CreateObject("Info") Then
		sComhis = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "combohistory"))
		stmp = ""
		newItem = Trim(scode.Data) & Trim(JNAM.Data)   ' 예: 200한화

		If Len(sComhis) > 0 Then
		    arr = Split(sComhis, vbTab)

		    For ii = 0 To UBound(arr)
		        If Len(Trim(arr(ii))) >= 3 Then
		            code = Left(Trim(arr(ii)), 3)
		            nam = Mid(Trim(arr(ii)), 4)

		            ' 같은 코드가 아니면 기존값 유지
		            If code <> Trim(scode.Data) Then
		                If Len(stmp) > 0 Then
		                    stmp = stmp & vbTab
		                End If
		                stmp = stmp & code & nam
		            End If
		        End If
		    Next
		End If

		' 마지막에 새 항목 추가
		If Len(stmp) > 0 Then
		    stmp = stmp & vbTab
		End If

		stmp = stmp & newItem
		INFO.pushData LOGIN.Name, myFILE, myMAP, "combohistory", stmp
	End If
End Sub


Sub read_combo_history()
	SYSTEM.Trace "read_combo_history"
	gridcom.Clear
	JNAM.Clear
	Dim sComhis, arr, code, nam, version
	If SCREEN.CreateObject("Info") Then
		version =  Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "version"))

		If version <> "1" Then
			INFO.pushData LOGIN.Name, myFILE, myMAP, "version", "1"
			INFO.pushData LOGIN.Name, myFILE, myMAP, "combohistory", ""
		End If

		sComhis = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "combohistory"))

		If Len(Trim(sComhis)) > 0 Then
			arr = Split(sComhis, vbTab)

			For ii = 0 To UBound(arr)
				code = Left(arr(ii),3)
				nam = Mid(arr(ii),4)
				nam = Trim(nam)
SYSTEM.Trace "[4253] read_combo_history code = " & code & " nam =" & nam
				JNAM.Data = nam
				scode.Data = code
			Next
		Else
SYSTEM.Trace "on data -> dosomething"
		'	cx_log.DoSomething "Get_SFCODE_VAL", "sfcode"
		End If

	End If
End Sub

