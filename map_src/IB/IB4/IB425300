RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim nRadio '현재 라디오값		1 : 시간대별+증감, 2: 시간대별+누적순매수, 3:일자별+증감, 4:일자별+누적순매수
Dim nState '라디오 상태 변수	시간대별 :0, 일자별 : 2
Dim grid_state

Sub Change_Object()
	If BUTTON1.Text = "차트" Then
		If stat.Data = "1" Then
			obj2.SetObject "IB425310"
		ElseIf stat.Data = "2"	Then
			obj2.SetObject "IB425320"
		ElseIf stat.Data = "3"	Or stat.Data = "4" Then
			obj2.SetObject "IB425340"
		End If
	Else
		If stat.Data = "1" Or stat.Data = "2" Then
			obj2.SetObject "IB425330"
		ElseIf stat.Data = "3"	Or stat.Data = "4" Then
			obj2.SetObject "IB425331"
		End If
	End If

	nRadio = stat.Data

'	Call Trace("Change_Object")

	Call Set_Ini()

End Sub

'라디오버튼과 콤보박스
Sub Set_Radio()
		If nRadio = "1" Then
			RADIO0.Visible = True
			RADIO1.Visible = True
			PANEL2.Visible = True
			COMBO0.Visible = False

			RADIO0.Checked = True
			RADIO2.Checked = True
			nState = 0

		ElseIf nRadio = "2" Then
			RADIO0.Visible = True
			RADIO1.Visible = True
			PANEL2.Visible = True
			COMBO0.Visible = False

			RADIO1.Checked = True
			RADIO2.Checked = True
			nState = 0

		ElseIf nRadio = "3" Or nRadio = "4" Then
			RADIO0.Visible = False
			RADIO1.Visible = False
			PANEL2.Visible = False
			COMBO0.Visible = True
			COMBO0.Index = grid_state - 1

			RADIO3.Checked = True
			nState = 2

		End If

		stat.Data = nRadio

'		Call Trace("Set_Radio")

End Sub


Sub Get_Ini()

		If SCREEN.CreateObject("Info") Then
			nRadio = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB425300", "Radio"))
			grid_state = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB425300", "grid_state"))

			'ini값이 없으면 초기 세팅으로 저장한다.
			If Len(Trim(nRadio)) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB425300", "Radio", "1"
				nRadio = "1"

				INFO.PushData LOGIN.Name, "userconf.ini", "IB425300", "grid_state", "3"
				grid_state = "3"

			End If

		End If

'	Call Trace("Get_Ini")
End Sub


Sub Set_Ini()

	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB425300", "Radio", Trim(nRadio)
		INFO.PushData LOGIN.Name, "userconf.ini", "IB425300", "grid_state", Trim(grid_state)
	End If

'	Call Trace("Set_Ini")

End Sub


Sub Trace(strDes)
	SYSTEM.Trace "+++" & strDes & "+++nRadio===>" & nRadio
End Sub


Sub send_id()
	Dim codex,idx
	codex = Trim(SCREEN.Object("jnam.scode").data)

	If Len(Trim(codex)) = 0 Then
		Exit Sub
	End If

	idx = CInt(codex)
SYSTEM.Trace "------------------------ 	idx = " & idx
	If CHECK0.Checked = True Then
		S62303.data =  idx
	Else
		S62303.data = 49
	End If
	SCREEN.Send 0
End Sub

Sub SetCode_IB425300(sCode)
	SCREEN.Proc "jnam.SetCode_IB425301", sCode
End Sub

