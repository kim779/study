ElseIf CHECK0.Checked = False Then
	SCREEN.Object("jnam.jnam").Enable = False
	SCREEN.Object("jnam.BUTTON2").Enable = False
	SCREEN.Object("jnam.SYMBOL7").Enable = False
End If

codex = Trim(SCREEN.Object("jnam.scode").data)

If Len(Trim(codex)) = 0 Then
	Exit Sub
End If

idx = CInt(codex)

If CHECK0.Checked = True Then
	SCREEN.Object("jnam.jnam").Enable = True
	S62303.data =  idx
ElseIf CHECK0.Checked = False Then
	SCREEN.Object("jnam.jnam").Enable = False
	S62303.data = 49
End If
SCREEN.Send 0
