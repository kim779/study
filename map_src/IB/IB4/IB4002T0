_AW_ONDECLARE_AW_
Const MapName = "IB400200"
Const FileName = "userconf.ini"
Dim per1,per2,udata,ddata,uTime,dtime
Dim bFirst
bFirst = True

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
		Dim width1, width2, height
		width1 = INFO.PopData(LOGIN.Name, FileName, MapName, "width")
		width2 = INFO.PopData(LOGIN.Name, FileName, MapName, "month")
		height = INFO.PopData(LOGIN.Name, FileName, MapName, "chart")

		If width1 = "" Then
			width1 = "0"
		End If

		widthOpt.Data = width1

		If width2 = "" Then
			width2 = "0"
		End If

		monthOpt.Data = width2

		If height = "" Then
			height = "0"
		End If

		chartOpt.Data = height

		Call SetSize()

	End If
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, FileName, MapName, "width", Trim(widthOpt.Data)		'가로
		INFO.PushData LOGIN.Name, FileName, MapName, "month", Trim(monthOpt.Data)		'월물별
		INFO.PushData LOGIN.Name, FileName, MapName, "chart", Trim(chartOpt.Data)		'차트
	End If
End Sub

Sub SetSize()
	If widthOpt.Data = "0" Then									'축소버튼
		SCREEN.SetSize 329, 341
	Else
		If monthOpt.Data = "0" And chartOpt.Data = "0" Then		'확대버튼 선택시(widthOpt = 1)
			SCREEN.SetSize 684, 341

			order_btn.Visible = True
			chart_btn.Visible = True
			month.Visible = True
		ElseIf monthOpt.Data = "1" And chartOpt.Data = "0" Then	'확대버튼, 월물별
			SCREEN.SetSize 937, 341

			order_btn.Visible = False
			chart_btn.Visible = False
			month.Visible = False
		ElseIf monthOpt.Data = "0" And chartOpt.Data = "1" Then '확대, 차트
			'PANEL5.Visible = False
			'PANEL4.Visible = True
			PANEL4.SetRect 0, 342, 684, 551
			SCREEN.SetSize 684, 552
			obj_chart.SetRect 5, 347, 679, 546

			order_btn.Visible = True
			chart_btn.Visible = True
			month.Visible = True
		ElseIf monthOpt.Data = "1" And chartOpt.Data = "1" Then
			'PANEL4.Visible = False
			'PANEL5.Visible = True
			PANEL4.SetRect 0, 342, 937, 551
			SCREEN.SetSize 937, 552
			obj_chart.SetRect 5, 347, 932, 546

			order_btn.Visible = False
			chart_btn.Visible = False
			month.Visible = False
		End If
	End If
End Sub

Sub ChangeCode()
	S40301.Trigger "", True
	S40301.Trigger "ed_focod", True
	S40301.Trigger "zFnoIsuNo", True
	SYSTEM.SetHistory "ed_focod", S40301.Data
	SYSTEM.SetHistory "zFnoIsuNo", S40301.Data
	SCREEN.Send 0
	obj.send
	obj_chart.Send
	obj2.Send
	OBJECT0.Send
End Sub

'기존코드 >= 현월물 = 기존코드
'기존코드 <  현월물 = 기존코드(앞 3자리) + 현월물(뒷 2자리) + 기존코드(뒤 3자리)
Sub ChangeOldMonth()
	bFirst = False

	Dim oldDivF, oldDivM, oldDivB, newDivF, newDivM, newDivB

	SCREEN.IgnoreChange True
	If Trim(S40301.Data) = "" Then
		SCREEN.GetCode 112, "40301", "40022", 0
	Else
		SCREEN.GetCode 112, "zFnoIsuNo1", "HNAM1", 0

		newDivF = Mid(Trim(zFnoIsuNo1.Data), 1, 3)
		newDivM = Mid(Trim(zFnoIsuNo1.Data), 4, 2)
		newDivB = Mid(Trim(zFnoIsuNo1.Data), 6, 3)

		oldDivF = Mid(Trim(S40301.Data), 1, 3)
		oldDivM = Mid(Trim(S40301.Data), 4, 2)
		oldDivB = Mid(Trim(S40301.Data), 6, 3)

		'SYSTEM.Trace "ChangeOldMonth : " & Trim(SCREEN.GetName(102, S40301.Data, 0))

		If Trim(SCREEN.GetName(102, S40301.Data, 0)) = "" Then
				S40301.Data = oldDivF & newDivM & oldDivB
				S40022.Data = SCREEN.GetName ("102", S40301.Data, 0)
		End If

	End If
	SCREEN.IgnoreChange False

	Call ChangeCode()
End Sub



Sub Onalert()
	up.Data = S40381.Data&"단계 상한 적용"
	down.Data = S40382.Data&"단계 하한 적용"
	If Trim(S41273.data) <> "0" And Trim(S41273.data) <> "" Then
		If Trim(S41274.Data) = "U" Then
			up.Data = S41273.Data&"단계 상한 예고"
			uTime = " "&Mid(S41275.Data,1,2)&":"&Mid(S41275.Data,3,2)
		ElseIf Trim(S41274.Data) = "D" Then
			down.Data = S41273.Data&"단계 하한 예고"
			dTime = " "&Mid(S41275.Data,1,2)&":"&Mid(S41275.Data,3,2)
		End If
	End If

	If Left(up.data,1) = "1" Then
		per1 = "(8%)"
	ElseIf(Left(up.data,1)) = "2" Then
		per1 = "(15%)"
	ElseIf(Left(up.data,1)) = "3" Then
		per1 = "(20%)"
	End If

	If Left(down.data,1) = "1" Then
		per2 = "(8%)"
	ElseIf(Left(down.data,1)) = "2" Then
		per2 = "(15%)"
	ElseIf(Left(down.data,1)) = "3" Then
		per2 = "(20%)"
	End If

	udata = Mid(up.data, 1,3) & per1 & Mid(up.Data, 5,5)
	ddata = Mid(down.data, 1,3) & per2 & Mid(down.Data, 5,5)
	tip.Data = "[KOSPI옵션 가격제한폭"&" "&udata&utime&" / "&ddata&dtime&"]"
End Sub

