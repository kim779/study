RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send()
	'SCREEN.Send 0
End Sub

Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = "IB425301"


Sub addRowToGrid(scode, sval)
	gridcom.InsertRow(0)
	gridcom.SetGridCell 1,1, scode
	gridcom.SetGridCell 1,2, sval
End Sub


Sub write_combo_history()
	Dim item, sVal, nRows
	JNAM.Clear

	items = ""

	nRows = gridcom.Rows
	For ii = 1 To gridcom.Rows
	 	sVal = Trim(gridcom.GetGridCell(nRows, 1)) & " " & Trim(gridcom.GetGridCell(nRows, 2))
	 	items = items & sVal & vbTab
	 	nRows = nRows - 1
SYSTEM.Trace "[4253] write_combo_history sVal = " & sVal
	Next

	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "combohistory", items
	End If
End Sub


Sub read_combo_history()
	SYSTEM.Trace "read_combo_history"
	gridcom.Clear
	JNAM.Clear
	Dim sComhis, arr, code, nam, version
	If SCREEN.CreateObject("Info") Then
		version =  Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "version"))

SYSTEM.Trace "[4253] read_combo_history version = " & version

		If version <> "1" Then
			INFO.pushData LOGIN.Name, myFILE, myMAP, "version", "1"
			INFO.pushData LOGIN.Name, myFILE, myMAP, "combohistory", ""
		End If

		sComhis = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "combohistory"))

SYSTEM.Trace "[4253] read_combo_history sComhis = " & sComhis

		If Len(Trim(sComhis)) > 0 Then
			arr = Split(sComhis, vbTab)

			For ii = 0 To UBound(arr)
				code = Left(arr(ii),3)
				nam = Mid(arr(ii),4)
				nam = Trim(nam)
				addRowToGrid code, nam
SYSTEM.Trace "[4253] read_combo_history code = " & code & " nam =" & nam
			Next

		'	JNAM.SetItems(sComhis)
		Else
SYSTEM.Trace "on data -> dosomething"
SYSTEM.Trace "[4253] read_combo_history sComhis no"
		'	cx_log.DoSomething "Get_SFCODE_VAL", "sfcode"
		End If

	End If
End Sub

_AW_ONSTART_AW_
SYSTEM.Trace "IB425301 onStart"
read_combo_history()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.Send = False

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Proc "parent.Get_Ini" , ""
SCREEN.Proc "parent.SelectRD" , ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(gridcom)
_AW_ONCLICK_AW_
If gridcom.HitPos = 3 Then
	If gridcom.Column = 3 Then
		gridcom.RemoveRow gridcom.Row - 1
		write_combo_history()
			sval = gridcom.GetGridText(1, 1) & vbTab & gridcom.GetGridText(1, 2)
		SYSTEM.Trigger "SetCode_IB425300", sval, "IB425300"
	Else
		sval = gridcom.GetGridText(gridcom.Row, 1) & vbTab & gridcom.GetGridText(gridcom.Row, 2)
		SYSTEM.Trigger "SetCode_IB425300", sval, "IB425300"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
If gridcom.HitPos = 3 Then
	sval = gridcom.GetGridText(gridcom.Row, 1) & vbTab & gridcom.GetGridText(gridcom.Row, 2)
	SYSTEM.Trigger "SetCode_IB425300", sval, "IB425300"
	SCREEN.CloseWindow
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
ret = MsgBox("전체내역 삭제하시겠습니까?", vbYesNo, "IBK투자증권")
If ret = vbYes Then
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "combohistory", ""
		gridcom.Clear
		sval = "" & vbTab & "49"
		SYSTEM.Trigger "SetCode_IB425300", sval, "IB425300"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



