Sub Set_Ptn()
	Dim Nxt, GR1
	For nxt = 1 To GRID0.Rows
		GR1 = GRID0.GetGridCell(nxt, 1)
		Select Case GR1
			Case "01"
				GRID0.SetGridCell nxt, 2, "주식형"
			Case "02"
				GRID0.SetGridCell nxt, 2, "주식혼합형"
			Case "03"
				GRID0.SetGridCell nxt, 2, "채권혼합형"
			Case "04"
				GRID0.SetGridCell nxt, 2, "채권형"
			Case "05"
				GRID0.SetGridCell nxt, 2, "신탁형"
			Case "06"
				GRID0.SetGridCell nxt, 2, "MMF"
			Case "07"
				GRID0.SetGridCell nxt, 2, "파생상품간접"
			Case "08"
				GRID0.SetGridCell nxt, 2, "부동산간접"
			Case "09"
				GRID0.SetGridCell nxt, 2, "실물간접"
			Case "10"
				GRID0.SetGridCell nxt, 2, "재간접"
			Case "11"
				GRID0.SetGridCell nxt, 2, "특별간접"
		End Select
	Next
End Sub

