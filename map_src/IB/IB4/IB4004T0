	ostart = 0
	Exit Sub
End If

ed_focod.Data = S40301.Data
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(30301)
_AW_ONCHANGE_AW_
If fstart = 1 Then
	fstart = 0
	Exit Sub
End If

ed_focod.Data = S30301.Data
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



