_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SYMBOL7)
_AW_ONCLICK_AW_
Dim ed_focod

ed_focod = SCREEN.GetCode (103, "ed_focod", "HNAM", 2)
If ed_focod <>  True Then
	Exit Sub
End If
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_focod)
_AW_ONCHANGE_AW_
