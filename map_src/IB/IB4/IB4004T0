RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim fstart, ostart
fstart = 1
ostart = 1

_AW_ONSEND_AW_
Dim code, fogb, rsymb

code = Left(ed_focod.Data, 1)
SCREEN.OnSend = False
If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
	fogb = 101
	rsymb = "30301"
	OBJ.SetObject("IB4004T1")
Else
	fogb = 102
	rsymb = "40301"
	OBJ.SetObject("IB4004T2")
End If
HNAM.Data = SCREEN.GetName (fogb, ed_focod.Data, 0)
If Trim(HNAM.Data) =  "" Then
	SCREEN.ClearAll 2, 0
	Exit Sub
End If

ed_focod.Trigger "ed_focod", True
ed_focod.Trigger rsymb, True
SYSTEM.SetHistory rsymb, ed_focod.Data
SYSTEM.SetHistory "ed_focod", ed_focod.Data

OBJ.Send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SYMBOL11)
_AW_ONCLICK_AW_
