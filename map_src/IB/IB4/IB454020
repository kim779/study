RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_SendFlag

g_SendFlag = False
'-----------------------------------------------------------------------
Sub GridClear()
	For i = 1 To 10
		GRID0.SetGridCell i, 7, ""
		GRID0.SetGridCell i, 8, ""
		GRID0.SetGridCell i, 9, ""
	Next
End Sub
'-----------------------------------------------------------------------
Function Str2Dbl(Data)
	Str2Dbl = 0
	AData = Trim(Data)
	If Len(AData) = 0 Then
		Exit Function
	End If
	Str2Dbl = CDbl(AData)
End Function
'-----------------------------------------------------------------------
Function Str2Int(Data)
	Str2Int = 0
	AData = Trim(Data)
	If Len(AData) = 0 Then
		Exit Function
	End If
	Str2Int = CLng(AData)
End Function
'-----------------------------------------------------------------------
Sub PushGridData()
	ArrData1 = Array("", "", 0, "", "", 0)

	ArrData2 = Array()
	ReDim ArrData2(GRID0.Rows)

	For i = 1 To GRID0.Rows
		ArrData1(0) = Trim(GRID0.GetGridCell(i, 1))
		ArrData1(1) = Trim(GRID0.GetGridCell(i, 2))
		ArrData1(2) = Str2Dbl(Trim(GRID0.GetGridCell(i, 5))) / 100
		ArrData1(3) = Trim(GRID0.GetGridCell(i, 6))
		ArrData1(4) = Trim(GRID0.GetGridCell(i, 4))
		ArrData1(5) = Str2Dbl(Trim(GRID0.GetGridCell(i, 3))) / 100
		ArrData2(i - 1) = Join(ArrData1, "^")
	Next

	Data = Join(ArrData2, "|")
	SCREEN.Proc "main.SetArrData", Data
End Sub
'-----------------------------------------------------------------------
Sub SendData()
	g_SendFlag = True
	S100301.Data = SCREEN.Object("main.100301").data
	SCREEN.Send 0
End Sub
'-----------------------------------------------------------------------
Sub SetGridData(Data)
	ArrData = Split(Data, "|")
	If ArrData(0) = "-1" Then
		Exit Sub
	End If
	If ArrData(0) = 0 Then
		GridClear
	End If
	GRID0.SetGridCell ArrData(0) + 1, 7, ArrData(1)
	GRID0.SetGridCell ArrData(0) + 1, 8, ArrData(2)
	GRID0.SetGridCell ArrData(0) + 1, 9, ArrData(3)
End Sub

_AW_ONSTART_AW_
'SendData

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
'GRID0.Clear
If g_SendFlag Then
	g_SendFlag = False
	GRID0.Clear
Else
	SCREEN.OnSend = False
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
PushGridData

ArrData3 = Array("", "", "", "")
ArrData3(0) = ot_CallRate.Data
ArrData3(1) = ot_CDRate.Data
ArrData3(2) = ot_MSB1.Data
RcvTime = Trim(ot_RcvTime.Data)
If Len(RcvTime) = 5 Then
	RcvTime = "0" & RcvTime
End If
RcvTime = Mid(RcvTime, 1, 2) & ":" & Mid(RcvTime, 3, 2) & ":" & Mid(RcvTime, 5, 2)
ArrData3(3) = RcvTime

GridClear
SCREEN.Proc "main.SetData", Join(ArrData3, "|")

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCHANGE_AW_
Data = GRID0.GetGridCell( GRID0.Row, GRID0.Column)
GRID0.SetGridCell GRID0.Row, GRID0.Column, Trim(Data)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_Date)
_AW_ONCHANGE_AW_
SendData
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


