Sub ar_code()
	Dim ii, code_cnt
	code_cnt = 0

	For ii = 0 To 3
		SCREEN.Object("scode" & ii).Data = ""
	Next

	For ii = 0 To 3
		If Trim(SCREEN.Object("code" & ii).Data) <> "" Then
			SCREEN.Object("scode" & code_cnt).Data = Trim(SCREEN.Object("code" & ii).Data)
			code_cnt = code_cnt + 1
		End If
	Next
End Sub


Sub sendTr(itype)
	If itype = 1then
