_AW_ONDECLARE_AW_
Dim num
num = 0
Function code_cnt()
	Dim kk, ii
	kk = 0
	For ii = 1  To HANG.Rows
	     If HANG.GetGridCell(ii, 2) = "1" Then
				kk = kk+1
		  End If
	     If HANG.GetGridCell(ii, 4) = "1" Then
				kk = kk+1
		  End If
	Next
	code_cnt = kk
End Function

Function Search_code(sCode)
	Dim ii
'SYSTEM.Trace "SRART"
	For ii = 0 To 3
		If StrComp(SCREEN.Object("main.code"&ii).data, sCode, 1) = 0 Then
			SCREEN.Object("main.code"&ii).data = ""
			Search_code = ii
		End If
	Next
'SYSTEM.Trace "SEARCH_CODE"&ii
End Function

Function Search_pos()
	Dim ii
	For ii = 0 To 3
		If Trim(SCREEN.Object("main.code"&ii).data) = "" Then
			Search_pos = ii
			Exit Function
		End If
	Next
End Function

Public Sub f_CheckGrid( sCode )
	Dim i
	For i = 1 To SCREEN.Object("MAIN.OBJ02.HANG").Rows
		If Trim(SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(i, 1)) = Trim(sCode) Then
			SCREEN.Object("MAIN.OBJ02.HANG").SetGridCell i, 2, "1"
		ElseIf Trim(SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(i, 5)) = Trim(sCode) Then
			SCREEN.Object("MAIN.OBJ02.HANG").SetGridCell i, 4, "1"
		ElseIf Trim(Trim(SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(i, 1))) = "" Then
			Exit Sub
		End If
	Next
End Sub

Public Function f_NumChecked()
	Dim i

	f_NumChecked = 0
	For i = 1 To SCREEN.Object("MAIN.OBJ02.HANG").Rows
		If HANG.GetGridCell(i, 2) = "1" Or HANG.GetGridCell(i, 2) = "-1" Then
			f_NumChecked = f_NumChecked + 1
		End If
		If HANG.GetGridCell(i, 4) = "1" Or HANG.GetGridCell(i, 4) = "-1" Then
			f_NumChecked = f_NumChecked + 1
		End If
		If Trim(HANG.GetGridCell(i, 1)) = "" Then Exit For
	Next
End Function

Public Function f_ClickGrid( lRowIdx, lColIdx )
	Dim ls_chk
	f_ClickGrid = 0
	ls_chk = Trim(HANG.GetGridCell(lRowIdx, lColIdx))
	If ls_chk = 1 Then
		If lColIdx = 2 Then
			ls_codx = Trim(HANG.GetGridCell(lRowIdx, lColIdx - 1 ))
		ElseIf lColIdx = 4 Then
			ls_codx = Trim(HANG.GetGridCell(lRowIdx, lColIdx + 1 ))
		End If

		If Trim(ls_codx) = "" Then
			HANG.SetGridCell lRowIdx, lColIdx , "0"
			f_ClickGrid = 1
		End If

		ls_cnt = f_NumChecked
		If ls_cnt > 4 Then
			MsgBox("최대 선택가능한 종목갯수는 4개 입니다.")
			HANG.SetGridCell lRowIdx, lColIdx , "0"
			f_ClickGrid = 1
		End If
	End If
End Function

