_AW_ONDECLARE_AW_
Private Sub loadUserConfig()
	If SCREEN.CreateObject("Info") Then
		str1  = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB430600", "GUBN"))
		If str1 = "" Then
		    	saveUserConfig()
		Else
			GUBN.Data = str1
			Select Case GUBN.Data
			Case "1"
				RADIO0.Checked = True
				ilja.Enable = True
			Case "2"
				RADIO1.Checked = True
				ilja.Enable = False
			Case Else
			End Select

			FOGB.data = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB430600", "FOGB"))
			If FOGB.Data = "2" Then
				RADIO2.checked = True
			Else
				RADIO3.checked = True
			End If
			RANG1.data = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB430600", "RANG1"))
			RANG2.data = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB430600", "RANG2"))
		End If
	End If
End Sub

Private Sub saveUserConfig()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, "userconf.ini", "IB430600", "GUBN",  GUBN.Data
		INFO.pushData LOGIN.Name, "userconf.ini", "IB430600", "FOGB",  FOGB.Data
		INFO.pushData LOGIN.Name, "userconf.ini", "IB430600", "RANG1", RANG1.Data
		INFO.pushData LOGIN.Name, "userconf.ini", "IB430600", "RANG2", RANG2.Data
	End If
End Sub

Private Sub Obj_Send()
    saveUserConfig()
    OBJ1.Send
    OBJ2.Send
    OBJ3.Send
    OBJ4.Send
    OBJ5.Send
    OBJ6.Send
    OBJ7.Send
    OBJ8.Send
    OBJ9.Send
End Sub

