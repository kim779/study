'*********************************************************************************
'* 주문후 환결설정
'*********************************************************************************
Sub Set_option
	Dim jprc, jqty
	'**********************************************************************
	' Main 주문설정 적용
	'**********************************************************************
	If OrdCfg.KeepPrc = True	Then		'주문후 단가저장
		jprc = Trim(ed_jprc.Data)
		If is_numeric(jprc) = True Then
			OrdCfg.Price = CDbl(ed_jprc.Data)
			SCREEN.Object(objnm & ".ed_jprc").data = OrdCfg.Price
		End If
	Else
		SCREEN.Object(objnm & ".ed_jprc").data = ""
	End If

	If OrdCfg.KeepQty = True	Then		'주문후 수량저장
		jqty = Trim(ed_jqty.Data)
		If is_numeric(jqty) = True Then
			OrdCfg.Qty = CDbl(ed_jqty.Data)
			SCREEN.Object(objnm & ".ed_jqty").data = OrdCfg.Qty
		End If
	Else
		SCREEN.Object(objnm & ".ed_jqty").data = ""
	End If
	'**********************************************************************
	'0101화면의 주문설정
	'**********************************************************************
	'주문후 focus 위치
	Select Case SCREEN.Object(objnm & ".OrdCfg").ReadCfg("CursorPos")
		Case 0			'계좌번호
			If Trim(SCREEN.Object("parent.tab_order").text) = "신용매도" Then
				SCREEN.Object("parent.AN11").Setfocus
			Else
				SCREEN.Object("parent.AN1A").Setfocus
			End If
		Case 1			'비밀번호
			SCREEN.Object("parent.ed_pswd").Setfocus
		Case 2			'종목코드
			SCREEN.Object(objnm & ".1301").Setfocus
		Case 3			'수량
			SCREEN.Object(objnm & ".ed_jqty").Setfocus
		Case 3			'단가
			SCREEN.Object(objnm & ".ed_jprc").Setfocus
		Case Else
			If Trim(SCREEN.Object("parent.tab_order").text) = "신용매도" Then
				SCREEN.Object("parent.AN11").Setfocus
			Else
				SCREEN.Object("parent.AN1A").Setfocus
			End If
	End Select
	'**********************************************************************
End Sub


