RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim rowcnt

Sub send_f()
	rowcnt = 1
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0050"
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

Dim dept, common_nm
If SCREEN.CreateObject("Info") Then
	dept = Trim(INFO.PopData("", "ACCNTDEPT.INI", "ACCNTDEPT", "DEPT"))
	common_nm = Trim(INFO.PopData("", "ACCNTDEPT.INI", "ACCNTDEPT", "COMMONNM"))
End If

EmpNo.Data = "9" & dept & common_nm

If Len(Trim(EmpNo.Data)) < 6 Then
	MsgBox "사원번호를 확인하세요.", , "IBK투자증권"
	EmpNo.SetFocus
	Exit Sub
End If

'MsgBox LEDGER.Fkey, 0, ""
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, tmpNm, ecod
ecod = Trim(LEDGER.Ecod)

If Is_numeric(ecod) = False Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
	If LEDGER.Next = "Y" Then
		next_btn.Enable = True
		next_btn.SetFocus
	Else
		next_btn.Enable = False
		send_btn.SetFocus
	End If

	For ii = rowcnt To GRID0.Rows
		GRID0.SetGridCell ii, 5, Trim(GRID0.GetGridCell(ii, 5))
		GRID0.SetGridCell ii, 8, Trim(GRID0.GetGridCell(ii, 8))

		'계좌명 툴팁처리시 계좌명에 &가 있을경우 툴팁에 언더바로 표시되어 교체
		tmpNm = Trim(GRID0.GetGridCell(ii, 4))

		If tmpNm <> "" Then
			If InStr(tmpNm, "&") > 0 Then
				GRID0.SetGridCell ii, 4, Replace(tmpNm, "&", "＆")
			End If
		End If
	Next

	rowcnt = ii
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zQrySrtDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zQryEndDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


