_AW_ONDECLARE_AW_

Sub SetData(sData)
	SCREEN.ClearAll 0 , 2

'	SYSTEM.Trace "sData[" & sData & "]"

	Dim arrLine, arrField, nCount, ii
	arrLine = Split(sData, vbTab, -1, 1)

	nCount = arrLine(0)
	zIn2.Data = zeropad(nCount, 5)
	GRID0.SetRows Int(nCount)

'	SYSTEM.Trace "arrLine0[" & arrLine(0) & "]"

	zAcntNo.Data = Trim(arrLine(1))
	zInptPwd.Data = Trim(arrLine(2))

'	SYSTEM.Trace "arrLine1[" & arrLine(1) & "]"
'	SYSTEM.Trace "arrLine2[" & arrLine(2) & "]"

	For ii = 1 To nCount
		arrField = Split(arrLine(ii+2), "|", -1, 1)

'		SYSTEM.Trace "arrLine" & ii+2 & "[" & arrLine(ii+2) & "]"

		If ii <> 1 Then
			GRID0.InsertRow(ii)
		End If

		GRID0.SetGridCell ii, 1, 1
		GRID0.SetGridCell ii, 2, arrField(0)
		GRID0.SetGridCell ii, 3, arrField(2)
		GRID0.SetGridCell ii, 4, arrField(4)
	Next

	SCREEN.Send 0
End Sub

Function zeropad(str, length)
	Dim strTemp
	strTemp = Trim(str)
	If strTemp = "" Then
		zeropad = ""
		Exit Function
	End If
	zeropad = String(length - Len(strTemp), "0") & strTemp
End Function

