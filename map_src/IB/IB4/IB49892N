_AW_ONCLICK_AW_
Dim Code,Fname
Select Case GRID0.HitPos
Case 3	'DATA부 click
	If GRID0.Column = 8 Then
		Code = Trim(GRID0.GetGridCell(GRID0.ROW, 1))
		Fname = Trim(GRID0.GetGridCell(GRID0.ROW, 2))
		If Len(Code) > 0 Then
			'MsgBox Code & "|" & Fname
			SYSTEM.Push "IB49892N_JOIN" , Code & "|" & Fname
			SYSTEM.Push "IB49892N_OK" , Code & "|" & Fname
			SCREEN.CloseWindow
		End If

	End If
Case Else
	SCREEN.OnSend = False
	Exit Sub
End Select
