_AW_ONDECLARE_AW_
Dim save
Sub Query_Chart()
	ctl0.ClearAllData

	ctl0.SetChartPeriod 1, 2
	ctl0.Setticksize 0, 0.01
	ctl0.SetInputValue 0,1, "41301", Trim(S40301.Data)
	ctl0.RequestData 0,1
End Sub

_AW_ONSEND_AW_
Dim code, name

code = Left(S40301.Data, 1)

If code = "2" Or code = "3" Or code = "B" Or code = "C" Then
	name = SCREEN.GetName (102, S40301.Data, 0)
	If Trim(name) =  "" Then
		S40301.Data = ""
	Else
		If StrComp(save, Trim(S40301.Data), 1) <> 0 Then
			S40301.Trigger "ed_focod", True
			S40301.Trigger "40301", True
			SYSTEM.SetHistory "ed_focod", S40301.Data
			'Query_Chart()
			OBJECT0.Send
			save = Trim(S40301.Data)
		End If
	End If
Else
	SCREEN.ClearAll 2, 0
	SCREEN.OnSend = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(40301)
_AW_ONCHANGE_AW_
SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


