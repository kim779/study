RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub Find_fund()
	Dim ii, pos
	pos = 0

	For ii = GRID1.rows To 1 Step -1
		pos = InStr(Trim(GRID1.GetGridCell(ii, 2)), Trim(search_fund.data))

		If pos = 0 Then
			GRID1.RemoveRow ii-1
		End If
	Next
End Sub

_AW_ONSTART_AW_
SYSTEM.Push "fundmsg", "NO"
LEDGER.Rcnt = "0090"
send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	send_c()
Else
	If Trim(search_fund.Data) <> "" Then
		Call Find_fund()
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call Find_fund()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID1)
_AW_ONDBLCLK_AW_
Dim msg

msg = GRID1.GetGridCell(GRID1.row, 1) & "|" & GRID1.GetGridCell(GRID1.Row, 2)
If Trim(GRID1.GetGridCell(GRID1.row, 1)) <> "" Then
	SYSTEM.Push "fundmsg", msg
End If
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_

Dim msg

msg = GRID1.GetGridCell(GRID1.row, 1) & "|" & _
	GRID1.GetGridCell(GRID1.row, 2)
If Trim(GRID1.GetGridCell(GRID1.row, 1)) <> "" Then
	SYSTEM.Push "fundmsg", msg
End If
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(search_fund)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If chk.Checked = False Then
		Call send_f()
	Else
		Call Find_fund()
		GRID1.SetFocus
		GRID1.Index = 1
		GRID1.Index = 0
	End If
	'SCREEN.SetTimer 4, False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
If chk.Checked = False Then
	Call send_f()
Else
	Call Find_fund()
	GRID1.SetFocus
	GRID1.Index = 1
	GRID1.Index = 0
End If
'SCREEN.SetTimer 4, False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(chk)
_AW_ONCLICK_AW_
search_fund.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


