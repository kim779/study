	'0:인덱스, 1:국채단가, 2:선도가격, 3:선도금리
	ArrData2 = Array (-1, "", "", "")
	For i = LBound(g_ArrData) To UBound(g_ArrData)
		If Len(g_ArrData(i)(0)) = 0 Then
			Exit For
		End If

		'0:전이자락일, 1:차기이자락일, 2:표면이율,
		'3:이표금액, 4:상환금액
