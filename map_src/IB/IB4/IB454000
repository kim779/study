		ArrBond = Array(BondElem, BondElem, BondElem, BondElem, BondElem)
		ArrBond(i)(0) = g_ArrData(i)(0)
		ArrBond(i)(1) = g_ArrData(i)(1)

		GetTheoPrice InInfor, ArrTheoPrc(i), ArrBond, i, 24
		MeanYield = MeanYield + ArrTheoPrc(i)(0)
		PreYield = PreYield + ArrTheoPrc(i)(1)

		ArrData2(0) = i
		ArrData2(1) = FormatNumber(ArrBond(i)(2), 2, -2, -2, 0)
		ArrData2(2) = FormatNumber(ArrBond(i)(3), 2, -2, -2, 0)
		ArrData2(3) = FormatNumber(Arrbond(i)(4), 2, -2, -2, 0)

		Data = Join(ArrData2, "|")


		OBJECT1.Proc "SetGridData", Data
		ArrData2(0) = -1
	Next

	If i = 0 Then
		i = 1
	End If

	MeanYield = MeanYield / CDbl(i)
	PreYield = PreYield / CDbl(i)

	If Mid(S100301.Data, 1, 3) = "165" Then	' 3년국채
		Seq = 6
	ElseIf Mid(S100301.Data, 1, 3) = "166" Then	' 5년국채
		Seq = 10
	ElseIf Mid(S100301.Data, 1, 3) = "167" Then	' 10년국채
		Seq = 20
	ElseIf Mid(S100301.Data, 1, 3) = "170" Then	' 30년국채
