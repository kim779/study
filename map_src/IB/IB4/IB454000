	TABLE1.SetTableCell 3, FormatNumber(PreYield, 2, -2, -2, 0)
End Sub
'-----------------------------------------------------------------------
Sub GetTheoPrice(InInfor, TheoElem, ArrBond, BondIndex, NumArray)
	PrevDate = InInfor(8)
	i = 0
	SYSTEM.Trace "CLng(PrevDate) : "&CLng(PrevDate)
	SYSTEM.Trace "CLng(InInfor(9)):"&CLng(InInfor(9))
	Do While (i < NumArray And CLng(PrevDate) < CLng(InInfor(9)))
		InInfor(17)(i)(0) = PrevDate
		InInfor(17)(i)(1) = AfterCouponDay(InInfor(11), InInfor(8), i + 1, InInfor(9))
		InInfor(17)(i)(2) = InInfor(10)
		InInfor(17)(i)(3) = 10000 * InInfor(10) / CDbl(InInfor(15))

		PrevDate = InInfor(17)(i)(1)
		i = i + 1
	Loop
	InInfor(16) = i
	SYSTEM.Trace "i:"&i
	InInfor(17)(i - 1)(4) = 10000

	InInfor(18) = GetBondPrice(InInfor)

	TrdDays = GetDays(InInfor(0), InInfor(7))
	Inter = 0
	For i = 0 To InInfor(16)
		Temp = InInfor(17)(i)(1)
		If Len(Temp) = 0 Then
			Temp = 0
		Else
			Temp = CLng(Temp)
		End If

		If Temp <= CLng(InInfor(7)) And Temp > CLng(InInfor(0)) Then
			t = GetDays(InInfor(0), InInfor(17)(i)(1))
			If t <= 91 Then
				InInfor(12) = InInfor(4) + (InInfor(5) - InInfor(4)) / (91 - 1) * (t - 1)
			Else
				InInfor(12) = InInfor(5) + (InInfor(6) - InInfor(5)) / (365 - 91) * (t - 91)
			End If
			Inter = Inter + InInfor(17)(i)(3)/(1 + InInfor(12) * t / 365)
		End If
	Next

	If TrdDays <= 91 Then
		InInfor(12) = InInfor(4) + (InInfor(5) - InInfor(4)) / (91 - 1) * (TrdDays - 1)
	Else
		InInfor(12) = InInfor(5) + (InInfor(6) - InInfor(5)) / (365 - 91) * (TrdDays - 91)
	End If
	InInfor(19) = (InInfor(18) - Inter) * (1 + InInfor(12) * TrdDays / 365)
	TempInInfor = InInfor

	InInfor(20) = ForwdYield(TempInInfor, InInfor(19))
	InInfor(20) = InInfor(20) * 100
	InInfor(19) = InInfor(19) / 100
	InInfor(18) = InInfor(18) / 100

	TheoElem(0) = InInfor(3) * 100
	TheoElem(1) = InInfor(20)

	ArrBond(BondIndex)(2) = InInfor(18)
	ArrBond(BondIndex)(3) = InInfor(19)
	ArrBond(BondIndex)(4) = InInfor(20)

End Sub
'-----------------------------------------------------------------------
Function AfterCouponDay(IntMethod, IssueDate, Num, FutExpiDate)
    IssueDate_ = TranDate(IssueDate)
    LastDay = TranDate(FutExpiDate)
    NextDate = DateAdd("m", CLng(IntMethod) * Num, IssueDate_)

    If NextDate > LastDay Then
        AfterCouponDay = GetDateToStr(LastDay)
    Else
        AfterCouponDay = GetDateToStr(NextDate)
    End If
End Function
'-----------------------------------------------------------------------
Function GetBondPrice(InInfor)
    StandardDate = InInfor(0)
    I = 0
    Do While (I < InInfor(16) And CLng(InInfor(17)(I)(1)) <= CLng(StandardDate))
        I = I + 1
    Loop
    If Len(InInfor(17)(I)(1)) = 0 Then
        I = I - 1
    End If


    InInfor(13) = GetDays(InInfor(17)(I)(0), InInfor(17)(I)(1))

    If CLng(StandardDate) < CLng(InInfor(8)) Then

        InInfor(14) = GetDays(InInfor(8), InInfor(17)(I)(1))

    Else

        InInfor(14) = GetDays(StandardDate, InInfor(17)(I)(1))

    End If

    DiscountFactor = 1 + (InInfor(3) / CDbl(InInfor(15)) _
        * (CDbl(InInfor(14)) / CDbl(InInfor(13))))
    temp1 = 1 + InInfor(3) / CDbl(InInfor(15))
    temp2 = CDbl(InInfor(14)) / CDbl(InInfor(13))
    j = 0
    temp5 = 0
    Do While (j <= InInfor(16) - I)
        k = I + j
        temp2 = j
        temp3 = temp1 ^ temp2
        SYSTEM.Trace "temp3:"&temp3
        SYSTEM.Trace "k:"&k
        SYSTEM.Trace "j:"&j
        SYSTEM.Trace "InInfor(16):"&InInfor(16)
        SYSTEM.Trace "InInfor(17)(k)(3):"&InInfor(17)(k)(3)
        temp5 = (InInfor(17)(k)(3) + InInfor(17)(k)(4)) / temp3
        InInfor(18) = InInfor(18) + temp5
        j = j + 1
    Loop
    InInfor(18) = InInfor(18) / DiscountFactor
    GetBondPrice = InInfor(18)

End Function
'-----------------------------------------------------------------------
Function GetDays(StrDate1, StrDate2)
    GetDays = DateDiff("d", TranDate(StrDate1), TranDate(StrDate2))
End Function
'-----------------------------------------------------------------------
Function TranDate(SrcDate)
    TranDate = ""
    If Len(SrcDate) <> 8 Then
        Exit Function
    End If
    StrDate = Mid(SrcDate, 1, 4) & "-" & Mid(SrcDate, 5, 2) & "-" & Mid(SrcDate, 7, 2)
    MyDate = CDate(StrDate)
    MyDate = DateAdd("m", 1, MyDate)
    TranDate = StrDate
End Function
'-----------------------------------------------------------------------
Function GetDateToStr(SrcDate)
    GetDateToStr = Mid(SrcDate, 1, 4) & Mid(SrcDate, 6, 2) & Mid(SrcDate, 9, 2)
End Function
'-----------------------------------------------------------------------
Function GetLog(dX, iY)
	' 이론가 계산

    Yield = dX * 0.01
    Sequence = iY

    rate0 = 1 / (1 + (Yield / 2))
    rate1 = 1
    rate2 = 1

    For I = 1 To Sequence
        rate1 = rate1 * rate0
        ' 3년국채, 5년국채, 10년국채, 30년국채 :: 5/2
        If Mid(S100301.Data, 2, 2) = "65" Or Mid(S100301.Data, 2, 2) = "66" Or Mid(S100301.Data, 2, 2) = "67" Or Mid(S100301.Data, 2, 2) = "70" Then
        	a = (5 / 2) * rate1
        Else
        	a = (8 / 2) * rate1
        End If
        b = b + a
    Next

    For I = 1 To Sequence
        rate2 = rate2 * rate0
    Next

    c = rate2 * 100

    FuturePrice = b + c

    GetLog = FuturePrice
End Function
'-----------------------------------------------------------------------
Function ForwdYield(InterInfor, iTempPrice)
    InitY = 16
    PreY = -99
    HighY = 256
    LowY = 0
    Do While (1)
        StandardDate = InterInfor(7)
        InterInfor(3) = InitY
        TempPrice = 0
        I = 0
        Do While (I < InterInfor(16) And CLng(InterInfor(17)(I)(1)) <= CLng(StandardDate))
            I = I + 1
        Loop
        If Len(InterInfor(17)(I)(1)) = 0 Then
            I = I - 1
        End If

        InterInfor(13) = GetDays(InterInfor(17)(I)(0), InterInfor(17)(I)(1))
        InterInfor(14) = GetDays(StandardDate, InterInfor(17)(I)(1))
        DiscountFactor = 1 + (InterInfor(3) / CDbl(InterInfor(15))) _
            * (CDbl(InterInfor(14)) / CDbl(InterInfor(13)))
        temp1 = 1 + InterInfor(3) / CDbl(InterInfor(15))
        j = 0
        Do While (j <= InterInfor(16) - I)
            k = I + j
            temp2 = j
            temp3 = temp1 ^ temp2
            TempPrice = TempPrice + (InterInfor(17)(k)(3) + InterInfor(17)(k)(4)) / temp3
            j = j + 1
        Loop

         TempPrice = TempPrice / DiscountFactor
        ForwdTempPrice = TempPrice

        If (InitY < 0.00000001) Then
            ForwdYield = InitY

            Exit Function
        End If

        If (InitY > 255.99999999) Then
            ForwdYield = InitY

            Exit Function
        End If

        TOL = InitY - PreY
        If TOL < 0 Then
            If -TOL < 0.00000001 Then
                ForwdYield = InitY

                Exit Function
            End If
        Else
            If TOL < 0.00000001 Then
                ForwdYield = InitY

                Exit Function
            End If
        End If
        PreY = InitY

        If iTempPrice > ForwdTempPrice Then
            HighY = InitY
            InitY = (InitY + LowY) / 2

        ElseIf iTempPrice < ForwdTempPrice Then
            LowY = InitY
            InitY = (InitY + HighY) / 2

        Else
            ForwdYield = InitY

            Exit Function
        End If

    Loop
    ForwdYield = 0

End Function

