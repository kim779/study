			ArrConItem, ArrConItem, ArrConItem, ArrConItem,_
			ArrConItem, ArrConItem, ArrConItem, ArrConItem,_
			ArrConItem, ArrConItem, ArrConItem, ArrConItem,_
			ArrConItem, ArrConItem, ArrConItem, ArrConItem,_
			ArrConItem, ArrConItem, ArrConItem, ArrConItem,_
			ArrConItem, ArrConItem, ArrConItem, ArrConItem,_
			ArrConItem, ArrConItem, ArrConItem, ArrConItem _

		)

		'0:매매일자, 1:선물코드, 2:채권코드,
		'3:유통수익률, 4:콜금리, 5:CD금리
		'6:통안채1년, 7:선물만기일, 8:채권발행일,
		'9:채권만기일, 10:표면이율, 11:이자지급방법
		'12:InterpollRate, 13:기준일수, 14:잔존일수
		'15:년간이자지급횟수, 16:총이자지급횟수, 17:채권가격용
		'18:채권가격, 19:선도가격, 20:선도금리

		InInfor = Array(S12901_D.Data, S100301.Data, g_ArrData(i)(0), _
			g_ArrData(i)(2), Str2Dbl(ed_Call.Data)/10000, Str2Dbl(ed_CD.Data)/10000, _
			Str2Dbl(ed_MSB.Data)/10000, ed_FutExpiDate.Data, g_ArrData(i)(3), _
			g_ArrData(i)(4), g_ArrData(i)(5), g_ArrRate(0), _
			0, 0, 0, _
			g_ArrRate(1), 0, ArrContents, _
			0, 0, 0)

		'0:현물금리, 1:선도금리
		TheoElem = Array(0, 0)
		ArrTheoPrc = Array(TheoElem, TheoElem, TheoElem, TheoElem, TheoElem)

		'0:채권종목코드, 1:채권명, 2:채권가격,
		'3:선도가격, 4:선도금리
