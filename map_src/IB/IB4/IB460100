	next_btn.Enable = True
	next_btn.SetFocus
Else
	next_btn.Enable = False
	send_btn.SetFocus
End If

Dim ii, mmgb, tmpNm

For ii = gridPos To viewGrid.Rows
	mmgb = Trim(viewGrid.GetGridCell(ii, 4))

	If mmgb = "매수" Then
		mmgb = "+" & mmgb
	ElseIf mmgb = "매도" Then
		mmgb = "-" & mmgb
	End If

	'계좌명 툴팁처리시 계좌명에 &가 있을경우 툴팁에서 언더바로 표시되어 수정 2010.03.19
	tmpNm = Trim(viewGrid.GetGridCell(ii, 2))

	If InStr(tmpNm, "&") > 0 Then
		viewGrid.SetGridCell ii, 2, Replace(tmpNm, "&", "＆")
	End If


	viewGrid.SetGridCell ii, 4, mmgb
Next

