	If Left(Trim(ed_fcod.Data), 1) = "1" Or Left(Trim(ed_fcod.Data), 1) = "4" Or _
	   Left(Trim(ed_fcod.Data), 1) = "A" Or Left(Trim(ed_fcod.Data), 1) = "D" Then
