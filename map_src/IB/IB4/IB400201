_AW_ONDECLARE_AW_
Set re1 = New RegExp
re1.Global = True
re1.IgnoreCase = True
re1.MultiLine = True
re1.Pattern = "[^0-9]"

Set re2 = New RegExp
re2.Global = True
re2.IgnoreCase = True
re2.MultiLine = True
re2.Pattern = "[^0-9\-]"

Dim g_Arrdata, xval, yval, zval, gA
Dim adist, bdist, spos, signwidth, nBottom, nIndex
adist = 0
bdist = 5
signwidth = 17
nBottom = 35
gA = Array(35, 78, 78, 91, 111, 121)

g_Arrdata = Array(_
Array(2,  gA(0), gA(0)+adist, gA(0)+adist+signwidth, gA(0)+adist+signwidth-3, gA(0)+adist+signwidth-3+bdist),_
Array(3,  gA(1), gA(1)+adist, gA(1)+adist+signwidth, gA(1)+adist+signwidth-3, gA(1)+adist+signwidth-3+bdist),_
Array(4,  gA(2), gA(2)+adist, gA(2)+adist+signwidth, gA(2)+adist+signwidth-3, gA(2)+adist+signwidth-3+bdist),_
Array(5,  gA(3), gA(3)+adist, gA(3)+adist+signwidth, gA(3)+adist+signwidth-3, gA(3)+adist+signwidth-3+bdist),_
Array(6,  gA(4), gA(4)+adist, gA(4)+adist+signwidth, gA(4)+adist+signwidth-3, gA(4)+adist+signwidth-3+bdist),_
Array(7,  gA(5), gA(5)+adist, gA(5)+adist+signwidth, gA(5)+adist+signwidth-3, gA(5)+adist+signwidth-3+bdist))

Sub Onalert()
	Dim drate
	sign.Data = Left(Trim(tDiff.GetTableCell(1)), 1)
	
	If Trim(tDiff.GetTableCell(1)) = "0.00" Then
		diff.Data = "0"
	Else
		diff.Data = Trim(tDiff.GetTableCell(1))
	End If

	diff.TRgb = sign.TRgb
	curr.Data = Trim(tDiff.GetTableCell(2))
	If Len(Trim(tDiff.GetTableCell(3))) > 0 Then
		drate = CDbl(Trim(tDiff.GetTableCell(3)))
	Else
		drate = 0.0
	End If

	If drate = 0.0 Then
		rate.Data = ""
	Else
		rate.Data = Trim(tDiff.GetTableCell(3))&"%"
	End If

	gvol.Data = Trim(tDiff.GetTableCell(4))

	If Left(Trim(tDiff.GetTableCell(1)), 1) = "2" Or Left(Trim(tDiff.GetTableCell(1)), 1) = "5" Then
		spos = 2
	Else
		spos = 0
	End If
	xval = re1.Replace(tDiff.GetTableCell(2), "")
	yval = difflen(Len(re1.Replace(diff.Data, "")))
	zval = ratelen(Len(re2.Replace(rate.Data, "")))
	'curr.SetRect
	If  Len(xval) <= 2 Then
		nIndex = 0
		curr.SetRect 0,					   0, 		g_Arrdata(0)(1), 		   nBottom
		sign.SetRect g_Arrdata(0)(2),      0, g_Arrdata(0)(3),          nBottom
		diff.SetRect g_Arrdata(0)(4),      0,      g_Arrdata(0)(4)+yval,      nBottom
		rate.SetRect g_Arrdata(0)(5)+yval, 0,      g_Arrdata(0)(5)+yval+zval, nBottom
	ElseIf Len(xval) = 3 Then
		nIndex = 1
	ElseIf Len(xval) = 4 Then
		nIndex = 2
	ElseIf Len(xval) = 5 Then
		nIndex = 3
	ElseIf Len(xval) = 6 Then
		nIndex = 4
	ElseIf Len(xval) > 6 Then
		nIndex = 5
	End If

	curr.SetRect 0,                    		0,  	g_Arrdata(nIndex)(1),           nBottom
	sign.SetRect g_Arrdata(nIndex)(2),      0, 		g_Arrdata(nIndex)(3),           nBottom
	diff.SetRect g_Arrdata(nIndex)(4),      0,      g_Arrdata(nIndex)(4)+yval,      nBottom
	rate.SetRect g_Arrdata(nIndex)(5)+yval, 0,      g_Arrdata(nIndex)(5)+yval+zval, nBottom

End Sub

Function ratelen(parm)
	If parm <= 3 Then
		ratelen = 54
	ElseIf parm = 4 Then
		ratelen = 63
	ElseIf parm = 5 Then
		ratelen = 72
	ElseIf parm = 6 Then
		ratelen = 81		'6초과 추후 보정
	ElseIf parm > 6 Then
		ratelen = 63
	End If
End Function

Function difflen(parm)
	If parm =1 Then
		difflen = 15
	ElseIf parm = 2 Then
		difflen = 24
	ElseIf parm = 3 Then
'		difflen = 33
		difflen = 40
	ElseIf parm = 4 Then
'		difflen = 46
		difflen = 53
	ElseIf parm = 5 Then
'		difflen = 54
		difflen = 66
	ElseIf parm = 6 Then	'6, 6 > 추후 보정
'		difflen = 63
		difflen = 70
	ElseIf parm > 6 Then
'		difflen = 63
		difflen = 70
	End If
End Function

_AW_ONSEND_AW_
S40301.Data = SCREEN.object("main.40301").Data
If Len(Trim(S40301.Data)) <> 8 Then
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Call Onalert()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(40301)
_AW_ONCHANGE_AW_
