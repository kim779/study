RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim read_f
'== 계좌명, 비밀번호 설정
Sub Set_account()
	ACNM.Data = AN55.Name
	zPwd.Data = AN55.Password
	If Trim(AN55.Data) = "" Then
		AN55.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
SCREEN.OnSend = False

LEDGER.Fkey = "C"
LEDGER.Rcnt = "0015"
zPwd.Data = "9999"	'HTS는 검증안함.

If Trim(FUNDNAME.Data) = "" Then
	MsgBox "펀드를 조회하십시오", , "IBK투자증권"
	Exit Sub
End If

zAcntTp.Data = 2
zAcntNo.Data = AN55.data & zSub.Data

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then

	If SCREEN.GetMapName(1) = "IB498925" Then
		SCREEN.Object("parent.parent.newFundJoin").Text = "N"
		SYSTEM.Trigger "newFundJoinSend", Trim(AN55.Data), "IB498900"
	End If
ElseIf Left(Trim(LEDGER.Emsg), 4) <> "2679" Then	'조회내역없을때는 보여주지 않
	MsgBox Trim(LEDGER.Emsg), , "IBK투자증권"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN55)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(search_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(fundbtn)
_AW_ONCLICK_AW_
Dim msg, fund

SYSTEM.Push "fundno", ""
SCREEN.CreateWindow 2, "IB498991 /t/d/p5/S", _
		"zAcntNo" & vbTab & Trim(AN55.Data) & vbLf & _
		"AcntNo" & vbTab & Trim(AN55.Data) & vbLf & _
		"zPwd" & vbTab & zPwd.Data & vbLf & _
		"ACNM" & vbTab & ACNM.Data

msg = SYSTEM.Pop("fundno")
If msg = "NO" Then
	Exit Sub
End If

fund = Split(msg, "|")
FUNDNAME.Data = fund(1)
zSub.Data = fund(2)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



