_AW_ONDECLARE_AW_
Dim combo_state

Sub Set_Grid_Color()
	Dim nCol, nRow, nIndex


	If combo_state = "1" Then
		For nCol = 2 To S63500.Columns
			For nRow = 1 To S63500.Rows
				S63500.SetTRgb nRow, nCol, 95
			Next
		Next

	ElseIf combo_state = "2" Then
		For nCol = 2 To S63500.Columns
			For nRow = 1 To S63500.Rows
				S63500.SetTRgb nRow, nCol, 94
			Next
		Next

	ElseIf combo_state = "3" Then
		For nCol = 2 To S63500.Columns
			For nRow = 1 To S63500.Rows
				nIndex = InStr(1, S63500.GetGridText(nRow, nCol), "-", 1)
				If nIndex > 0  Then
					S63500.SetTRgb nRow, nCol, 95
				Else
					S63500.SetTRgb nRow, nCol, 94
				End If
			Next
		Next
	End If
End Sub

