Sub Onalert()
	Dim f, s, out

	If Trim(S104310.GetGridCell (1, 8)) = "" Then
		f = 0
	Else
		f = CDbl(Trim(S104310.GetGridCell (1, 8)))
	End If

	If Trim(S104310.GetGridCell (2, 8)) = "" Then
		s = 0
	Else
		s = CDbl(Trim(S104310.GetGridCell (2, 8)))
	End If

	out = f - s
	If out > 0 Then
		S104310.SetGridCell 1, 7, "+" & out
	ElseIf out < 0 Then
		S104310.SetGridCell 1, 7, "-" & out
	Else
		S104310.SetGridCell 1, 7, " " & out
	End If
End Sub

