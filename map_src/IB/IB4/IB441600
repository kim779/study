_AW_ONDECLARE_AW_

Function Nullcheck(Data)
	Nullcheck = Data
	If Trim(Nullcheck) = "" Then
		Nullcheck = 0
	End If
End Function

Function SetSign(Data)
	SetSign = Data
	If Data > 0 Then
		SetSign = "+" & Data
	End If
End Function

Function idx(data)
	idx = data
	Select Case Fix(idx)
		Case 9
			idx = 1
		Case 8
			idx = 2
		Case 0
			idx = 3
		Case 1
			idx = 4
		Case 2
			idx = 5
		Case 3
			idx = 6
		Case 4
			idx = 7
		Case 5
			idx = 8
		Case 6
			idx = 9
		Case 12
			idx = 10
		Case 13
			idx = 11
		Case 7
			idx = 12
	End Select
End Function

Sub ProcSetData(Data)
	Dim id
	obj0.Send
	obj1.Send
	ArrData = Split(Data, "|")

	Dim col4, col5, col6, col7

	If Trim(arrdata(5)) = "" Or Trim(arrdata(6)) = "" Or Trim(arrdata(1)) = "" Or Trim(arrdata(2)) = "" Or Trim(arrdata(3)) = "" Or Trim(arrdata(4)) = "" Then
		Exit Sub
	End If

	id = idx(arrdata(0))

	col4 = Fix(arrdata(1) + CLng(Nullcheck(GRID0.GetGridCell(id,4))))
	col5 = Fix(arrdata(5)/1000 + (Nullcheck(GRID0.GetGridCell(id,5))))
	col6 = Fix(arrdata(2) + CLng(Nullcheck(GRID0.GetGridCell(id,6))))
	col7 = Fix(arrdata(6)/1000 + (Nullcheck(GRID0.GetGridCell(id,7))))

	GRID0.SetGridCell id, 2, SetSign(Fix(arrdata(3) + CLng(Nullcheck(GRID0.GetGridCell(id,2)))))
	GRID0.SetGridCell id, 3, SetSign(Fix(arrdata(4)/1000 + (Nullcheck(GRID0.GetGridCell(id,3)))))
	GRID0.SetGridCell id, 4, col4
	GRID0.SetGridCell id, 5, col5
	GRID0.SetGridCell id, 6, col6
	GRID0.SetGridCell id, 7, col7

	GRID0.SetGridCell id, 8, col4 + col6'CLng(Nullcheck(GRID0.GetGridCell(id,4)))+CLng(Nullcheck(GRID0.GetGridCell(id,6)))
	GRID0.SetGridCell id, 9, col5 + col7'(Nullcheck(GRID0.GetGridCell(id,5)))+(Nullcheck(GRID0.GetGridCell(id,7)))

End Sub

