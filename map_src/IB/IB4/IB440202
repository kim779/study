RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub OnAlert()
	Dim svol, dvol, tmp
	For ii = 1 To GRID0.Rows
		svol = GRID0.GetGridCell (ii, 11)
		dvol = GRID0.GetGridCell (ii, 12)
		If Trim(svol) = "" Then
			svol = 0
		End If
		If Trim(dvol) = "" Then
			dvol = 0
		End If
		tmp = CLng(svol) - CLng(dvol)
		If tmp > 0 Then
			tmp = "+"&tmp
		ElseIf tmp < 0 Then
			tmp = "-"&tmp
		End If
		GRID0.SetGridCell ii, 8, tmp
	Next
End Sub

}



