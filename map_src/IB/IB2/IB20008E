	If Len(Trim(zInputPwd.Data)) >= 4 And Trim(zInputPwd.Data) <> "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zInputPwd.Data))
		zInputPwd.Data = "HEAD"
	ElseIf Trim(zInputPwd.Data) = "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = Trim(SCREEN.Object("parent.LEDGER").EPwd)
		zInputPwd.Data = "HEAD"
	End If
End If

If Trim(zInputPwd.Data) = "HEAD" Then
	If Len(Trim(LEDGER.EPwd)) <> 44 Then
		SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
		SCREEN.Object("main.OBJ_order.ed_pswd").Data = ""
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		SCREEN.OnSend = False
		Exit Sub
	End If
End If

