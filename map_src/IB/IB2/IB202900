_AW_ONDECLARE_AW_
Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
	OBJECT0.Send
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major
cxMarket.sCode = S1301.Data
'TEST
'S1301.Data = "006800"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
cxMarket.sCode = S1301.Data
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1777.Data =  "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1777.Data =  "3"
	End If
	SYSTEM.Trace "yes cxMarket 1777 = " & S1777.Data
Else
	SYSTEM.Trace "no cxMarket map = " & SCREEN.GetMapName(0)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SBTN)
_AW_ONCLICK_AW_
cxMarket.sCode = Trim(S1301.Data)
OBJECT0.Send

S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTTN)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, 1301, "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

cxMarket.sCode = Trim(S1301.Data)

S1301.Trigger "", True
SCREEN.Object("OBJECT0.1301").data = S1301.Data
SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctl_Category)
_AW_ONCLICK_AW_
Dim codx
codx = ctl_Category.GetPreCode(S1301.Data)
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

cxMarket.sCode = Trim(S1301.Data)

SCREEN.Object("OBJECT0.1301").data = S1301.Data
SCREEN.Send 2

'SCREEN.Send 0

'S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim codx
codx = ctl_Category.GetNextCode(S1301.Data)
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
S1301.Data = ctl_Category.GetCurCode
S1301.Trigger "",True

SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If Trim(S1301.Data) = "000000" Or Trim(S1301.Data) = "" Then
 	SCREEN.ClearAll 2, 2

	Exit Sub
End If
S1301.Trigger "",True
S1301.Trigger "",False

cxMarket.sCode = Trim(S1301.Data)
SCREEN.Send 2

'S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


