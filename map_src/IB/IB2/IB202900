SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

If UCase(TypeName( SCREEN.Object("cbSOrder") )) <> "NOTHING" Then
	If cxMarket.sMarket = "통합" Then
		cbSOrder.Data = "S"
	ElseIf cxMarket.sMarket = "KRX" Then
		cbSOrder.Data = "1"
	ElseIf cxMarket.sMarket = "NXT" Then
		cbSOrder.Data = "N"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
