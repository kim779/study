_AW_ONDECLARE_AW_
Sub sendobj()
Dim i
	vagb.Data = 0 '금액
	If Left(Trim(SCREEN.Object("parent.LABEL3").data) , 1) <> "미" Then
		For i = 11 To 22
			SCREEN.Object("v"&i).visible = True
		Next
		For i = 23 To 34
			SCREEN.Object("v"&i).visible = False
		Next
	Else
		For i = 11 To 22
			SCREEN.Object("v"&i).visible = False
		Next
		For i = 23 To 34
			SCREEN.Object("v"&i).visible = True
		Next
	End If
End Sub

_AW_ONSEND_AW_
Call sendobj()

