'--------------------------------------------------------------------------------------------------------------
'등락 수급 라디오 버튼 체크 여부에 따라 개인 외국인 개인 라벨  Show or Hide
Sub ShowLabel()
	If rdsugb.Checked = True Then
		lbsuback.Visible = True
		lbImagePer.Visible = True
		lbtxPer.Visible = True
		lbImageFore.Visible = True
		lbtxFore.Visible = True
		lbImageGi.Visible = True
		lbtxgi.Visible = True

		lbper1.Visible = False
		lbper2.Visible = False
		lbBack2.Visible = False
		btimage.Visible = False

	Else
		lbsuback.Visible = False
		lbImagePer.Visible = False
		lbtxPer.Visible = False
		lbImageFore.Visible = False
		lbtxFore.Visible = False
		lbImageGi.Visible = False
		lbtxgi.Visible = False

		lbper1.Visible = True
		lbper2.Visible = True
		lbBack2.Visible = True
		btimage.Visible = True
	End  If

End Sub

'--------------------------------------------------------------------------------------------------------------
Sub SetGubn()
	If rdupdown.Checked = True Then  '등락 선택시
		COMBO2.Visible = True
		COMBO3.Visible = False
		If COMBO2.Index = 0 Then	'시가총액
			edgubn.Data = "0"
		ElseIf COMBO2.Index = 1 Then '거래량
			edgubn.Data = "1"
		ElseIf COMBO2.Index = 2 Then  '거래대금
			edgubn.Data = "2"
		End If
	Else							'수급 선택시
		COMBO2.Visible = False
		COMBO3.Visible = True
		If COMBO3.Index = 0 Then
			edgubn.Data = "3"	    '순매수량
		Else
			edgubn.Data = "4"		'순매수대금
		End If
	End If

	OBJECT0.Proc "SetGridColumn",""
	SaveLaststate()
End Sub


'--------------------------------------------------------------------------------------------------------------
Sub Send_f()
	Dim sMarket, sType, sSort, sGubn

	If rdKospi.Checked = True Then    	'0 코스피 1 코스닥
		sMarket = 0
		edUpcode.Data = ""
	Else
		sMarket = 1
	End If

	If rdupdown.Checked = True Then     '0 등락 1 수급
		sType = 0
	Else
		sType = 1
	End If

	If COMBO2.Visible = True Then
		If COMBO2.Index = 0  Then
			sSort = 0					'0 시가총액
		ElseIf COMBO2.Index = 1   Then
			sSort = 1					'1 거래량
		Else
			sSort = 2					'2 거래대금
		End If
	Else
		If COMBO3.Index = 0  Then
			sSort = 3					'3 외국인 순매수량
		ElseIf COMBO3.Index = 1   Then
			sSort = 4					'4 외국인 순매수대금
		End If
	End If

	If rdGubn1.Checked = True Then		'0 균일 1 비율
		sGubn = 0
	Else
		sGubn = 1
	End If

	CONTROL0.LoadMap sMarket, sType, sSort, sGubn

End Sub


'--------------------------------------------------------------------------------------------------------------
'object 화면으로 부터 호출 비중값을 컨트롤에서 가져온 뒤 데이터 저장용 그리드(GRID0)에 데이터 저장 후
'object 화면 메소드(SetBijungArr) 호출(object 화면은 그리드 데이터 참조)

'sArr   object 에서 호출 업종구분자 + 업종코드가 arr 형태로 내려옴
'       1,업종에 따른 비중   ex) 00:5:6: 코스피      10:203:214:  코스닥

'sGubn  5 -> 시가총액의 비중
'		6 -> 거래량의 비중
'		7 -> 거래대금의 비중

' 컨트롤에서는 해당 업종이나 종목코드와 비중값을 arr 형태로 반환  ex) 5!22.22:6!33.33:
Sub GetBijungArr(sArr, sGubn)   '비중
	Dim sArr1, sArr2
	GRID0.Clear

	sArr1 = Split(CONTROL0.GetDataArr(sArr, sGubn), ":")

	For ii = 0 To UBound(sArr1) - 1
		sArr2 = Split(sArr1(ii), "!")
		GRID0.SetGridCell ii + 1, 1, sArr2(0)
		GRID0.SetGridCell ii + 1, 2, sArr2(1)
	Next

	OBJECT0.Proc "SetBijungArr",""
End Sub

'--------------------------------------------------------------------------------------------------------------
Sub SaveLaststate()
	Dim sState

	If rdKospi.Checked = True Then
		sState = "0"
	Else
		sState = "1"
	End If

	If rdupdown.Checked = True Then
		sState = sState & "!" & "0"
	Else
		sState = sState & "!" & "1"
	End If

	If rdupdown.Checked = True Then
		sState = sState & "!" & COMBO2.Index
	Else
		sState = sState & "!" & COMBO3.Index
	End If

	SYSTEM.Push "MARKETMAP", sState
End Sub


'--------------------------------------------------------------------------------------------------------------
Sub LoadLaststate()
	Dim sState, arr
	sState = SYSTEM.Pop("MARKETMAP")

	If Len(Trim(sState)) = 0 Then
		ShowLabel()
		Exit Sub
	End If

	arr = Split(sState, "!")

	If arr(0) = "0" Then					'코스피
		rdKospi.Checked = True
	Else									'코스닥
		rdKosdaq.Checked = True
	End If

	If arr(1) = "0" Then					'등락
		rdupdown.Checked = True
		rdsugb.Checked = False
		COMBO2.Visible = True				'시가총액 거래량 거래대금 콤보
		COMBO3.Visible = False

		If arr(2) = "0" Then
			COMBO2.Index = 0
		ElseIf arr(2) = "1" Then
			COMBO2.Index = 1
		ElseIf arr(2) = "2" Then
			COMBO2.Index = 2
		End If

	Else
		rdupdown.Checked = False								'수급
		rdsugb.Checked = True
		COMBO2.Visible = False
		COMBO3.Visible = True

		If arr(2) = "0" Then				'순매수량 순매수대금 콤보
			COMBO3.Index = 0
		ElseIf arr(2) = "1" Then
			COMBO3.Index = 1
		End If
	End If

	ShowLabel()
End Sub


