_AW_ONDECLARE_AW_
Sub change_code(codx)
	If Len(Trim(codx)) <> 6 Then
		Exit Sub
	End If
		SYSTEM.Trace "[IB201600]change_code  codx = " & codx

	S1301.Data = codx
	SCREEN.Send 0
End Sub

Sub changerange(rg1,rg2)
	'Dim arr,rg1,rg2

	If rg1 > rg2 Then
		S17412.SetPriceRange rg1,rg2
	Else
		S17412.SetPriceRange rg2,rg1
	End If
End Sub

Sub changepercent(rg1,rg2)
	S17412.SetPercent rg1,rg2
End Sub

Sub change_Market(sVal)

	SYSTEM.Trace "[IB201600]change_Market  sVal = " & sVal

	If sVal = "KRX" Then
		S1777.Data = "1"
		S17412.SetMKtype(1)
	ElseIf sVal = "NXT" Then
		S1777.Data =  "2"
		S17412.SetMKtype(2)
	ElseIf sVal = "통합" Then
		S1777.Data =  "3"
		S17412.SetMKtype(3)
	End If

	SCREEN.Send 0

End Sub

_AW_ONSEND_AW_
If Len(Trim(S1301.Data)) = 0 Then
	SCREEN.OnSend = False
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONFOCUS_AW_
If S1301.Data <> "" Then
	SYSTEM.SetHistory "1301",S1301.Data
End If

_AW_ONENDSUB_AW_
