_AW_ONCLICK_AW_
Dim codb
If grd.HitPos = 3 Then
	codb = grd.GetGridCell(grd.row, 2)
   SCREEN.Object("main.ELWUD").data = codb
   SCREEN.Proc "main.P_send", ""
End If
