_AW_ONDECLARE_AW_
Dim g_cod, oflg
Function P_elw(i_cod)
 oflg = 0
 For ii = 1 To grd.Rows
	g_cod = grd.GetGridCell(ii, 1)
	If Trim(i_cod) = Trim(g_cod) Then
		oflg = 1
	End If
 Next
 If oflg = 1 Then
	P_elw = "1"
 Else
	P_elw = "0"
 End If

'	codb = ii & "|" & oflg
'   grd.SetGridCell 3, 1, codb
End Function

