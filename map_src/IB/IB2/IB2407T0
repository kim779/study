_AW_ONDECLARE_AW_
Dim start_f

start_f = False

Sub MKTriggerFromMain(sdata)
	cxMarket.sMarket = sdata
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888
#load IB999901

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
c_upgb.Pop("c_upgb")
S200901.Pop("200901")
'SYSTEM.Trace(S200901.Data)
cxMarket.sMarket = LoadMKGubn
cxMarket.MNum = "IB100000"
S200901.Data = c_upgb.Data
If c_upgb.Data = 889 Then
	S200901.Enable = False
	UBUT.Enable = False
Else
	S200901.Enable = True
	UBUT.Enable = True
End If

SCREEN.SetTimer 1, True		'ResizableEx인 경우 vrow값 서버에 제대로 올려주기위해
							'화면이 다 뜬 상태에서 send

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If start_f = False Then
	SCREEN.OnSend = False
	Exit Sub
End If

If Start.Data = "0" Then
	SCREEN.SetTimer 2, False
	SCREEN.OnSend = False
	Exit Sub
End If

S200331.Data = "0"
If S200999.CHECKED = True Then
	S200331.data = "1"
	strHead = "순매수량"
Else
	S200331.data = "2"
	strHead = "순매도량"
End If

For ii = 0 To S215300.Columns
	If S215300.GetColumnName(ii) = "215001" Then
		S215300.Column = ii
		S215300.SetHead ii, strHead
		Exit For
	End If
Next

If cxMarket.sMarket = "KRX" Then
	S200777.DATA = "1"
ElseIf cxMarket.sMarket = "NXT" Then
	S200777.DATA = "2"
ElseIf cxMarket.sMarket = "통합" Then
	S200777.DATA = "3"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If S200301.Data = 1 Then
	S215300.SetFocus
	S215300.INDEX = 0
ElseIf S200301.Data = "-1" Then
	S215300.SetFocus
	S215300.INDEX = S215300.Rows-1
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
start_f = True

If Start.Data = "1" Then
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(200999)
_AW_ONCLICK_AW_
