RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub sendobj()
Dim i
	vagb.Data = 1 '수량
	'MsgBox "data:"&Left(Trim(SCREEN.Object("parent.LABEL3").data) , 1)
	If Left(Trim(SCREEN.Object("parent.LABEL3").data) , 1) <> "미" Then
		For i = 11 To 22
			SCREEN.Object("v"&i).visible = True
		Next
		For i = 23 To 34
			SCREEN.Object("v"&i).visible = False
		Next
	Else
		For i = 11 To 22
			SCREEN.Object("v"&i).visible = False
		Next
		For i = 23 To 34
			SCREEN.Object("v"&i).visible = True
		Next
	End If
End Sub

_AW_ONSEND_AW_
Call sendobj()

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
Else
	SYSTEM.Trace "IB2908V2  No cxMarket"
End If

_AW_ONENDSUB_AW_
}



