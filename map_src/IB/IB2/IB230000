_AW_ONDECLARE_AW_
Dim flag '4601에서 넘길 계좌번호등을 셋팅하기위한 플래그
Dim bFirst
bFirst = True

Sub send_sise_all(gubn)
	Dim code, fogb, rsymb, acnm

	code = Mid(Trim(ed_fcod.Data), 2, 2)

	If Trim(code) = "" Then
		ed_fcod.Clear
		OBJ_sise.Send
		OBJ_info.ClearAll 2
		Exit Sub
	End If

	' 주식선물인지 CHECK
	If (code < "10" Or "59" < code)  And  (code < "B0" Or "ZZ" < code) _
		 And   (code < "0A" Or "0Z" < code)  And   (code < "1A" Or "1Z" < code) _
		 And   (code < "2A" Or "2Z" < code)  And   (code < "3A" Or "3Z" < code) _
		 And   (code < "4A" Or "4Z" < code)  And   (code < "5A" Or "5Z" < code) _
		 And   (code < "6A" Or "6Z" < code)  And   (code < "7A" Or "7Z" < code) _
		 And   (code < "8A" Or "8Z" < code)  And   (code < "9A" Or "9Z" < code) Then
		ed_fcod.Clear
		OBJ_sise.Send
		OBJ_info.ClearAll 2
		Exit Sub
	End If

	code = Left(ed_fcod.Data, 1)
	S100301.Data = ed_fcod.Data

	fogb = 130 		'GetCode : 122 GetName : 130
	rsymb = "100301"
	OBJ_sise.SetObject("IB230010")

	HNAM.Data = SCREEN.GetName (fogb, ed_fcod.Data, 0)
'	SYSTEM.Trace "send_sise_all HNAM : " & HNAM.Data

	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = HNAM.data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_fcod").data = ed_fcod.data
		SCREEN.IgnoreChange False
	End If

	Call tab_info_change()

	acnm = Trim(SCREEN.Object("OBJ_order.acnm").data)

	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 2, 2
		SCREEN.Object("OBJ_order.acnm").data = acnm
		OBJ_sise.Send
		OBJ_info.Send
		Exit Sub
	Else
		ed_fcod.Trigger "ed_fcod", True
		ed_fcod.Trigger rsymb, True
		ed_fcod.Trigger rsymb, False
		SYSTEM.SetHistory rsymb, ed_fcod.Data
		SYSTEM.SetHistory "ed_fcod", ed_fcod.Data
	End If

	OBJ_sise.Send
	If tab_info.ID <> 1 Then
		OBJ_info.Send
	End If

	SCREEN.Proc "OBJ_order.AddHistory", ed_fcod.Data
End Sub

Sub tab_info_change()
	Select Case tab_info.ID
	Case 1 : OBJ_info.SetObject "IB230021"
	Case 2 : OBJ_info.SetObject "IB230022"
	Case 3 : OBJ_info.SetObject "IB230023"
	Case 4 : OBJ_info.SetObject "IB230024"
	Case 5 : OBJ_info.SetObject "IB230025"
	Case 6 : OBJ_info.SetObject "IB230026"
	Case 7 : OBJ_info.SetObject "IB230027"
	Case Else : Exit Sub
	End Select

	If tab_info.ID = 1 Then
		SCREEN.Object("obj_info.1301").data = SCREEN.Object("OBJ_sise.101005").data
		OPEN_BTN1.Enable = True
		OPEN_BTN1.Visible = True
	Else
		OPEN_BTN1.Enable = False
		OPEN_BTN1.Visible = False
	End If

	OBJ_info.Send
End Sub

Sub OBJ_account_send()
	OBJ_account.send
End Sub

Sub clearWrongJmcd()
	ed_fcod.Clear
	OBJ_sise.Send
	OBJ_info.ClearAll 2
End Sub


'기존코드 >= 현월물 = 기존코드
'기존코드 <  현월물 = 기존코드(앞 3자리) + 현월물(뒷 4자리)
Sub ChangeOldMonth()
	bFirst = False
	Dim oldDivF, oldDivB, newDivF, newDivB

	If Trim(ed_fcod.Data) = "" Then
		SCREEN.GetCode 134, "zFnoIsuNo1", "HNAM1", 0
		ed_fcod.Data = zFnoIsuNo1.Data
	Else
		SCREEN.GetCode 134, "zFnoIsuNo1", "HNAM1", 0

		newDivF = Mid(Trim(zFnoIsuNo1.Data), 1, 3)
		newDivB = Mid(Trim(zFnoIsuNo1.Data), 4, 5)

		oldDivF = Mid(Trim(ed_fcod.Data), 1, 3)
		oldDivB = Mid(Trim(ed_fcod.Data), 4, 5)

		'SYSTEM.Trace "ChangeOldMonth : " & Trim(SCREEN.GetName(130, ed_fcod.Data, 0))

		If Trim(SCREEN.GetName(130, ed_fcod.Data, 0)) = "" Then
				ed_fcod.Data = oldDivF & newDivB
		End If

	End If

	SCREEN.Proc "main.send_sise_all", "main"
End Sub

