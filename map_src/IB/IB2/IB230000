'TR4601에서 그리드 클릭시 실행
If flag = 1 Then
	If Trim(accn_4601.Data) <> "" Then
		If Trim(mmgb_4601.Data) = "매도" Then
			SCREEN.Object("OBJ_order.tab_order").ID = 2
		Else
			SCREEN.Object("OBJ_order.tab_order").ID = 1
		End If

		SCREEN.Proc "OBJ_order.order_tab_change", ""

		SCREEN.Object("OBJ_order.AN20").Data = Trim(accn_4601.Data)
		SCREEN.Object("OBJ_order.ed_pswd").Data = ""
		SCREEN.Object("OBJ_order.ACNM").Data = Trim(acnm_4601.Data)

		SCREEN.Object("OBJ_order.OBJ_odr.ed_fcod").Data = Trim(jmcd_4601.Data)
		SCREEN.Proc "OBJ_order.OBJ_odr.ChangeCode", ""

		SCREEN.Object("OBJ_order.OBJ_odr.ed_jQty").Data = Trim(jmQty_4601.Data)

		accn_4601.Clear
		acnm_4601.Clear
		jmcd_4601.Clear
		mmgb_4601.Clear
		jmQty_4601.Clear
		OBJ_account.ClearAll 2

	ed_fcod.Trigger "ed_fcod", True
	ed_fcod.Trigger "100301", True
	SYSTEM.SetHistory "ed_fcod", ed_fcod.Data

	SCREEN.Object("OBJ_order.ed_pswd").SetFocus
	End If

	flag = 0
End If

