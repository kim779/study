'-----------------------------------------------------------------------
Sub SetAccVol(Data)
	If Len(Trim(Data)) = 0 Then
		Data = 0
	End If

	g_BefAccVol = CCur(Data)
End Sub
'-----------------------------------------------------------------------
Sub OnAlert()
	Dim ArrData
	If g_Flag <> 1 Then
		Exit Sub
	End If
	If CLng(g_Today) <> CLng(S11309.Data) Then
		Exit Sub
	End If

	AccVol = Trim(S11310.GetGridCell (1, 4))
	If AccVol = "" Then
		Exit Sub
	Else
		If AccVol = 0 Then
			Exit Sub
		End If
	End If


	Flag = 0
	For i = 1 To S11310.Rows
		AccVol = Trim(S11310.GetGridCell(i, 4))
		If Len(Trim(AccVol)) = 0 Then
			Exit For
		ElseIf CCur(AccVol) = g_BefAccVol Then
			Flag = 1
			Exit For
		End If
	Next

	If Flag = 1 And i - 1 >= 1 Then
		j = i - 1
		Do While(1)
			If j <= 0 Then
				Exit Do
			End If
			ArrData = Array("", "", "", "")
			'0:시간, 1:현재가, 2:등락률, 4:거래량


			ArrData(0) = (S11310.GetGridCell(j,1))
			ArrData(1) = (S11310.GetGridCell(j,2))
			ArrData(2) = (S11310.GetGridCell(j,3))

			If Trim(ArrData(2)) <> "" Then
				If ArrData(2) < 0 Then
					ArrData(2) = "-" & ArrData(2)
				Else
				End If
			End If
			ArrData(3) = (S11310.GetGridCell(j,4))

			Data = Join(ArrData, "|")
			SCREEN.Proc "parent.ProcSetData", Data
			j = j - 1
		Loop
	End If

	g_BefAccVol = CLng(S11310.GetGridCell(1,4))

End Sub

_AW_ONSTART_AW_
AYear = Year(Date)
AMon = Month(Date)
If Len(AMon) = 1 Then
	AMon = "0" & AMon
End If
ADay = Day(Date)
If Len(ADay) = 1 Then
	ADay = "0" & ADay
End If
S11309.data = AYear & AMon & ADay

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.Object("Main.1301").data
'S11309.data = SCREEN.Object("main.11309").data
If Trim(S1301.Data) = "" Then
	SCREEN.OnSend = False
	Exit Sub
End If

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1777.Data =  "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1777.Data =  "3"
	End If
	SYSTEM.Trace "yes cxMarket 1777 = " & S1777.Data
Else
	SYSTEM.Trace "no cxMarket map = " & SCREEN.GetMapName(0)
End If

