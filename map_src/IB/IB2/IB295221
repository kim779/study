Dim cha, bicha, Tot, KP200, vo, bs

If SCREEN.CreateObject("info") Then
	cha = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295221", "IB295221_chaik"))
	bicha = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295221", "IB295221_bichaik"))
	tot = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295221", "IB295221_total"))
	KP200 = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295221", "IB295221_kp"))
	vo = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295221", "IB295221_vol"))
	bs = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295221", "IB295221_basis"))

	chaik.Data = cha
	bichaik.Data = bicha
	total.Data = Tot
	KP.Data = KP200
	vol.Data = vo
	basis.Data = bs
End If

If chaik.Data = "1" Then
	CHECK0.checked = True
Else
	CHECK0.checked = False
End If

If bichaik.Data = "1" Then
	CHECK1.checked = True
Else
	CHECK1.checked = False
End If

If total.Data = "1" Then
	CHECK2.checked = True
Else
	CHECK2.checked = False
End If

If KP.Data = "1" Then
	CHECK3.checked = True
Else
	CHECK3.checked = False
End If

If vol.Data = "1" Then
	CHECK4.checked = True
Else
	CHECK4.checked = False
End If




'2009.07.13 아무것도 선택하지 않았을 경우 전체차트 보여줌.
If chaik.Data <> "1" And bichaik.Data <> "1" And total.Data <> "1" And KP.Data <> "1" And vol.Data <> "1" Then
     CHECK2.Checked = True
End If

SCREEN.SetTimer 10, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

SCREEN.OnSend False
upcd.Data = SCREEN.Object("parent.upgb").data
If upcd.Data = "2" Then
	CHECK5.Visible = False
Else
	CHECK5.Visible = True
End If
vggb.Data = SCREEN.Object("parent.vggb").data
dfgb.Data = SCREEN.Object("parent.dfgb").data
jgga.Data = SCREEN.Object("parent.jgga").data

If CHECK4.Checked = True Then
	obj.SetObject "IB295223"
Else
	obj.SetObject "IB295222"
End If

obj.Send

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
obj.send

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
Dim cha, bicha, Tot, KP200, vo, bs

If CHECK0.Checked = True Then
	cha = "1"
Else
	cha = "0"
End If

If CHECK1.Checked = True Then
	bicha = "1"
Else
	bicha = "0"
End If

If CHECK2.Checked = True Then
	Tot = "1"
Else
	Tot = "0"
End If

If CHECK3.Checked = True Then
	KP200 = "1"
Else
	KP200 = "0"
End If

If CHECK4.Checked = True Then
	vo = "1"
Else
	vo = "0"
End If

If CHECK5.Checked = True Then
	bs = "1"
Else
	bs = "0"
End If

If SCREEN.CreateObject("info") Then
