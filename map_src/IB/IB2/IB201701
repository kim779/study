Function mod_time(Timedata)

Dim hh, mm, ss, temp
hh = Timedata \ 10000
If hh > 23 Then
	hh = 23
End If
mm = Timedata Mod 10000
mm = mm \ 100
If mm > 59 Then
	mm = 59
End If

ss = Timedata Mod 100
If ss > 59 Then
	ss = 59
End If

temp = 10000*hh + 100*mm + ss
If hh < 10 Then
	temp = "0" & temp
End If
mod_time = temp

End Function

