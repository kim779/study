Private Sub saveUserConfig()
	If SCREEN.CreateObject("Info") Then
			INFO.pushData LOGIN.Name, "userconf.ini", "DH146700", "COMB", COMB.Data
			INFO.pushData LOGIN.Name, "userconf.ini", "DH146700", "COM2", COM2.Data

