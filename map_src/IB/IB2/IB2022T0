Sub FileCopy(srcFile)
	Dim fso,MyFile

	Set fso = CreateObject("Scripting.FileSystemObject")

	If fso.FileExists(srcFile & ".org") Then
		Set MyFile = fso.GetFile(srcFile& ".org")
		MyFile.Copy (srcFile)
	End If
End Sub

Sub FileDelete(srcFile)
	Dim fso,MyFile

	Set fso = CreateObject("Scripting.FileSystemObject")

	If fso.FileExists(srcFile & ".org") Then
		Set MyFile = fso.GetFile(srcFile & ".org")
		MyFile.Delete
	End If
End Sub

Sub OnPortfolio(confirm)
	SCREEN.SetTimerx 1, 1, False
End Sub

Sub OnPort(confirm)
	Dim groupNames, parseData, Items, codelist, row, countGroup
	If UCase(confirm) <> "OK" And UCase(confirm) <> "START" Then
		Exit Sub
	End If

	Items = ""
	DX_INTEREST.SetUserName(LOGIN.Name)

	groupNames = DX_INTEREST.LoadGroupNames()
	countGroup = 0
	Do While Len(groupNames) > 0

		parseData  = Mid(groupNames, 1, InStr(groupNames, vbTab) -1)
		groupNames = Mid(groupNames, InStr(groupNames, vbTab) + 1)
		Items = parseData & vbTab & Items
		countGroup = countGroup + 1
	Loop

	'계좌 보유종목 조회
	If countGroup < 100 Then
		Items = "00 보유종목" & vbTab & Items
	End If

	If Items = "" Then
		intercombo.SetItems("")
	Else
		intercombo.SetItems(vbTab & Items)
	End If

	Call p_read_com()
'	intercombo.Data = SYSTEM.Pop("cxPortfolioItem")
'	SCREEN.Proc "OBJ1.OnGroup", intercombo.Data


    'Call p_write_com()
	'축소화면도 같이 업데이트
	'SCREEN.Proc "main.obj_reduce1.OnPortfolio", confirm

	CONTROL0.SetGroup intercombo.Data - 1
	CONTROL0.OnPortfolio confirm

	If UCase(confirm) <> "START" Then
		CONTROL0.ChangeGroup intercombo.Data
	End If
End Sub

Sub p_read_com()
	If SCREEN.CreateObject("Info") Then
	 	Dim data
	 	data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP"))
		If data = "" Then
			intercombo.Data = "01"
		Else
			intercombo.Data = data
		End If

'		data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "SELECT_ARRANGE"))
'		If data = "" Then
'			arrange.Data = "00"
'		Else
'			arrange.Data = data
'		End If
		arrange.Data = "00"
	End If
End Sub

Sub OptionLoad()
	Dim data

	data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "INTERAUTO"))

	If data = "" Then
		data = 1
	End If

	If data = 1 Then
		auto.Checked = True
	Else
		auto.Checked = False

		data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "INTEREXPECT"))

		If data = "" Then
			data = 0
		End If

		If data = 1 Then
			expect.Checked = True
		Else
			expect.Checked = False
		End If
	End If

	If auto.Checked = True Then
		CONTROL0.SetAutoCheck True
		CONTROL0.SetExpect False

		expect.Enable = False
		expect.Checked = False
	Else
		CONTROL0.SetAutoCheck False
		CONTROL0.SetExpect False

		expect.Enable = True
	End If

	If expect.Checked = True Then
		CONTROL0.SetExpect True

		If RADIO1.Checked = True Then
			CONTROL0.ChangeGroup intercombo.Data
		End If
	Else
		CONTROL0.SetExpect False

		If RADIO1.Checked = True Then
			CONTROL0.ChangeGroup intercombo.Data
		End If
	End If
End Sub

Sub p_write_com()
	Dim data

	If SCREEN.CreateObject("Info") Then
	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP", intercombo.Data
	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "SELECT_ARRANGE", arrange.Data

	  If auto.Checked = True Then
	  	data = 1
	  Else
	  	data = 0
	  End If

	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "INTERAUTO", data

	  If expect.Checked = True Then
	  	data = 1
	  Else
	  	data = 0
	  End If

	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "INTEREXPECT", data
	End If
End Sub

