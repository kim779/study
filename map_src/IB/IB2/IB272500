Sub SendChart(AType)
	If AType = "1" Then
		Data = AType & "|" & g_CtTp
	Else
		ItemCd = S20301.Data
		If Len(Trim(ot_ckdt.Data)) = 0 Then
			CkDt = "99999999"
		Else
			CkDt = ot_ckdt.Data
		End If
		Data = "0" & "|" & ItemCd & "|" & g_CtTp & "|" & CkDt & "|" & ed_date.data

	End If

	OBJ_CHART.Proc "change_chart", 1
End Sub
