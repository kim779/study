_AW_SCRIPT_AW_(301300)
_AW_ONCLICK_AW_
Select Case S301300.HitPos
Case 3	'DATA부 click
	If Len(Trim(S301300.GetGridCell(S301300.Index +1, 1))) = 7 Then
		S1301.DATA = Right(Trim(S301300.GetGridCell(S301300.Index +1, 1)),6)
		If Trim(S1301.DATA) = "" Then
		    Exit Sub
		End If

		S1301.Trigger "", False
		S1301.Trigger "", True
	   SYSTEM.SetHistory "1301", S1301.DATA
	End If
Case Else
	SCREEN.OnSend = fasle
	Exit Sub
End Select
