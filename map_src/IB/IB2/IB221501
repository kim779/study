_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

If S300301.Data = 1 Then
	S301300.SetFocus
	S301300.INDEX = 0
ElseIf S300301.Data = "-1" Then
	S301300.SetFocus
	S301300.INDEX = S301300.Rows-1
End If


S301300.SetFocus

If SCREEN.Object("parent.300307").Data > S300307.Data Then
	'윗 페이지로 이동시 하단부터 보이도록 포커스 이동
	'하나로는 기능이 정상작동하지 않아 여러건을 걸었음.
	S301300.Index S301300.Rows - 3
	S301300.Index S301300.Rows - 2
	S301300.Index S301300.Rows - 1
Else
	S301300.Index 0
End If

S301300.SetFocus


SCREEN.Object("parent.300307").Data = S300307.Data
SCREEN.Object("parent.300308").Data = S300308.Data

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
