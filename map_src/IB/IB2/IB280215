Sub Onalert()
	Dim grJmcd
	grJmcd = Trim(TABLE0.GetTableCell(4))	'종목코드

	If grJmcd = "" Then
		Exit Sub
	End If

	S1301.Data = Trim(SCREEN.Object("main.1301").Data)

	If grJmcd <> Trim(S1301.data) Then
		Exit Sub
	End If

	Dim grGubn1, v_name						'구분1
	grGubn1 = Trim(TABLE0.GetTableCell(8))

	If grGubn1 = "" Then
		Exit Sub
	End If

	If IsNumeric(grGubn1) = False Then
		Exit Sub
	End If

	Select Case CLng(grGubn1)
		Case 1
			If GUBN1.Checked = False Then
				Exit Sub
			End If
			v_name = "시황"
		Case 2
			If GUBN2.Checked = False Then
				Exit Sub
			End If
			v_name = "공시"
		Case 3
			If GUBN3.Checked = False Then
				Exit Sub
			End If
			v_name = "이투데이"
		Case 4
			If GUBN4.Checked = False Then
				Exit Sub
			End If
			v_name = "시황속보"
		Case 5
			If GUBN5.Checked = False Then
				Exit Sub
			End If
			v_name = "전자신문"
		Case 6
			If GUBN6.Checked = False Then
				Exit Sub
			End If
			v_name = "이데일리"
		Case 7
			If GUBN7.Checked = False Then
				Exit Sub
			End If
			v_name = "월드인덱스"
		Case 8
			If GUBN8.Checked = False Then
				Exit Sub
			End If
			v_name = "연합뉴스"
		Case 9
			If GUBN9.Checked = False Then
				Exit Sub
			End If
			v_name = "머니투데이"
		Case 10
			If GUBN10.Checked = False Then
				Exit Sub
			End If
			v_name = "한경뉴스"
		Case 11
			If GUBN11.Checked = False Then
				Exit Sub
			End If
			v_name = "매경뉴스"
		Case 12
			If GUBN12.Checked = False Then
				Exit Sub
			End If
			v_name = "아시아경제"
		Case 13
			If GUBN13.Checked = False Then
				Exit Sub
			End If
			v_name = "헤럴드경제"
		Case 14
			If GUBN14.Checked = False Then
				Exit Sub
			End If
			v_name = "촉n토크"
		Case 15
			If GUBN15.Checked = False Then
				Exit Sub
			End If
			v_name = "IR GO"
		Case 16
			If GUBN16.Checked = False Then
				Exit Sub
			End If
			v_name = "컨슈머타임스"
		Case 17
			If GUBN17.Checked = False Then
				Exit Sub
			End If
			v_name = "뉴스웨이"
	End Select

	GRID0.InsertRow 0

	' set GRID data
	GRID0.SetGridCell 1, 2, Trim(TABLE0.GetTableCell(6))	'시간
	GRID0.SetGridCell 1, 3, v_name
	GRID0.SetGridCell 1, 4, Trim(TABLE0.GetTableCell(2))	'제목
	GRID0.SetGridCell 1, 5, Trim(TABLE0.GetTableCell(3))	'recn
	GRID0.SetGridCell 1, 6, Trim(TABLE0.GetTableCell(10))	'flag
	GRID0.SetGridCell 1, 7, Trim(TABLE0.GetTableCell(11))	'KEYV
	GRID0.SetGridCell 1, 1, Mid(TABLE0.Data, 1, 8)

	TABLE0.Data = ""
	GRID0.Index = 0
'	If GRID0.Index < 1000 Then
'		GRID0.Index = GRID0.Index + 1
'	End If
End Sub

Sub click_grid()
		Dim	key_value, key_text
		key_value = GRID0.GetGridCell(GRID0.Row, 7)
		If Trim(key_value) <= "" Then
			Exit Sub
		End If
		key_text = GRID0.GetGridCell(GRID0.Row, 4)
		If Trim(key_text) <= "" Then
			Exit Sub
		End If

		key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.
		SCREEN.CreateWindow 4, "IBNEWSXX /S/d/p1/t", "015"& vbTab & key_text & vbLf & _
			"016" & vbTab & key_value & vbLf & "1301" & vbTab & SCREEN.Object("main.1301").Data

'		keyv.text = key_value
'		SCREEN.Object("OBJ1.isrn").data = recn
'		OBJ1.send
End Sub

Dim save
save = ""
Sub Check_edit()
Dim scode
scode = Trim(SCREEN.Object("main.1301").data)
If Trim(scode) = "" Then
	Exit Sub
End If
If StrComp(save, scode, 1) <> 0 Then
	save = scode
	cod2.Data = SCREEN.object("parent.1301").Data
	isrn.Data = ""
End If
End Sub

