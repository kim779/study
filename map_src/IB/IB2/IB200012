RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub OnGroup(group)
	S90303.Clear()

	If Trim(group) <> "" Then
		codelist = DX_INTEREST.LoadCodeList(group)
		row = 1
		Do While Len(codelist) > 0
			parseData = Mid(codelist, 1, InStr(codelist, vbTab) -1)
			codelist = Mid(codelist, InStr(codelist, vbTab) + 1)
			S90303.InsertRow(-1)
			S90303.SetGridCell S90303.rows, 2, parseData
'			S90303.SetGridCell row, 2, parseData
			row = row + 1
		Loop
		SCREEN.Send 0
	End If
End Sub

Sub OnPredict(bNowPrice)
	If bNowPrice = "0" Then
		predict = True
	Else
		predict = False
	End If
	S90303.SetColumnVisible 5, predict
	S90303.SetColumnVisible 7, predict
	S90303.SetColumnVisible 9, predict
    S90303.SetColumnVisible 11, predict

	S90303.SetColumnVisible 4, Not predict
	S90303.SetColumnVisible 6, Not predict
	S90303.SetColumnVisible 8, Not predict
    S90303.SetColumnVisible 10, Not predict
End Sub

_AW_ONSEND_AW_
S90308.Data = S90303.rows
'--

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S90777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S90777.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S90777.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(90303)
_AW_ONCLICK_AW_
If S90303.HitPos = 3 Then
	S1301.DATA = S90303.GetGridCell(S90303.Row, 2)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	If Len(Trim(S90303.GetGridCell(S90303.index+1, 2))) > 6 Then
		Exit Sub
	End If

	SCREEN.Proc "main.send_sise", "top" & "," & S1301.Data

	'메인에 저장
	SCREEN.Object("main.theme_check").data = 1
	SCREEN.Object("main.theme_1301").data = S1301.Data

	'If S1301.Data > 500000 Then
	If SCREEN.GetCodeType(S1301.Data) = 9 Then
		E1301.Data = S1301.Data
		E1301.Trigger "E1301", True
	End If

	SCREEN.Object("main.1301").Data = S90303.GetGridCell(S90303.Row, 2)
	SCREEN.Proc "main.Send_sise_all", "main"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


