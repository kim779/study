Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		mode.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "mode"))
		gubn.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "gubn"))
		If Trim(mode.Data) = "" Then
			mode.Data = "T"
		End If

		If Trim(gubn.Data) = "" Then
			gubn.Data = "T"
		End If

		If mode.Data = "T" Then
        	acumdd.Data = "001"
			acumdd.Enable = False
		End If
	End If
End Sub



Sub SaveConfig()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "mode", mode.Data
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "gubn", gubn.Data
	End If
End Sub

Sub SendReqeust(name)

	' 버튼클릭에 의한 호출일 경우 조회구분값을 토글시킨다.
	If name="dayb1" Or name="dayb4" Then
		If gubn.Data = "T" Then
			gubn.Data = "D"
		Else
			gubn.Data = "T"
		End If
	ElseIf name="dayb2" Or name="dayb3" Then
        If RADIO2.Checked = True Then
        	mode.Data = "D"  '일자
        	acumdd.Data = "001"
			acumdd.Enable = True
        ElseIf RADIO3.Checked = True Then
        	mode.Data = "T"  '시간
        	acumdd.Data = "001"
			acumdd.Enable = False
        End If
'		If mode.Data = "T" Then
'			mode.Data = "D"
'		Else
'			mode.Data = "T"
'		End If
	End If

	' 버튼 캡션 설정
	If mode.Data = "T" Then  '시간
		dayb2.Text = "일자별"
		dayb3.Text = "일자별"
		RADIO3.Checked = True
	Else                     '일자
		dayb2.Text = "시간별"
		dayb3.Text = "시간별"
		RADIO2.Checked = True
	End If

	If gubn.data = "T" Then
		dayb1.Text = "차트"
		dayb4.Text = "차트"
	Else
		dayb1.Text = "데이터"
		dayb4.Text = "데이터"
	End If

	' 현재모드에 맞는 Sub맵을 호출한다.
	If mode.Data="T" And gubn.data="T" Then
		OBJ.SetObject("IB230310")  '시간별데이타
	ElseIf mode.Data="T" And gubn.data="D" Then
