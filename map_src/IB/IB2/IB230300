			SCREEN.Object("OBJ.OBJ7.obj").SetObject("IB230317")
			SCREEN.Object("OBJ.OBJ8.obj").SetObject("IB230317")
		End If
	ElseIf mode.Data="D" And gubn.data="T" Then
		OBJ.SetObject("IB230320")  '일자별데이타
	ElseIf mode.Data="D" And gubn.data="D" Then
