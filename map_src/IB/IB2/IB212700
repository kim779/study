Sub	code_trigger(code)
	SYSTEM.Trace "code_trigger: " & code
	S1301.DATA = code
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
    SYSTEM.SetHistory "1301", S1301.DATA
End Sub


Sub Send_Main()
	' 현재 코드를 시장식별자에 대입하여 NXT 지원 가능 여부 판단
	If CHECK0.Checked = True Then
		cxMarket.sCode = S1301.Data
	Else
		cxMarket.sCode = "005930"
	End If

	Dim code
	code = SCREEN.GetCodeType(S1301.Data)

	If CHECK0.Checked = True Then
		If code = 1 Or code = 6 Then
			COMBO0.Index = 0
			S20301.Data = 1
		Else
			COMBO0.Index = 1
			S20301.Data = 201
		End If
	End If


	SYSTEM.Trace "code type : " & code

	SCREEN.Send 0
	OBJECT0.Send
End Sub

