RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub savememoToServer()
	editGubn.Data = "S"
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
If Len(Trim(edcode.Data)) = 6 Then
	edcode.Data = "A" & edcode.Data
End If
outmemo.Data = ""
edID.Data = LOGIN.User

If Left(SCREEN.GetMapName(1),8) = "IB209900" Then
	SCREEN.Object("parent.GUIDE").TEXT = ""
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SYSTEM.Trace "IB209903 onreceive = " & SCREEN.GetMapName(1)

If Left(SCREEN.GetMapName(1),8) = "IB209900" Then
	If outRet.Data = "1" And outGubn.Data = "S" Then
		SCREEN.Object("parent.MEMO0").Text = outmemo.Data
	End If

	SCREEN.Object("parent.GUIDE").TEXT = outMsg.Data

ElseIf Left(SCREEN.GetMapName(1),8) = "IB209901" Then
	If outRet.Data = "1" And outGubn.Data = "S" Then
		SCREEN.Object("parent.OBJECT0.MEMO0").Text = outmemo.Data
		SCREEN.Object("parent.GUIDE").TEXT = outMsg.Data
	ElseIf outRet.Data = "0" And outGubn.Data = "S" Then
		data = CONTROL0.GetMemoData(2, edcode.Data, "")
		SCREEN.Object("parent.OBJECT0.MEMO0").Text = data
		If Len(Trim(data)) > 0 Then
			SCREEN.Object("parent.GUIDE").TEXT = "조회가 완료되었습니다.."
		End If
	End If

	If outGubn.Data <> "S" Then
		SCREEN.Proc "parent.closemap",""
	End If

End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



