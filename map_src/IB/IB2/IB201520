	End If
	g_ArrGrid(Index)(1) = g_ArrGrid(Index)(0).Row
	g_ArrGrid(Index)(2) = g_ArrGrid(Index)(0).GetPRgb(g_ArrGrid(Index)(0).Row, 1)
	For i = 1 To 8
		g_ArrGrid(Index)(0).SetPRgb g_ArrGrid(Index)(0).Row, i, 78
	Next
End Sub
'-----------------------------------------------------------------------
Sub grid_Click(gname)
	If Len(gname) = 5 Then
		ProcFocus Mid(gname, 5, 1)
	End If
	Dim code, grid
	Set grid = SCREEN.Object(gname)
	If grid.HitPos = 3 Then
		code = Trim(grid.GetGridCell(grid.row, 2))
		If Trim(code) <> "" And Trim(code) <> SCREEN.Object("main.1301").Data Then
			SCREEN.Object("main.1301").Data = code
			SCREEN.Object("main.1301").Trigger "", True
			SYSTEM.SetHistory "1301", code
		End If
	End If
End Sub
'-----------------------------------------------------------------------
Sub grid_DblClick(gname)
	Dim code, grid
