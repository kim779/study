		OBJ.SetObject "IB2909T1"
		TEXT.Visible = False
		CHART.Visible = True
		'KFGB.Visible = True
		CHK.TEXT = CHART.TEXT
	End If

	SCREEN.Object("OBJ.gubn").data = GUBN.Data
	OBJ.Send
End If
End Sub


