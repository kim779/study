RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim flag

Sub send_f()
	flag = 0
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
trac.Data = Trim(SCREEN.Object("parent.TRAD").Data)
VAGB.Data = Trim(SCREEN.Object("parent.VAGB").Data)
dygb.Data = Trim(SCREEN.Object("parent.dygb").Data)

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
S400.Column = 6
If VAGB.Data = "1" Then
	S400.Head = "순매수량"
ElseIf VAGB.Data = "2" Then
	S400.Head = "순매도량"
ElseIf VAGB.Data = "3" Then
	S400.Head = "순매수금액"
ElseIf VAGB.Data = "4" Then
	S400.Head = "순매도금액"
End If

S400.Column = 5
If VAGB.Data = "1" Or VAGB.Data = "2" Then
	S400.Head = "매도량"
ElseIf VAGB.Data = "3" Or VAGB.Data = "4" Then
	S400.Head = "매도대금"
End If

S400.Column = 4
If VAGB.Data = "1" Or VAGB.Data = "2" Then
	S400.Head = "매수량"
ElseIf VAGB.Data = "3" Or VAGB.Data = "4" Then
	S400.Head = "매수대금"
End If

Dim prePage
prePage = Trim(SCREEN.Object("parent.page1").Data)

If flag <> 0 Then
	If Is_numeric(prePage) = True And Is_numeric(page1.Data) = True Then
		If CLng(prePage) > CLng(page1.Data) Then
			S400.Index S400.Rows - 5
			S400.Index S400.Rows - 4
			S400.Index S400.Rows - 3
			S400.Index S400.Rows - 2
			S400.Index S400.Rows - 1
			S400.Index S400.Rows
		End If
	End If
Else
	flag = 1
End If

SCREEN.Object("parent.page1").Data = Trim(page1.Data)
SCREEN.Object("parent.page2").Data = Trim(page2.Data)

SCREEN.Object("parent.GRID0").SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(400)
_AW_ONCLICK_AW_
If S400.HitPos = 3 Then
	S1301.DATA = S400.GetGridCell(S400.row, 2)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.Data
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



