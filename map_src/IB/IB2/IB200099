			xxgb = "X"									'처리구분(이하의 값이 세팅되지않을경우 X)
			sygb = ""									'신용구분코드(103:자기융자상환 ...)
			val  = Trim(VIEWGRID.GetGridCell(ii, 17))   '신용분류코드
			If sycd = "01" Then
				xxgb = "B"
				sygb = "1" & val   '신용분류코드
			End If
			dcdt = VIEWGRID.GetGridCell(ii, 18)			'대출일자

			s_data = "^" & s_data
			s_data = dcdt & "|" & s_data				'대출일자
			s_data = sygb & "|" & s_data				'신용구분코드(103:자기융자상환코드 ...)
			s_data = xxgb & "|" & s_data				'처리구분
			s_data = jcgb & "|" & s_data				'정정취소
			s_data = jmjg & "|" & s_data				'주문조건
			s_data = hogb & "|" & s_data				'호가구분
			s_data = jmga & "|" & s_data				'주문가격
			s_data = hjan & "|" & s_data				'호가잔량
			s_data = jmsu & "|" & s_data				'주문수량
			s_data = miga & "|" & s_data				'매입단가(평균단가)
			s_data = jmna & "|" & s_data				'종목명
			s_data = code & "|" & s_data				'종목코드
			s_data = jmno & "|" & s_data				'원주문번호
			s_data = pass & "|" & s_data				'비밀번호
			s_data = accn & "|" & s_data				'계좌번호
			s_data = mmgb & "|" & s_data				'매매구분
			s_data = mkgb & "|" & s_data				'시장구분
			s_data = jmgb & "|" & s_data				'주문유형
			s_data = sycd & "|" & s_data				'신용구분(00:일반 01:신용 02~04:대용 05:기타)
			s_data = "1" & "|" & s_data					'chk
		End If
	End If
Next

num.data = cnt											'처리건수

If cnt > 0 Then
	num.Push ""
	SCREEN.CreateWindow 2, "IB120110 /p5 /d", "s_data" & vbTab & s_data & vbLf & "AN1A" & vbTab & AN1A.Data & vbLf & "pswd" & vbTab & SCREEN.Object("main.OBJ_order.ed_pswd").Data & vbLf & "MKCD" & vbTab & cxMarket.sMarket & vbLf

	clear_check()
End If

