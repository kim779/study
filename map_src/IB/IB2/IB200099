''*************************************************
''send ui data
''*************************************************
Sub f_vSendUiData()
	Dim accn, pass,tax,mmd

	SCREEN.OnSend False
	VIEWGRID.Clear

	If cbo_mmd.Index = 0 Then
		mmd = out_hts.data
	ElseIf cbo_mmd.Index = 1 Then
		mmd = out_call.data
	ElseIf cbo_mmd.Index = 2 Then
		mmd = out_ars.data
	End If

	' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "0" And Trim(pswd.Data) = "" Then
	   pswd.Data = "9999"
	End If

	accn = Trim(AN1A.Data)						'계좌번호
	pass = Trim(pswd.Data)						'비밀번호
	tax = cbo_tax.data

	If Len(Trim(accn)) <> 11 Then
		Exit Sub
	End If

	If Len(Trim(pass)) < 4 Then
		Exit Sub
	End If

	CONTROL0.SetMcgb = cbo_mmd.Index

	Call CONTROL0.Send(accn , pass, tax ,mmd )

	SCREEN.Wait = True
End Sub

