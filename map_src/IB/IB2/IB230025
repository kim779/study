RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim g_ArrData

g_ArrData = Array(Array("기초자산", "00"), Array("대비", "01"))

'--------------------------------------------------------------------------------------
Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB230025", "col_num", col_num.Data
	End If
End Sub
'--------------------------------------------------------------------------------------
Sub p_read_ini()
	Dim ArrCols, i, HeadData
	If SCREEN.CreateObject("INFO") = True Then

		Dim tmp
		tmp = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB230025", "col_num"))

		If tmp = "" Then
			S104310.SetColumnVisible 4, True
			S104310.SetColumnVisible 5, False
			col_num.Data = 4
		ElseIf tmp = "4" Then
			S104310.SetColumnVisible 4, True
			S104310.SetColumnVisible 5, False
			col_num.Data = 4
		Else
			S104310.SetColumnVisible 4, False
			S104310.SetColumnVisible 5, True
			col_num.Data = 5
		End If
	End If
End Sub
'--------------------------------------------------------------------------------------

_AW_ONSTART_AW_
S100301.Data = Trim(SCREEN.Object("parent.ed_fcod").data)
'SCREEN.Send 0
p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S100301.Data = Trim(SCREEN.Object("parent.ed_fcod").data)

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(104310)
_AW_ONCLICK_AW_
If S104310.HitPos = 4 Then
	Dim i
	For i = LBound(g_ArrData) To UBound(g_ArrData)
		If Trim(S104310.GetHeadCell( S104310.Column )) = g_ArrData(i)(1) Then

			S104310.SetHead S104310.Column, g_ArrData(i)(0)

			If Trim(S104310.GetHead(col_num.Data)) = "기초자산" And S104310.Column = 5  Then
				S104310.SetColumnVisible 4, True
				S104310.SetColumnVisible 5, False
				S104310.SetHead S104310.Column, g_ArrData(i+1)(0)							' 변경된 column head 원복
				col_num.Data = 4															' 보여지는 column 저장
			ElseIf Trim(S104310.GetHead(col_num.Data)) = "대비" And S104310.Column = 4 Then
			 	S104310.SetColumnVisible 4, False
				S104310.SetColumnVisible 5, True
				S104310.SetHead S104310.Column, g_ArrData(i-1)(0)
				col_num.Data = 5
			End If

			Exit For
		End If
	Next
    p_write_ini
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


