If SCREEN.CreateObject("Info") Then
	sjcd = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "300903"))
	If sjcd = "" Then
		sjcd = "0"
	End If
	If sjcd = "0" Then
		r1_0.Checked = True
		r1_1.Checked = False
		r1_2.Checked = False
	ElseIf sjcd = "1" Then
		r1_0.Checked = False
