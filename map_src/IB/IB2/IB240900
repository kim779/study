	Data2 = ADate & "|" & JnGb & "|" & AGubn & "|" & "00"

	OBJ0.Proc "SetData", Data1
	'OBJ0.Send

	OBJ1.Proc "SetData", Data2
	'OBJ1.Send

End Sub

Sub Change_MKGubn_Main(sMKGubn)

SYSTEM.Trace "[IB240500]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	SendData()

End Sub

