	End If
	S300905.Data = gubn
End If

S300900.Data = "F"
S300901.Data = LOGIN.Day0

SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If cxMarket.sMarket = "NXT" Then
