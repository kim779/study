_AW_ONDECLARE_AW_
Sub rd_click()
	Dim ii

	If r2_1.Checked Then
		For ii=1 To 20
			If ii = 7 Then
				SCREEN.Object("obj0.GUBN"&ii).Checked = False
			Else
				SCREEN.Object("obj0.GUBN"&ii).Checked = True
			End If
		Next
	ElseIf r2_2.Checked Then
		For ii=1 To 20
			If ii = 2 Then
				SCREEN.Object("obj0.GUBN"&ii).Checked = True
			Else
				SCREEN.Object("obj0.GUBN"&ii).Checked = False
			End If
		Next
	ElseIf r2_3.Checked Then
		For ii=1 To 20
			If ii = 2 Or ii = 7 Then
				SCREEN.Object("obj0.GUBN"&ii).Checked = False
			Else
				SCREEN.Object("obj0.GUBN"&ii).Checked = True
			End If
		Next
	Else

	End If
End Sub

_AW_ONSTART_AW_
SCREEN.SetTimer 2, False

If SCREEN.CreateObject("Info") Then
	Dim rd_val
	Dim chkval
	rd_val = Trim(INFO.popData (LOGIN.Name, "userconf.ini", "IB200400", "RD_CHK"))

	If rd_val = "" Then
		rd_val = "1"
	End If
	Select Case rd_val
	Case 1
		r2_1.Checked = True
		r2_2.Checked = False
		r2_3.Checked = False
	Case 2
		r2_1.Checked = False
		r2_2.Checked = True
		r2_3.Checked = False
	Case 3
		r2_1.Checked = False
		r2_2.Checked = False
		r2_3.Checked = True
	End Select

	newsdata = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB200400", "news"))

	If newsdata = "1" Then
		RADIO0.Checked = True
		obj0.SetObject "IB200439"
		obj0.Send
		'obj0.SetRect 280, 26, 560, 188
	ElseIf newsdata = "2" Then
		RADIO1.Checked = True
		obj0.SetObject "IB200438"
		obj0.Send
		'obj0.SetRect 0, 26, 280, 188

		r2_1.Enable = False
		r2_2.Enable = False
		r2_3.Enable = False
	End If
Else
	r2_1.Checked = True
	r2_2.Checked = False
	r2_3.Checked = False
End If

rd_click()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False
obj0.Send

