_AW_ONDECLARE_AW_
Option Explicit

'-----------------------------------------------------------------------
Sub progMm(cvol)
	Dim ii
	For ii = 3 To GRID0.Columns
		If GRID0.GetHead(ii) = "프로그램" Then
			If CDbl(cvol) > 0 Then
				cvol = "+" & cvol
			End If

			GRID0.SetGridCell 1, 8, cvol
		End If
	Next
End Sub
'-----------------------------------------------------------------------
Sub SetItems()
	Dim PrcFlag, PrgFlag
	PrcFlag = 1
	PrgFlag = 1

	OBJ1.Proc "SetFlag", PrcFlag
	obj_mm.Proc "SetFlag", PrgFlag
End Sub
'-----------------------------------------------------------------------
Function NullCheck(Data)
	If Trim(data) = "" Then
		Null_check = 0
		Exit Function
	End If
	Null_check  = CLng(Data)
End Function
'-----------------------------------------------------------------------
Sub ProcSetData(Data)
	Dim ArrData, CurPrc, Rate

	ArrData = Split(Data, "|")
	CurPrc = ArrData(1)
	Rate = ArrData(2)


	Dim tmpCurPrc
	tmpCurPrc = CDbl(Trim(CurPrc))

	If tmpCurPrc < 0 Then
		GRID0.SetGridCell 1, 3, Abs(tmpCurPrc)
		GRID0.SetTRgb 1, 3, 95
	ElseIf tmpCurPrc > 0 Then
		GRID0.SetGridCell 1, 3, tmpCurPrc
		GRID0.SetTRgb 1, 3, 94
	End If

	GRID0.SetGridCell 1, 4, Rate
End Sub
'-----------------------------------------------------------------------

_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.1301").Data

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1301.Data = SCREEN.Object("main.1301").Data
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1301.Data = "N." & SCREEN.Object("main.1301").Data
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1301.Data = "M." & SCREEN.Object("main.1301").Data
	End If
End If

