_AW_ONCLICK_AW_
SCREEN.IgnoreChange True

Dim jqty, jprc, ogno, code, name, acno

acno = SCREEN.Object("parent.AN1A").Data
ed_pswd.Data = SCREEN.Object("parent.ed_pswd").Data
If Trim(acno) = "" Then
	SCREEN.Object("parent.AN1A").Setfocus
	MsgBox "계좌번호를 확인하세요", , "조회에러"
	Exit Sub
End If
If Trim(ed_pswd.data) = "" Then
	SCREEN.Object("parent.ed_pswd").Setfocus
	MsgBox "비밀번호를 확인하세요", , "조회에러"
	Exit Sub
End If

SYSTEM.Push "S_code", ""
SYSTEM.Push "S_jqty", ""
SYSTEM.Push "S_jprc", ""
SYSTEM.Push "S_ogno", ""

SCREEN.CreateWindow 2, "IB100191 /p5 /d", "AN1A" & vbTab & acno & vbLf & _
											"pswd" & vbTab & ed_pswd.Data & vbLf

o_jmno.Clear
code = Trim(SYSTEM.Pop("S_code"))
If code <> "" Then
	S1301.Data = code
	Call changecode()
	SCREEN.Proc "main.send_sise_all", "jumun"
End If

ogno = Trim(SYSTEM.Pop("S_ogno"))
If ogno <> "" Then ed_ogno.Data = ogno

jqty = Trim(SYSTEM.Pop("S_jqty"))
If jqty <> "" Then ed_jqty.Data = jqty

SCREEN.IgnoreChange False
