{


_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999912) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "4"

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN16.name
	ed_pswd.Data = AN16.pswd
	SCREEN.Proc "main.Set_account", "jumn"
	o_jmno.Clear
	mesg.Text = ""
End Sub

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos
	Dim mdgb, dmsg
	Dim sHnam

	Call init_data2()									'매수주문 기본세팅

	If Error_check2() = False Then				'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		If r_mdgb1.Checked = True Then
			mdgb = "일부취소"
		Else
			mdgb = "전부취소"
		End If

		sHnam = Replace(Mid(SCREEN.Object("OBJ_hnam.1022").Data,2), "/","／")
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("main.OBJ_order.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & sHnam & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_mdgb" & vbTab & mdgb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf
		SCREEN.CreateWindow 2, "IB10018A /p5 /d", dmsg
		If SYSTEM.Pop("stock_cancel_order") <> "OK" Then
			Exit Sub
		End If
	End If
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

	cPos = OrdCfg.ReadCfg("CursorPos")
	Select Case cPos
		Case "0" : SCREEN.Object("main.OBJ_order.AN1A").SetFocus()
		Case "1" : SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus()
		Case "2" : S1301.SetFocus()
		Case "3" : ed_jqty.SetFocus()
		Case "4" : ed_jprc.SetFocus()
	End Select
End Sub


'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check2()
	Dim mstr
	Error_check2 = False
	If Trim(ed_acno.Data) = "" Then
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus
		MsgBox "계좌번호를 입력하십시오.", , "IBK투자증권"
		Exit Function
	End If
	If Len(Trim(ed_pswd.Data)) < 4 Then
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		MsgBox "비밀번호를 입력하십시오.", , "IBK투자증권"
		Exit Function
	End If
	Select Case mmgb
		Case "1" : mstr = "매도"
		Case "2" : mstr = "매수"
		Case "3" : mstr = "정정"
		Case "4" : mstr = "취소"
	End Select

	'시장구분 Set
	If	Set_mkgb(S1301.Data) = False Then
		MsgBox "종목코드를 확인하십시오.", , "IBK투자증권"
		S1301.SetFocus
		Exit Function
	End If

	'주문수량 check
	If ed_jqty.Enable = True And Is_numeric(ed_jqty.Data) = False Then
		MsgBox mstr & "수량을 입력하십시오.", , "IBK투자증권"
		ed_jqty.SetFocus
		Exit Function
	End If

	'주문단가 check
	If mstr <> "취소" Then
		If ed_jprc.Enable = True And Is_numeric(ed_jprc.Data) = False Then
			MsgBox mstr & "가격을 입력하십시오.", , "IBK투자증권"
			ed_jprc.SetFocus
			Exit Function
		End If
	End If

	If mstr = "정정" Or mstr = "취소" Then
		If Is_numeric(ed_ogno.Data) = False Then
			MsgBox "원주문번호를 확인하십시오.", , "IBK투자증권"
			ed_ogno.SetFocus
			Exit Function
		End If
	End If

	'주문착오방지를 위한 모범규준 check
	If chk_mistake_order(S1301.Data) = False Then
		Exit Function
	End If

	Error_check2 = True
End Function

'***************************************************************************
' DESC: 주문시 반드시 초기화해야 할 값
'***************************************************************************
Sub init_data2()
SCREEN.IgnoreChange True
	ed_acno.Data = SCREEN.Object("main.OBJ_order.AN1A").data	'계좌번호
	ed_pswd.Data = SCREEN.Object("main.OBJ_order.ed_pswd").data	'비밀번호
	ed_odgb.Data = "1"			'주문유형
	ed_mmgb.Data = mmgb			'매매구분

	Select Case mmgb
		Case "3"
			ed_hogb.data = shogb.Data
			ed_jmgb.Data = "00"			'주문조건
			o_jmno.Clear				'주문번호
		Case "4"
			ed_jprc.Data = ""			'주문단가
			ed_hogb.Data = ""			'호가구분
			ed_jmgb.Data = "00"			'주문조건
			o_jmno.Clear				'주문번호
		Case Else
			ed_ogno.Data = ""			'원주문번호
			ed_mdgb.Data = ""			'정정취소
	End Select
SCREEN.IgnoreChange False

	Call Set_prgb()				'--처리구분값 설정(현금/신용/대용)

	SCREEN.Object("main.guide").Text = " "					'메세지
End Sub

