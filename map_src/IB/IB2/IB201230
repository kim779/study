RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Navigate()
	SCREEN.SetTimer 3, False
End Sub

_AW_ONRECEIVE_AW_
SCREEN.Proc "OBJ_STAFF.Send_F", ""

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Dim shost, id
If Trim(S1301.Data) <> "" Then
	shost = SYSTEM.Host
	If Mid(shost,1,6) = "172.17" Then	' 내부망
		If SYSTEM.ConnectBy = 1 Then	' 직원
			id = Trim(LOGIN.User)		' 직원사번
		Else
			id = Trim(SCREEN.Object("OBJ_STAFF.emno").Data) ' 직원사번
		End If
		If Len(id) > 0 Then	' 직원사번 존재시 CDN으로 망연계 인터넷 단말에서 조회
			url = "https://www.ibks.com/redirectCDN.jsp?url=http%3A//consensus.hankyung.com/analysis/list%3Freport_type%3DCO%26search_value%3DREPORT_TITLE%26search_text%3D"&Trim(S1301.Data)&"&id="&id
			SYSTEM.Navigate url
		Else				' 직원 사번 미존재시 일반 고객으로 간주
			BROWSER0.Navigate("https://consensus.hankyung.com/analysis/list?report_type=CO&search_value=REPORT_TITLE&search_text=" + Trim(S1301.Data))
		End If
	Else	' 외부망 :: bypass
		BROWSER0.Navigate("https://consensus.hankyung.com/analysis/list?report_type=CO&search_value=REPORT_TITLE&search_text=" + Trim(S1301.Data))
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If Trim(S1301.Data) = "000000" Or Trim(S1301.Data) = "" Then
	Exit Sub
End If
S1301.Trigger "",True
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BROWSER0)
_AW_ONCLICK_AW_
SYSTEM.Push "DOYOUAGREE", "YES"
SCREEN.CloseWindow()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



