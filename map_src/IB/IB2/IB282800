_AW_ONDECLARE_AW_
Sub inputdata()
	etpg.Data = etpg_.Data
	iocd.Data = iocd_.Data
	If RADIO0.Checked = True Then
		imil.Data = "01"
		imim.Data = imim_1.Data
	ElseIf RADIO1.Checked = True Then
		imil.Data = "02"
		imim.Data = imim_2.Data
	End If
	imis.Data = imis_.Data
	iacl.Data = iacl_.Data
	iacm.data = iacm_.Data
	iacs.Data = iacs_.Data
	etps.Data = etps_.Data
	rign.Data = rign_.data
	If RADIO1.Checked = False Then
		GRID0.SetColumnVisible 11, False
		GRID0.SetColumnVisible 12, False
	Else
		GRID0.SetColumnVisible 11, True
		GRID0.SetColumnVisible 12, True
	End If
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	Call inputdata()
	mesg.Data = ""
	SCREEN.Send 0
End Sub

Sub itemset1()
	Dim items1

	items1 = ""

	Select Case imim_2.Data

	Case "05"
		items1 = "00" & vbTab & "00전체" & vbTab & "01중국" & vbTab & "02홍콩" & vbTab & "03일본" & vbTab & "04인도" & vbTab & "05베트남" & vbTab & "06호주" & vbTab & "07대만" & vbTab & "08인도네시아" & vbTab & "09필리핀"
	Case "06"
		items1 = "00" & vbTab & "00전체" & vbTab & "01미국"
	Case "07"
		items1 = "00" & vbTab & "00전체" & vbTab & "01브라질"
	Case "08"
		items1 = "00" & vbTab & "00전체" & vbTab & "01영국" & vbTab & "02독일" & vbTab & "03러시아"
	Case Else
		items1 = "00" & vbTab & "00전체"

	End Select

	imis_.SetItems(items1)
End Sub

Sub itemset2()
	Dim item,items2

	item = "00" & vbTab & "00전체"
