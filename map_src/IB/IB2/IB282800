	Case "03"
		items2 = "00" & vbTab & "00전체" & vbTab & "01혼합" & vbTab & "02금속" & vbTab & "03에너지" & vbTab & "04농산물"
	Case "03"
		items2 = "00" & vbTab & "00전체" & vbTab & "01주가지수" & vbTab & "02변동성" & vbTab & "03구조화"
	Case "04"
		items2 = "00" & vbTab & "00전체" & vbTab & "01리츠"
	Case "05"
