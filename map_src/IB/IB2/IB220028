	For ii = 14 To 16
		If ii = CLng(SCREEN.object("obj01.COMBO0").Data)+5 Then
			Call SCREEN.object("obj02.62311").SetColumnVisible( ii, True)
		Else
			Call SCREEN.object("obj02.62311").SetColumnVisible( ii, False)
		End If
	Next
	'SCREEN.Send 0

End Sub

Sub SetComboItem(nIndex)
	Dim sItem
	If nIndex = "1"Then
		sItem = "09" & vbTab & "09연기금등 " & vbTab & "11기타법인"
	Else
		sItem = "11" & vbTab & "11기타"
	End If

	SCREEN.proc "obj01.SetComboItems" , sItem

End Sub

