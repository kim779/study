RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim count

'-----------------------------------------------------------------------
Sub p_write_ini(state)
	If SCREEN.CreateObject("INFO") = True Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB200111", "c_INDX", Trim(state)
		INFO.PushData LOGIN.Name, "userconf.ini", "IB200111", "c_CHK", is_real.Checked
	End If
End Sub
'-----------------------------------------------------------------------
Sub p_read_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim state, chk
		chk = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB200111", "c_CHK"))
		If Trim(chk) <> "" Then
			is_real.Checked = chk
		End If

		state = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB200111", "c_INDX"))
		If Trim(state) <> "" Then
			S11310.SetHeadCell 5, state
			S11310.SetHeadCell 6, state
			change_state(state)
		End If
	End If
End Sub
'-----------------------------------------------------------------------
Sub change_state(state)
	Select Case state
	Case "00"	' 거래량
		S11310.SetColumnVisible 5, True
		S11310.SetColumnVisible 6, False
	Case "01"	' 체결강도
		S11310.SetColumnVisible 5, False
		S11310.SetColumnVisible 6, True
	End Select
	Call p_write_ini(state)
	SCREEN.SetTimer 1, False
End Sub

_AW_ONINDECLARE_AW_
#load IB999901

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
S11310.SetHeadCell 5, "00"
S11310.SetHeadCell 6, "00"
Call p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.1301").Data
If Len(Trim(S1301.Data)) <> 6 Then
	SCREEN.OnSend False
	Exit Sub
End If

SetMKGubn777()
SYSTEM.Trace "[MKGubn][IB200111][onSend][poop]1301 = " & S1301.Data & " 1777 = " & S1777.Data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If is_real.Checked = False Then
	S1021.Clear
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
Call p_write_ini(Trim(S11310.GetHeadCell( 5 )))

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(11310)
_AW_ONCLICK_AW_
If S11310.HitPos = 4 Then
	Select Case S11310.Column
	Case 5, 6	' Change Column Visible
		Dim state
		state = Trim(S11310.GetHeadCell( S11310.Column ))
		S11310.SetHeadCell 5, state
		S11310.SetHeadCell 6, state
		Call change_state(state)
	End Select
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(is_real)
_AW_ONCLICK_AW_
Dim state
state = Trim(S11310.GetHeadCell( 5 ))
Call p_write_ini(state)
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim state
state = Trim(S11310.GetHeadCell( 5 ))
Call p_write_ini(state)
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(real_push)
_AW_ONCLICK_AW_
real_push.Visible False
real_pop.Visible True
real_pop.Checked False

Call IsReal_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(real_pop)
_AW_ONCLICK_AW_
real_push.Visible True
real_pop.Visible False
real_push.Checked True

Call IsReal_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


