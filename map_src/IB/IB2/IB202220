Sub Onalert()
	Dim	v_gubn, v_date

	'해당종목뉴스 아니면 exit
	If Mid(TABLE0.GetTableCell(4), 1, 6) <> S1301.data Then
		Exit Sub
	End If

	'뉴스 구분

	If IsNumeric(Trim(TABLE0.GetTableCell(8))) = False Then
		Exit Sub
	End If

	v_gubn = CLng(Trim(TABLE0.GetTableCell(8)))

	If v_gubn < 1 And v_gubn > 20 Then
		Exit Sub
	End If

	Select Case v_gubn
	Case 1 :	If GUBN1.Checked  = False Then Exit Sub
	Case 2 :	If GUBN2.Checked  = False Then Exit Sub
	Case 3 :	If GUBN3.Checked  = False Then Exit Sub
	Case 4 :	If GUBN4.Checked  = False Then Exit Sub
	Case 5 : 	If GUBN5.Checked  = False Then Exit Sub
	Case 6 :	If GUBN6.Checked  = False Then Exit Sub
	Case 7 : 	If GUBN7.Checked  = False Then Exit Sub
	Case 8 :	If GUBN8.Checked  = False Then Exit Sub
	Case 9 :	If GUBN9.Checked  = False Then Exit Sub
	Case 10 :	If GUBN10.Checked = False Then Exit Sub
	Case 11 : 	If GUBN11.Checked = False Then Exit Sub
	Case 12 : 	If GUBN12.Checked = False Then Exit Sub
	Case 13 : 	If GUBN13.Checked = False Then Exit Sub
	Case 14 : 	If GUBN14.Checked = False Then Exit Sub
	Case 15 : 	If GUBN15.Checked = False Then Exit Sub
	Case 16 : 	If GUBN16.Checked = False Then Exit Sub
	Case 17 : 	If GUBN17.Checked = False Then Exit Sub
	Case 18 : 	If GUBN18.Checked = False Then Exit Sub
	Case 19 : 	If GUBN19.Checked = False Then Exit Sub
	Case 20 : 	If GUBN20.Checked = False Then Exit Sub
	Case Else
		Exit Sub
	End Select

	' add GRID row
	v_date = GRID0.GetGridCell(1,1)
	GRID0.InsertRow 0
	GRID0.SetGridCell 1, 1, v_date		'날짜
	GRID0.SetGridCell 1, 2, TABLE0.GetTableCell(6)		'시간
	GRID0.SetGridCell 1, 3, TABLE0.GetTableCell(2)		'제목
	GRID0.SetGridCell 1, 4, v_name(v_gubn-1)
	GRID0.SetGridCell 1, 5, TABLE0.GetTableCell(9)		'제공처
	GRID0.SetGridCell 1, 6, TABLE0.GetTableCell(4)		'종목코드
	GRID0.SetGridCell 1, 7, TABLE0.GetTableCell(5)		'종목명
	GRID0.SetGridCell 1, 8, TABLE0.GetTableCell(8)		'구분1
	GRID0.SetGridCell 1, 9, TABLE0.GetTableCell(9)		'구분2
	GRID0.SetGridCell 1, 10, TABLE0.GetTableCell(11)	'Keyv
	GRID0.SetGridCell 1, 11, TABLE0.GetTableCell(10)	'Flag

	GRID0.Index = 0
	TABLE0.Data = ""
	TABLE0.SetTableCell 1, "S0000"
'	If GRID0.Index < 1000 Then
'		GRID0.Index = GRID0.Index + 1
'	End If
End Sub

