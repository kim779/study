'증권사 비교
Function CheckSignal(sec)
	Dim result

	If Left(Trim(sec) , 1) = "+" Or Left(Trim(sec) , 1) = "-" Then
		result = Mid(Trim(sec), 2)
	Else
		result = Trim(sec)
	End If

	CheckSignal = result
End Function


'실시간으로 들어온 증권사중에 비교대상이 있는 검색
Function FindingSec(sec)
	FindingSec = 0
	Dim sum, compareA, compareB

	sum = ""

	If Trim(sec) = "" Then
		compareA = 0
	Else
		compareA = CLng(sec)
	End If



	'부호가 있을 경우 제거하고 비교 -> 코드로 비교
	For i = LBound(g_ArrRealCode) To 4

		If Trim(g_ArrRealCode(i).data) = "" Then
			compareB = 0
		Else
			compareB = CLng(Trim(g_ArrRealCode(i).data))
		End If

		If compareA = compareB Then
			sum = CStr(i+1)
		End If
	Next

	For i = 5 To UBound(g_ArrRealCode)

		If Trim(g_ArrRealCode(i).data) = "" Then
			compareB = 0
		Else
			compareB = CLng(Trim(g_ArrRealCode(i).data))
		End If

		If compareA = compareB Then
			sum = sum + CStr(i+1)
		End If
	Next

	If sum = "" Then
		sum = "0"
	End If

	FindingSec = sum
End Function


