				md_1 = 0
			End If

			If Trim(md_2) = "" Then
				md_2 = 0
			End If


			If signal = 1 Then
				ProceedResult = comareData(sec, CDbl(ms_2) + CDbl(md_2), CDbl(ms_1) + CDbl(md_1))
