_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
Select Case GRID1.HitPos
Case 3	'DATA부 click
	SYSTEM.Trace "Onclick"
	Dim data
	data = Trim(GRID1.GetGridCell(GRID1.Row, 1))
	SYSTEM.Trace "data ; " & data
	If Len(data) = 6 Then
		S1301.Data = data

		If Trim(S1301.DATA) = "" Then
		    Exit Sub
		End If

	    SCREEN.Object("main.1301").Data = S1301.Data
	    SCREEN.Proc "main.Send_sise_all", "main"

'		SCREEN.CreateWindow 1, "IB201400 /t/s/d", "1301" & vbTab & S1301.Data & vbLf
	End If
Case 4
	Select	Case GRID1.Column
		Case 7	'성과분석 클릭
			sort = 4
		Case 8
			sort = 5
		Case 9
			sort = 6
		Case 10
			sort = 7
		Case 11
			sort = 8
		Case Else
			Exit Sub

	End Select

	SYSTEM.Trace "STEP0  edit4.Data : " & EDIT4.Data & "  edit5.Data :  " & EDIT5.Data & " column : " & GRID1.Column
	If EDIT4.Data = "F" And EDIT5.Data <> GRID1.Column Then		' 첫 조회

		If EDIT5.Data = "-1" Then
			SYSTEM.Trace "STEP2"

			COMBO1.index = sort - 1
			COMBO1.data = sort
			EDIT1.Data = sort
			EDIT3.Data = "1"
			EDIT4.Data = "N"
			EDIT5.Data = GRID1.Column

		End If

	ElseIf EDIT4.Data = "N" And Trim(EDIT5.Data) <> Trim(GRID1.Column) Then
			COMBO1.index = sort - 1
			COMBO1.data = sort
			EDIT1.Data = sort
			EDIT3.Data = "1"
			EDIT4.Data = "N"
			EDIT5.Data = GRID1.Column

	ElseIf EDIT4.Data = "N" And Trim(EDIT5.Data) = Trim(GRID1.Column) Then		' 첫 조회
		SYSTEM.Trace "000000000000000000000000000000"
		EDIT3.Data ="0"
		'EDIT4.Data = "F"
		EDIT5.Data = "-1"
'	Else
'		EDIT3.Data ="0"
'		EDIT4.Data = "F"
'		EDIT5.Data = "-1"
	End If

	SCREEN.IgnoreChange True
	SYSTEM.Trace "STEP3 combo1.index " &  COMBO1.index
	SYSTEM.Trace "STEP4  edit4.Data : " & EDIT4.Data & "  edit5.Data :  " & EDIT5.Data
	SCREEN.Send 0
Case Else
	SCREEN.OnSend = False
	Exit Sub

End Select
