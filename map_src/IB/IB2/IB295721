RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFile = "userconf.ini", myMap = "IB295700"

Private Sub saveUserConfig()
	If SCREEN.CreateObject("Info") Then
			INFO.pushData LOGIN.Name, myFile, myMap, "COMB", COMB.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "COM2", COM2.Data

			If(COMB.Data = "2") Then
			       BSIS_1.Data = F1.Data
			       BSIS_2.Data = F2.Data
			Else
			       GRYL_1.Data = F1.Data
			       GRYL_2.Data = F2.Data
			End If

			INFO.pushData LOGIN.Name, myFile, myMap, "BSIS_1", BSIS_1.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "BSIS_2", BSIS_2.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GRYL_1", GRYL_1.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GRYL_2", GRYL_2.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GJDY", GJDY.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "ILSU", ILSU.Data
	End If
End Sub

_AW_ONSEND_AW_
COMB.Data = SCREEN.Object("main.COMB").Data
COM2.Data = SCREEN.Object("main.COM2").Data
F1.Data = SCREEN.Object("main.F1").Data
F2.Data = SCREEN.Object("main.F2").Data
ILSU.Data = SCREEN.Object("main.ILSU").Data

If (Len(Trim(SCREEN.Object("main.GJDY").Data)) > 0) Then
       GJDY.Data = SCREEN.Object("main.GJDY").Data
End If

_AW_ONENDSUB_AW_
}



