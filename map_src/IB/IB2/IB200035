_AW_ONDECLARE_AW_
Sub send_tr(acno, pwd, mmgb, cod2, pric, flag, zdate)
	SCREEN.ClearAll 0, 2
	ed_acno.Data = acno
	zPwd.Data = pwd
	zBnsTp.Data = mmgb
	zIsuNo.Data = cod2
	dOrdPrc.Data = pric
	l_avol.Data = flag
	LoanDt.Data = zdate
	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

SCREEN.ClearAll 0, 2
Exit Sub
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
SCREEN.Proc "main.Set_guide", " "

ed_acno.Data = SCREEN.Object("main.OBJ_order.AN1A").data
Call Password_initSetting(zPwd)

If Trim(ed_acno.Data) = "" Then
	MsgBox "계좌번호를 확인하세요", ,"IBK투자증권"
	If SCREEN.GetMapName(1) = "IB105000" Then
		SCREEN.Object("main.OBJ_order.AN18").SetFocus
	Else
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus
	End If
	Exit Sub
End If

If SYSTEM.ConnectBy = "1" Then
	If Trim(zPwd.Data) = "" Then
		MsgBox "비밀번호를 확인하세요", ,"IBK투자증권"
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Sub
	End If
End If

If Len(Trim(zIsuNo.Data)) <> 6 Then
	MsgBox "종목코드를 확인하세요", ,"IBK투자증권"
	SCREEN.Object("parent.1301").SetFocus
	Exit Sub
End If
If zBnsTp.Data = "2" Then	'-- 매수일 때 단가입력
	If Trim(dOrdPrc.Data) = "" Or CLng(dOrdPrc.Data) = 0 Then
		If SCREEN.Object("parent.shogb").Data <> "03" Then '시장가아닐때
			SCREEN.Object("main.guide").Text = "주문단가를 확인하세요"
			SCREEN.Object("parent.ed_jprc").SetFocus
			Exit Sub
		End If
	End If
End If

If SCREEN.GetCodeType(zIsuNo.Data) = 9 Then		' ELW
	zIsuNo_A.Data = "J"
ElseIf SCREEN.GetCodeType(zIsuNo.Data) = 27 Then		' Etn
	zIsuNo_A.Data = "Q"
Else
	zIsuNo_A.Data = "A"
End If

If Trim(SCREEN.Object("parent.ed_jprc").Data) = "0000000000" Then
	dOrdPrc.Data = SCREEN.Object("main.OBJ_sise.2023").data
	SCREEN.Object("parent.ed_jprc").Data = dOrdPrc.Data
Else
	dOrdPrc.Data = SCREEN.Object("parent.ed_jprc").Data
End If
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

