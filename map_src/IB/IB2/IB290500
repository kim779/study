_AW_ONDECLARE_AW_
Sub Up_name()

	Dim name
	name = SCREEN.GetName(104, S20301.Data, 99)
	If name <> "" Then
		S20022.Data = name
	End If

End Sub

Dim upcd_flg
upcd_flg = 1

Const myFILE = "userconf.ini"
Const myMAP = "IB290500"

Sub p_write_com()
'SYSTEM.Trace "S20301:" & S20301.data
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "COMBO1", S20301.Data

End If
End Sub

Sub p_read_com()
If SCREEN.CreateObject("Info") Then
 	S20301.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COMBO1"))
End If

If Len(Trim(S20301.data)) = 0 Then
	S20301.data = "001"
	upgb.DATA = "001"
End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888888.P_GetBigCd

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call p_read_com()
'OBJ02.Send

SCREEN.SetTimer 2, False
'--

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_

SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SYMBOL23)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "DH510200 /S /d", "20301"  & vbTab & S20301.Data & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SYMBOL14)
_AW_ONCLICK_AW_
Dim retn

Select Case upgb.Index
	Case 0, 2   				'KOSPI
		retn = SCREEN.GetCode(104, "20301", "20022", 0)
	Case 1						'KOSDAQ
		retn = SCREEN.GetCode(104, "20301", "20022", 9)
	Case 3						'SECTOR
		retn = SCREEN.GetCode(104, "20301", "20022", 200)
	Case 4
		retn = SCREEN.GetCode(104, "20301", "20022", 801)
End Select

S20301.SetFocus

If (retn = True) Then
	OBJ02.Send
	SCREEN.Send 2
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


