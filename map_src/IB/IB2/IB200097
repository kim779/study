'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check2()
	Dim mstr
	Error_check2 = False
	If Trim(ed_acno.Data) = "" Then
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus
		MsgBox "계좌번호를 입력하십시오.", , "IBK투자증권"
		Exit Function
	End If
	If Len(Trim(ed_pswd.Data)) < 4 Then
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		MsgBox "비밀번호를 입력하십시오.", , "IBK투자증권"
		Exit Function
	End If
	Select Case mmgb
		Case "1" : mstr = "매도"
		Case "2" : mstr = "매수"
		Case "3" : mstr = "정정"
		Case "4" : mstr = "취소"
	End Select

	'시장구분 Set
	If	Set_mkgb(S1301.Data) = False Then
		MsgBox "종목코드를 확인하십시오.", , "IBK투자증권"
		S1301.SetFocus
		Exit Function
	End If

	'주문수량 check
	If ed_jqty.Enable = True And Is_numeric(ed_jqty.Data) = False Then
		MsgBox mstr & "수량을 입력하십시오.", , "IBK투자증권"
		ed_jqty.SetFocus
		Exit Function
	End If

	'주문단가 check
'	If mstr <> "취소" Then
	If ed_mmgb.Data <> "4" Then
		If ed_jprc.Enable = True And Is_numeric(ed_jprc.Data) = False Then
			MsgBox mstr & "가격을 입력하십시오.", , "IBK투자증권"
			ed_jprc.SetFocus
			Exit Function
		End If
	End If

	If mstr = "정정" Or mstr = "취소" Then
		If Is_numeric(ed_ogno.Data) = False Then
			MsgBox "원주문번호를 확인하십시오.", , "IBK투자증권"
			ed_ogno.SetFocus
			Exit Function
		End If
	End If

	'주문착오방지를 위한 모범규준 check
	If chk_mistake_order(S1301.Data) = False Then
		Exit Function
	End If

	Error_check2 = True
End Function

