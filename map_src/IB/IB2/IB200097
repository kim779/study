{


_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(DH010198) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "3"

'***************************************************************************
' DESC: 사용자 입력키 Action
'***************************************************************************
Sub OnAxUserKey(key)
'	If OrdCfg.EnterOrder = True Then
'		If key = 13 Then
'			SYSTEM.UserKey	= True
'			'DoOrder()
'		End If
'	End If
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN16.name
	ed_pswd.Data = AN16.pswd
	SCREEN.Proc "main.Set_account", "jumn"
	o_jmno.Clear
	mesg.Text = ""
End Sub

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos
	Dim mdgb, dmsg
	Dim sHnam, smarket

	Call init_data2()									'주문 기본세팅

	ed_mmgb.Data = "3"	 '매매구분
	ed_prgb.Data = "X"	 '처리구분

	If Error_check2() = False Then				'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		If r_mdgb1.Checked = True Then
			mdgb = "일부정정"
		Else
			mdgb = "전부정정"
			ed_jqty.Data = 0
		End If

		smarket = cxMarket.sMarket
		If cxMarket.sMarket = "통합" Then
			smarket = "SOR"
		End If

		sHnam = Replace(Mid(SCREEN.Object("OBJ_hnam.1022").Data,2), "/","／")
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("main.OBJ_order.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & sHnam & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_mdgb" & vbTab & mdgb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & ed_jprc.Data & vbLf &_
			"o_stopjprc" & vbTab & edStopPrc.Data & vbLf &_
			"o_market" & vbTab & smarket & vbLf &_
			"o_hogb" & vbTab & Mid(shogb.Text,4) & vbLf
		SCREEN.CreateWindow 2, "IB10017A /p5 /d", dmsg
		If SYSTEM.Pop("stock_modify_order") <> "OK" Then
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

	cPos = OrdCfg.ReadCfg("CursorPos")
	Select Case cPos
		Case "0" : SCREEN.Object("main.OBJ_order.AN1A").SetFocus()
		Case "1" : SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus()
		Case "2" : S1301.SetFocus()
		Case "3" : ed_jqty.SetFocus()
		Case "4" : ed_jprc.SetFocus()
	End Select
End Sub

'***************************************************************************
' DESC: 취소전송
'***************************************************************************
Sub DoCancel()
	Dim hogb, cPos
	Dim mdgb, dmsg
	Dim sHnam, smarket

	Call init_data2()									'매수주문 기본세팅

	ed_mmgb.Data = "4"   '매매구분
	ed_prgb.Data = "C"	 '처리구분

	If Error_check2() = False Then				'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		If r_mdgb1.Checked = True Then
			mdgb = "일부취소"
		Else
			mdgb = "전부취소"
			ed_jqty.Data = 0
		End If

		smarket = cxMarket.sMarket
		If cxMarket.sMarket = "통합" Then
			smarket = "SOR"
		End If

		sHnam = Replace(Mid(SCREEN.Object("OBJ_hnam.1022").Data,2), "/","／")
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("main.OBJ_order.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & sHnam & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_mdgb" & vbTab & mdgb & vbLf &_
			"o_market" & vbTab & smarket & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf
		SCREEN.CreateWindow 2, "IB10018A /p5 /d", dmsg
		If SYSTEM.Pop("stock_cancel_order") <> "OK" Then
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송

