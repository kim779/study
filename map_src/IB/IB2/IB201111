_AW_ONCLICK_AW_
If C_GAMT.Checked = True Then
	S12500.SetColumnVisible 9, False
	S12500.SetColumnVisible 10, True
Else
	S12500.SetColumnVisible 9, True
	S12500.SetColumnVisible 10, False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(12500)
_AW_ONCLICK_AW_
Dim ISAVE

SAVE.TEXT = S12500.INFO
ISAVE = Left(SAVE.TEXT, 14)
SAVE.Text = Trim(IsAVE)

Select Case (S12500.ACTION)
Case 1
	S12500.ROW = S12500.ROWS
	S12500.COLUMN = 2
Case 2
	S12500.ROW = 1
	S12500.COLUMN = 2
End Select

ISAVE = Trim(SAVE.TEXT) + Trim(S12500.CELL)
SAVE.Text = ISAVE

Select Case (S12500.ACTION)
Case 1
	S12500.ROW = 1
	S12500.COLUMN = 2
Case 2
	S12500.ROW = S12500.ROWS
	S12500.COLUMN = 2
End Select

ISAVE = Trim(SAVE.TEXT) + Trim(S12500.CELL)
SAVE.Text = ISAVE

S12500.INFO = SAVE.TEXT
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


