_AW_ONDECLARE_AW_
Sub OnAlert()
	msda = S12500.GetGridCell(1, 17)
	mdda = S12500.GetGridCell(1, 18)

	If Trim(msda) = "" Then
		msda = 0
	End If

	If Trim(mdda) = "" Then
		mdda = 0
	End If

	data = msda - mdda

	If data > 0 Then
		data = "+" & data
	End If

	S12500.SetGridCell 1, 19, data

End Sub

_AW_ONSTART_AW_
If SCREEN.Object("main.C_GAMT").checked = True Then
	C_GAMT.Checked = True
	If C_GAMT.Checked = True Then
		S12500.SetColumnVisible 9, False
		S12500.SetColumnVisible 10, True
	End If
Else
	C_GAMT.Checked = False
	If C_GAMT.Checked = False Then
		S12500.SetColumnVisible 9, True
		S12500.SetColumnVisible 10, False
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S12901.Data = SCREEN.Object("main.12901").data
S1301.Data = SCREEN.Object("main.1301").Data

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1777.Data =  "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1777.Data =  "3"
	End If
	SYSTEM.Trace "yes cxMarket 1777 = " & S1777.Data
Else
	SYSTEM.Trace "no cxMarket map = " & SCREEN.GetMapName(0)
End If

