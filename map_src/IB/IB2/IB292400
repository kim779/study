_AW_ONDECLARE_AW_
Option Explicit
Dim Isstart
Dim myFILE, myMAP

Isstart = False
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)

Sub send_f()
	If Isstart = False Then
		Exit Sub
	End If
	SCREEN.ClearAll 0, 2
	
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
	SCREEN.Proc "obj.send_f", ""
End Sub

Sub OnAlert()
	obj.Proc "diffupdate", S2023.Data
End Sub

Sub SetDate()
	Dim strtDt, EndDt
	If BEFORE.Data = "1" Then
		day1.Enable = True
		day2.Enable = True
	Else
		day1.Enable = False
		day2.Enable = False
	End If

	Select Case Trim(BEFORE.Data)
		Case "1" : strtDt = change_date("d", -15)
		Case "3" : strtDt = change_date("d", -1)
		Case "4" : strtDt = change_date("d", -5)
		Case "5" : strtDt = change_date("d", -15)
		Case "6" : strtDt = change_date("d", -20)
		Case "7" : strtDt = getCurrDay()
	End Select

	strtDt = week_check(strtDt)

	If Trim(BEFORE.Data) = "3" Then
		EndDt = strtDt
	Else
		EndDt  = getCurrDay()
	End If

	day1.Data = strtDt
	day2.Data = EndDt
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
	obj.Send
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major


Dim gign
Isstart = True
If SCREEN.CreateObject("Info")  Then
	gign = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "gign"))
	If gign = "" Then
		gign = "1"
	End If
	BEFORE.Data = gign
	Call SetDate()
	SCREEN.Object("obj.day1").Data = day1.Data
	SCREEN.Object("obj.day2").Data = day2.Data
	Call send_f()
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
