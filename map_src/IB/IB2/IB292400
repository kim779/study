	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1777.Data =  "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1777.Data =  "3"
	End If
	SYSTEM.Trace "yes cxMarket 1777 = " & S1777.Data
Else
	SYSTEM.Trace "no cxMarket map = " & SCREEN.GetMapName(0)
End If

