Function 	check_combo()
	If RADIO0.Checked = True Then
		check_combo = 1
	ElseIf RADIO1.Checked = True Then
		check_combo = 2
	ElseIf RADIO2.Checked = True Then
		check_combo = 3
	ElseIf RADIO3.Checked = True Then
		check_combo = 4
	End If

End Function



Sub Set_combo(combo_no)
	SYSTEM.Trace "set_combo"
	If combo_no = "1" Then
		drChart.GetChartProperty("SetGraphHide (0, 0, 체결량, false )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 상환량, true )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 잔고수량, True )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 잔고금액, true )")

		RADIO0.Checked = True
		RADIO1.Checked = False
		RADIO2.Checked = False
		RADIO3.Checked = False
	ElseIf combo_no = "2" Then
		drChart.GetChartProperty("SetGraphHide (0, 0, 체결량, true )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 상환량, false )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 잔고수량, true )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 잔고금액, true )")

		RADIO0.Checked = False
		RADIO1.Checked = True
		RADIO2.Checked = False
		RADIO3.Checked = False
	ElseIf combo_no = "3" Then
		drChart.GetChartProperty("SetGraphHide (0, 0, 체결량, true )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 상환량, true )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 잔고수량, false )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 잔고금액, true )")

		RADIO0.Checked = False
		RADIO1.Checked = False
		RADIO2.Checked = True
		RADIO3.Checked = False
	ElseIf combo_no = "4" Then
		drChart.GetChartProperty("SetGraphHide (0, 0, 체결량, true )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 상환량, true )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 잔고수량, true )")
		drChart.GetChartProperty("SetGraphHide (0, 0, 잔고금액, false )")

		RADIO0.Checked = False
		RADIO1.Checked = False
		RADIO2.Checked = False
		RADIO3.Checked = True
	End If
	p_write_ini
End Sub


Sub p_write_ini()
	Dim combo_no
	If RADIO0.Checked = True Then
		combo_no = 1
	ElseIf RADIO1.Checked = True Then
		combo_no = 2
	ElseIf RADIO2.Checked = True Then
		combo_no = 3
	ElseIf RADIO3.Checked = True Then
		combo_no = 4
	End If

	If SCREEN.CreateObject("INFO") Then
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "combo", combo_no
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim combo_no
		combo_no = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "combo"))
	End If

	If combo_no = "1" Then
		Set_combo(1)
		RADIO0.Checked = True
		LABEL1.Text = "체결량"
	ElseIf combo_no = "2" Then
		Set_combo(2)
		RADIO1.Checked = True
		LABEL1.Text = "상환량"
	ElseIf combo_no = "3" Then
		Set_combo(3)
		RADIO2.Checked = True
		LABEL1.Text = "잔고수량"
	ElseIf combo_no = "4" Then
		Set_combo(4)
		RADIO3.Checked = True
		LABEL1.Text = "잔고금액"
	Else
		Set_combo(1)
		RADIO0.Checked = True
		LABEL1.Text = "체결량"
	End If

End Sub

