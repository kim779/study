Sub OnAlert()
	'KO 확인
	KO = Trim(S2191.Data)
	If Len(KO) <> 0 And g_BefKO <> KO Then
		If KO = "99" Then
			S2190.Visible = True
		End If
	End If

	'환산가 계산
	Dim hsga, hsgg, curr, jhrt, cpgb, temp, jjjj, tmpLen	'tmpLen : 행사가격의 소수점자리의 길이

	cpgb = Trim(S1852.Data)					'ELW권리유형
	temp = Trim(TABLE2.GetTableCell(1))		'행사가격

	If temp = "" Then
		Exit Sub
	End If

'	If Mid(temp, Len(temp)-2, 1) = "." Then
'		hsgg = Left(temp, Len(temp)-3)
'	Else
'		hsgg = temp
'	End If

	If InStr(temp, ".") > 0 Then
		Dim tmpArr
		tmpArr = Split(temp, ".")
		tmpLen =  Len(Trim(tmpArr(1)))

		hsgg = Left(temp, Len(temp) - (tmpLen + 1))	'소수점 포함위해 + 1
	Else
		hsgg = temp
	End If

	curr = Trim(S2023.Data)					'현재가
	jhrt = Trim(TABLE2.GetTableCell(3))		'전환비율

'	If Is_numeric(jhrt) = False Then
'		Exit Sub
'	End If

	If cpgb = "콜" Then
		If curr > 0 Then
			hsga = hsgg + (curr / jhrt)
		Else
			hsga = hsgg - (curr / jhrt)
		End If
	Else
		If curr > 0 Then
			hsga = hsgg - (curr / jhrt)
		Else
			hsga = hsgg + (curr / jhrt)
		End If
	End If

'	If Mid(temp, Len(temp)-2, 1) = "." Then
'		If Mid(hsga, Len(hsga)-1, 1) = "." Then
'			hsga = hsga & "0"
'		ElseIf Mid(hsga, Len(hsga)-2, 1) <> "." Then
'			hsga = hsga & ".00"
'		End If
'	End If

	If tmpLen > 0 Then
