RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim initflag, grdact
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)
initflag = False
grdact = ""

Sub makecolumn()
	If VIEW.Data = "1" Then
		sval = True
	ElseIf VIEW.Data = "2" Then
		sval = False
	End If
	For ii=1 To S300300.Columns
		If ii < 11 Then
			S300300.SetSkip S300300.GetColumnName(ii), Not sval
		Else
			S300300.SetSkip S300300.GetColumnName(ii), sval
		End If

		If 3 <= ii And ii <= 10 Then
			S300300.SetColumnVisible ii, sval
		End If
		If  13 <= ii And ii <= 20 Then
			S300300.SetColumnVisible ii, Not sval
		End If
	Next
End Sub

Sub Change_MKGubn_Main(sMKGubn)

	SYSTEM.Trace "[IB291300]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0

End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major


Dim sjcd, tjcd, gubn, showgb, ii, sval
If SCREEN.CreateObject("Info") Then
	sjcd = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "300903"))
	If sjcd = "" Then
		sjcd = "0"
	End If
	S300903.Data = sjcd
	tjcd = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "300904"))
	If tjcd = "" Then
		tjcd = "0"
	End If
	S300904.Data = tjcd
	gubn = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "300905"))
	If gubn = "" Then
		gubn = "1"
	End If
	S300905.Data = gubn

	showgb = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "VIEW"))
	If showgb = "" Then
		showgb = "1"
	End If
	VIEW.Data = showgb
	makecolumn()
End If

S300900.Data = "F"
S300901.Data = LOGIN.Day0

SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S300777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S300777.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S300777.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
S300900.Data = "X"
initflag = True

If S300300.Rows < 1 Then
	Exit Sub
End If

Select Case grdact
Case "up"
	S300300.Index S300300.Rows - 3
	S300300.Index S300300.Rows - 2
	S300300.Index S300300.Rows - 1
Case "dn"

End Select
grdact = ""

S300300.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(300901)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SBTN)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(300300)
_AW_ONCLICK_AW_
If S300300.HitPos = 3 Then
	If VIEW.Data = "1" Then
		S1301.DATA = Trim(S300300.GetGridCell(S300300.INDEX +1, 1))
		S1301.Trigger "", False
		S1301.Trigger "", True
	Else
		S1301.DATA = Trim(S300300.GetGridCell(S300300.INDEX +1, 11))
		S1301.Trigger "", False
		S1301.Trigger "", True
	End If
ElseIf initflag = True Then
	grdact = ""
	Select Case S300300.HitPos
	Case 1, 5
		grdact = "up"
	Case 2, 6
		grdact = "dn"
	End Select
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(300903)
_AW_ONCHANGE_AW_
If SCREEN.CreateObject("Info") Then
	INFO.pushData LOGIN.Name, myFILE, myMAP, "300903", S300903.Data
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


