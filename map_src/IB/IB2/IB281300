_AW_ONCLICK_AW_
Select Case tab_order.ID
	Case 1		'호가
		obj.SetObject("IB281310")

	Case 2		'시간대별
		obj.SetObject("IB281320")

	Case 3		'일별
		obj.SetObject("IB281330")

	Case 4		'비교차트
		obj.SetObject("IB281340")
End Select

obj.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



