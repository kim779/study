_AW_ONDECLARE_AW_
Sub IsReal_check()
	If is_real.Checked = False Then
		'SCREEN.Object("OBJECT1.1301").Clear
		SCREEN.Object("OBJECT1.1021").Clear
	Else
		SCREEN.Object("OBJECT1.1301").Data = S1301.Data
		SCREEN.Object("OBJECT1.1021").Data = "A" & S1301.Data
		Send_OBJ1()
	End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	SCREEN.Object("object1.11310").Clear
	Send_OBJ()
	OBJECT1.Proc "change_code", ""

End Sub

Sub Send_Screen()
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
End Sub

Sub Send_OBJ()
	cxMarket.sCode = Trim(S1301.Data)
	OBJECT1.Send
	OBJECT0.send
End Sub

Sub Send_OBJ1()
	cxMarket.sCode = Trim(S1301.Data)
	OBJECT1.Send
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

S1301.Data = SYSTEM.GetHistory(False, 1301)
SCREEN.Object("object1.1301").Data = S1301.Data
SCREEN.Object("object1.11310").Clear

Send_OBJ()

If BUTTON1.Text = "일자별" And BUTTON3.Text = "데이터" Then
	BUTTON4.Enable = True
Else
	BUTTON4.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
'CHECK0.Checked = SCREEN.Object("main.is_real").Checked

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

Send_Screen()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
If BUTTON1.Text = "일자별" Then
	If BUTTON3.Text = "차트" Then
		OBJECT1.SetObject "IB295820"
		BUTTON4.Enable = False
	Else
		OBJECT1.SetObject "IB295840"
		BUTTON4.Enable = False
	End If

	BUTTON1.Text = "시간별"
ElseIf BUTTON1.Text = "시간별" Then
	If BUTTON3.Text = "차트" Then
		OBJECT1.SetObject "IB295810"
		BUTTON4.Enable = False
	Else
		OBJECT1.SetObject "IB295830"
		BUTTON4.Enable = True
	End If

	BUTTON1.Text = "일자별"
End If
SCREEN.Object("object1.11310").Clear
Send_OBJ1()
OBJECT1.Proc "change_code", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
If BUTTON3.Text = "차트" Then
	If BUTTON1.Text = "일자별" Then
		OBJECT1.SetObject "IB295830"
		BUTTON4.Enable = True
	Else
		OBJECT1.SetObject "IB295840"
		BUTTON4.Enable = False
	End If

	BUTTON3.Text = "데이터"

ElseIf BUTTON3.Text = "데이터" Then
	If BUTTON1.Text = "일자별" Then
		OBJECT1.SetObject "IB295810"
		BUTTON4.Enable = False
	Else
		OBJECT1.SetObject "IB295820"
		BUTTON4.Enable = False
	End If

	BUTTON3.Text = "차트"
End If
SCREEN.Object("object1.11310").Clear
Send_OBJ1()
OBJECT1.Proc "change_code", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


