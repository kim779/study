Sub FileCopy(srcFile)
	Dim fso,MyFile

	Set fso = CreateObject("Scripting.FileSystemObject")

	If fso.FileExists(srcFile & ".org") Then
		Set MyFile = fso.GetFile(srcFile& ".org")
		MyFile.Copy (srcFile)
	End If
End Sub

Sub FileDelete(srcFile)
	Dim fso,MyFile

	Set fso = CreateObject("Scripting.FileSystemObject")

	If fso.FileExists(srcFile & ".org") Then
		Set MyFile = fso.GetFile(srcFile & ".org")
		MyFile.Delete
	End If
End Sub

