Sub OnPortfolio(confirm)
	Dim groupNames, parseData, Items, codelist, row, countGroup

'	SYSTEM.Trace "reduce_start"

	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If
	If UCase(confirm) <> "OK" And UCase(confirm) <> "START" Then
		Exit Sub
	End If

	Items = ""
	DX_INTEREST.SetUserName(LOGIN.Name)
	groupNames = DX_INTEREST.LoadGroupNames()


	countGroup = 0
	Do While Len(groupNames) > 0
		parseData = Mid(groupNames, 1, InStr(groupNames, vbTab) -1)
		groupNames = Mid(groupNames, InStr(groupNames, vbTab) + 1)
		Items = parseData & vbTab & Items
		countGroup = countGroup + 1
	Loop

	'계좌 보유종목 조회
	If countGroup < 100 Then
		Items = "00 보유종목" & vbTab & Items
	End If


	If Items = "" Then
		intercombo.SetItems("")
	Else
		intercombo.SetItems(vbTab & Items)
	End If

	Call p_read_com()
'	intercombo.Data = SYSTEM.Pop("cxPortfolioItem")
'	SCREEN.Proc "OBJ1.OnGroup", intercombo.Data

	'Call OnGroup(intercombo.Data)
	CONTROL1.SetGroup intercombo.Data-1
	CONTROL1.OnPortfolio confirm
	If UCase(confirm) <> "START" Then
		If intercombo.Index = 0 Then
			CONTROL1.SetAccount SCREEN.Object("main.OBJ_order.AN1A").Data
		End If
		CONTROL1.ChangeGroup intercombo.Data
	End If
End Sub

Sub SyncComboBox()

	If SCREEN.Object("main.tab_tuja").ID <> 0 Then
		Exit Sub
	End If

	If intercombo.Data <> SCREEN.Object("main.OBJ_Interest.intercombo").Data Then
		SCREEN.Object("main.OBJ_Interest.intercombo").data = intercombo.Data

		SCREEN.Object("main.OBJ_Interest.CONTROL0").ClearGrid

		If intercombo.Index = 0 Then
			SCREEN.Object("main.OBJ_Interest.CONTROL0").SetAccount SCREEN.Object("main.OBJ_order.AN1A").Data
		End If

		SCREEN.Object("main.OBJ_Interest.CONTROL0").ChangeGroup intercombo.Data
	End If
End Sub

Sub OptionLoad()
	Dim data

	data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "INTERAUTO"))

	If data = "" Then
		data = 1
	End If

	If data = 1 Then
		auto.Checked = True
	Else
		auto.Checked = False

		data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "INTEREXPECT"))

		If data = "" Then
			data = 0
		End If

		If data = 1 Then
			expect.Checked = True
		Else
			expect.Checked = False
		End If
	End If

	If auto.Checked = True Then
		CONTROL1.SetAutoCheck True
		CONTROL1.SetExpect False

		expect.Enable = False
		expect.Checked = False
	Else
		CONTROL1.SetAutoCheck False
		CONTROL1.SetExpect False

		expect.Enable = True
	End If

	If expect.Checked = True Then
		CONTROL1.SetExpect True

		If RADIO1.Checked = True Then
			CONTROL1.ChangeGroup intercombo.Data
		End If
	Else
		CONTROL1.SetExpect False

		If RADIO1.Checked = True Then
			CONTROL1.ChangeGroup intercombo.Data
		End If
	End If
End Sub

