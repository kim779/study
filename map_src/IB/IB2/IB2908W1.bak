RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim tu_sum, tu_int, t_sum, val

Function Is_numeric(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		Is_numeric = 0
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Is_numeric = 0
		Exit Function
	End If

	Is_numeric = CDbl(num)
End Function

_AW_ONSEND_AW_
vagb.Data = 1

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
Else
	SYSTEM.Trace "IB2908W1  No cxMarket"
End If

_AW_ONENDSUB_AW_
}



