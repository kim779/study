RESOURCE DIVISION
{


_AW_ONSTART_AW_
ed_start.Data = "F"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If ed_start.Data <> "F" Then
	SCREEN.OnSend False
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If ed_start.Data = "F" Then
	GRID1.Index = Trim(SCREEN.Object("main.theme_index").data)
	GRID1.SetFocus

	If GRID1.Index = 0 Then
		SCREEN.Object("parent.TMNAM").Data = "[" & Trim(GRID1.GetGridCell(1, 1)) & _
		 "] "& GRID1.GetGridCell(1, 2)
		SCREEN.Object("parent.TMCB").Data = GRID1.GetGridCell(1, 1)
	Else
		SCREEN.Object("parent.TMNAM").Data = "[" & Trim(GRID1.GetGridCell(GRID1.Index+1, 1)) & _
		 "] "& GRID1.GetGridCell(GRID1.Index+1, 2)
		SCREEN.Object("parent.TMCB").Data = GRID1.GetGridCell(GRID1.Index+1, 1)
	End If

'	SCREEN.Object("parent.TMNAM").Data = "[" & Trim(GRID1.GetGridCell(GRID1.Row, 1)) & _
'	 "] "& GRID1.GetGridCell(GRID1.Row, 2)
'	SCREEN.Object("parent.TMCB").Data = GRID1.GetGridCell(GRID1.Row, 1)

'	SCREEN.Proc "parent.OBJ_send", ""
'	SCREEN.Object("parent.TMNAM").Data = GRID1.GetGridCell(1, 2)
	ed_start.Data = "N"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
If GRID1.HitPos = 3 Then
	'테마 탭이동시 마지막 선택값 보여줄 수 있도록 선택값 저장
	SCREEN.Object("main.theme_code").data = Trim(GRID1.GetGridCell(GRID1.Row, 1))
	SCREEN.Object("main.theme_index").data = GRID1.Index
	SCREEN.Object("main.TMNAM").data = "[" & Trim(GRID1.GetGridCell(GRID1.Row, 1)) & _
	 "] "& GRID1.GetGridCell(GRID1.Row, 2)
	SCREEN.Object("parent.TMNAM").Data = "[" & Trim(GRID1.GetGridCell(GRID1.Row, 1)) & _
	 "] "& GRID1.GetGridCell(GRID1.Row, 2)
	SCREEN.Object("parent.TMCB").Data = GRID1.GetGridCell(GRID1.Row, 1)
	SCREEN.Proc "parent.OBJ_send", ""

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



