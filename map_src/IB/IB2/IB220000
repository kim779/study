_AW_ONDECLARE_AW_
Dim bFirst
bFirst =True

Sub SetFOCode( code, handle)
	Dim hKey

	If tab_info.ID <> 1 Then
		Exit Sub
	End If

	hKey = SCREEN.Object("OBJ_info.grid").GetMapHandle()

'	SYSTEM.Trace "handle : " & handle & " hKey :" & hKey
	If Trim(handle) <> Trim(hKey) Then
		Exit Sub
	End If
	ed_focod.data = code
	Call send_sise_all("main")
End Sub

'CX_OptionEx에서 사용
Sub SetOPCode(code, handle)
	Dim hKey

	hKey = SCREEN.Object("OBJ_order.OBJ_odr.Control0").MapHandle

'	SYSTEM.Trace "handle : " & handle & " hKey :" & hKey
	If Trim(handle) <> Trim(hKey) Then
		Exit Sub
	End If
	ed_focod.data = code
	Call send_sise_all("main")
End Sub

Sub send_sise_all(gubn)
	Dim code, fogb, rsymb, acnm
dbx.Text = dbx.Text & ed_focod.data&"ALL:"&gubn
	code = Left(ed_focod.Data, 1)
	If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
		fogb = 101
		rsymb = "30301"
		'OBJ_sise.SetObject("IB300110")
		'OBJ_sise.SetObject("IB220040")

	ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C"Then
		fogb = 102
		rsymb = "40301"
		'OBJ_sise.SetObject("IB300115")
		'OBJ_sise.SetObject("IB220050")

	End If


	HNAM.Data = SCREEN.GetName (fogb, ed_focod.Data, 0)
	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = HNAM.data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_focod").data = ed_focod.data
		SCREEN.IgnoreChange False
	End If

	Call tab_info_change()

	If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
		OBJ_sise.SetObject("IB220040")
	ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C" Then
		OBJ_sise.SetObject("IB220050")
	End If

	acnm = Trim(SCREEN.Object("OBJ_order.acnm").data)
	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 2, 2
		SCREEN.Object("OBJ_order.acnm").data = acnm
		SCREEN.SetTimerX 1, 5, False
		'OBJ_sise.Send
		OBJ_info.Send
		Exit Sub
	Else
		ed_focod.Trigger "ed_focod", True
		ed_focod.Trigger rsymb, True
		ed_focod.Trigger rsymb, False
		SYSTEM.SetHistory rsymb, ed_focod.Data
		SYSTEM.SetHistory "ed_focod", ed_focod.Data
	End If

	SCREEN.SetTimerX 1, 5, False
	'OBJ_sise.Send

	' 전광판에 종목코드가 변경되었음을 알려준다.
	' 전광판을 그리드->컨트롤 변경하면서 현재 보고있는 종목을 제외하고는
	' Skip기능이 들어감. ( 밀릴경우 그리기 횟수를 줄임 )
	' 다만 이과정에서 옆의 호가와 불일치 하는 현상이 발생하여
	' 현재 바라보는 종목은 무조건 동기화 그리기를 시행함. by warship
	OBJ_info.Proc "ReloadCode", ""

	'CX_OptionEx에 바뀐 종목 세팅
	SCREEN.Object("OBJ_order.OBJ_odr.Control0").CurCode  = ed_focod.Data
End Sub


'기존코드 >= 현월물 = 기존코드
'기존코드 <  현월물 = 기존코드(앞 3자리) + 현월물(뒷 4자리)
Sub ChangeOldMonth()
	bFirst = False
	Dim oldDivF, oldDivB, newDivF, newDivB, code, fogb

	If Trim(ed_focod.Data) = "" Then
		SCREEN.GetCode 111, "ed_focod", "HNAM", 0
	Else
		SCREEN.GetCode 111, "zFnoIsuNo1", "HNAM1", 0

		code = Left(ed_focod.Data, 1)
		If code = "1" Or code = "4" Or code = "A" Or code = "D" Then '선물
			fogb = 101
	
		ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C"Then '옵션 
			fogb = 102
		End If
	
		newDivF = Mid(Trim(zFnoIsuNo1.Data), 1, 3)
		newDivB = Mid(Trim(zFnoIsuNo1.Data), 4, 5)
	
		oldDivF = Mid(Trim(ed_focod.Data), 1, 3)
		oldDivB = Mid(Trim(ed_focod.Data), 4, 5)
		
		'SYSTEM.Trace "ChangeOldMonth : " & Trim(SCREEN.GetName(fogb, ed_focod.Data, 0)) 
		
		If Trim(SCREEN.GetName(fogb, ed_focod.Data, 0)) = "" Then
				ed_focod.Data = oldDivF & newDivB	
		End If

	End If

	Call send_sise_all("main")

End Sub

