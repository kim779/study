' 종합계좌간 자금대체 대리인 계좌 리스트
Sub addCompany()
	Dim ii, indx, chk, accn, text, acnm, ding, user_acc

	user_acc = SCREEN.Object("Parent.CMB_ACCT").Data


	VIEWGRID.Clear()

	' VIEWGRID Start Count
	indx = 1

	' GRID0 Data to VIEWGRID
	For ii = 1 To GRID0.Rows
		accn  = Trim(GRID0.GetGridCell (ii, 1))	' 계좌
		acnm  = Trim(GRID0.GetGridCell (ii, 2)) ' 계좌명

		Select Case Mid(Trim(accnCell), 4, 2)
			Case "10" : text = "위탁    "
			Case "11" : text = "ELW전용 "
			Case "12" : text = "코넥스  "
			Case "20" : text = "선물옵션"
			Case "21" : text = "옵션전용"
			Case "30" : text = "일반저축"
			Case "51" : text = "CMA전용 "
			Case "52" : text = "RP전용  "
			Case "53" : text = "수익증권"
			Case "70" : text = "신탁    "
			Case "37" : text = "ISA     "
			Case Else : text = "        "
		End Select

		ding  = Trim(GRID0.GetGridCell (ii, 8)) ' 자금대체대리인 약정 여부

		' 2022.07.19 요건사항 협의(윤영선차장님, 김지영차장님)에 의해
		' 출금계좌가 자금대체대리인 약정인 계좌인 경우는
		' 1. 자금대체대리인 약정이 맺어져 있는 계좌 중
		' 2. 출금계좌와 동일한 계좌는 제외하고,
		' 3. 출금계좌의 종합계좌에 소속된 계좌만
		' 입금계좌로 세팅
		If ding = "1" And Trim(user_acc) <> Trim(accn) And Right(Trim(user_acc), 6) = Right(Trim(accn), 6) Then
			' VIEWGRID에 데이터 삽입
			'MsgBox "addCompany():accn:"&accn
			Call insert_row (indx, accn, text, acnm)
			indx = indx + 1
		End If
	Next

	' 상위 맵(Parent)에 내계좌 콤보 세팅 :: 자금대체 대리인
	Call AcctSetting()

End Sub

' VIEWGRID에 계좌 삽입
Sub insert_row(i_indx, i_accn, i_text, i_acnm)
	VIEWGRID.InsertRow (i_indx)
	VIEWGRID.SetGridCell i_indx, 1, "068"			' 당사코드
	VIEWGRID.SetGridCell i_indx, 2, "IBK투자증권"	' 당사명
	VIEWGRID.SetGridCell i_indx, 3, Trim(i_accn)	' 계좌번호
	VIEWGRID.SetGridCell i_indx, 4, Trim(i_text)	' 계좌구분
	VIEWGRID.SetGridCell i_indx, 5, Trim(i_acnm)	' 계좌명
End Sub



' 출금계좌가 내 계좌인 경우 내 계좌 리스트 세팅
Sub addMyAccount()
	Dim ii, t_accn, t_acnm, my_accn, text, user_acc , user_acc2 ,user_acc3

	user_acc = Trim(SCREEN.Object("parent.CMB_ACCT").Data)
	user_acc2 = Left(user_acc,3) & Right(user_acc,6)

	GRID0.Clear()
	VIEWGRID.Clear()
	indx = 1
	For ii = 1 To SCREEN.Object("Main.OBJ_acct.GRID0").Rows
		' 사용자 보유 전체 계좌 리스트
		t_accn = Trim( SCREEN.Object("Main.OBJ_acct.GRID0").GetGridCell (ii,  9) )	' 계좌번호
		t_acnm = Trim( SCREEN.Object("Main.OBJ_acct.GRID0").GetGridCell (ii, 10) )	' 계좌명
		my_accn = Trim(SCREEN.Object("Main.OBJ_acct.GRID0").GetGridCell (ii, 12) )	' 동일인 여부
		user_acc3 = Left(t_accn,3) & Right(t_accn,6)
		' 상품명
		Select Case Mid(Trim(accnCell), 4, 2)
		Case "10" : text = "위탁    "
		Case "11" : text = "ELW전용 "
		Case "12" : text = "코넥스  "
		Case "20" : text = "선물옵션"
		Case "21" : text = "옵션전용"
		Case "30" : text = "일반저축"
		Case "37" : text = "ISA     "
		Case "51" : text = "CMA전용 "
		Case "52" : text = "RP전용  "
		Case "53" : text = "수익증권"
		Case "70" : text = "신탁    "
		Case Else : text = "        "
		End Select

		'MsgBox "11t_accn:"&t_accn
		'MsgBox "11user_acc:"&user_acc
		'MsgBox "11user_acc2:"&user_acc2
		'MsgBox "11user_acc3:"&user_acc3
		' 계좌가 있을때만 & 해당 계좌가 동일인 (내계좌) 일때만 & 출금계좌로 선택된 계좌는 제외 & 계좌번호 15선택시 -> 55, 55선택시 -> 15
		If Trim(t_accn) <> "" And Trim(my_accn) = "동일인" And Trim(t_accn) <> Trim(user_acc) And user_acc2 = user_acc3 Then
			'MsgBox "addMyAccount():t_accn:"&t_accn
			Call insert_row (indx, t_accn, text, t_acnm)
			indx = indx + 1
		End If
	Next

	Call AcctSetting()
End Sub




'***************************************************************
' FINAL : 상단맵의 입금대상 계좌 콤보에 조회해온 데이터 세팅
'***************************************************************
Sub AcctSetting()
	Dim user_acc, item, items, accn_type


	' 출금계좌
	user_acc = Trim(SCREEN.Object("parent.CMB_ACCT").Data)

	' accn_type : TRUE(자금대체대리인), FALSE(내계좌)
	accn_type = SCREEN.Object("Parent.AN00").IsAccAgent(Trim(user_acc), 6)

	item = ""
	items = ""

	'MsgBox "user_acc:"&user_acc
	'MsgBox "Trim(Mid(user_acc,4,2)):"&Trim(Mid(user_acc,4,2))

	For ii = 1 To VIEWGRID.Rows
		item = Trim(VIEWGRID.GetGridText(ii,3))	' 계좌번호
			'	MsgBox "Trim(Mid(item,5,2)):"&Trim(Mid(item,5,2))
		If Trim(item) <> "" Then
			' 종합계좌가 아니면서 길이가 13Bytes(하이픈-포함)인 계좌만 유효

			Select Case accn_type
			Case True	' 자금대체 대리인 계좌 :: addCompany()에서 데이터 세팅
				items = items & vbTab & item

			Case False	' 내계좌 :: addMyAccount() 에서 Data Setting
				If Trim(Mid(user_acc,4,2)) = "15" Then
					If Trim(Mid(item,5,2)) = "55" Then
						items = items & vbTab & item
					End If
				Else
					If Trim(Mid(item,5,2)) = "15" Or Trim(Mid(item,5,2)) = "51" Then
						items = items & vbTab & item
					End If
				End If

				' 내계좌인 경우 다음 상품에 대해 데이터 세팅
				'Select Case Trim(Mid(item,5,2))
				'Case "15":
'					If (CLng(Left(Trim(item), 3)) < 551 Or CLng(Left(Trim(item), 3)) > 561) Then	' 551 ~ 561 계좌는 SKIP
				'		items = items & vbTab & item
'					End If
				'End Select

			End Select
		End If
	Next


	' 상단맵의 입금대상계좌 콤보 데이터 세팅
	SCREEN.Object("parent.CMB_ACCT2").SetItems(items)

	' 상단 맵의 지연이체 여부 확인
	If SCREEN.Object("parent.DlyMtrsfTp").visible = True Then
		SCREEN.Object("parent.DlyMtrsfTp").SetFocus()
	Else
		SCREEN.Object("parent.AMT").SetFocus()
	End If

	SCREEN.Proc "Parent.getName", ""
End Sub

