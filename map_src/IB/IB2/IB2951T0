Function Is_empty(valx)
	If Len(Trim(valx)) = 0 Then
		Is_empty = 0
	Else
		Is_empty = CDbl(valx)
	End If
End Function


Function check_date()
	Dim t_day, f_day, x_day, yy, mm, dd

	x_day = week_check(xday.Data)
	t_day = Trim(day2.Data)

	If t_day = "" Or Len(t_day) < 8 Then
		day2.Data = x_day
	End If
	If IsNumeric(t_day) = False Or t_day > x_day Then
		day2.Data = x_day
	End If
	day2.Data = week_check(day2.Data)

	f_day = Trim(day1.Data)
	If f_day = "" Or Len(f_day) < 8 Then
		day1.Data = x_day
	End If
	day1.Data = week_check(day1.Data)

	If IsNumeric(f_day) = True And day1.Data <= day2.Data Then
		Exit Function
	End If

	day1.Data = t_day
	Exit Function

	yy = Mid(t_day, 1, 4)
	mm = Mid(t_day, 5, 2)
	dd = Mid(t_day, 7, 2)
	x_day = yy & "-" & mm & "-" & dd
	If IsDate(x_day) = False Then
		Exit Function
	End If



	x_day = DateSerial(yy, mm-2, dd)
	yy = Year(x_day)
	mm = Month(x_day)
	If Len(mm) = 1 Then mm = "0"&mm
	dd = Day(x_day)
	If Len(dd) = 1 Then dd = "0"&dd
	x_day = yy&mm&dd
	day1.Data = week_check(x_day)
End Function


Function check_today()
	If xday.Data = day2.Data And xday.Data = day1.Data Then	'당일
		gbdy.Data = "1"
	Else
		gbdy.Data = "2"
	End If
End Function

