Sub SetSkip()
	Dim ii

	For ii = 1 To S210500.Columns
		S210500.SetSkip S210500.GetColumnName(ii), True
	Next

	For ii = 1 To S201300.Columns
		S201300.SetSkip S201300.GetColumnName(ii), True
	Next

	If RADIO0.Checked Then
		S210500.Visible = False
		S201300.Visible = True

		For ii = 1 To S201300.Columns
			S201300.SetSkip S201300.GetColumnName(ii), False
		Next

	ElseIf RADIO1.Checked Then
		S201300.Visible = False
		S210500.Visible = True

		For ii = 1 To S210500.Columns
			S210500.SetSkip S210500.GetColumnName(ii), False
		Next

	End If

End Sub

