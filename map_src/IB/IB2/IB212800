RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub web_navigate()
	Dim sLinkAddr

	If Trim(S1301.Data) <> "" Then
		If tab_new.ID = 1 Then
			sLinkAddr = "https://finance.daum.net/quotes/"+"A"+Trim(S1301.Data)+"#talks"
		Else
			sLinkAddr = "https://m.stock.naver.com/discussion/domestic/"& Trim(S1301.Data) &"/posts?orgCode=C1AABU0000"
		End If
	End If

	WebLink.Navigate(sLinkAddr)
End Sub

_AW_SCRIPT_AW_(tab_new)
_AW_ONCLICK_AW_
Dim sLinkAddr

Select Case tab_new.ID
	Case 0
		sLinkAddr = "https://finance.naver.com/item/board.nhn?code="+Trim(S1301.Data)
	Case 1
		sLinkAddr = "https://finance.daum.net/quotes/"+"A"+Trim(S1301.Data)+"#talks"
End Select

WebLink.Seturl2(sLinkAddr)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If Trim(S1301.Data) = "000000" Or Trim(S1301.Data) = "" Then
	Exit Sub
End If
S1301.Trigger "",True

web_navigate()

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_JM)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

web_navigate()
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(WebLink1)
