'CX_INTEREST.DLL 사용시 필요 함수
Sub SetTrData(map,handle,file,bookmark,data,dataLen)
	Dim hKey
	If map <> "2000" Then
		Exit Sub
	End If

	If tab_tujaEx1.ID = 0 Then
		hKey = SCREEN.Object("OBJ_Interest.CONTROL1").GetMapHandle()

		If Trim(handle) <> Trim(hKey) Then
			Exit Sub
		End If

		SCREEN.Object("OBJ_Interest.CfgFile").Data = file
		SCREEN.Object("OBJ_Interest.BookFile").Data = bookmark
		SCREEN.Object("OBJ_Interest.trData").Data = data
		SCREEN.Object("OBJ_Interest.DataLen").Data = dataLen
	End If

End Sub


'투자탭 분할1
Sub click_tujaEx1()
	Dim msgAns

	mapName = OBJ_Interest.GetObject

	If InStr(mapName,"IB2000W0") > 0 And tab_tujaEx1.ID <> 0 Then
		If SCREEN.Object("OBJ_Interest.CONTROL1").CheckSaveStatus = True Then
			msgAns = MsgBox ("[관심종목]변경 사항을 저장하시겠습니까?",1,"관심종목 저장 확인창")

			If msgAns = 1 Then
				SCREEN.Object("OBJ_Interest.CONTROL1").ClosingSave tab_tujaEx1.ID
				SCREEN.Object("OBJ_Interest.CfgFile").Data = ""
				SCREEN.Object("OBJ_Interest.BookFile").Data = ""
				SCREEN.Object("OBJ_Interest.trData").Data = ""
				SCREEN.Object("OBJ_Interest.DataLen").Data = ""
				SCREEN.SetTimer 1, False
				bCallClick = True
				Exit Sub
			Else
				SCREEN.Object("OBJ_Interest.CONTROL1").Recover
			End If

			SCREEN.Object("OBJ_Interest.CfgFile").Data = ""
			SCREEN.Object("OBJ_Interest.BookFile").Data = ""
			SCREEN.Object("OBJ_Interest.trData").Data = ""
			SCREEN.Object("OBJ_Interest.DataLen").Data = ""
		End If
	End If

	Select Case tab_tujaEx1.ID
		Case 0 :
			OBJ_Interest.Visible True
			obj_reduce1.Visible False
			If Trim(SCREEN.Object("OBJ_Interest.intercombo").Data) <> "" Then
				SCREEN.Object("OBJ_Interest.CONTROL1").ChangeGroup SCREEN.Object("OBJ_Interest.intercombo").Data
			End If

			OBJ_Interest.SetRect 8,29,326,329
			obj_reduce1.SetRect 8,1029,326,1329
		Case 1 :
			OBJ_Interest.Visible False
			obj_reduce1.Visible True
			obj_reduce1.SetObject "IB2000W1"
			obj_reduce1.SetRect 8,29,326,329
			OBJ_Interest.SetRect 8,1029,326,1329
		Case 2 :
			OBJ_Interest.Visible False
			obj_reduce1.Visible True
			obj_reduce1.SetObject "IB2000W2" ': OPEN_BTN0.Visible False
			obj_reduce1.SetRect 8,29,326,329
			OBJ_Interest.SetRect 8,1029,326,1329
		Case 3 :
			OBJ_Interest.Visible False
			obj_reduce1.Visible True
			obj_reduce1.SetObject "IB2000W3" ': OPEN_BTN0.Visible False
			obj_reduce1.SetRect 8,29,326,329
			OBJ_Interest.SetRect 8,1029,326,1329
		Case 4 :
			OBJ_Interest.Visible False
			obj_reduce1.Visible True
			obj_reduce1.SetObject "IB2000W4"
			obj_reduce1.SetRect 8,29,326,329
			OBJ_Interest.SetRect 8,1029,326,1329
		Case 5 :
			OBJ_Interest.Visible False
			obj_reduce1.Visible True
			obj_reduce1.SetObject "IB2000W6"
			obj_reduce1.SetRect 8,29,326,329
			OBJ_Interest.SetRect 8,1029,326,1329
		Case 6 :
			OBJ_Interest.Visible False
			obj_reduce1.Visible True
			obj_reduce1.SetObject "IB2000W7"
			obj_reduce1.SetRect 8,29,326,329
			OBJ_Interest.SetRect 8,1029,326,1329
		Case 7 :
			OBJ_Interest.Visible False
			obj_reduce1.Visible True
			obj_reduce1.SetObject "IB2000W8"
			obj_reduce1.SetRect 8,29,326,329
			OBJ_Interest.SetRect 8,1029,326,1329
		Case 8 :
			OBJ_Interest.Visible False
