Sub Settrigger(data, handle)
	Dim codx, hKey

	hKey = SCREEN.Object("OBJ_Interest.CONTROL1").GetMapHandle()

	If Trim(handle) <> Trim(hKey) Then
		Exit Sub
	End If

	If tab_tujaEx1.ID <> 0 Then
		Exit Sub
	End If

	codx = Trim(data)
	If Left(codx, 1) = "m" Then
		Exit Sub
	End If

	If Len(codx) = 3 Then
		Exit Sub

	ElseIf Len(codx) = 6 Then
		S1301.Data = codx
