'========================================
' 하위 OBJ에 시장구분자 세팅 후 조회 발생
'========================================
Sub Change_MKGubn_Main(sMKGubn)

	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "MKgubn", sMKGubn
	End If

	'=====================
	' 직전 시장구분자 저장
	'=====================
	Dim tMKGubn
	tMKGubn = cxMarket.sMarket

	'================================================================
	' 소속 OBJ 내의 cxMarket 시장 구분을 Main 시장구분으로 세팅
	'================================================================
	' 여기서 시장구분자 보정 후 Change_MKGubn_Main_Limited 함수 호출되어서
	' 하위 오브젝트에 시장 자동으로 전파한다.
	'================================================================
	Call Spread_mkgb(S1301.Data, sMKGubn)


	'================================================================
	' 시장 변동이 없을 경우 조회 Send 발생 SKIP 처리
	'================================================================
	' Spread_mkgb() 함수 이후의 시장구분자는 보정되고 난 다음의 시장구분자이다.
	'================================================================
	If tMKGubn = cxMarket.sMarket Then
		Exit Sub
	End If


	'====================
	' 하단 원장 OBJ 조회
	'====================
	Call Change_MKGubn_Main_Send()
End Sub


'=========================================
' 하위 OBJ에 시장구분자 세팅 (조회 미발생)
'=========================================
Sub Change_MKGubn_Main_Limited(sMKGubn)

	' 직전 시장구분자 저장
	Dim tMKGubn
	tMKGubn = cxMarket.sMarket

	SCREEN.IgnoreChange True
	cxMarket.sCode = S1301.Data
	cxMarket.sMarket = sMKGubn		' Main Market 변경

	'거래소 구분값추가로 인한 연동 함수
	SCREEN.Proc "main.OBJ_account.Change_MKGubn_OBJ"          , sMKGubn
	SCREEN.Proc "main.OBJ_order.OBJ_odr.Change_MKGubn_OBJ"    , sMKGubn
	SCREEN.Proc "main.obj_reduce1.Change_MKGubn_OBJ"          , sMKGubn
	SCREEN.Proc "main.obj_reduce1.Change_MKGubn_OBJ_Reduce1"  , sMKGubn
	SCREEN.Proc "main.obj_reduce2.Change_MKGubn_OBJ"          , sMKGubn
	SCREEN.Proc "main.OBJ_sise.Change_MKGubn_OBJ"             , sMKGubn
	SCREEN.Proc "Main.OBJ_account.OBJ1.Change_MKGubn_OBJ"     , sMKGubn
	SCREEN.Proc "main.OBJ_Interest.Change_MKGubn_OBJ"         , sMKGubn

	SCREEN.IgnoreChange False

	' 시장 변동 발생 시 조회 발생
	If tMKGubn <> cxMarket.sMarket Then
		Change_MKGubn_Main_Send()
		SCREEN.Proc "main.OBJ_Interest.ChangeMarket"              , sMKGubn
	End If

End Sub



'=====================================
' 하위 OBJ 시장 변동에 따른 Send 발생
'=====================================
Sub Change_MKGubn_Main_Send()
	' 하단 원장 OBJ 조회 :: 잔고구분자에 시장 변경 버튼이 존재
	Select Case tab_account.ID
	Case 0 : ' 미체결|잔고
		' 미체결 내역은 변경하지 않도록 위해 다음 구문을 사용
		' => 서브 미체결|잔고 화면의 OnSend() 에서 DONOTSEND 일때는
		'    미체결 조회 하지 않도록 스크립트 미체결내역의 OnSend 스크립트 추가
		SCREEN.Object("OBJ_account.OBJ0.GOSTOP").Text = "DONOTSEND"
		SCREEN.Object("OBJ_account.OBJ1").Send

	Case 2 :  ' 실시간잔고
		SCREEN.Object("OBJ_account").Send

	End Select

	SCREEN.Object("main.obj_codeInfo").Send	' 전송 시점에 시장선택
	SCREEN.Object("main.obj_currSise").Send ' 전송 시점에 시장선택
	SCREEN.Object("main.OBJ_hnam").Send	' 전송 시점에 시장선택
	SCREEN.Object("obj_obj_sise").Send	' 주문 단가 세팅용 시세 OBJ 전송 시점에 시장선택

	SCREEN.Object("main.obj_reduce1").Send
	SCREEN.Object("main.obj_reduce2").Send
	SCREEN.Object("main.OBJ_sise").Send
	SCREEN.Object("main.OBJECT0").Send

	OBJ_hnam.Send
	If UCase(TypeName( SCREEN.Object("OBJ_order.obj_odr.OBJ_hnam"))) <> "NOTHING" Then
		 SCREEN.Object("OBJ_order.obj_odr.OBJ_hnam").Send
	End If
End Sub


