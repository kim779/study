	tmp1 =  S34310.GetGridCell(S34310.Row, 9)
	S34310.Row = 2

	If (Trim(tmp1) = "") Then
		tmp1 = 0
	End If

	tmp2 =  S34310.GetGridCell(S34310.Row, 9)
	If (Trim(tmp2) = "") Then
		tmp2 = 0
	End If
	tmp3 = tmp1 - tmp2

	If ( tmp3 > 0 ) Then
		tmp4 = "+" & tmp3
	Else
		tmp4 = tmp3
   End If

	If tmp4 <> 0 Then
		S34310.SetGridCell 1, 10, tmp4
	End If


End Sub

