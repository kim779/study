Sub Init_combo_gvol()

 ' If SCREEN.GetMapName(1)<>"IB240100" Then Exit Sub
  Dim items
  ' Data Length 2자리일 경우의 ComboBox Item 구성
  items = "01" & vbTab & "00전체" & vbTab & _
  		  "01 1,000 주" & vbTab & _
  		  "02 2,000 주" & vbTab & _
          "03 3,000 주" & vbTab & _
          "04 5,000 주" & vbTab &_
          "05 10,000 주" & vbTab & _
          "06 30,000 주" & vbTab & _
          "07 50,000 주" & vbTab & _
          "08 100,000 주" & vbTab & _
          "09 500,000 주" & vbTab & _
          "10 1,000,000 주"
  gvol.SetItems(items)
  gvol.Index  = 00

End Sub

'''combobox 수량 설정
Sub Set_combo_gvol()
SCREEN.IgnoreChange True

	Select Case gvol.Data
		Case "00" '전
			ed_gvol.Data = "000000000000000"
		Case "01"		'1000
			ed_gvol.Data = "000000000001000"
		Case "02"		'1000
			ed_gvol.Data = "000000000002000"
		Case "03"		'1000
			ed_gvol.Data = "000000000003000"
		Case "04"		'1000
			ed_gvol.Data = "000000000005000"
		Case "05"		'1000
			ed_gvol.Data = "000000000010000"
		Case "06"		'1000
			ed_gvol.Data = "000000000030000"
		Case "07"		'1000
			ed_gvol.Data = "000000000050000"
		Case "08"		'1000
			ed_gvol.Data = "000000000100000"
		Case "09"		'1000
			ed_gvol.Data = "000000000500000"
		Case "10"		'1000
			ed_gvol.Data = "000000001000000"
		Case Else
			ed_gvol.Data = "000000003000000"
	End Select

SCREEN.IgnoreChange False
End Sub

