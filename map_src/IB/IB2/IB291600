			BUTTON30.Enable  = True
    	ElseIf button = 4 Then
			BUTTON41.Visible = False
			BUTTON41.Enable  = False
			BUTTON40.Visible = True
			BUTTON40.Enable  = True
    	ElseIf button = 5 Then
 			BUTTON51.Visible = False
			BUTTON51.Enable  = False
			BUTTON50.Visible = True
			BUTTON50.Enable  = True
    	ElseIf button = 6 Then
 			BUTTON61.Visible = False
			BUTTON61.Enable  = False
			BUTTON60.Visible = True
			BUTTON60.Enable  = True
        End If
    Else
        SYSTEM.Trace "graphchk:1 button:"&button
        If button = 1 Then
