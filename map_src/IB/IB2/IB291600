Sub ControlRBtn(iNum, radFlag)
	Dim WHIMG



	For ii=0 To R_TCNT - 1
		strExpr = "BUTTON" & R_UNIT*(ii+1) & ".text=" & Chr(34) & "투자자별" & "0" & (ii+2)
		If ii = CLng(iNum-1) Then
			SYSTEM.Trace "graph txt : " & ISGRAPH.Text & " RbnNo : " & lblRBtnNo.Text
			SYSTEM.Trace "iNum : " & iNum

			If (ISGRAPH.Text = "G") And (CLng(lblRBtnNo.Text) = CLng(iNum)) Then
			    SYSTEM.Trace "pyo mode"
				OBJ5.Visible = False
				SYSTEM.Trace "showline = " & "false"
				ShowLine(1)
				ISGRAPH.Text = "T"
				OBJ1.Send
				OBJ2.Send
				OBJ3.Send
				'	strExpr = strExpr & UPIMG
				Call ButtonRecov(iNum, 0)
		   Else
				SYSTEM.Trace "graph mode"

				OBJ5.Visible = True
				SYSTEM.Trace "showline = " & "true"
				ShowLine(0)
		        ISGRAPH.Text = "G"
				'	strExpr = strExpr & DNIMG
		     	Call ButtonRecov(iNum, 1)
			End If
		Else
				'strExpr = strExpr & UPIMG
		End If
		'strExpr = strExpr & Chr(34)

		'execute strExpr
	Next

	lblRBtnNo.Text = iNum

	If ISGRAPH.Text = "T" Then
		OBJ1.Send
		OBJ2.Send
		OBJ3.Send
	Else
		OBJ5.Send
	End If
End Sub

Const myFILE = "userconf.ini"
Const myMAP = "IB291600"
Dim jj

Sub p_read_ini()
If SCREEN.CreateObject("Info") Then
 	jj = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "G_CHCK"))
	Select Case jj
		Case "1"
			Call ControlRBtn(1, False)
		Case "2"
			Call ControlRBtn(2, False)
		Case "3"
			Call ControlRBtn(3, False)
		Case "4"
			Call ControlRBtn(4, False)
		Case "5"
			Call ControlRBtn(3, False)
		Case "6"
			Call ControlRBtn(4, False)
		Case Else

		End Select
	g_chck.Data = jj
End If
End Sub


Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
	  INFO.PushData LOGIN.Name, myFILE, myMAP, "G_CHCK", g_chck.data
	End If
End Sub

Sub p_write_ini2()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB291600", "stock", stock.data
		INFO.PushData LOGIN.Name, "userconf.ini", "IB291600", "future", future.data
		INFO.PushData LOGIN.Name, "userconf.ini", "IB291600", "option", coption.data
	End If
End Sub

Sub p_read_ini2()
	If SCREEN.CreateObject("INFO") Then
		Dim vol, amt, acc
		vol = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB291600", "stock"))
		amt = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB291600", "future"))
		acc = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB291600", "option"))

		stock.data = vol
		future.Data = amt
		coption.data = acc

		OBJ1.Send
		OBJ2.Send
		OBJ3.send

	End If
End Sub

