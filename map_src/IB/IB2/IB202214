RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim save, start, svrn, send_yn, tmp1
start = False

Function get_true(chk)
	If chk = "True" Then
		get_true = 1
	Else
		get_true = 0
	End If
End Function

'조회설정값 저장하기
Private Sub SAVE_Config(val)
	If SCREEN.CreateObject("Info") = False Then Exit Sub

	Select Case val
		Case 1
			INFO.PushData LOGIN.Name, "userconf.ini", "DH205710", "gubn", gubn.Text
		Case 2
			INFO.PushData LOGIN.Name, "userconf.ini", "DH205710", "gap", gap.Data
		Case 3
			INFO.PushData LOGIN.Name, "userconf.ini", "DH205710", "chk_mod", chk_mod.Checked
	End Select
End Sub

Sub Set_option()
	Dim tmp

	Select Case (gubn.Text)
		Case "0", "5"
			chk_mod.Enable = False
			gap.Enable = False
		Case "1"
			chk_mod.Enable = False
			gap.Enable = True
		Case Else
			chk_mod.Enable = True
			gap.Enable = False
	End Select
	svrn = "ctl"&gubn.Text
	For ii = 0 To 5
		tmp = "ctl"&ii
		If CStr(ii) = Trim(gubn.Text) Then
			SCREEN.Object(tmp).ShowWindow 1
		Else
			SCREEN.Object(tmp).ShowWindow 0
		End If
		If start = False Then
			SCREEN.Object(tmp).SetKeepDisplaySize(1)
		End If
	Next
	start = True
End Sub

'-----------------------------------------------------------------
' DESC : 차트 속성 셋팅
'-----------------------------------------------------------------
Sub Query_Chart()
	Dim sCode, trcd, send

	sCode = Trim(S71301.data)
	If Trim(sCode) = "" Then
		Exit Sub
	End If

	tmp1 = sCode&gubn.Text&gap.data&get_true(chk_mod.Checked)

	If save <> tmp1 Then
		Set_option()
		If Left(save, 6) <> sCode Then
			For ii = 0 To 5
				send = "send"&CStr(ii)
				SCREEN.Object(send).text = "N"
			Next
		End If

		If Mid(save, 1) <> chk_mod.Checked Then
			For ii = 2 To 4
				send = "send"&CStr(ii)
				SCREEN.Object(send).text = "N"
			Next
		End If

		If Mid(save, 8, 2) <> gap.Data Then
			send1.text = "N"
		End If
		save = sCode&gubn.Text&gap.data&get_true(chk_mod.Checked)
	Else
		Exit Sub
	End If

	send_yn = "send"&gubn.Text
'	If SCREEN.Object(send_yn).text = "Y" Then
'		Exit Sub
'	End If


	SCREEN.Object(svrn).clearAllDATA

'	If gubn.Text = "5" Then
'		SCREEN.Object(svrn).Setdisplaysize 370
'	End If

	SCREEN.Object(svrn).SetChartPeriod 0, (gubn.Text)
'	SCREEN.Object(svrn).showgraph 0, 1, 1
'	SCREEN.Object(svrn).SetBaseLineValue 0, 0
'	SCREEN.Object(svrn).Setcharttype 0, "봉차트"
	If gubn.Text < 2 Then
		trcd = gubn.Text
		If trcd = 1 Then
			SCREEN.Object(svrn).Setgraphheader 0, 1, 3, gap.Data		'분간격
			SCREEN.Object(svrn).Setchartcycle 0, gap.Data
			SCREEN.Object(svrn).SetLastCloseChangeType(1)				'전일종가대비
		End If
	ElseIf gubn.Text = 5 Then								'분틱
		trcd = 3
		SCREEN.Object(svrn).SetChartPeriod 0, 1
		SCREEN.Object(svrn).Setchartcycle 0, 1
'		SCREEN.Object(svrn).SetBaseLineValue 0, 1
'		SCREEN.Object(svrn).Setcharttype 0, "종가선차트"
'		SCREEN.Object(svrn).showgraph 0, 1, 0
'		SCREEN.Object(svrn).AddPriceData 0, 4, CDbl(LOGIN.Date)
	Else
		trcd = 2
		Select Case (gubn.Text)
			Case "2"
				SCREEN.Object(svrn).SetGraphHeader 0, trcd, 2, 1
			Case "3"
				SCREEN.Object(svrn).SetGraphHeader 0, trcd, 2, 2
			Case "4"
				SCREEN.Object(svrn).SetGraphHeader 0, trcd, 2, 3
		End Select
		'수정주가
		If chk_mod.Checked = True Then
			Call SCREEN.Object(svrn).SetGraphHeader( 0, 2, 4, 33)
		Else
			Call SCREEN.Object(svrn).SetGraphHeader( 0, 2, 4, 32)
		End If
		SCREEN.Object(svrn).SetLastCloseChangeType(0)	'직전봉대비
	End If

	If SCREEN.Object(svrn).getRequestState(0, trcd) <> 0 Then
		Exit Sub
	End If

	SCREEN.Object(svrn).SetMarketType 0, 2
	SCREEN.Object(svrn).SetTickSize 0, 0.01

	SCREEN.Object(svrn).SetInputValue 0, trcd, "21301", sCode
	SCREEN.Object(svrn).RequestData 0, trcd
	SCREEN.Object(send_yn).text = "Y"

End Sub

_AW_ONSTART_AW_
Dim tmp
'이전 조회설정값 읽어오기
If SCREEN.CreateObject("Info") Then
	gubn.Text = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "DH205710", "gubn"))
	If Trim(gubn.Text) = "" Then
		gubn.Text = "2"
	Else
		Select Case gubn.Text
			Case "0" : r_0.Checked = True : chk_mod.Enable = False
			Case "1" : r_1.Checked = True : chk_mod.Enable = False : gap.Visible = True
			Case "2" : r_2.Checked = True : chk_mod.Enable = True
			Case "3" : r_3.Checked = True : chk_mod.Enable = True
			Case "4" : r_4.Checked = True : chk_mod.Enable = True
			Case "5" : r_5.Checked = True : chk_mod.Enable = False
		End Select
	End If
	tmp = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "DH205710", "gap"))
	If Trim(tmp) <> "" Then gap.Data = tmp
	tmp = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "DH205710", "chk_mod"))
	If Trim(tmp) <> "" Then chk_mod.Checked = tmp
End If

Call Set_option()
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S71022.Data = SCREEN.GetName(108, S71301.data, 0)
Query_Chart()

