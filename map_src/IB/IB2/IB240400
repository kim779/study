_AW_ONDECLARE_AW_
Sub SetGrid()
	If COMBO0.Data = "9" Then
		GRID0.SetColumnVisible 11, True

		GRID0.SetColumnWidth 6, 70
		GRID0.SetColumnWidth 7, 70
		GRID0.SetColumnWidth 8, 70
		GRID0.SetColumnWidth 9, 80
		GRID0.SetColumnWidth 10, 37
	Else
		GRID0.SetColumnVisible 11, False

		GRID0.SetColumnWidth 6, 82
		GRID0.SetColumnWidth 7, 82
		GRID0.SetColumnWidth 8, 82
		GRID0.SetColumnWidth 9, 92
		GRID0.SetColumnWidth 10, 50

	End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

c_upgb.SetFocus

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim gday

'If KP.Checked = True Then
'	upgb.Data = "00"
'ElseIf KQ.Checked = True Then
'	upgb.Data = "09"
'Else
'	upgb.Data = "99"
'End If

If R_MS.Checked = True Then
	mmgb.Data = "00"
Else
	mmgb.Data = "01"
End If

gday = Trim(dday.data)
If gday = "" Or gday < 3 Then
	dday.Data = "3"
End If


If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

