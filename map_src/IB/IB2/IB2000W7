_AW_ONDECLARE_AW_
Sub OBJ_send()
	SCREEN.Send 0
End Sub

Sub Find_Thema()
	Dim SearchString, GridString
	Dim Pos, ii
	SearchString = Trim(TMED.Data)

	For ii = 1 To SCREEN.Object("OBJ_TEMA.GRID1").Rows
		GridString = Trim(SCREEN.Object("OBJ_TEMA.GRID1").GetGridCell(ii, 2))
		Pos = InStr(GridString, SearchString)

		If Pos > 0 Then
			TMNAM.Data = "[" & Trim(SCREEN.Object("OBJ_TEMA.GRID1").GetGridCell(ii, 1)) & _
						"] "& Trim(SCREEN.Object("OBJ_TEMA.GRID1").GetGridCell(ii, 2))

			SCREEN.Object("OBJ_TEMA.GRID1").index = ii-1
			SCREEN.Object("OBJ_TEMA.GRID1").SetFocus
			SCREEN.Object("main.theme_code").data = Trim(SCREEN.Object("OBJ_TEMA.GRID1").GetGridCell(ii, 1))
			SCREEN.Object("main.theme_index").data = ii-1
			SCREEN.Object("main.TMNAM").data = Trim(TMNAM.Data)
			Exit Sub
		End If
	Next
End Sub

Sub Init_Set()
	TMCB.data = SCREEN.Object("main.theme_code").data
	SCREEN.Object("OBJ_TEMA.GRID1").index = SCREEN.Object("main.theme_index").data
	SCREEN.Object("OBJ_TEMA.GRID1").SetFocus
	TMNAM.Data = Trim(SCREEN.Object("main.TMNAM").data)
End Sub

