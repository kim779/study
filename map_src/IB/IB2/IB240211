_AW_ONDECLARE_AW_
Dim clickCnt
clickCnt = 0

Sub send_f()
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
End Sub


_AW_ONSEND_AW_
Dim v_dygb, show(4)
v_dygb = Int(mmgb.Data)
If SCREEN.Object("main.R2_2").Checked = True Then
	v_dygb = v_dygb + 2
End If

show(0) = False
show(1) = False
show(2) = False
show(3) = False
show(v_dygb-1) = True
GRID.SetColumnVisible 10, show(0)
GRID.SetColumnVisible 11, show(1)
GRID.SetColumnVisible 14, show(2)
GRID.SetColumnVisible 15, show(3)
GRID.SetColumnVisible 8, SCREEN.Object("main.R2_1").Checked
GRID.SetColumnVisible 9, SCREEN.Object("main.R2_1").Checked
GRID.SetColumnVisible 12, SCREEN.Object("main.R2_2").Checked
GRID.SetColumnVisible 13, SCREEN.Object("main.R2_2").Checked

dygb.Data = v_dygb
WCODF.Data = SCREEN.Object("main.WCODF").data

'UPCD.Data = SCREEN.Object("main.200901").data

'If startFlag.Data = 0 Then
'	UPCD.Data = "888"
'	startFlag.Data = 1
'Else
	UPCD.Data = SCREEN.Object("main.200901").Data
'End If

v_dygb = 0

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GRID0").SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID)
_AW_ONCLICK_AW_
If GRID.HitPos = 3 Then
	S1301.DATA = GRID.GetGridCell(GRID.INDEX +1, 2)

	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.Data
ElseIf GRID.HitPos = 1 Then
	Select Case Trim(dygb.Data)
		Case 1
			GRID.Sort 10, False, False
		Case 2
			GRID.Sort "4", False, False
	End Select
End If

If GRID.HitPos = 4 And GRID.Column = 4 Then

	If GRID.Column = 4 Then
		clickCnt = clickCnt + 1

		If (clickCnt Mod 2) = 0 Then
			GRID.Sort "4", False, True
		Else
			GRID.Sort "4", True, True
		End If
	Else
		clickCnt = 0
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


