'------------------------------------------------------
Sub SetFirstData()
	If Not g_IsFirst Then
		Exit Sub
	End If

	Dim AYear, AMon, ADay
	AYear = Year(DateAdd("m", -1, Date))
	AMon = Month(DateAdd("m", -1, Date))
	If Len(AMon) = 1 Then
		AMon = "0" & AMon
	End If
	ADay = Day(DateAdd("m", -1, Date))
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	SCREEN.IgnoreChange True
	dt_StartDate.Data = AYear & AMon & ADay
	SCREEN.IgnoreChange False
End Sub
'-------------------------------------------------------------------
Sub SetStartDate()
	If ed_DataTp.Data = 1 Then
'		If BUTTON1.Text = "데이터" Then		'차트
'			dt_StartDate.Enable = True
'		Else
			dt_StartDate.Enable = False
'		End If
	Else
		dt_StartDate.Enable = True
	End If
End Sub


Sub changeMap()
	SYSTEM.Push "mapChg_2025", ""
	Call p_write_ini()
	SYSTEM.Push "mapChg_2025", "expand"
	SCREEN.ChangeMap "IB202530"
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "jmcd", Trim(S1301.Data)
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "srtDt", Trim(dt_StartDate.Data)
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "endDt", Trim(S12901_D.Data)
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "dateTp", Trim(ed_DataTp.Data)
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "viewTp", Trim(AMTF.Data)
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "unitTp", Trim(dan.Data)
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "mmgbTp", Trim(GUBN.Data)
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "mode", Trim(sect.Data)
	End If
	SYSTEM.Push "cxMarket2025Code", S1301.Data
	SYSTEM.Push "cxMarket2025Mk", cxMarket.sMarket
	
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim jmcd, srtDt, EndDt, DateTp, viewTp, unitTp, mmgbTp, Mode
		DateTp = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "dateTp"))

		If Trim(DateTp) = "" Then
			SetFirstData
			SetStartDate

			S1301.SetFocus
			Send_Screen()
			Exit Sub
		End If

		jmcd = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "jmcd"))
		srtDt = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "srtDt"))
		EndDt = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "endDt"))

		If Trim(SYSTEM.Pop("mapChg_2025")) <> "" Then
			S1301.Data = jmcd
			dt_StartDate.Data = srtDt
			S12901_D.Data = EndDt
		End If

		viewTp = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "viewTp"))
		unitTp = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "unitTp"))
		mmgbTp = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "mmgbTp"))
		Mode = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "mode"))

		ed_DataTp.Data = DateTp
		AMTF.Data = viewTp
		dan.Data = unitTp
		GUBN.Data = mmgbTp
		sect.Data = Mode

		If DateTp = 1 Then
			R21.Checked = True
			dt_StartDate.Enable = False
		Else
			R22.Checked = True
			dt_StartDate.Enable = True
		End If

		If viewTp = 1 Then
			If Trim(unitTp) = "" Then
				unitTp = 0
			End If

			If unitTp = 0 Then
				R1.Checked = True
			Else
				R3.Checked = True
			End If
		Else
			R2.Checked = True
		End If

		If mmgbTp = 1 Then
			R12.Checked = True
		ElseIf mmgbTp = 2 Then
			R13.Checked = True
		Else
			R11.Checked = True
		End If

		If Mode = 1 Then
			BUTTON1.Text = "데이터"
			OBJ.SetObject "IB202520"
		Else
			BUTTON1.Text = "차트"
			OBJ.SetObject "IB202510"
		End If

		SYSTEM.Push "mapChg_2025", ""
	End If

	Dim cxMarket2025Code, cxMarket2025Mk
	cxMarket2025Code = SYSTEM.Pop ("cxMarket2025Code")
	cxMarket2025Mk = SYSTEM.Pop ("cxMarket2025Mk")
	
	If cxMarket2025Code <> "" Then
		cxMarket.sCode = cxMarket2025Code
	End If

	If cxMarket2025Mk <> "" Then
		cxMarket.sMarket = cxMarket2025Mk
	End If

End Sub

Sub changeMode()
	' 0- 데이터 1- 차트

	If sect.Data = "0" Then
		sect.Data = "1"
		BUTTON1.Text = "데이터"
		OBJ.SetObject "IB202520"
	ElseIf sect.data = "1" Then
		sect.Data = "0"
		BUTTON1.Text = "차트"
		OBJ.SetObject "IB202510"
	End If
	SetStartDate
	SCREEN.Send 0

	BUTTON1.SetFocus
End Sub

Sub mapSizeSave()
	If SCREEN.CreateObject("INFO") = True Then
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "size", Trim(size.Text)
	End If
End Sub

Sub mapSizeLoad()
	If SCREEN.CreateObject("INFO") = True Then
		Dim mapSize
		mapSize = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "size"))

		size.Text = Trim(mapSize)
	End If
End Sub

