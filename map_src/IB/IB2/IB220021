RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim start
start = 0
Sub ReloadCode()
	grid.code = SCREEN.Object("main.ed_focod").Data
End Sub

Sub Setdata()
	Dim data
	func.Data = "F"
	obj.Proc "start",""
	data =""
	MMYY.SetItems(data)
	SCREEN.Send 0
	start = 1
End Sub

_AW_ONSTART_AW_
grid.SetMapHandle SCREEN.Major & SCREEN.Minor

grid.SetPredict 0

If SCREEN.CreateObject("Info") Then
	cbType.Data = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB220000", "SGJ_TYPE"))
	gubn.Data = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB220000", "minigubn"))
End If

start = 0
Call Setdata()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
'SCREEN.Object("obj.30303").data = MMYY.Index+1
'obj.Send

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(MMYY.Data) <> "" Then
	func.Data = "E"
End If

grid.hsga = atm.Data
grid.code = SCREEN.Object("main.ed_focod").Data

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
If SCREEN.CreateObject("Info") Then
	INFO.PushData LOGIN.Name, "userconf.ini", "IB220000", "SGJ_TYPE", cbType.Data
	INFO.PushData LOGIN.Name, "userconf.ini", "IB220000", "minigubn", gubn.Data
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(MMYY)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(chkPrd)
_AW_ONCLICK_AW_
If chkPrd.Checked Then
	grid.SetPredict 1

	SCREEN.Proc "obj.SetPredict",True

	prd.Data = 1
Else
	grid.SetPredict 0

	SCREEN.Proc "obj.SetPredict",False

	prd.Data = 0
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cbType)
_AW_ONCHANGE_AW_
grid.SetType cbType.Data

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(gubn)
_AW_ONCHANGE_AW_
If start <> 0 Then
	Call Setdata()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



