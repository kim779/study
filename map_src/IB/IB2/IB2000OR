RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim exgb

'왼쪽 상단 obj 분할로 보여줄건지 결정
Sub change_extend(gb)
	exgb = gb
	Call change_tujaObj(exgb)
	SCREEN.SetTimer 2, True
End Sub

'왼쪽 상단 obj 분할로 보여줄건지 결정
Sub change_tujaObj(xgb)
	If xgb = "0" Then	'--일반
		'화면 setobject
		Call click_tuja()

		'탭변경
		tab_tuja.Visible True
		tab_tujaEx1.Visible False
		tab_tujaEx2.Visible False

		'오브젝트 변경
		OBJ_tuja.Visible True
		obj_reduce1.Visible False
		obj_reduce2.Visible False

		'확장 버튼 설정
		OPEN_BTN0.Visible True

		'판넬 변경
		PANEL6.Visible False
		PANEL7.Visible False
		PANEL17.Visible True
		panel_hoga2.Visible False
		PANEL_topS.visible False
		PANEL_bottom.visible False
		PANEL_left.visible False
		PANEL_right.visible False


	Else			'--분할
		'화면 setobject
		Call click_tujaEx1()
		Call click_tujaEx2()

		'탭변경
		tab_tuja.Visible False
		tab_tujaEx1.Visible True
		tab_tujaEx2.Visible True

		PANEL7.Visible True
		PANEL17.Visible False

		'호가탭일 경우 테두리있는 패널 사용
		If tab_tujaEx2.ID  = 0 Then
			panel_hoga2.Visible True
			PANEL_topS.visible True
			PANEL_bottom.visible True
			PANEL_left.visible True
			PANEL_right.visible True
			PANEL6.Visible False
		Else
			panel_hoga2.Visible False
			PANEL_topS.visible False
			PANEL_bottom.visible False
			PANEL_left.visible False
			PANEL_right.visible False
			PANEL6.Visible True
		End If

		'오브젝트 변경
		OBJ_tuja.Visible False
		obj_reduce1.Visible True
		obj_reduce2.Visible True

		'확장 버튼 설정
		OPEN_BTN0.Visible False

	End If

End Sub


'투자탭
Sub click_tuja()
	OPEN_BTN0.Visible True
	Select Case tab_tuja.ID
		Case 0 : OBJ_tuja.SetObject "IB200011" : SCREEN.Object("OBJ_tuja.OBJ1").Visible True
		Case 1 : OBJ_tuja.SetObject "IB200013" : SCREEN.Object("OBJ_tuja.OBJ").Visible True
		Case 2 : OBJ_tuja.SetObject "IB200051" : OPEN_BTN0.Visible False '"IB200019"
		Case 3 : OBJ_tuja.SetObject "IB200014" : OPEN_BTN0.Visible False
		Case 4 : OBJ_tuja.SetObject "IB200016" : Exit Sub': news.Visible True
		Case 5 : OBJ_tuja.SetObject "IB200052"
'		Case 6 : OBJ_tuja.SetObject "IB200055"
		Case 6 : OBJ_tuja.SetObject "IB200054"
		Case 7 : OBJ_tuja.SetObject "IB20005G"
	End Select

	OBJ_tuja.Send
End Sub

'투자탭 분할1
Sub click_tujaEx1()
	Select Case tab_tujaEx1.ID
		Case 0 : obj_reduce1.SetObject "IB20002A" ': SCREEN.Object("obj_reduce1.OBJ1").Visible True
		Case 1 : obj_reduce1.SetObject "IB20002B"
		Case 2 : obj_reduce1.SetObject "IB20002C" ': OPEN_BTN0.Visible False
		Case 3 : obj_reduce1.SetObject "IB20002D" ': OPEN_BTN0.Visible False
		Case 4 : obj_reduce1.SetObject "IB20002E"
		Case 5 : obj_reduce1.SetObject "IB20002F"
		Case 6 : obj_reduce1.SetObject "IB20002G"
		Case 7 : obj_reduce1.SetObject "IB20005F"
	End Select

	obj_reduce1.Send
End Sub

'투자탭 분할2
Sub click_tujaEx2()
	Select Case tab_tujaEx2.ID
		Case 0 : obj_reduce2.SetObject "IB200020" : obj_reduce2.Proc "SetIniName", "0"
		Case 1 : obj_reduce2.SetObject "IB200022"
		Case 2 : obj_reduce2.SetObject "IB200024"
		Case 3 : obj_reduce2.SetObject "IB200023"
		Case 4 : obj_reduce2.SetObject "IB200027"
		Case 5 : obj_reduce2.SetObject "IB200050"
		Case 6 : obj_reduce2.SetObject "IB200015"
	End Select

	obj_reduce2.Send
End Sub

Sub all_account()
	If tab_account.ID = 2 Then
		OBJ_account.Proc "main_sended", ""
	Else
		OBJ_account.Send
	End If
End Sub

'5분할시 obj_tuja화면 숨기기
Sub hide_ExpandObj()
	SCREEN.Object("obj_tuja").visible False

	Select Case tab_tuja.ID
		Case 0
			If SCREEN.Object("obj_tuja.RADIO1").Checked = True Then
				SCREEN.Object("obj_tuja.OBJ1").visible = False
				SCREEN.Object("obj_tuja.OBJ1.OBJ1").visible = False
			Else
				SCREEN.Object("obj_tuja.OBJ1").visible = False
			End If
		Case 1
			SCREEN.Object("obj_tuja.OBJ").visible = False
		Case 2
			SCREEN.Object("obj_tuja.OBJ_chart").SetObject ""
		Case 4
			SCREEN.Object("obj_tuja.obj0").visible = False
			SCREEN.Object("obj_tuja.OBJ_hnam.17413").visible = False

		Case 5
			SCREEN.Object("obj_tuja.OBJ").visible = False
			SCREEN.Object("obj_tuja.OBJ0.CONTROL0").Visible = False
			SCREEN.Object("obj_tuja.OBJ1.CONTROL0").Visible = False

		Case 6
'			SCREEN.Object("obj_tuja.OBJ_TEMA").visible = False
			SCREEN.Object("obj_tuja.OBJ1").visible = False
		Case 7
			SCREEN.Object("obj_tuja.CONTROL0").Visible = False
		Case Else
	End Select
End Sub

'4분할시  obj_tuja화면 보이기
Sub show_ExpandObj()
	If Trim(SCREEN.Object("obj_tuja").GetObject) = "" Then
		Exit Sub
	End If

	SCREEN.Object("obj_tuja").visible True
	Select Case tab_tuja.ID
		Case 0
			If SCREEN.Object("obj_tuja.RADIO1").Checked = True Then
				SCREEN.Object("obj_tuja.OBJ1").visible = True
				SCREEN.Object("obj_tuja.OBJ1.OBJ1").visible = True
			Else
				SCREEN.Object("obj_tuja.OBJ1").visible = True
			End If

			If InStr(SCREEN.Object("OBJ_tuja.intercombo").Data, "00") > 0 Then
				SCREEN.Proc "OBJ_tuja.OBJ1.OnGroup", SCREEN.Object("OBJ_tuja.intercombo").Data
			End If
		Case 1
			SCREEN.Object("obj_tuja.OBJ").visible = True
		Case 2
			OBJ_tuja.proc "func_CHK", ""
		Case 4
			SCREEN.Object("obj_tuja.obj0").visible = True
			SCREEN.Object("obj_tuja.OBJ_hnam.17413").visible = True
		Case 5
			SCREEN.Object("obj_tuja.OBJ").visible = True
			OBJ_tuja.Proc "OBJ_setting", ""
			SCREEN.Object("obj_tuja.OBJ0.CONTROL0").Visible = True
			SCREEN.Object("obj_tuja.OBJ1.CONTROL0").Visible = True

		Case 6
'			SCREEN.Object("obj_tuja.OBJ_TEMA").visible = True
'			OBJ_tuja.Proc "Init_Set", ""
			SCREEN.Object("obj_tuja.OBJ1").visible = True
		Case 7
			SCREEN.Object("obj_tuja.CONTROL0").Visible = True
		Case Else
	End Select
End Sub

