		SCREEN.Object("OBJ_tuja.1301").data = Trim(S1301.Data)
		SCREEN.Object("OBJ_tuja.OBJ1.1301").data = Trim(S1301.Data)
		OBJ_tuja.Send
	End If

	'5분할 뉴스
	If tab_tujaEx1.ID = 4 Then
'		SCREEN.Object("obj_reduce1.1301").data = Trim(S1301.Data)
		obj_reduce1.Send
	End If

	'5분할 테마
