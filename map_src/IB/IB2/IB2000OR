			SCREEN.IgnoreChange True
			SCREEN.Object("OBJ_order.obj_odr.1301").Data = S1301.Data
			SCREEN.Proc "OBJ_order.obj_odr.ChangeCode", ""
			SCREEN.IgnoreChange False
		End If
	End If

	If Trim(SCREEN.Object("obj_reduce2").GetObject) <> "" Then
		If Trim(S1301.Data) <> Trim(SCREEN.Object("obj_reduce2.1301").data) Then
				SCREEN.Object("obj_reduce2.1301").data = Trim(S1301.Data)
			obj_reduce2.Send
		End If
	End If

	If Trim(S1301.Data) <> Trim(SCREEN.Object("OBJ_sise.1301").data) Then
			SCREEN.Object("OBJ_sise.1301").data = Trim(S1301.Data)
		OBJ_sise.Send
	End If

