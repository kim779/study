'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	Data = re.Replace(Data,"")
	If Len(Data) > 0 Then
		If SCREEN.Object("parent.r1_3").Checked And CLng(Data) > 0 Then
			SetSign = "+" & Data
		Else
			SetSign = Data
		End If
	End If
End Function
'-----------------------------------------------------------------------
Function ForceSign(Data, Rate)
	ForceSign = Data
	Data = re.Replace(Data,"")
	Rate = re.Replace(Rate,"")
	If Len(Rate) > 0 Then
		If CDbl(Rate) > 0 Then
			ForceSign = "+" & Data
		ElseIf CDbl(Rate) < 0 Then
			ForceSign = "-" & Data
		End If
	End If
End Function
'-----------------------------------------------------------------------
Function SetTimeElement(hh, mm, ss)
	If Len(hh) = 1 Then
		hh = "0" & hh
	End If
	If Len(mm) = 1 Then
		mm = "0" & mm
	End If
	If Len(ss) = 1 Then
		ss = "0" & ss
	End If
	SetTimeElement = hh & ":" & mm & ":" & ss
End Function
'-----------------------------------------------------------------------
Function GetTime(SrcTime, Interval)
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = CLng(Mid(SrcTime, 1, 2))
	AMin = CLng(Mid(SrcTime, 3, 2))
	ASec = CLng(Mid(SrcTime, 5, 2))
	If Interval = 0 Then '30초간격
		If ASec >= 30 Then
			ASec = 0
			AMin = AMin + 1
		Else
			ASec = 30
		End If
	ElseIf Interval = 60 Then
		AHour = AHour + 1
		AMin = 0
		ASec = 0
	Else
		ASec = 0
		AMin = (Fix(AMin / Interval) + 1) * Interval
	End If
	ADate = TimeSerial(AHour, AMin, ASec)

	GetTime = SetTimeElement(Hour(ADate), Minute(ADate), Second(ADate))
End Function
'-----------------------------------------------------------------------
Function GetTimeJisu(SrcTime, Interval)
	Dim remain
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = CLng(Mid(SrcTime, 1, 2))
	AMin = CLng(Mid(SrcTime, 3, 2))
	ASec = CLng(Mid(SrcTime, 5, 2))

	If Interval = 0 Then '30초간격
		If ASec > 0 Then
			If ASec < 40 Then
				ASec = 30
			Else
				ASec = 0
				AMin = AMin + 1
			End If
		End If
	ElseIf Interval = 60 Then
		AHour = AHour + 1
		AMin = 0
		ASec = 0
	Else
		ASec = 0
		AMin = (Fix(AMin / Interval) + 1) * Interval
	End If

	ADate = TimeSerial(AHour, AMin, ASec)

	GetTimeJisu = SetTimeElement(Hour(ADate), Minute(ADate), Second(ADate))
End Function
