JJIS.Data = Trim(SCREEN.Object("parent.JJIS").Data)

For ii = LBound(componentArr) To UBound(componentArr)
	tmpCom = Trim(componentArr(ii))
	compTp = Left(tmpCom, 1)

	If compTp <> "l" Then
		If compTp = "c" Then
			SCREEN.Object(tmpCom).Checked SCREEN.Object("parent." & tmpCom).Checked
		Else
			SCREEN.Object(tmpCom).Data = Trim(SCREEN.Object("parent." & tmpCom).Data)
		End If
	End If
Next

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, jj, kk, grid, headNm, viewHeadNm, headInfoArr, col, width, data, tColor, gridRow
Set grid = SCREEN.Object("parent.grd")

For ii = 1 To grd.Rows

	If sendFlag = "Y" Then
		If ii < grid.Rows Then
			gridRow = ii
		Else
			grid.InsertRow - 1
			gridRow = grid.Rows
		End If
	Else
		grid.InsertRow -1
		gridRow = grid.Rows
'		SYSTEM.Trace "gridRow = " & gridRow
	End If

	For jj = 1 To grd.Columns
		If jj <= 6 Then
			grid.SetGridCell gridRow, jj, Trim(grd.GetGridCell(ii, jj))
		Else
			headNm = Trim(grid.GetHead(jj))

			If headNm <> "" Then
				col = getHeadColNo(headNm)
				data = Trim(grd.GetGridText(ii, col))

				grid.SetGridCell gridRow, jj, data

				If ii = 1 Then
					width = getHeadColWidth(headNm)
					grid.SetColumnWidth jj, width
				End If

				If headNm = "등락률" Then
					If chkNumericData(data) = True Then
						If CLng(data) > 0 Then
							tColor = 94
						ElseIf CLng(data) < 0 Then
							tColor = 95
						Else
							tColor = 69
						End If

						grid.SetTrgb gridRow, jj, tColor
					End If
				ElseIf headNm = "발행사" Then
					If Left(data, 1) = "+" Then
						data = Mid(data, 2)
						grid.SetGridCell gridRow, jj, data
						tColor = 94
					Else
						tColor = 69
					End If

					grid.SetTrgb gridRow, jj, tColor
				End If
			End If
		End If
	Next
Next

If sendFlag = "Y" Then
	If ii < grid.Rows Then
		For jj = grid.Rows To ii Step -1
			grid.RemoveRow jj - 1
		Next
	End If

	grid.SetFocus
	grid.Index grid.Rows - 1
	grid.Index grid.Rows - 2
	grid.Index grid.Rows - 3
	grid.Index grid.Rows - 4
	grid.Index 0
	grid.Index 0
	grid.Index 0
End If

sendFlag = "N"
SCREEN.Object("parent.btn_send").SetFocus

If Trim(SCREEN.GetMapName(1)) = "IB105000" Then
	If grid.Rows <= 0 Then
		SCREEN.Object("Main.GUIDE").Text = "조회내역이 없습니다"
	Else
		SCREEN.Object("Main.GUIDE").Text = "조회가 완료되었습니다"
	End If
Else
	If grid.Rows <= 0 Then
		SCREEN.Object("parent.mesg").Data = "조회내역이 없습니다"
	Else
		SCREEN.Object("parent.mesg").Data = "조회가 완료되었습니다"
	End If
End If

