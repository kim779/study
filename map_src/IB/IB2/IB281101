Function getHeadColNo(headNm)
	Select Case headNm
		Case "등락률" 	  : getHeadColNo =  7
		Case "거래량" 	  : getHeadColNo =  8
		Case "거래대금"   : getHeadColNo =  9
		Case "이론가" 	  : getHeadColNo = 10
		Case "괴리율" 	  : getHeadColNo = 11
		Case "프리미엄"   : getHeadColNo = 12
		Case "패리티" 	  : getHeadColNo = 13
		Case "기어링" 	  : getHeadColNo = 14
		Case "손익분기율" : getHeadColNo = 15
		Case "자본지지점" : getHeadColNo = 16
		Case "기초자산"   : getHeadColNo = 17
		Case "발행사" 	  : getHeadColNo = 18
		Case "잔존일수"   : getHeadColNo = 19
		Case "손익분기점" : getHeadColNo = 20
		Case "행사가격"   : getHeadColNo = 21
		Case "전환비율"   : getHeadColNo = 22
		Case "델타" 	    : getHeadColNo = 23
		Case "e*기어링"   : getHeadColNo = 24
		Case "틱환산"     : getHeadColNo = 25
		Case "LP보유비율" : getHeadColNo = 26
	End Select
End Function

Function getHeadColWidth(headNm)
	Select Case headNm
		Case "등락률" 	  : getHeadColWidth = 56
		Case "거래량" 	  : getHeadColWidth = 73
		Case "거래대금"   : getHeadColWidth = 97
		Case "이론가" 	  : getHeadColWidth = 54
		Case "괴리율" 	  : getHeadColWidth = 74
		Case "프리미엄"   : getHeadColWidth = 54
		Case "패리티" 	  : getHeadColWidth = 55
		Case "기어링" 	  : getHeadColWidth = 57
		Case "손익분기율" : getHeadColWidth = 64
		Case "자본지지점" : getHeadColWidth = 70
		Case "기초자산"   : getHeadColWidth = 94
		Case "발행사" 	  : getHeadColWidth = 110
		Case "잔존일수"   : getHeadColWidth = 60
		Case "손익분기점" : getHeadColWidth = 69
		Case "행사가격"   : getHeadColWidth = 62
		Case "전환비율"   : getHeadColWidth = 60
		Case "델타" 	    : getHeadColWidth = 70
		Case "e*기어링"   : getHeadColWidth = 60
		Case "틱환산"     : getHeadColWidth = 60
		Case "LP보유비율"     : getHeadColWidth = 70
	End Select
End Function


