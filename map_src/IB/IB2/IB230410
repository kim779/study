RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim xstr, xvalue, xistrue

Sub send_f()
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
End Sub

Sub CalData()
	Dim ii, masu, vol, tMasu, tVol

	tMasu = 0
	tVol = 0
	masu = 0
	vol = 0

	total_ms.Clear
	total_vol.Clear

	For ii=1 To S30000.Rows
		masu = Trim(S30000.GetGridCell(ii, 7))
		vol = Trim(S30000.GetGridCell(ii, 11))

		If masu <> "" Then
			tMasu = tMasu + CCur(masu)
		End If

		If vol <> "" Then
			tVol = tVol + CCur(vol)
		End If
	Next

	'총매수량 총거래량
	total_ms.Data = tMasu
	total_vol.Data = tVol

	'검색 시작일, 검색 종료일
	sdate.Data = Trim(S30000.GetGridCell(S30000.Rows, 2))
	edate.Data = Trim(S30000.GetGridCell(1, 2))

	If Trim(total_ms.Data) <> "" Then
		If CLng(total_ms.Data) > 0 Then
			total_ms.TRgb 94
		ElseIf CLng(total_ms.Data) < 0 Then
			total_ms.TRgb 95
		End If
	End If
End Sub

_AW_ONSEND_AW_
cod2.Data = Trim(SCREEN.Object("parent.1301").Data)

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		cod2.Data = SCREEN.Object("main.1301").Data
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		cod2.Data = "N." & SCREEN.Object("main.1301").Data
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		cod2.Data = "M." & SCREEN.Object("main.1301").Data
	End If
End If

txcd.Data = Trim(SCREEN.Object("parent.TRAD").Data)

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, masu, mado, sum, tColor

For ii = 1 To S30000.Rows
	masu = Trim(S30000.GetGridCell(ii, 5))
	mado = Trim(S30000.GetGridCell(ii, 6))
	sum = 0

	If masu <> "" And mado = "" Then
		sum = masu
	ElseIf masu = "" And mado <> "" Then
		sum = "-" & mado
	End If

	S30000.SetGridCell ii, 7, sum

	If CCur(sum) > 0 Then
		tColor = "94"
	ElseIf CCur(sum) < 0 Then
		tColor = "95"
	End If

	S30000.SetTrgb ii, 7, tColor
Next

Call CalData()

SCREEN.Object("parent.GRID0").SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(30000)
_AW_ONCLICK_AW_
Select Case S30000.HitPos
Case 2
	If GUBN.Data <> "1" Then
		Exit Sub
	End If
	GUBN.Data = "N"
	S30000.Column = 2
	S30000.Row = 1
	SDAY.Data = S30000.Cell
	S30000.Row = S30000.Rows
	EDAY.Data = S30000.Cell
	S30000.SetDataPosition 2
Case 6
	If GUBN.Data <> "1" Then
		Exit Sub
	End If
	GUBN.Data = "N"
	S30000.Column = 2
	S30000.Row = 1
	SDAY.Data = S30000.Cell
	S30000.Row = S30000.Rows
	EDAY.Data = S30000.Cell
	S30000.SetDataPosition 2
Case Else
	Exit Sub
End Select

SCREEN.Send 0
