_AW_ONDECLARE_AW_
Dim counter
Sub OnAlert()
	counter = 0
	resendyn = 0
	'SYSTEM.Trace "real recv"
	For ii=1 To GRID1.Row
		jcode = Trim(GRID1.GetGridCell(ii, 26))
		If jcode = "98" Then
			resendyn = 1
		End If
	Next
	If resendyn = 1 Then
		SCREEN.SetTimer 1, False
	End If
End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
OBJ.Proc "send_f", page.Data

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
counter = counter + 1
If counter <= 10 Then
	'SYSTEM.Trace "counter=["&counter&"]"
	SCREEN.SetTimer 10, False
Else
	counter = 0
	'SYSTEM.Trace "완료"
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
