_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
Dim xcod
If GRID1.HitPos = 3 Then
	xcod = Right(Trim(GRID1.GetGridCell(GRID1.Row, 3)), 6)
'	SYSTEM.Trace xcod
	If Len(xcod) >= 6 Then
		S1301.data = xcod
		If Trim(S1301.data) = "" Then
		    Exit Sub
		End If
		S1301.Trigger "1301", True
		SYSTEM.SetHistory "1301", S1301.DATA
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


