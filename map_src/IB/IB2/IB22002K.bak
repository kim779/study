RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_table()
	Dim ii

	For ii = 9 To 11

		If ii = 9 Then
			If CLng(COMBO0.Data) = 9 Then
				SCREEN.Object("tt8").visible = True
			Else
				SCREEN.Object("tt8").visible = False
			End If
		ElseIf ii = CLng(COMBO0.Data) Then
			SCREEN.Object("tt"&ii).visible = True

		Else
			SCREEN.Object("tt"&ii).visible = False
		End If
	Next
		SCREEN.Proc "parent.change_grid", ""
End Sub

Sub SetComboItems(sItem)
	COMBO0.SetItems sItem
End Sub

Sub OnAlert()
	If gubn.Data = "1" Then

	 	For ii =0 To 11
	 		SCREEN.Object("tt" & ii).SetTableCell 2, SCREEN.Object("t" & ii).GetTableCell(2)
			SCREEN.Object("tt" & ii).SetTableCell 3, SCREEN.Object("t" & ii).GetTableCell(3)
			SCREEN.Object("tt" & ii).SetTableCell 4, SCREEN.Object("t" & ii).GetTableCell(4)

		Next
	Else

	 	For ii =0 To 11
			SCREEN.Object("tt" & ii).SetTableCell 2, SCREEN.Object("t" & ii).GetTableCell(5)
			SCREEN.Object("tt" & ii).SetTableCell 3, SCREEN.Object("t" & ii).GetTableCell(6)
			SCREEN.Object("tt" & ii).SetTableCell 4, SCREEN.Object("t" & ii).GetTableCell(7)
		Next
	End If
End Sub

_AW_ONSEND_AW_
upcd.Data = SCREEN.Object("parent.62303").Data

If SCREEN.Object("parent.F2").checked = True Then		'금액
	gubn.Data = "2"
ElseIf SCREEN.Object("parent.F1").checked = True Then '수량
	gubn.Data = "1"
End If

Select Case SCREEN.Object("parent.62302").Data
Case "02" :	upcd.data="301"
Case "05" : upcd.data="401"
Case "06" : upcd.data="501"
Case "10" : upcd.data="101"		'-- KOSPI 200
End Select

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If gubn.Data = "1" Then

 	For ii =0 To 11
 		SCREEN.Object("tt" & ii).SetTableCell 2, SCREEN.Object("t" & ii).GetTableCell(2)
		SCREEN.Object("tt" & ii).SetTableCell 3, SCREEN.Object("t" & ii).GetTableCell(3)
		SCREEN.Object("tt" & ii).SetTableCell 4, SCREEN.Object("t" & ii).GetTableCell(4)

	Next
Else

 	For ii =0 To 11
		SCREEN.Object("tt" & ii).SetTableCell 2, SCREEN.Object("t" & ii).GetTableCell(5)
		SCREEN.Object("tt" & ii).SetTableCell 3, SCREEN.Object("t" & ii).GetTableCell(6)
		SCREEN.Object("tt" & ii).SetTableCell 4, SCREEN.Object("t" & ii).GetTableCell(7)
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(COMBO0)
_AW_ONCHANGE_AW_
Call Set_table()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



