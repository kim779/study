_AW_ONDECLARE_AW_
Sub Onalert()
	Dim y, m,d, temp,diff

	SYSTEM.Trace " cell : " & SCREEN.Object("main.26500").GetgridCell(1,1)

	If Trim(SCREEN.Object("main.26500").GetgridCell(1,1)) = "" Then
		Exit Sub
	End If

	y = Mid(SCREEN.Object("main.26500").GetgridCell(1,1),1,4)
	m = Mid(SCREEN.Object("main.26500").GetgridCell(1,1),5,2)
	d = Mid(SCREEN.Object("main.26500").GetgridCell(1,1),7,2)
	temp = DateSerial(y, m, d)
	diff = DateDiff("d", Now, temp)

	If diff <> 0 Then
		Exit Sub
	End If

	If S20301.Data = "001" Then
			SCREEN.Object("main.26500").SetGridcell 1, 2, (S26500.GetGridCell(1, 3))
	ElseIf S20301.Data = "201" Then
			SCREEN.Object("main.26500").SetGridcell 1, 3, (S26500.GetGridCell(1, 3))
	ElseIf S20301.Data = "101" Then
			SCREEN.Object("main.26500").SetGridcell 1, 5, (S26500.GetGridCell(1, 3))
	ElseIf S20301.Data = "305" Then
			SCREEN.Object("main.26500").SetGridcell 1, 6, (S26500.GetGridCell(1, 3))
	End If

	SCREEN.Proc "main.CalRealdata", ""
End Sub

