RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("main.GUIDE").Text = ""

'If Len(Trim(SCREEN.Object("parent.zPwd").Data)) < 4 Then
'	MsgBox "비밀번호를 확인하십시오.", , "IBK투자증권"
'	SCREEN.Object("parent.zPwd").SetFocus
'	Exit Sub
'End If

If SCREEN.Object("parent.RADIO0").Checked = True Then
	zRpBnsTp.Data = "2"
ElseIf SCREEN.Object("parent.RADIO1").Checked = True Then
	zRpBnsTp.Data = "1"
Else
	zRpBnsTp.Data = "7"
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod, ii, iday, bef, rat, aft, parent_iday

ecod = Trim(LEDGER.Ecod)
If ecod = "3669" Then
	SCREEN.ClearAll 0, 2
	Exit Sub
End If

If LEDGER.Next = "Y" And ecod <> "0136" Then
	Call send_c()
Else
	parent_iday = Trim(SCREEN.Object("Main.i_lRpDays").Data)
	If Len(parent_iday) > 0 Then
		parent_iday = CInt(parent_iday)
	End If

	' Reformatting & Assign Data to Parent Map
	For ii = GRID0.Rows To 1 Step -1
		iday = Trim(GRID0.GetGridCell(ii, 2))	' 약정일
		bef  = Trim(GRID0.GetGridCell(ii, 3))	' 약정 전 이율
		rat  = Trim(GRID0.GetGridCell(ii, 4))	' 약정    이율
		aft  = Trim(GRID0.GetGridCell(ii, 5))	' 약정 후 이율

		If bef = "" Or rat = "" Or aft = "" Or iday = "" Then
			Exit Sub
		End If



		' 약정일수
		If Len(Trim(iday)) <> "" Then
			If IsNumeric(iday) = True Then
				iday = CInt(iday)
			End If
		End If

		' 약정일수가 0인경우 해당 row는 보여주지 않음 (의미 없는 데이터)
		If iday = 0 Then
			GRID0.RemoveRow ii - 1
		Else
			' Formatting To Grid
			GRID0.SetGridCell ii, 3, FormatNumber(bef * 100, 2)
			GRID0.SetGridCell ii, 4, FormatNumber(rat * 100, 2)
			GRID0.SetGridCell ii, 5, FormatNumber(aft * 100, 2)

			' Default Data shoot To MainMap
			If parent_iday = iday Then
				iday = Trim(GRID0.GetGridCell(ii, 2))	'약정일
				bef  = Trim(GRID0.GetGridCell(ii, 3))	'약정전이율
				rat  = Trim(GRID0.GetGridCell(ii, 4))	'약정이율
				aft  = Trim(GRID0.GetGridCell(ii, 5))	'약정후이율

				SCREEN.Object("parent.cc").data          = rat
				SCREEN.Object("parent.i_before").data    = bef
				SCREEN.Object("parent.i_dRpIntrat").data = rat
				SCREEN.Object("parent.i_after").data     = aft
				SCREEN.Object("parent.i_lRpDays").data   = iday
			End If
		End If
	Next

	SCREEN.Proc "main.Set_Focus", ""
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

If GRID0.Rows < 1 Then
	Exit Sub
End If

Dim bef, rat, aft, iday, val
iday = Trim(GRID0.GetGridCell(GRID0.row, 2))	'약정일
bef = Trim(GRID0.GetGridCell(GRID0.row, 3))		'약정전이율
rat = Trim(GRID0.GetGridCell(GRID0.row, 4))		'약정이율
aft = Trim(GRID0.GetGridCell(GRID0.row, 5))		'약정후이율

If bef = "" Or rat= "" Or aft = "" Or iday = "" Then
	Exit Sub
End If

SCREEN.Object("parent.cc").data = rat
SCREEN.Object("parent.i_before").data = bef
SCREEN.Object("parent.i_dRpIntrat").data = rat
SCREEN.Object("parent.i_after").data = aft
SCREEN.Object("parent.i_lRpDays").data = iday
SCREEN.Object("parent.price").SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(OUTPUT)
_AW_ENDSCRIPT_AW_


}



