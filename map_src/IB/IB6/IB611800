Sub SumGrid()
Dim IntrstTpNm, IntrstAmt, BoaAmt, Ictax, Ihtax, TaxAfAmt
Dim TaxBfIntrstAmt, TaxAfIntrstAmt, RemnDays
Dim gridRows

IntrstAmt = 0
BoaAmt = 0
Ictax = 0
Ihtax = 0
TaxAfAmt = 0
TaxBfIntrstAmt = 0
TaxAfIntrstAmt = 0

For ii = 1 To GRID0.Rows
	If IsNumeric(Trim(GRID0.GetGridCell(ii, 4))) = True Then
		IntrstAmt = IntrstAmt + CLng(Trim(GRID0.GetGridCell(ii, 4)))
	End If

	If IsNumeric(Trim(GRID0.GetGridCell(ii, 5))) = True Then
		BoaAmt = BoaAmt + CLng(Trim(GRID0.GetGridCell(ii, 5)))
	End If

	If IsNumeric(Trim(GRID0.GetGridCell(ii, 6))) = True Then
		Ictax = Ictax + CLng(Trim(GRID0.GetGridCell(ii, 6)))
	End If

	If IsNumeric(Trim(GRID0.GetGridCell(ii, 7))) = True Then
		Ihtax = Ihtax + CLng(Trim(GRID0.GetGridCell(ii, 7)))
	End If

	If IsNumeric(Trim(GRID0.GetGridCell(ii, 8))) = True Then
		TaxAfAmt = TaxAfAmt + CLng(Trim(GRID0.GetGridCell(ii, 8)))
	End If

	If IsNumeric(Trim(GRID0.GetGridCell(ii, 9))) = True Then
		TaxBfIntrstAmt = TaxBfIntrstAmt + CLng(Trim(GRID0.GetGridCell(ii, 9)))
	End If

	If IsNumeric(Trim(GRID0.GetGridCell(ii, 10))) = True Then
		TaxAfIntrstAmt = TaxAfIntrstAmt + CLng(Trim(GRID0.GetGridCell(ii, 10)))
	End If
Next

gridRows = GRID0.Rows + 1
GRID0.InsertRow(-1)

GRID0.SetGridCell gridRows, 3, " 총  합"
GRID0.SetGridCell gridRows, 4, IntrstAmt
GRID0.SetGridCell gridRows, 5, BoaAmt
GRID0.SetGridCell gridRows, 6, Ictax
GRID0.SetGridCell gridRows, 7, Ihtax
GRID0.SetGridCell gridRows, 8, TaxAfAmt
GRID0.SetGridCell gridRows, 9, TaxBfIntrstAmt
GRID0.SetGridCell gridRows, 10, TaxAfIntrstAmt

End Sub

Function chk_input()
	chk_input = False

	If Trim(CKNO.Data) = "" Then
		MsgBox "종목번호를 입력하세요.", , "IBK투자증권"
		CKNO.SetFocus
		Exit Function
	End If


	If Trim(BuyErnrat_.Data) = "0000000" Then
		MsgBox "매수수익률을 입력하세요.", , "IBK투자증권"
		BuyErnrat_.SetFocus
		Exit Function
	End If

	If Trim(TrdTp.Data) <> "1" Then
		If Trim(SellErnrat_.Data) = "0000000" Then
			MsgBox "매도수익률을 입력하세요.", , "IBK투자증권"
			SellErnrat_.SetFocus
			Exit Function
		End If
	End If

	If gubnChk.Checked = True Then
		If Trim(BnsQty.Data) = "000000000000000" Then
			MsgBox "매매수량을 입력하세요.", , "IBK투자증권"
			BnsQty.SetFocus
			Exit Function
		Else
			If CDbl(BnsQty.Data) < 10000 Then
				MsgBox "매매수량은 10000원 이상을 입력하세요.", , "IBK투자증권"
				BnsQty.SetFocus
				Exit Function
			End If
		End If
	Else
		If Trim(BuyAmt_in.Data) = "000000000000000" Then
			MsgBox "매수금액을 입력하세요.", , "IBK투자증권"
			BuyAmt_in.SetFocus
			Exit Function
		End If
	End If

	If Trim(BuyUprc_.Data) = "0000000000" Then
		MsgBox "매수단가를 입력하세요.", , "IBK투자증권"
		BuyUprc_.SetFocus
		Exit Function
	End If

	If Trim(SellUprc_.Data) = "0000000000" Then
		MsgBox "매도단가를 입력하세요.", , "IBK투자증권"
		SellUprc_.SetFocus
		Exit Function
	End If



	If TrdTp.Data <> "1" Then
		If CLng(SellDt.Data) <= CLng(BuyDt.Data) Then
			MsgBox "매도일이 매수일과 같거나 전입니다.", , "IBK투자증권"
			SellDt.SetFocus
			Exit Function
		End If
	End If

	chk_input = True
End Function

