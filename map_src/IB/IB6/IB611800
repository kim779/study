_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	ACNM.Data = AN1A.Name
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	CKNO.SetFocus
End Sub

Sub send_f()
	SCREEN.ClearAll 0,2
	ACNM.Data = Trim(AN1A.Name)

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 수익률 포맷
Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

Sub FormatData()

	If IsNumeric(Trim(CpnRat.Data)) = True Then			'--표면금리
