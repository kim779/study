Sub send_c()
	LEDGER.Fkey = "7"
	GRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub FMNum(row,col,pindex)
	If GRID.GetGridCell(row,col) <> "" Then
		GRID.SetGridCell row,col,FormatNumber(Int(GRID.GetGridCell(row,col)*10^pindex)/10^pindex,pindex)
	End If
End Sub

