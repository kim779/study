RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	inA.Data = "00001"
	QryTp.Data = QryTp_1.Data
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
MgempNo.Data = SYSTEM.UserID

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0015"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod),1) = "0" Then
	If LEDGER.Next = "Y" Then
		send_c()
	End If
Else
	SCREEN.ClearAll 0, 2
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
If CDbl(CvntSrtDt.Data) > CDbl(CvntEndDt.Data) Then
	MsgBox "계약일을 확인하여 주십시오.",0,"IBK투자증권"
Else
	If CDbl(SrtDueDt.Data) > CDbl(EndDueDt.Data) Then
		MsgBox "만기일을 확인하여 주십시오.",0,"IBK투자증권"
	Else
		Call send_f()
	End If
End If
_AW_ONENDSUB_AW_
