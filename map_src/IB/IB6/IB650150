'***************************************************************************
' DESC: 주문확인
'***************************************************************************
Sub BnOrder()
	Dim msg_domino
	SYSTEM.Push "bond_mado_order", ""

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	msg_domino = "o_acno" & vbTab & SCREEN.Object("main.AN1A").Data & vbLf &_
					"o_acnm" & vbTab & SCREEN.Object("main.ACNM").Data & vbLf &_
					"o_hnam" & vbTab & cgname.Data & vbLf &_
					"o_date" & vbTab & ed_date.Data & vbLf &_
					"o_txgb" & vbTab & txgb.Text & vbLf &_
					"o_dygb" & vbTab & dygb.Text & vbLf &_
					"o_dyac" & vbTab & AN20.Data & vbLf &_
					"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
					"o_jprc" & vbTab & ed_jprc.Data & vbLf
	SCREEN.CreateWindow 2, "IB63011A /p99 /d", msg_domino

	If SYSTEM.Pop("bond_mado_order") <> "OK" Then
		Exit Sub
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송
	QueryOption("after")
End Sub

'***************************************************************************
' DESC: 에러체크
'***************************************************************************
Function Error_check()

	Const scr_name = "장내채권 대용"
	SCREEN.Object("main.guide").text = ""
	ed_pswd.Data = SCREEN.Object("main.ed_pswd").Data

	Error_check = False
	If Trim(SCREEN.Object("main.AN1A").Data) = "" Then
		MsgBox "계좌번호를 입력하세요", , scr_name
		SCREEN.Object("main.AN1A").SetFocus
		Exit Function
	End If
	If Trim(SCREEN.Object("main.ed_pswd").Data) = "" Then
		MsgBox "비밀번호를 입력하세요", , scr_name
		SCREEN.Object("main.ed_pswd").SetFocus
		Exit Function
	End If
	If Trim(cgcd.Data) = "" Then
		MsgBox "종목을 입력하세요", , scr_name
		cgcd.SetFocus
		Exit Function
	End If
	If CDbl(ed_jqty.Data) = 0 Then
		MsgBox "수량을 입력하세요", , scr_name
		ed_jqty.SetFocus
		Exit Function
	End If
	If CDbl(ed_jprc.Data) = 0 Then
		MsgBox "단가를 입력하세요", , scr_name
		ed_jprc.SetFocus
		Exit Function
	End If

	Error_check = True
End Function

Sub ChangeCode()
	Dim name
	name = ""

	If Len(Trim(cgcd.Data)) <> 12 Then
		cgcd.Clear
	End If

	name = SCREEN.GetName(105, cgcd.Data, 0)

	If Trim(name) = "" Then
		cgname.Clear
		cgcd.SetFocus
	End If

'	If IsNumeric(Trim(cgcd.Data)) = True Then
'		If Mid(cgcd.Data, 3 ,1) < 4 Then
'			ed_sysj.Data = "1"
'		Else
'			ed_sysj.Data = "0"
'		End If
'	End If

	cgname.Data = name
	ed_code.Data = Trim(cgcd.Data)

	If Trim(SCREEN.Object("main.cgcd").Data) <> Trim(cgcd.Data) Then
		ed_ogno.Clear
		ed_jqty.Data = 0
		ed_jprc.Data = 0

		SCREEN.Object("main.cgcd").Data = Trim(cgcd.Data)
		cgcd.Trigger "cgcd", True
		SCREEN.Proc "main.send_sise", ""
	End If
	SCREEN.Object("main.obj_spin").send
End Sub

'***************************************************************************
' DESC: 주문후 수량 단가 유지
'***************************************************************************
Sub QueryOption(when)
	If when = "after" Then
		If OrdCfg.KeepQty = False Then		'-- 수량유지안함
			ed_jqty.Data = "0"
		End If

		If OrdCfg.KeepPrc = False Then		'-- 단가유지안함
			ed_jprc.Data = "0"
		End If
		Exit Sub
	End If
End Sub

