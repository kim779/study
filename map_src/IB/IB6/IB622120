RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub DoReceive()
	Dim ii, items, acnt, SubAcnt

	For ii = 1 To GRID0.Rows
		If Trim(zAcntNo.Data) = Trim(GRID0.GetGridCell(ii, 5)) Then
			acnt = Trim(GRID0.GetGridCell(ii, 1))

			If Len(acnt) = 14 Then
				SubAcnt = Right(acnt, 3)

				If items = "" Then
					items = "   " & vbTab & "   " & "전체" & vbTab & SubAcnt & SubAcnt
					'items = SubAcnt & vbTab & SubAcnt & SubAcnt
				Else
					items = items & vbTab & SubAcnt & SubAcnt
				End If
			End If
		End If
	Next

	SCREEN.Object("parent.csubb").SetItems items

	If items <> "" Then
		If SYSTEM.ConnectBy = 0 Then
			If SCREEN.GetMapName(1) <> "IB622400" Then
				SCREEN.Proc "parent.send_f", ""
			End If
		Else
			SCREEN.Object("parent.zPwd").SetFocus
		End If
	Else
		SCREEN.Object("parent.csubb").SetFocus
	End If

	' 8729 화면에서 오픈시 "1" 아닐 경우 "0"
	If scnGb.Data = "1" Then
		SCREEN.Proc "main.Link_Account", ""
		scnGb.Data = "0"
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
scnGb.Data = "0"	'8729 화면에서 6223 화면 오픈 구분 Data

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0078"

SCREEN.OnSend = False

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.AN15").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call guide_msg("신탁계좌번호(ex.xxx-70-xxxxxx)를 확인하여 주십시오.")
	SCREEN.Object("parent.AN15").SetFocus
	Exit Sub
End If

zOtptTp1.Data = "1"
zOtptTp2.Data = "2"

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If Left(ecod, 1) = 0 Then
	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		Call DoReceive()
	End If
Else
	Call alert_msg(Trim(LEDGER.Emsg))
End If

_AW_ONENDSUB_AW_
}



