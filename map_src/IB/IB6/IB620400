_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	SCREEN.ClearAll 2, 2
	GUIDE.Text = ""

	If Len(Trim(AN51.Data)) = 11 Then
		ACNM.Data = Trim(AN51.Name)
		zPwd.Data = Trim(AN51.Password)

		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
		End If
	Else
		AN51.SetFocus
	End If
End Sub


Sub SetMmgbScr()
	next_btn.Enable = False
	GUIDE.Text = ""

	If masuRadio.Checked = True Then
		OBJ.SetObject "IB620420"
	Else
		OBJ.SetObject "IB620410"
	End If
End Sub


Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

Sub DoOrder()
	Dim dmsg
	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	dmsg = "o_acno" & vbTab & AN51.Data & vbLf &_
			"o_acnm" & vbTab & ACNM.Data & vbLf &_
			"o_juno" & vbTab & CDbl(lSettNo.Data) & vbLf &_
			"o_gubn" & vbTab & COMBO.Text & vbLf &_
			"o_rpgb" & vbTab & zRpBnsTp.text & vbLf

	SCREEN.CreateWindow 2, "IB620405 /p5 /d", dmsg

	If SYSTEM.Pop("rp_cancel_order") <> "OK" Then
		Exit Sub
	End If

	OBJ.Send		'주문전송
End Sub

Function Error_check()
	Error_check = False
	If Trim(AN51.Data) = "" Then
		MsgBox "계좌번호를 확인하십시오.", , "IBK투자증권"
		AN51.SetFocus
		Exit Function
	End If
	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하십시오.", , "IBK투자증권"
		zPwd.SetFocus
		Exit Function
	End If

	If CDbl(lSettNo.Data) = 0 Then
		MsgBox "매매번호를 확인하십시오.", , "IBK투자증권"
		lSettNo.SetFocus
		Exit Function
	End If

	Error_check = True
End Function

