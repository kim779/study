'NAME: inpot
'DESC: 입력데이터를 송신데이터의 포맷에 마춰주는 함수
'***************************************************************
Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

