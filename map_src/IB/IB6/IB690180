_AW_ONCLICK_AW_
SCREEN.IgnoreChange True

Dim jqty, jprc, ogno, code, name, acno

If SCREEN.GetMapName(1) = "IB105000" Then
	acno = SCREEN.Object("parent.AN18").Data
Else
	acno = SCREEN.Object("parent.AN1A").Data
End If
If Trim(acno) = "" Then
	MsgBox "계좌번호를 확인하세요", , "IBK투자증권"
	Exit Sub
End If
ed_pswd.Data = SCREEN.Object("parent.ed_pswd").Data
If Trim(ed_pswd.data) = "" Then
	SCREEN.Object("parent.ed_pswd").Setfocus
	MsgBox "비밀번호를 확인하세요", , "IBK투자증권"
	Exit Sub
End If

SYSTEM.Push "S_code", ""
SYSTEM.Push "S_jqty", ""
SYSTEM.Push "S_jprc", ""
SYSTEM.Push "S_ogno", ""

SCREEN.CreateWindow 2, "IB100191 /p? /d", "AN1A" & vbTab & acno & vbLf & _
											"pswd" & vbTab & ed_pswd.Data & vbLf

