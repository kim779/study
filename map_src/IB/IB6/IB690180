	SCREEN.CreateWindow 2, "IB999920 /p?", ""
	If SYSTEM.Pop("rtn_OrderConfirm") <> "OK" Then
		chk_OrderConfirm.Checked = True
		Exit Sub
	End If
End If

SCREEN.Object("parent.chk_OrderConfirm").Checked = chk_OrderConfirm.Checked

If chk_OrderConfirm.Checked = True Then
	If SCREEN.CreateObject("info") Then
