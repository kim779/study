Sub Set_option
	Dim jprc, jqty
	'**********************************************************************
	' Main 주문설정 적용
	'**********************************************************************
	If OrdCfg.KeepPrc = True	Then		'주문후 단가저장
		jprc = Trim(ed_jprc.Data)
		If is_numeric(jprc) = True Then
			OrdCfg.Price = CDbl(ed_jprc.Data)
			SCREEN.Object(objnm & ".ed_jprc").data = OrdCfg.Price
		End If
	Else
		SCREEN.Object(objnm & ".ed_jprc").data = ""
	End If

	If OrdCfg.KeepQty = True	Then		'주문후 수량저장
		jqty = Trim(ed_jqty.Data)
		If is_numeric(jqty) = True Then
			OrdCfg.Qty = CDbl(ed_jqty.Data)
			SCREEN.Object(objnm & ".ed_jqty").data = OrdCfg.Qty
		End If
	Else
		SCREEN.Object(objnm & ".ed_jqty").data = ""
	End If
	'**********************************************************************
	'0101화면의 주문설정
	'**********************************************************************
	'주문후 focus 위치
	Select Case SCREEN.Object(objnm & ".OrdCfg").ReadCfg("CursorPos")
		Case 0			'계좌번호
			If Trim(SCREEN.Object("parent.tab_order").text) = "신용매도" Then
				SCREEN.Object("parent.AN11").Setfocus
			Else
				SCREEN.Object("parent.AN1A").Setfocus
			End If
		Case 1			'비밀번호
			SCREEN.Object("parent.ed_pswd").Setfocus
		Case 2			'종목코드
			SCREEN.Object(objnm & ".1301").Setfocus
		Case 3			'수량
			SCREEN.Object(objnm & ".ed_jqty").Setfocus
		Case 3			'단가
			SCREEN.Object(objnm & ".ed_jprc").Setfocus
		Case Else
			If Trim(SCREEN.Object("parent.tab_order").text) = "신용매도" Then
				SCREEN.Object("parent.AN11").Setfocus
			Else
				SCREEN.Object("parent.AN1A").Setfocus
			End If
	End Select
	'**********************************************************************
End Sub

Function GetToday()
	YY = Year(Date)
	MM = Month(Date)
	If Len(MM) = 1 Then
		MM = "0" & MM
	End If
	DD = Day(Date)
	If Len(DD) = 1 Then
		DD = "0" & DD
	End If
	GetToday = YY & MM & DD
End Function

' 숫자를 포멧팅에 맞게 변환
Function t_format(istr, inum, fnum)
	Dim ipos, stmp, tmps, dpos

	tmps = ""
	stmp = ""

	' Dot Position (From Left)
	dpos = InStr(1, istr, ".", 1)

	' 정수 추출
	If dpos = 0 Then	' Dot 미존재
		tmps = String(inum - Len(istr), "0") & Trim(istr)	' 추출한 정수값에 0을 붙여서 inum만큼 채움
	Else				' Dot 존재
		tmps = Left(istr, InStr(1, istr, ".", 1) - 1)		' 입력받은 숫자에서 정수값 추출
		tmps = String(inum - Len(tmps), "0") & Trim(tmps)	' 추출한 정수값에 0을 붙여서 inum만큼 채움
	End If

	' 소숫점 자리 이하 추출
	If (fnum > 0) Then

		' Dot Position (From Right)
		ipos = Len(istr) - InStr(1, istr, ".", 1) + 1

		If dpos = 0 Then										' 소수점 미입력시
			stmp = String(fnum, "0")							' 추출한 소수점 자리값에 0을 붙여서 fnum 만큼 채움
		Else
			stmp = Mid(istr, InStr(1, istr, ".", 1) + 1, ipos)	' 입력받은 숫자에서 소수점 이하값만 추출
			stmp = stmp & String(fnum - Len(stmp), "0")			' 추출한 소수점 자리값에 0을 붙여서 fnum 만큼 채움
		End If

		t_format = Trim(tmps) & "." & Trim(stmp)
	Else
		t_format = Trim(tmps)
	End If


End Function

