Sub Order()
	Dim msg, hogb

	If Len(Trim(EDIT0.data)) < 14 Then
		MsgBox "계좌번호를 확인 하십시오.", , "IBK 투자증권"
		Exit Sub
	End If

	If Len(Trim(IN_2.data)) < 4 Then
		MsgBox "비밀번호를 확인 하십시오.", ,"IBK 투자증권"
		Exit Sub
	End If

	If Len(Trim(fundcode.data)) <> 8 Then
		MsgBox "취소할 펀드를 선택하십시오.", ,"IBK 투자증권"
		Exit Sub
	End If

	msg = "o_acno" & vbTab & lDps.data & vbLf &_
		  "o_code" & vbTab & fundcode.data & vbLf &_
		  "o_hnam" & vbTab & fundname.data & vbLf
	SCREEN.CreateWindow 2, "IB61133A /p5 /d", msg
	If SYSTEM.Pop("6113fund_cncl_order") <> "OK" Then
		SCREEN.OnSend = False
		Exit Sub
	End If
End Sub

