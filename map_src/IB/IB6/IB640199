_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	Call inputdata()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub inputdata()
	Dim ernrat,ernratlen,i
	ernrat=""
	ernratlen=""
	AcntNo.Data = Trim(SCREEN.Object("main.AN1A").data)
	Pwd.Data = Trim(SCREEN.Object("main.zPwd").data)
	IsuNo.Data = Trim(SCREEN.Object("main.IsuNo_1").data)
	BnsQty.Data = Trim(SCREEN.Object("main.BnsQty_1").data)
	BnsBndUprc.Data = Trim(SCREEN.Object("main.BnsBndUprc_1").data)
	ernrat = FormatNumber(Trim(SCREEN.Object("main.BnsBndErnrat_1").data)*100,6)
	ernratlen = Len(ernrat)
	ernratlen = 11 - ernratlen
	For i=1 To ernratlen
		ernrat = "0"&ernrat
	Next
	BnsBndErnrat.Data = ernrat
	BnsBndErnrat__.Data = Trim(SCREEN.Object("main.BnsBndErnrat__").data)
	FundOpAcntNo.Data = Trim(SCREEN.Object("main.FundOpAcntNo_1").data)
	SettDt.Data = Trim(Replace(Date,"-",""))
	BuyDt.Data = Trim(SCREEN.Object("main.BuyDt_1").data)
	BuyBndUprc.Data = Trim(SCREEN.Object("main.BuyBndUprc_1").data)
	DclsrSeqno.Data = Trim(SCREEN.Object("main.DclsrSeqno_1").data)
End Sub

_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = "0" Then
	SCREEN.Object("main.SettNo").data = SettNo.Data
	SCREEN.Object("main.DpsBfbalAmt").data = DpsBfbalAmt.Data
	SCREEN.Object("main.DpsCrbalAmt").data = DpsCrbalAmt.Data
	SCREEN.Object("main.SecBfbalQty").data = SecBfbalQty.Data
	SCREEN.Object("main.SecCrbalQty").data = SecCrbalQty.Data
	SCREEN.Object("main.CmsnAmt").data = CmsnAmt.Data
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



