Function SetAccount()
	Dim grid
	Call GD_ORDER.Clear()
	Set grid = SCREEN.Object("main.GD_ACCNTS")

	If grid.Rows=0 Then
		MsgBox "그룹 혹은 계좌번호를 확인하십시오.", vbOKOnly, "IBK투자증권"
		SetAccount = False
		Exit Function
	End If

	Dim jprc, jqty
	jprc = SCREEN.Object("main.obj_Odr.ed_jprc").Data
	jqty = SCREEN.Object("main.obj_Odr.ed_jqty").Data

	GD_ORDER.SetRows(grid.Rows)
	For i=1 To grid.Rows
		Call GD_ORDER.SetGridCell(i, 1, "1")								' 주문여부
		Call GD_ORDER.SetGridCell(i, 2, Trim(grid.GetGridCell(i,1)))		' 계좌번호
		Call GD_ORDER.SetGridCell(i, 3, Trim(grid.GetGridCell(i,2)))		' 계좌명
		Call GD_ORDER.SetGridCell(i, 4, Trim(grid.GetGridCell(i,3)))		' 비밀번호
		Call GD_ORDER.SetGridCell(i, 5, CLng(Trim(grid.GetGridCell(i,5))))	' 배수
		Call GD_ORDER.SetGridCell(i, 6, CDbl(Trim(grid.GetGridCell(i,4))))	' 비율
		Call GD_ORDER.SetGridCell(i, 7, 0)									' 총평가금액
		Call GD_ORDER.SetGridCell(i, 8, 0)									' 평가금액
		Call GD_ORDER.SetGridCell(i, 9, 0)									' 비중
		Call GD_ORDER.SetGridCell(i, 10, 0)									' 잔고수량
		Call GD_ORDER.SetGridCell(i, 11, "")								' 산정수량
		Call GD_ORDER.SetGridCell(i, 12, "")								' 매매구분명
		Call GD_ORDER.SetGridCell(i, 13, "")								' 호가구분
		Call GD_ORDER.SetGridCell(i, 14, jqty)								' 주문수량
		Call GD_ORDER.SetGridCell(i, 15, jprc)								' 주문단가
		Call GD_ORDER.SetGridCell(i, 16, "")								' 주문번호
		Call GD_ORDER.SetGridCell(i, 17, "")								' 주문결과
		Call GD_ORDER.SetGridCell(i, 18, Trim(grid.GetGridCell(i,6)))		' 암호화비번
	Next
	SetAccount = True
End Function

Sub SetOrderGrid()
	bOrdering = False

	Dim mmgb, hogb, mmgb_nm, grid, jprc

	mmgb = SCREEN.Object("main.tab_order").ID
	jprc = SCREEN.Object("main.obj_Odr.ed_jprc").Data

	If mmgb="1" Then
		mmgb_nm = "-매도"
	ElseIf mmgb="2" Then
		mmgb_nm = "+매수"
	Else
		Exit Sub
	End If

	If Not SetAccount() Then
		Exit Sub
	End If

	For i=1 To GD_ORDER.Rows
		Call GD_ORDER.SetGridCell(i, 12, mmgb_nm)							' 매매구분명
		Call GD_ORDER.SetGridCell(i, 13, hogb)								' 호가구분
		Call GD_ORDER.SetGridCell(i, 15, CLng(jprc))				 		' 주문단가
	Next

	'SCREEN.Proc "OBJ_jango.QueryJango", "parent"
End Sub

Sub EndQueryJango(name)
	bOrdering = False

	Dim grid
	Set grid = SCREEN.Object( "OBJ_jango." & name )
	For ii=1 To grid.Rows
		For jj=1 To GD_ORDER.Rows
			If Len(Trim(GD_ORDER.GetGridCell(jj, 2)))=0 Then
				Exit For
			End If
			If Trim(grid.GetGridCell(ii,1)) = Trim(GD_ORDER.GetGridCell(jj, 2)) Then
				v1 = grid.GetGridCell(ii, 7)	' 평가금액
				v2 = grid.GetGridCell(ii, 8)	' 주식평가금액
				v3 = grid.GetGridCell(ii, 9)	' D+2예수금
				v4 = CCur(v2) + CCur(v3)
				'MsgBox v2 & "," & v3 & "," & v4
				GD_ORDER.SetGridCell jj, 7, v4					' 주식평가금액 + D2예수금 = 총평가금액
				GD_ORDER.SetGridCell jj, 8, CCur(v1)			' 평가금액
				If IsNumeric(v1) = True And CCur(v1)<>0.0 And CCur(v4)<>0.0 Then
					tmp = FormatNumber(CCur(v1)/CCur(v4)*100.0, 4, TristateTrue)
					If Mid(tmp, 1,1)="." Then
						GD_ORDER.SetGridCell jj, 9, "0" & tmp
					Else
						GD_ORDER.SetGridCell jj, 9, tmp
					End If
				Else
					GD_ORDER.SetGridCell jj, 9, "0.0000"
				End If
				GD_ORDER.SetGridCell jj, 10, CCur( grid.GetGridCell(ii, 5) )  ' 잔고수량(체결기준)
				'MsgBox Trim(grid.GetGridCell(ii,1)) & ", " & Trim(GD_ORDER.GetGridCell(jj, 2))
				Exit For
			End If
		Next
	Next
	Call CalcJqty()
End Sub

Sub CalcJqty()
	bOrdering = False

	mmgb = SCREEN.Object("main.tab_order").ID
	If mmgb="1" Then
		Call CalcMadoJqty()
	ElseIf mmgb="2" Then
		Call CalcMasuJqty()
	End If
End Sub

Sub CalcMadoJqty()
	bOrdering = False

	Dim val

	jqty = CLng(SCREEN.Object("main.obj_Odr.ed_jqty").Data)				' 주문수량

	For ii=1 To GD_ORDER.Rows
		If Len(Trim(GD_ORDER.GetGridCell(ii, 2)))=0 Then
			Exit For
		End If

		rate = CCur(GD_ORDER.GetGridCell(ii, 6 ))		' 주문 비율
		jngo = CCur(GD_ORDER.GetGridCell(ii, 10))		' 잔고 수량
		mult = CCur(GD_ORDER.GetGridCell(ii, 5 ))		' 주문 승수
		aamt = CCur(GD_ORDER.GetGridCell(ii, 7))		' 총평가금액
		camt = CCur(GD_ORDER.GetGridCell(ii, 8))		' 평가금액
		crat = CCur(GD_ORDER.GetGridCell(ii, 9))/100.0	' 비중

		hogb = GD_ORDER.GetGridCell(ii, 13)				' 주문(호가)구분
		jprc = GD_ORDER.GetGridCell(ii, 15)				' 주문가격

'		SYSTEM.Trace "val[" & val & "] mult[" & mult & "] jprc[" & jprc & "] jqty[" & jqty & "] rate[" & rate & "]"

		GD_ORDER.SetGridCell ii, 11, jqty
		GD_ORDER.SetGridCell ii, 14, jqty
	Next
End Sub

