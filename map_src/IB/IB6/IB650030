Sub SendOrder(gubn)
	bOrdering = True

	Dim grid, obj, dmsg, gjnm, jidx, jcnt, jqty, jamt, jprc, code
	Dim jmgb,dyac,vonm,etc1,txgb,feee,sycg,sysj,dhbd,unit,addr,cdat,etc2

	jmgb = SCREEN.Object("parent.obj_Odr.ed_jmgb").data
	dyac = SCREEN.Object("parent.obj_Odr.ed_dyac").data
	vonm = SCREEN.Object("parent.obj_Odr.ed_vonm").data
	etc1 = jmgb & dyac & vonm		'기타입력1

	txgb = SCREEN.Object("parent.obj_Odr.ed_txgb").data
	'feee = SCREEN.Object("parent.obj_jumn.ed_feee").data
	feee = "1" '수수료를 적용하도록 기본 세팅함.
	sycg = SCREEN.Object("parent.obj_Odr.ed_sycg").data
	sysj = SCREEN.Object("parent.obj_Odr.ed_sysj").data
	dhbd = SCREEN.Object("parent.obj_Odr.ed_dhbd").data
	unit = SCREEN.Object("parent.obj_Odr.ed_unit").data
	addr = SCREEN.Object("parent.obj_Odr.addr").data
	cdat = SCREEN.Object("parent.obj_Odr.ed_date").data
	etc2 = txgb & feee & sycg & sysj & dhbd & unit & addr & cdat		'기타입력2

	If gubn <> 1 And gubn <> 2 Then ' 매도
		Exit Sub
	End If

	obj = "OBJ_odr"

	Set grid = SCREEN.Object(obj & ".OGRID")

	jidx = 1
	jcnt = 0
	jqty = 0
	jamt = 0
	jprc = SCREEN.Object("main.obj_Odr.ed_jprc").Data
	Call grid.Clear()
	For ii=1 To GD_ORDER.Rows

		If GD_ORDER.GetGridCell(ii, 1)="1" Then
			grid.SetGridCell jidx, 1, 1
			grid.SetGridCell jidx, 2, " "
			grid.SetGridCell jidx, 3, gubn
			grid.SetGridCell jidx, 4, GD_ORDER.GetGridCell(ii, 2)
			grid.SetGridCell jidx, 5, "HEAD"
			code = Trim(SCREEN.Object("main.obj_odr.sycd").Data)
			grid.SetGridCell jidx, 7, code
			grid.SetGridCell jidx, 9, CLng(GD_ORDER.GetGridCell(ii, 14))
			grid.SetGridCell jidx, 10, CLng(GD_ORDER.GetGridCell(ii, 15))
			grid.SetGridCell jidx, 11, "  "
			grid.SetGridCell jidx, 12, " "
			grid.SetGridCell jidx, 13, " "
			grid.SetGridCell jidx, 14, "C"
			grid.SetGridCell jidx, 15, etc1	'기타1
			grid.SetGridCell jidx, 16, etc2	'기타2
			grid.SetGridCell jidx, 17, GD_ORDER.GetGridCell(ii, 18)	'암호화된비번

			jidx = jidx + 1
			jcnt = jcnt + 1
			jqty = jqty + CLng(GD_ORDER.GetGridCell(ii, 14))
			jamt = jamt + ( CLng(GD_ORDER.GetGridCell(ii, 14)) * CLng(GD_ORDER.GetGridCell(ii, 15)) / CLng(10000))

			'SYSTEM.Trace jidx & ", " & jcnt & ", " & jqty & ", " & jamt & ", " & gjnm
		End If
	Next

	dmsg =	""

	If gubn="1" Then
		dmsg =	"o_gpno" & vbTab & SCREEN.Object("main.CB_GROUP").Text & vbLf & _
		"o_hnam" & vbTab & Trim(SCREEN.Object("main.obj_odr.cgname").Data) & vbLf & _
		"o_date" & vbTab & Trim(SCREEN.Object("main.obj_odr.ed_date").Data) & vbLf & _
		"o_txgb" & vbTab & Trim(SCREEN.Object("main.obj_odr.txgb").Data) & vbLf & _
		"o_sycg" & vbTab & Trim(SCREEN.Object("main.obj_odr.sycg").Text) & vbLf & _
		"o_jcnt" & vbTab & jcnt & vbLf & _
		"o_jqty" & vbTab & jqty & vbLf & _
		"o_jamt" & vbTab & jamt & vbLf & _
		"o_pric" & vbTab & jprc

		SCREEN.CreateWindow 2, "IB650013 /S /p99 /d", dmsg
	ElseIf gubn="2" Then
		dmsg =	"o_gpno" & vbTab & SCREEN.Object("main.CB_GROUP").Text & vbLf & _
		"o_hnam" & vbTab & Trim(SCREEN.Object("main.obj_odr.cgname").Data) & vbLf & _
		"o_sycg" & vbTab & Trim(SCREEN.Object("main.obj_odr.sycg").Text) & vbLf & _
		"o_jcnt" & vbTab & jcnt & vbLf & _
		"o_jqty" & vbTab & jqty & vbLf & _
		"o_jamt" & vbTab & jamt & vbLf & _
		"o_pric" & vbTab & jprc

		SCREEN.CreateWindow 2, "IB650014 /S /p99 /d", dmsg
	Else
		Exit Sub
	End If

	If SYSTEM.Pop("stock_bond_order") <> "OK" Then
		Exit Sub
	End If
	SCREEN.Object(obj & ".NREC").Data = jcnt

	SCREEN.Proc obj & ".SendOrder", ""
End Sub

Sub RecvOrder()

	SYSTEM.Trace "RecvOrder"
	Dim obj

	obj = "OBJ_odr"

	Dim grid, jmno
	Set grid = SCREEN.Object( obj & ".OGRID")

	For ii=1 To grid.Rows
		For jj=1 To GD_ORDER.Rows
			If	Trim(grid.GetGridCell(ii,4))=Trim(GD_ORDER.GetGridCell(jj,2)) Then 'And Trim(grid.GetGridCell(ii,5))= "UTP1" Then

				jmno = Trim(grid.GetGridCell(ii, 18))
				emsg = Trim(grid.GetGridCell(ii, 20))

				SYSTEM.Trace "jmno[" & jmno & "] emsg[" & emsg & "]"

				If jmno<>"" Then
					jmno = CLng(jmno)
					If jmno<>0 Then
						GD_ORDER.SetGridCell jj, 16, jmno
					End If
				End If
				If Len(Trim(emsg)) > 4 Then
					If CLng(Mid(emsg,1,4))>=1000 Then
						GD_ORDER.SetTRgb jj, 17, 94
						GD_ORDER.SetGridCell jj, 16, ""
					Else
						GD_ORDER.SetTRgb jj, 17, 69
					End If
				End If
				GD_ORDER.SetGridCell jj, 17, emsg
				Exit For
			End If
		Next
	Next

	SCREEN.Proc "main.OBJ_odr.AfterOrder", ""
End Sub

