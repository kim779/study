Sub Set_account()
	SCREEN.Object("obj_jumn.ed_accn").Data = AN1A.data
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password

	Dim data

	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
	ElseIf Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus
	Else
		SCREEN.Object("obj_jumn.cgcd").SetFocus
	End If
	GUIDE.text = ""

	data = Trim(AN1A.password)
'	SYSTEM.Trace "6501 account : " & AN1A.name & data
	If data <> "" Then
'		SYSTEM.Trace "6501 not Null : " & data
		SCREEN.Proc "obj_account.send_f", ""
	Else
'		SYSTEM.Trace "6501 Null : " & data
		'obj_account.Send
	End If
End Sub



