Sub passPW()
	Dim cnt,accn2,pswd1,accn,mkgb2,ii,code,jprc,jmsu,jmna,mcsu,jmgb,dyac
	Dim vonm,etc1,txgb,feee,sycg,sysj,dhbd,unit,addr,cdat,etc2,s_data
	SYSTEM.push "bondpush", SCREEN.GetMapName(1)
	cnt = 0
	accn2 = Mid(AN1A.data, 1, 8)
	pswd1 = ed_pswd.Data
	accn = AN1A.data										'계좌번호
	mkgb2 = ""
	If Odrgubn = 1 Then
		For ii = 1 To SCREEN.Object("obj_account.grid").rows
			If SCREEN.Object("obj_account.grid").GetGridCell(ii ,1) = 1 Then
				cnt = cnt + 1
			    code = SCREEN.Object("obj_account.grid").GetGridCell(ii, 8)   		'종목코드
				jprc = SCREEN.Object("obj_account.grid").GetGridCell(ii, 25)			'주문가격(or 정정가격)
				jmsu = SCREEN.Object("obj_account.grid").GetGridCell(ii, 23)			'주문수량
				jmnu = SCREEN.Object("obj_account.grid").GetGridCell(ii, 6)			'주문번호
				jmna = SCREEN.Object("obj_account.grid").GetGridCell(ii, 9)			'종목명
				mcsu = SCREEN.Object("obj_account.grid").GetGridCell(ii, 21)			'미체결량
				jmgb = SCREEN.Object("parent.obj_jumn.ed_jmgb").data
				dyac = SCREEN.Object("parent.obj_jumn.ed_dyac").data
				vonm = SCREEN.Object("parent.obj_jumn.ed_vonm").data
				etc1 = jmgb & dyac & vonm		'기타입력1

				txgb = SCREEN.Object("parent.obj_jumn.ed_txgb").data
				'feee = SCREEN.Object("parent.obj_jumn.ed_feee").data
				feee = "1" '수수료를 적용하도록 기본 세팅함.
				sycg = SCREEN.Object("parent.obj_jumn.ed_sycg").data
				sysj = SCREEN.Object("parent.obj_jumn.ed_sysj").data
				dhbd = SCREEN.Object("parent.obj_jumn.ed_dhbd").data
				unit = SCREEN.Object("parent.obj_jumn.ed_unit").data
				addr = SCREEN.Object("parent.obj_jumn.addr").data
				cdat = SCREEN.Object("parent.obj_jumn.ed_date").data
				etc2 = txgb & feee & sycg & sysj & dhbd & unit & addr & cdat		'기타입력2

				s_data = "#" & s_data
				s_data = etc2 & "|" & s_data					'처리구분	16
				s_data = etc1 & "|" & s_data					'처리구분	15
				s_data = "C" & "|" & s_data					'처리구분	14
				s_data = "2" & "|" & s_data					'모두구분	13
				s_data = "0" & "|" & s_data					'주문조건	12
				s_data = "00" & "|" & s_data				'호가구분	11
				s_data = jprc & "|" & s_data				'주문가격	10
				s_data = mcsu & "|" & s_data				'주문수량(정정, 취소수량)	9
				s_data = jmna & "|" & s_data				'종목명		8
				s_data = code & "|" & s_data				'종목코드	7
				s_data = jmnu & "|" & s_data				'주문번호	6
				s_data = pswd1 & "|" & s_data				'비밀번호	5
				s_data = accn & "|" & s_data				'계좌번호	4
				s_data = "3" & "|" & s_data					'매매구분	3
				s_data = mkgb2 & "|" & s_data				'시장구분	2
				s_data = "1" & "|" & s_data					'주문유형	1
				s_data = "1" & "|" & s_data					'CUD
			End If
		Next
		If cnt > 0 Then
			SCREEN.CreateWindow 3, "IB630199 /p5 /d", "s_data" & vbTab & s_data & vbLf & "acct" & vbTab & AN1A.Data & vbLf & "pswd" & vbTab & pswd1 & vbLf _
																 & "NREC" & vbTab & cnt & vbLf & "ACNM" & vbTab & ACNM.Data
			clear_check()
		End If
	ElseIf Odrgubn = 2 Then
