Function IsCusPrfsmallThanPrdRisk(sCus, sPrdRisk) '789
SYSTEM.Trace "[6202] IsCusPrfsmallThanPrdRisk(고객성향과 상품등급 비교)  sCus = " & sCus

	If sCus = "안정형" Then
		check_char = 1
	ElseIf sCus = "안정추구형" Then
		check_char = 2
	ElseIf sCus = "위험중립형" Then
		check_char = 3
	ElseIf sCus = "적극투자형" Then
		check_char = 4
	ElseIf sCus = "공격투자형" Then
		check_char = 6
	End If

SYSTEM.Trace "[6202] IsCusPrfsmallThanPrdRisk(고객성향과 상품등급 비교) check_char = " & check_char & " |  상품 = " & sPrdRisk

	'RP 낮은 위험  안정형(1)이면
	If check_char < CInt(sPrdRisk) Then
		IsCusPrfsmallThanPrdRisk = True
		 'IsCusPrfsmallThanPrdRisk = False  'test
		Exit Function
	End If
	IsCusPrfsmallThanPrdRisk = False


End Function

