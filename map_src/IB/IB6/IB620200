{


_AW_ONDECLARE_AW_
Dim emsg
Dim PolicyPhase
PolicyPhase = 2

Function P_pswdConfirm(accn, pswd, msg)
	Dim ret, sdata1
	GUIDE.Text = ""
	P_pswdConfirm = False

	If SYSTEM.ConnectBy = "0" Then
		If Len(Trim(accn)) <> 11 Then
			msg = "계좌번호를 확인하여 주십시오."
			MsgBox msg, , "IBK투자증권"
			Exit Function
		End If

		If Len(Trim(pswd)) > 8 Or Len(Trim(pswd)) < 4 Then
			msg = "비밀번호를 확인하여 주십시오."
			MsgBox msg, , "IBK투자증권"
			Exit Function
		End If
		msg = ""

		sdata = accn&pswd
		ret = SCREEN.ServiceEx("pibopswd", accn&pswd, Len(sdata), 0, 600000)
		If Left(ret,1) <> "1" Then
			msg = Mid(ret,2,99)
			If Trim(msg) = "" Then
				msg = "대기 시간 초과입니다. 결과를 꼭 확인 바랍니다."
			End If

			If InStr(msg, "3669") > 0 Then
				MsgBox msg, , "IBK투자증권"
			End If

			GUIDE.Text = Trim(msg)
			Exit Function
		End If
	End If

	P_pswdConfirm = True
End Function

Sub Set_account()
	price.Enable = False
	SCREEN.ClearAll 0, 2
	SCREEN.SetTimer 5, False

	ACNM.Data = AN51.Name
	zPwd.Data = AN51.Password

	If Len(Trim(AN51.Data)) < 11 Then
		AN51.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If
End Sub



Function Error_check()
