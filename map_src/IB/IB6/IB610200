RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_account()
	ACNM.Data = AN50.Name
	ed_pswd.Data = AN50.Password
	If Trim(AN50.Data) = "" Then
		AN50.SetFocus
		Exit Sub
	End If
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus
		Exit Sub
	End If
	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	zAcntNo.Data = Trim(AN50.Data)
	zPwd.Data = ed_pswd.Data
'SYSTEM.Trace zAcntNo.Data & " | " & zPwd.Data
	GRID0.Clear
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	zAcntNo.Data = Trim(AN50.Data)
	zPwd.Data = ed_pswd.Data
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0100"
Set_account()
If Len(Trim(ed_pswd.Data)) > 0 Then
	send_f()
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim dmsg
If GRID0.HitPos = 3 And GRID0.Column = 1 Then
	dmsg = "f_name" & vbTab & GRID0.GetGridCell(GRID0.row, 2) & vbLf &_
		"f_num" & vbTab & GRID0.GetGridCell(GRID0.row, 3) & vbLf &_
		"f_tran" & vbTab & GRID0.GetGridCell(GRID0.row, 4) & vbLf &_
		"f_com" & vbTab & GRID0.GetGridCell(GRID0.row, 5)
	If Len(Trim(GRID0.GetGridCell(GRID0.row, 3))) > 0 Then
		SCREEN.CreateWindow 2, "IB610201 /p5 /d", dmsg
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN50)
_AW_ONCHANGE_AW_
Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_pswd)
_AW_ONCHANGE_AW_
If Trim(ed_pswd.Data) = "" Then
	SCREEN.OnSend = False
	Exit Sub
End If
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
SCREEN.OnSend = False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


