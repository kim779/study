RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim Today
Today = getCurrDay()

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	zAcntNm.Data = AN55.Name
	zPwd.Data = AN55.Password
	If Trim(AN55.Data) = "" Then
		AN55.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	GRID1.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
