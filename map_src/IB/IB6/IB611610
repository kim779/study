_AW_ONDECLARE_AW_
Option Explicit

Dim Today
Today = Replace(Date, "-", "")

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	zAcntNm.Data = AN50.Name
	zPwd.Data = AN50.Password
	If Trim(AN50.Data) = "" Then
		AN50.SetFocus
		Exit Sub
	End If
	fundcode.Clear
	FundName.text = ""
	OrgMchndIttCode.Clear
	corpname.Text = ""
	If SYSTEM.ConnectBy = "1" Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If
End Sub

'== 연속 조회
Sub send_f()
	LEDGER.Fkey = "C"
	TrxTp.Data = "5"
	answer.Data = ""
	SCREEN.Send 0
End Sub

'==계좌번호, 비밀번호 체크
Function l_CheckInput(ANCT, zPwd)
 	l_CheckInput = False
	If Trim(ANCT.data) = "" Or Len(Trim(ANCT.data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하십시오.")
 		ANCT.Setfocus
 		Exit Function
	End If

	If Len(Trim(zPwd.data)) < 4 Then
		Call alert_msg("비밀번호를 확인하십시오.")
		zPwd.Setfocus
		Exit Function
	End If

	If Trim(fundcode.data) = "" Or Len(Trim(fundcode.data)) < 3 Then
		Call alert_msg("펀드코드를 확인하십시오.")
 		fundcode.Setfocus
 		Exit Function
	End If

	If Len(Trim(OrgMchndIttCode.data)) = 0 Then
		SCREEN.Object("main.guide").text = "이동전 판매사 코드를 입력하여 주십시오."
		OrgMchndIttCode.Setfocus
		Exit Function
	End If

	If Len(Trim(OrgMchndAcntNo.data)) = 0 Then
		SCREEN.Object("main.guide").text = "이동전 판매사 계좌번호를 입력하여 주십시오."
		OrgMchndAcntNo.SetFocus
		Exit Function
	End If

	If Len(Trim(krzcode.data)) = 0 Then
		SCREEN.Object("main.guide").text = "펀드코드를 입력하여 주십시오."
		krzcode.SetFocus
		Exit Function
	End If

	If Len(Trim(MovePrslUnitQty.data)) = 0 Then
		SCREEN.Object("main.guide").text = "신청좌수를 입력하여 주십시오."
		MovePrslUnitQty.SetFocus
		Exit Function
	End If

	l_CheckInput = True
End Function

Sub list()
	obj.Send
End Sub

