Sub Order()
	Dim msg, hogb

	If Len(Trim(zAcntNo.data)) <> 14 Then
		MsgBox "매수 계좌번호를 확인하여 주십시오.", ,"IBK 투자증권"
		Exit Sub
	End If

	If Len(Trim(zIvstfndCode.data)) <> 8 Then
		MsgBox "주문할 펀드를 선택하십시오.", ,"IBK 투자증권"
		Exit Sub
	End If

	If Trim(lBuyOrdAmt.data) = "" Then
		MsgBox "주문금액을 확인하여 주십시오.", ,"IBK 투자증권"
		Exit Sub
	End If

	If Trim(zOrdAmtTp.Data) = "0" Then
		hogb = "일부"
	Else
		hogb = "전액"
	End If

	msg = "o_acno" & vbTab & zAcntNo.data & vbLf &_
		  "o_code" & vbTab & zIvstfndCode.data & vbLf &_
		  "o_hnam" & vbTab & fundname.data & vbLf &_
		  "o_hogb" & vbTab & hogb & vbLf &_
		  "o_jprc" & vbTab & lBuyOrdAmt.data & vbLf
	SCREEN.CreateWindow 2, "IB61131A /p5 /d", msg
	If SYSTEM.Pop("6113fund_masu_order") <> "OK" Then
		SCREEN.OnSend = False
		Exit Sub
	End If
End Sub

