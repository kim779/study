'********************************************************
'수수료 징수기간
'********************************************************
Function feeGubn(value)
	Select Case value
		Case "10" : feeGubn = "주"
		Case "20" : feeGubn = "월"
		Case "30" : feeGubn = "분기"
		Case "40" : feeGubn = "반기"
		Case "50" : feeGubn = "년"
		Case "90" : feeGubn = "만기"
	End Select
End Function


'********************************************************
'자산유형
'********************************************************
Function assetTp()
	Select Case tab_subHangmok.ID
		Case 0 : assetTp = "100000"
		Case 1 : assetTp = "101001"
		Case 2 : assetTp = "101002"
		Case 3 : assetTp = "101100"
		Case 4 : assetTp = "200000"
		Case 5 : assetTp = "300000"
		Case 6 : assetTp = "700000"
		Case 7 : assetTp = "900000"
	End Select
End Function


Sub SetSubHangmokTab()
	If tab_subHangmok.ID = 0 Then
		viewGrid.SetColumnVisible 7, True
		viewGrid.SetColumnVisible 9, True

		viewGrid.SetColumnWidth 4, 73
		viewGrid.SetColumnWidth 5, 67
		viewGrid.SetColumnWidth 6, 67
		viewGrid.SetColumnWidth 7, 61
		viewGrid.SetColumnWidth 9, 80
		viewGrid.SetColumnWidth 11, 63
	Else
		viewGrid.SetColumnVisible 7, False
		viewGrid.SetColumnVisible 9, False

		viewGrid.SetColumnWidth 4, 91
		viewGrid.SetColumnWidth 5, 109
		viewGrid.SetColumnWidth 6, 120
		viewGrid.SetColumnWidth 7, 0
		viewGrid.SetColumnWidth 9, 0
		viewGrid.SetColumnWidth 11, 95
	End If

	viewGrid.SetColumnWidth 1, 68
	viewGrid.SetColumnWidth 2, 80
	viewGrid.SetColumnWidth 3, 130
	viewGrid.SetColumnWidth 8, 91
	viewGrid.SetColumnWidth 10, 91

	If tab_subHangmok.ID = 1 Then
		viewGrid.SetHead 8, "평균금액"
	Else
		viewGrid.SetHead 8, "평가금액"
	End If

	If tab_subHangmok.ID = 7 Then
		viewGrid.SetHead 5, "취득가격/수수료율"
		viewGrid.SetHead 6, "평가가격/매매수익율"
	Else
		viewGrid.SetHead 5, "취득가격"
		viewGrid.SetHead 6, "평가가격"
	End If
End Sub


Sub cpData()
	Dim ii, jmtp, jmcd, jmnm, holdQty, chgPrc, EvalPrc, ernRat, EvalAmt, wghtRat, EvalPnl, rmk, tabGb
	tabGb = assetTp()

	For ii = 1 To GRID0.Rows
		If tabGb = Trim(GRID0.GetGridCell(ii, 3)) Then	'자산유형코드
			jmtp    = Trim(GRID0.GetGridCell(ii, 7))	'종목유형명
			jmcd    = Trim(GRID0.GetGridCell(ii, 6))	'종목코드
			jmnm    = Trim(GRID0.GetGridCell(ii, 4))	'종목명
			holdQty = Trim(GRID0.GetGridCell(ii, 1))	'보유수량
			chgPrc  = Trim(GRID0.GetGridCell(ii, 8))	'취득가격
			EvalPrc = Trim(GRID0.GetGridCell(ii, 9))	'평가가격
			ernRat  = Trim(GRID0.GetGridCell(ii, 11))   '수익률
			EvalAmt = Trim(GRID0.GetGridCell(ii, 10))	'평가금액
			EvalPnl = Trim(GRID0.GetGridCell(ii, 12))	'평가손익
			rmk     = Trim(GRID0.GetGridCell(ii, 2))	'비고

			If Is_numeric(EvalAmt) = True And Is_numeric(zTotDpsastEvalAmt.Data) = True Then
				wghtRat = (EvalAmt / zTotDpsastEvalAmt.Data) * 100
				wghtRat = Int(wghtRat * 10) / 10
			Else
				wghtRat = 0
			End If

			viewGrid.InsertRow -1
			viewGrid.SetGridCell viewGrid.Rows, 1, jmtp


			If jmcd <> "000000000000" Then
				viewGrid.SetGridCell viewGrid.Rows, 2, jmcd
			End If

			viewGrid.SetGridCell viewGrid.Rows, 3, jmnm
			viewGrid.SetGridCell viewGrid.Rows, 4, holdQty

			If chkNumericData(chgPrc) = True Then
				viewGrid.SetGridCell viewGrid.Rows, 5, FormatNumber(chgPrc, 0)
			End If

			If chkNumericData(EvalPrc) = True Then
				viewGrid.SetGridCell viewGrid.Rows, 6, FormatNumber(EvalPrc, 0)
			End If

			If chkNumericData(ernRat) = True Then
				viewGrid.SetGridCell viewGrid.Rows, 7, FormatNumber(ernRat, 2)	'수익률
			End If

			If ernRat > 0 Then
				viewGrid.SetTrgb viewGrid.Rows, 7, 94
			End If

			viewGrid.SetGridCell viewGrid.Rows, 8, EvalAmt
			viewGrid.SetGridCell viewGrid.Rows, 9, FormatNumber(wghtRat, 1)
			viewGrid.SetGridCell viewGrid.Rows, 10, EvalPnl
			viewGrid.SetGridCell viewGrid.Rows, 11, rmk
		End If
	Next
End Sub

