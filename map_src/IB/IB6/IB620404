RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos
gridPos = 1

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("main.AN51").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("main.AN51").SetFocus
	Exit Sub
End If

'If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy = 0 Then
'	zPwd.Data = "9999"
'Else
'	zPwd.Data = Trim(SCREEN.Object("main.zPwd").Data)
'End If

zPwd.Data = Trim(SCREEN.Object("main.zPwd").Data)

If Len(Trim(zPwd.Data)) < 4 Then
	Call alert_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("main.zPwd").SetFocus
	Exit Sub
End If

'zBnsTp.Data = SCREEN.Object("main.zRpBnsTp").Data
zBnsTp.Data = 2

SCREEN.onsend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	SCREEN.Object("main.next_btn").Enable = True
Else
	SCREEN.Object("main.next_btn").Enable = False
End If

Dim ecod
ecod = Trim(LEDGER.Ecod)

If Is_numeric(ecod) = False Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
	Dim ii , val, rpGubn, gridRpGubn
	rpGubn = Trim(SCREEN.Object("main.zRpBnsTp").Text)

	For ii = GRID0.Rows To gridPos Step -1
		gridRpGubn = Trim(GRID0.GetGridCell(ii, 3))
		val = 0

		If rpGubn <> "" Then
			If rpGubn = gridRpGubn Then

				val = Trim(GRID0.GetGridCell (ii, 4))

				If Is_numeric(val) = True Then
					val = FormatNumber(CDbl(val) * 100, 2)
				Else
					val = 0
				End If

				GRID0.SetGridCell ii, 5, val
			Else
				GRID0.RemoveRow ii - 1
			End If
		End If
	Next

	gridPos = GRID0.Rows + 1
Else

End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(lTrdNo)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(OUTPUT1)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim OrderNo, rpMmgb
OrderNo = Trim(GRID0.GetGridCell(GRID0.row,1))
rpMmgb = Trim(GRID0.GetGridCell(GRID0.Row, 2))

If OrderNo = "" Or rpMmgb = "" Then
	Exit Sub
End If

SCREEN.Object("parent.i_SettNo").data = OrderNo
SCREEN.Object("parent.zRpBnsTp").Data = rpMmgb
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


