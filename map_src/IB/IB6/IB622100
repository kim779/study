'==계좌번호, 비밀번호 체크
Function L_CheckInput(zPwd)
 	L_CheckInput = False

 	If Len(Trim(AN15.data)) <> 11 Then
		Call alert_msg("신탁계좌번호(ex.xxx-70-xxxxxx)를 확인하여 주십시오.")
 		AN15.Setfocus
 		Exit Function
	End If

	If Len(Trim(csubb.Data)) < 3 And csubb.Text <> "전체" Then
		Call alert_msg("서브계좌번호를 확인하여 주십시오.")
 		csubb.Setfocus
 		Exit Function
	End If


	If Len(Trim(zPwd.data)) < 4 Then
		If chkNumericData(sel.Text) = True Then
			If Trim(sel.Text) = "10" Then
				Call alert_msg("비밀번호를 확인하여 주십시오.")
			Else
				Call guide_msg("비밀번호를 확인하여 주십시오.")
			End If
		Else
			Call alert_msg("비밀번호를 확인하여 주십시오.")
		End If

 		zPwd.Setfocus
 		Exit Function
	End If

	L_CheckInput = True
End Function

