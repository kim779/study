'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	GUIDE.Text = ""

	If Len(Trim(AN15.Data)) = 11 Then
		ANCM.Data = Trim(AN15.Name)
		h_acnm.Data = Trim(AN15.Name)
		zPwd.Data = Trim(AN15.Password)
	Else
		AN15.SetFocus
		Exit Sub
	End If

	SCREEN.Proc "obj_getSubAcnt.send_f", ""

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If
End Sub

'== 첫 조회
Sub send_f()
	SrtNo.Data = l_zeropad(SrtNo)
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

