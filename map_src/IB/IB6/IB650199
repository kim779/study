RESOURCE DIVISION
{


_AW_ONSTART_AW_
Dim p1,p2,p3,p4

If SCREEN.CreateObject("Info") Then
  	p1 = INFO.PopData("", "bondoption.ini", "jqty", "chk1")
  	If p1 <> "0" Then
  		chk1.Checked = True
  	Else
  		chk1.Checked = False
  	End If

  	p2 = INFO.PopData("", "bondoption.ini", "jqty", "chk2")
  	If p2 <> "0" Then
  		chk2.Checked = True
  	Else
  		chk2.Checked = False
  	End If

  	p3 = INFO.PopData("", "bondoption.ini", "jprc", "ro1")
  	If p3 <> "0" Then
  		ro1.Checked = True
  	Else
  		ro1.Checked = False
  	End If

  	p4 = INFO.PopData("", "bondoption.ini", "jprc", "ro2")
  	If p4 <> "0" Then
  		ro2.Checked = True
  	Else
  		ro2.Checked = False
  	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
If SCREEN.CreateObject("Info") Then
 	INFO.PushData "", "bondoption.ini", "jqty", "chk1", chk1.Checked
 	INFO.PushData "", "bondoption.ini", "jqty", "chk2", chk2.Checked
 	INFO.PushData "", "bondoption.ini", "jprc", "ro1", ro1.Checked
 	INFO.PushData "", "bondoption.ini", "jprc", "ro2", ro2.Checked
End If

If ro1.Checked = False Then
	SYSTEM.Push "jqty_option","OK"
Else
	SYSTEM.Push "jqty_option","NO"
End If

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



