_AW_ONDECLARE_AW_
Sub Set_account()
	SCREEN.ClearAll 2, 2

	ACNM.Data = AN34.Name

	If Trim(AN34.Data) = "" Or Len(Trim(AN34.Data)) < 11 Then
		AN34.SetFocus
		Exit Sub
	Else
		If Mid(Trim(AN34.Data), 4, 2) = "51" Then
			zRpBnsTp.SetItems "5" & vbTab & "5CMA"		'CMA전용계좌일 경우 RP매매구분 안보이게
			labelzRpBnsTp.Visible = False
			zRpBnsTp.Visible = False
		ElseIf Mid(Trim(AN34.Data), 4, 2) = "10" Or Mid(Trim(AN34.Data), 4, 2) = "52" Then  '위탁계좌나 RP전용계좌일 경우 RP매매구분에 일반과 수시만 표시(수익자유추가)
			Dim items
			items = "0" & vbTab & "0전체" & vbTab &"1일반" & vbTab & "2수시" & vbTab & "7수익자유" '& vbTab
			zRpBnsTp.SetItems items
			labelzRpBnsTp.Visible = True
			zRpBnsTp.Visible = True
'		Else
'			Dim items
'			items = "0" & vbTab & "0전체" & vbTab &"1일반" & vbTab & "2수시" &_
'			              vbTab & "3MMF연계" & vbTab & "4차입MMF연계" & vbTab & "5CMA"
'			zRpBnsTp.SetItems items
'			zRpBnsTp.Visible = True
		End If

		zPwd.Data = AN34.Password

		If SYSTEM.ConnectBy = 1 Then
			If Trim(zPwd.Data) = "" Or Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If
		End If
	End If

	Call send_f()
End Sub

Sub send_f()
	SCREEN.ClearAll 2, 2

	ACNM.Data = Trim(AN34.Name)

	LEDGER.Fkey = "C"
	If SYSTEM.ConnectBy Then
		zCommdaCode.Data = "00"
	Else
		zCommdaCode.Data = "01"
	End If

	SCREEN.Send 0
'	obj.Send
'	SCREEN.Send 2
End Sub


'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

