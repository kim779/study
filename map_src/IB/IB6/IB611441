Dim tmp
For ii = 1 To GRID0.Rows
	GRID3.SetGridCell ii, 1, CDbl(GRID0.GetGridCell(ii,2)) + 1 &"일 미만"
	If GRID0.GetGridCell(ii,7) = "1" Then
		tmp = "이익금 범위(%)"
	ElseIf GRID0.GetGridCell(ii,7) = "2" Then
		tmp = "매매금액 범위(%)"
	End If
	GRID3.SetGridCell ii, 2, tmp
	If Trim(GRID0.GetGridCell(ii, 4)) <> "" Then
		GRID3.SetGridCell ii, 3, FormatPercent(FormatNumber(GRID0.GetGridCell(ii, 4), 2, 0, 0, 0))
	End If
	If Trim(GRID0.GetGridCell(ii, 3)) <> "" Then
		GRID3.SetGridCell ii, 4, FormatNumber(GRID0.GetGridCell(ii, 3), 0, -1, 0, 0)
	End If
Next

