Sub Set_account()
	SCREEN.ClearAll 2, 2

	If Trim(AN12.Data) = "" Or Len(Trim(AN12.Data)) < 11 Then
		AN12.SetFocus
		Exit Sub
	Else
		ACNM.Data = AN12.Name
		zPwd.Data = AN12.Password

		If SYSTEM.ConnectBy = 1 Then
			If Trim(zPwd.Data) = "" Or Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If
		End If
	End If

	Call send_f()
	SCREEN.Proc "obj0.send_f", ""
End Sub

