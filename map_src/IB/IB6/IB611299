_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	zIn.Data = "00001"
	zQryTp.Data = "1"
	LEDGER.Rcnt = "0025"
	zAcntNo.Data = Trim(Replace(SCREEN.Object("parent.AN55").data, "-", ""))
	SYSTEM.Trace zAcntNo.Data
	zPwd.Data = Trim(SCREEN.Object("parent.ACNM").data)
	zBaseDt.Data = Replace(Date, "-", "")
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	For i=0 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,1)) <> "" Then
			For ii=0 To SCREEN.Object("parent.GRID0").Rows
				If	SCREEN.Object("parent.GRID0").GetGridCell(ii,1) <> "" Then
					If CDbl(GRID0.GetGridCell(i,1)) = CDbl(SCREEN.Object("parent.GRID0").GetGridCell(ii,1)) Then
						SCREEN.Object("parent.GRID0").Setgridcell ii, 25, GRID0.GetGridCell(i,22)
						SCREEN.Object("parent.GRID0").Setgridcell ii, 26, GRID0.GetGridCell(i,23)
'						MsgBox GRID0.GetGridCell(i,25)
						If GRID0.GetGridCell(i,25) = "0" Then
							SCREEN.Object("parent.GRID0").Setgridcell ii, 27, "불가능"
						ElseIf GRID0.GetGridCell(i,25) = "1" Then
							SCREEN.Object("parent.GRID0").Setgridcell ii, 27, "가능"
						End If
					End If
				End If
			Next
		End If
	Next
'	SCREEN.SetTimer 10, False
	GUIDE.text = LEDGER.Emsg
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_

send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



