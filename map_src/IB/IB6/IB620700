_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos


'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = Trim(AN34.Name)
	zPwd.Data = Trim(AN34.Password)

	If Len(Trim(AN34.Data)) < 11 Then
		AN34.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 0 Then

	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ANCM.Data = Trim(AN34.Name)
	gridPos = 1
	next_btn.Enable = False

	If SYSTEM.ConnectBy = 1 Then
		SCREEN.Object("OBJECT0.IntaccNo").Data = Trim(AN34.Data)
		SCREEN.Object("OBJECT0.Pwd").Data = Trim(zPwd.Data)
		OBJECT0.Send
	Else
		Call OkSend()
	End If
End Sub


Sub OkSend()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub


'== 첫 조회
Sub send_click()
	Call send_f()
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'==계좌번호, 비밀번호 체크
Function L_CheckInput(zPwd)
 	L_CheckInput = False
 	If Trim(AN34.data) = "" Or Len(Trim(AN34.data)) < 11 Then
		Call alert_msg("계좌번호를 확인하십시오.")
 		AN34.Setfocus
 		Exit Function
	End If

	If Len(Trim(zPwd.data)) = 0 Then
		Call alert_msg("비밀번호를 확인하십시오.")
 		zPwd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zPwd.data)) < 4 Then
			Call alert_msg("비밀번호를 확인하십시오.")
	 		zPwd.Setfocus
	 		Exit Function
		End If
	End If
	L_CheckInput = True
End Function

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

'직원/고객에 따른 비밀번호 컨트롤 설정
Call Check_LoginType(zPwd)

'--------- 고객 로그인시

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
End If

If L_CheckInput(zPwd) = True Then
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, data, result

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

If Trim(LEDGER.Ecod) = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = Trim(AN34.Name)
Else
	For ii = gridPos To GRID1.Rows
		data = Trim(GRID1.GetGridCell(ii, 22))

		If data <> "" Then
			GRID1.SetGridCell ii, 24, "취소"
		End If

		data = Trim(GRID1.GetGridCell(ii, 16))
		result = FormatNumber(data*100, 3)
		GRID1.SetGridCell ii, 16, result

		data = Trim(GRID1.GetGridCell(ii, 17))
		result = FormatNumber(data*100, 3)
		GRID1.SetGridCell ii, 17, result

		data = Trim(GRID1.GetGridCell(ii, 18))
		result = FormatNumber(data*100, 3)
		GRID1.SetGridCell ii, 18, result

		data = Trim(GRID1.GetGridCell(ii, 8))
		result = FormatNumber(data, 2)
		GRID1.SetGridCell ii, 8, result
	Next

	gridPos = ii
End If

