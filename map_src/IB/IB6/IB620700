_AW_SCRIPT_AW_(RADIO1)
_AW_ONCLICK_AW_
Dim Day1, Day2, mm, dd

Day2 = CDate(QryEndDt.text)

Day1 = DateAdd("m", -1, Day2)

If Month(Day1) < 10 Then
	mm = "0" & Month(Day1)
Else
	mm = Month(Day1)
End If

If Day(Day1) < 10 Then
	dd = "0" & Day(Day1)
Else
	dd = Day(Day1)
End If

QrySrtDt.data = Year(Day1) & mm & dd

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


