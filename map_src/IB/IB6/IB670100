'***************************************************************************
' DESC: 계좌설
'***************************************************************************
Sub Set_account()
	SCREEN.Object("obj_jumn.ed_accn").Data = AN1A.data
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
	ElseIf Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus
	Else
		SCREEN.Object("obj_jumn.jscd").SetFocus
	End If
	GUIDE.text = ""
	If Trim(ed_pswd.Data) <> "" Then
		obj_account.Send
	End If
End Sub

Sub order_tab_change()
	Select Case tab_order.ID
		Case "1" : obj_jumn.SetObject("IB670110")
'			If tab_account.ID = "5" Then
'				SCREEN.proc "obj_account.clear", ""
'			End If
		Case "2" : obj_jumn.SetObject("IB670120")

			If tab_account.ID = "5" Then
			'	SCREEN.proc "obj_account.clear", ""
				If SCREEN.Object("obj_account.radio0").checked = True Then
					SCREEN.Object("obj_account.panel38").visible = True
				End If
			End If

		Case "3" : obj_jumn.SetObject("IB670130")
		Case "4" : obj_jumn.SetObject("IB670140")
		Case "5" : obj_jumn.SetObject("IB670150")
	End Select

	If tab_order.ID = 3 Or tab_order.ID = 4 Then
		SCREEN.Object("obj_jumn.ed_ogno").SetFocus
	Else
		SCREEN.Object("obj_jumn.jscd").SetFocus
	End If
End Sub

Sub sise_tab_change()
	Select Case tab_sise.ID
		Case "1" : obj_hoga.SetObject("IB670171")
		Case "2" : obj_hoga.SetObject("IB670172")
		Case "3" : obj_hoga.SetObject("IB670173")
		Case "4" : obj_hoga.SetObject("IB670174")
		Case "5" : obj_hoga.SetObject("IB670175")
	End Select
	obj_hoga.Send
End Sub

Sub send_sise(gubn)
	obj_sise.ClearAll 2
	obj_hoga.ClearAll 2
	obj_sise.Send
	obj_hoga.Send
	If gubn = "2" Then
		jgbn.Data = "2"
	Else
		jgbn.Data = "1"
	End If
End Sub

'***************************************************************************
' DESC: 호가가격 Setting
'***************************************************************************
Sub Set_Odrjprc(jprc)
	If  tab_order.ID <> 5 And SCREEN.Object("obj_jumn.ed_jprc").Enable = True Then
		SCREEN.Object("obj_jumn.ed_jprc").Data = jprc
		If tab_account.ID = 5 Then
			SCREEN.Object("obj_account.ordprc").data = jprc
		End If
	End If
End Sub

Sub resend()
	If tab_account.ID = 1 Or tab_account.ID = 2 Or tab_account.ID = 4 Then
		obj_account.Proc "send_f", ""
	End If
End Sub


