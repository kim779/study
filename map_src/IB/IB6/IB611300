_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj.ClearAll 2
	SCREEN.Proc "obj.cls", ""
	GUIDE.Text = ""
	ANCM.Data = AN50.Name
	h_acnm.Data = AN50.Name
	zPwd.Data = AN50.Password

	If AN50.IsAccAgent("", 5) Then '해당계좌가 금융상품매매대리인(5)인지 확인하고 맞으면 메세지 박스
		agentchk.Data = 1
	Else
		agentchk.Data = 0
	End If

	If Trim(AN50.Data) = "" Or Len(Trim(AN50.Data)) < 11 Then
		AN50.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" Or Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If
End Sub

Sub INFO_send()
	SCREEN.Object("obj.obj0").send
End Sub

