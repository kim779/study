RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_account()
	ACNM.Data = AN50.name
	ed_pswd.Data = AN50.Password
	GUIDE.Text = " "
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus
	End If
End Sub

Sub FOrder()
	Dim Omsg, tt
	Dim jnam, gb
	tt = Date

	If Len(Trim(AN50.Data)) <= 0 Then
		MsgBox "계좌 번호를 입력해주세요"
		Exit Sub
	End If

	If Len(Trim(ed_pswd.Data)) <= 0 Then
		MsgBox "비밀번호를 입력해주세요"
		Exit Sub
	End If

	If JY1.Checked = True Then
		jnam = "임의식"
	ElseIf JY2.Checked = True Then
		jnam = "거치식"
	ElseIf JY3.Checked = True Then
		jnam = "적립식"
	End If

	If JB1.Checked = True Then
		gb = "자유적립식"
	ElseIf JB2.Checked = True Then
		gb = "정액적립식"
	End If


	Omsg = "f1" & vbTab & f_name.Data  & vbLf &_
	"f2" & vbTab & f_tran.Data & vbLf &_
	"f3" & vbTab & tt & vbLf &_
	"f4" & vbTab & jnam  & vbLf &_
	"f5" & vbTab & gprc.Data & vbLf &_
	"f6" & vbTab & f_com.Data & vbLf &_
	"f7" & vbTab & Mid(nyear.Data, 4, 2) & vbLf &_
	"f8" & vbTab & gb & vbLf &_
	"f9" & vbTab & nday.Data

	SCREEN.CreateWindow 2, "IB610203 /p5 /d", Omsg

	If SYSTEM.Pop("fund_order") <> "OK" Then
		Exit Sub
	End If

	FD_OBJ.Send
End Sub

Sub Set_OrPrc()

	zHirnkAcntNo.Data = AN50.Data
	zAcntPwd.Data = ed_pswd.Data
	zIvstfndCode.Data = f_num.Data
	If JY1.Checked = True Then
		zPayMthdCode.Data = "01"
	ElseIf JY2.Checked = True Then
		zPayMthdCode.Data = "02"
	Else
		If JB1.Checked = True Then
			zPayMthdCode.Data = "04"
		Else
			zPayMthdCode.Data = "03"
		End If
	End If

	If nyear.Enable = True Then
		lCvntTermMthQty.Data = nyear.Data * 12
	End If

	If nday.Enable = True Then
		zMthPayDt.Data = nday.Data
	End If

	lPayUnitAmt.Data = gprc.Data
End Sub

_AW_ONSTART_AW_
SYSTEM.Push "fund_order", "NO"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
Set_OrPrc()
FOrder()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN50)
_AW_ONCHANGE_AW_
Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_pswd)
_AW_ONCHANGE_AW_
If Trim(ed_pswd.Data) = "" Then
	Exit Sub
End If
SCREEN.Proc "main.all_account", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(JY1)
_AW_ONCLICK_AW_
Set_Option()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



