	Dim rat,bef,aft

	rat = Trim(O_rat.Data)
	bef = Trim(O_bef.data)
	aft = Trim(O_aft.data)

	If rat = "" Or bef = "" Or aft = "" Then
		Exit Sub
	End If

	O_rat.Data = FormatNumber(Trim(O_rat.data) * 100, 2)
	O_bef.Data = FormatNumber(Trim(O_bef.data) * 100, 2)
	O_aft.Data = FormatNumber(Trim(O_aft.data) * 100, 2)

	SCREEN.Proc "OBJ.send_f", ""

	If IsBnkAccnType(zAcntNo) = True Then
		SCREEN.Proc "obj_cancelMoney.send_f", ""
	End If
Else
	Call alert_msg(LEDGER.Emsg)
End If

