_AW_ONDECLARE_AW_
Option Explicit

Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

Sub send_obj()
	OBJ.send
End Sub

Sub send_o()
	SCREEN.ClearAll 0, 2

	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub DoOrder()
	SYSTEM.Push "rp_BuyOrder_cancel", ""

	zAcntNo.Data = Trim(SCREEN.Object("parent.AN51").Data)

	If Len(Trim(zAcntNo.Data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하여 주십시오.")
		SCREEN.Object("parent.AN51").SetFocus
		Exit Sub
	End If

	zpwd.Data = Trim(SCREEN.Object("parent.zpwd").Data)

	If Len(Trim(zpwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		SCREEN.Object("parent.zpwd").SetFocus
		Exit Sub
	End If

	If is_numeric(i_SettNo.Data) = False Then
		MsgBox "취소할 매매내역을 선택하여 주십시오.", , "IBK투자증권"
		Exit Sub
	End If

	SYSTEM.Push "rp_order_cancel", "No"

	Dim dmsg
	dmsg = "o_juno" & vbTab & CDbl(i_SettNo.Data) & vbLf & _
		   "o_acno" & vbTab & Trim(zAcntNo.Data) & vbLf & _
		   "o_acnm" & vbTab & Trim(SCREEN.Object("main.ACNM").Data) & vbLf & _
		   "o_gubn" & vbTab & "매수" & vbLf & _
		   "o_rpgb"	& vbTab & Trim(SCREEN.Object("main.zRpBnsTp").Text) & vbLf


	SCREEN.CreateWindow 2, "IB620405 /t /p5 /d", dmsg

	If Trim(SYSTEM.Pop("rp_order_cancel")) <> "OK" Then
		Exit Sub
	End If

	Call send_o()
End Sub

