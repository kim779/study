_AW_ONDECLARE_AW_
Dim Mydata

Function data_split()
	Mydata = Split(ReadFile, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), ";", -1, 1)							' 한 레코드를 개체별로 자르는중..

		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(0))				' 원주문
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))				' 종목코드
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))				' 종목명
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))				' 주문수량
		GRID.SetGridCell NREC.Data - ii, 5,Trim(Mydata(ii)(4))				' 주문단가
		GRID.SetGridCell NREC.Data - ii, 6,Trim(Mydata(ii)(5))				' 주문단가
		GRID.SetGridCell NREC.Data - ii, 7,Trim(Mydata(ii)(6))				' 주문단가
		GRID.SetGridCell NREC.Data - ii, 8,Trim(Mydata(ii)(7))				' 주문단가
		GRID.SetGridCell NREC.Data - ii, 9,Trim(Mydata(ii)(8))				' 주문단가
		GRID.SetGridCell NREC.Data - ii, 10,1000*Trim(Mydata(ii)(9))		' 주문단가
		GRID.SetGridCell NREC.Data - ii, 11,Trim(Mydata(ii)(10))			' 주문단가
		GRID.SetGridCell NREC.Data - ii, 12,Trim(Mydata(ii)(11))			' 주문단가
		GRID.SetGridCell NREC.Data - ii, 13,Trim(Mydata(ii)(12))			' 주문단가
		GRID.SetGridCell NREC.Data - ii, 14,Trim(Mydata(ii)(13))			' 주문단가
		GRID.SetGridCell NREC.Data - ii, 15,Trim(Mydata(ii)(14))			' 주문단가
		GRID.SetGridCell NREC.Data - ii, 16,Trim(Mydata(ii)(15))			' 주문단가
		GRID.SetGridCell NREC.Data - ii, 17,Trim(Mydata(ii)(16))			' 암호화된비번
