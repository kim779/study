Sub send_f()
	SCREEN.ClearAll 0, 2
	SCREEN.Object("main.GUIDE").Text = ""
	LEDGER.Fkey = "C"
	Dim yy, mm, dd
	yy = Left(Date, 4)
	mm = Mid (Date,6,2)
	dd = Mid (Date,9,2)

	zOrdDt.Data = yy & mm & dd

	If (SYSTEM.ConnectBy) Then
		zCommdaCode.data = "00"
	Else
		zCommdaCode.Data = "01"
	End If

	Dim sPass
	sPass = Trim(SCREEN.Object("main.ed_pswd").Data)
	If CLng(SYSTEM.ConnectBy) = 0 Then
		If sPass = "" Then
			sPass = "9999"
		End If
	End If

	PASS.Data = sPass
	If CheckInput(SCREEN.Object("main.AN1A"), PASS) = False Then
		Exit Sub
	End If
	AN1A.Data = Trim(SCREEN.Object("main.AN1A").Data)
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub


'-------------------------------------------------------------- 일괄정정 추가
Function chkcnt()
	Dim gcnt
	gcnt = 0

	chkcnt = False
	For ii = 1 To GRID.Rows
		If Trim(GRID.GetGridCell(ii, 1)) = 1 Then
			If Trim(GRID.GetGridCell(ii, 21)) <> "" Then
				gcnt = gcnt + 1
			Else
				GRID.SetGridCell ii,1, 0
			End If
		End If
	Next

	If gcnt > 0 Then
		chkcnt = True
	End If
End Function

Sub all_Check(Flag)
	For ii = 1 To GRID.Rows
		If Trim(GRID.GetGridCell (ii, 21)) <> "" Then
			GRID.SetGridCell ii, 1, Flag
		End If
	Next
End Sub

