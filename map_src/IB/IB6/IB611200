Sub Set_account()
	SCREEN.ClearAll 0, 2

	If SCREEN.GetMapName(1) = "IB170930" Then
		'IB170902(1709의 전체탭
		If SCREEN.Object("parent.gubn").Data = "1" Then

			AN55.data = SCREEN.Object("main.accn").data
			ACNM.Data = SCREEN.Object("main.acnm").data
			HNAM.Data = ACNM.Data
			SCREEN.Object("parent.gubn").Data = "2"
			Exit Sub
		Else
			ACNM.Data = AN55.Name
			HNAM.Data = ACNM.Data
			zPwd.Data = AN55.Password
			If Trim(AN55.Data) = "" Then
				AN55.SetFocus
				Exit Sub
			End If
		End If
	Else
		ACNM.Data = AN55.Name
		HNAM.Data = ACNM.Data
		zPwd.Data = AN55.Password
		If Trim(AN55.Data) = "" Then
			AN55.SetFocus
			Exit Sub
		End If
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub
