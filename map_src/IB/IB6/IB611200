	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim gubn
		gubn = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "gubnTp"))

		If gubn = "" Then
			gubn = 5
		End If

		zBalIonYn.Data = gubn

		Select Case gubn
			Case "1" : RADIO0.Checked = True
			Case "5" : RADIO1.Checked = True
			Case "2" : RADIO2.Checked = True
		End Select
	End If
End Sub


Sub SelectTp()
	If RADIO0.Checked = True Then
		zBalIonYn.Data = "1"
	ElseIf RADIO1.Checked = True Then
		zBalIonYn.Data = "5"
	Else
		zBalIonYn.Data = "2"
	End If

	Call p_write_ini()
	Call send_f()
End Sub

