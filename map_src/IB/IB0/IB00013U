RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim gcnt
gcnt = 12
Sub ch_cols()
	Dim ii, jj
	Dim strt, gubn, grid
	strt = 2
	gubn = strt
	If SCREEN.Object("parent.r2_2").Checked Then
		gubn = gubn + 3
	End If
	If SCREEN.Object("parent.r1_2").Checked Then
		gubn = gubn + 1
	ElseIf SCREEN.Object("parent.r1_3").Checked Then
		gubn = gubn + 2
	End If
	For ii=1 To gcnt
		For jj=strt To 7
			Set grid = SCREEN.Object("GRID"&(ii-1))
			If gubn = jj Then
				grid.SetColumnVisible jj, True
			Else
				grid.SetColumnVisible jj, False
			End If
		Next
	Next
End Sub

Sub ch_grid(gidx)
	Dim ii, grid
	Set grid = SCREEN.Object("GRID"&gidx)

	If grid.HitPos = 4 Then
		target = grid.GetHeadCell(grid.Column)

		If target ="" Then
			Exit Sub
		End If

		For ii = 8 To 11
			If ii <> 9 Then
				If ii = CLng(target) Then
					SCREEN.Object("GRID"&ii).Visible = True
				Else
					SCREEN.Object("GRID"&ii).Visible = False
				End If
			End If
		Next
	End If
End Sub

_AW_ONSEND_AW_
vagb.Data = 1 '수량
ch_cols()

If UCase(TypeName( SCREEN.Object("Main.cxMarket") )) <> "NOTHING" Then
	If SCREEN.Object("Main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("Main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("Main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

