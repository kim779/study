RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim r_rgb, b_rgb, val, myFILE

myFILE = "userconf.ini"
r_rgb = 209
b_rgb = 222

Sub Load()
	If SCREEN.CreateObject("INFO") Then
		val = Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "FIREWALL"))
		If val="ON" Then
			pn_nprotect.Text = "실행중"
			pn_nprotect.TRgb = b_rgb
		Else
			pn_nprotect.Text = "미실행"
			pn_nprotect.TRgb = r_rgb
		End If
		
		val = Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "KEYSECURE"))
		If val="ON" Then
			pn_kdefense.Text = "실행중"
			pn_kdefense.TRgb = b_rgb
		Else
			pn_kdefense.Text = "미실행"
			pn_kdefense.TRgb = r_rgb
		End If
	End If
End Sub

Sub Save(yesno)
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "YESNO", yesno
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "NOPOPUP", btn_nochk.Checked
	End If
End Sub

_AW_ONSTART_AW_
Call Load()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(btn_yes)
_AW_ONCLICK_AW_
Call Save("YES")
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn_no)
_AW_ONCLICK_AW_
Call Save("NO")
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



