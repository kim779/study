		Bms = Trim(INFO.PopData("", "NOTICEPOPUP.INI", "BTYPE", "MS"))
		Bmt = Trim(INFO.PopData("", "NOTICEPOPUP.INI", "BTYPE", "MT"))


		Cmi = Trim(INFO.PopData("", "NOTICEPOPUP.INI", "CTYPE", "MI"))
		Cms = Trim(INFO.PopData("", "NOTICEPOPUP.INI", "CTYPE", "MS"))
		Cmt = Trim(INFO.PopData("", "NOTICEPOPUP.INI", "CTYPE", "MT"))

		'이미지 셋팅
		'PANEL_bg.text =  Ami
		CONTROL0.SetImageFile Ami
		'PANEL_bg2.text = Bmi
		CONTROL1.SetImageFile Bmi
		'PANEL_bg3.text = Cmi
		CONTROL2.SetImageFile Cmi


		'타입별 화면셋팅
