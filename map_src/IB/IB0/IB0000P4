Sub Set_Ini()
	Dim Today, Check

	If SCREEN.CreateObject("Info") Then

	 	Today = INFO.PopData("", "NOTICECOOKIE.ini", "EVENT_POPUP", "TODAY")

	 	If Today = "0" Then
	 		INFO.PushData "", "NOTICECOOKIE.INI", "EVENT_POPUP", "TODAY", CDAT.Data
			INFO.PushData "", "NOTICECOOKIE.ini", "EVENT_POPUP", "FIRST", "1"
	 	Else
	 		INFO.PushData "", "NOTICECOOKIE.INI", "EVENT_POPUP", "TODAY", CDAT.Data
	 	End If

	 	Check = INFO.PopData("", "NOTICECOOKIE.ini", "EVENT_POPUP", "FIRST")

	 	If Check = "0" Then
	 		CHECK0.Checked = True
			INFO.PushData "", "NOTICECOOKIE.ini", "EVENT_POPUP", "FIRST", "0"
	 	Else
	 		CHECK0.Checked = False
			INFO.PushData "", "NOTICECOOKIE.ini", "EVENT_POPUP", "FIRST", "1"
	 	End If
	End If

End Sub


Sub Set_Ini2(data)
	Dim tp, Ami, Ams, Amt, Bmi, Bms, Bmt, Cmi, Cms, Cmt, ratio, mgleft, mgtop, mgwidth, mgheigt


	If SCREEN.CreateObject("Info") Then


		Ami = Trim(INFO.PopData("", "NOTICEPOPUP.INI", "ATYPE", "MI"))
		Ams = Trim(INFO.PopData("", "NOTICEPOPUP.INI", "ATYPE", "MS"))
		Amt = Trim(INFO.PopData("", "NOTICEPOPUP.INI", "ATYPE", "MT"))


