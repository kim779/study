		lb_screenX.Data = cx_log.GetScreenWidth()
		lb_screenY.Data = cx_log.GetScreenHeight()
		lb_DPIX.Data = cx_log.GetDPIX()
		lb_DPIY.Data = cx_log.GetDPIY()
		lb_MonitorX.Data = cx_log.GetMonitorX_inch()
		lb_MonitorY.Data = cx_log.GetMonitorY_inch()

		If IsNumeric(lb_screenX.Data) = True And IsNumeric(lb_screenY.Data) Then
	 		ratio = Sqr(CDbl(lb_screenX.Data)^2 + CDbl(lb_screenY.Data)^2)'해상도 대각선길이 구함
	 	End If

	 	ratio = ratio * 0.00055 '적당한 비율

		If ratio =< 1 Then
			ratio = 1
		ElseIf ratio > 2 Then
			ratio = 2
		End If

	 	mgleft = 0
	 	mgtop = 0
	 	mgwidth = 280
	 	mgheigt = 336

	 	'PANEL_bg.SetRect    mgleft,          mgtop, mgwidth*ratio + mgleft         , mgheigt*ratio
	 	'PANEL_link1.SetRect mgleft,          mgtop, mgwidth*ratio + mgleft         , mgheigt*ratio
		CONTROL0.SetRect mgleft,          mgtop, mgwidth*ratio + mgleft , mgheigt*ratio-5

	 	'PANEL_bg2.SetRect   mgwidth*ratio,   mgtop, mgwidth*ratio + mgwidth*ratio  , mgheigt*ratio
	 	'PANEL_link2.SetRect mgwidth*ratio,   mgtop, mgwidth*ratio + mgwidth*ratio  , mgheigt*ratio
	 	CONTROL1.SetRect mgwidth*ratio +5,   mgtop, mgwidth*ratio + mgwidth*ratio, mgheigt*ratio-5

	 	'PANEL_bg3.SetRect   mgwidth*ratio*2, mgtop, mgwidth*ratio + mgwidth*ratio*2, mgheigt*ratio
	 	'PANEL_link3.SetRect mgwidth*ratio*2, mgtop, mgwidth*ratio + mgwidth*ratio*2, mgheigt*ratio
	 	CONTROL2.SetRect mgwidth*ratio*2 +5, mgtop, mgwidth*ratio + mgwidth*ratio*2, mgheigt*ratio-5

	 	PANEL1.SetRect 	  mgleft, mgheigt*ratio, 1580*ratio, mgheigt*ratio + 21 *ratio

	 	CHECK0.SetRect    mgwidth*ratio  -138*ratio,  340*ratio, mgwidth*ratio   ,  340*ratio+17
	 	CHECK1.SetRect    mgwidth*ratio*2-138*ratio,  340*ratio, mgwidth*ratio*2 ,  340*ratio+17
	 	CHECK2.SetRect    mgwidth*ratio*3-138*ratio,  340*ratio, mgwidth*ratio*3 ,  340*ratio+17

		Select Case tp
		Case "A"	'1X1 TYPE
			SCREEN.SetSize mgwidth * ratio, 360*ratio
			CHECK1.Visible = False
			CHECK2.Visible = False
'			BUTTON2.Visible = False
'			BUTTON3.Visible = False
'			BUTTON4.Visible = False
'			BUTTON5.Visible = False

		Case "B"	'2X1 TYPE
			SCREEN.SetSize mgwidth * ratio *2, 360*ratio
			CHECK0.Visible = False
			CHECK2.Visible = False
'			BUTTON0.Visible = False
'			BUTTON1.Visible = False
'			BUTTON4.Visible = False
'			BUTTON5.Visible = False

		Case "C"	'3X1 TYPE
			SCREEN.SetSize mgwidth * ratio * 3, 360*ratio
			CHECK0.Visible = False
			CHECK1.Visible = False
'			BUTTON0.Visible = False
'			BUTTON1.Visible = False
'			BUTTON2.Visible = False
'			BUTTON3.Visible = False

		Case Else
			Exit Sub

		End Select


		' 클릭 이벤트
		If Trim(data) <> "" Then

				Select Case data
				Case "A"	'1X1 TYPE
					If Amt = 1 Then '화면
						SCREEN.CreateWindow 1, "IB" & Ams & "00" & "/t/d", ""
					ElseIf Amt = 2 Then 'URL
						SYSTEM.Push "IB980001_URL", Ams
						SCREEN.CreateWindow 1, "IB980001 /p?", ""
					End If


				Case "B"	'2X1 TYPE
					If Bmt = 1 Then '화면
						SCREEN.CreateWindow 1, "IB" & Bms & "00" & "/t/d", ""
					ElseIf Bmt = 2 Then 'URL
						SYSTEM.Push "IB980001_URL", Bms
						SCREEN.CreateWindow 1, "IB980001 /p?", ""
					End If

				Case "C"	'3X1 TYPE

					If Cmt = 1 Then '화면
						SCREEN.CreateWindow 1, "IB" & Cms & "00" & "/t/d", ""
					ElseIf Cmt = 2 Then 'URL
						SYSTEM.Push "IB980001_URL", Cms
						SCREEN.CreateWindow 1, "IB980001 /p?", ""
					End If

				Case Else
					Exit Sub

				End Select
		End If
	End If
End Sub

