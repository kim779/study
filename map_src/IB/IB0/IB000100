Sub SetTrData(map,handle,file,bookmark,data,dataLen)
	If map <> "0001" And map <> "0002" Then
		Exit Sub
	End If

	If map = "0001" Then
		If tab_tuja.ID = 0 Then
			If Trim(handle) <> Trim(SCREEN.Object("OBJ_Interest.CONTROL0").GetMapHandle()) Then
				Exit Sub
			End If

			SCREEN.Object("OBJ_Interest.CfgFile").Data = file
			SCREEN.Object("OBJ_Interest.BookFile").Data = bookmark
			SCREEN.Object("OBJ_Interest.trData").Data = data
			SCREEN.Object("OBJ_Interest.DataLen").Data = dataLen
		End If
	ElseIf map = "0002" Then
		If tab_info2.ID = 8 Then
			If Trim(handle) <> Trim(SCREEN.Object("OBJ_Interest2.CONTROL0").GetMapHandle()) Then
				Exit Sub
			End If

			SCREEN.Object("OBJ_Interest2.CfgFile").Data = file
			SCREEN.Object("OBJ_Interest2.BookFile").Data = bookmark
			SCREEN.Object("OBJ_Interest2.trData").Data = data
			SCREEN.Object("OBJ_Interest2.DataLen").Data = dataLen
		End If
	End If
End Sub

'모든 obj 1301에 종목정보 전송
Sub send_sise_all(xval)
'	SYSTEM.Trace "send_sise_all="&xval

	'모래시계 생기는 오류사항을 해결하기 위해 Settimer사용
	'(MAIN이 ONSTART하기전에 1301에서 심볼에서 Onchange가 발생하여 귀결적으로 모래시계생김)
	If Isstarted = False Then
		SCREEN.SetTimer 2, False
		Exit Sub
	End If


	SCREEN.IgnoreChange True
	If xval <> "jumun" And xval <> "account" Then
  		S1301.Trigger "", False
 	End If
	S1301.Trigger "1301", True

	If xval <> "jumun" Then
		'If Trim(S1301.Data) <> Trim(SCREEN.Object("obj_order.obj_odr.1301").Data) Then
			Call Ord_ChangeCode(S1301.Data)	' ChangeCode를 태운다
		'End If
	End If

	'시세 전송
	SCREEN.Object("OBJ_sise.1301").data = Trim(S1301.Data)
	OBJ_sise.Send

	'자동단가 전송
	SCREEN.Object("OBJECT0.1301").Data = Trim(S1301.Data)
	OBJECT0.Send

	'왼쪽 하단 전송(차트, 비교, 시황, ...)
	If tab_info2.ID <> 8 Then
		If tab_info2.ID = 3 Then
			OBJ_INFO2.Proc "send_f", ""
		ElseIf tab_info2.ID = 4 Then
			If SCREEN.Object("main.obj_info2.obj1.isclick").Checked = False Then
				OBJ_INFO2.Send
			End If
		Else
			OBJ_INFO2.Send
		End If
	End If

	'미니탭 전송 (회원/체결/투자/일별)
	OBJ1.Send

	'왼쪽 상단은 분할화면일 경우에만 재전송
	If tab_tuja.ID = 6 Then
		OBJ_tuja.Send
	End If

	If tab_account.ID = 7 Then
		SCREEN.Proc "OBJ_account.send_main", ""
	End If

	obj_obj_sise.Send
	If SCREEN.Object("OBJ_order.obj_odr.1301").Iskonex = True Then
		SCREEN.Object("OBJ_order.obj_odr.c_jqty").type = Asc("N")
	Else
		SCREEN.Object("OBJ_order.obj_odr.c_jqty").type = Asc("1")
	End If
	SCREEN.IgnoreChange False
End Sub

