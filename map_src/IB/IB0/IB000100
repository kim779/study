Sub Settrigger(data, handle)
	Dim codx, hKey1, hKey2

	hKey1 = SCREEN.Object("OBJ_Interest.CONTROL0").GetMapHandle()
	hKey2 = SCREEN.Object("OBJ_Interest2.CONTROL0").GetMapHandle()

	If Trim(handle) <> Trim(hKey1) And Trim(handle) <> Trim(hKey2) Then
		Exit Sub
	End If

	codx = Trim(data)
	If Left(codx, 1) = "m" Then
		Exit Sub
	End If

	If Len(codx) = 3 Then
		Exit Sub

	ElseIf Len(codx) = 6 Then
		S1301.Data = codx
		SCREEN.Proc "Send_sise_all", codx
		SCREEN.Proc "Send_sise_all2", codx
		SCREEN.Proc "Send_sise_all3", codx
	Else
		Exit Sub
	End If
End Sub

