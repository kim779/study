_AW_ONCLICK_AW_
Dim target, i

If GRID.HitPos = 4 Then
	target = GRID.GetHeadCell(GRID.Column)

	If GRID.Column < 14 Or Len(target) <= 0 Then
		Exit Sub
	End If

	For i = LBound(g_ArrData) To UBound(g_ArrData)
		If Trim(target) = g_ArrData(i)(1) Then
			GRID.SetColumnVisible target, True
		ElseIf g_ArrData(i)(1) >= 14 Then
			GRID.SetColumnVisible g_ArrData(i)(1), False
		End If
	Next
End If
