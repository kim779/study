Sub Set_Ini()
	Dim tp, Check, Today
    Dim f2, f4
    Dim nowtime, hhmm, shhmm

    If(Len(Hour(Now)) = 1) Then
       hhmm = Hour(Now)*100 + Minute(Now)
       shhmm = "0" + CStr(hhmm)
    Else
       hhmm = Hour(Now)*100 + Minute(Now)
       shhmm = CStr(hhmm)
    End If

    Dim yy, mm, dd, cday, MyWeek
	cday = DateAdd("d", 0, Date) '오늘날짜
	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)

	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd
	nowtime = cday + shhmm


    SYSTEM.Trace "shhmm:"&shhmm

	If SCREEN.CreateObject("Info") Then
		Today = INFO.PopData("", "NOTICECOOKIE.INI", "EVENT_POPUP", "TODAY")
	 	tp = INFO.PopData("", "NOTICEPOPUP.INI", "TYPE", "TP")
		f2 = INFO.PopData("", "NOTICEPOPUP.INI", tp&"TYPE", "F2")
		f4 = INFO.PopData("", "NOTICEPOPUP.INI", tp&"TYPE", "F4")

		'nowtime = Today + shhmm
		SYSTEM.Trace "nowtime:"&nowtime
		SYSTEM.Trace "f2:"&f2
		SYSTEM.Trace "f4:"&f4

	 	If Today = "0" Or (Today <> CDAT.Data) Then
			INFO.PushData "", "NOTICECOOKIE.INI", "EVENT_POPUP", "TODAY", CDAT.Data
			INFO.PushData "", "NOTICECOOKIE.INI", "EVENT_POPUP", "FIRST", "1"
		Else
		 	INFO.PushData "", "NOTICECOOKIE.INI", "EVENT_POPUP", "TODAY", CDAT.Data
		End If

	 	Check = INFO.PopData("", "NOTICECOOKIE.INI", "EVENT_POPUP", "FIRST")

		If tp <> "D" And Check = "1" Then
			If CDbl(f2) < CDbl(nowtime) And CDbl(nowtime) < CDbl(f4) Then
				SYSTEM.Trace "popup"
				SCREEN.CreateWindow 1, "IB0000P4 /p1", ""
			End If
		End If

	End If
End Sub



