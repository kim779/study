' 원장 스위칭 시각 로그인 시 팝업창으로 스위칭 알림 문구 제공
' kind : "국내", "해외"
Sub check_switching(kind)
	Dim ding, stim, etim, curr

	' 현재 시각 : 시(HH) + 분(MM)
	curr = Hour(Now)*100 + Minute(Now)
	If SCREEN.CreateObject("Info") Then
		' 메시지 출력 여부
	 	ding = INFO.PopData("", "SWITCHING.INI", "SWITCHING", "DING")
	 	If ding <> "Y" Then
	 		Exit Sub
	 	End If

	 	' 스위칭 시작 시각
	 	stim = INFO.PopData("", "SWITCHING.INI", kind, "STIM")
	 	' 데이터 미존재 시, Default 값 세팅
	 	If Trim(stim) = "" Then
	 		Select Case Trim(kind)
	 		Case "국내"		' 국내 원장 재기동 시작 시각
	 			stim = 2340
	 		Case "해외"		' 해외 원장 재기동 시작 시각
	 			stim = 0620
	 		End Select
	 	End If

	 	' 스위칭 종료 시각
	 	etim = INFO.PopData("", "SWITCHING.INI", kind, "ETIM")
	 	' 데이터 미존재 시, Default 값 세팅
	 	If Trim(etim) = "" Then
	 		Select Case Trim(kind)
	 		Case "국내"		' 국내 원장 재기동 시작 시각
	 			etim = 0050
	 		Case "해외"		' 해외 원장 재기동 시작 시각
	 			etim = 0640
	 		End Select
	 	End If

	 	' Data 보정 :
	 	If Trim(curr) <> "" Then
	 		curr = CDbl(curr)
	 	End If

	 	If Trim(stim) <> "" Then
	 		stim = CDbl(stim)
	 	End If

	 	If Trim(etim) <> "" Then
	 		etim = CDbl(etim)
	 	End If

		' 원장 재기동 시각에 안내문구 표시
		Select Case Trim(kind)
		Case "국내" ' 23:40 ~ 익일 00:50 사이에 국내원장 재기동 안내문구 팝업
			If stim =< curr Or curr =< etim Then
				SCREEN.CreateWindow 3, "IB0000P9 /t/S/p5/d", "KIND"&vbTab&Trim(kind)&vbLf
			End If
		Case "해외" ' 06:20 ~      06:40 사이에 해외원장 재기동 안내문구 팝업
			Dim tmpkind
			If stim = 720 Then
				tmpkind = "해외서머해제"
			Else
				tmpkind = "해외서머"
			End If

			If stim =< curr And curr =< etim Then
				SCREEN.CreateWindow 3, "IB0000P9 /t/S/p5/d", "KIND"&vbTab&Trim(tmpkind)&vbLf
			End If
		End Select

	End If
End Sub

