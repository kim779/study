RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)

Sub send_f()
	If r1.Checked Then
		upgb.Data = "0"
	ElseIf r2.Checked Then
		upgb.Data = "1"
	ElseIf r3.Checked Then
		upgb.Data = "2"
	Else
		upgb.Data = "3"
	End If

	GRID0.Clear
	SCREEN.Send 0
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
		For ii=1 To 4
			If SCREEN.Object("r"&ii).Checked = True Then
				INFO.pushData LOGIN.Name, myFILE, myMAP, "RD_CHK", ii
			End If
		Next
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim objseq, ii
		objseq = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "RD_CHK"))
		If objseq = "" Then
			objseq = "1"
		End If
		For ii=1 To 4
			If ii = CLng(objseq) Then
				SCREEN.Object("r"&ii).Checked = True
			Else
				SCREEN.Object("r"&ii).Checked = False
			End If
		Next
	End If
End Sub

Sub Change_MKGubn_OBJ(sMKGubn)
	cxMarket.sMarket = sMKGubn
	send_f()
End Sub

_AW_ONSTART_AW_
If UCase(TypeName( SCREEN.Object("Main.cxMarket") )) <> "NOTHING" Then
	cxMarket.sMarket = SCREEN.Object("Main.cxMarket").sMarket
End If

p_read_ini()
send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
OBJ_chart.Send

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
ed_upcd.Data = Trim(GRID0.GetGridCell(1, 2))
SCREEN.Proc "OBJECT0.send_f", ""

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(r3)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r1)
