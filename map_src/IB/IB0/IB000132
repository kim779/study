_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	ed_upcd.Data = Trim(GRID0.GetGridCell(GRID0.Row, 2))
	SCREEN.Proc "OBJECT0.send_f", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


