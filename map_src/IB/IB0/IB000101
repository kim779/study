		sign.SetRect g_Arrdata(4)(2),      37+spos, g_Arrdata(4)(3),           54+spos
		diff.SetRect g_Arrdata(4)(4),      39,      g_Arrdata(4)(4)+yval,      55
		rate.SetRect g_Arrdata(4)(5)+yval, 39,      g_Arrdata(4)(5)+yval+zval, 55
	ElseIf Len(xval) > 6 Then
		curr.SetRect 0,                    27,      g_Arrdata(5)(1),           60
		sign.SetRect g_Arrdata(5)(2),      37+spos, g_Arrdata(5)(3),           54+spos
		diff.SetRect g_Arrdata(5)(4),      39,      g_Arrdata(5)(4)+yval,      55
		rate.SetRect g_Arrdata(5)(5)+yval, 39,      g_Arrdata(5)(5)+yval+zval, 55
	End If
End Sub

Function ratelen(parm)
	If parm <= 3 Then
		ratelen = 54
	ElseIf parm = 4 Then
		ratelen = 63
	ElseIf parm = 5 Then
		ratelen = 72
	ElseIf parm = 6 Then
		ratelen = 81		'6초과 추후 보정
	ElseIf parm > 6 Then
		ratelen = 63
	End If
End Function

Function difflen(parm)
	If parm =1 Then
		difflen = 15
	ElseIf parm = 2 Then
		difflen = 24
	ElseIf parm = 3 Then
		difflen = 33
	ElseIf parm = 4 Then
		difflen = 46
	ElseIf parm = 5 Then
		difflen = 54
	ElseIf parm = 6 Then	'6, 6 > 추후 보정
		difflen = 63
	ElseIf parm > 6 Then
		difflen = 63
	End If
End Function

