	End If
	xval = re1.Replace(tDiff.GetTableCell(2), "")
	yval = difflen(Len(re1.Replace(diff.Data, "")))
	zval = ratelen(Len(re2.Replace(rate.Data, "")))
	'curr.SetRect
	If  Len(xval) <= 2 Then
		curr.SetRect 0,					   27, 		g_Arrdata(0)(1), 		   60
		sign.SetRect g_Arrdata(0)(2),      37+spos, g_Arrdata(0)(3),           54+spos
		diff.SetRect g_Arrdata(0)(4),      39,      g_Arrdata(0)(4)+yval,      55
		rate.SetRect g_Arrdata(0)(5)+yval, 39,      g_Arrdata(0)(5)+yval+zval, 55
	ElseIf Len(xval) = 3 Then
		curr.SetRect 0, 				   27,      g_Arrdata(1)(1),           60
		sign.SetRect g_Arrdata(1)(2),      37+spos, g_Arrdata(1)(3),           54+spos
		diff.SetRect g_Arrdata(1)(4),      39,      g_Arrdata(1)(4)+yval,      55
		rate.SetRect g_Arrdata(1)(5)+yval, 39,      g_Arrdata(1)(5)+yval+zval, 55
	ElseIf Len(xval) = 4 Then
		curr.SetRect 0, 				   27,      g_Arrdata(2)(1),           60
		sign.SetRect g_Arrdata(2)(2),      37+spos, g_Arrdata(2)(3),           54+spos
		diff.SetRect g_Arrdata(2)(4),      39,      g_Arrdata(2)(4)+yval,      55
		rate.SetRect g_Arrdata(2)(5)+yval, 39,      g_Arrdata(2)(5)+yval+zval, 55
	ElseIf Len(xval) = 5 Then
		curr.SetRect 0, 				   27, 	    g_Arrdata(3)(1), 		   60
		sign.SetRect g_Arrdata(3)(2),      37+spos, g_Arrdata(3)(3),           54+spos
		diff.SetRect g_Arrdata(3)(4),      39,      g_Arrdata(3)(4)+yval,      55
		rate.SetRect g_Arrdata(3)(5)+yval, 39,      g_Arrdata(3)(5)+yval+zval, 55
	ElseIf Len(xval) = 6 Then
