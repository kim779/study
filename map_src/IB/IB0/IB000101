Sub Onalert()
	Dim drate
	sign.Data = Left(Trim(tDiff.GetTableCell(1)), 1)
	diff.Data = Trim(tDiff.GetTableCell(1))
	curr.Data = Trim(tDiff.GetTableCell(2))
	If Len(Trim(tDiff.GetTableCell(3))) > 0 Then
		drate = CDbl(Trim(tDiff.GetTableCell(3)))
	Else
		drate = 0.0
	End If

	If drate = 0.0 Then
		rate.Data = ""
	Else
		rate.Data = Trim(tDiff.GetTableCell(3))&"%"
	End If

	'거래량 자릿수 추가 로직 26.02.03 -lwj
	'-----------------------------------------------------------
	If Len(Trim(tDiff.GetTableCell(4))) > 9 Then
		SelectVol = True
	Else
		SelectVol = False
	End If

	If SelectVol Then
		gvol2.Data = Trim(tDiff.GetTableCell(4))
		gvol.Visible = False
		gvol2.Visible = True
	Else
		gvol.Data = Trim(tDiff.GetTableCell(4))
		gvol.Visible = True
		gvol2.Visible = False
	End If
