_AW_ONDECLARE_AW_
Option Explicit

Dim sendCnt

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
zSecurCardInpt1.SetFocus

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

If Trim(lOnesfCnfTrxSeqno.Data) = "" Or Trim(zSecurCardInptNo1.Data) = "" Or Trim(zSecurCardInptNo2.Data) = "" Then
	If Trim(responseMsg.Text) <> "" Then
		Call alert_msg(Trim(responseMsg.Text))
		Call guide_msg(Trim(responseMsg.Text))
		Exit Sub
	End If
End If

If Trim(zSecurCardInpt1.data) = "" Then
	Call alert_msg("보안카드 번호를 확인하여 주십시오.")
	zSecurCardInpt1.SetFocus
	Exit Sub
End If

If Trim(zSecurCardInpt2.data) = "" Then
	Call alert_msg("보안카드 번호를 확인하여 주십시오.")
	zSecurCardInpt2.SetFocus
	Exit Sub
End If

sendCnt = sendCnt + 1

If sendCnt > 1 Then
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
cnt.Data = lRetryAbleCnt.data

If Trim(zErrMsgCode.Data) = "0000" Then
	SCREEN.SetTimer 4, False
Else
	Call alert_msg(zErrMsgCode.Data & " " &  Trim(zErrMsgCnts.Data) & vbLf & "재시도 가능 횟수는 "& Trim(cnt.Data) & "번 남았습니다.")
	sendCnt = 0
	SCREEN.Proc "obj_gen.send_f", ""
	zSecurCardInpt1.Setfocus
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
sendCnt = 0
zSecurCardInpt1.Clear
zSecurCardInpt2.Clear

SCREEN.ClearAll 0, 2
SCREEN.Proc "parent.obj_snd.send_o", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(lRetryAbleCnt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCode)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCnts)
_AW_ENDSCRIPT_AW_


