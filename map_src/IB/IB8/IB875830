_AW_ONDECLARE_AW_
Dim g_ArrCtrls
'0 :구분
'1 :주차
'2 :순서
'3 :발행사명
'4 :청약시작일자
'5 :청약종료일자
'6 :납입일
'7 :발행회차
'8 :기초코드1
'9 :기초코드2
'10 :조기상환수준
'11:KI
'12:총수익률
'13:만기기간
'14:조기상환주기
'15:연수익률
'16:연수익률2
'17:조기상환확률
'18:원금손실확률
'19:KI예상자산
g_ArrCtrls = Array(ed_gubn, ed_wkno, ed_sqno, ed_isnm, ed_apst,_
	ed_apet, ed_pydt, ed_isno, ed_cod1, ed_cod2,_
	ed_rplv, ed_kida, ed_trat, ed_exyr, ed_rpfq,_
	ed_yrrt, ed_yrt2, ed_rppb, ed_lspb, ed_kiap)
'---------------------------------------------------------------------------------
Sub InsertData(Data)
	'SYSTEM.Trace "SEND|" & Data
	g_ArrCtrls(0).Data = "I"
	ArrData = Split(Data, "|")
	For i = 1 To UBound(g_ArrCtrls)
		g_ArrCtrls(i).Data = ArrData(i - 1)
	Next
	SCREEN.Send 0
End Sub
'---------------------------------------------------------------------------------
Sub DeleteData(Data)
	'SYSTEM.Trace "SEND|" & Data
	g_ArrCtrls(0).Data = "D"
	ArrData = Split(Data, "|")
	For i = 1 To UBound(g_ArrCtrls)
		g_ArrCtrls(i).Data = ArrData(i - 1)
	Next
	SCREEN.Send 0
End Sub

_AW_ONRECEIVE_AW_
If ed_gubn.Data = "I" Then
	Data = Trim(ot_smsg.Data)
	If Len(Data) = 0 Then
		SCREEN.Proc "Main.InsertData", ""
		SCREEN.Proc "Main.InitCtrls", ""
	End If
ElseIf ed_gubn.Data = "D" Then
	SCREEN.Proc "Main.SendData", "0"
End If

Data = Trim(ot_smsg.Data)
If Len(Data) = 0 Then
	SCREEN.Proc "Main.SetGuideData", ""
Else
	SCREEN.Proc "Main.SetGuideData", Data
End If

_AW_ONENDSUB_AW_
}



