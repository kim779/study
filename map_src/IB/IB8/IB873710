RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")
LEDGER.Rcnt = "0045"

If Hour(Time) < 15 Then
	Call alert_msg("오후 3시 이후에 조회가 가능합니다.")
	Exit Sub
End If

zIn.Data = "00001"

zQrySrtDate.Data = Trim(SCREEN.Object("parent.zQrySrtDate").Data)
zQryEndDate.Data = Trim(SCREEN.Object("parent.zQryEndDate").Data)

If DateDiff("d", zQrySrtDate.Text, zQryEndDate.Text) > 7 Then
	Call alert_msg("조회기간을 확인하여 주십시오." & vbLf & vbLf & "조회기간은 영업일 7일이내로 입력하셔야 합니다.")
	SCREEN.Object("parent.zQrySrtDate").SetFocus
	Exit Sub
End If

If DateDiff("d", zQrySrtDate.Text, zQryEndDate.Text) < 0 Then
	Call alert_msg("조회시작일은 조회종료일보다 빨라야 합니다.")
	SCREEN.Object("parent.zQrySrtDate").SetFocus
	Exit Sub
End If

If zQrySrtDate.Data > LOGIN.Day0 Then
	Call alert_msg("조회시작일은 조회당일과 같거나 빨라야 합니다.")
	SCREEN.Object("parent.zQrySrtDate").SetFocus
	Exit Sub
End If

If zQryEndDate.Data > LOGIN.Day0 Then
	Call alert_msg("조회종료일은 조회당일과 같거나 빨라야 합니다.")
	SCREEN.Object("parent.zQryEndDate").SetFocus
	Exit Sub
End If

zBnsTp.Data = Trim(SCREEN.Object("parent.zBnsTp").Data)

If SCREEN.Object("parent.RADIO0").Checked = True Then
	zQryTp.Data = 1
Else
	zQryTp.Data = 2
End If

zUserId.Data = Trim(LOGIN.User)
zBrnNo.Data = Trim(LOGIN.Brno)
zAfirTp.Data = "1"
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	SCREEN.Object("parent.next_btn").Enable = True
Else
	SCREEN.Object("parent.next_btn").Enable = False
End If

If Left(Trim(LEDGER.Ecod), 1) = "0" Then

Else
	If Trim(LEDGER.Ecod) <> "2679" Then
		Call alert_msg(Trim(LEDGER.Emsg))
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zQrySrtDate)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zQryEndDate)
