RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_pwd(data)
'	get_passwd.Clear

	get_passwd.Data = data
End Sub

Sub Set_msg(data)
	msg.Clear
	msg.Data = data
End Sub

_AW_ONSTART_AW_
k1pad.Start

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
k1pad.Close

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If SCREEN.Key = "13" Then
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_

get_passwd.Trigger "ed_pswd", False
get_passwd.Trigger "ed_pswd", True

get_passwd.Trigger "zPwd", False
get_passwd.Trigger "zPwd", True

get_passwd.Trigger "pswd", False
get_passwd.Trigger "pswd", True
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
get_passwd.Clear
msg.Clear

k1pad.GetPasswd
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
k1pad.Close
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



