_AW_ONDECLARE_AW_
Option Explicit

Dim sendType

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	sendType = "Q"

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_o()
	sendType = "O"
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub confirmOrder()
	SYSTEM.Push "fundLoan_8505", ""

	If chkInpt() = False Then
		Exit Sub
	End If

	Dim dmsg, odrGubn, odrName
	odrGubn = "현금상환"
	odrName = "현금상환금"

	dmsg = "odrGubn" & vbTab & odrGubn         & vbLf &_
		   "odrName" & vbTab & odrName         & vbLf &_
		   "o_acno"  & vbTab & Trim(SCREEN.Object("parent.AN50").Data) & vbLf &_
		   "o_acnm"  & vbTab & Trim(SCREEN.Object("parent.ACNM").Data) & vbLf &_
		   "o_aa"    & vbTab & Trim(SCREEN.Object("parent.aa").Data)   & vbLf

	SCREEN.CreateWindow 2, "IB85051A /t /s /p5 /d", dmsg

	If Trim(SYSTEM.Pop("fundLoan_8505")) <> "OK" Then
		Exit Sub
	End If

	Call send_o()
End Sub


Function chkInpt()
	Dim msg

	chkInpt = False

	If Len(Trim(SCREEN.Object("parent.AN50").Data)) <> 11 Then
		msg = "계좌번호(ex.xxx-53-xxxxxx)를 확인하여 주십시오."
		Call alert_msg(msg)
		Call guide_msg(msg)
		SCREEN.Object("parent.AN50").SetFocus
		Exit Function
	End If

	If Len(Trim(SCREEN.Object("parent.zPwd").Data)) < 4 Then
		msg = "비밀번호를 확인하여 주십시오."
		Call alert_msg(msg)
		Call guide_msg(msg)
		SCREEN.Object("parent.zPwd").SetFocus
		Exit Function
	End If

	If Is_numeric(SCREEN.Object("parent.aa").Data) = False Then
		msg = "상환금을 확인하여 주십시오."
		Call alert_msg(msg)
		Call guide_msg(msg)
		SCREEN.Object("parent.aa").SetFocus
		Exit Function
	End If

	chkInpt = True
End Function

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"

zAcntNo.Data = SCREEN.Object("parent.AN50").data
zPwd.Data = SCREEN.Object("parent.zPwd").data

If CheckInput(zAcntNo, zPwd) = True Then
	Dim amt
	amt = Trim(SCREEN.Object("parent.aa").Data)

	If IsNumeric(amt) = False Then
		Call alert_msg("상환금을 확인하여 주십시오.")
		SCREEN.Object("parent.aa").SetFocus
		Exit Sub
	End If

	If sendType = "O" And amt <= 0 Then
		Call alert_msg("상환금을 확인하여 주십시오.")
		SCREEN.Object("parent.aa").SetFocus
		Exit Sub
	End If

	lOrgTrxNo.Data = "+" & l_zeropad(SCREEN.Object("parent.aa"))
	SCREEN.OnSend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If sendType = "O" Then
	Call alert_msg(Trim(LEDGER.Emsg))

	SCREEN.Object("parent.aa").Clear

	If Left(ecod, 1) = 0 Then
		SCREEN.Proc "parent.obj_list.send_f", ""
	End If

	SCREEN.Object("parent.aa").SetFocus
Else
	SCREEN.Object("parent.send_btn").SetFocus
End If

Call guide_msg(Trim(LEDGER.Emsg))

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	Else
		Dim acnt
		acnt = Trim(SCREEN.Object("main.zAcntNo").Data)

		If acnt <> Trim(AN50.Data) Then
			SCREEN.Object("main.zAcntNo").Data = Trim(AN50.Data)
		End If

		SCREEN.Object("main.zPwd").Data = Trim(zPwd.Data)
	End If

	If Is_numeric(aa.Data) = True Then
		Call send_f()
	Else
		aa.SetFocus
	End If
End If
