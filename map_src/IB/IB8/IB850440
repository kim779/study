_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.Rows < 1 Then
	Exit Sub
End If

If GRID0.HitPos <> 3 Then
	Exit Sub
End If

If Trim(GRID0.GetGridCell(GRID0.Row, 1)) = "" Then
	Exit Sub
End If

If Trim(GRID0.GetGridCell(GRID0.Row, 8)) = "대출신청취소" Then
	GUIDE.Text = " 이미 취소된 내역입니다."
	zTrxNo_dummy.Data = ""
	Exit Sub
End If

GUIDE.Text = ""

zTrxBrnNo.Data = Trim(GRID0.GetGridCell(GRID0.Row, 2))
zTrxNo_dummy.Data = Trim(GRID0.GetGridCell(GRID0.Row, 3))
