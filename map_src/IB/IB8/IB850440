RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gubn
gubn = ""
'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	SCREEN.ClearAll 0, 2

	If Len(Trim(AN10.Data)) = 11 Then
		ACNM.Data = Trim(AN10.name)
		zPwd.Data = Trim(AN10.Password)

		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If

		Call send_f()
	Else
		AN10.SetFocus
		Exit Sub
	End If
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	ACNM.Data = Trim(AN10.name)
	gubn = "조회"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	GRID0.SetDataPosition 2
	gubn = "조회"
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub send_o()
	gubn = "주문"
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub confirmOrder()
	Dim dmsg

	SYSTEM.Push "madoRdmtnCancel", ""

	If Len(Trim(AN10.Data)) <> 11 Then
		MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"
		AN10.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zPwd.SetFocus
		Exit Sub
	End If

	If Is_numeric(zTrxNo_dummy.Data) = False Then
		MsgBox "해지하실 대출신청내용을 아래 대출신청목록에서 선택하여 주십시오.", , "IBK투자증권"
		Exit Sub
	End If

	zTrxNo.Data = "+" & l_zeropad(zTrxNo_dummy)

	dmsg = "o_acno" & vbTab & Trim(AN10.Data) & vbLf &_
		   "o_acnm" & vbTab & Trim(ACNM.Data) & vbLf &_
		   "o_loan" & vbTab & Trim(cancelLoanAmt.Data) & vbLf

	SCREEN.CreateWindow 2, "IB85044A /t /p5 /d", dmsg

	If SYSTEM.Pop("madoRdmtnCancel") = "OK" Then
		If IsBnkAccnType(AN10) = True Then
			SCREEN.Proc "obj_getMoney.contributionBnk", Trim(cancelLoanAmt.Data)
		Else
			Call send_o()
		End If
	End If

	SYSTEM.Push "madoRdmtnCancel", ""
End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
GUIDE.Text = ""
LEDGER.Rcnt = "0015"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

If Len(Trim(AN10.Data)) <> 11 Then
	MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"
	AN10.SetFocus
	Exit Sub
End If

If Len(Trim(zPwd.Data)) < 4 Then
	MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
	zPwd.SetFocus
	Exit Sub
End If

If Trim(gubn) = "주문" Then
	If Is_numeric(zTrxNo_dummy.Data) = False Then
		MsgBox "해지하실 대출신청내용을 아래 대출신청목록에서 선택하여 주십시오.", , "IBK투자증권"
		Exit Sub
	End If

	zTrxNo.Data = "+" & l_zeropad(zTrxNo_dummy)
Else
	zTrxNo.Data = "+000000000"
	zTrxBrnNo.Data = ""
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If LEDGER.Next = "Y" Then
		Call send_c()
	End If
Else
	If Trim(LEDGER.Ecod) = "3669" Then
		SCREEN.ClearAll 0, 2
		ACNM.Data = Trim(AN10.Name)
		zPwd.SetFocus
	Else
		If Trim(LEDGER.Ecod) <> "2679" Then 	'조회내역이 없습니다
			MsgBox Trim(LEDGER.Emsg), , "IBK투자증권"
		End If
	End If

	If IsBnkAccnType(AN10) = True And Trim(gubn) = "주문" Then
		SCREEN.Proc "obj_cancelMoney.send_f", ""
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(b_ok)
_AW_ONCLICK_AW_
Call confirmOrder()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zTrxNo_out)
_AW_ENDSCRIPT_AW_


