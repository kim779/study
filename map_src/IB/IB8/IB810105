RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sendCnt
sendCnt = 0

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
zOtpVrfVal.SetFocus
gubndata.Data = "8101"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

If Trim(lOnesfCnfTrxSeqno.Data) = "" Then
	MsgBox Trim(searchMsg.Text), , "IBK투자증권"
	Exit Sub
End If

If Trim(zOtpVrfVal.Data) = "" Then
	alert_msg("OTP생성번호를 입력하세요")
	zOtpVrfVal.SetFocus
	Exit Sub
End If

sendCnt = sendCnt + 1

If sendCnt > 1 Then
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod),1) = "0" Then
	If Trim(zErrMsgCode.Data) = "0000" Then
		zOtpVrfVal.Clear
		SCREEN.ClearAll 0, 2
		SCREEN.SetTimer 4, False
	Else
		sendCnt = 0

		Dim msg
		msg = Trim(zErrMsgCnts.Data)

		If Trim(zErrMsgCnts.Data) <> "" Then
			If Trim(zErrMsgCode.Data) = "3517" Then
				msg = msg & vbLf & vbLf & "재시도 가능횟수는 "& Trim(lRetryAbleCnt.Data) & "회 남았습니다."
			End If

			alert_msg(msg)
		End If
		SCREEN.Object("parent.OBJ_otp1").Send
	End If
Else
	sendCnt = 0
	SCREEN.Object("parent.OBJ_otp1").Send
	alert_msg(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Proc "parent.send", ""
SCREEN.Proc "parent.OTP_hide", ""
sendCnt = 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(lRetryAbleCnt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zOtpVrfVal)
_AW_ONKEYCHANGE_AW_
'== 보안카드번호 입력 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	SCREEN.Proc "parent.Confirm_Send", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
SCREEN.Object("parent.OBJ_otp2").Visible = False
SCREEN.Object("parent.BTN_BANK").SetFocus

zOtpVrfVal.Clear
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCode)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCnts)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 2, "IB810190 /t /s /p5 /d", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(opindata)
_AW_ONKEYCHANGE_AW_
'== 보안카드번호 입력 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	SCREEN.Proc "parent.Confirm_Send", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
If Trim(zMdaSeqno.data) = "" Then
	MsgBox "매체일련번호를 입력하세요",0,"IBK투자증권"
Else
	If SCREEN.Object("parent.obj_otp1.zOnesfCnfPtnTp").data = "S" Then
		If CHECK0.Checked = True Then
			SCREEN.Object("parent.obj_otp1.obj_op").send
		Else
			SCREEN.Object("parent.obj_otp1.obj_ox").send
		End If
	Else
		SCREEN.Proc "parent.Confirm_Send", ""
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
If SCREEN.Object("parent.obj_otp1.zOnesfCnfPtnTp").data = "S" And CHECK0.Checked = False Then
	obj_oz.send
Else
	SCREEN.Proc "parent.Confirm_Send", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHECK0)
_AW_ONCLICK_AW_
If CHECK0.Checked = True Then
	LABEL2.Visible = True
	opindata.Visible = True
Else
	LABEL2.Visible = False
	opindata.Visible = False
End If

SCREEN.Object("parent.OBJ_otp1").Send
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
If CHECK0.Checked = True Then
	LABEL2.Visible = True
	opindata.Visible = True
Else
	LABEL2.Visible = False
	opindata.Visible = False
End If

SCREEN.Object("parent.OBJ_otp1").Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



