RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_memo()
	AWHY.Text = SYSTEM.Pop ("IB884000_WHY")
End Sub


Sub get_byte(strwhy)
	l_byte = 0

	For i = 1 To Len(strwhy)
		If Asc(Mid(strwhy, i, 1)) < 0 Then
			l_byte = l_byte + 2
		Else
			l_byte = l_byte + 1
		End If
	Next

	len_why.Data = l_byte

End Sub

_AW_ONSTART_AW_
If FLAG.Data = "0" Then '추천사유
	SCREEN.SetCaption "Winners Club 추천사유"
	TITLE_LABEL.Data = "추천사유"
ElseIf FLAG.Data = "1" Then '종료사유
	SCREEN.SetCaption "Winners Club 종료사유"
	TITLE_LABEL.Data = "종료사유"
Else
	SCREEN.SetCaption "Winners Club 사유입력"
	TITLE_LABEL.Data = "사유입력"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(sendBtn)
_AW_ONCLICK_AW_
Dim i, ii, func
get_byte(Trim(AWHY.Text))
i = CLng(len_why.Data)
If i > 4096 Then
	MsgBox "현재 "&i&"Byte 입력 / "&Abs(4096-i)&"Byte 초과 하였습니다."
Else

'	If FLAG.Data = "0" Then '추천사유
'		SYSTEM.Push "RWHY", MEMO0.TEXT
'	Else					'종료사유
'		SYSTEM.Push "EWHY", MEMO0.TEXT
'	End If

	MsgBox "입력이 완료되었습니다.",,"IBK투자증권"

	If FLAG.Data = "0" Then
		func = "Set_rwhy"
	Else
		func = "Set_ewhy"
	End If

	SYSTEM.Push "IB884000_WHY", Trim(AWHY.TEXT)
	SYSTEM.Trigger func, "", "IB884000"
	SCREEN.CloseWindow()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



