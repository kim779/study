RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

Sub Set_account()
	SCREEN.ClearAll 0, 2

	If Trim(SCREEN.Object("main.zAcntNo").Data) <> Trim(AN50.Data) Then
		SCREEN.Object("main.zAcntNo").Data = Trim(AN50.Data)
		SCREEN.Object("main.zPwd").Data = ""
	End If

	If Len(Trim(AN50.Data)) = 11 Then
		ACNM.Data = Trim(AN50.Name)
		zPwd.Data = Trim(AN50.Password)

		If Trim(zPwd.Data) = "" Then
			If Trim(AN50.Data) = Trim(SCREEN.Object("main.zAcntNo").Data) Then
				If Len(Trim(SCREEN.Object("main.zPwd").Data)) >= 4 Then
					zPwd.Data = SCREEN.Object("main.zPwd").Data
				End If
			End If
		End If

		Call send_f()
	Else
		AN50.SetFocus
		Exit Sub
	End If
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ACNM.Data = Trim(AN50.Name)
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Function comChkData(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		comChkData = False
		Exit Function
	Else
		comChkData = True
		Exit Function
	End If
End Function

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0013"

Call Check_LoginType(zPwd)

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
Call guide_msg("")

If SYSTEM.ConnectBy = 0 And Trim(zPwd.Data) = "" Then
	zPwd.Data = "9999"
End If

If CheckInput(AN50,zPwd) = True Then
	SCREEN.OnSend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If comChkData(ecod) = False Then
	Exit Sub
End If

