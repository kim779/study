	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text

	account = Trim(CMB_ACCT.Data)
	zAcntNo.Data = account

	acct1 = Mid(zAcntNo.data,1,3)
	acct2 = Mid(zAcntNo.data, 6, 6)

	totacnt.Data  = acct1 & "00" & acct2
	AN00.data = zAcntNo.Data
	zPwd.Data = AN00.Password
	Call Clear()

	'Call bank_chk()

	If Trim(CMB_ACCT.Data) <> "" And Trim(zPwd.Data) <> "" Then
		Call checkPassword()
	End If
End Sub


'==============================================================
