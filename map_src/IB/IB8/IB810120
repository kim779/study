Sub bank_chk()
	bchk.Text = ""

	If Left(CMB_ACCT.text, 1) = "5" Then	'은행개설계좌일 경우
		Dim manageNo, ii, grdAcct, acctGrd
		Set acctGrd = SCREEN.Object("main.obj_acct.GRID0")

		For ii = 1 To acctGrd.Rows
			grdAcct = Trim(acctGrd.GetGridCell(ii, 9))

			If grdAcct = Trim(CMB_ACCT.Data) Then
				manageNo = Trim(acctGrd.GetGridCell(ii, 7))
				Exit For
			End If
		Next

		If Left(manageNo, 1) = "5" Then
			bchk.Text = "1"
		End If
	End If

	If Trim(bchk.Text) = "" Then
		bchk.Text = "0"
	End If
End Sub

'비밀번호 검증
Sub checkPassword()
	Dim tmpAcct, tmpPwd
	tmpAcct = Trim(CMB_ACCT.Data)
	tmpPwd = Trim(zPwd.Data)

	If Len(tmpAcct) <> 11 Then
		MsgBox "출금계좌번호를 확인하여 주십시오.", , "IBK투자증권"
		CMB_ACCT.SetFocus
		Exit Sub
	End If

	If Len(tmpPwd) < 4 Then
		MsgBox "출금계좌비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Object("chk_passwd.IntaccNo").data = tmpAcct
	SCREEN.Object("chk_passwd.Pwd").data = tmpPwd

	chk_passwd.Send
End Sub

