_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	GRID1.SetDataPosition 2
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub


Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)
End Sub

Sub check()
	If CHECK0.Checked = True Then
		S1301.Enable = True
		BUTTON0.Enable = True
	Else
		S1301.Enable = False
		BUTTON0.Enable = False
	End If
End Sub

_AW_ONSTART_AW_
SCREEN.SetTimer 1, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

