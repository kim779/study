AcntNo.Data = SCREEN.Object("main.AN98").data
pwd.Data = SCREEN.Object("main.zPwd").data


SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
Dim otype, oname, ormno, orela, oaddD, ocanD
ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = "0" Then

	If LEDGER.Next = "Y" Then
		send_c()
	Else

		For ii=1 To Grid0.Rows
		otype = Trim(Grid0.GetgridCell(ii, 8))
		oname = Trim(Grid0.GetgridCell(ii, 11))
		ormno = Trim(Grid0.GetgridCell(ii, 12))
		ormno = Left(ormno,3) & "**********"
		orela = Trim(Grid0.GetgridCell(ii, 10))
		oaddD = Trim(Grid0.GetgridCell(ii, 25))
		ocanD = Trim(Grid0.GetgridCell(ii, 26))

		Grid0.SetGridCell ii, 1, otype
		Grid0.SetGridCell ii, 2, oname
		Grid0.SetGridCell ii, 3, ormno
		Grid0.SetGridCell ii, 4, orela
		Grid0.SetGridCell ii, 5, oaddD
		Grid0.SetGridCell ii, 6, ocanD



	Next
	End If
End If
SCREEN.Object("main.GUIDE").text = LEDGER.Emsg

