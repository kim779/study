'==================================================
' 계좌명 세팅, 화면 클리어
'==================================================
Sub acct_set()
	SCREEN.ClearAll 0, 2
	isPwdConfirm.Text = ""
	ACNM.Text = ""
	zPwd.Clear
	tmp_zIsuNo.Clear
	zIsuNo.Clear
	jmNm.Clear
	zTrxQty.Clear
	obj_cancelList.ClearAll 0
	SCREEN.Object("parent.obj2").ClearAll 2

	If Trim(CMB_ACCT.Text) = "" Then
		Exit Sub
	End If

	Dim accnArr
	accnArr = Split(Trim(CMB_ACCT.Text), "  ")

	ACNM.Text = Trim(accnArr(UBound(accnArr)))

	zPwd.SetFocus
End Sub



'==================================================
' 비밀번호를 바르게 입력했을 때
'==================================================
Sub rightPwd(param)
	isPwdConfirm.Text = "Y"

	If param = "up" Then
		SCREEN.Proc "obj_cancelList.send_f", ""
		SCREEN.Proc "parent.obj2.send_f", ""
	ElseIf param = "bottom" Then
		SCREEN.Proc "parent.obj2.send_f", ""
	End If
End Sub


'==================================================
' 비밀번호가 틀렸을 때
'==================================================
Sub wrongPwd()
	isPwdConfirm.Text = "N"
	zPwd.SetFocus
End Sub


'==================================================
' 타사대체신청전 확인
'==================================================
Sub chkSendCondition()
	SYSTEM.Push "transCancel_8102", ""

	If inputCheck = False Then
		Exit Sub
	End If

	Dim dmsg
	dmsg =  "o_acn1"   & vbTab & Left(Trim(CMB_ACCT.Text), 13) & vbLf &_
			"o_acname" & vbTab & Trim(ACNM.Text) & vbLf &_
			"jm_name"  & vbTab & Trim(jmNm.Text) & vbLf &_
			"o_cnt"    & vbTab & Trim(zTrxQty.Data) & vbLf

	SCREEN.CreateWindow 2, "IB810271 /t /p5 /d", dmsg

	If Trim(SYSTEM.Pop("transCancel_8102")) <> "OK" Then
		SYSTEM.Push "transCancel_8102", ""
		Exit Sub
	End If

	SYSTEM.Push "transCancel_8102", ""

	zTrxTp.Data = "2"
	SCREEN.Proc "obj_snd.send_o", ""
End Sub


'==================================================
' 입력값 확인
'==================================================
Function InputCheck()
	inputCheck = False

	If Len(Trim(CMB_ACCT.Data)) <> 11 Then
		Call alert_msg("출고계좌번호를 확인하여 주십시오.")
		CMB_ACCT.SetFocus
		Exit Function
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		Call alert_msg("출고계좌비밀번호를 확인하여 주십시오.")
		zPwd.SetFocus
		Exit Function
	End If

	If Trim(tmp_zIsuNo.Data) = "" Or Trim(jmNm.Data) = "" Then
		Call alert_msg("유가잔고내역에서 종목을 선택하여 주십시오.")
		Exit Function
	End If

	If Trim(zTrxQty.Data) <> "" Then
		If IsNumeric(zTrxQty.Data) = True Then
			If CDbl(zTrxQty.Data) = 0 Then
				Call alert_msg("대체수량을 확인하여 주십시오.")
				zTrxQty.SetFocus
				Exit Function
			End If
		Else
			Call alert_msg("대체수량을 확인하여 주십시오.")
			zTrxQty.SetFocus
			Exit Function
		End If
	Else
		Call alert_msg("대체수량을 확인하여 주십시오.")
		zTrxQty.SetFocus
		Exit Function
	End If

	inputCheck = True
End Function

