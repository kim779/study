	End Select
	cycle.SetItems(items)
	ch_editb()

End Sub
'-------------------------------------------------------------------
Sub ch_editb()
	Dim iyear, ii
	iyear = ((CLng(ed_year.Data) / 10) * 12) / CLng(cycle.Data)
	For ii=1 To 9
		If ii <= iyear Then
			SCREEN.Object("cd0"&ii).Enable = True
		Else
			SCREEN.Object("cd0"&ii).Enable = False
		End If
	Next
	Freq = (ed_year.Data/10) * (12 / cycle.Data)
	g_ArrCd(0) = Freq
	g_ArrCd(1) = cycle.Data
	Data = Join(g_ArrCd, "|")
	SCREEN.Proc "Parent.SetCdData", g_Index & "," & Data
