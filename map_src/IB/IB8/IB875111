	'3:조회일, 4:조회일종가1, 5:조회일종가2
	ArrData = Split(Data, "@")
	If UBound(ArrData) < 1 Then
		Exit Sub
	End If

	InitCtrls
	ArrData1 = Split(ArrData(0), "|")

	For i = LBound(g_ArrDecSrch) To UBound(g_ArrDecSrch)
		g_ArrDecSrch(i).Data = ArrData1(i)
	Next

'SYSTEM.Trace ArrData(1)
	ArrData2 = Split(ArrData(1), "|")

	For i = LBound(ArrData2) To UBound(ArrData2)
		If Arrdata2(i) = "0" Then
			Exit For
		End If
		g_ArrCtrls(i).Data = ArrData2(i)
	Next

	ArrData3 = Split(ArrData(2), "|")
	ed_dcdf.Data = ArrData3(0)
	ed_srdf.Data = ArrData3(1)
	ed_dsdf.Data = ArrData3(2)
	'SYSTEM.Trace g_ArrDecSrch(1).Data
End Sub
