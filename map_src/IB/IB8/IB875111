Sub SendFirstDecDate()
	Mon = -1 * CLng(cycle.Data)
	AYear = Year(DateAdd("m", Mon, Date))
	AMon = Month(DateAdd("m", Mon, Date))
	ADay = Day(DateAdd("m", Mon, Date))

	If Len(AMon) = 1 Then
		AMon = "0" & AMon
	End If

	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If

