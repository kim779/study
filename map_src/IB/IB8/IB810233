RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub initData()
	curRow.Text = "1"
	pGridRows.Text = Trim(SCREEN.Object("parent.GRID0").Rows)

	Call SetData()
End Sub

Sub SetData()
	SCREEN.ClearAll 0, 0

	zIn.Data = "00001"
	zAcntNo.Data = Trim(SCREEN.Object("parent.zAcntNo").Data)
	zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

	Dim tmpCurrRow
	tmpCurrRow = CDbl(curRow.Text)

	If SCREEN.Object("parent.parent.r_chae").Checked = True Then
		zIsuNo.Data = Trim(SCREEN.Object("parent.GRID0").GetGridCell(tmpCurrRow, 1))

		zBuyDt.Data = Trim(SCREEN.Object("parent.GRID0").GetGridCell(tmpCurrRow, 3))

		Dim tmpTaxGb
		tmpTaxGb = Trim(SCREEN.Object("parent.GRID0").GetGridCell(tmpCurrRow, 4))

		If tmpTaxGb = "종합과세" Then
			zTxontTp.Data = "1"
		Else
			zTxontTp.Data = "2"
		End If
	Else
		zIsuNo.Data = Trim(SCREEN.Object("parent.GRID0").GetGridCell(tmpCurrRow, 9))
		zBuyDt.Data = ""
		zTxontTp.Data = ""
	End If

	Call send_f()
End Sub

Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If SCREEN.Object("parent.parent.r_chae").Checked = True Then
		SCREEN.Object("parent.GRID0").SetGridCell CDbl(curRow.Text), 20, Trim(amt.Data)
	Else
		SCREEN.Object("parent.GRID0").SetGridCell CDbl(curRow.Text), 23, Trim(amt.Data)
	End If

Else
	Call guide_msg(Trim(LEDGER.Emsg))
End If

curRow.Text = CDbl(curRow.Text) + 1
If CDbl(curRow.Text) <= CDbl(pGridRows.Text) Then
	Call SetData()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(amt)
_AW_ENDSCRIPT_AW_


}



