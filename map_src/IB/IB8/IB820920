RESOURCE DIVISION
{


_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
zRrno.Data = LOGIN.Juno

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
Else
	For i = 1 To GRID0.Rows
		'- 체크박스 건드려주기
	    GRID0.SetGridCell i, 1, CHECK0.text

		If Trim(GRID0.GetGridCell (i, 3)) = "1" Then '-- 활동계좌
			GRID0.Setgridcell i, 4, "활동계좌"
		ElseIf Trim(GRID0.GetGridCell (i, 3)) = "2" Then '--
			GRID0.Setgridcell i, 4, "비활동계좌"
		End If

		If Trim(GRID0.GetGridCell (i, 9)) = "0" Then '-- 미승인
			GRID0.Setgridcell i, 10, "미승인"
		ElseIf Trim(GRID0.GetGridCell (i, 3)) = "1" Then '-- 승
			GRID0.Setgridcell i, 10, "승인"
		End If
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



