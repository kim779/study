RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_account()
	SCREEN.ClearAll 0, 2

	ACNM.Data = AN1A.Name
	h_acnm.Data = AN1A.name

	If Len(Trim(AN1A.Data)) <> 11 Then
		Exit Sub
	End If


	Call send_f()

End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	SYSTEM.Trace "send_f " & AN1A.data
	If AN1A.data <> "           " Then
		ACNM.Data = h_acnm.Data
	End If

	LEDGER.Fkey = "C"
	SCREEN.Send 0

End Sub

Sub send_all()
	SCREEN.ClearAll 0, 2
	AN1A.data = ""
	LEDGER.Fkey = "C"
	SCREEN.Send 0

End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)
End Sub

Sub SettingAdmin(data)
	Dim dataArray, gubn
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	gubn = dataArray(0)

	If gubn = "0030" Or gubn = "0040" Then
		EDIT2.Data = "1"
	ElseIf gubn = "0030" Then
		EDIT2.Data = "0"
	ElseIf gubn = "0470" Then
		EDIT2.Data = "2"
	End If

	SYSTEM.Trace "data : " & data
	'EDIT2.Data = dataArray(0)
	EDIT3.Data = dataArray(1)
	EDIT4.Data = dataArray(2)



End Sub

_AW_ONSTART_AW_
EDIT1.Data = "Y"
SCREEN.SetTimer 2, False

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

EDIT1.Data = "N"

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_

Call send_all()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
If EDIT1.Data = "N" Then
	Call Set_account()
Else
	AN1A.data = ""
	SYSTEM.Trace "account onchange send_all()"
	'Call send_all()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
