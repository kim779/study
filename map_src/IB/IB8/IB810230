_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 0
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.CMB_ACCT").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call guide_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.CMB_ACCT").SetFocus
	Exit Sub
End If

zPwd.Data = SCREEN.Object("parent.zPwd").Data

If Len(Trim(zPwd.Data)) < 4 Then
	Call guide_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
'	SCREEN.Object("parent.jngo_nextBtn").Enable = True
'Else
'	SCREEN.Object("parent.jngo_nextBtn").Enable = False
End If

SCREEN.Object("main.GUIDE").text = LEDGER.Emsg

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	If Trim(GRID0.GetGridCell(GRID0.Row, 1)) <> "" Then
		'가능수량
		SCREEN.Object("main.canbuy").data = Trim(GRID0.GetGridCell(GRID0.Row, 7))
		SCREEN.Proc "main.Setting_canbuy", ""
		SCREEN.Object("main.chae_nm").data = Trim(GRID0.GetGridCell(GRID0.Row, 3))
		'채권인지 주식인지 구별
		If Trim(Left(GRID0.GetGridCell(GRID0.Row, 1), 1)) = "A" Then
			SCREEN.Object("main.1301").data = Mid(Trim(GRID0.GetGridCell(GRID0.Row, 1)),2,6)
			SCREEN.Proc "main.Setting_jusik", ""


		Else
			SCREEN.Object("main.zIsuNo_chae").data = Trim(GRID0.GetGridCell(GRID0.Row, 1))
			SCREEN.Proc "main.Setting_chae", ""

		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
zAcntNo.Data = "00110001666"
zPwd.Data = "0423"

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


