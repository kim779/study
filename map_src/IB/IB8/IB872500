RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim startFlag
startFlag = 0

Sub clearSelData()
	jmcd.Clear
	jmnm.Clear
	strtDt.Clear
	gubn.Clear
	isProc.Clear
	isTJSMDown.Clear
End Sub

Sub SetUtab0()
	UTAB0.Index = 1
	obj3.SetObject "IB840240"
End Sub

Sub SetJmInfo()
	If Trim(SCREEN.Object("main.isProc").Data) <> "진행중" Then
		Exit Sub
	End If

	If Trim(SCREEN.Object("main.jmcd").Data) = "" Then
		Exit Sub
	End If

	If Len(Trim(jmcd.Data)) <> 7 Then
		SCREEN.Object("obj1.chae").Checked = True
		SCREEN.Object("obj1.zIsuNo_chae").Data = Trim(jmcd.Data)
		SCREEN.Object("obj1.chae_nm").Data = Trim(jmnm.Data)
		SCREEN.Proc "obj1.set_chae", ""
	Else
		SCREEN.Object("obj1.jusik").checked = True
		SCREEN.Object("obj1.zIsuNo").data = Mid(Trim(jmcd.Data), 2)
		SCREEN.Object("obj1.jusik_nm").data = Trim(jmnm.Data)
		SCREEN.Proc "obj1.set_jusik", ""
	End If
End Sub

_AW_ONSTART_AW_
Call SetUtab0()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(UTAB0)
_AW_ONCLICK_AW_
GUIDE.Text = ""

Select Case UTAB0.Index
	Case 1 : obj3.SetObject "IB840240"
	Case 2 : obj3.SetObject "IB840230"
	Case 3 : obj3.SetObject "IB84026C"
End Select
_AW_ONENDSUB_AW_
