Sub InitIMAX
	If m_binit = False Then
		ed_initimax.Data = l_initimax("ctrl_jango")
		m_binit = True
		GetParentGroupAdnSkin()
	End If
End Sub



Sub SetGridDataToIMAX()
	Dim ii
	Dim strData
	Dim code
	Dim row_cnt, send_cnt
	Dim temp

	temp = 0
	row_cnt = Len(VIEWGRID.Rows)
	For ii=1 To 4 - row_cnt
		send_cnt = send_cnt & "0"
	Next

	send_cnt = send_cnt & CStr(VIEWGRID.Rows)
	strData = send_cnt & vbTab

	For ii = 1 To VIEWGRID.Rows   							'거래소
		If VIEWGRID.GetGridCell(ii, 15) = "71"	Then
	 		code = "104"  '홍콩
	 	ElseIf VIEWGRID.GetGridCell(ii, 15) = "72"	Then
	 		code = "215"  '상해
	 	ElseIf VIEWGRID.GetGridCell(ii, 15) = "73"	Then
	 		code = "214"  '심천
	 	ElseIf VIEWGRID.GetGridCell(ii, 15) = "81"	Then
	 		code = "321"  '뉴욕
	 	ElseIf VIEWGRID.GetGridCell(ii, 15) = "82"	Then
	 		code = "537"  '나스닥
	 	ElseIf VIEWGRID.GetGridCell(ii, 15) = "87"	Then
	 		code = "66"  '아맥스
	 	End If

		strData = strData & code & vbTab & Trim(VIEWGRID.GetGridText(ii, 3)) & vbTab & Trim(VIEWGRID.GetGridText(ii, 5))
		strData = strData & vbTab & Trim(VIEWGRID.GetGridText(ii, 2))
		strData = strData & vbTab & Trim(VIEWGRID.GetGridText(ii, 1)) & vbTab & Trim(VIEWGRID.GetGridText(ii, 4))
	    strData = strData & vbTab & Trim(VIEWGRID.GetGridText(ii, 8))
		strData = strData & vbTab & Trim(VIEWGRID.GetGridText(ii, 6)) & vbTab & Trim(VIEWGRID.GetGridText(ii, 13))
		strData = strData & vbTab & Trim(VIEWGRID.GetGridText(ii, 7)) & vbTab & Trim(VIEWGRID.GetGridText(ii, 17))
		strData = strData & vbTab & Trim(VIEWGRID.GetGridText(ii, 18)) & vbTab & Trim(VIEWGRID.GetGridText(ii, 14)) '평가손익
		strData = strData & vbTab & Trim(VIEWGRID.GetGridText(ii, 20)) & vbTab & Trim(VIEWGRID.GetGridText(ii, 21))
		strData = strData & vbTab & vbLf

	Next

	ctrl_jango.SetIMAXData 0, strData
	'cur = VIEWGRID.Rows
End Sub

'== 첫 조회
Sub send_f()
	VIEWGRID.Clear
	next_btn.Enable = True
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	VIEWGRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

