_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

LEDGER.Rcnt = "0019"

AN19.Data = Trim(SCREEN.Object("main.obj0.AN19").Data)
zPwd.Data = Trim(SCREEN.Object("main.obj0.zPwd").Data)

SYSTEM.Trace "AN19.Data:"&AN19.Data
SYSTEM.Trace "zPwd.Data:"&zPwd.Data



If SYSTEM.ConnectBy = "0" Then
	   zPwd.Data = "9999"
Else
	If Len(Trim(zPwd.Data)) < 4 Then
		SCREEN.Object("parent.GUIDE").Text = "비밀번호를 입력하십시오."
		Exit Sub
	End If

	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If  Len(Trim(zPwd.Data)) >= 4 Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If

