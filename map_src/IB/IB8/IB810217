Dim user_acc, item, items, account519, add_item
Dim account(100), count913, ii, jj, a, b, bIn, final_acct(100), fCount

Sub AcctSetting()
	user_acc = Trim(SCREEN.Object("parent.CMB_ACCT").Text)

	item = ""
	items = ""
	count913 = 0
'	SYSTEM.Trace "selectAcct : " & user_acc
'	SYSTEM.Trace "FindYackAcct in 519 Service : " & YChk.Data
	For ii=1 To GRID0.Rows
		If Trim(GRID0.getgridcell(ii, 9)) <> "" Then

			item = Trim(GRID0.GetGridtext(ii,9))

			If Mid(item,5,2) <> "00" And Len(Trim(GRID0.GetGridCell(ii,9))) = 11 Then

				'앞 3자리 뒤에 6자리가 같은 계좌는 추가, 가운데까지 같은 계좌는 제외
				If Mid(user_acc,1,3) = Mid(item, 1,3) Then
					If Mid(user_acc,8,6) = Mid(item, 8,6) Then
						If Mid(user_acc,5,2) <> Mid(item, 5,2) And Mid(item, 5,2) <> "00" Then
							If Mid(item, 5,2) = "10" Or Mid(item, 5,2) = "11" Or Mid(item, 5,2) = "30" Then
								items = items & vbTab & item
								account(count913) = Trim(Replace(item, "-", ""))
								count913 = count913 + 1
'								SYSTEM.Trace "account_913 Service : " & item
							End If
						End If
					End If
				End If
			End If
		End If
	Next

'	SYSTEM.Trace "count of 913 : " & count913

	'1일경우 519서비스에서 약정된 계좌가 안나왔음으로 선택한 계좌의 상품구분만 틀린 계좌만 보여준다
	If Trim(YChk.Data) = "1" Then
		SCREEN.Object("parent.CMB_ACCT2").SetItems("")
		SCREEN.Object("parent.CMB_ACCT2").SetItems(items)
		Exit Sub
	End If

	'다른 계좌중에 약정된 계좌는 보여준다
	'SACAQ519에서 현재 등록된 계좌외에에 모든 약정계좌를 뿌려준다
	For ii=1 To SCREEN.Object("parent.obj_yackAccnStatus.GRID0").Rows

		If Trim(SCREEN.Object("parent.obj_yackAccnStatus.GRID0").getgridcell(ii, 5)) <> "" Then

			account519 = Trim(SCREEN.Object("parent.obj_yackAccnStatus.GRID0").GetGridtext(ii,5))

			a = -1

			For jj=1 To count913
				If account519 = account(jj) Then
					a = 0
				End If
			Next



			If a = -1 Then
				add_item = Mid(account519,1,3) & "-" & Mid(account519,4,2) & "-" & Mid(account519,6,6)
'				SYSTEM.Trace "account_519 Service : " & add_item
				items = items & vbTab & add_item
			End If
		End If

	Next

	SCREEN.Object("parent.CMB_ACCT2").SetItems(items)
End Sub

