Sub LoadAccounts()



	Dim accList, ii, acc, acno, ACNM, acid, actp, idx, myAcntFlag, value
	accList = Split(CX_DTS.GetTypeData ("4","1" ), vbLf, -1, vbTextCompare)  'accoutcc 로 전계좌 불러오기 0->1

	zAcnt1.Data = AN50.data

	idx = 1

	SYSTEM.Trace "LoadAccounts zAcnt1.Data:"&zAcnt1.Data

	For ii=0 To UBound(accList)
		acc = Trim(accList(ii))

		If Len(acc)>11 Then
			acc = Split(acc, "|", -1, vbTextCompare)
			acno = Trim(Mid(acc(0), 1, 11))
			ACNM = Mid(acc(0), 12)
			ACNM = Replace(ACNM, vbTab, "")
			ACNM = Trim(ACNM)
			acid = Trim(acc(1))
			actp = Mid(acno, 4, 2)
			myAcntFlag = acc(2)
			SYSTEM.Trace "start logic acno:"&acno
            SYSTEM.Trace "myAcntFlag:"&myAcntFlag
			'계좌플래그 2 또는 3 이면 랩계좌, 법인계좌 타입 = 4
			If chkNumericData(myAcntFlag) = True Then
				value = myAcntFlag And 4    '법인계좌 4 와 And 연산
			    If value = 0 Then
                   SYSTEM.Trace "person"
                   corpyn = "N"
                Else
                   If Trim(zAcnt1.Data) = Trim(acno) Then
                   	  SYSTEM.Trace "corp"
                   	  corpyn = "Y"
                   	  SYSTEM.Trace "end logic corpyn:"&corpyn
                   	  Exit Sub
                   End If
				End If
			End If
		End If
	Next

End Sub

