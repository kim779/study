_AW_ONDECLARE_AW_
Option Explicit
Dim corpyn
Dim dmsg

Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj_list.ClearAll 2
	aa.Clear
	zPwd.Clear

	If Trim(SCREEN.Object("main.zAcntNo").Data) <> Trim(AN50.Data) Then
		SCREEN.Object("main.zAcntNo").Data = Trim(AN50.Data)
		SCREEN.Object("main.zPwd").Data = ""
	End If

	If Len(Trim(AN50.Data)) = 11 Then
		ACNM.Data = Trim(AN50.Name)
		zPwd.Data = Trim(AN50.Password)

		If Trim(zPwd.Data) = "" Then
			If Trim(SCREEN.Object("main.zAcntNo").Data) = Trim(AN50.Data) Then
				If Len(Trim(SCREEN.Object("main.zPwd").Data)) >= 4 Then
					zPwd.Data = Trim(SCREEN.Object("main.zPwd").Data)
				End If
			End If
		End If

		If SYSTEM.ConnectBy = 1 Then
			If Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If
		End If

		SCREEN.Proc "obj_list.send_f", ""
	Else
		AN50.SetFocus
		Exit Sub
	End If
End Sub

'== 첫 조회
Sub send_f()
	sendType.Data = "Q"
	SCREEN.ClearAll 0, 2
	ACNM.Data = Trim(AN50.Name)

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 전송
Sub send_o()
	LEDGER.Fkey = "5"
	sendType.Data = "O"
	SCREEN.Send 0
End Sub

Sub confirmOrder()
	SYSTEM.Push "fundLoan_8505", ""

    '여신거래 안심차단 로직추가
    SYSTEM.Trace "applLoan_zObjYn:"&zObjYn.Data
    If zObjYn.Data = "Y" Then
       Call popup()
       Exit Sub
    End If

	If chkInpt() = False Then
		Exit Sub
	End If

	Dim odrGubn, odrName

	If zTrxTp.Data = "0" Then
		odrGubn = "신청"
		odrName = "신청금액"
	Else
		odrGubn = "해지"
		odrName = "해지금액"
	End If

	dmsg = "odrGubn" & vbTab & odrGubn         & vbLf &_
		   "odrName" & vbTab & odrName         & vbLf &_
		   "o_acno"  & vbTab & Trim(AN50.Data) & vbLf &_
		   "o_acnm"  & vbTab & Trim(ACNM.Data) & vbLf &_
		   "o_aa"    & vbTab & Trim(aa.Data)   & vbLf

	SCREEN.SetTimer 10, False

End Sub


Function chkInpt()
	Dim msg

	chkInpt = False

	If Len(Trim(AN50.Data)) <> 11 Then
		msg = "계좌번호(ex.xxx-53-xxxxxx)를 확인하여 주십시오."
		Call alert_msg(msg)
		Call guide_msg(msg)
		AN50.SetFocus
		Exit Function
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		msg = "비밀번호를 확인하여 주십시오."
		Call alert_msg(msg)
		Call guide_msg(msg)
		zPwd.SetFocus
		Exit Function
	End If

	If Is_numeric(aa.Data) = False Then
		msg = "금액을 확인하여 주십시오."
		Call alert_msg(msg)
		Call guide_msg(msg)
		aa.SetFocus
		Exit Function
	End If

	chkInpt = True
End Function


