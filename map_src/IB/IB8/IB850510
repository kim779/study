Sub complete_cusstatus()

	Dim char,check_char,tmptujaYN,tmpinfoYN,tmptujaNM,tmptujaGD,tempYN

	tmptujaYN = Trim(SCREEN.Object("obj_cusstatus.OUTPUT7").Data)
	tmpinfoYN = Trim(SCREEN.Object("obj_cusstatus.OUTPUT8").Data)
	tmptujaNM = Trim(SCREEN.Object("obj_cusstatus.zGrdNm").Data)

	If Trim(tmptujaYN) = "0" Then
		tmptujaYN = "미희망"
	Else
		tmptujaYN = "희망"
	End If

	If tmptujaNM = "안정형" Then
		check_char = 1
	ElseIf tmptujaNM = "안정추구형" Then
		check_char = 2
	ElseIf tmptujaNM = "위험중립형" Then
		check_char = 3
	ElseIf tmptujaNM = "적극투자형" Then
		check_char = 4
	ElseIf tmptujaNM = "공격투자형" Then
		check_char = 6
	End If

