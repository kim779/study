'--계좌번호, 계좌명 세팅
Sub acct_set()
	If Len(CMB_ACCT.Data) = 11 Then
		Dim tmpAcnm
		tmpAcnm = Split(Trim(CMB_ACCT.Text), " ")

		ACNM.Data = tmpAcnm(2)
		If SYSTEM.ConnectBy = "0" Then
			zPwd.Data = "9999"
		End If

		Call send_f()
	Else
		CMB_ACCT.SetFocus
	End If
End Sub


'== 첫 조회
Sub send_f()
	'SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub


Sub chkdate()
	Dim dyear

	dyear = Year(Date)

	If dyear < CDbl(zSrtDt1.Data) Or CDbl(zEndDt1.Data) < CDbl(zSrtDt1.Data) Then
		MsgBox "시작분기의 미래값입력 오류 입니다.",0,"IBK투자증권"
	End If

	If CDbl(zEndDt1.Data) = CDbl(zSrtDt1.Data) And CDbl(COMBO1.Data) < CDbl(COMBO0.Data) Then
		MsgBox "시작분기의 미래값입력 오류 입니다.",0,"IBK투자증권"
	End If
End Sub

Sub SetDate()
	Dim sYear, sQuarter, sMonth

	sYear = Year(DateAdd("m", -3, Date))
	sMonth = Month(DateAdd("m", -3, Date))

	Select Case sMonth
		Case 1,2,3
			sQuarter = 1
		Case 4,5,6
			sQuarter = 2
		Case 7,8,9
			sQuarter = 3
		Case 10,11,12
			sQuarter = 4
	End Select

	zEndDt.Data = sYear & "0101"
	zEndDt1.Data = Left(zEndDt.Data,4)
	COMBO1.Data = sQuarter

	zSrtDt.Data = sYear & "0101"
	zSrtDt1.Data = Left(zSrtDt.Data,4)
	COMBO0.Data = sQuarter
End Sub

Sub ChkRange()
	Dim dYear, sQuarter, dMonth, curtmp, custmpSrt,custmpEnd

	dyear = Year(Date)
	dMonth = Month(Date)

	Select Case dMonth
		Case 1,2,3
			sQuarter = 1
		Case 4,5,6
			sQuarter = 2
		Case 7,8,9
			sQuarter = 3
		Case 10,11,12
			sQuarter = 4
	End Select

	curtmp = dyear *10 + sQuarter
	custmpSrt = CDbl(zSrtDt1.Data)*10 + CDbl(COMBO0.Data)
	custmpEnd = CDbl(zEndDt1.Data)*10 + CDbl(COMBO1.Data)

	'MsgBox "curtmp : " & curtmp & " custmpSrt : "&custmpSrt & " custmpEnd : "&custmpEnd,0,"IBK투자증권"

	If curtmp < custmpSrt Or curtmp < custmpEnd Then
	  MsgBox "기준분기의 미래값 입력 오류입니다.",0,"IBK투자증권"
	  Call SetDate()
	End If

End Sub







