Sub DoOrderL()
	If Trim(CMB_ACCT.Text) = "" Then
		Call alert_msg("증권계좌번호를 확인하여 주십시오.")
		CMB_ACCT.SetFocus
		Exit Sub
	End If

	If Trim(ibkAccnAlert.Text) <> "" Then
		Call alert_msg(ibkAccnAlert.Text)
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		Call alert_msg("증권계좌 비밀번호를 확인하여 주십시오.")
		zPwd.SetFocus
		Exit Sub
	End If

	If Trim(CMB_ACCT2.Text) = "" Then
		Call alert_msg("조회버튼을 클릭하여 출금계좌번호를 확인하여 주십시오.")
		BUTTON2.SetFocus
		Exit Sub
	End If

'	If Trim(OUT_ACNM.Data) = "" Then
'		Call alert_msg("예금주조회버튼을 클릭하여 예금주 조회를 해주십시오.")
'		BTNNAME.SetFocus
'		Exit Sub
'	End If

	If Len(Trim(EDIT_PWD.Data)) < 4 Then
		Call alert_msg("출금계좌 비밀번호를 확인하여 주십시오.")
		EDIT_PWD.SetFocus
		Exit Sub
	End If

	If checkInptVal(EDIT_AMT.Data) = False Then
		Call alert_msg("이체금액을 확인하여 주십시오.")
		SCREEN.Object("main.guide").text = ""
		EDIT_AMT.SetFocus
		Exit Sub
	End If

	Dim dmsg, ACNT2, acn2

	ACNT2 = CMB_ACCT2.text
	acnt = Left(Trim(CMB_ACCT.Text), 13)

	dmsg = 	"o_name" & vbTab & CMB_NAME.Text & vbLf &_
			"o_acn1" & vbTab & CMB_YACCT.text & vbLf &_
			"o_amt" & vbTab & EDIT_AMT.Data & vbLf &_
