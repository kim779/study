_AW_ONDECLARE_AW_
'--계좌번호, 계좌명 세팅
Sub acct_set()
	Dim account, acct1, acct2

	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text

	account = Trim(CMB_ACCT.Data)
	zAcntNo.Data = account
	acct1 = Mid(zAcntNo.data,1,3)
	acct2 = Mid(zAcntNo.data, 6, 6)
	totacnt.Data  = acct1 & "00" & acct2
	AN00.data = zAcntNo.Data
	zPwd.Data = AN00.Password

	Call Clear()
	CMB_ACCT2.SetItems ""
	ibkAccnAlert.Text = ""
	SCREEN.Object("main.GUIDE.GUIDE").Text = ""

	If Trim(CMB_ACCT.Text) <> "" Then
		If Left(Trim(CMB_ACCT.Text), 3) = "501" Then
			Dim ii, accnListGr, tmpAccn, accnMgNo, dmsg
			Set accnListGr = SCREEN.Object("parent.obj_acct.GRID0")
			accnMgNo = ""

			For ii = 1 To accnListGr.Rows
				tmpAccn = Trim(accnListGr.GetGridCell(ii, 9))

				If tmpAccn = Trim(CMB_ACCT.Data) Then
					accnMgNo = Trim(accnListGr.GetGridCell(ii, 7))
					Exit For
				End If
			Next

			If Trim(accnMgNo) = "" Then

			Else
				If accnMgNo <> "501" Then
					dmsg = "기업은행 개설계좌중 지점 이관계좌는 이체가 불가능합니다."
					ibkAccnAlert.Text = dmsg
					'Call alert_msg(dmsg)
					SCREEN.Object("main.GUIDE.GUIDE").Text = dmsg
				End If
			End If
		End If
	End If
End Sub

'비밀번호 검증
Sub checkPassword()
	Dim tmpAcct, tmpPwd
	tmpAcct = Trim(CMB_ACCT.Data)
	tmpPwd = Trim(zPwd.Data)

	If Len(tmpAcct) <> 11 Then
		MsgBox "증권계좌번호를 확인하여 주십시오.", , "IBK투자증권"
		CMB_ACCT.SetFocus
		Exit Sub
	End If

	If Len(tmpPwd) < 4 Then
		MsgBox "증권계좌비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Object("chk_passwd.IntaccNo").data = tmpAcct
	SCREEN.Object("chk_passwd.Pwd").data = tmpPwd
	chk_passwd.Send
End Sub

'비밀번호 검증 성공시
Sub passPW()
	SCREEN.Object("chk_YJ.zAcntNo").Data = zAcntNo.Data
	SCREEN.Object("chk_YJ.zInptPwd").Data = zPwd.Data
	chk_YJ.proc "send_bank", ""
End Sub

Sub clearInput()
	zPwd.Clear
	CMB_ACCT2.SetItems ""
	EDIT_PWD.Clear
	lMnyrclOdpntRepayAmt.Clear
	OUT_ACNM.Clear
	EDIT_AMT.Clear
End Sub


