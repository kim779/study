Sub send_c()
'	SYSTEM.Trace "Send_c"
	LEDGER.Fkey = "7"
	nextgbn.Text = CLng(nextgbn.text) + 1
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Function Error_check()
	Error_check = False

	If Len(Trim(AN1A.Data)) < 11 Then
		GUIDE_msg("계좌번호를 확인하십시오")
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus()
		Exit Function
	End If
	If Len(Trim(zPwd.Data)) < 4 Then
		guide_msg("비밀번호를 확인하십시오")
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus()
		Exit Function
	End If

	Error_check = True
End Function

