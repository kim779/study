	SCREEN.Object("parent.BTNSEND").SetFocus
End If
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
'== 보안카드번호 입력 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	SCREEN.Proc "parent.DoOrder", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


