RESOURCE DIVISION
{


_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

If Trim(lOnesfCnfTrxSeqno.Data) = "" Or Trim(zSecurCardInptNo1.Data) = "" Or Trim(zSecurCardInptNo2.Data) = "" Then
	If Trim(searchMsg.Text) <> "" Then
		MsgBox Trim(searchMsg.Text), , "IBK투자증권"
		Exit Sub
	End If
End If

If Trim(zSecurCardInpt1.data) = "" Or Trim(zSecurCardInpt2.data) = "" Then
	Call alert_msg("보안 카드 번호를 입력해주십시오.")
	zSecurCardInpt1.SetFocus
End If

If Trim(zSecurCardInpt1.data) <> "" And Trim(zSecurCardInpt2.data) <> "" Then
	SCREEN.OnSend True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
cnt.Data = lRetryAbleCnt.data
If Trim(zErrMsgCode.Data) = "0000" Then
	SCREEN.SetTimer 4, False
'	Call alert_msg(Mid(Trim(LEDGER.Emsg), 5))
Else
	Call alert_msg(zErrMsgCode.Data & " " &  Trim(zErrMsgCnts.Data) & vbLf & "재시도 가능 횟수는 "& Trim(cnt.Data) & "번 남았습니다.")
	zSecurCardInpt1.Clear
	zSecurCardInpt2.Clear
	SCREEN.Proc "parent.OTP_setting", ""
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Proc "parent.send", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zErrMsgCode)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCnts)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zSecurCardInpt2)
_AW_ONCHANGE_AW_
