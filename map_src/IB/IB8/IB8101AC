RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Send_F()
	Call startinit()
	LEDGER.Fkey = "C"
	'SCREEN.Send 0
	GUIDE.Text = LEDGER.Emsg
End Sub


Sub startinit()
	INA.Data = "00001"
	If Trim(SCREEN.Object("parent.bank_code").data) = "" Then
		bankcode.Data = ""
		If SCREEN.Object("parent.F1").Checked = True Then
			bankacc.Data = Left(Replace(Trim(SCREEN.Object("parent.CMB_ACCT2").text), "-", ""), 11)
		Else
			bankacc.Data = Replace(Trim(SCREEN.Object("parent.EDIT_ACCT").data), "-", "")
		End If
	Else
		bankcode.Data = Trim(SCREEN.Object("parent.bank_code").data)
		bankacc.Data = Trim(SCREEN.Object("parent.EDIT_ACCT").data)
	End If
	delaytime.Data = "0"
	acc1.Data = Replace(Trim(SCREEN.Object("parent.CMB_ACCT").text),"-","")

	If UCase(TypeName( SCREEN.Object("parent.ed_FIN_FDS") )) <> "NOTHING" Then
SYSTEM.Trace "[BANK][IB8101AC] --FDS--  startinit ed_FIN_FDS = " & SCREEN.Object("parent.ed_FIN_FDS").Data
		If SCREEN.Object("parent.ed_FIN_FDS").Data = "1" Then
			SCREEN.Object("parent.ed_FIN_FDS").Data = ""
			bankcode.Data = "FIN"
		End If
	End If

End Sub

_AW_ONSEND_AW_
SYSTEM.Trace "[BANK][IB8101AC] --FDS--  OnSend"
Call Send_F()

SYSTEM.Trace "[BANK][IB8101AC][OnSend] --FDS-- bankcode = " & bankcode.Data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
