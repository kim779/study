'SYSTEM.Trace "result : "&result.Data
'SYSTEM.Trace "senarioid : "&senarioid.Data
'SYSTEM.Trace "filler : "&filler.Data
'SYSTEM.Trace "GUIDE : "&GUIDE.text
bankcode.Data = ""
SYSTEM.Trace "[BANK][IB8101AC] --FDS--  MapName0[" & SCREEN.GetMapName(0) & "] MapName1[" & SCREEN.GetMapName(1) & "]"
SYSTEM.Trace "[BANK][IB8101AC]<SAMST002>[rev] --FDS--  MapName = " & MapName.Data
SYSTEM.Trace "[BANK][IB8101AC]<SAMST002>[rev] !!!--FDS--!!!  result = " & result.Data
SYSTEM.Trace "[BANK][IB8101AC] --FDS--  GUIDE : "&GUIDE.text

SCREEN.Proc "parent.RecvFDS", MapName.Data

