_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Function Find_Row(acc_no, mtp,code)


	For row = 1 To GRID0.Rows
		If Trim(acc_no) = Trim(GRID0.GetGridCell (row, 2)) _
				And Trim(mtp) = Trim(GRID0.GetGridCell (row, 4)) _
				And Trim(code) = Trim(GRID0.GetGridCell (row, 6)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

_AW_ONSEND_AW_
LEDGER.Rcnt = "0040"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, jj, Ordqty, chgqty,sAccList

If LEDGER.Next = "Y" Then
	Send_c()

Else

	For ii= 1 To GRID0.Rows
		sAccList = sAccList & GRID0.GetGridCell(ii,3) & vbTab
	Next
	'MsgBox sAccList
'	SYSTEM.Trace "GRID0.Rows: " & CStr(GRID0.Rows)
	If GRID0.Rows = 0 Then sAccList = ""
	Call SCREEN.Object("main.control0").SetFilterAcc(sAccList)
	SCREEN.Object("main.send_btn").Enable = True
	SCREEN.Proc "main.send_f", ""
End If

