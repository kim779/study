Function DateTimeConvert(Str)
	If Len(Str) = 1 Then
		Str = "0" & Str
	End If

'	If Trim(Str) = "11" Then
'		Str = "1 1"
'	ElseIf Mid(Str, 2, 1) = "1" Then
'		Str = Mid(Str, 1, 1) + " 1"
'	End If

	If Left(Str, 1) = "1" Then
		Str = " " & Str
	End If

	If Right(Str, 1) = "1" Then
		Str = Mid(Str, 1, Len(Str)-1) & " 1"
	End If

	DateTimeConvert = Str
End Function


Function DateTimeConvert_1(Str)
	If Len(Str) = 1 Then
		Str = "0" & Str
	End If

	If Right(Str, 1) = "1" Then
		Str = Mid(Str, 1, Len(Str)-1) & " 1"
	End If

	DateTimeConvert_1 = Str
End Function

