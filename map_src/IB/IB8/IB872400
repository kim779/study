_AW_ONDECLARE_AW_
Sub LoadAccounts()

	Dim accList, ii, acc, acno, acnm, acid, actp, items, myAcntFlag

	accList = Split(CX_DTS.GetTypeData ("4","" ), vbLf, -1, vbTextCompare)

	items = vbTab
	For ii=0 To UBound(accList)
		acc = Trim(accList(ii))
		If Len(acc)>11 Then
			acc = Split(acc, "|", -1, vbTextCompare)
			acno = Trim(Mid(acc(0), 1, 11))
			acnm = Mid(acc(0), 12)
			acnm = Replace(acnm, vbTab, "")
			acnm = Trim(acnm)
			acid = Trim(acc(1))
			actp = Mid(acno, 4, 2)
			myAcntFlag = acc(2)

			If chkNumericData(myAcntFlag) = True Then
				If CLng(myAcntFlag) < 2 Then
					If actp="10" Or actp="51" Or actp="11" Or actp="30" Or actp="50" Or actp="53" Then
						items = items & acno&Left(acno,3)&"-"& Mid(acno,4,2)&"-"&Right(acno,6)&" "&acnm & vbTab
					End If
				'items += acno & vbTab   				'SYSTEM.Trace ("계좌" &  acno & acc & acnm)
				End If
			End If

		End If
	Next

	'COMBO0.SetItems(items)
	SCREEN.Object("main.OBJECT0.COMBACC").SetItems(items)
End Sub

Sub LoadAccounts2()

	Dim accList, ii, acc, acno, acnm, acid, actp, items

	accList = Split(CX_DTS.GetTypeData ("4","" ), vbLf, -1, vbTextCompare)

	items = vbTab

	For ii=0 To UBound(accList)
		acc = Trim(accList(ii))
		If Len(acc)>11 Then
			acc = Split(acc, "|", -1, vbTextCompare)
			acno = Trim(Mid(acc(0), 1, 11))
			acnm = Mid(acc(0), 12)
			acnm = Replace(acnm, vbTab, "")
			acnm = Trim(acnm)
			acid = Trim(acc(1))
			actp = Mid(acno, 4, 2)

			If actp="20" Or actp="21" Then
				items = items & acno & Left(acno,3) &"-"& Mid(acno,4,2) &"-"& Right(acno,6) & " " & acnm & vbTab
			End If
			'items += acno & vbTab   				'SYSTEM.Trace ("계좌" &  acno & acc & acnm)
		End If

	Next

	'COMBO0.SetItems(items)
	SCREEN.Object("main.OBJECT0.COMBACC").SetItems(items)
End Sub


