{


_AW_ONDECLARE_AW_
Dim g_GraphControl

g_GrpCtrls = Array(ot_epf2, lb_Elw, ot_grpe, ot_grpm, ot_grps, lb_BefPf, lb_AftPf, ot_bfam, ot_afam)
g_InitCtrls = Array(ed_amot1, ed_amot2, ed_amot3)
'------------------------------------------------------------------
Function GetFundsAmt()
	GetFundsAmt = ""
	TotAmt = 0
	For i = LBound(g_InitCtrls) To UBound(g_InitCtrls)
		Amt = Trim(g_InitCtrls(i).Data)
		If Len(Amt) <> 0 Then
			TotAmt = TotAmt + CLng(Amt)
		End If
	Next
	GetFundsAmt = TotAmt
End Function
'------------------------------------------------------------------
Sub InitDescCtrls()
	ADate = ot_date.Data
	AYear = FormatNumber(ADate/10000, 0, -2, -2, 0)
	AMon = FormatNumber((ADate Mod 10000) / 100, 0, -2, -2, 0)
	ADay = ADate Mod 100

	If Len(AMon) = 1 Then
		AMon = "0" & AMon
	End If

	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If


	lb_Date.Data = AYear & "/" & AMon & "/" & ADay
	lb_InitAmt.Data = FormatNumber(GetFundsAmt(), 0)
	If Trim(lb_InitAmt.Data) = "0" Then
		lb_InitAmt.Data = ""
	End If
End Sub
'------------------------------------------------------------------
Sub GrpCtrlsVisible(Data)
	For i = LBound(g_GrpCtrls) To UBound(g_GrpCtrls)
		g_GrpCtrls(i).Visible = Data
	Next
End Sub
'------------------------------------------------------------------
Sub SetFundNm(Data)
	cb_FdNm1.SetItems(Data)
	cb_FdNm2.SetItems(Data)
	cb_FdNm3.SetItems(Data)

	cb_FdNm1.Index = 0
	cb_FdNm2.Index = 0
	cb_FdNm3.Index = 0
End Sub
'------------------------------------------------------------------
Function CtrlCheck()
	CtrlCheck = False
	Data1 = Trim(ed_amot1.Data)
	Data2 = Trim(ed_amot2.Data)
	Data3 = Trim(ed_amot3.Data)

	If Len(Data1) = 0 And Len(Data2) = 0 And Len(Data3) = 0 Then
		GUIDE1.Text = "초기투자금액에 금액을 입력해주십시요."
		Exit Function
	End If

	Data1 = CLng(Data1)
	Data2 = CLng(Data2)
	Data3 = CLng(Data3)

	If Data1 = 0 And Data2 = 0 And Data3 = 0 Then
		GUIDE1.Text = "초기투자금액에 금액을 입력해주십시요."
		Exit Function
	End If

	If Data1 > 200000000 Or Data2 > 200000000 Or Data3 > 200000000 Then
		GUIDE1.Text = "초기투자금액의 합은 2억원을 초과할 수 없습니다."
		Exit Function
	End If

	Amt = CLng(Data1) + CLng(Data2) + CLng(Data3)
	If Amt > 200000000 Then
		GUIDE1.Text = "초기투자금액의 합은 2억원을 초과할 수 없습니다."
		Exit Function
	End If
	CtrlCheck = True
End Function
'------------------------------------------------------------------
Sub SetGraphData(StartData, EndData, BefAmt, BakAmt)
	StartY = BOX0.Bottom
	StartX = BOX0.Left
	Height = BOX0.Bottom - BOX0.Top

	TotDiff = EndData - StartData
	BefDiff = BefAmt - StartData
	BakDiff = BakAmt - StartData

	BefRate = BefDiff/TotDiff
	BakRate = BakDiff/TotDiff

	BefHeight = FormatNumber(BefRate*Height, 0, -2, -2, 0)
	BakHeight = FormatNumber(BakRate*Height, 0, -2, -2, 0)


	ot_bfam.Bottom = StartY
	ot_bfam.Top = StartY - BefHeight
	ot_afam.Bottom = StartY
	ot_afam.Top = StartY - BakHeight

	Height = ot_bfam.Top - ot_afam.Top

'	If Height < 16 And Height > -16 Then
'		pn_Color.Visible = True
'
'		ot_epf2.Top = ot_afam.Top - 36
'		ot_epf2.Bottom = ot_afam.Top - 10
'		lb_Elw.Top = ot_epf2.Top
'		lb_Elw.Bottom = ot_epf2.Bottom
'	Else


'		ot_epf2.Bottom = ot_bfam.Top
'		ot_epf2.Top = ot_afam.Top
'		lb_Elw.Bottom = ot_epf2.Bottom
'		lb_Elw.Top = ot_epf2.Top

'	End If
	If ot_afam.Top = ot_bfam.Top Then
		pn_Color.Top = ot_afam.Top
		pn_Color.Bottom = ot_bfam.Top + 1
	Else
		pn_Color.Top = ot_afam.Top
		pn_Color.Bottom = ot_bfam.Top
	End If

End Sub

