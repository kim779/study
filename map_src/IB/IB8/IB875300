GrpCtrlsVisible False
InitDescCtrls
OBJ0.Send

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
DnRate = Trim(ed_drt3.Data)

If Len(DnRate) = 0 Then
	SCREEN.OnSend = False
	Exit Sub
End If

If DnRate < 0 Then
	ed_drt3.Data = DnRate * (-1)
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Data = Trim(ot_elpf.Data)
StartData = Trim(ot_grps.Data)
EndData = Trim(ot_grpe.Data)

If Len(Data) <> 0 And Len(StartData) <> 0 And Len(EndData) <> 0 Then
	If StartData <> 0 And EndData <> 0 Then
		BefAmt = Trim(ot_bfam.Data)
		BakAmt = Trim(ot_bksa.Data)
		If Len(BefAmt) <> 0 And Len(BakAmt) <> 0 Then
			If BefAmt <> 0 Then
				InitDescCtrls
				GrpCtrlsVisible True
				SetGraphData StartData, EndData, BefAmt, BakAmt
			Else
				GrpCtrlsVisible False
			End If
		Else
			GrpCtrlsVisible False
		End If
	Else
		'GrpCtrlsVisible False
	End If
End If

SMsg = Trim(ot_omsg.Data)

If Len(SMsg) = 0 Then
	GUIDE1.Text = " "
Else
	GUIDE1.Text = SMsg
End If

