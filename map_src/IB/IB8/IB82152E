RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
SCREEN.OnSend = False

zPwd = SCREEN.Object("main.zPwd").data

If Len(Trim(zPwd)) < 4 Then
	Exit Sub
End If


EDIT0.Data = "00001"
AcntNo.Data = SCREEN.Object("main.AN98").data
AccountType = Mid(AcntNo.Data, 4,2)
If AccountType = "10" Or AccountType = "11" Then
	TrxTp.Data = "2"
ElseIf AccountType = "20" Then
	TrxTp.Data = "1"
Else
	Exit Sub
End If



SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
BascMny = GRID0.GetGridCell (1,3)
BascMny = Mid(BascMny, 2, 15)

'BascMny = CLng(BascMny)

'SYSTEM.Trace "BascMny ==> [" & Len(Trim(BascMny)) & "]"
If Len(Trim(BascMny)) > 0 Then
'	SYSTEM.Trace "12312"
	BascMny = FormatNumber(BascMny, 0)
	SCREEN.Object("parent.BscMny").data = BascMny
End If

SCREEN.Proc "parent.send_f", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


