_AW_SCRIPT_AW_(fundbtn)
_AW_ONCLICK_AW_
Dim acct, msg, fundname
acct = Replace(SCREEN.Object("parent.CMB_ACCT").text, "-", "")

SYSTEM.Push "fundno", ""
SCREEN.CreateWindow 2, "IB810108 /t/d/p5/S", _
		"zAcntNo" & vbTab & acct

msg = SYSTEM.Pop("fundno")
If msg = "NO" Then
	Exit Sub
End If

fundname = Split(msg, "|")
zBncertSellIsuNo.Data = fundname(0)
zBncertSellIsuSeqno.Data = fundname(1)
