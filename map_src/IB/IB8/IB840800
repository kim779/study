RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim str

Sub obj1_to_obj3()
	If SCREEN.Object("obj1.jusik").checked = True Then
		SCREEN.Object("obj3.jusik").checked = True

		If Trim(SCREEN.Object("obj1.zIsuNo").data) <> "" Then
			SCREEN.Object("obj3.no").data = SCREEN.Object("obj1.zIsuNo").data
			SCREEN.Object("obj3.obj.1301").data = SCREEN.Object("obj1.zIsuNo").data
			SCREEN.Object("obj3.obj").send

'			SCREEN.Proc "obj3.set_jusik", ""
		Else
			'obj1의 주식종목에 데이터가 없을 경우
			SCREEN.Object("obj3.no").data = ""
			SCREEN.Object("obj3.obj.1301").data = ""
			SCREEN.Object("obj3.obj").send

'			SCREEN.Proc "obj3.set_jusik_first", ""
		End If

		SCREEN.Proc "obj3.set_jusik", ""

	ElseIf SCREEN.Object("obj1.chae").checked = True Then
		SCREEN.Object("obj3.chae").checked = True

		If Trim(SCREEN.Object("obj1.zIsuNo_chae").data) <> "" Then
			SCREEN.Object("obj3.zIsuNo_chae").data = SCREEN.Object("obj1.zIsuNo_chae").data
			SCREEN.Object("obj3.chae_nm").data = SCREEN.Object("obj1.chae_nm").data
'			SCREEN.Proc "obj3.set_chae", ""
		Else
			SCREEN.Object("obj3.zIsuNo_chae").data = ""
			SCREEN.Object("obj3.chae_nm").data = ""

'			SCREEN.Proc "obj3.set_chae_first", ""
		End If

		SCREEN.Proc "obj3.set_chae", ""
	End If
End Sub

_AW_ONSTART_AW_
SCREEN.SetTimer 10, True

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
'SCREEN.CreateWindow 1, "IB840212 /t/s/p5/", ""

obj1_to_obj3()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(UTAB0)
_AW_ONCLICK_AW_
SCREEN.Object("GUIDE.guide").text = ""

Select  Case (UTAB0.Index)
	Case "0" : obj3.SetObject "IB840820"	 '-- 청약증거금
			   Call obj1_to_obj3()
	Case "1" : obj3.SetObject "IB840830"	 '-- 청약내역조회
				Call obj1_to_obj3()

End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UTAB1)
_AW_ONCLICK_AW_
SCREEN.Object("GUIDE.guide").text = ""
Select  Case (UTAB1.Index)

	Case "0" : obj1.SetObject "IB840840"	 '-- 청약예약
			   UTAB0.Index = 0
			   obj3.SetObject "IB840820"
'			   Call obj1_to_obj3()
	Case "1" : obj1.SetObject "IB840850"	 '-- 청약취소
			   UTAB0.Index = 1
			   obj3.SetObject "IB840830"

End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



