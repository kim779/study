_AW_ONDECLARE_AW_
Option Explicit

Public Today
Today = getCurrDay()

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	GUIDE.Text = ""

	ANCM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	Else
		zPwd.Data = "9999"
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ANCM.Data = Trim(AN1A.Name)
	next_btn.Enable = False

	If SYSTEM.ConnectBy = 1 Then
		SCREEN.Object("OBJECT0.IntaccNo").Data = Trim(AN1A.Data)
		SCREEN.Object("OBJECT0.Pwd").Data = Trim(zPwd.Data)
		OBJECT0.Send
	Else
		SCREEN.Proc "obj.send_f", ""
	End If

End Sub


'== 연속 조회
Sub send_c()
	SCREEN.Proc "obj.send_c", ""
End Sub


Sub OkSend()
	SCREEN.Proc "obj.send_f", ""
End Sub

Sub beforeDateChg()
	Dim comDate, srtDt
	srtDt = Trim(zOrdStrDt.Data)

	isGiganChk.Text = "N"

	srtDt = Left(srtDt, 4) & "-" & Mid(srtDt, 5, 2) & "-" & Right(srtDt, 2)
	comDate = change_indate("m", 1, srtDt)

	If CLng(comDate) < CLng(zOrdEndDt.Data) Then
		zOrdEndDt.Data = comDate
		RADIO2.Checked = True

		isGiganChk.Text = "Y"
	End If

	If CLng(zOrdStrDt.Data) > CLng(zOrdEndDt.Data) Then
		zOrdEndDt.Data = comDate
		RADIO2.Checked = True

		isGiganChk.Text = "Y"
	End If

	sect.Text = 4
	'Call send_f()
End Sub

Sub afterDateChg()
	Dim comDate, endDt
	endDt = Trim(zOrdEndDt.Data)

	isGiganChk.Text = "N"

	endDt = Left(endDt, 4) & "-" & Mid(endDt, 5, 2) & "-" & Right(endDt, 2)
	comDate = change_indate("m", -1, endDt)

	If CLng(comDate) > CLng(zOrdStrDt.Data) Then
		zOrdStrDt.Data = comDate
		RADIO2.Checked = True

		isGiganChk.Text = "Y"
	End If

	If CLng(zOrdStrDt.Data) > CLng(zOrdEndDt.Data) Then
		zOrdStrDt.Data = comDate
		RADIO2.Checked = True

		isGiganChk.Text = "Y"
	End If

	sect.Text = 5
	'Call send_f()
End Sub

