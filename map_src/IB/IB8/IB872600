RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim startFlag
startFlag = 1

'== 계좌명, 비밀번호 설정
Sub Set_account(acntCtrl)
	If acntCtrl.Visible = True Then
		SCREEN.ClearAll 0, 2
		obj.ClearAll 2
		GUIDE.Text = ""
		zPwd.Clear

		startFlag = 2

		If Len(Trim(acntCtrl.Data)) = 11 Then
			ACNM.Data = acntCtrl.Name
			zPwd.Data = acntCtrl.Password

			If SYSTEM.ConnectBy = 0 Then
				If Trim(zPwd.Data) = "" Then
					zPwd.Data = "9999"
				End If
			End If

			Call selSubTab()
		Else
			acntCtrl.SetFocus
			Exit Sub
		End If
	End If
End Sub

Sub selMainTab()
	GUIDE.Text = ""
	If mainTab.ID = 1 Then
		LABEL0.Text = "종합계좌번호"
		AN98.VIsible False
		AN99.Visible True
		ACNM.SetRect 222, 4, 286, 24
		subTab.SetTabVisible 3, True
		subTab.SetTabVisible 4, True
	Else

		LABEL0.Text = "계좌번호"
		AN98.VIsible True
		AN99.Visible False
		ACNM.SetRect 198, 4, 262, 24
		subTab.SetTabVisible 3, False
		subTab.SetTabVisible 4, False

		If subTab.ID >= 3 Then
			subTab.ID = 1
		End If
	End If

	Call selSubTab()
End Sub

Sub selSubTab()
	If mainTab.ID = 1 Then
		Select Case subTab.ID
			Case 1
					If SYSTEM.ConnectBy = 0 Then
						obj.SetObject "IB821511"
					Else
						obj.SetObject "IB821515"
					End If
			Case 2 : obj.SetObject "IB821512"
			Case 3 : obj.SetObject "IB821513"
			Case 4 : obj.SetObject "IB821514"
		End Select
	Else
		If subTab.ID = 1 Then
			Dim acntTp

			If Trim(AN98.Data) = "" Then
				Call alert_msg("계좌번호를 확인하여 주십시오.")
				AN98.SetFocus
				Exit Sub
			End If

			acntTp = Mid(Trim(AN98.Data), 4, 2)

			Select Case acntTp
				Case "10", "11", "51", "52" : obj.SetObject "IB82152A"	'------ 위탁
				Case "20", "21"             : obj.SetObject "IB82152B"	'------ 선물
				Case "30"                   : obj.SetObject "IB82152C"	'------ 저축
				Case "53"                   : obj.SetObject "IB82152D"	'------ 수익증권
				Case Else
					obj.SetObject "IB82152A"
					Exit Sub
			End Select
		Else
			obj.SetObject "IB821522"
		End If
	End If

	If startFlag = 2 Then
		Call send_f()
	End If
End Sub

Sub send_f()

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	If mainTab.ID = 1 Then
		If subTab.ID = 1 Then
			SCREEN.Proc "obj.obj.send_f", ""
		Else
			SCREEN.Proc "obj.send_f", ""
		End If
	Else
		SCREEN.Proc "obj.send_f", ""
		SCREEN.Proc "obj.object0.send_f", ""
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'직원/고객에 따른 비밀번호 컨트롤 설정
Call Check_LoginType(zPwd)

AN98.Visible = False
AN99.visible = True

Call selMainTab()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN99)
_AW_ONCHANGE_AW_
Call Set_account(AN99)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN98)
_AW_ONCHANGE_AW_
Call Set_account(AN98)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(mainTab)
_AW_ONCLICK_AW_
Call selMainTab()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(subTab)
_AW_ONCLICK_AW_
Call selSubTab()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


