'***************************************************************
'NAME: IsBnkAccnType(accn)
'DESC: 은행 예수금계좌인지 증권 예수금계좌인지 구분
'accn: 계좌컨트롤
'은행 예수금계좌이면 True, 증권 예수금계좌이면 False를 반환
'***************************************************************
Function IsBnkAccnType(accn)
	IsBnkAccnType = False

	Dim brnAccn
	brnAccn = Left(Trim(accn.Data), 3)

	If CLng(brnAccn) >= 551 And CLng(brnAccn) <= 561 Then '160119 557계좌 추가 190103 561계좌 추가  '201006 558계좌 추가(은행예수금계좌, IBK주거래생활금융통장)
		IsBnkAccnType = True
	End If
End Function


'***************************************************************
'NAME: chkNumericData(num)
'num이 숫자이면 True, Null이거나 숫자가 아니면 False를 반환
'***************************************************************
Function chkNumericData(num)
	chkNumericData = False

	Dim data
	data = Trim(num)

	If data = "" Then
		Exit Function
	End If

	If IsNumeric(data) = False Then
		Exit Function
	End If

	chkNumericData = True
End Function

