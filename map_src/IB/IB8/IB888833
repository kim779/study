	Case 03, 06, 07, 13, 16, 23, 26, 81, 61 : check_Jijungga = False
	Case Else : : check_Jijungga = True
	End Select
End Function

'***************************************************************
'==계좌번호, 비밀번호 체크
Function CheckInput(ANCT, zPwd)
 	CheckInput = False
	If Trim(ANCT.data) = "" Or Len(Trim(ANCT.data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하십시오.")
 		ANCT.Setfocus
 		Exit Function
	End If

	If Len(Trim(zPwd.data)) = 0 Then
 		zPwd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zPwd.data)) < 4 Then
			Call alert_msg("비밀번호를 확인하십시오.")
	 		zPwd.Setfocus
	 		Exit Function
		End If
	End If
	CheckInput = True
End Function

'***************************************************************
'==사원번호, 비밀번호 체크
Function CheckInput_1(ANCT, zPwd)
 	CheckInput_1 = False

	If Trim(ANCT.data) = "" Then
		Call alert_msg("사원번호를 확인하십시오.")
 		ANCT.Setfocus
 		Exit Function
	End If

	If Len(Trim(zPwd.data)) = 0 Then
 		zPwd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.data)) < 4 Then
			Call alert_msg("비밀번호를 확인하십시오.")
	 		zPwd.Setfocus
	 		Exit Function
		End If
	End If
	CheckInput_1 = True
End Function

Sub alert_msg(msgx)
	If guide_flag = 1 Then
		SCREEN.Object("main.guide").Text = msgx
	Else
		MsgBox msgx, , "IBK투자증권"
	End If
End Sub
Sub guide_msg(msgx)
	SCREEN.Object("main.guide").Text = msgx
End Sub
'***************************************************************
'NAME: l_zeropad
'DESC: 왼쪽을 "0"으로 자리수 맞추어 표시
'EX)   l_zeropad(edit)   			return	"00099"
'***************************************************************
Function l_zeropad(ed_str)
	Dim sln, str
	str = Trim(ed_str.Data)
	If str = "" Then
		l_zeropad = ""
		Exit Function
	End If
	l_zeropad = String(Len(ed_str.Data) - Len(str), "0") & str
End Function

