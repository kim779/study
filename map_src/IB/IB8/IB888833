'== 소수 2자리 add
Function str2flt(edit1)
	str2flt = CDbl(Trim(edit1.data))
	str2flt = Trim(FormatNumber(str2flt, 2,0,0,0))
	edit1.data = str2flt
End Function

Function check_Jijungga()
