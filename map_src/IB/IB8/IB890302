_AW_ONDECLARE_AW_
Dim count

Sub set_accn( group )

Dim i, idx, a

idx = 1

'SYSTEM.Trace("jjjjjjjjjjjjjjjj")

'SYSTEM.Trace(group)

For i = 1 To GRID0.Rows
	If Trim(GRID0.GetGridCell( i, 1 )) = group Then
		a = GRID0.GetGridCell( i, 1 )
		SCREEN.Object("main.GRID1").SetGridCell idx, 1, a
		a = GRID0.GetGridCell( i, 2 )
		SCREEN.Object("main.GRID1").SetGridCell idx, 2, a
		a = GRID0.GetGridCell( i, 3 )
		SCREEN.Object("main.GRID1").SetGridCell idx, 3, a
		a = GRID0.GetGridCell( i, 4 )
		SCREEN.Object("main.GRID1").SetGridCell idx, 4, a
		a = GRID0.GetGridCell( i, 5 )
		SCREEN.Object("main.GRID1").SetGridCell idx, 5, a

'		SYSTEM.Trace(a)

		idx = idx + 1
	End If

'	SYSTEM.Trace(i & GRID0.GetGridCell( i, 1 ) )
Next

End Sub

_AW_ONSEND_AW_
Dim count

count = CLng(curRow.Data)

If count >= SCREEN.Object("parent.GRID0").Rows Then
'	SYSTEM.Trace("OnSend False" )
	SCREEN.OnSend = False
End If

'SYSTEM.Trace("OnSend " & count )

EDIT3.Data = SCREEN.Object("parent.GRID0").GetGridCell( count+1, 1 )
EDIT4.Data = SCREEN.Object("parent.GRID0").GetGridCell( count+1, 2 )

If Len(Trim(EDIT3.Data)) = 0 Or Len(Trim(EDIT4.Data)) = 0 Then
	SCREEN.OnSend = False
	SCREEN.Proc "parent.set_accn",""
End If

'SYSTEM.Trace("OnSend a " & EDIT3.Data & " " & EDIT4.Data )

curRow.Data = count + 1

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim a
a = CLng(OUTPUT0.Data)
count = a + count

If count >= GRID0.Rows Then
	GRID0.SetRows( count )
End If

If CLng(curRow.Data) < SCREEN.Object("parent.GRID0").Rows Then
'	SYSTEM.Trace("SCREEN.OnReceive 0")
	GRID0.SetDataPosition(1)
	SCREEN.Send 0
Else
	SCREEN.Proc "parent.set_accn",""
End If

