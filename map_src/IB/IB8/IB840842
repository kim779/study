_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
'	ACNM.Data = AN1A.Name
'	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub Setting2()
	Dim ii, items, items2, str, name, count, str2, cnt
	count = 0
	cnt = 0
	items = "" & vbTab & "" & ""
	items2 = "" & vbTab & ""
	str2 = Trim(SCREEN.Object("parent.r_account").data)

	For ii=1 To GRID0.Rows
		If Trim(GRID0.GetGridcell(ii, 1)) = "1103" Then
			str = Trim(GRID0.GetGridtext(ii, 3))

			If str <> "" And Replace(str, "-", "") <> str2 Then
				items = items & vbTab & Replace(str, "-", "") & str
				name = Trim(GRID0.GetGridtext(ii,4))
				items2 = items2 & vbTab & name
				count = count + 1
				cnt = cnt +1
			End If
		End If
	Next

	If cnt < 1 Then
		view = Mid(str2, 1, 3) & "-" & Mid(str2, 4, 2) & "-" & Mid(str2, 6, 6)
		items = items & vbTab & str2 & view
		name = SCREEN.Object("parent.ANCM").data
		items2 = items2 & vbTab & name
		count = count + 1
	End If

	SCREEN.Object("main.obj1.cb_count").data = count
	SCREEN.Object("main.OBJ1.zRebatAcntNo").SetItems(items)
	SCREEN.Object("main.OBJ1.zRebatAcntNo_nm").SetItems(items2)

	SCREEN.Proc "main.OBJ1.acct_set", ""  '--계좌번호, 계좌명 세팅
	SCREEN.Proc "main.OBJ1.chg_acct_set", ""

	SCREEN.Object("parent.lAppyQty").Enable = False
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

zAcntNo.Data = SCREEN.Object("main.obj1.AN1A").data
zInptPwd.Data = SCREEN.Object("main.obj1.zpwd").data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
Else

	Call Setting2()
	'Call alert_msg("환불입고계좌가 정확한지 확인하시기 바랍니다.")
End If


