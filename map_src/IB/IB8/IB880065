RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	next_btn.Enable = False
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0040"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii,irow, trow, icol

If LEDGER.Next = "Y" Then
	Call send_c()
Else
	trow = GRID0.rows
	If trow > 0 Then
		Call SCREEN.Object("parent.Grid0").Clear
		For ii = 1 To trow
			If (ii Mod 4) = 1 Then
				irow = SCREEN.Object("parent.Grid0").rows
				SCREEN.Object("parent.Grid0").InsertRow irow
				irow = irow+1
			End If

			icol = ii Mod 4
			If icol = 0 Then icol = 4
			Call SCREEN.Object("parent.Grid0").SetGridCell(irow, icol*3-2, GRID0.GetGridCell(ii, 1))
			Call SCREEN.Object("parent.Grid0").SetGridCell(irow, icol*3, GRID0.GetGridCell(ii, 2))
			Call SCREEN.Object("parent.Grid0").SetGridCell(irow, icol*3-1, GRID0.GetGridCell(ii, 3))
		Next
	End If
	SCREEN.Object("parent.Guide").text = LEDGER.Emsg
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



