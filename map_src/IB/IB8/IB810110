	If bFirst Then
		bFirst = False
		strBaseList = SYSTEM.Pop("IB810101_AccList")
		strBaseNameList = SYSTEM.Pop("IB810101_AccNameList")
		strAccList = AN00.GetAgentAccList()	'자금대체, 통합계좌 대리인
		strNameList = AN00.GetAgentNameList()	'자금대체, 통합계좌 대리인

