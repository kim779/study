Function chk_myaccn()
	Dim ii, t_accn, c_accn, my_accn
	chk_myaccn = False

	' 입금대상계좌 구분(내계좌/타계좌)에 따른 계좌 컴포넌트 선별
	If F1.Checked = True Then
		c_accn = Left(Trim(Replace(Trim(CMB_ACCT2.Text), "-", "")), 11)
	Else
		c_accn = Trim(EDIT_ACCT.Data)
	End If

	For ii = 1 To SCREEN.Object("Main.OBJ_acct.GRID0").Rows
		' 사용자 보유 전체 계좌 리스트
		t_accn = Trim( SCREEN.Object("Main.OBJ_acct.GRID0").GetGridCell (ii, 9) )	' 비교 대상 계좌번호
		my_accn = Trim(SCREEN.Object("Main.OBJ_acct.GRID0").GetGridCell (ii, 12))	' 동일인 여부

		' 계좌가 있을때만 & 계좌 약정이 맺어져 있는 경우만
		If Trim(t_accn) <> "" And Trim(c_accn) <> "" Then
			If t_accn = c_accn Then
				chk_myaccn = True
				Exit Function
			End If
		End If
	Next
End Function


'--계좌번호, 계좌명 세팅 :: 출금 계좌번호 변경 시
Sub acct_set()
	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text

	zAcntNo.Data = Trim(CMB_ACCT.Data)
	AN00.data = zAcntNo.Data
