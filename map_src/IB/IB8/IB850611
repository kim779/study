	Dim arrdata

	arrdata = Split(data, "|")
	AcntNo.Data = arrdata(0)
	Pwd.Data    = arrdata(1)
	FundOpAcntNo.Data = arrdata(2)
	IvstfndCode.Data = arrdata(3)
	HanglIvstfndNm.Data = arrdata(4)
	OrdDt.Data = arrdata(5)
	ExecDt.Data = arrdata(6)
	SettDt.Data = arrdata(7)
	CslLoanAmtdt1.Data = arrdata(8)
	OrdNo.Data = arrdata(9)
End Sub

