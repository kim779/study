	       "DpsBfbalAmt" & vbTab & Trim(TABLE0.GetTableCell(3)) & vbLf &_
	       "LoanAmt" & vbTab & Trim(TABLE0.GetTableCell(7)) & vbLf &_
	       "LoanIntrstAmt" & vbTab & Trim(TABLE0.GetTableCell(8)) & vbLf &_
	       "LoanAmtSum" & vbTab & Trim(TABLE0.GetTableCell(9)) & vbLf &_
	       "LoanIntrstSum" & vbTab & Trim(TABLE0.GetTableCell(10)) & vbLf &_
	       "DpsCrbalAmt" & vbTab & Trim(TABLE0.GetTableCell(4)) & vbLf

	SCREEN.CreateWindow 2, "IB85061B /p5 /d", dmsg
