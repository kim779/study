_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim dmsg

If Left(LEDGER.Ecod , 1) <> "0" Then
	Exit Sub
Else
	dmsg = "TrdNo" & vbTab & CLng(Trim(TABLE0.GetTableCell(1))) & vbLf &_
		   "RfundDt" & vbTab & Trim(TABLE0.GetTableCell(2)) & vbLf &_
