		VIEWGRID.SetGridCell row, c_wqty, Trim(RTSGRID.GetGridCell(1, 8))			' 미체결수량
		VIEWGRID.SetGridCell row, c_dqty, Trim(RTSGRID.GetGridCell(1, 13))			' 체결수량
