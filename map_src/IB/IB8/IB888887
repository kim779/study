' DESC :  분할체결된 내역을 더블클릭할 경우 아래 함수를 호출하여 상세체결내역을 조회한다.
'****************************************************************************************************************************
Sub ShowDetailChegPopup()
	Dim jprc, ccnt, row, col, hogb, juno, accno, accnm, mapn

	row = VIEWGRID.Row
	col = VIEWGRID.Column

	If VIEWGRID.HitPos = 3 Then
		ccnt = Trim(VIEWGRID.GetGridCell(row, 24))
		If Len(ccnt)=0 Then
			Exit Sub
		End If
		If ccnt > 1 Then
			juno = Trim(VIEWGRID.GetGridCell(row, c_jmno))
			hogb = Trim(VIEWGRID.GetGridCell(row, c_hogb))
			If hogb="시장가" Then
				jprc = hogb
			Else
				jprc = Trim(VIEWGRID.GetGridCell(row, c_jprc))
			End If

			mapn = SCREEN.GetMapName(0)
			If Left(mapn, 6)="IB3106" Then
				accno = ACCN.Data
				accnm = ACNM.Data
			ElseIf Right(mapn, 2)="00" Then
				accno = AN20.Data
				accnm = ACNM.Data
			Else
				accno = ed_accn.Data
				accnm = ACNM.Data
			End If


			SCREEN.CreateWindow 2, _
				"IB9999B0 /p5 /d", _
				"juno" & vbTab & juno & vbLf & _
				"acno" & vbTab & accno & vbLf & _
				"acnm" & vbTab & accnm & vbLf & _
				"jprc" & vbTab & jprc
		End If
	End If
End Sub


