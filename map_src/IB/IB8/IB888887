'		If Mid(Trim(RTSGRID.GetGridCell(1, 4)),2,1) = "0" Then
		mkty = Mid(Trim(RTSGRID.GetGridCell(1, 4)),2,2)

		If ("10" <= mkty And mkty <= "59") Or ("B0" <= mkty And mkty <= "ZZ") _ 
				Or ("0A" <= mkty And mkty <= "0Z")  Or ("1A" <= mkty And mkty <= "1Z")  _
				Or ("2A" <= mkty And mkty <= "2Z")  Or ("3A" <= mkty And mkty <= "3Z")  _
				Or ("4A" <= mkty And mkty <= "4Z")  Or ("5A" <= mkty And mkty <= "5Z")  _
				Or ("6A" <= mkty And mkty <= "6Z")  Or ("7A" <= mkty And mkty <= "7Z")  _
				Or ("8A" <= mkty And mkty <= "8Z")  Or ("9A" <= mkty And mkty <= "9Z") 	Then
			t_dprc = Trim(CDbl(RTSGRID.GetGridCell(1, 14))/100)
		Else
			t_dprc = Trim(CDbl(RTSGRID.GetGridCell(1, 14))/100)
			If mkty >= "85" And mkty <= "87" Then
				t_dprc = FormatNumber(t_dprc, 0)
			Else
				t_dprc = FormatNumber(t_dprc, 2)
			End If
		End If


		VIEWGRID.SetGridCell row, c_dprc, t_dprc									' 체결가격
		VIEWGRID.SetGridCell row, c_jqty, Trim(RTSGRID.GetGridCell(1, 9))			' 주문수량

'		SYSTEM.Trace "Update_Row(row)2 mkty : " & mkty
'		If Mid(Trim(RTSGRID.GetGridCell(1, 4)),2,1) = "0" Then

		If ("10" <= mkty And mkty <= "59") Or ("B0" <= mkty And mkty <= "ZZ") _
					 Or  ("0A" <= mkty And mkty <= "0Z")   Or  ("1A" <= mkty And mkty <= "1Z")  _
					 Or  ("2A" <= mkty And mkty <= "2Z")   Or  ("3A" <= mkty And mkty <= "3Z")  _
					 Or  ("4A" <= mkty And mkty <= "4Z")   Or  ("5A" <= mkty And mkty <= "5Z")  _
					 Or  ("6A" <= mkty And mkty <= "6Z")   Or  ("7A" <= mkty And mkty <= "7Z")  _
					 Or  ("8A" <= mkty And mkty <= "8Z")   Or  ("9A" <= mkty And mkty <= "9Z")  Then
			t_dprc = Trim(CDbl(RTSGRID.GetGridCell(1, 10))/100)
		Else
			t_dprc = Trim(CDbl(RTSGRID.GetGridCell(1, 10))/100)
			If mkty >= "85" And mkty <= "87" Then
				t_dprc = FormatNumber(t_dprc, 0)
			Else
				t_dprc = FormatNumber(t_dprc, 2)
			End If
		End If

		VIEWGRID.SetGridCell row, c_jprc, t_dprc									' 주문단가
		VIEWGRID.SetGridCell row, c_stat, Trim(RTSGRID.GetGridCell(1,11))			' 접수구분
		VIEWGRID.SetGridCell row, c_time, Trim(RTSGRID.GetGridCell(1,15))			' 처리시간

		If Trim(RTSGRID.GetGridCell(1, 7)) <> "" Then										' 호가구분
			VIEWGRID.SetGridCell row, c_hogb, Trim(RTSGRID.GetGridCell(1, 7))
