'****************************************************************************************************************************
' DESC :  선물  실시간 주문 체결
'****************************************************************************************************************************

Sub sCont_Notice(RTSGRID, VIEWGRID)
Dim r_stat, r_jmno, r_ojno, row_F, row_O
	r_stat = Trim(RTSGRID.GetGridCell(1, 11))					' 접수구분
	r_jmno = Trim(RTSGRID.GetGridCell(1, 2))						' 주문번호
	r_ojno = Trim(RTSGRID.GetGridCell(1, 3))						' 원주문번호

	If InStr(r_stat,"접수") > 0 Then									' 기본셋팅
		Call RTSGRID.SetGridCell (1,13, "0")
		Call RTSGRID.SetGridCell (1,14, "0")
	ElseIf r_stat = "거부" Or r_stat = "접수오류" Then
		Call RTSGRID.SetGridCell (1, 13, "0")
		Call RTSGRID.SetGridCell (1, 14, "0")
	End If

' *********     VIEWGRID가 empty일 경우     *********
	If VIEWGRID.Rows = 0 Then
		VIEWGRID.InsertRow 0
		Update_Row(1)
		RTSGRID.RemoveRow 0
		Exit Sub
	End If

	row_F = Find_Row(r_jmno)
	Update_Row_1(row_F)
' ********* 동일한 주문번호가 존재하는 경우 *********
	If row_F > 0 Then
		If r_stat = "체결" Then
			Call Modify_dqty(RTSGRID.GetGridCell(1, 13), row_F)

			RTSGRID.RemoveRow 0
			Exit Sub
		ElseIf r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
'			If row_O > 0 And r_stat = "정정확인"	Then
			If row_O > 0 Then
					Modify_wqty(row_O)		' 원주문의 미체결 계산
					Modify_hqty(row_O)		' 원주문의 정취량
			End If

'			VIEWGRID.SetGridCell row_F, c_hqty, Trim(RTSGRID.GetGridCell(1, 13))					'정정/취소수량
			VIEWGRID.SetGridCell row_F, c_wqty, Trim(RTSGRID.GetGridCell(1, 8))						' 미체결수량
			VIEWGRID.SetGridCell row_F, c_stat, Trim(RTSGRID.GetGridCell(1,11))						' 접수구분
			RTSGRID.RemoveRow 0
			Exit Sub
		ElseIf r_stat = "거부" Or r_stat = "접수오류" Then

		ElseIf InStr(r_stat,"접수") > 0 Then

		Else
			RTSGRID.RemoveRow 0
			Exit Sub
		End If
' ********* 일치하는 주문번호가 없는경우 *********
	Else
		If r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
'			If row_O > 0 And r_stat = "정정확인"	Then
			If row_O > 0 Then
					Modify_wqty(row_O)		' 원주문의 미체결 계산
					Modify_hqty(row_O)		' 원주문의 정취량
			End If

			Call RTSGRID.SetGridCell (1, 13, "0")
			Call RTSGRID.SetGridCell (1, 14, "0")
		End If
		VIEWGRID.InsertRow 0
		row_F = 1
	End If

	Update_Row(row_F)
	RTSGRID.RemoveRow 0
End Sub

'****************************************************************************************************************************
' DESC :  선물  실시간 주문  미체결
'****************************************************************************************************************************
Sub sNCont_Notice(RTSGRID, VIEWGRID)
Dim r_stat, r_jmno, r_ojno, row_F, row_O, wqty, r_time
	r_stat = Trim(RTSGRID.GetGridCell(1, 11))					' 접수구분
	r_jmno = Trim(RTSGRID.GetGridCell(1, 2))						' 주문번호
	r_ojno = Trim(RTSGRID.GetGridCell(1, 3))						' 원주문번호
	r_wqty = Trim(RTSGRID.GetGridCell(1, 8))						' 미체결수량
	If r_wqty = "" Then r_wqty = "0"
	r_time = Trim(RTSGRID.GetGridCell(1, 15))						' 체결시간

	SYSTEM.Trace "sNCont_Notice[" & r_time & "]"

	If InStr(r_stat,"접수") > 0 Then									' 기본셋팅
		Call RTSGRID.SetGridCell (1,13, "0")
		Call RTSGRID.SetGridCell (1,14, "0")
	ElseIf r_stat = "거부" Or r_stat = "접수오류" Then
		Call RTSGRID.SetGridCell (1, 13, "0")
		Call RTSGRID.SetGridCell (1, 14, "0")
	End If

' *********     VIEWGRID가 empty일 경우     *********
	If VIEWGRID.Rows = 0 Then
		If CDbl(r_wqty) > 0 Then
			VIEWGRID.InsertRow 0
			Update_Row(1)
		End If
		RTSGRID.RemoveRow 0
		Exit Sub
	End If

	row_F = Find_Row(r_jmno)
	Update_Row_1(row_F)
' ********* 동일한 주문번호가 존재하는 경우 *********

	If row_F > 0 Then
		If r_stat = "체결" Then
			Call Modify_dqty(RTSGRID.GetGridCell(1, 13), row_F)

			If CDbl(r_wqty) < 1 Then
				VIEWGRID.RemoveRow row_F-1
			End If
			RTSGRID.RemoveRow 0
			Exit Sub
		ElseIf r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
'			If row_O > 0 And r_stat = "정정확인"	Then
			If row_O > 0 Then
					Modify_wqty(row_O)
					wqty = Trim(VIEWGRID.GetGridCell (row_O, c_wqty))
					If wqty = "" Then wqty = "0"

					If CDbl(wqty) < 1 Then
							VIEWGRID.RemoveRow row_O-1
					End If
			End If

			VIEWGRID.SetGridCell row_F, c_wqty, r_wqty												' 미체결수량
			VIEWGRID.SetGridCell row_F, c_stat, Trim(RTSGRID.GetGridCell(1,11))						' 접수구분
			RTSGRID.RemoveRow 0

			If CDbl(r_wqty) < 1 Then
				VIEWGRID.RemoveRow row_F-1
			End If
			Exit Sub
		ElseIf r_stat = "거부" Or r_stat = "접수오류" Then
		ElseIf InStr(r_stat,"접수") > 0 Then
		Else
			RTSGRID.RemoveRow 0
			Exit Sub
		End If
' ********* 일치하는 주문번호가 없는경우 *********
	Else

		If r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
'			If row_O > 0 And r_stat = "정정확인"	Then
			If row_O > 0 Then
					Modify_wqty(row_O)
					wqty = Trim(VIEWGRID.GetGridCell (row_O, c_wqty))
					If wqty = "" Then wqty = "0"

					If CDbl(wqty) < 1 Then
							VIEWGRID.RemoveRow row_O-1
					End If
			End If

			Call RTSGRID.SetGridCell (1, 13, "0")
			Call RTSGRID.SetGridCell (1, 14, "0")
		End If
		VIEWGRID.InsertRow 0
		row_F = 1
	End If

	If CDbl(r_wqty) < 1 Then
		VIEWGRID.RemoveRow row_F-1
		RTSGRID.RemoveRow 0
		Exit Sub
	End If
	Update_Row(row_F)
	RTSGRID.RemoveRow 0
End Sub

'****************************************************************************************************************************
' DESC :  Help Funtion
'****************************************************************************************************************************
Sub Modify_dqty(amt, row_F)
	Dim amt_T, amount, t_dprc, mkty, ccnt
	amount = Trim(VIEWGRID.GetGridCell (row_F, c_dqty))													' 체결수량

	' 분할체결 처리.
	amount = Replace(amount, "※ ", "")
	ccnt = Trim(RTSGRID.GetGridCell(1, 16))

	If amount = "" Then	amount = "0"

	amount = CDbl(amount) + CDbl(amt)
'	amount = CDbl(amt)
	Call VIEWGRID.SetGridCell (row_F, c_dqty, amount)
	Call VIEWGRID.SetGridCell (row_F, c_stat, Trim(RTSGRID.GetGridCell(1,11)))					' 처리구분
	Call VIEWGRID.SetGridCell (row_F, c_wqty, Trim(RTSGRID.GetGridCell(1,8)))						' 미체결수량

	' 분할체결 처리.
	Call VIEWGRID.SetGridCell (row_F, 24, ccnt)
	Call SetChegCountDisplay(VIEWGRID, 15, 24, row_F)

	If Trim(RTSGRID.GetGridCell(1, 14)) <> "" Then
'		If Mid(Trim(RTSGRID.GetGridCell(1, 4)),2,1) = "0" Then
		mkty = Mid(Trim(RTSGRID.GetGridCell(1, 4)),2,2)
		If ("10" <= mkty And mkty <= "59") Or ("B0" <= mkty And mkty <= "ZZ") _ 
					Or ("0A"  <= mkty And mkty <= "0Z") Or ("1A"  <= mkty And mkty <= "1Z") _
					Or ("2A"  <= mkty And mkty <= "2Z") Or ("3A"  <= mkty And mkty <= "3Z") _
					Or ("4A"  <= mkty And mkty <= "4Z") Or ("5A"  <= mkty And mkty <= "5Z") _
					Or ("6A"  <= mkty And mkty <= "6Z") Or ("7A"  <= mkty And mkty <= "7Z") _
					Or ("8A"  <= mkty And mkty <= "8Z") Or ("9A"  <= mkty And mkty <= "9Z") Then
			t_dprc = Trim(CDbl(RTSGRID.GetGridCell(1, 14))/100)
		Else
			t_dprc = Trim(CDbl(RTSGRID.GetGridCell(1, 14))/100)
			If mkty >= "85" And mkty <= "87" Then
				t_dprc = FormatNumber(t_dprc, 0)
			Else
				t_dprc = FormatNumber(t_dprc, 2)
			End If
		End If
		Call VIEWGRID.SetGridCell (row_F, c_dprc, t_dprc)	' 체결가격
	End If
End Sub

Sub Modify_wqty(row)
	Dim h_qty, w_qty
	h_qty = RTSGRID.GetGridCell (1, 13)										' 정정/취소 확인수량
	w_qty = Trim(VIEWGRID.GetGridCell (row, c_wqty))

	If w_qty = "" Then w_qty = "0"
	If w_qty <> "0" Then
		h_qty = CDbl(w_qty) - h_qty
	Else
		h_qty = "0"
	End If

	Call VIEWGRID.SetGridCell (row, c_wqty, h_qty)

End Sub

Sub Modify_hqty(row)
	Dim tmp, hqty, hqty_T

	hqty = RTSGRID.GetGridCell (1, 13)										' 정정/취소 확인수량
	tmp = Trim(VIEWGRID.GetGridCell (row, c_hqty))

	If tmp = "" Then tmp = "0"
	hqty_T = CDbl(hqty) + CDbl(tmp)

	Call VIEWGRID.SetGridCell (row, c_hqty, hqty_T)

End Sub

Function Find_Row(jm_num)														' 주문번호/원주문번호가 일치하는 Row Return
	Dim row
	For row = 1 To VIEWGRID.Rows
		If Trim(jm_num) = Trim(VIEWGRID.GetGridCell(row, c_jmno)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

