RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim msg

Sub send_f(param)
	SCREEN.ClearAll 0, 0
	msg = param

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
IntaccNo.Data = Trim(SCREEN.Object("parent.CMB_ACCT").Data)

If Len(Trim(IntaccNo.Data)) <> 11 Then
	Call guide_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.CMB_ACCT").SetFocus
	Exit Sub
End If

Pwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

If Len(Trim(Pwd.Data)) < 4 Then
	Call guide_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SYSTEM.Push "IB8101XY", "8102"

If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If SCREEN.GetMapName(1) = "IB810200" Then
		If SCREEN.Object("main.utab0").id = 1 Or SCREEN.Object("main.utab0").id = 2 Then
			SCREEN.Object("OBJECT0.an").data = Mid(IntaccNo.Data, 1, 3) & "00" & Mid(IntaccNo.Data, 6, 6)
			SCREEN.Object("OBJECT0.pwd").data = Pwd.Data
			OBJECT0.Send
		Else '기존로직 유지
			SCREEN.Proc "parent.rightPwd", msg
		End If
	Else '기존로직 유지
		SCREEN.Proc "parent.rightPwd", msg
	End If
Else
	If Trim(LEDGER.Ecod) <> "3669" Then
		alert_msg(Trim(LEDGER.emsg))
	End If

	SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)
	SCREEN.Proc "parent.wrongPwd", ""
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



