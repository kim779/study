Sub send_f()
	SCREEN.ClearAll 0, 2
	indx.Data = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
	SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
