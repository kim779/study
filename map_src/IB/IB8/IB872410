	SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg
End Sub

Sub setAccUsid()
	SCREEN.ClearAll 0, 2
	SCREEN.Object("main.GUIDE").Text = ""
	If RADIO0.Checked Then
		EDIT_USID.Visible = False
		MgempNo.Data = ""
		COMBACC.Visible = True
		TrxTp.Data ="1"
	ElseIf RADIO1.Checked Then
		EDIT_USID.Visible = True
		MgempNo.Data = LEDGER.Usid
		EDIT_USID.Data = LEDGER.Usid
		COMBACC.Visible = False
		COMBACC.Data = ""
		TrxTp.Data ="2"
	End If
End Sub

