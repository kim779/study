RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_o()
	SCREEN.ClearAll 0, 0
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
zIn.Data = "00001"
zTrxTp.Data = Trim(SCREEN.Object("parent.zTrxTp").Data)
zAcntNo.Data = Trim(SCREEN.Object("parent.CMB_ACCT").Data)
zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)
zIsuNo.Data = Trim(SCREEN.Object("parent.zIsuNo").Data)
zTrxQty_giho.Data = "+"
zTrxQty.Data = l_zeropad(SCREEN.Object("parent.zTrxQty"))
zBuyDt.Data = Trim(SCREEN.Object("parent.zBuyDate").Data)
zTxontTp.Data = Trim(SCREEN.Object("parent.zTxontTp").Data)
zBkeepTp.Data = "4"
zOtcoNo.Data = Trim(SCREEN.Object("parent.zOtcoNo").Data)
zOtcoBrnNo.Data = l_zeropad(SCREEN.Object("parent.zOtcoBrnNo"))
zBkeepAcntNo.Data = Trim(SCREEN.Object("parent.zBkeepAcntNo").Data)
zSeqNo_giho.Data = "+"

If Trim(zTrxTp.Data) = "1" Then
	zTrxDate.Data = ""
	zSeqNo.Data = "000000000"
	zTelRgno.Data = Trim(SCREEN.Object("parent.zTelRgno").Data)
	zTelExno.Data = Trim(SCREEN.Object("parent.zTelExno").Data)
	zTelSeqno.Data = Trim(SCREEN.Object("parent.zTelSeqno").Data)

Else
	zTrxDate.Data = Trim(SCREEN.Object("parent.zTrxDate").Data)
	zSeqNo.Data = l_zeropad(SCREEN.Object("parent.zSeqNo"))
	zTelRgno.Data = ""
	zTelExno.Data = ""
	zTelSeqno.Data = ""
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Call alert_msg(Trim(LEDGER.Emsg))

If Left(Trim(LEDGER.Ecod), 1) = "0" Then
'	SCREEN.Proc "parent.obj_jngo.send_f", ""
	SCREEN.Object("parent.zTrxQty").Clear

	If SCREEN.Object("main.UTAB1").ID = 4 Then
		SCREEN.Proc "main.obj2.send_f", ""
	End If
End If

If zTrxTp.Data = "1" Then		'타사대체신청
	SCREEN.Object("parent.obj_showCerti").Visible = False
	SCREEN.Object("parent.obj_showCerti").SetObject("")
Else							'타사대체취소
	SCREEN.Proc "parent.obj_cancelList.send_f", ""
End If

Call guide_msg(Trim(LEDGER.Emsg))

_AW_ONENDSUB_AW_
}



