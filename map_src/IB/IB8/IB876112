RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim toggle
toggle = 1

Sub view_toggle(ttype)
	Dim snam, active, curr, objn
	For ii = 1 To GRID0.Rows
		snam   = GRID0.GetGridCell(ii,  3)	' 서버명
		active = GRID0.GetGridCell(ii,  8)	' 사용여부
		curr   = GRID0.GetGridCell(ii, 13)	' 사용자수
		objn = "TABLE" & ii - 1

		' 접속서버
		If ttype = 1 Then
			SCREEN.Object(objn).SetTableCell 1, Trim(snam)
		Else
			SCREEN.Object(objn).SetTableCell 1, curr
		End If

		' 기본 색상
		SCREEN.Object(objn).SetTRgb 1, 1, 192	' WHITE

		' Active/InActive 에 따른 색상 표기
		Select Case Trim(active)
		Case "□"	' 접속가능
			SCREEN.Object(objn).SetTRgb 1, 1, 192	' WHITE
		Case "▣"
			SCREEN.Object(objn).SetTRgb 1, 1, 247	' GRAY
		Case Else	' 접속차단
			SCREEN.Object(objn).SetTRgb 1, 1, 95	' BLUE
		End Select
	Next

	If toggle = 1 Then
		toggle = 0
	Else
		toggle = 1
	End If
End Sub

_AW_ONRECEIVE_AW_
view_toggle(toggle)

