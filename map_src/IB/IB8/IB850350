_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt = "0030"

SCREEN.SetTimer 5, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

	AN19.Data = Trim(SCREEN.Object("main.obj0.AN19").Data)
	zPwd.Data = Trim(SCREEN.Object("main.obj0.zPwd").Data)

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" Then
   zPwd.Data = "9999"
   SCREEN.onsend = True
   Exit Sub
End If

If CheckInput(SCREEN.Object("main.obj0.AN19"), SCREEN.Object("main.obj0.zPwd")) = True Then
'	AN19.Data = Trim(SCREEN.Object("main.obj0.AN19").Data)
'	zPwd.Data = Trim(SCREEN.Object("main.obj0.zPwd").Data)
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
Else
	Select Case selection.Data
		Case "1"	zPwd.SetFocus()
		Case "2"	send_btn.SetFocus()
		Case "3"	next_btn.SetFocus()
	End Select
End If

SCREEN.Object("main.GUIDE").text = LEDGER.Emsg

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Proc "parent.startSend", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
	selection.Data = 1
End If
