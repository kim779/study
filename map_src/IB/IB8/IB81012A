RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Dim ii, jj
Sub Setting()
	jj=1
	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(ii, 3)) = "X" Then

			GRID1.SetGridCell jj, 1, Trim(GRID0.GetGridCell(ii, 2))
			GRID1.SetGridCell jj, 2, "비정상"
			jj = jj + 1
'			SYSTEM.Trace GRID0.GetGridCell(ii, 2) & " : " & GRID0.GetGridCell(ii, 3)
		End If
	Next

	recvTime.Data = LEDGER.Time
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0050"
send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Call Setting()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONDBLCLK_AW_
Dim name
name = GRID0.GetGridCell(GRID0.row, 3)

SYSTEM.Push "KNAME", name

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(recvTime)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
