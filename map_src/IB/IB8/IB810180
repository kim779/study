Sub acct_set()
	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text
	UserId.Data = Trim(CMB_ACCT.Data)
End Sub


'==========================================================
'입금기관 선택
'==========================================================
Sub selInptGiGwan()
	Call scrClear()

	Dim IsBool

	If F1.Checked = True Then
		Tp.Data = "1"
		IsBool = True
		Bank_Code.Data = CMB_MY.Data
		SELECTBANK.Text = Mid(CMB_MY.Text, 5)
	Else
		Tp.Data = "2"
		IsBool = False
		Bank_Code.Data = "068"
		SELECTBANK.Text = "IBK투자증권"
	End If

	CMB_MY.Enable = IsBool
	SELECTBANK.Enable = IsBool
	BUTTON13.Enable = IsBool
End Sub


'==========================================================
'그리드 클릭
'==========================================================
Sub DoGridClick()
	Dim grAccnData, grAccnText, grAccnName, grBnkCode, grBnkName, grCorpType, grAccnNick
	grCorpType = Trim(GRID0.GetGridCell(GRID0.Row, 1))			'입금기관구분
	grBnkCode = Trim(GRID0.GetGridCell(GRID0.Row, 5))			'은행코드
	grBnkName = Trim(GRID0.GetGridCell(GRID0.Row, 6))			'은행명
	grAccnData = Trim(GRID0.GetGridCell(GRID0.Row, 8))			'계좌번호
	grAccnText = Trim(GRID0.GetGridText(GRID0.Row, 8))			'계좌번호(포맷)
	grAccnName = Trim(GRID0.GetGridCell(GRID0.Row, 9))			'계좌명
	grAccnNick = Trim(GRID0.GetGridCell(GRID0.Row, 10))			'닉네임

	If grBnkCode = "" Or grBnkName = "" Or grAccnData = "" Then
		Exit Sub
	End If

	If grCorpType = "1" Then
		F1.Checked = True
	Else
		F2.Checked = True
	End If

	Call selInptGiGwan()

	CMB_MY.Data = grBnkCode
	Bank_Code.Data = grBnkCode
	SELECTBANK.Text = grBnkName
	bank_acct.Data = grAccnData
	Nick.Data = grAccnNick

	If GRID0.Column = 12 Then
		Call delete_action(grAccnText, grAccnName)
	End If
End Sub

