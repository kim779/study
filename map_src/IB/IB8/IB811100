Sub Set_account()
	Dim accn
	SCREEN.ClearAll 0, 2
'	If SYSTEM.ConnectBy = "1" Then
		AN1A.data = Trim(CMB_ACCT.Data)
'	End If

	accn = Left(AN1A.data, 3)
	If (accn < "551" Or accn > "558") And accn <> "561" Then	'201006 558계좌 추가(은행예수금계좌, IBK주거래생활금융통장)
		ACNM.Data = AN1A.Name
	End If
	zPwd.Clear
	zpwd1.Clear

	If Len(Trim(AN1A.Data)) <> 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If
End Sub

Sub checkbox()
	If CHECK0.Checked = True And CHECK1.Checked = True And CHECK2.Checked = True And CHECK3.Checked = True Then
		agree.Enable = True
	Else
		agree.Enable = False
	End If
End Sub

Sub send_agree()
	Acct.Data = Trim(CMB_ACCT.data)
	EDIT1.Data = zPwd.Data
	EDIT2.Data = "1"

	If Len(Trim(Acct.Data)) <> 11 Then
		CMB_ACCT.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하여 주시기 바랍니다."
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Object("OBJECT3.IntaccNo").Data = Trim(CMB_ACCT.Data)
	SCREEN.Object("OBJECT3.Pwd").Data = Trim(zPwd.Data)
	OBJECT3.Send

	If SYSTEM.ConnectBy = "1" Then
		alert_msg("임직원은 이용하실 수 없습니다.")
		Exit Sub
	End If


End Sub

Sub OkSend()
	SCREEN.Send 0
End Sub

Sub send_cancel()
	Acct.Data = Trim(CMB_ACCT.data)
	EDIT1.Data = zPwd.Data
	EDIT2.Data = "2"

	If Len(Trim(Acct.Data)) <> 11 Then
		CMB_ACCT.SetFocus1
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		alert_msg("임직원은 이용하실 수 없습니다.")
		Exit Sub
	End If

	SCREEN.Send 0
End Sub

Sub check_cancel()
	CHECK0.Checked = False
	CHECK1.Checked = False
	CHECK2.Checked = False
	CHECK3.Checked = False
End Sub

Sub staff_send()
	Acct.Data = Trim(AN1A.data)
	EDIT1.Data = zpwd1.Data

	EDIT2.Data = "3"

	If Len(Trim(Acct.Data)) <> 11 Then
		Acct.SetFocus
		Exit Sub
	End If

	Dim check
	check = SYSTEM.CheckPasswd(Trim(zpwd1.Data))

	If check = True Then
		SCREEN.OnSend = True
	Else
		Call alert_msg("비밀번호를 확인하십시오.")
		Exit Sub
	End If

	SCREEN.Send 0
End Sub

