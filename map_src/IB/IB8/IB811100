Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)

	If LABEL7.Text = "0" Then
		LABEL7.Text = ""
		LABEL7.Visible = False
		Exit Sub
	End If
	Call start_cb()
End Sub

Sub start_cb()
	If ProductCB.Data = "018" Then
		LABEL7.Visible = True
		LABEL7.Text = "RMS수수료 0%, 최초 3개월 6.8%, 연장시 6.8%"
	ElseIf ProductCB.Data = "077" Then
		LABEL7.Visible = True
		LABEL7.Text = "RMS수수료 0%, 최초 6개월 4.2%, 연장시 4.9%"
	ElseIf ProductCB.Data = "081" Then
		LABEL7.Visible = True
		LABEL7.Text = "RMS수수료 0%, 최초 6개월 4.2%, 연장시 4.9%"
	End If
End Sub

