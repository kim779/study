	' 권리일자유형에 따른 콤보박스 Item 세팅
	If RADIO0.Checked Then items = Array("00기준일", "11청약일", "05상장일")
	If RADIO1.Checked Then items = Array("00기준일", "07단주대금지급일", "05상장일")
	If RADIO2.Checked Then items = Array("00기준일", "09배당지급일", "07단주대금지급일", "05상장일")
