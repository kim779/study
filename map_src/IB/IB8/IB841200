	If RADIO5.Checked Then items = Array("00기준일", "09대금지급일")
	'If RADIO6.Checked Then items = Array("00기준일","01배정작업일","02단주매각대금계산일","03세금계산일","04세금출금일","05권리주식입고일","06주식소각일","07단주매각대금지급일","08유통단주매각대금지급일","09배정금액지급일","10매수청구대금지급일","11청약시작일","12청약종료일","13반대의사접수시작일","14반대의사접수종료일","15매수청구접수시작일","16매수청구접수종료일","17매수청구취하접수시작일","18매수청구취하접수종료일","19공모청약시작일","20공모청약종료일","31결산일","32주총일","33이사회결의일","34납입일","35주주명부등재일","36신주인수권기준일")
	If RADIO6.Checked Then items = Array("01권리행사시작일", "02신청시작일", "03주식상장일", "04단주대금지급일")
	RgtDatePtnCode.SetItems "02" & vbTab & Join(items, vbTab)
	RgtDatePtnCode.Index = 0
End Sub

Sub Request(bNext)
	Dim RgtTp, IsuNo

	'일자 기입
	SCREEN.Object("OBJ.RgtDt").Data = QrySrtDt.Data
	' 종목번호 조립 주식의 경우 A
	If RADIO6.Checked Then
		IsuNo = Trim(jscd.Data)
	Else
		If Len(Trim(S1301.Data))>0 Then
			If SCREEN.GetCodeType(Trim(S1301.Data)) <> 27 Then
				IsuNo = Trim("A" & S1301.Data)
			Else
				IsuNo = Trim("Q" & S1301.Data)
			End If
		End If
	End If

	' 권리구분 세팅
	If RADIO0.Checked Then RgtTp="0"
	If RADIO1.Checked Then RgtTp="1"
	If RADIO2.Checked Then RgtTp="2"
	If RADIO3.Checked Then RgtTp="3"
	If RADIO4.Checked Then RgtTp="4"
	If RADIO5.Checked Then RgtTp="5"
	If RADIO6.Checked Then RgtTp="6"

	If r_all.Checked = True Then
		SCREEN.Object("OBJ.IsuNo").Data = ""
	Else
		SCREEN.Object("OBJ.IsuNo").Data = IsuNo
	End If
	SCREEN.Object("OBJ.RgtTp").Data = RgtTp
	SCREEN.Object("OBJ.RgtDatePtnCode").Data = RgtDatePtnCode.Data
	If bNext<>True Then
		OBJ.Proc "send_f", ""
	Else
		OBJ.Proc "send_n", ""
	End If

End Sub

