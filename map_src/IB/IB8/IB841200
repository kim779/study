Sub ChangeCode()
	' 종목코드 변경시 종목명 컨트롤 세팅 (주식의 경우에만), 조회는 Request에서
	If RADIO6.Checked Then
		cgname.Data = SCREEN.GetName(105, jscd.Data, 0)
	Else
		If Trim(S1301.Data)<>"" Then
			SCREEN.Object("OBJ01.1301").Data = S1301.Data
			OBJ01.Send
		End If
	End If
	'Request(False)
End Sub

