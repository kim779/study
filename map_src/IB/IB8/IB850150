Sub send_e()
	If CheckInput(AN1A, zPwd) = False Then
		Exit Sub
	End If

	If Trim(S1301.Data) = "" Then
		alert_msg("종목코드를 입력하세요")
		S1301.SetFocus
		Exit Sub
	End If

	If Trim(lRfundQty.Data) <= 0 Then
		alert_msg("상환수량을 입력하세요")
		lRfundQty.SetFocus
		Exit Sub
	End If

	If Trim(zLoanDt.Data) <= 0 Then
		alert_msg("대출일자를 입력하세요")
		zLoanDt.SetFocus
		Exit Sub
	End If

	dmsg = "acno" & vbTab & AN1A.Data & vbLf &_
		   "acnm" & vbTab & AN1A.Name & vbLf &_
		   "hnam" & vbTab & Mid(SCREEN.Object("OBJECT0.1022").Data, 2) & vbLf &_
		   "capa" & vbTab & lRfundQty.Data & vbLf &_
		   "loandate" & vbTab & zLoanDt.Data & vbLf

	SCREEN.CreateWindow 2, "IB85015A /p5 /d", dmsg

	If SYSTEM.Pop("request") <> "OK" Then
		Exit Sub
	Else
		If IsBnkAccnType(AN1A) = True Then
			SCREEN.Proc "obj_inqueryMoney.send_f", ""
		Else
			Call send_o()
		End If
	End If
End Sub

