{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 0
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
zAcntNo.Data = SCREEN.Object("main.obj1.CMB_ACCT").Data
zPwd.Data = SCREEN.Object("main.obj1.zPwd").Data
zSrtIsuNo.Data = ""
zQryTp.Data = 0

If CheckInput(SCREEN.Object("main.obj1.CMB_ACCT"), SCREEN.Object("main.obj1.zPwd")) = True Then
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	If GRID0.Rows > 0 Then
		If Trim(GRID0.GetGridCell(1, 1)) = "" Then
			Exit Sub
		End If

		SCREEN.Proc "obj_getAvailQty.initData", ""
	End If

	SCREEN.Object("main.GUIDE").text = LEDGER.Emsg
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	If Trim(GRID0.GetGridCell(GRID0.Row, 1)) <> "" Then
		SCREEN.Object("parent.tmp_zIsuNo").Data = Trim(GRID0.GetGridCell(GRID0.Row, 1))	'종목코드
		SCREEN.Object("parent.zIsuNo").Data = Trim(GRID0.GetGridCell(GRID0.Row, 1))		' 종목코드
		SCREEN.Object("parent.jmNm").Data = Trim(GRID0.GetGridCell(GRID0.Row, 2))		'종목명
		SCREEN.Object("parent.zTrxQty").Data = Trim(GRID0.GetGridCell(GRID0.Row, 20))	'가능수량
		SCREEN.Object("parent.zBuyDate").data = Trim(GRID0.GetGridCell(GRID0.row, 3))	' 매수일자
		'SCREEN.Object("parent.zTxontTp").Data = Trim(GRID0.GetGridCell(GRID0.row, 4)) ' 과세유형

		' 과세유형
		If Trim(GRID0.GetGridCell(GRID0.row, 4)) = "종합과세" Then
			SCREEN.Object("parent.zTxontTp").Data = 1
		ElseIf Trim(GRID0.GetGridCell(GRID0.row, 4)) = "분리과세" Then
			SCREEN.Object("parent.zTxontTp").Data = 2
		End If

	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	If Trim(GRID0.GetGridCell(GRID0.Row, 8)) <> "" Then
'		'가능수량
		SCREEN.Object("main.canbuy").data = Trim(GRID0.GetGridCell(GRID0.Row, 26))
		SCREEN.Proc "main.Setting_canbuy", ""
'
