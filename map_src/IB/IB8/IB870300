RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim Today, thisYear, thisMon
Today = getCurrDay()
thisYear = Year(Now)
thisMon = Month(Now)

Sub quarter()
	Select Case thisMon
		Case 1, 2, 3
			zQrySrtDt.Data = thisYear & "0101"
			zQryEndDt.Data = thisYear & "0331"
		Case 4, 5, 6
			zQrySrtDt.Data = thisYear & "0401"
			zQryEndDt.Data = thisYear & "0630"
		Case 7, 8, 9
			zQrySrtDt.Data = thisYear & "0701"
			zQryEndDt.Data = thisYear & "0930"
		Case 10, 11, 12
			zQrySrtDt.Data = thisYear & "1001"
			zQryEndDt.Data = thisYear & "1231"
	End Select
End Sub


'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub CheckDate()
	Dim MyWeek

	MyWeek = Weekday(Date)

	'토,일요일일 경우 시간에 관계없이 조회
	If MyWeek = 1 Or MyWeek = 7 Then
		Call send_f()
		Exit Sub
	End If

	If Trim(zQryTermTp.Data) = "1" And Trim(zQryEndDt.Data) = Today And Trim(zQryEndDt.Data) = Trim(zQrySrtDt.Data) Then
		Call send_f()
	Else								'기간조회 이외
		If CDbl(Hour(Now)) < 15 And CDbl(Hour(Now)) >= 9 Then
			Call ErrMsgBox()
			Call SetGigan()
			Exit Sub
		End If

		Call send_f()
	End If
End Sub

Sub ErrMsgBox()
	Dim sen

	Select Case zQryTermTp.Index
		Case 0 : sen = "기간 조회는 "
		Case 2 : sen = "금월 조회는 "
		Case 3 : sen = "금기 조회는 "
	End Select

	MsgBox sen&"장중시간(09:00 ~ 15:30)에 조회가 불가능합니다.", , "IBK투자증권"
End Sub

Sub SetGigan()
	SCREEN.IgnoreChange True
	zQryTermTp.Data = 1
	zQrySrtDt.Data = Today
	zQryEndDt.Data = Today
	zQrySrtDt.Enable = True
	zQryEndDt.Enable = True
	SCREEN.IgnoreChange False
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
SCREEN.Object("main.guide").text = ""

If Trim(zBrnNo.Data) <> "" And Len(Trim(zBrnNo.Data)) = 3 Then
	SCREEN.onsend = True
Else
	MsgBox "지점번호를 확인하십시오.", ,"IBK투자증권"
	zBrnNo.SetFocus
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)

If LEDGER.Next = "Y" Then
'	next_btn.Enable = True
'	next_btn.SetFocus
	Call send_c()
Else
'	next_btn.Enable = False
	If Trim(zBrnNm.Data) = "" Then
		zBrnNo.Clear
		SCREEN.ClearAll 0, 2
		SCREEN.Object("main.guide").text = ""
		MsgBox "지점번호를 확인하십시오.",,"IBK투자증권"
		zBrnNo.SetFocus
		Exit Sub
	End If

	Dim ii
	For ii=1 To GRID1.Columns
		GRID0.SetGridCell 1, ii, GRID1.GetGridCell(GRID1.Rows, ii)
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zQryTermTp)
_AW_ONCHANGE_AW_
Select Case zQryTermTp.Index
	Case "0"
		zQrySrtDt.Enable = True
		zQryEndDt.Enable = True

		SCREEN.IgnoreChange True
		zQrySrtDt.Data =  Today
		zQryEndDt.Data =  Today
		SCREEN.IgnoreChange False
	Case "1"
		zQrySrtDt.Enable = False
		zQryEndDt.Enable = False

		SCREEN.IgnoreChange True
		zQrySrtDt.Data =  Today
		zQryEndDt.Data =  Today
		SCREEN.IgnoreChange False
	Case "2"
		Dim curDay
		zQrySrtDt.Enable = False
		zQryEndDt.Enable = False

		curDay = Right(Date, 2)

		If Len(thisMon) = 1 Then
			thisMon = "0" & thisMon
		End If

		SCREEN.IgnoreChange True
		zQrySrtDt.Data =  thisYear & thisMon & "01"
		zQryEndDt.Data =  thisYear & thisMon & curDay
		SCREEN.IgnoreChange False
	Case "3"
		zQrySrtDt.Enable = False
		zQryEndDt.Enable = False

		Call quarter()
End Select

Call CheckDate()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zQrySrtDt)
_AW_ONCHANGE_AW_
'If Trim(zQrySrtDt.Data) > Today Then
'	zQrySrtDt.Data = Today
'	Exit Sub
'End If

If CLng(Trim(zQryTermTp.Index)) = 0 Then
	Call CheckDate()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zCommdaCode)
_AW_ONCHANGE_AW_
Call CheckDate()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call CheckDate()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zBrnNo)
_AW_ONCHANGE_AW_
SCREEN.ClearAll 0, 2

Call CheckDate()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim findNo, findNm

SYSTEM.Push "branchNo8703", ""
SYSTEM.Push "branchNm8703", ""

SCREEN.CreateWindow 2, "IB870310  /t /s /p?" , ""

findNo = SYSTEM.Pop("branchNo8703")
findNm = SYSTEM.Pop("branchNm8703")

If findNo = "" Or findNm = "" Then
	zBrnNo.SetFocus
	Exit Sub
Else
	zBrnNo.Data = findNo
	zBrnNm.Data = findNm

	Call CheckDate()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zQryEndDt)
_AW_ONCHANGE_AW_
If CLng(Trim(zQryTermTp.Index)) = 0 Then
	Call CheckDate()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 2, "IB870320 /p?", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zAcmgtCode)
_AW_ONCHANGE_AW_
Call CheckDate()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



