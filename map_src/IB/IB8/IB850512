RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Function comChkData(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		comChkData = False
		Exit Function
	Else
		comChkData = True
		Exit Function
	End If
End Function

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

LEDGER.Rcnt = "0026"
zIn.Data = "00001"
zBrnNo.Data = "000"

zAcntNo.Data = SCREEN.Object("parent.AN50").data
zPwd.Data = SCREEN.Object("parent.zPwd").data




If CheckInput(zAcntNo, zPwd) = True Then
	SCREEN.OnSend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If comChkData(ecod) = False Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
	If LEDGER.Next = "Y" Then
		next_btn.Enable = True
	Else
		next_btn.Enable = False
	End If
End If

If Len(Trim(SCREEN.Object("parent.zPwd").Data)) < 4 Then
	SCREEN.Object("parent.zPwd").SetFocus
Else
	SCREEN.Object("parent.aa").SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(QrySrtDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(QryEndDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

If Trim(GRID0.GetGridCell(GRID0.Row, 3)) = "" Then
	Exit Sub
End If

If SCREEN.Object("main.UTAB0").ID = "3" Then
	If Trim(GRID0.GetGridCell(GRID0.Row, 13)) = "현금상환" Then
		SCREEN.Object("parent.aa").Data = Trim(GRID0.GetGridCell(GRID0.Row, 3))
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



