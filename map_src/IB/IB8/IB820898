_AW_ONDECLARE_AW_
Sub clickevet()
	Dim data , D1,D2
	If SCREEN.Object("OBJECT0.GRID0").HitPos = 3 Then
		D1 = Trim(SCREEN.Object("OBJECT0.GRID0").GetGridCell(SCREEN.Object("OBJECT0.GRID0").Row,1))
		D2 = Trim(SCREEN.Object("OBJECT0.GRID0").GetGridCell(SCREEN.Object("OBJECT0.GRID0").Row,2))
		If D1 <> "" And D2 <> "" Then
			data = D1&"|"&D2
			SYSTEM.Push "RaStdIndstCode",data
			SCREEN.CloseWindow
		End If
	End If
End Sub

