{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"

If SCREEN.GetMapName(1) = "IB840200" Or SCREEN.GetMapName(1) = "IB872500" Then
	zQryTp.Data = "1"
	zAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

	If Len(Trim(zAcntNo.Data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하여 주십시오.")
		SCREEN.Object("parent.AN1A").SetFocus
		Exit Sub
	End If

	' 기존 Main 좌측상단 그리드에서 종목 선택시만 일자 세팅되던 부분을
	'zAppySrtDt.Data = Trim(SCREEN.Object("parent.zAppySrtDt").Data)
	
	' Main 우측상단 청약증거금 조회에서 사용하는 일자로 변경
	zAppySrtDt.Data = SCREEN.Object("Main.obj0.zAppySrtDt").Data
Else
	zQryTp.Data = "2"
	zAcntNo.Data = Trim(SCREEN.Object("parent.OUTPUT11").Data)
	zAppySrtDt.Data = getCurrDay()
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
		If Trim(zClntTp.Data) = "2" Then
			SCREEN.Object("parent.cus_grade").Text = "우대(200%)"
		ElseIf Trim(zClntTp.Data) = "1" Then
			SCREEN.Object("parent.cus_grade").Text = "일반(온라인 청약시 150%)"
		Else
			SCREEN.Object("parent.cus_grade").Text = "일반(100%)"
		End If
Else
	If ecod = "2679" Then
		Call guide_msg(Trim(LEDGER.Emsg))
	Else
		Call alert_msg(Trim(LEDGER.Emsg))
	End If
End If

