_AW_ONDECLARE_AW_
Dim g_ArrObjs

g_ArrObjs = Array(Array(OBJECT0, OBJECT1), Array(OBJECT2, OBJECT3))
'----------------------------------------------------------------------
Sub SendDecData(Index)
	g_ArrObjs(Index)(1).Proc "SendData", ""
End Sub
'----------------------------------------------------------------------
Sub CalcCdData(Index)
	g_ArrObjs(Index)(1).Proc "CalcCdData", ","
End Sub
'----------------------------------------------------------------------
Sub SetItemCd(Index, Data)
	g_ArrObjs(Index)(1).Proc "SetItemCd", Data
End Sub
'----------------------------------------------------------------------
Sub SetDecAndSrchData(Index, Data)
	g_ArrObjs(Index)(0).Proc "SetDecAndSrchData", Data
End Sub
'----------------------------------------------------------------------
Sub SetCdData(Index, Data)
	g_ArrObjs(Index)(1).Proc "SetCdData", Data
End Sub
'----------------------------------------------------------------------
Sub SetSrchDate(Index, Data)
	g_ArrObjs(Index)(1).Proc "SetSrchDate", Data
End Sub
'----------------------------------------------------------------------
Sub SetFirstDeciDate(Index, Data)
	g_ArrObjs(Index)(1).Proc "SetDecDate", Data
End Sub
'----------------------------------------------------------------------
Sub comb_list_done()
	Dim grid, item, txt
	Dim jnam, jcod, jgub
	item = ""
	Set grid = SCREEN.Object("OBJ.GRID0")
	For ii=1 To grid.Rows
		jcod = grid.GetGridCell(ii, 1)
		jnam = grid.GetGridCell(ii, 2)
		jgub = grid.GetGridCell(ii, 3)
		If jcod = "" Then
			Exit For
		End If
		txt = jgub & jcod

		item = item & txt & jnam & vbTab
		If ii=1 Then
			item = txt & vbTab & item
		End If
	Next
	SCREEN.Object("cdrt").Data = SCREEN.Object("OBJ.cdkr").Data
	SCREEN.Object("jcom1").SetItems item
	SCREEN.Object("jcom2").SetItems item
End Sub

_AW_ONSTART_AW_
OBJECT0.Proc "SetIndex", "0"
OBJECT1.Proc "SetIndex", "0"
OBJECT2.Proc "SetIndex", "1"
OBJECT3.Proc "SetIndex", "1"

_AW_ONENDSUB_AW_
}



