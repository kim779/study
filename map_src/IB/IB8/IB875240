'----------------------------------------------------------------------
Function GetDate(ADate, DefaultMon)
	ArrData = Split(ADate, "/")
	AYear = ""
	AMon = ""
	ADay = ""
	GetDate = ""
	If UBound(ArrData) = 2 Then
		If Len(ArrData(0)) = 2 Then
			AYear = "20" & ArrData(0)
		Else
			AYear = ArrData(0)
		End If
		AMon = ArrData(1)
		If Len(AMon) = 1 Then
			AMon = "0" & AMon
		End If
		ADay = ArrData(2)
		If Len(ADay) = 1 Then
			ADay = "0" & ADay
		End If
	ElseIf UBound(ArrData) = 1 Then
		AYear = Year(Date)
		AMon = ArrData(0)
		If Len(AMon) = 1 Then
			AMon = "0" & AMon
		End If
		ADay = ArrData(1)
		If Len(ADay) = 1 Then
			ADay = "0" & ADay
		End If
	ElseIf UBound(ArrData) = 0 Then
		AYear = Year(Date)
		AMon = DefaultMon
		If Len(AMon) = 1 Then
			AMon = "0" & AMon
		End If
		ADay = ArrData(0)
		If Len(ADay) = 1 Then
			ADay = "0" & ADay
		End If
	End If
	GetDate = AYear & AMon & ADay
End Function
'----------------------------------------------------------------------
Function GetWeekNo(Data, DefaultYear)
	GetWeekNo = ""
	ArrData = Split(Data, "월")
	ArrData(0) = Trim(ArrData(0))
	ArrData(1) = Trim(ArrData(1))
	ArrData2 = Split(ArrData(1), "주차")

	AMon = ArrData(0)
	If Len(AMon) = 1 Then
		AMon = "0" & AMon
	End If

	AYear = DefaultYear
	If Len(AYear) = 4 Then
		AYear = Mid(AYear, 3, 2)
	End If

	AWeek = ArrData2(0)
	If Len(AWeek) = 1 Then
		AWeek = "0" & AWeek
	End If

	GetWeekNo = AYear & AMon & AWeek
End Function
'----------------------------------------------------------------------
Function OpenExcel(FileName)
	Dim objExcel
	Dim objWorkBook
	Dim objSheet
	Dim DictData

	Set objExcel = CreateObject("Excel.Application")
	objExcel.Visible = False

	OpenExcel = ""

	Set objWorkBook = objExcel.WorkBooks.Open(FileName)
	Set objSheet = objWorkBook.WorkSheets(1)
	ArrData = Split(objSheet.Name, ".")
	StdMon = ArrData(1)
	StdYear = ArrData(0)
	AMon = ArrData(1)
	iLoadCnt = 0
	BefMon = ""

	InitData

	WeekNo = Trim(objSheet.cells(2, 16))
	WeekNo = Replace(WeekNo, "(", "")
	WeekNo = Replace(WeekNo, ")", "")
	WeekNo = GetWeekNo(WeekNo, StdYear)
	'SYSTEM.Trace WeekNo
	For i = g_ArrConv(0) To g_ArrConv(1)
		'발행사명
		IssueNm = Trim(objSheet.cells(i, 2))
		If Len(IssueNm) = 0 Then
			Exit For
		End If

		'청약기간
		Data = Trim(objSheet.cells(i, 3))
		ArrData = Split(Data, "~")
		AppSttDate = GetDate(ArrData(0), AMon)
		AppEndDate = ""
		If UBound(ArrData) = 0 Then
			AppEndDate = AppSttDate
		Else
			If BefMon = "" Then
				BefMon = AMon
			End If
			AppEndDate = GetDate(ArrData(1), AMon)
		End If
		If Len(AppSttDate) <> 8 Or Len(AppEndDate) <> 8 Then
			OpenExcel = "로딩실패 INDEX[" & i & "] 청약일자관련"
			Exit For
		End If

		'납입일
		Data = Trim(objSheet.cells(i, 4))
		PayDate = GetDate(Data, StdMon)

		'회차
		IssueNo = Trim(objSheet.cells(i, 5))

		'기초자산
		ArrKrCode = Array("", "")
		Data = Trim(objSheet.cells(i, 7))
		Pos = InStr(Data, "_")
		Data = Mid(Data, Pos + 1, Len(Data) - Pos)
		ArrData = Split(Data, "/")

		If UBound(ArrData) > 1 Then
			OpenExcel = "로딩실패 INDEX[" & i & "] 기초자산명 2개초과"
			Exit For
		End If

		For j = LBound(ArrData) To UBound(ArrData)
			Data = Trim(ArrData(j))
			If Not g_DictItem.Exists(Data) Then
				OpenExcel = "로딩실패 INDEX[" & i & "] 기초자산명 " & j + 1 & "번째[" & Data & "]"
				Exit For
			Else
				ArrKrCode(j) = Trim(g_DictItem.Item(Data))
			End If
		Next
		If Len(OpenExcel) <> 0 Then
			Exit For
		End If

		If UBound(ArrData) = 0 Then
			ArrKrCode(1) = ArrKrCode(0)
		End If

		'조기상환가격수준
		RepLevel = Trim(objSheet.cells(i, 8))

		'KI
		KI = Trim(objSheet.cells(i, 9))
		If KI = "-" Then
			KI = "0"
		ElseIf KI = "" Then
			KI = "0"
		End If

		'총수익률
		Data = Trim(objSheet.cells(i, 10))
		If Not IsNumeric(Data) Then
			Data = "0"
		End If
		TotRate = Data * 100

		'만기
		ExpiYear = Trim(objSheet.cells(i, 11))

		'조기상환주기
		RepFreq = Trim(objSheet.cells(i, 12))

		'연수익
		YearRate = Trim(objSheet.cells(i, 13))
		If Not IsNumeric(YearRate) Then
			YearRate = "0"
		Else
			YearRate = YearRate * 100
		End If

		'조기상환확률
		RepRate = Trim(objSheet.cells(i, 14))
		RepRate = FormatNumber(RepRate/100, 4, -2, -2, 0)
		If Not IsNumeric(RepRate) Then
			RepRate = "0"
		Else
			RepRate = RepRate * 100
		End If

		'원금손실확률
		LossRate = Trim(objSheet.cells(i, 15))
		LossRate = FormatNumber(LossRate/100, 4, -2, -2, 0)
		If Not IsNumeric(LossRate) Then
			LossRate = "0"
		Else
			LossRate = LossRate * 100
		End If

		'KI발생시예상자산
		KIAssetRate = Trim(objSheet.cells(i, 16))
		KIAssetRate = FormatNumber(KIAssetRate/100, 4, -2, -2, 0)
		If Not IsNumeric(KIAssetRate) Then
			KIAssetRate = "0"
		Else
			KIAssetRate = KIAssetRate * 100
		End If

		'0 : 주차
		'1 : 순서
		'0 :발행사명
		'1 :청약시작일자
		'2 :청약종료일자
		'3 :납입일
		'4 :회차
		'5 :기초자산코드1
		'6 :기초자산코드2
		'7 :조기상환가격수준
		'8 :KI
		'9 :총수익률
		'10:만기
		'11:조기상환주기
		'12:연수익
		'13:조기상환확률
		'14:원금손실확률
		'15:KI발생시예상자산

		Data = WeekNo & "|" & iLoadCnt & "|" &IssueNm & "|" & AppSttDate & "|" &_
			AppEndDate & "|" & PayDate & "|" & IssueNo & "|" & ArrKrCode(0) & "|" &_
			ArrKrCode(1) & "|" & RepLevel & "|" & KI & "|" & TotRate & "|" &_
			ExpiYear & "|" & RepFreq & "|" & YearRate & "|" & RepRate & "|" &_
			LossRate & "|" & KIAssetRate

		g_DictData.Add iLoadCnt, Data

		iLoadCnt = iLoadCnt + 1
		g_ArrData(1) = iLoadCnt
		BefMon = Mid(AppSttDate, 5, 2)
	Next

	InsertData

	objExcel.WorkBooks.Close
	objExcel.Quit
	If Len(OpenExcel) = 0 Then
		OpenExcel = "LOAD COUNT=[" & iLoadCnt & "]"
	End If
'	SYSTEM.Trace OpenExcel & "|" & i
End Function

