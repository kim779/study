RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_ArrConv
Dim g_DictItem
Dim g_ArrExceptItem
Dim g_DictData
Dim g_ArrData
Dim g_ArrCtrls
Dim g_ArrComb

'0 : StartRowIndex
'1 : EndRowIndex
'2 : StartColIndex
'3 : EndColIndex
g_ArrConv = Array(4, 65535, 2, 15)
Set g_DictItem = CreateObject("Scripting.Dictionary")
Set g_DictData = CreateObject("Scripting.Dictionary")
'0:DictData, 1:Dict 갯수, 2:INSERT INDEX
g_ArrData = Array(g_DictData, 0, -1)
g_DictItem.Add "HSCEI", "HSI@HSCE"
g_DictItem.Add "S&P500", "SPI@SPX"

'0 :구분
'1 :주차
'2 :순서
'3 :발행사명
'4 :청약시작일자
'5 :청약종료일자
'6 :납입일
'7 :발행회차
'8 :기초코드1
'9 :기초코드2
'10 :조기상환수준
'11:KI
'12:총수익률
'13:만기기간
'14:조기상환주기
'15:연수익률
'16:조기상환확률
'17:원금손실확률
'18:KI예상자산
g_ArrCtrls = Array(ed_gubn, ed_wkno, ed_sqno, ed_isnm, ed_apst,_
	ed_apet, ed_pydt, ed_isno, ed_cod1, ed_cod2,_
	ed_rplv, ed_kida, ed_trat, ed_exyr, ed_rpfq,_
	ed_yrrt, ed_rppb, ed_lspb, ed_kiap)

g_ArrComb = Array()
'----------------------------------------------------------------------
Sub SetComboIndex(Data)
	Index = -1
	For i = LBound(g_ArrComb) To UBound(g_ArrComb)
		CompData = Trim(g_ArrComb(i))
		StdData = Trim(Data)
		If CompData = StdData Then
			Index = Index + 1
			Exit For
		End If
		Index = Index + 1
	Next
	If Index >= 0 Then
		cb_WeekNo.Index = Data
	End If
End Sub
'----------------------------------------------------------------------
Sub SendOBJ0()
	OBJ0.Send
End Sub
'----------------------------------------------------------------------
Sub InitCtrls()
	For i = 2 To UBound(g_ArrCtrls)
		g_ArrCtrls(i).Data = ""
	Next
End Sub
'----------------------------------------------------------------------
Sub SetGuideData(Data)
	GUIDE1.Text = Data & " " & "(" & g_ArrData(1) & "/" & g_ArrData(2) & ")"
End Sub
'----------------------------------------------------------------------
Sub InitData()
	g_ArrData(0).RemoveAll
	g_ArrData(1) = 0
	g_ArrData(2) = -1
	g_ArrCtrls(0).Data = "Q"
End Sub
'----------------------------------------------------------------------
Sub InsertData()
	If g_ArrData(1) = 0 Then
		InitData
		OBJ0.Send
		Exit Sub
	End If

	If CLng(g_ArrData(1)) - 1 = g_ArrData(2) Then
		InitData
		OBJ0.Send
		Exit Sub
	End If
	g_ArrData(2) = g_ArrData(2) + 1
	Data = g_ArrData(0).Item(g_ArrData(2))
	'SYSTEM.Trace Data
	OBJ2.Proc "InsertData", Data
End Sub
'----------------------------------------------------------------------
Sub SetItemData(Data, Rows)
	If Rows <> 0 Then
		ArrData = Split(Data, "`")
		For i = LBound(ArrData) To UBound(ArrData)
			ArrData2 = Split(ArrData(i), "|")
			g_DictItem.Add ArrData2(1), ArrData2(0)
