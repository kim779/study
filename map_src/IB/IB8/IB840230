_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub SetDate()
	Dim yy, mm, dd, cday, MyWeek
	cday = DateAdd("d", -2, Date)
	MyWeek = Weekday(cday)

	If MyWeek = 1 Then
		cday= DateAdd("d", -2 , cday)
	ElseIf MyWeek = 7 Then
		cday= DateAdd("d", -1 , cday)
	End If

	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)

	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd

	zAppySrtDt.Data = cday
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

Call SetDate()
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim ii, str, jmNm

	For ii = GRID0.Rows To 1 Step -1
		jmNm = Trim(GRID0.GetGridCell(ii, 2))

		' ELS, DLS, DLB 제외
		If (InStr(jmNm, "ELS") Or InStr(jmNm, "DLS") Or InStr(jmNm, "DLB")) > 0 Then
			GRID0.RemoveRow (ii - 1)
		Else
			str = Trim(GRID0.GetGridCell(ii, 1))

			If Left(str, 1) = "A" Then
				GRID0.SetGridCell ii, 1, Mid(str, 2, Len(str))
			End If
		End If
	Next

	SCREEN.Proc "main.obj1.Set_focus", ""
End If

