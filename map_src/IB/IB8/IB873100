RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MYFILE = "userconf.ini"
Const MYMAP = "IB873100"

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "zAcmgtCode", zAcmgtCode.Data
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim temp
		temp = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "zAcmgtCode"))
		SCREEN.IgnoreChange True
		If temp <> "" Then
			zAcmgtCode.Data = temp
		End If
		SCREEN.IgnoreChange False
	End If
End Sub

'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"
zEmpNo.Data = SYSTEM.UserID
Call p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

If CheckInput_1(zEmpNo, zEmpPwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 1,2
	zEmpPwd.Clear
	zEmpPwd.SetFocus
End If

Select Case sec.data
	Case "1"	zEmpNo.SetFocus
	Case "2"	zEmpPwd.SetFocus
	Case "3"	send_btn.SetFocus
	Case "4"    next_btn.SetFocus
End Select

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
	GRID0.SetFormat GRID0.rows, 1, "99999999"
	'그리드 마지막 행의 첫번째 셀은 '/ /' 표시를 제거하기 위해 사용
End If

_AW_ONENDSUB_AW_
