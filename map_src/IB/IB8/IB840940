'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	SCREEN.proc "Main.OBjSend", ""
	ACNM.Data = AN1A.Name
	zpwd.Data = AN1A.Password

	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If
End Sub

'== 첫 조회
Sub send_f()

Dim hnam
If jusik.Checked = True Then
	hnam = Mid(SCREEN.Object("obj.1022").Data, 2)
Else
	hnam = chae_nm.Data
End If

	dmsg = "acno" & vbTab & AN1A.Data & vbLf &_
		   "acnm" & vbTab & AN1A.Name & vbLf &_
		   "hnam" & vbTab & hnam & vbLf &_
		   "num" & vbTab & Trim(lAppyNo.Data) & vbLf

			SCREEN.CreateWindow 2, "IB84094A /p5 /d", dmsg

			If SYSTEM.Pop("confirm") <> "OK" Then
				Exit Sub
			Else
				LEDGER.Fkey = "C"
				SCREEN.Send 0
			End If
End Sub

' 계좌 비밀번호만 Send
Sub send_info()
	If CheckInput(AN1A, zpwd) = True Then
		SCREEN.proc "Main.SendObj2", AN1A.Data &","& zpwd.Data
		SCREEN.proc "Main.SendObj3", AN1A.Data &","& zpwd.Data
	 	Exit Sub
	End If
End Sub

