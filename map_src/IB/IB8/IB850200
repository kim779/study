_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

If CheckInput(AN1A, zPwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
Else
	SCREEN.ClearAll 2, 2
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
