	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		SCREEN.Object("parent.OBJ_yact.YChk").data = "0"
		SCREEN.Object("parent.OBJ_yact").Send
	End If
Else
	If Trim(LEDGER.Ecod) = "2679" Then
		SCREEN.Object("parent.OBJ_yact.YChk").data = "1"
		SCREEN.Object("parent.OBJ_yact").Send
	Else
		Call alert_msg(Trim(LEDGER.Emsg))
	End If
