RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub send_o()
	Dim OrdDt, OrdMktCode, MgmtBrnNo, OrdNo, SeExecNo, lCtrctNo, AcntNo
	OrdDt      = Trim(GRID0.GetGridCell(GRID0.Row, 1))
	OrdMktCode = Trim(GRID0.GetGridCell(GRID0.Row, 2))
	MgmtBrnNo  = Trim(GRID0.GetGridCell(GRID0.Row, 3))
	OrdNo      = Trim(GRID0.GetGridCell(GRID0.Row, 4))
	lCtrctNo   = Trim(GRID0.GetGridCell(GRID0.Row, 5))
	SeExecNo   = Trim(GRID0.GetGridCell(GRID0.Row, 6))
	AcntNo     = Trim(GRID0.GetGridCell(GRID0.Row, 7))

	SCREEN.Proc "obj_confirm.send_f", OrdDt & ", " & OrdMktCode & ", " & MgmtBrnNo & ", " & OrdNo & ", " & lCtrctNo & ", " & SeExecNo & ", " & AcntNo
End Sub

Sub DoRecieve()
	Dim ii, IsConfirm, IsHow, OrderAmt, execAmt

	'업무구분이 입력이면 활성화
	'업무구분을 선택하면 자동조회되므로  zAfirTp의 OnChange에 함수를 넣지 않았음.
	'주석처리 -> 그리드에 체크가 되어있지 않으면 비활성화
	If Trim(zAfirTp.Data) = "1" Then
		SCREEN.Object("parent.confirm_btn").Enable = False
		allConfirmChk.Enable = False
		allCnsltPath.Enable = False
	Else
		SCREEN.Object("parent.confirm_btn").Enable = True
		allConfirmChk.Enable = True
		allCnsltPath.Enable = True
	End If

	For ii = gridPos To GRID0.Rows
		'주문가격, 체결가격. 현물이면 소수점 표현 안함. 선물이면 소수점 둘째자리까지 표시
		OrderAmt = Trim(GRID0.GetGridCell(ii, 14))
		execAmt  = Trim(GRID0.GetGridCell(ii, 23))

		If Trim(zPrdtTp.Data) = "1" Then
			If OrderAmt <> "" Then
				OrderAmt = Left(OrderAmt, 13)
			End If

			If execAmt <> "" Then
				execAmt = Left(execAmt, 13)
			End If
		Else
			If OrderAmt <> "" Then
				OrderAmt = Left(OrderAmt, 16)
			End If

			If execAmt <> "" Then
				execAmt = Left(execAmt, 16)
			End If
		End If

		GRID0.SetGridCell ii, 13, OrderAmt
		GRID0.SetGridCell ii, 22, execAmt

		'입력된 내용인지 확인후 체크
		IsConfirm = Trim(GRID0.GetGridCell(ii, 26))

		GRID0.SetGridCell ii, 30, "1"
		GRID0.SetGridCell ii, 30, "0"

		If IsConfirm <> "" Then
			If IsConfirm = "1" Then
				GRID0.SetGridCell ii, 30, "1"
			Else
				GRID0.SetGridCell ii, 30, "0"
			End If
		End If

		IsHow = Trim(GRID0.GetGridCell(ii, 27))

		If IsHow <> "" Then
			GRID0.SetGridCell ii, 32, IsHow
		End If
	Next

	gridPos = GRID0.Rows + 1
	SCREEN.Object("parent.zQryDttm").Data = Trim(zQryDttm.Data)
End Sub

Sub DoCheck()
	Dim IsChecked
	IsChecked = Trim(GRID0.GetGridCell(GRID0.Row, 28))
End Sub

Sub DoConfirm()
	Dim ii, IsChecked

	If SCREEN.Object("parent.servRa_input").Checked = True Then
		IsChecked = False

		For ii = 1 To GRID0.Rows
			If Trim(GRID0.GetGridCell(ii, 30)) = "1" Then
				IsChecked = True
				Exit For
			End If
		Next

		If IsChecked = True Then
			SCREEN.Proc "obj_confirm.inputData", ""
		Else
			Call alert_msg("확인/변경하실 내용에 체크를 하여 주십시오.")
		End If
	ElseIf SCREEN.Object("parent.survRa_change").Checked = True Then
		IsChecked = False

		For ii = 1 To GRID0.Rows
			If Trim(GRID0.GetGridCell(ii, 30)) = "1" Then
				If Trim(GRID0.GetGridCell(ii, 27)) <> Trim(GRID0.GetGridCell(ii, 32)) Then
					IsChecked = True
					Exit For
				End If
			End If
		Next
		If IsChecked = True Then
			SCREEN.Proc "obj_confirm.inputData", ""
		Else
			Call alert_msg("변경된 내역이 없습니다.")
		End If
	End If
End Sub

Sub chkAllConfirm()
	Dim ii, bChk, cnt
	cnt = 0

	If allConfirmChk.Checked = True Then
		bChk = 1
	Else
		bChk = 0
	End If


	For ii = 1 To GRID0.Rows
		GRID0.SetGridCell ii, 30, bChk

		If bChk = 1 Then
			cnt = cnt + 1
		End If
	Next

	If cnt > 0 Then
		SCREEN.Object("parent.confirm_btn").Enable = True
	Else
		SCREEN.Object("parent.confirm_btn").Enable = False
	End If
End Sub

Sub chkAllCnsltPath()
	Dim ii

	For ii = 1 To GRID0.Rows
		GRID0.SetGridCell ii, 32, allCnsltPath.Data
	Next
End Sub

