_AW_ONDECLARE_AW_
Sub Set_init()
	zEmpNo.Data = SYSTEM.UserID
	'zEmpNo.Data = "900100"
	zQrySrtDt.Data = Replace(Date,"-","")
	zQryEndDt.Data = Replace(DateAdd("d", 14, Date),"-","")
	zPrdTp.Data = "00"

	If EmpType.Data <> "" Then
		If EmpType.Data = "1" Then
			zEmpTp.Data = "1"
			UTAB0.Index = 1
		Else
			zEmpTp.Data = "0"
			UTAB0.Index = 0
		End If
	Else
		zEmpTp.Data = 0
	End If
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	Call Set_init()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0007"
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim i,ii,N,M
	ii = 1
	For i=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,7)) <> "" Then
			M = False
			For N=1 To GRID1.Rows
				If Trim(GRID1.GetGridCell(N,1)) = Trim(GRID0.GetGridCell(i,7)) Then
					If Trim(GRID1.GetGridCell(N,2)) = Trim(GRID0.GetGridCell(i,5)) Then
						M = True
					End If
				End If
			Next
			If M = False Then
				GRID1.InsertRow -1
				GRID1.SetGridCell ii,1, Trim(GRID0.GetGridCell(i,7))
				GRID1.SetGridCell ii,2, Trim(GRID0.GetGridCell(i,5))
				ii = ii+1
			End If
		End If
	Next
End If

GRID1.Sort 1,True,False

GRID1.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONDBLCLK_AW_
Dim i,ii
ii = 1
