_AW_ONDECLARE_AW_
Sub Set_account()
	SCREEN.ClearAll 0, 2
	ACNM.Data = AN1A.Name
	h_acnm.Data = AN1A.Name
	zPwd.Data = AN1A.Password

	If Len(Trim(AN1A.Data)) <> 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "0" Then
		zPwd.Data = "9999"
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If
	send_f()
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	ACNM.Data = h_acnm.Data
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Check_LoginType(zPwd)

If SYSTEM.ConnectBy = "1" Then
	LABEL4.Text = "접속비밀번호"
	zPwd1.Visible = True
	zPwd.Visible = False
Else
	zPwd.Visible = True
	zPwd1.Visible = False
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

If SYSTEM.ConnectBy = "1" Then
	Dim check
	check = SYSTEM.CheckPasswd(Trim(zPwd1.Data))

	If check = True Then
		SCREEN.OnSend = True
		zPwd.Data = "9999"
	Else
		Call alert_msg("비밀번호를 확인하십시오.")
		Exit Sub
	End If
Else
	SCREEN.OnSend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

If CHECK0.Checked = False Then
	CHECK0.Checked = True


	SCREEN.Send 0
End If

If pdt_no.Data = "018" Then
	OBJECT0.SetObject "IB811210"
	PANEL2.Text = "대출일"
ElseIf pdt_no.Data = "077" Then
	OBJECT0.SetObject "IB811220"
	PANEL2.Text = "최종 대출일"
ElseIf pdt_no.Data = "081" Then
	OBJECT0.SetObject "IB811220"
	PANEL2.Text = "최종 대출일"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
	Else

			Call send_f()

	End If
End If
