RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub inputData()
	SCREEN.ClearAll 0, 0

	Dim ii, jj, gridObj
	Set gridObj = SCREEN.Object("parent.GRID0")

	For ii = 1 To gridObj.Rows
		If SCREEN.Object("main.servRa_input").Checked = True Then
			zAfirTp.Data = "2"

			If Trim(gridObj.GetGridCell(ii, 30)) = "1" Then
				GRID0.InsertRow -1

				For jj = 1 To 8
					If jj <> 8 Then
						GRID0.SetGridCell GRID0.Rows, jj, Trim(gridObj.GetGridCell(ii, jj))
					Else
						GRID0.SetGridCell GRID0.Rows, jj, Trim(gridObj.GetGridCell(ii, 32))
					End If
				Next
			End If
		ElseIf SCREEN.Object("main.survRa_change").Checked = True Then
			zAfirTp.Data = "3"

			If Trim(gridObj.GetGridCell(ii, 30)) = "1" Then
				If Trim(gridObj.GetGridCell(ii, 27)) <> Trim(gridObj.GetGridCell(ii, 32)) Then
					GRID0.InsertRow -1
					For jj = 1 To 8
						If jj <> 8 Then
							GRID0.SetGridCell GRID0.Rows, jj, Trim(gridObj.GetGridCell(ii, jj))
						Else
							GRID0.SetGridCell GRID0.Rows, jj, Trim(gridObj.GetGridCell(ii, 32))
						End If
					Next
				End If
			End If
		End If
	Next

	Call send_o()
End Sub

Sub send_o()
	Dim OrdDt, OrdMktCode, MgmtBrnNo, OrdNo, SeExecNo, lCtrctNo, AcntNo, CnsltPathTp
	OrdDt 	    = Trim(GRID0.GetGridCell(1, 1))
	OrdMktCode  = Trim(GRID0.GetGridCell(1, 2))
	MgmtBrnNo   = Trim(GRID0.GetGridCell(1, 3))
	OrdNo 	    = Trim("+" & String(9 - Len(Trim(GRID0.GetGridCell(1, 4))), "0") & Trim(GRID0.GetGridCell(1, 4)))
	lCtrctNo    = Trim(GRID0.GetGridCell(1, 5))
	SeExecNo    = Trim(GRID0.GetGridCell(1, 6))
	AcntNo 	    = Trim(GRID0.GetGridCell(1, 7))
	CnsltPathTp = Trim(GRID0.GetGridCell(1, 8))

	Call send_f(OrdDt, OrdMktCode, MgmtBrnNo, OrdNo, lCtrctNo, SeExecNo, AcntNo, CnsltPathTp)
End Sub

Sub send_f(OrdDt, OrdMktCode, MgmtBrnNo, OrdNo, lCtrctNo, SeExecNo, AcntNo, CnsltPathTp)
	LEDGER.Fkey = "C"

	zIn.Data = "00001"

	zBnsTp.Data = Trim(SCREEN.Object("parent.zPrdtTp").Data)
	zCnfYn.Data = "1"

	zOrdDt.Data = OrdDt
	zOrdMktCode.Data = OrdMktCode
	zMgmtBrnNo.Data = MgmtBrnNo
	zOrdNo.Data = OrdNo
	zlCtrctNo.Data = lCtrctNo
	zSeExecNo.Data = SeExecNo
	zAcntNo.Data = AcntNo
	zCnsltPathTp.Data = CnsltPathTp

	zUserId.Data = Trim(SCREEN.Object("parent.zUserId").Data)

	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(LEDGER.Ecod, 1) = "0" Then
	GRID0.RemoveRow 0

	If GRID0.Rows > 0 Then
		Call send_o()
	Else
		Call alert_msg("등록(변경)이 완료되었습니다.")
		SCREEN.Proc "parent.send_f", ""
	End If
Else
	Call alert_msg(Trim(LEDGER.Emsg))
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
