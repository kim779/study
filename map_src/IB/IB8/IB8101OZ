RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sendCnt
sendCnt = 0

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

lOnesfCnfTrxSeqno.Data = Trim(SCREEN.Object("parent.lOnesfCnfTrxSeqno").data)
zMdaSeqno.Data = Trim(SCREEN.Object("parent.zMdaSeqno").data)
zOtpVrfVal.Data = Trim(SCREEN.Object("parent.zOtpVrfVal").data)
TrdInfo.Data = Trim(SCREEN.Object("parent.TrdInfo").data)

If Trim(lOnesfCnfTrxSeqno.Data) = "" Then
	MsgBox Trim(searchMsg.Text), , "IBK투자증권"
	Exit Sub
End If

If Trim(zOtpVrfVal.Data) = "" Then
	alert_msg("OTP생성번호를 입력하세요")
	zOtpVrfVal.SetFocus
	Exit Sub
End If

sendCnt = sendCnt + 1

If sendCnt > 1 Then
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod),1) = "0" Then
	If Trim(zErrMsgCode.Data) = "0000" Then
		SCREEN.Object("parent.zOtpVrfVal").Clear
		SCREEN.ClearAll 0, 2
		SCREEN.SetTimer 4, False
	Else
		sendCnt = 0

		Dim msg
		msg = Trim(zErrMsgCnts.Data)

		If Trim(zErrMsgCnts.Data) <> "" Then
			If Trim(zErrMsgCode.Data) = "3517" Then
				msg = msg & vbLf & vbLf & "재시도 가능횟수는 "& Trim(lRetryAbleCnt.Data) & "회 남았습니다."
			End If

			alert_msg(msg)
		End If

		If SCREEN.Object("parent.gubndata").data = "8101" Then
			SCREEN.Object("parent.parent.OBJ_otp1").Send
		Else
			SCREEN.Proc "parent.obj_gen.send_f", ""
		End If
	End If
Else
	sendCnt = 0
		If SCREEN.Object("parent.gubndata").data = "8101" Then
			SCREEN.Object("parent.parent.OBJ_otp1").Send
		Else
			SCREEN.Object("main.GUIDE").TRgb = 94
			Call guide_msg(msg)
			SCREEN.Proc "parent.obj_gen.send_f", ""
		End If

	alert_msg(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
sendCnt = 0
If SCREEN.Object("parent.gubndata").data = "8101" Then
	SCREEN.Proc "parent.parent.send", ""
	SCREEN.Proc "parent.parent.OTP_hide", ""
Else
	zOtpVrfVal.Clear
	SCREEN.ClearAll 0, 2
	SCREEN.Proc "parent.parent.obj_snd.send_o", ""
	SCREEN.Object("parent.parent.obj_showCerti").Visible = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(lRetryAbleCnt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCode)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCnts)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



