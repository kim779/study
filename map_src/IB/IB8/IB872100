{


_AW_ONDECLARE_AW_
Dim gridPos
gridPos = 1

'== 첫 조회
Sub send_f()
	'GRID0.Clear
	SCREEN.ClearAll 2, 2
	gridPos = 1

	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
zEmpNo.Data = SYSTEM.UserID

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
GUIDE.Text = ""

If CheckInput_1(zEmpNo, zEmpPwd) = True Then
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
	next_btn.SetFocus
Else
	next_btn.Enable = False
End If

For i = gridPos To GRID0.Rows
	GRID0.SetGridCell i, 13, Trim(GRID0.GetGridCell(i,26))
Next
gridPos = GRID0.Rows + 1

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zEmpPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 And GRID0.Column = 27 Then
	If GRID0.GetGridCell(GRID0.Row,1) <> "" Then
		SCREEN.Object("OBJECT0.an").data = GRID0.GetGridCell(GRID0.Row,1)
		OBJECT0.Visible = True
		OBJECT0.Send
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(COMBO0)
_AW_ONCHANGE_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


