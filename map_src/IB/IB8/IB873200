RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MYFILE = "userconf.ini"
Const MYMAP = "IB873200"

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "zAcmgtCode", zAcmgtCode.Data
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim temp
		temp = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "zAcmgtCode"))
		SCREEN.IgnoreChange True
		If temp <> "" Then
			zAcmgtCode.Data = temp
		End If
		SCREEN.IgnoreChange False
	End If
End Sub

'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub send_Ex()
	If Len(Trim(zEmpNo.Data)) < 6 Then
		GUIDE.Text = "사원번호를 확인하여 주십시오."
		zEmpNo.SetFocus
		Exit Sub
	End If

	If Len(Trim(zEmpPwd.Data)) < 4 Then
		GUIDE.Text = "접속비밀번호를 확인하여 주십시오."
		zEmpPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0015"
zEmpNo.Data = SYSTEM.UserID
Call p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
GUIDE.text = ""
If CheckInput_1(zEmpNo, zEmpPwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
	next_btn.SetFocus
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
SCREEN.OBJect("main.zEmpNo").data = zEmpNo.Data
SCREEN.OBJect("main.zEmpPwd").data = zEmpPwd.Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


