MyWeek = Weekday(cday)
If MyWeek = 1 Then
	cday= DateAdd("d", -2 , cday)
ElseIf MyWeek = 7 Then
	cday= DateAdd("d", -1 , cday)
End If

yy = Year(cday)
mm = Month(cday)
