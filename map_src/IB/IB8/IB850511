RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Function comChkData(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		comChkData = False
		Exit Function
	Else
		comChkData = True
		Exit Function
	End If
End Function

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0013"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
zAcntNo.Data = SCREEN.Object("parent.AN50").data
zPwd.Data = SCREEN.Object("Parent.zPwd").data

If CheckInput(zAcntNo, zPwd) = True Then
	SCREEN.OnSend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If comChkData(ecod) = False Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		If comChkData(dLoanPldgRat.Data) = True Then
			If Trim(dLoanPldgRat.Data) = "0.0000" Then
				dLoanPldgRat.Data = ""
			Else
				dLoanPldgRat.Data = dLoanPldgRat.Data * 100
			End If
		End If

		If comChkData(dTotPldgRat.Data) = True Then
			If Trim(dTotPldgRat.Data) = "0.0000" Then
				dTotPldgRat.Data = ""
			Else
				dTotPldgRat.Data = dTotPldgRat.Data * 100
			End If
		End If
	End If

	Dim ii, jmGubn, availGubn

	For ii = gridPos To GRID0.Rows
		jmGubn = Trim(GRID0.GetGridCell(ii, 3))
		availGubn = Trim(GRID0.GetGridCell(ii, 9))

		GRID0.SetGridCell ii, 4, jmGubn
		GRID0.SetGridCell ii, 10, availGubn
	Next

	gridPos = ii
Else

End If

If Len(Trim(SCREEN.Object("parent.zPwd").Data)) < 4 Then
	SCREEN.Object("parent.zPwd").SetFocus
Else
	SCREEN.Object("parent.aa").SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
'If Trim(SCREEN.Object("main.zPwd").Data) <> "" Then
'	AN50.Data = SCREEN.Object("main.ACNM").Data
'	zPwd.Data = SCREEN.Object("main.zPwd").Data
	Call send_f()

'	SCREEN.Object("main.obj1.aa").Setfocus
'End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
