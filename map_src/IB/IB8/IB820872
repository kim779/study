				data = Mid(data, 2, 11)
				buho = 0
			End If
			If InStr(1,data, "." ,1) <> 0 Then
				d0 = Split(data, ".", -1, 1)
				d1 = d0(0)
				d2 = d0(1)
			Else
				d1 = data
				d2 = 000000
			End If
			i = Len(d1)
			ii =  Len(d2)
			For iii = 1 To 4-i
				d3 = d3 + "0"
			Next
			For iii = 1 To 6-ii
				d4 = d4 + "0"
			Next
			If buho = 1 Then
				SCREEN.Object("EDIT"&i).data = "-"&d3&d1&"."&d2&d4
			Else
				SCREEN.Object("EDIT"&i).data = "+"&d3&d1&"."&d2&d4
			End If
		Else
		    SCREEN.Object("EDIT"&i).data = "+0000.000000"
