Sub addnumeric()
	Dim data,d1,d2,d0,buho,d3,d4, i, ii, iii
	buho = 0
	For i=1 To 5
	    data = Trim(SCREEN.Object("PrtnRat"&i).data)
		If data <> "" Then
			If Left(data,1) = "-" Then
				data = Mid(data, 2, 11)
