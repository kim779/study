RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SYSTEM.Trace "LEDGER.Fkey ==> " & LEDGER.Fkey
	SCREEN.Send 0
End Sub

Sub send_c()
	GRID1.SetDataPosition 2
	LEDGER.Fkey = "7"
	SYSTEM.Trace "LEDGER.Fkey ==> " & LEDGER.Fkey
	SCREEN.Send 0
End Sub


Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)
End Sub

Sub check()
	If CHECK0.Checked = True Then
		S1301.Enable = True
		BUTTON0.Enable = True
	Else
		S1301.Enable = False
		BUTTON0.Enable = False
	End If
End Sub

_AW_ONSTART_AW_
check()
S1301.Data = ""
SCREEN.SetTimer 1, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

SCREEN.OnSend = False

If CHECK0.Checked = False Then
	S1301.Data = ""
	OBJ0.Send
End If
SYSTEM.Trace "1301 data " & S1301.Data
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	GRID1.SetFocus
	next_btn.Enable = True
Else
	GRID1.SetFocus
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If SCREEN.Key = "13" And S1301.Focus = False Then
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

Call send_f()
'SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
If GRID1.HitPos = 3 Then
	Dim data
	data = Trim(GRID1.GetGridCell(GRID1.Row, 1))

	S1301.DATA = data

	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ProductCB)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHECK0)
_AW_ONCLICK_AW_
check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
SYSTEM.Trace "Onchange"

If Trim(S1301.Data) = "" Then
	CHECK0.Checked = False
	S1301.Enable = False
	Exit Sub
End If

If Len(Trim(S1301.Data)) < 6 Then
	Exit Sub
End If
SYSTEM.Trace "999999999999999999999999"

OBJ0.Send

S1301.Trigger "", False
S1301.Trigger "", True

SCREEN.Object("obj0.1301").data = S1301.Data
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



