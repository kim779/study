RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim SendFlag
SendFlag = 0

Dim objset
objset = Array(obj_copt, obj_popt, obj_futu)
Sub make_hsga()
	Dim atmg, item
	item = ""

	For ii=1 To grid.Rows
		atmyn = Trim(grid.GetGridCell(ii, 1))
		ocod = Trim(grid.GetGridCell(ii, 2))
		hang = Trim(grid.GetGridCell(ii, 3))
		If ocod="" Then
			Exit For
		End If
		item = item & ocod & hang
		If ii <> grid.Rows Then
			item = item & vbTab
		End If
		If atmyn = "Y" Then
			item = ocod & vbTab & item
		End If
		'SYSTEM.trace "["&ii&"] ["&item&"]"
	Next

	SCREEN.Object("HSGA").SetItems item
End Sub

Sub ch_hsga()
	For ii=LBound(objset) To UBound(objset)
		objset(ii).Proc "send_f", " "
	Next
End Sub

Sub Set_account()
	ACNM.Data = AN20.name
	ed_pswd.Data = AN20.Password
	SCREEN.Object("main.guide").Text = ""

	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus : Exit Sub
	Else
		OBJ_account.Send
	End If

End Sub

Sub call_jumun(param)
	Dim code, vols, pric
	ArrData = Split(param, "|")
	For i =LBound(ArrData) To UBound(ArrData)
		SubArr = Split(ArrData(i), "~")
		If UBound(SubArr) = 3 Then
			If Left(SubArr(0), 1) = "1" Or Left(SubArr(0), 1) = "A" Then
				odr_futu.Proc "send_odr", ArrData(i)
				'SYSTEM.Trace "cnt="&UBound(SubArr)&" ii=["&i&"] "&ArrData(i)
			ElseIf Left(SubArr(0), 1) = "2" Or Left(SubArr(0), 1) = "B" Then
				odr_copt.Proc "send_odr", ArrData(i)
			ElseIf Left(SubArr(0), 1) = "3" Or Left(SubArr(0), 1) = "C" Then
				odr_popt.Proc "send_odr", ArrData(i)
			End If
		End If
	Next
End Sub

