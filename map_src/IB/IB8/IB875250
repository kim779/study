RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_ComboIndex
g_ComboIndex = "0"
'-------------------------------------------------------------
Sub SetComboIndex(Data)
	g_ComboIndex = Data
End Sub
'-------------------------------------------------------------
Sub SetComboData()
	Data = Trim(ot_nrec.Data)
	If Len(Data) = 0 Then
		Exit Sub
	End If
	Data = ""
	For i = 1 To ot_nrec.Data
		Week = Trim(GRID0.GetGridCell(i, 1))
		Disp = Trim(GRID0.GetGridCell(i, 2))

		If Len(Week) = 0 Then
			Exit For
		ElseIf Len(Week) = 5 Then
			Week = " " & Week
		End If

		If i = 1 Then
			Data = Week
		End If

		Data = Data & vbTab & Week & Disp
	Next

	SCREEN.Proc "Main.SetComboData", Data & "," & g_ComboIndex & "," & ot_nrec.Data
End Sub
'-------------------------------------------------------------
Sub SendData()
	SCREEN.Send 0
End Sub

_AW_ONRECEIVE_AW_
SetComboData
'SCREEN.Proc "Main.SendData" ,"0"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



