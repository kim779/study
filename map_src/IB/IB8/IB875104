RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub comb_list_done()
	Dim grid, item, txt
	Dim jnam, jcod, jgub
	item = ""
	Set grid = SCREEN.Object("OBJ.GRID0")
	For ii=1 To grid.Rows
		jcod = grid.GetGridCell(ii, 1)
		jnam = grid.GetGridCell(ii, 2)
		jgub = grid.GetGridCell(ii, 3)
		If jcod = "" Then
			Exit For
		End If
		txt = jgub & jcod

		item = item & txt & jnam & vbTab
		If ii=1 Then
			item = txt & vbTab & item
		End If
	Next
	SCREEN.Object("cdrt").Data = SCREEN.Object("OBJ.cdkr").Data
	SCREEN.Object("jcom1").SetItems item
	SCREEN.Object("jcom2").SetItems item
End Sub

_AW_ONSTART_AW_
didx.Data = "4"
diid.Data = "875100"

'default값
ed_year.Data = "1"
tryn.Data = "1000"
cd01.Data = "100"
cd02.Data = "95"
cd03.Data = "90"
cdki.Data = "70"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
ed_date.Data = o_date.Data
SCREEN.Proc "main.SetGuide", "1"
out1.Data = ""
out2.Data = ""
out3.Data = ""
out4.Data = ""
'SCREEN.ClearAll 0, 2

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Data = Trim(ot_smsg.Data)
If Len(Data) = 0 Then
	SCREEN.Proc "main.SetGuide", "2"
Else
	SCREEN.Proc "main.SetGuide", Data
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_year)
_AW_ONCHANGE_AW_
Data = ed_year.Data
If Len(Trim(Data)) = 0 Then
	Exit Sub
End If

If Data < "0" Or Data > "9" Then
	Exit Sub
End If

If Data = "0" Then
	ed_year.Data = "1"
End If

If Data > 3 Then
	ed_year.Data = "3"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tryn)
_AW_ONCHANGE_AW_
Data = Trim(tryn.Data)

If Len(Data) = 0 Then
	tryn.Data = 1000
	Exit Sub
End If

Data =CLng(Data)

If Data < 0 Then
	tryn.Data = 1000
End If

If Data > 10000 Then
	tryn.Data = 10000
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(o_date)
_AW_ONCHANGE_AW_
AYear = year(Date)
AMon = Month(Date)
If Len(AMon) = 1 Then
	AMon = "0" & AMon
End If
ADay = Day(Date)
If Len(AMon) = 1 Then
	ADay = "0" & ADay
End If

Today = AYear & AMon & ADay
If Len(Trim(o_date.Data)) = 0 Then
	o_date.Data = Today
	Exit Sub
End If

If CLng(Today) > CLng(o_date.Data) Then
	ot_date.Data = "과거"
ElseIf CLng(Today) = CLng(o_date.Data) Then
	ot_date.Data = "당일"
Else
'	SYSTEM.Trace Today & "|" & o_date.Data
	o_date.Data = Today
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



