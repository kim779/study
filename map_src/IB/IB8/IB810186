RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_o()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub confirm()
	SYSTEM.Push "favorate_register", ""
	SYSTEM.Push "favorate_nick", ""

	Dim Domino
	Domino = "bank" & vbTab & Trim(zBnkName.Data)     & vbLf &_
	         "acct" & vbTab & Trim(zBnkAcntNo.Data)   & vbLf &_
	         "name" & vbTab & Trim(zBnkAcntNm.Data)   & vbLf &_
	         "nick" & vbTab & Trim(zBnkAcntNick.Data) & vbLf

	SCREEN.CreateWindow 2, "IB81018D /p5 /d", Domino

	If Trim(SYSTEM.Pop("favorate_register")) <> "OK" Then
		Exit Sub
	Else
		Dim regNick
		regNick = Trim(SYSTEM.Pop("favorate_nick"))

		If regNick <> "" Then
			zBnkAcntNick.Data = regNick
		End If

		Call send_o()
	End If
End Sub

Function GetToday()
	Dim YY,MM,DD
	YY = Year(Date)
	MM = Month(Date)
	If Len(MM) = 1 Then
		MM = "0" & MM
	End If
	DD = Day(Date)
	If Len(DD) = 1 Then
		DD = "0" & DD
	End If
	GetToday = YY & MM & DD
End Function

_AW_ONINDECLARE_AW_
