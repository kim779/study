_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"
zTP.Data = "2"
zDelDt.Data = GetToday()

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Proc "parent.send_Tr", zClntNo.Data

