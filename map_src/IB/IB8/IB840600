'계좌유상청약내역 조회
Sub Search()
	Dim account, zPwd

	If CheckInput(SCREEN.Object("OBJECT0.AN1A"), SCREEN.Object("OBJECT0.zPwd")) = False Then
		Exit Sub
	Else
		account = SCREEN.Object("OBJECT0.AN1A").data
		zPwd = SCREEN.Object("OBJECT0.zPwd").data
	End If

	Call setAccnt(account, zPwd)
End Sub

