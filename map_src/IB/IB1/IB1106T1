_AW_SCRIPT_AW_(VIEWGRID)
_AW_ONCLICK_AW_
Dim s_code, s_jmga, s_mjsu, s_jmno, s_data, dmsg

If VIEWGRID.HitPos = 3 Then

	If Trim(VIEWGRID.GetGridCell (VIEWGRID.Row, 6)) = "" Then
		Exit Sub
	End If

	s_code = Mid(VIEWGRID.GetGridCell(VIEWGRID.Row, 6),1,6)					'주문코드
	s_jmno = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 4))					'주문번호
	s_jmga = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 11))					'주문가격
	s_mjsu = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 16))					'미체결수량

	dmsg = s_code &"|"& s_jmno &"|"& s_jmga &"|"& s_mjsu &"|"
	SYSTEM.Push "domino_data", dmsg
	If VIEWGRID.Column = 2 Then
		SCREEN.CreateWindow 1, "IB101300 /p5 /s/t", "1301"& vbTab & s_code
	ElseIf VIEWGRID.Column = 3 Then
		SCREEN.CreateWindow 1, "IB101400 /p5 /s/t", "1301"& vbTab & s_code
	Else
		If Len(Trim(VIEWGRID.GetGridCell(VIEWGRID.Index +1, 6))) = 6 Then
			g_cod.DATA = Right(Trim(VIEWGRID.GetGridCell(VIEWGRID.Index +1, 6)),6)
			If Trim(g_cod.DATA) = "" Then
			    Exit Sub
			End If

			If chk_cod.Checked = True Then
				S1301.Data = g_cod.Data
				S1301.Trigger "", False
				S1301.Trigger "", True
				SYSTEM.SetHistory "1301", S1301.DATA
			End If
		End If
	End If
	If chkcnt() = False Then
		BUTTON0.Enable = False
		BUTTON2.Enable = False
	Else
		BUTTON0.Enable = True
		BUTTON2.Enable = True
	End If
End If

