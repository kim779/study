'==계좌번호, 비밀번호 체크
Function CheckInput2(ANCT, zPwd)
 	CheckInput2 = False
	If Trim(ANCT.data) = "" Or Len(Trim(ANCT.data)) <> 11 Then
'		Call alert_msg("계좌번호를 확인하십시오.")
 		ANCT.Setfocus
 		Exit Function
	End If

	If Len(Trim(zPwd.data)) = 0 Then
 		zPwd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zPwd.data)) < 4 Then
'			Call alert_msg("비밀번호를 확인하십시오.")
	 		zPwd.Setfocus
	 		Exit Function
		End If
	End If
	CheckInput2 = True
End Function

