RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim smok_ga, imok_ga, ibo_ga, choi_ga
Dim condition
Dim name, gubn
Dim row, row_t

row = 0
row_t = 0

smok_ga = 0
imok_ga = 0
ibo_ga = 0
choi_ga = 0

Sub Reg_StopLoss()
		If SCREEN.Object("main.chk_smok").Checked = True Then
			smok_ga = CONTROL1.GetPriceSetupValue(Trim(SCREEN.Object("main.j_num").Data), Trim(ed_mae.Data), SCREEN.Object("main.com_smok").Data, 0, SCREEN.Object("main.ed_smok").Data)
		End If

		If SCREEN.Object("main.chk_imok").Checked = True Then
			imok_ga = CONTROL1.GetPriceSetupValue(SCREEN.Object("main.j_num").Data, Trim(ed_mae.Data), SCREEN.Object("main.com_imok").Data, 1, SCREEN.Object("main.ed_imok").Data)
		End If

		If SCREEN.Object("main.chk_ibo").Checked Then
			ibo_ga = CONTROL1.GetPriceSetupValue(SCREEN.Object("main.j_num").Data, ed_mae.Data, SCREEN.Object("main.com_ibo").Data, 2, SCREEN.Object("main.ed_ibo").Data)
			choi_ga = CONTROL1.GetPriceSetupValue(SCREEN.Object("main.j_num").Data, ibo_ga, com_choi.Data, 3, SCREEN.Object("main.ed_choi").Data)
		End If

		condition =  smok_ga & ":" & imok_ga & ":" & ibo_ga & ":" & choi_ga
		CONTROL1.SetCondition ed_gubn.Data, SCREEN.Object("main.j_num").Data, Trim(condition)

		For ii = 1 To row
			name = GRID0.GetGridCell(ii, 1)
			gubn = GRID0.GetGridCell(ii, 13)

			'MsgBox Trim(name) & " " & Trim(j_nam.Data) & "|" & Trim(gubn) & " " & Trim(ed_gubn.Data)

			If Trim(name) = Trim(SCREEN.Object("main.j_nam").Data) And Trim(gubn) = Trim(ed_gubn.Data) Then
				row_t = ii
				'MsgBox row_t
				Exit For
			End If
		Next

		If row_t = 0 Then
			row = row + 1
			row_t = row
		End If

		GRID0.SetGridCell row_t, 1, SCREEN.Object("main.1301").Data
		GRID0.SetGridCell row_t, 2, SCREEN.Object("main.j_nam").Data
		GRID0.SetGridCell row_t, 3, ed_juga.Data
	    GRID0.SetGridCell row_t, 4, ed_mae.Data
'			GRID0.SetGridCell row_t, 4, ed_pson.Data
'			GRID0.SetGridCell row_t, 5, ed_rate.Data
		GRID0.SetGridCell row_t, 11, ed_gubn.Data


		GRID0.SetGridCell row_t, 5, smok_ga
		GRID0.SetGridCell row_t, 6, imok_ga
		If ibo_ga = 0 Then
 			ibo_ga = ""
		End If
			GRID0.SetGridCell row_t, 7, ibo_ga


End Sub

Sub Start_StopLoss()
	CONTROL1.Start(True)
End Sub

Sub Stop_StopLoss()
	CONTROL1.Start(False)
End Sub

_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



