_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	'SCREEN.ClearAll 2, 2
	'ACNM.Data = AN1A.Name
	'zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	'SCREEN.ClearAll 2,2
	'ACNM.Data = AN1A.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
guide_flag = 1		'-- 메세지박스를 띄우지 않고 Guide로 출력여부
SCREEN.Object("main.guide").Text = " "
LEDGER.Rcnt = "0010"

Call Check_LoginType(zPwd)		'직원/고객에 따른 비밀번호 컨트롤 설정

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.Proc "main.Set_guide", " "
SCREEN.OnSend = False
GRID0.Clear
AN1A.Data = SCREEN.Object("main.OBJ_order.AN1A").Data
zPwd.Data = SCREEN.Object("main.OBJ_order.ed_pswd").Data

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
Else
	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If Trim(zPwd.Data) <> "HEAD" And Len(Trim(zPwd.Data)) >= 4 Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If

	    If Trim(zPwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
				SCREEN.Object("main.OBJ_order.ed_pswd").Data = ""
				SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If

If CheckInput(AN1A, zPwd) = False Then
	SCREEN.OnSend = False
 	Exit Sub
End If

SCREEN.onsend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
	'ACNM.Data = AN1A.Name
Else
	Select Case selection.Data
		Case "1"	zPwd.SetFocus()
		Case "2"	send_btn.SetFocus()
		Case "3"	next_btn.SetFocus()
	End Select
End If

SCREEN.Object("main.GUIDE").text = LEDGER.Emsg

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
