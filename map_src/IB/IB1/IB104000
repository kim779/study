_AW_ONTIMER_AW_
Dim ecod
ecod  = Trim(SCREEN.Object("OBJ_order.OBJ_snd.LEDGER").ecod)

If Left(ecod, 1) <> "0" Then
	Exit Sub
End If




If SCREEN.Object("OBJ_order.OBJ_odr.ed_occd").data = "00" Then
	SYSTEM.Trace "일반예약"
	TAB_account.SetTabVisible 2, True
	TAB_account.SetTabVisible 3, True
	TAB_account.SetTabVisible 5, False
	TAB_account.SetTabVisible 6, False
	obj.Visible = False

	If OBJ_account.GetObject <> "IB104022" Then
		TAB_account.ID = "2"


		OBJ_account.SetObject "IB104022"
	End If
	SCREEN.Proc "OBJ_account.send_f", ""
Else
	Set_type("1")
	obj.Send

End If

