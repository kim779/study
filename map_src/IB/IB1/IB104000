RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub all_account()
	OBJ_account.Send
End Sub

Sub send_sise_all(xval)
SCREEN.IgnoreChange True
	S1301.Trigger "", True

	If xval <> "jumun" Then
		Call Ord_ChangeCode(S1301.Data)
	End If
	OBJ_sise.Send
	OBJ_info.Send
SCREEN.IgnoreChange False
End Sub

Sub tab_ordtyp_change()
	Select Case tab_ordtyp.ID
	Case 0
		OBJ_order.SetObject("IB104090")
		Call Set_init()
	Case 1
		OBJ_order.SetObject("IB104091")
		Call Set_init()
	Case 2
		OBJ_order.SetObject("IB104092")
		Call Set_init()
	Case 3
		tab_ordtyp.SetTabVisible 3, True
		tab_ordtyp.SetTabVisible 4, False
		OBJ_order.SetObject("IB104093")

	Case 4
		tab_ordtyp.SetTabVisible 3, False
		tab_ordtyp.SetTabVisible 4, True
		OBJ_order.SetObject("IB104094")
	End Select
End Sub

Sub Set_init()
	If SCREEN.Object("OBJ_order.OBJ_odr.ed_occd").data = "00" Then
		SCREEN.Object("OBJ_order.OBJ_odr.ed_sdat").enable = False
		SCREEN.Object("OBJ_order.OBJ_odr.ed_edat").enable = False
	End If
End Sub

Sub Set_type(val)
	Dim value
	value = val
	SYSTEM.Trace "ste_type start : " & val & value

	If val = "0" Then						'예약주문내역
		TAB_account.Index = 2
		TAB_account.SetTabVisible 2, True
		TAB_account.SetTabVisible 3, True
		TAB_account.SetTabVisible 5, False
		TAB_account.SetTabVisible 6, False
		obj.Visible = False
		OBJ_account.Visible = True
		SCREEN.Object("obj.OBJ_hnam.17413").Visible = False
		OBJ_account.SetObject ("IB104022")
	ElseIf val = "1" Then					'기간예약주문내역
		TAB_account.Index = 5
		TAB_account.SetTabVisible 5, True
		TAB_account.SetTabVisible 2, False
		TAB_account.SetTabVisible 6, True
		TAB_account.SetTabVisible 3, False
		obj.SetObject("IB104032")
		SCREEN.Proc "obj.send_f", ""
		obj.Visible = True
		OBJ_account.Visible = False
		SCREEN.Object("obj.OBJ_hnam.17413").Visible = True
	ElseIf val = "2" Then					'예약주문 처리결과
		TAB_account.Index = 3
		TAB_account.SetTabVisible 2, True
		TAB_account.SetTabVisible 3, True
		TAB_account.SetTabVisible 5, False
		TAB_account.SetTabVisible 6, False
		obj.Visible = False
		OBJ_account.Visible = True
		OBJ_account.SetObject ("IB104023")
		OBJ_account.Proc "send_f", ""
		
	ElseIf val = "3" Then					'기간예약주문 처리결과
		TAB_account.Index = 6
		TAB_account.SetTabVisible 5, True
		TAB_account.SetTabVisible 2, False
		TAB_account.SetTabVisible 6, True
		TAB_account.SetTabVisible 3, False
		obj.SetObject("IB104033")
		obj.Visible = True
		OBJ_account.Visible = False
	End If
	'Call clck_account()
End Sub

Sub clck_account()

'	Dim chk
'
'	If obj.GetObject <> "" Then
'		chk = 1
'	End If

'	If chk = 1 Then
'		obj.Visible = False
'		SCREEN.Object("obj.OBJ_hnam.17413").Visible = False
'		OBJ_account.Visible = True
'	End If


	Select Case TAB_account.ID
	Case 1
		OBJ_account.SetObject ("IB104021")
		obj.Visible = False
		OBJ_account.Visible = True
		If obj.GetObject = "IB104032" Then
			SCREEN.Object("obj.OBJ_hnam.17413").Visible = False
		End If
	Case 2
		OBJ_account.SetObject ("IB104022")
		obj.Visible = False
		OBJ_account.Visible = True
		If obj.GetObject = "IB104032" Then
			SCREEN.Object("obj.OBJ_hnam.17413").Visible = False
		End If
	Case 3
		OBJ_account.SetObject ("IB104023")
		obj.Visible = False
		OBJ_account.Visible = True
		If obj.GetObject = "IB104032" Then
			SCREEN.Object("obj.OBJ_hnam.17413").Visible = False
		End If
	Case 4
		OBJ_account.SetObject ("IB104024")
		obj.Visible = False
		OBJ_account.Visible = True
		If obj.GetObject = "IB104032" Then
			SCREEN.Object("obj.OBJ_hnam.17413").Visible = False
		End If

		SCREEN.Object("OBJ_account.objX").Visible = True
	Case 5
		obj.SetObject("IB104032")
		obj.Visible = True
		OBJ_account.Visible = False
		If OBJ_account.GetObject = "IB104024" Then
			SCREEN.Object("OBJ_account.objX").Visible = False
		End If


	Case 6
		obj.Visible = True
		OBJ_account.Visible = False
		obj.SetObject("IB104033")
		If OBJ_account.GetObject = "IB104024" Then
			SCREEN.Object("OBJ_account.objX").Visible = False
		End If
	Case Else
		Exit Sub
	End Select
End Sub

