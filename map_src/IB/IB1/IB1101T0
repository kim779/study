_AW_SCRIPT_AW_(VIEWGRID)
_AW_ONCLICK_AW_
	Dim s_code, s_jmga, s_mjsu, s_jmno, s_data, dmsg, gcnt, s_mkgb

Select Case VIEWGRID.HitPos
Case 3	' 데이터부
	If Trim(VIEWGRID.GetGridCell (VIEWGRID.Row, 8)) = "" Then	' 종목번호
		Exit Sub
	End If

	Select Case VIEWGRID.Column
	Case 2	' 체크박스
		gcnt = 0
		For ii = 1 To VIEWGRID.Rows
			If Trim(VIEWGRID.GetGridCell(ii, 2)) = 1 Then
				gcnt = gcnt + 1
			End If
		Next

		If gcnt > 9 Then
			MsgBox "일괄 주문은 최대 9건 까지만 가능합니다"
			Call VIEWGRID.SetGridCell(VIEWGRID.Row, 2, "0")
		End If

		If chkcnt() = False Then
			BUTTON0.Enable = False
			BUTTON2.Enable = False
		Else
			BUTTON0.Enable = True
			BUTTON2.Enable = True
		End If

	Case 3	' 정정
		s_code = Mid(VIEWGRID.GetGridCell(VIEWGRID.Row, 8),1,6)					'종목코드
		s_jmno = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 5))					'주문번호
		s_jmga = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 16))					'주문가격
		s_mjsu = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 21))					'미체결수량
		s_mkgb = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 7))					'시장구분

		dmsg = s_code &"|"& s_jmno &"|"& s_jmga &"|"& s_mjsu &"|"& s_mkgb &"|"

		SYSTEM.Push "domino_data", dmsg
		SCREEN.CreateWindow 1, "IB101300 /p5 /s/t/d", "" '"1301"& vbTab & s_code

	Case 4	' 취소
		s_code = Mid(VIEWGRID.GetGridCell(VIEWGRID.Row, 8),1,6)					'종목코드
		s_jmno = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 5))					'주문번호
		s_jmga = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 16))					'주문가격
		s_mjsu = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 21))					'미체결수량
		s_mkgb = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 7))					'시장구분

		dmsg = s_code &"|"& s_jmno &"|"& s_jmga &"|"& s_mjsu &"|"& s_mkgb &"|"

		SYSTEM.Push "domino_data", dmsg
		SCREEN.CreateWindow 1, "IB101300 /p5 /s/t/d", "" '"1301"& vbTab & s_code

	Case Else	' 종목 연동
		Dim codx
		codx = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 8))	  	'종목코드

		If SCREEN.GetCodeType(codx) = "7" Then
			MsgBox "[6801]신주인수권주문 화면을 이용해 주십시오.",, "IBK투자증권"
			Exit Sub
		End If

		If Len(Trim(codx)) <> 6 Then
			If SCREEN.GetCodeType(codx) <> 9 Then
				Exit Sub
			End If
		End If

		Dim jqty, jprc, ogno, otype, jmgb, mkgb, stov

		ogno  = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 5)) 	'주문번호
		mkgb  = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 7))		'시장구분
		jqty  = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 17)) 	'주문수량
		jprc  = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 13)) 	'주문가격

		otype =  Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 12))	'주문유형
		jmgb  = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 10)) 	'주문구분

		stov  = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 23))

		' 시장구분자 변경
		Call Spread_mkgb(codx, mkgb)
		SYSTEM.Trigger "edMarketTrigger", cxMarket.sMarket, ""
		SCREEN.IgnoreChange False

		Dim param

		Select Case Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 12))
			Case "지정가" 			 : jmgb = "00"
			Case "시장가" 			 : jmgb = "03"
			Case "조건부지정가" 	 : jmgb = "05"
			Case "최유리지정가" 	 : jmgb = "06"
			Case "최우선지정가" 	 : jmgb = "07"
			Case "지정가(IOC)" 		 : jmgb = "10"
			Case "시장가(IOC)" 		 : jmgb = "13"
			Case "최유리지정가(IOC)" : jmgb = "16"
			Case "지정가(FOK)" 		 : jmgb = "20"
			Case "시장가(FOK)" 		 : jmgb = "23"
			Case "최유리지정가(FOK)" : jmgb = "26"
			Case "경매매"            : jmgb = "65"
			Case "스톱지정가"        : jmgb = "01"
			Case "중간가"        	 : jmgb = "02"
			Case "중간가(FOK)"       : jmgb = "22"
			Case "중간가(IOC)"       : jmgb = "12"
		End Select

		'arr(0) - 화면구분, arr(1) - 계좌, arr(2) - 계좌명, arr(3) - 신용구분, arr(4) - 신용코드, arr(5) - 잔고, arr(6) - 신용일자
		param = "미체결" & "|" & Trim(AN1A.Data) & "|" & Trim(ACNM.Data) & "|" & ogno & "|" & jmgb & "|" & Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 19))
		SYSTEM.Push "jngo_1000", param

		SCREEN.SetTimerX 1, 3, False

	End Select


Case 4	' 컬럼 헤더부
	Dim i, col, ii, c_col
	For i = LBound(g_ArrData) To UBound(g_ArrData)
		If Trim(VIEWGRID.GetHeadCell( VIEWGRID.Column )) = g_ArrData(i)(2) Then

			If Trim(g_ArrData(i)(2)) = "07" Then
				Call run_standard()
			ElseIf Trim(g_ArrData(i)(2)) = "99" Then
				Exit Sub
			Else
				VIEWGRID.SetHead VIEWGRID.Column, g_ArrData(i)(0)
				col = Int(g_ArrData(i)(3))
				c_col = VIEWGRID.Column
				For ii=1 To VIEWGRID.Rows
					VIEWGRID.SetGridCell ii, c_col, Trim(VIEWGRID.GetGridCell(ii, col))
				Next
			End If
			Exit For
		End If
	Next

	Call Setitems()

	p_write_ini
End Select


