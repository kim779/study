Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB110100", "version", "1"
		Dim ArrCols, i
		ArrCols = Array("", "", "")

		For i = LBound(ArrCols) To UBound(ArrCols)
			Dim tmpCol
			tmpCol = "col" & Trim(i + 13)

			INFO.PushData LOGIN.Name, "userconf.ini", "IB110100", tmpCol, VIEWGRID.GetHead(i + 13)
		Next
	End If
End Sub
'-----------------------------------------------------------------------
Sub p_read_ini()
	Dim ArrCols, i, HeadData, chk
	chk = 0
	If SCREEN.CreateObject("INFO") = True Then
		version = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB110100", "version"))
		If version <> "" Then
			ArrCols = Array("", "", "")

			For i = LBound(ArrCols) To UBound(ArrCols)
				Dim tmpCol
				tmpCol = "col" & Trim(i + 13)

				If Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB110100", tmpCol)) <> "" Then
					ArrCols(i) = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB110100", tmpCol))
				Else
					chk = 1
				End If
			Next
		Else
			chk = 1
		End If

		If chk = 0 Then
			For i = LBound(ArrCols) To UBound(ArrCols)
				VIEWGRID.SetHead i + 13, ArrCols(i)
			Next
		Else
			Call Set_standard()
		End If
	End If
End Sub
