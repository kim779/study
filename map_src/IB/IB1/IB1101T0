Function s_chk_elw_price(mkgb2, code, rgrid, ii)
	Dim	cprice, jprice, prc_a, prc_b
	Dim	sdata, rcv_curr, dmsg
	s_chk_elw_price = True
	If mkgb2 <> "1" Then
		Exit Function
	End If

	Select Case Mid(code, 2, 1)
	Case "5", "6", "7", "8"			'ELW종목
		sdata = "1301" & Chr(127) & Mid(code, 2) & vbTab & "2023" & vbTab
		rcv_curr = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
		cprice = Abs(Int(rcv_curr))
		jprice = Int(rgrid.GetGridCell(ii, 15))
		'호가한도가격설정기준(현재가) 500원 미만일 경우
		'상한은 MAX(상한값, 500원), 하한은 적용 배제
		prc_a = (Int(cprice) *0.5)
		prc_b = (Int(cprice) * 2)
		If cprice < 500 Then
			prc_a = 0
			If prc_b < 500 Then prc_b = 500
		End If

		If jprice < prc_a Or jprice > prc_b Then
			dmsg = vbLf & code & " [" & RTrim(rgrid.GetGridCell(ii, 6)) & "]" & vbLf
			If jprice > prc_b Then
				dmsg = dmsg & vbLf & "고객님의 주문가격은 현재가격과 비교하여 현저히 높습니다.   "
			ElseIf jprice < prc_a Then
				dmsg = dmsg & vbLf & "고객님의 주문가격은 현재가격과 비교하여 현저히 낮습니다.   "
			End If
			dmsg = dmsg & vbLf & Space(58) & "~~~~~~~~~~" & _
					vbLf & "착오주문여부를 한 번 더 확인하시기 바랍니다." & _
					vbLf & vbLf & vbLf & "주문을 전송하시겠습니까?"
			If MsgBox(dmsg, vbYesNo + vbInformation, "ELW종목 주문착오방지") = 7 Then
				s_chk_elw_price = False
			End If
		End If
	End Select
End Function

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)

	Dim gcnt, mflag
	gcnt = 0
	mflag = 0

	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 8)) = "" Then
			Exit Sub
		End If

		VIEWGRID.SetGridCell ii, 2, Flag

		If Trim(VIEWGRID.GetGridCell (ii,  2)) = "1" Then
			gcnt = gcnt + 1
		End If

		If Flag = 1 And gcnt > 9 Then '일괄주문은 9건까지만 가능
			Call VIEWGRID.SetGridCell(ii, 2, "0")
			mflag = 1
		End If

	Next

	If Flag = 1 And mflag = 1 Then
		MsgBox "일괄 주문은 최대 9건 까지만 가능합니다"
	End If
End Sub

