Sub CalcMinQty(price)
	Dim minQty
	Dim rmValue
	Dim tmp

	'price = SCREEN.Object("main.OBJ_sise.2023").Data
	ed_jprc2.Data = SCREEN.Object("main.OBJ_stand.1336").Data

	If price = Null Or IsNumeric(price) = False Then
		Exit Sub
	End If

	If SCREEN.GetCodeType(S1301.Data) = 1 Then
		minQty = 500000000 / CLng(price)'OrdCfg.Price
		rmValue = 500000000 Mod price'OrdCfg.Price

		If rmValue > 0 Then
			minQty = CLng(minQty) + 1
		End If

		tmp = minQty Mod 100

		If tmp < 100 Then
			tmp = 100 - tmp

			minQty = minQty + tmp
		End If

		editMinQty.Data = CLng(minQty)
	ElseIf SCREEN.GetCodeType(S1301.Data) = 2 Then
		minQty = 200000000 / CLng(price)'OrdCfg.Price
		rmValue = 200000000 Mod CLng(price)'OrdCfg.Price

		If rmValue > 0 Then
			minQty = CLng(minQty) + 1
		End If

		editMinQty.Data = CLng(minQty)
	End If
End Sub

