_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "WithFee"

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	GUIDE.Text = ""

	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password

	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	SCREEN.Proc "obj.send_f", ""
	editSearch.Data = "1"
End Sub


Sub send_f()
	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			obj.ClearAll 2
			next_btn.Enable = False
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 입력하세요."
			Exit Sub
		End If
	End If

	If Trim(zOrdDt.Data) = Trim(tday.Data) Then
		obj.SetObject("IB130110")
	Else
		obj.SetObject("IB130120")
	End If

	SCREEN.Proc "obj.send_f", ""
	editSearch.Data = "1"
End Sub


Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, myFILE, myMAP, "Stock", CHECK0.Checked	'매매비용 포함 구분

		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "130100_COM1", zQryTp.data	'조회구분
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "130100_COM2", COMBO0.data	'일자구분
	End If
End Sub


Sub p_read_ini()
	'매매비용 포함여부
	Dim stock_fee

	If SCREEN.CreateObject("Info") Then
		stock_fee = INFO.PopData(LOGIN.Name, myFILE, myMAP, "Stock")

		If Trim(stock_fee) = "" Then
			stock_fee = False
		End If

		CHECK0.Checked = stock_fee

		If CHECK0.Checked = False Then
			zCmsnAmtAppTp.Data = 0
		Else
	  	 	zCmsnAmtAppTp.Data = 1
		End If

		zQryTp.data = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "130100_COM1"))
'		COMBO0.data = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "130100_COM2"))
'
