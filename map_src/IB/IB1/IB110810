_AW_ONDECLARE_AW_
Sub Send_F()
	SCREEN.ClearAll 2,2
	Call startinit()
	LEDGER.Fkey = "C"
'	SCREEN.Send 0
	SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg
End Sub

Sub startinit
	INA.Data = "00001"
	HtsId.Data = SYSTEM.UserID
	SvcKindCode.Data = "3123"
End Sub

_AW_ONSEND_AW_
Call Send_F()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim i,items,item,name
items = ""
If Trim(GRID0.GetGridCell (1,1)) <> "" Then
	For i = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell (i,3)) <> "" And  Mid(Trim(GRID0.GetGridCell (i,3)),4,2) = "10" Then
			name = Mid(GRID0.GetGridCell(i, 3),1,3)&"-"&Mid(GRID0.GetGridCell(i, 3),4,2)&"-"&Mid(GRID0.GetGridCell(i, 3),6,6)&"        | "&GRID0.GetGridCell(i, 5)
			item = GRID0.GetGridCell(i, 3)&name
			items = items & vbTab & item
		End If
	Next
	SCREEN.Proc "main.Setcombo",items
Else
	MsgBox "[약정된 미징수계좌가 없는 ID입니다]",0,"IBK투자증권"
End If

