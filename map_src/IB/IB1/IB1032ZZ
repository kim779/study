Sub OnAlert()
	Dim tmp, shogb

	If SCREEN.Object("main.tab_ordtyp").ID = "0" Then
		If SCREEN.Object("main.OBJ_order.tab_order").ID = "1" Or SCREEN.Object("main.OBJ_order.tab_order").ID = "2" Then
			tmp = "Y"
		Else
			Exit Sub
		End If
	End If
	If tmp = "Y" Then
		shogb = SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").data
		'If shogb = "05" Or Right(shogb,1) = "0" Then
		If shogb = "05" Or Right(shogb,1) = "0" Or shogb = "01" Then

			If SCREEN.Object("main.OBJ_order.OBJ_odr.CHK_auto").Checked = True And SCREEN.Object("main.OBJ_order.OBJ_odr.c_hogb").Checked = False Then
				If SCREEN.Object("main.OBJ_order.OBJ_odr.flash_fg").Data = 0 Then
					Select Case SCREEN.Object("main.OBJ_order.OBJ_odr.cboPrice").Data
					Case "2025" : SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jprc").Data = S2025.Data
					Case "2023" : SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jprc").Data = S2023.Data
					Case "2026" : SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jprc").Data = S2026.Data
					Case "2302" : SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jprc").Data = S2302.Data
					Case "2303" : SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jprc").Data = S2303.Data
					End Select
					SCREEN.Proc "main.OBJ_order.OBJ_odr.OBJ_JUNGSAN.CalcJungsan", ""
				End If
			End If
		End If
	End If

	tmp = "N"
End Sub

