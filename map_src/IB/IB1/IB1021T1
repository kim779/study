_AW_ONDECLARE_AW_
Dim xxxx_flag
xxxx_flag = 1

Sub order_tab_change()
	Select Case tab_order.ID
	Case "1"
		OBJ_odr.SetObject("IB1021T2")
	Case "3"
		OBJ_odr.SetObject("IB1021T3")
	Case "4"
		OBJ_odr.SetObject("IB1021T4")
	End Select
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password

	If Trim(SYSTEM.Pop("1000trPSWD")) <> "" And Trim(AN1A.Data) = Trim(SYSTEM.Pop("1000trACC")) Then
		ed_pswd.Data = Trim(SYSTEM.Pop("1000trPSWD"))
		SYSTEM.Push "1000trPSWD", ""
		SYSTEM.Push "1000trACC", ""
	End If

	SCREEN.Proc "main.Set_account", "jumn"
	SCREEN.Object("obj_odr.o_jmno").Clear
	SCREEN.Object("main.guide").Text = " "

	If xxxx_flag = 1 Then
		SCREEN.Proc "main.chk_xxxx", ""		'비밀번호 체크
		xxxx_flag = 0
	End If
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus : Exit Sub
	End If
End Sub

'=== 가격자동 체크박스 체크값 기억/설정 ===
Dim auto_flag(3)
auto_flag(0) = False : auto_flag(1) = False : auto_flag(2) = False
Sub Set_Auto(mmgb)
	If (mmgb < "1") Or (mmgb > "3") Then Exit Sub
	SCREEN.Object("obj_odr.chk_auto").Checked = auto_flag(mmgb-1)
	SCREEN.Object("obj_odr.cboPrice").Enable = auto_flag(mmgb-1)
End Sub
Sub Get_Auto(mmgb, c_auto)
	If (mmgb < "1") Or (mmgb > "3") Then Exit Sub
	auto_flag(mmgb-1) = c_auto
End Sub

_AW_ONSTART_AW_
SCREEN.SetTimer 2, False

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
'주식주문2(IB100200)에서 주문타입변경시 계좌비밀번호 유지
If SCREEN.GetMapName(1) = "IB100200" Then
	SCREEN.Object("main.xxxx").Text = ed_pswd.Data
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(tab_order)
_AW_ONCLICK_AW_
Call order_tab_change()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()
ed_pswd.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_pswd)
_AW_ONKEYCHANGE_AW_
If Trim(ed_pswd.Data) = "" Then
