End If

If SCREEN.Key = 13 And Trim(ed_pswd.Data) <> "" Then
	SCREEN.Proc "main.OnSave_ToDLL", "False, PSWD, " & Trim(AN1A.Data) & "-" & Trim(ed_pswd.Data)
	SCREEN.Proc "main.OnStartInterest", "Y"
	OBJ_odr.Proc "MoveTabFocus", 1

End If
