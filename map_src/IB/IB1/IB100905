	SCREEN.Object("parent.ed_pswd").Setfocus
	MsgBox "비밀번호를 확인하세요", , "IBK투자증권"
	Exit Sub
End If

SYSTEM.Push "S_code", ""
SYSTEM.Push "S_jqty", ""
SYSTEM.Push "S_jprc", ""
SYSTEM.Push "S_ogno", ""

SCREEN.CreateWindow 2, "IB100191 /p? /d", "AN1A" & vbTab & acno & vbLf & _
											"pswd" & vbTab & ed_pswd.Data & vbLf

o_jmno.Clear
code = Trim(SYSTEM.Pop("S_code"))
If code <> "" Then
	S1301.Data = code
	Call changecode()
	SCREEN.Proc "main.send_sise_all", "jumun"
End If

ogno = Trim(SYSTEM.Pop("S_ogno"))
If ogno <> "" Then ed_ogno.Data = ogno

If r_mdgb1.Checked = True Then
	jqty = Trim(SYSTEM.Pop("S_jqty"))
	If jqty <> "" Then ed_jqty.Data = jqty
Else
	ed_jqty.Data = 0
End If

