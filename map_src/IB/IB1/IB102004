		Else
			If szCrdt = "03" Then
				RADIO1.Checked = True
				cmb_ordtype.Enable = True
				cmb_ordtype.Index = 1

			ElseIf szCrdt = "01" Then
				RADIO1.Checked = True
				cmb_ordtype.Enable = True
				cmb_ordtype.Index = 0

			ElseIf szCrdt = "80" Then
				MsgBox "예탁담보대출 잔고는" & vbCrLf &"신규잔고편입매도 감시조건 설정이 불가합니다.", , "IBK투자증권"
				RADIO0.Checked = True
				cmb_ordtype.Enable = False
			End If
		End If
	ElseIf szVal = "ITEMCHANGE" Then
		'화면 종목 변경으로 들어온 정보 처리
		'종목코드
		E_shrt_cd.Data = e_jcode.Data
		Set_EDIT_mkgb(Trim (e_jcode.Data))
		'종목명
		LB_NAME.Data = e_jname.Data
		'잔고신용구분  00:현금 03:자기융자 01:유통융자 80:대출
		RADIO0.Checked = True
		cmb_ordtype.Enable = False
		Call InitCondCtrls("ALL")
	End If

End Sub



'***************************************************************************
' DESEC: 시장구분 Setting
'1:거래소 2:코스닥 3:프리보드 4:장외
'***************************************************************************
Function Set_EDIT_mkgb(code)
	Dim retn
	Set_EDIT_mkgb = True
	edt_cond_1.SetType 0
	edt_cond_2.SetType 0
	edt_cond_3_1.SetType 0
	edt_cond_3_2.SetType 0
	retn = SCREEN.GetCodeType(code)
	Select Case retn
		Case 1
			'거래소
			edt_cond_1.SetType 100
			edt_cond_2.SetType 100
			edt_cond_3_1.SetType 100
			edt_cond_3_2.SetType 100
		Case 2
			'코스닥
			edt_cond_1.SetType 200
			edt_cond_2.SetType 200
			edt_cond_3_1.SetType 200
			edt_cond_3_2.SetType 200
		Case 3
			'프리보드
		Case 4, 5, 7
			'장외
		Case 6, 27
			'ETF
			edt_cond_1.SetType 240
			edt_cond_2.SetType 240
			edt_cond_3_1.SetType 240
			edt_cond_3_2.SetType 240
		Case 9
			'ELW
			edt_cond_1.SetType 250
			edt_cond_2.SetType 250
			edt_cond_3_1.SetType 250
			edt_cond_3_2.SetType 250
		Case Else
			Set_EDIT_mkgb = False
	End Select
End Function

'***************************************************************************
Function Get_Edt_Type()
	Get_Edt_Type = 0
	retn = SCREEN.GetCodeType(Trim(E_shrt_cd.Data))
	Select Case retn
		Case 1
			'거래소
			Get_Edt_Type = 100
		Case 2
			'코스닥
			Get_Edt_Type = 200
		Case 3
			'프리보드
		Case 4, 5, 7
			'장외
		Case 6, 27
			'ETF
			Get_Edt_Type = 240
		Case 9
			'ELW
			Get_Edt_Type = 250
		Case Else
			Get_Edt_Type = 0
	End Select

End Function

