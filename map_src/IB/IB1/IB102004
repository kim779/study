'/* 주문수량설정구분/* 1:잔고대비율 2:주 3금액*/
If szData = "1" Then
	RADIO6.Checked = True
	cmb_qtyper.Enable = True
	If szTemp = "100" Then
		cmb_qtyper.Index = 0
	ElseIf szTemp = "90" Then
		cmb_qtyper.Index = 1
	ElseIf szTemp = "80" Then
		cmb_qtyper.Index = 2
	ElseIf szTemp = "70" Then
		cmb_qtyper.Index = 3
	ElseIf szTemp = "60" Then
		cmb_qtyper.Index = 4
	ElseIf szTemp = "50" Then
		cmb_qtyper.Index = 5
	End If
End If

'주문가격=====================================================
If RADIO4.Checked = False Then	'시장가 아닐때만 유효함
	'/* 주문가격설정구분 /* 1:TICK 2:지정가 3:상한가 4:하한가*/*/
	szData = Trim(SCREEN.Object("obj_cond.o_ordr_prc_est_clsf").data)
	If szData = "1" Then
		RADIO8.Checked = True
		cmb_prc.Enable = True
		szData = Trim(SCREEN.Object("obj_cond.o_ordr_prc_est_vl").data)
		If szData = "5" Then
			cmb_prc.Index = 1
		ElseIf szData = "4" Then
			cmb_prc.Index = 2
		ElseIf szData = "3" Then
			cmb_prc.Index = 3
		ElseIf szData = "2" Then
			cmb_prc.Index = 4
		ElseIf szData = "1" Then
			cmb_prc.Index = 5
		ElseIf szData = "0" Then
			cmb_prc.Index = 6
		ElseIf szData = "-1" Then
			cmb_prc.Index = 7
		ElseIf szData = "-2" Then
			cmb_prc.Index = 8
		ElseIf szData = "-3" Then
			cmb_prc.Index = 9
		ElseIf szData = "-4" Then
			cmb_prc.Index = 10
		ElseIf szData = "-5" Then
			cmb_prc.Index = 11
		End If
	ElseIf szData = "3" Then
		RADIO8.Checked = True
		cmb_prc.Enable = True
		cmb_prc.Index = 0
	ElseIf szData = "4" Then
		RADIO8.Checked = True
		cmb_prc.Enable = True
		cmb_prc.Index = 12
