'========================================================
'편입조건 단건조회
'=======================================================
Sub LoadCond()
obj_cond.Clearall 0
SCREEN.Object("obj_cond.e_acnt_no").data = Trim(SCREEN.Object("main.AN5A").Data)
SCREEN.Object("obj_cond.e_sq").data = E_sq.Data
obj_cond.Send

End Sub

'========================================================
'주문유형에 따른 주문가격컨트롤 활성/비활성화
'=======================================================
Sub SetOrdPrcCtrlByOrdType()
	Dim bEnablePrc
	bEnablePrc = True
	If RADIO4.Checked = True Then
		'시장가
		bEnablePrc = False
	ElseIf RADIO5.Checked = True Then
		If cmb_hoga.Index = 1 Then
			'최유리 지정가
			bEnablePrc = False
		ElseIf cmb_hoga.Index = 2 Then
			'최우선 지정가
			bEnablePrc = False
		End If
	End If

	If bEnablePrc = True Then
		RADIO8.Enable = True
		If RADIO8.Checked = True Then
			cmb_prc.Enable = True
		End If
	Else
		InitCondCtrls("ORD_PRC")
		cmb_prc.Enable = False
		RADIO8.Enable = False
	End If

End Sub


'========================================================
'편입 조건 단건조회데이터 파싱
'=======================================================
Sub SetCondData()

Dim szData
'주문구분=====================================================
szData = Trim(SCREEN.Object("obj_cond.o_crdt_typ_cd").data)
If szData = "00" Then
	RADIO0.Checked = True
	cmb_ordtype.Enable = False
Else
	If szData = "03" Then
		RADIO1.Checked = True
		cmb_ordtype.Enable = True
		cmb_ordtype.Index = 1

	ElseIf szData = "01" Then
		RADIO1.Checked = True
		cmb_ordtype.Enable = True
		cmb_ordtype.Index = 0
	ElseIf szData = "80" Then
		MsgBox "신규편입 대출 없음"
	End If

End If


'손실제한====================================================
szData = Trim(SCREEN.Object("obj_cond.o_cndt_rstn_est_f1").data)
If szData = "1" Then
	chk_cond_1.Checked = True
	cmb_cond_1.Enable = True
	edt_cond_1.Enable = True
'01:현재가 02:매도1호가 03:매수1호가 04:전일종가 05:당일시가 06:거래량 07:순간매도체결량 08:순간매수체결량
'10:이익(평가손익) 11:주당이익
'12: 손실(쳥가손익) 13: 주당손실
	szData = Trim(SCREEN.Object("obj_cond.o_cndt_est_prc_clsf1").data)
	If szData = "13" Then
		'주당손실
		cmb_cond_1.Index = 0
		LABEL5.Data = "원 이상"
	ElseIf szData = "12" Then
		'손실율
		cmb_cond_1.Index = 1
		LABEL5.Data = "% 이상"
		'1씩 증가하는 %/틱 전용 타입
		edt_cond_1.SetType 99
	End If
	szData = Trim(SCREEN.Object("obj_cond.o_cndt_rstn_est_vl1").data)
	edt_cond_1.Data = szData
End If

'이익실현=====================================================
szData = Trim(SCREEN.Object("obj_cond.o_cndt_rstn_est_f2").data)
If szData = "1" Then
	chk_cond_2.Checked = True
	cmb_cond_2.Enable = True
	edt_cond_2.Enable = True
'01:현재가 02:매도1호가 03:매수1호가 04:전일종가 05:당일시가 06:거래량 07:순간매도체결량 08:순간매수체결량
'10:이익(평가손익) 11:주당이익
'12: 손실(쳥가손익) 13: 주당손실
	szData = Trim(SCREEN.Object("obj_cond.o_cndt_est_prc_clsf2").data)
	If szData = "11" Then
		'주당이익
		cmb_cond_2.Index = 0
		LABEL6.Data = "원 이상"
	ElseIf szData = "10" Then
		'이익율
		cmb_cond_2.Index = 1
		LABEL6.Data = "% 이상"
		'1씩 증가하는 %/틱 전용 타입
		edt_cond_2.SetType 99
	End If
	szData = Trim(SCREEN.Object("obj_cond.o_cndt_rstn_est_vl2").data)
	edt_cond_2.Data = szData
End If

'TS=====================================================
szData = Trim(SCREEN.Object("obj_cond.o_t_s_prft_rstn_est_f").data)
If szData = "1" Then
	chk_cond_3.Checked = True
	cmb_cond_3_1.Enable = True
	cmb_cond_3_2.Enable = True
 	edt_cond_3_1.Enable = True
 	edt_cond_3_2.Enable = True


 	'TS고점 구분값  *//* 01:현재가 10:이익 11:주당이익 */
 	szData = Trim(SCREEN.Object("obj_cond.o_t_s_prft_rstn_est_prc_clsf").data)
 	If szData = "10" Then
 		cmb_cond_3_1.Index = 1
 		LABEL7.Data = "% 이상"
 		'1씩 증가하는 %/틱 전용 타입
		edt_cond_3_1.SetType 99
 	ElseIf szData = "11" Then
 		cmb_cond_3_1.Index = 0
 		LABEL7.Data = "원 이상"
 	End If

 	'TS 고점 설정값
 	szData = Trim(SCREEN.Object("obj_cond.o_t_s_prft_rstn_est_vl").data)
 	edt_cond_3_1.Data = szData

 	'고점 대비 설정값
 	szData = Trim(SCREEN.Object("obj_cond.o_t_s_hgh_mrk_cmpr_est_vl").data)
 	edt_cond_3_2.Data = szData

 	'고점대비설정단위 /* 1:가격 2:율 3:Tick */
 	szData = Trim(SCREEN.Object("obj_cond.o_t_s_hgh_mrk_cmpr_est_unt").data)
 	If szData = "1" Then
 		cmb_cond_3_2.Index = 0
 	ElseIf szData = "2" Then
 		cmb_cond_3_2.Index = 2
 		'1씩 증가하는 %/틱 전용 타입
		edt_cond_3_2.SetType 99
 	ElseIf szData = "3" Then
 		cmb_cond_3_2.Index = 1
 		'1씩 증가하는 %/틱 전용 타입
		edt_cond_3_2.SetType 99
 	End If
End If

'호가분할=====================================================
szData = Trim(SCREEN.Object("obj_cond.o_askprc_prtn_ordr_f").data)
If szData = "1" Then
	chk_cond_4.Checked = True
	cmb_cond_4.Enable = True
	szData = Trim(SCREEN.Object("obj_cond.o_prtn_ordr_tno").data)
	cmb_cond_4.Index = CInt(szData) - 1
End If

'호가구분=====================================================
szData = Trim(SCREEN.Object("obj_cond.o_ordr_typ_cd").data)
cmb_hoga.Enable = False
If szData = "00" Then
	'지정가
	RADIO3.Checked = True
ElseIf szData = "03" Then
	'시장가
	RADIO4.Checked = True
ElseIf szData = "05" Then
	'조건부 지정가
	RADIO5.Checked = True
	cmb_hoga.Enable = True
	cmb_hoga.Index = 0
ElseIf szData = "06" Then
	'최유리 지정가
	RADIO5.Checked = True
	cmb_hoga.Enable = True
	cmb_hoga.Index = 1
ElseIf szData = "07" Then
	'최우선 지정가
	RADIO5.Checked = True
	cmb_hoga.Enable = True
	cmb_hoga.Index = 2
End If
'주문수량=====================================================
szData = Trim(SCREEN.Object("obj_cond.o_ordr_q_est_clsf").data)
