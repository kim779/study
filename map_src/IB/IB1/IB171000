_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account1()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN99.Name
	zPwd.Data = AN99.Password
	If Trim(AN99.Data) = "" Then
		AN99.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	'Call send_f()
End Sub

'== 계좌명, 비밀번호 설정
Sub Set_account2()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN98.Name
	zPwd.Data = AN98.Password
	If Trim(AN98.Data) = "" Then
		AN98.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	'Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"

	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)


sect.Data = "1"

AN98.Visible = False
AN99.visible = True

If Trim(AN98.data) = "" Then

	ACNM.data = ""
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

If sect.data = "1" Then
	If SYSTEM.ConnectBy = 1 Then
		If CheckInput(AN99, zPwd) = True Then
			mobj.Send
			'Exit Sub
		End If
	Else
		zPwd.Data = "9999"
		mobj.Send
	End If
ElseIf sect.data = "2" Then
	If SYSTEM.ConnectBy = 1 Then
		If CheckInput(AN98, zPwd) = True Then
			mobj.Send
			'Exit Sub
		End If
	Else
		zPwd.Data = "9999"
		mobj.Send

	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN99)
_AW_ONCHANGE_AW_
Set_account1()
_AW_ONENDSUB_AW_
