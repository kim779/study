'AN99 : 종합계좌
'AN98 : 개별계좌

Select Case tab.ID
Case 1
		 AN98.Visible = False
		 AN99.visible = True
		 sect.Data = "1"
		 mobj.SetObject "IB171010"
		 GUIDE.Text = ""
Case 2
		 AN98.Visible = True
		 AN99.visible = False
		 sect.Data = "2"
		 mobj.SetObject "IB171020"
		 GUIDE.Text = ""
Case Else
         Exit Sub
End Select

SCREEN.Send 0
