'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN10.Name
	h_acnm.Data = AN10.Name
	zPwd.Data = AN10.Password
	SCREEN.Object("GUIDE.GUIDE").Text = ""

	If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy <> "1" Then '고객
		zPwd.Data = "9999"
	End If

	If Trim(AN10.Data) = "" Then
		AN10.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	If Trim( SCREEN.Object("obj_Buf.edt_MapNo").Data) = "" Then
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	Call clear_guide()
	ANCM.Data = h_acnm.Data
	If  Trim(AN10.Data) = "" Then
		AN10.SetFocus
		Exit Sub
	End If

	If  Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Object("obj_Buf.edt_sndCnt").Data = SCREEN.Object("obj_Buf.edt_sndCnt").Data + 1
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub clear_guide()
	SCREEN.Object("guide.guide").text = ""
End Sub



Sub SetInitCustomer()
	Dim iCustomerType
	iCustomerType = SYSTEM.ConnectBy
	SCREEN.Object("obj_Buf.edt_Customer").Data = iCustomerType

	If iCustomerType <> "1" Then '고객
		zPwd.Enable = False

		If Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If
	End If

	If SCREEN.Object("obj_Buf.edt_sndCnt").Data = 0 Then
		Call send_f()
	End If

End Sub


Sub SetPassword(sData)
	Dim Ifind, sAcc, sPass
	ifind = InStr(sData, "-")
	sAcc = Trim( Left(sData, Ifind-1) )
	sPass = Trim( Mid(sData, Ifind+1, Len(sData)- Ifind) )

	If Trim(AN10.Data) = sAcc Then

		zPwd.data = Trim(sPass)
		If Trim( SCREEN.Object("obj_Buf.edt_sndCnt").Data) = "0" Then
			Call send_f()
		End If
	End If
End Sub

