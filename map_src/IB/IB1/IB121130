_AW_ONDECLARE_AW_
Sub send_f()
	'상위 맵에서 데이터 가져오기
	Dim val, money
	val = SCREEN.object("main.UTAB1").Index
	zAcntNo.Data = SCREEN.object("main.AN10").data
	zInputPwd.Data = SCREEN.object("main.zPwd").data

	'입금/출금 구분
	If RADIO0.checked = True Then
		zTrxTp.Data = 3
		money = EDIT0.Data
	ElseIf RADIO1.Checked = True Then
		zTrxTp.Data = 4
		money = EDIT1.Data
	End If

	'확인창 띄우기
	dmsg = "acno" & vbTab & SCREEN.Object("main.AN10").Data & vbLf &_
		   "acnm" & vbTab & SCREEN.Object("main.AN10").Name & vbLf &_
		   "cost" & vbTab & money & vbLf &_
		   "tab" & vbTab & zTrxTp.Data & vbLf

			SCREEN.CreateWindow 2, "IB12113A /p5 /d", dmsg

			If SYSTEM.Pop("confirm") <> "OK" Then
				Exit Sub
			Else
				SCREEN.Send 0
			End If
End Sub


'가상매매시작버튼을 클릭하지 않고 주문을 할 경우 '1162 계좌정보가 등록되지 않았습니다.' 메세지 출력되어
'조회를 먼저 하도록 수정
Function beforeOrderCheck()
	beforeOrderCheck = False

	Dim ii, tmpAccn, tmpCnt, flag
	flag = "N"

	For ii = 0 To 4
		tmpCnt = "accn1211_" & ii
		tmpAccn = SCREEN.Object("main.preAccn_" & ii).Text

		If Trim(SCREEN.Object("main.AN10").Data) = Trim(tmpAccn) Then
			flag = "Y"
			Exit For
		End If
	Next

	If flag = "N" Then
		MsgBox "가상매매시작버튼을 클릭하여 주십시오.", , "IBK투자증권"
		SCREEN.Object("main.BUTTON0").SetFocus
		Exit Function
	End If

	beforeOrderCheck = True
End Function

