_AW_ONDECLARE_AW_
'== 처음 조회
Sub send_f()
	SCREEN.ClearAll 2,2
	ACNM.Data = AN1A.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
	send_btn.SetFocus
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
'SCREEN.SetTimer 10, False
'zTrxDt.SetFocus()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(LEDGER.Ecod, 1) <> "0" Then
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
Else
	lRcvblEnsrAmt.Data = lRcvblEnsrAmt.Data * 100
	lEvrRcvblAmt.Data = lEvrRcvblAmt.Data * 100

	Select Case selection.Data
		Case "1"	zTrxDt.SetFocus()
		Case "2"	send_btn.SetFocus()
		Case "3"	next_btn.SetFocus()
	End Select

End If

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If


If lRcvblEnsrAmt.Data > "0" Then
	lRcvblEnsrAmt.TRgb 94
Else
	lRcvblEnsrAmt.Data = "-" & lRcvblEnsrAmt.Data
	lRcvblEnsrAmt.TRgb 95
End If


If lEvrRcvblAmt.Data > "0" Then
	lEvrRcvblAmt.TRgb 94
Else
	lEvrRcvblAmt.Data = "-" & lEvrRcvblAmt.Data
	lEvrRcvblAmt.TRgb 95
End If


'Dim val1
'For ii = 1 To GRID0.Rows
'	val1 = GRID0.GetGridCell(ii, 4) * 100
'	GRID0.SetGridCell ii, 4, val1
'Next



Dim ii, exTax, cmAmt, trTax, fsTax, inTax, ihTax, plRat

For ii = 1 To GRID0.Rows

	cmAmt = GRID0.GetGridCell(ii, 16)	'--수수료
	trTax = GRID0.GetGridCell(ii, 17)	'--거래세
	fsTax = GRID0.GetGridCell(ii, 18)	'--농특세
	intax = GRID0.GetGridCell(ii, 19)	'--소득세
	ihTax = GRID0.GetGridCell(ii, 20)	'--주민세
	plRat = GRID0.GetGridCell(ii, 4)	'--담보비율

	exTax = 0

	If IsNumeric(cmAmt) = True Then
		exTax = exTax + cmAmt
	End If
	If IsNumeric(trTax) = True Then
		exTax = exTax + trTax
	End If
	If IsNumeric(fsTax) = True Then
		exTax = exTax + fsTax
	End If
	If IsNumeric(inTax) = True Then
		exTax = exTax + inTax
	End If
	If IsNumeric(ihTax) = True Then
		exTax = exTax + ihTax
	End If

	GRID0.SetGridCell ii, 30, exTax

	plRat = plRat * 100

	GRID0.SetGridCell ii, 4, plRat

	If plRat > 0 Then				'--담보비율에 색 입히기
		GRID0.SetTRgb ii, 4, 94
	Else
		GRID0.SetTRgb ii, 4, 95
	End If

Next

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
send_f()
selection.Data = 2

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
selection.Data = 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
selection.Data = 3
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
SCREEN.ClearAll 0, 2
ACNM.Data = AN1A.name

If Len(Trim(AN1A.Data)) < 11 Then
	AN1A.SetFocus
	Exit Sub
End If

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zTrxDt)
_AW_ONCHANGE_AW_
send_f()
selection.Data = 1
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
	selection.Data = 1
	zTrxDt.SetFocus()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(lEvrRcvblAmt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(lRcvblEnsrAmt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.DATA = GRID0.GetGridCell(GRID0.Row, 7)

	If Trim(S1301.DATA) = "" Then
		Exit Sub
	End If

	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



