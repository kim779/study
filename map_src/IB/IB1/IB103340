_AW_ONDECLARE_AW_
Sub Init()
	Call SetLabel()
	zAcntNo.Data = SCREEN.Object("main.AN1A").Data
	zPwd.Data = SCREEN.Object("main.Pwd").Data
	zAcnm.Data = SCREEN.Object("main.zAcnm").Data
	zIsuNo.Data = SCREEN.Object("main.1301").Data
	zLoanDt.Data = Trim(SCREEN.Object("main.obj_grid.grid0").GetGridCell(SCREEN.Object("main.obj_grid.grid0").row, 6))
	LoanDtChgDays.Data = ""
	lbName.Text = ""
	lbDaeDate.Text = ""
	lbManDate.Text = ""
	lbDaeEja.Text = ""
	lbJanAmt.Text = ""
	lbJanPrc.Text = ""
End Sub

Sub SetLabel()
	LABEL0.Text = "만기연장일수를 입력해 주시고 신청내역이 맞으면"
	LABEL1.Text = Chr(34) & "만기연장 신청하기" & Chr(34) & "를 클릭해주시기 바랍니다."
	LABEL2.Text = ""
End Sub

'== 첫 조회
Sub send_f()
	zAcntNo.Data = SCREEN.Object("main.AN1A").Data
	zAcnm.Data = SCREEN.Object("main.Acnm").Data
	zPwd.Data = SCREEN.Object("main.Pwd").Data
	zIsuNo.Data = SCREEN.Object("main.1301").Data
	zLoanDt.Data = Trim(SCREEN.Object("main.obj_grid.grid0").GetGridCell(SCREEN.Object("main.obj_grid.grid0").row, 6))
	SCREEN.Proc "main.SetLoanCode", ""
	zLoanDtlClssCode.Data = SCREEN.Object("main.zLoanDtlClssCode").Data

	If Len(Trim(zPwd.Data)) < 4 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요."
		SCREEN.Object("main.GUIDE").TRgb = 94
		SCREEN.Object("main.pwd").SetFocus
		Exit Sub
	ElseIf Len(Trim(zIsuNo.Data)) = 0 Then
		MsgBox "종목을 선택하세요.", , "IBK투자증권"
		Exit Sub
	ElseIf Len(Trim(zLoanDt.Data)) = 0 Then
		MsgBox "대출일이 없습니다.", , "IBK투자증권"
		Exit Sub
	End If

	dmsg = "acno" & vbTab & zIsuNo.Data & vbLf &_
		   "acnm" & vbTab & zAcnm.Data & vbLf &_
		   "hnam" & vbTab & lbName.Data & vbLf &_
		   "basedate" & vbTab & zLoanDt.Data & vbLf &_
		   "exdate" & vbTab & CLng(LoanDtChgDays.Data) & "일" & vbLf &_
		   "sygb" & vbTab & Trim(SCREEN.Object("main.obj_grid.GRID0").GetGridCell(SCREEN.Object("main.obj_grid.GRID0").row, 13)) & vbLf

	SCREEN.CreateWindow 2, "IB85014A /p5 /d", dmsg

	If SYSTEM.Pop("request") <> "OK" Then
		Exit Sub
	Else
		LEDGER.Fkey = "C"
		SCREEN.Send 0
	End If
End Sub

Sub send_o()
	SCREEN.Proc "main.SetLoanCode", ""
	zLoanDtlClssCode.Data = SCREEN.Object("main.zLoanDtlClssCode").Data
	obj1.proc "send_f", ""
End Sub

Sub SetBasicData()
	Dim obj, sDate1, sDate2
	Set obj = SCREEN.Object("main.obj_grid.grid0")

	sDate1 = Trim(obj.GetGridCell(obj.row, 6))
	sDate2 = Trim(obj.GetGridCell(obj.row, 7))

	lbName.Text = Trim(obj.GetGridCell(obj.row, 2))
	lbDaeDate.Text = SetDateString(sDate1, ".")
	lbManDate.Text = SetDateString(sDate2, ".")
	lbDaeEja.Text = ""
	lbJanAmt.Text = add_comma(Trim(obj.GetGridCell(obj.row, 3))) & " 주"
	lbJanPrc.Text = add_comma(Trim(obj.GetGridCell(obj.row, 4))) & " 원"

