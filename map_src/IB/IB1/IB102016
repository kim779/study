		EDIT4.Data = "1"
		EDIT5.Data = S1301.Data
	Else
		EDIT4.Data = "0"
		EDIT5.Data = ""
	End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

For i = 0 To GRID0.Rows
	For j = 1 To GRID0.Columns
		GRID0.SetGridCell i, j, Trim(GRID0.GetGridCell(i,j))
