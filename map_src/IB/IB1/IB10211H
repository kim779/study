Sub SetDanga(Data)
	If Len(g_DangaObject) = 0 Then
		Exit Sub
	End If
	SCREEN.Object(g_DangaObject).Data = Data
End Sub
'-----------------------------------------------------------------------
Function SetSign(Data)
	If Data > 0 Then
		SetPrcSign = "+" & LTrim(Data)
	ElseIf Data < 0 Then
		SetPrcSign = "-" & LTrim(Data)
	Else
		SetPrcSign = Data
	End If
End Function
'-----------------------------------------------------------------------
Function Str2Int(Str)
	Str2Int = 0
	If Len(Trim(Str)) = 0 Then
		Exit Function
	End If
	Str2Int = CCur(Str)
End Function
'-----------------------------------------------------------------------
Function Str2Dbl(Str)
	Str2Dbl = 0
	If Len(Trim(Str)) = 0 Then
		Exit Function
	End If
	Str2Dbl = CDbl(Str)
End Function
'-----------------------------------------------------------------------
Sub OnAlert()
	If g_ArrPrc(0) = 0 Then
		g_ArrPrc(0) = Str2Int(S2023.Data)
		Exit Sub
	End If

	If Str2Int(g_ArrPrc(1)) = 0 Then
		g_ArrPrc(1) = Str2Int(S3051.Data)
		Exit Sub
	End If

	If g_ArrPrc(0) <> Str2Int(S2023.Data) Then
		SetBox
	End If

	If Str2Int(g_ArrPrc(1)) <> Str2Int(S2023.Data) Then
		SetBox
	End If

	g_ArrPrc(0) = Str2Int(S2023.Data)
	g_ArrPrc(1) = Str2Int(S3051.Data)

	If g_ArrPrc(2) <> Str2Int(S2027.Data) Then
		SetPrevVolRate
	End If
End Sub
'-----------------------------------------------------------------------
Sub SetPrevVolRate()
	Rate = "0.00%"
	If g_ArrPrc(3) <> 0 Then
		Rate = FormatNumber(Str2Int(S2027.Data)*100/g_ArrPrc(3), 2, -2, -2, 0) & "%"
	End If
	S2403.Data = Rate
End Sub
'-----------------------------------------------------------------------
Sub SetBox()
	If Trim(S2023.Data) = "" Then
		BOX0.Visible = False
		Exit Sub
	End If

	For i = LBound(g_ArrCtrl(4)) To UBound(g_ArrCtrl(4))
		If Str2Int(S2023.Data) = Str2Int(g_ArrCtrl(4)(i).Data) Then
			'Width = g_ArrSize(0) - (SCREEN.Object("Parent.obj_10Hoga").Right - SCREEN.Object("Parent.obj_10Hoga").Left)
			'Height = g_ArrSize(1) - (SCREEN.Object("Parent.obj_10Hoga").Bottom - SCREEN.Object("Parent.obj_10Hoga").Top)
			'If i Mod 2 = 0 Then
			'	WidthGap = Width / 5
			'Else
			'	WidthGap = 0
			'End If
			BOX0.Top = g_ArrCtrl(4)(i).Top - 1 '+ Height * 17 / 100
			BOX0.Bottom = g_ArrCtrl(4)(i).Bottom + 1 '+ Height * 24 / 100
			BOX0.Right = g_ArrCtrl(4)(i).Right + 1 '+ Width * 3 / 4 - WidthGap
			BOX0.Left = g_ArrCtrl(4)(i).Left - 1 '+ Width / 2 - WidthGap
			BOX0.Visible = True
			Exit For
		End If
	Next
	If i = UBound(g_ArrCtrl(4)) + 1 Then
		BOX0.Visible = False
	End If
End Sub
