	AN5A.data = ACNT.Data
	ACNM.Data = AN5A.Name
	zPwd.Data = AN5A.Password

	If Len(Trim(AN5A.Data)) <> 11 Then
		AN5A.SetFocus
		Exit Sub
	End If


	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If

	e_SAVE.Data = "N"
Call send_f()

End Sub

Sub send_f()
	If Len(Trim(zPwd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하여 주십시오."
		MsgBox "비밀번호를 확인하십시오", , "IBK투자증권"
		zPwd.SetFocus
		Exit Sub
	End If

	LEDGER.Fkey = "5"
	SCREEN.Object("OBJECT3.IntaccNo").Data = Trim(AN5A.Data)
	SCREEN.Object("OBJECT3.Pwd").Data = Trim(zPwd.Data)
	OBJECT3.Send
End Sub

'OBJECT3 비밀번호 체크 성공후 호출 됨
Sub OkSend()
	If Trim(e_SAVE.Data) = "N" Or Trim(e_SAVE.Data) = "" Then
		' N 일때는 비밀번호 체크후자동주문 서비스약정 조회
		SCREEN.Object("obj_yg.zAcntNo").Data = Trim(AN5A.Data)
		SCREEN.Object("obj_yg.zPwd").Data = Trim(zPwd.Data)
		obj_yg.Send

		obj_getHP.Send
	ElseIf Trim(e_SAVE.Data) = "C" Then
		'C는 서비스 변경
		'0:조회 1:등록 2:변경 3:해지
		status = check_combox()
		If status = False Then
			Exit Sub
		End If
		szok = MsgBox( "주식자동주문 서비스를" & vbCrLf & "변경하시겠습니까?" ,1, "IBK투자증권")
		If szok <> "1" Then
			Exit Sub
		End If
		SCREEN.Object("obj_SVR_YG.e_use_yn").Data = "2"
		obj_SVR_YG.Send
	ElseIf Trim(e_SAVE.Data) = "Y" Then
		'Y일때는 약정서비스신청/해지
		If Trim(e_YG.Data) = "N" Then
			status = check_combox()
			If status = False Then
				Exit Sub
			End If

			szok = MsgBox( "주식자동주문 서비스를" & vbCrLf & "신청하시겠습니까?" ,1, "IBK투자증권")
			If szok <> "1" Then
				Exit Sub
			End If
		Else
			'0:조건없음 1:저장된 조건있음 2:감시중인 조건 있음
			If e_tot_clsf.Data = "0" Then
				szok = MsgBox( "주식자동주문 서비스를" & vbCrLf & "해지하시겠습니까?" ,1, "IBK투자증권")
				If szok <> "1" Then
					Exit Sub
				End If
			ElseIf e_tot_clsf.Data = "1" Then
				szok = MsgBox( "자동주문 등록된 내역이 있어요." & vbCrLf & "서비스 해지 시 자동주문 등록내역은"& vbCrLf & "일괄 삭제되요, 정말 해지하시겠습니까?" ,1, "IBK투자증권")
				If szok <> "1" Then
					Exit Sub
				End If

			ElseIf e_tot_clsf.Data = "2" Then
				MsgBox "감시 중인 주문이 있어요, 감시조건 중지"& vbCrLf & "또는 삭제 후 해지하실 수 있어요.", , "IBK투자증권"
				Exit Sub
			End If


		End If
		SCREEN.Send 0
	End If
End Sub

Function check_combox()
	If CHECK0.Checked = False Then
		MsgBox "SMS는 필수 입니다.", , "IBK투자증권"
		check_combox = False
		Exit Function
	End If

	If chk0.Checked = False Then
		MsgBox "주식자동주문 이용 동의문을" & vbCrLf & "확인해 주세요.", , "IBK투자증권"
		check_combox = False
		Exit Function
	End If

	If CHECK3.Checked = False Then
		MsgBox "개인정보 수집,이용에 동의해 주세요.", , "IBK투자증권"
		check_combox = False
		Exit Function
	End If

	check_combox = True
End Function


Sub SVR_YG(szVal)
	If szVal = "YES" Then
		e_YG.Data = "Y"
		BUTTON3.Visible = False
		BUTTON5.Visible = True
		BUTTON6.Visible = True
		LABEL0.Data = "주식자동주문을 이용하고 있어요."
	Else
		e_YG.Data = "N"
		BUTTON3.Visible = True
		BUTTON5.Visible = False
		BUTTON6.Visible = False
		LABEL0.Data = "주식자동주문을 이용하고 있지 않아요."
	End If
End Sub

