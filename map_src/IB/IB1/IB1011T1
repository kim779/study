'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password

	If Trim(SYSTEM.Pop("1000trPSWD")) <> "" And Trim(AN1A.Data) = Trim(SYSTEM.Pop("1000trACC")) Then
		ed_pswd.Data = Trim(SYSTEM.Pop("1000trPSWD"))
		SYSTEM.Push "1000trPSWD", ""
		SYSTEM.Push "1000trACC", ""
	End If

	SCREEN.Proc "obj_odr.OBJ_JUNGSAN.CalcJungsan", ""

	SCREEN.Proc "main.Set_account", "jumn"
	SCREEN.Object("obj_odr.o_jmno").Clear
	SCREEN.Object("main.guide").Text = " "

	If xxxx_flag = 1 Then
		SCREEN.Proc "main.chk_xxxx", ""		'비밀번호 체크
		xxxx_flag = 0
	End If
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus : Exit Sub
	End If
	ed_pswd.SetFocus
End Sub

'=== 가격자동 체크박스 체크값 기억/설정 ===
Sub Set_Auto(mmgb)
	Dim flag
	If (mmgb < "1") Or (mmgb > "3") Then Exit Sub
	flag = SYSTEM.Pop("auto_flag_s")		'-매도,매수,정정
	If Len(Trim(flag)) <> 3 Then flag = "000"	'-default:자동아님
	SCREEN.Object("obj_odr.chk_auto").Checked = (Mid(flag,mmgb,1) = "1")
	SCREEN.Object("obj_odr.cboPrice").Enable = (Mid(flag,mmgb,1) = "1")
End Sub
Sub Get_Auto(mmgb, c_auto)
	Dim flag, val
	If c_auto = "True" Then
		val = "1"
	Else
		val = "0"
	End If

	flag = SYSTEM.Pop("auto_flag_s")		'-매도,매수,정정
	If Len(Trim(flag)) <> 3 Then flag = "000"	'-default:자동아님
	Select Case mmgb
	Case "1" : flag = val & Mid(flag,2)
	Case "2" : flag = Left(flag,1) & val & Mid(flag,3)
	Case "3" : flag = Left(flag,2) & val
	Case Else : Exit Sub
	End Select
	SYSTEM.Push "auto_flag_s", flag
End Sub


Sub SetTab(index)
	Select Case index
		Case "1"  OBJ_odr.SetObject("IB100150")
		Case "2"  OBJ_odr.SetObject("IB100160")
	End Select
End Sub

Sub SetPrc(prc)
