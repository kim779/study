{


_AW_ONDECLARE_AW_
Dim nCurrRow
nCurrRow = 1

'== 첫 조회
Sub send_f()
	nCurrRow = 1
	CrdtTp.Data = "1"

	SCREEN.ClearAll 0,2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub change_grp1()	'시장구분 전체0, 코스피1, 코스닥2
	IsuMktTp.Data = "0"

	If grp1_00.Checked Then
		IsuMktTp.Data = "0"
	ElseIf grp1_01.Checked Then
		IsuMktTp.Data = "1"
	ElseIf grp1_02.Checked Then
		IsuMktTp.Data = "2"
	End If
End Sub

Sub change_grp2()	'가능구분 가능0, 불가능1
	LoanAbleYn.Data = "0"

	If grp2_00.Checked Then
		LoanAbleYn.Data = "0"
	ElseIf grp2_01.Checked Then
		LoanAbleYn.Data = "1"
	End If
End Sub

Sub change_grp3()	'종목한도 S등급S , A등급A , B등급B , C등급C , D등급D '두자리임. 뒤에 스페이스
	IcgCode.Data = "00"

	If grp3_00.Checked Then
		IcgCode.Data = "00"
	ElseIf grp3_01.Checked Then
		IcgCode.Data = "S "
	ElseIf grp3_02.Checked Then
		IcgCode.Data = "A "
	ElseIf grp3_03.Checked Then
		IcgCode.Data = "B "
	ElseIf grp3_04.Checked Then
		IcgCode.Data = "C "
	ElseIf grp3_05.Checked Then
		IcgCode.Data = "D "
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call change_grp1()
Call change_grp2()
Call change_grp3()

