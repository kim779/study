Sub Map_OpenSize()

	Dim msize, xy
	If SCREEN.CreateObject("INFO") = False Then
		Exit Sub
	End If

	msize = INFO.PopData(LOGIN.Name, "userconf.ini", "MAPSIZE_SIGMA", SCREEN.GetMapName(1))
	If Trim(msize) <> "" Then
		xy = Split(msize, ",")
		SCREEN.SetSize xy(0), xy(1)

		If xy(1) = 491 Then
			info_show.Visible = True
			info_hidden.Visible = False
			OBJECT3.Visible = False
			Call SetReduceRect()
		ElseIf xy(1) = 320 Then
			info_show.Visible = True
			info_hidden.Visible = False
			OBJECT3.Visible = False
			Call SetReduceRect()
		End If

		SCREEN.Object("OBJECT5.17412").HogaType xy(2)
		SCREEN.Object("OBJECT5.17412").Refresh

		BTN_HS.Visible	Mid(xy(3),1,1)
		BTN_HM.Visible	Mid(xy(3),2,1)
		BTN_WS.Visible  Mid(xy(3),3,1)
	 	BTN_WM.Visible  Mid(xy(3),4,1)
 	End If
End Sub

Sub Push_OpenSize(xval, yval, hogb, btn)
	Dim msize
	If SCREEN.CreateObject("INFO") = False Then
		Exit Sub
	End If

	msize = xval &","& yval &","& hogb &","& btn
	INFO.PushData LOGIN.Name, "userconf.ini", "MAPSIZE_SIGMA", SCREEN.GetMapName(1), msize
