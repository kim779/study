RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sect
sect = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN30.Name
	h_acnm.Data = AN30.Name
	zPwd.Data = AN30.Password

	If Trim(AN30.Data) = "" Then
		AN30.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ANCM.Data = AN30.Name
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)
LEDGER.Rcnt = "0019"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""
If SYSTEM.ConnectBy = 1 Then
	If CheckInput(AN30, zPwd) = True Then
		SCREEN.onsend = True
	End If
Else
	zPwd.Data = "9999"

	If CheckInput(AN30, zPwd) = True Then
		SCREEN.onsend = True
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
	next_btn.Enable False
	zPwd.SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable True
	next_btn.Setfocus
Else
	next_btn.Enable False
	GRID0.SetFocus
End If

If sect = 0 And LEDGER.Next <> "Y" Then
	zPwd.SetFocus
End If

BUTTON1.Enable = True

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN30)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	sect = 0
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
sect = 1
'SYSTEM.Trace "1"
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
sect = 1
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(lDps)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
'SCREEN.Print
GRID0.Excel True, True, "IB120330"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.DATA = GRID0.GetGridCell(GRID0.INDEX +1, 1)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.Data

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(gubn)
_AW_ONCHANGE_AW_
SCREEN.CreateObject("Info")
INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "G_COMBO", gubn.Data

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(st_dt)
_AW_ONCHANGE_AW_
'SCREEN.CreateObject("Info")
