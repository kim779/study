Sub refreshList()

	If Trim(pswd2.Data) = "" Then
		pswd2.SetFocus
		Exit Sub
	End If


	SCREEN.Proc "obj_condlist.DisplayCondList", ""
	SCREEN.Proc "obj_condlist.obj_svrcondlist.refreshList", ""

End Sub


Sub clickcondTypeTab()
	obj_currSise.Visible = True
	OBJ_sise.Visible = True
	PANEL_hoga.Visible = True
	PANEL1.Visible = True
	tab_hoga.Visible = True

	S1301.Enable  True
	BUTTON1.Enable True
	BUTTON2.Enable True
	S1301.Visible = True
	OBJ_hnam.Visible = True
	BUTTON1.Visible = True
	BUTTON2.Visible = True

	obj_svrCond.Visible = True

	Select Case tab_condType.ID
	Case 7 :
		'obj_condlist.SetRect 0,60,660,395
		obj_condlist.SetRect 0,80,660,415
		obj_condlist.SetObject "IB102010"
		obj_svrCond.SetObject "IB102002"
		S1301.Enable  False
		BUTTON1.Enable False
		BUTTON2.Enable False
	Case 2 :
		'obj_condlist.SetRect 0,60,660,395
		obj_condlist.SetRect 0,80,660,415
		obj_condlist.SetObject "IB102010"
		obj_svrCond.SetObject "IB102003"

	Case 5 :
		'obj_condlist.SetRect 0,60,660,395
		obj_condlist.SetRect 0,80,660,415
		obj_condlist.SetObject "IB102010"
		obj_svrCond.SetObject "IB102004"
	Case 6 :
		'obj_condlist.SetRect 0,60,1000,675
		obj_condlist.SetRect 0,80,1000,695
		obj_condlist.SetObject "IB102014"

		OBJ_sise.SetObject "IB102022"

		obj_currSise.SetObject "IB102022"
		obj_currSise.Visible = False
		OBJ_sise.Visible = False
		PANEL_hoga.Visible = False
		PANEL1.Visible = False
		tab_hoga.Visible = False

		S1301.Visible = False
		OBJ_hnam.SetObject "IB102022"
		OBJ_hnam.Visible = False
		BUTTON1.Visible = False
		BUTTON2.Visible = False

		obj_svrCond.Visible = False


	End Select


	If Trim(pswd2.Data) = "" Or Trim(e_YG.Data) = "" Then
		obj_condlist.SetObject "IB102022"
		obj_svrCond.SetObject "IB102023"

		'내역 조회 보다 계좌 바뀌는 경우임 호가 obj 화면들 원복 시키려고
		If tab_condType.ID <> 6 And OBJ_sise.GetObject = "IB102022" Then
			OBJ_hnam.SetObject "IB2000YJ"
			OBJ_hnam.Visible = True
			OBJ_hnam.Send

			obj_currSise.SetObject "IB102021"
			obj_currSise.Visible = True
			obj_currSise.Send
			Call click_hogaTab()
		End If

		pswd2.SetFocus
		Exit Sub
	End If


	If tab_condType.ID <> 6 And OBJ_sise.GetObject = "IB102022" Then
		OBJ_hnam.SetObject "IB2000YJ"
		obj_currSise.SetObject "IB102021"
		OBJ_hnam.Visible = True
		OBJ_hnam.Send

		obj_currSise.SetObject "IB102021"
		obj_currSise.Visible = True
		obj_currSise.Send

		Call click_hogaTab()
	End If

	SCREEN.Proc "obj_condlist.SetObj", ""


	Call InitItemCode()

End Sub


Sub click_hogaTab()

	Select Case tab_hoga.ID
	Case 0 : OBJ_sise.SetObject "IB102020"

			Call SetHogaVisible()
	Case 1 : OBJ_sise.SetObject "IB102044"

	End Select

	OBJ_sise.Send
End Sub


Sub send_sise_all(xval)
SCREEN.IgnoreChange True
If xval <> "jumun" And xval <> "account" Then
	S1301.Trigger "", False
End If
S1301.Trigger "1301", True

OBJ_hnam.Send
OBJ_sise.Send
obj_currSise.Send

If tab_condType.ID = 7 Or tab_condType.ID = 5 Or tab_condType.ID = 2 Then
	If obj_svrCond.GetObject <> "IB102023" Then
		SCREEN.Object("obj_svrCond.e_jcode").data = S1301.Data
		SCREEN.Object("obj_svrCond.e_jname").data = SCREEN.GetName(100, S1301.Data, 0)
		SCREEN.Object("obj_svrCond.e_crdt").data = "00"
		SCREEN.Object("obj_svrCond.e_ldate").data = ""
	'	SCREEN.Object("obj_svrCond.e_avprc").data = e_avprc.Data

		SCREEN.Proc "obj_svrCond.SetJanInfo", "ITEMCHANGE"
	End If
End If

SCREEN.IgnoreChange False

End Sub


Sub send_ItemInfo(xval)
	If xval = "JANGOINFO" Then
		'잔고 더블클릭으로 들어온 정보 처리
		If tab_condType.ID = 7 Or tab_condType.ID = 5 Or tab_condType.ID = 2 Then
			'잔고청산
			SCREEN.Object("obj_svrCond.e_jcode").data = e_jcode.Data
			SCREEN.Object("obj_svrCond.e_jname").data = e_jname.Data
			SCREEN.Object("obj_svrCond.e_crdt").data = e_crdt.Data
			SCREEN.Object("obj_svrCond.e_ldate").data = e_ldate.Data
			SCREEN.Object("obj_svrCond.e_avprc").data = e_avprc.Data

			SCREEN.Proc "obj_svrCond.SetJanInfo", "JANGOINFO"

		End If
	ElseIf xval = "SVR_CONDLIST_B" Then
		'매수조건리스트에서 더블클릭
		SCREEN.Object("obj_svrCond.e_sq").data = e_sq.Data
		SCREEN.Object("obj_svrCond.e_avprc").data = e_avprc.Data
		SCREEN.Proc "obj_svrCond.LoadCond", ""
	End If

End Sub

Sub SetHogaVisible()
	If  OBJ_sise.GetObject = "IB102020" Then
		Sindex = "0"
		If SCREEN.CreateObject("Info") Then
			Sindex = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB102020", "HOGA_INDEX"))
			If Len(Sindex) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB1001E0", "HOGA_INDEX", "0"
				Sindex = "0"
			End If
		End If

		OBJ_sise.Proc "ProcSetVisible", Sindex
	End If
End Sub

