Sub SVR_YG(szVal)
	If szVal = "YES" Then
		b_Yak.Text = "자동주문 서비스 변경/해지"
		e_YG.Data = "Y"
		Call clickcondTypeTab()
		Call SVR_SendStart()
	Else
		b_Yak.Text = "자동주문 서비스 신청"
		e_YG.Data = "N"
		szok = MsgBox("주식자동주문 서비스를 신청하셔야"& vbCrLf &"이용하실 수 있어요."& vbCrLf &"서비스신청을 하시겠어요?" ,1, "IBK투자증권")

		If szok <> "1" Then
			SCREEN.CloseWindow
		Else
			SCREEN.SetTimer 5, True
		End If

	End If
End Sub

Sub SVR_SendStart()
	SCREEN.Proc "obj_condlist.sendData", "QRY"
End Sub

