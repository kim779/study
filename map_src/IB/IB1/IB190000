_AW_ONDECLARE_AW_
Dim ts

Function ggd( obj, row, col )
	ggd = Trim(SCREEN.Object(obj).GetGridCell(row,col))
End Function

Sub get_gp_list()
	'SYSTEM.Trace("get_gp_list")

	gr_gp_list.Clear
	gr_gp_accn.Clear
	gr_accn_list.Clear

	SCREEN.Object("obj2.GRID0").Clear ' 그룹 계좌리스트 초기화

	SCREEN.Proc "obj1.send_f", ""
End Sub

Sub gp_select(row) ' 그룹이 선택 되었을 때
	Dim gp_num, num, idx, temp, rowCnt
	gp_num = Trim(gr_gp_list.GetGridCell( row, 3 )) ' 그룹번호
	rowCnt = 0

	gr_gp_accn.Clear

	If Len(gp_num) = 0 Then ' 그룹번호가 없으면 새그룹 일 경우
		LABEL2.Text = ""
		Exit Sub
	End If

	Call writeOpen()		'230 파일열기

	ed_gp_num.Data = gp_num
	ed_gp_name.Data = gr_gp_list.GetGridCell( row, 2 ) '
	idx = 1

	ts.writeLine(Time & " IB190000 gp_select 조회된 계좌들에서 그룹에 맞는 계좌 가져오기 selectrow = " & row)	'230

	For i = 1 To SCREEN.Object("obj2.GRID0").Rows
		num = ggd("obj2.GRID0",i,1)
		If Len(num) = 0 Then
			LABEL2.Text = rowCnt
			ts.writeLine("    rowCnt = " & rowCnt)	'230
			ts.writeLine(Time & " IB190000 gp_select end")	'230
			ts.close	'230
			rowCnt = 0
			Exit For
		End If

		If num = gp_num Then
			gr_gp_accn.SetGridCell idx, 1, ggd("obj2.GRID0",i,1) '그룹번호
			gr_gp_accn.SetGridCell idx, 2, ggd("obj2.GRID0",i,2) '그룹명
			gr_gp_accn.SetGridCell idx, 3, ggd("obj2.GRID0",i,3) '계좌번호
			gr_gp_accn.SetGridCell idx, 4, ggd("obj2.GRID0",i,4) '계좌명
			gr_gp_accn.SetGridCell idx, 5, ggd("obj2.GRID0",i,5) '비밀번호

			temp = ggd("obj2.GRID0",i,6)
			gr_gp_accn.SetGridCell idx, 6, FormatNumber(temp,2) '배율

			temp = ggd("obj2.GRID0",i,7)
			gr_gp_accn.SetGridCell idx, 7, FormatNumber(temp,0) '승수

			ts.writeLine("    " & idx & " " & ggd("obj2.GRID0",i, 1) & " " & ggd("obj2.GRID0",i, 2) & " " & ggd("obj2.GRID0",i, 3) & " " & ggd("obj2.GRID0",i, 4))	'230

			idx = idx + 1
			rowCnt = rowCnt + 1
		End If
	Next

	Call grGpAcntCnt()
End Sub

Sub gp_accn_done()
	gp_select(1)

	obj4.Send ' 보유계좌 조회
End Sub

Sub gp_list_done()

Dim num, name, idx

idx = 0

For i = 1 To SCREEN.Object("obj1.GRID0").Rows

	num = ggd("obj1.GRID0", i, 1 )
	name = ggd("obj1.GRID0", i, 2 )
	If Len(num) = 0 Then
		Exit For
	End If

	idx = idx + 1

	gr_gp_list.SetGridCell i, 1, Right( num, 3 )
	gr_gp_list.SetGridCell i, 2, name
	gr_gp_list.SetGridCell i, 3, num
Next

If idx = 0 Then '그룹이 없으면
	obj4.Send
	accn_list_done()
Else
	SCREEN.Proc "obj2.query_accn", "1"
End If

End Sub

Sub accn_list_done()

Dim accn, name, ty, gp_accn, find, idx

'SYSTEM.Trace("accn_list_done " & SCREEN.Object("obj4.GRID0").Rows)

idx = 1
For i = 1 To SCREEN.Object("obj4.GRID0").Rows

	accn = ggd("obj4.GRID0", i, 1 )

	If Len(accn) = 0 Then
		Exit For
	End If

	name = ggd("obj4.GRID0", i, 2 )
	name = Left( name, InStr(name,"|")-1 )

	find = False

	'SYSTEM.Trace( accn & " " & name )

	For j = 1 To SCREEN.Object("obj2.GRID0").Rows ' 그룹에 들어간 계좌 제외
		gp_accn = ggd("obj2.GRID0", j, 3 )
		If  gp_accn = accn Then

			'SYSTEM.Trace( "그룹에 들어간 계좌 " & gp_accn & " " & accn )

			find = True
		End If
	Next

	ty = Mid( accn ,4, 2 )
	If ty <> "10" And ty <> "51" Then ' 주식이 아닌 계좌 제
		find = True
	End If

	If find = False Then ' 전체 보유 계좌에 추가
		'SYSTEM.Trace( "계좌 추가 " & accn  )
		gr_accn_list.SetGridCell idx, 1, accn
		gr_accn_list.SetGridCell idx, 2, name
		idx = idx + 1
	End If

Next

If idx < 18 Then
	gr_accn_list.SetRows 18
Else
	gr_accn_list.SetRows idx
End If

End Sub

Function total_d()
	Dim total

	total = CDbl(0)
	For i = 1 To gr_gp_accn.Rows
		If Len( Trim( gr_gp_accn.GetGridCell(i,3) ) ) <> 0 And Len( Trim(gr_gp_accn.GetGridCell(i,6)) )<> 0 Then
			total = CDbl(total) + CDbl(Trim(gr_gp_accn.GetGridCell(i,6)))
		End If
	Next

	total_d = Round(total,2)

End Function

Sub check_pwd( accn, ret ) ' 비밀번호 검사 결과

For i = 1 To gr_gp_accn.Rows

	If Trim(gr_gp_accn.GetGridCell( i, 3)) = accn Then
		If ret = "N" Then
			MsgBox accn & " " & "비밀번호 검증 실패"
		Else
			MsgBox accn & " " & "비밀번호 검증 성공 "
		End If

		Exit For
	End If

Next

End Sub

Sub add_accn()
	Dim accn, name, add

	accn = Trim(gr_accn_list.GetGridCell( gr_accn_list.Row, 1 ))
	name = Trim(gr_accn_list.GetGridCell( gr_accn_list.Row, 2 ))

	If Len(accn) = 0 Then
		Exit Sub
	End If

	add = True

	For i = 1 To gr_gp_accn.Rows
		If Len(Trim(gr_gp_accn.GetGridCell( i, 3 ))) = 0 Then
			Exit For
		End If

		If Trim(gr_gp_accn.GetGridCell(i,3)) = accn Then
			add = False
			Exit For
		End If
	Next

	If add = True Then
		Call writeOpen()
		gr_gp_accn.SetGridCell i, 3, accn
		gr_gp_accn.SetGridCell i, 4, name
		gr_gp_accn.SetGridCell i, 5, ""
		gr_gp_accn.SetGridCell i, 6, "1.00"
		gr_gp_accn.SetGridCell i, 7, "1"

		ts.writeLine(Time & " 계좌입력 " & accn & "" & name )
		ts.close()
	End If
End Sub


Sub writeOpen()
	Dim fso, data, parseData, userID, index, directory
	Const ForWriting = 8
	Set fso = CreateObject("Scripting.FileSystemObject")
	directory = SYSTEM.Home & "\user\LIST_" & getCurrDay() &".ini"

	If (fso.FileExists(directory)) = False Then
		fso.CreateTextFile directory, True
	End If

	Set ts = fso.OpenTextFile(directory, ForWriting)
End Sub


Sub grGpAcntCnt()
	Dim ii, cnt, tmpAcnt
	cnt = 0

	For ii = 1 To gr_gp_accn.Rows
		tmpAcnt = Trim(gr_gp_accn.GetGridCell(ii, 3))

		If tmpAcnt = "" Then
			Exit For
		End If

		cnt = cnt + 1
	Next

	LABEL2.Text = cnt
End Sub

