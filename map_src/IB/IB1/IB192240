_AW_ONDECLARE_AW_
'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	OGRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Dim a, yyyymmdd

Sub CheckData()
	If Trim(LOGIN.Day0) <> "" And Trim(LOGIN.Day1) <> "" And Trim(LOGIN.Day2) <> "" Then
		yyyymmdd = DateSerial(Left(LOGIN.Day1, 4), Mid(LOGIN.Day1, 5, 2), Mid(LOGIN.Day1, 7, 2))

		a = Weekday(CDate(Trim(yyyymmdd)))

		'오늘이 토요일 이거나 일요일 이면 전영업일로 초기화
		If a = 7 Or a = 1 Then
			dt.Data = LOGIN.Day0
		End If
	End If
End Sub

Sub sendGriddata()
	Dim ii
	Dim code, gubn, qty, sellqty, maip, maipVal, curr, suik, pyunga, sonik, currtype, dataset

	dataset = ""

	For ii =1 To OGRID.Rows

		code = Trim(OGRID.GetGridCell(ii, 1))
		gubn = Trim(OGRID.GetGridCell(ii, 4))
		qty = Trim(OGRID.GetGridCell(ii, 5))
		sellqty = Trim(OGRID.GetGridCell(ii, 13))
		maip = Trim(OGRID.GetGridCell(ii, 6))
		curr = Trim(OGRID.GetGridCell(ii, 7))
		suik = Trim(OGRID.GetGridCell(ii, 10))
		pyunga = Trim(OGRID.GetGridCell(ii, 11))
		sonik = Trim(OGRID.GetGridCell(ii, 9))

		If code <> "" Then
			If	Mid(code,1,1) = "1" Then
				currtype = 500000
			Else
				currtype = 100000
			End If
		End If

		If maip = "" Then
			maip = 0
		End If

		If qty = "" Then
			qty = 0
		End If

		maipVal = maip * qty * currtype 	'매입금액 = 매입가 * 미결수량 * 선옵가격

		dataset = code & vbTab & gubn & vbTab & qty & vbTab & sellqty & vbTab & maip & vbTab & maipVal & vbTab &_
				curr & vbTab & suik & vbTab & pyunga & vbTab & sonik & vbTab

'		SYSTEM.Trace "sendGriddata dataset : " & dataset
		If dataset <> "" Then
			SCREEN.Proc "parent.SetGrid", dataset
		End If
	Next

End Sub

_AW_ONSTART_AW_
LEDGER.Fkey = "C"
LEDGER.Rcnt = "0015"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
an20.Data = SCREEN.Object("parent.AN20").Data
zpwd.Data = SCREEN.Object("parent.zpwd").Data
BalEvalTp.Data = SCREEN.Object("parent.Combo1").Data	'잔고평가구분
FutsPrcEvalTp.Data =  SCREEN.Object("parent.Combo2").Data	'선물가격평가

CheckData()

If Trim(SYSTEM.UserPass) <> Trim(zpwd.Data) Then
	If Len(Trim(zpwd.Data)) >=4 And Trim(zpwd.Data) <> "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zpwd.Data))
		zpwd.Data = "HEAD"
	ElseIf Trim(zpwd.Data) = "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = Trim(SCREEN.Object("parent.LEDGER").EPwd)
		zpwd.Data = "HEAD"
	End If
End If

If Trim(zpwd.Data) = "HEAD" Then
	If Len(Trim(LEDGER.EPwd)) <> 44 Then
		SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
		SCREEN.Object("main.zpwd").Data = ""
		SCREEN.Object("main.zpwd").SetFocus
		SCREEN.OnSend = False
		Exit Sub
	End If
End If

