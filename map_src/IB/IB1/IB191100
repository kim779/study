Sub SendOrder()

	Dim grid, obj, gjnm, jidx, jcnt, code, xxgb, sygb, sycd

	obj = "OBJ_odr"

	Set grid = SCREEN.Object(obj & ".GRID")

	Dim ii, pswd2

	en_accn.Data = Mid(AN1A.data, 1, 8)
	en_pswd.Data = pswd.Data
	pswd2 = SYSTEM.Encrypt(en_pswd.Data, en_accn.Data)

	jidx = 1
	jcnt = 0
	Call grid.Clear()
	For ii=1 To VIEWGRID.Rows
		If VIEWGRID.GetGridCell(ii, 1)="1" And CLng(VIEWGRID.GetGridCell(ii, 23))>0 Then
			grid.SetGridCell jidx, 1, VIEWGRID.GetGridCell (ii, 1)
			grid.SetGridCell jidx, 2, "1"
			grid.SetGridCell jidx, 3, ""
			grid.SetGridCell jidx, 4, "1"
			grid.SetGridCell jidx, 5, AN1A.Data
			grid.SetGridCell jidx, 6, pswd2
			grid.SetGridCell jidx, 7, ""
			grid.SetGridCell jidx, 8, VIEWGRID.GetGridCell(ii, 2)
			grid.SetGridCell jidx, 9, VIEWGRID.GetGridCell(ii, 23)
			grid.SetGridCell jidx, 10, VIEWGRID.GetGridCell(ii, 24)
			grid.SetGridCell jidx, 11, cb21.Data
			grid.SetGridCell jidx, 12, "0"
			grid.SetGridCell jidx, 13, ""

			xxgb = "X"
			sycd = VIEWGRID.GetGridCell (ii, 4)
			If sycd = "01" Then
				xxgb = "B"
				Select Case Trim(VIEWGRID.GetGridCell(ii, 17))
				Case "01"	' 유통융자
					sygb = "101"
				Case "03"	' 자기융자
					sygb = "103"
				End Select
			End If



			grid.SetGridCell jidx, 14, xxgb
			grid.SetGridCell jidx, 15, sygb
			grid.SetGridCell jidx, 16, VIEWGRID.GetGridCell(ii, 18)			'대출일자

			jidx = jidx + 1
			jcnt = jcnt + 1
		End If
	Next
	SCREEN.Object("OBJ_odr.NREC").Data = jcnt

	OBJ_odr.Send

End Sub

Sub RecvOrder()

	Dim obj

	obj = "OBJ_odr"

	Dim grid, jmno, ii, jj, emsg, row
	Set grid = SCREEN.Object( obj & ".GRID")

	'SYSTEM.Trace "grid row[" & grid.Rows & "]"

	row = 1
	For ii=1 To grid.Rows
		For jj= row To VIEWGRID.Rows
			row = row + 1

			'SYSTEM.Trace "row[" & row & "]check[" & (VIEWGRID.GetGridCell(jj, 1) = "1") & "] grid[" & Trim(grid.GetGridCell(ii,8)) & "] VIEWGRID[" & Trim(VIEWGRID.GetGridCell(jj,2)) & "]"
			If  VIEWGRID.GetGridCell(jj, 1) = "1" And (Trim(grid.GetGridCell(ii,8))=Trim(VIEWGRID.GetGridCell(jj, 2))) Then

				jmno = Trim(grid.GetGridCell(ii, 18))
				emsg = Trim(grid.GetGridCell(ii, 20))

				'SYSTEM.Trace "jmno[" & jmno & "] emsg[" & emsg & "]"

				If jmno<>"" Then
					jmno = CLng(jmno)
					If jmno<>0 Then
						VIEWGRID.SetGridCell jj, 26, jmno
					End If
				End If
				If Len(Trim(emsg)) > 4 Then
					If CLng(Mid(emsg,1,4))>=1000 Then
						VIEWGRID.SetTRgb jj, 27, 94
					Else
						VIEWGRID.SetTRgb jj, 27, 69
					End If
				End If
				VIEWGRID.SetGridCell jj, 27, emsg
				Exit For
			End If
		Next
	Next
End Sub


Function get_hoga_unit(byval inval, code)
	Dim sCode

	sCode = code

	If Left(Trim(code), 1) = "A" Then
		sCode = Mid(code, 1)
	End If

	If SCREEN.GetCodeType(sCode) = 6 Then
		get_hoga_unit = 5
	ElseIf (inval < 1000) Then
		get_hoga_unit = 1
	ElseIf (inval < 5000) Then
		get_hoga_unit = 5
	ElseIf (inval < 10000) Then
		get_hoga_unit = 10
	ElseIf (inval < 50000) Then
		get_hoga_unit = 50
	ElseIf (inval < 100000) Then
		get_hoga_unit = 100
	ElseIf (inval < 500000) Then
		If SCREEN.GetCodeType(sCode) = 2 Then
			get_hoga_unit = 100
		Else
			get_hoga_unit = 500
		End If
	Else
		If SCREEN.GetCodeType(sCode) = 2 Then
			get_hoga_unit = 100
		Else
			get_hoga_unit = 1000
		End If
	End If
End Function

