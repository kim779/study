RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim gridPos
gridPos = 1

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

AcntNo.Data = SCREEN.Object("main.AN1A").Data
Pwd.Data = SCREEN.Object("main.Pwd").Data

LoanDt.Data = SCREEN.Object("parent.LoanDt").Data
IsuNo.Data = SCREEN.Object("parent.grid0").GetGridCell(SCREEN.Object("parent.grid0").row, 1)
GUBN.Data = "1"

If Len(Trim(AcntNo.Data)) < 11 Then
	guide_msg("계좌번호를 확인하세요.")
	SCREEN.Object("main.AN1A").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = "1" Then
	If Len(Trim(Pwd.data)) < 4 Then
		guide_msg("비밀번호를 확인하세요.")
		SCREEN.Object("main.Pwd").SetFocus
		Exit Sub
	End If
	If SYSTEM.UserPass <> Trim(Pwd.Data) Then
		If Trim(Pwd.Data) <> "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(Pwd.Data))
			Pwd.Data = "HEAD"
		Else
			LEDGER.Hsiz = 44
			LEDGER.EPwd = Trim(SCREEN.Object("main.LEDGER").EPwd)
			Pwd.Data = "HEAD"
		End If

		If Trim(Pwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
				SCREEN.Object("main.Pwd").Data = ""
				SCREEN.Object("main.Pwd").SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If

If  SCREEN.Object("parent.GRID0").rows = 0 Then
	guide_msg("조회내역을 확인하세요.")
	SCREEN.OnSend = False
Else
	SCREEN.OnSend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

Call guide_msg(Trim(LEDGER.Emsg))

SCREEN.Object("parent.grid0").SetGridCell SCREEN.Object("parent.grid0").row, 8, OUTPUT4.Data

_AW_ONENDSUB_AW_
}



