Sub AllCancel()

	Dim ii

	For ii=1 To GRID.Rows
		GRID.SetGridCell ii, 6, Trim(pswd.Data)
	Next

	SCREEN.Send 0
End Sub

Sub Set_account()
	ACNM.Data = AN1A.name
	acct.Data = AN1A.data
'	pswd.Data = AN1A.Password
End Sub

Function ReadFile()
	Set myFSO = CreateObject("Scripting.FileSystemObject")
	Set ReadStuff = myFSO.OpenTextFile("1901Cancel.dat", 1, True)
	ReadFile = ReadStuff.ReadLine
	ReadStuff.Close
	Set WriteStuff = Nothing
	Set myFSO = Nothing
End Function

