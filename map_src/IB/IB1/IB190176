Dim Mydata

Function data_split()

	Mydata = Split(ReadFile, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), ";", -1, 1)							' 한 레코드를 개체별로 자르는중..

		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(0))				' 원주문
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))				' 종목코드
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))				' 종목명
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))				' 주문수량
