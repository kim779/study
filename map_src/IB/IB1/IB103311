QryTp.Data = 1

Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg

Dim i, data1, data2, data3
data1 = 0
data2 = 0

For i = 1 To GRID0.Rows
	If Trim(GRID0.GetGridCell(i,4)) <> "" Then
		data1 = data1 + CDbl(Trim(GRID0.GetGridCell(i,4)))
	End If
	If Trim(GRID0.GetGridCell(i,2)) <> "" Then
		data3 = CDbl(Trim(GRID0.GetGridCell(i,2)))
		If data2 < data3 Then
			data2 = data3
		End If
	End If
Next

DLoanAmt.Data = data1
LoanAmt.Data = data2

