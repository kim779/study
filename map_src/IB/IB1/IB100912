'***************************************************************************
Function Error_check()
	Dim ret

	Error_check = False

	If P_CheckInput(AN1A, pswd) = False Then
		Exit Function
	End If
	If SCREEN.GetMapName(1) <> "IB885100" Then
		ret = P_pswdConfirm(AN1A.data, pswd.data, msg)
		If ret <> True Then
			SCREEN.Object("Main.GUIDE").Text = msg
			Exit Function
		End If
	End If

	Error_check = True
End Function

'***************************************************************
