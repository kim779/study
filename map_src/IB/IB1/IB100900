Dim exgb

Sub change_extend(gb)
	exgb = gb
	SCREEN.SetTimer 2, True
End Sub

Sub SelectCode(sData)
	arlist = Split(sData, ";", -1, 1)
	SCREEN.Object("OBJ_order.obj_odr.1301").Data = arlist(0)
	SCREEN.Object("OBJ_order.obj_odr.ed_jqty").Data = arlist(1)
	SCREEN.Object("OBJ_order.obj_odr.ed_jprc").Data = arlist(2)
End Sub

' ------ 관심종목 확장형인지 검사
Function isextend()
	Dim gb

	gb = 0
	isextend = 0
	If tab_tuja.ID <> 0 Then
		isextend = 0
		Exit Function
	End If

	If SCREEN.CreateObject("Info") Then
		gb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB300000", "isextend"))
	End If
	If gb = "1" Then
		isextend = 1
		Exit Function
	End If
End Function


Sub all_account()
	OBJ_account.Send
End Sub

Sub send_sise_all(xval)
	S1301.Trigger "1301", True

	If xval <> "jumun" Then
		If Trim(S1301.Data) <> Trim(SCREEN.Object("obj_order.obj_odr.1301").Data) Then
			SCREEN.IgnoreChange True
			SCREEN.Object("OBJ_order.obj_odr.1301").Data = S1301.Data
			SCREEN.IgnoreChange False
			SCREEN.Proc "OBJ_order.obj_odr.ChangeCode", ""
		End If
	End If

	SCREEN.Object("OBJECT0.1301").Data = Trim(S1301.Data)
	OBJECT0.Send

	OBJ_sise.ClearAll 2

	OBJ_sise.Send
	obj_tuja.Send
	OBJ_etc.Send
	obj_stand.Send

	If tab_account.ID = 7 Then
		SCREEN.Proc "OBJ_account.send_main", ""
	End If
End Sub

' 관심종목 창을 닫을때 프로시져 호출
