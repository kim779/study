Sub SetHogaVisible()
	If  OBJ_sise.GetObject = "IB300021" Then
		Sindex = "0"
		If SCREEN.CreateObject("Info") Then
			Sindex = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB300021", "HOGA_INDEX"))
			If Len(Sindex) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB300021", "HOGA_INDEX", "0"
				Sindex = "0"
			End If
		End If
		If SIndex = "0" Then
			bt_Hoga.Text = "10호가"
		Else
			bt_Hoga.Text = "5호가"
		End If
		OBJ_sise.Proc "ProcSetVisible", Sindex
	End If
End Sub

Sub showHogaPanel()
	PANEL1.Visible = False
	hoga_panel.Visible = True
	hoga_up.Visible = True
	hoga_bottom.Visible = True
	hoga_left.Visible = True
	hoga_right.Visible = True

End Sub

Sub hideHogaPanel()
	hoga_panel.Visible = False
	hoga_up.Visible = False
	hoga_bottom.Visible = False
	hoga_left.Visible = False
	hoga_right.Visible = False
	PANEL1.Visible = True
