_AW_ONDECLARE_AW_
Sub OnGroup(group)
	S90303.Clear()
	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If

	If Trim(group) <> "" Then
		If InStr(group, "00") > 0 Then
			SCREEN.SetTimer 4, False
		Else
			codelist = DX_INTEREST.LoadCodeList(group)
			row = 1
			Do While Len(codelist) > 0
				parseData = Mid(codelist, 1, InStr(codelist, vbTab) -1)
				codelist = Mid(codelist, InStr(codelist, vbTab) + 1)
				S90303.InsertRow(-1)
				S90303.SetGridCell S90303.rows, 2, parseData
				row = row + 1
			Loop
			SCREEN.Send 0
		End If

	End If
End Sub




Sub OnPredict(bNowPrice)
	If bNowPrice = "0" Then
		predict = True
	Else
		predict = False
	End If
	S90303.SetColumnVisible 8, predict
	S90303.SetColumnVisible 10, predict
	S90303.SetColumnVisible 12, predict
    S90303.SetColumnVisible 14, predict

	S90303.SetColumnVisible 7, Not predict
	S90303.SetColumnVisible 9, Not predict
	S90303.SetColumnVisible 11, Not predict
    S90303.SetColumnVisible 13, Not predict
End Sub

