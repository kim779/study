'위로
Sub GridRowUp()
	Dim ii, gridRow

	gridRow = GRID0.Row

	'현재 선택된 Row가 빈값이면 하지않음.
	If Trim(GRID0.GetGridCell(gridRow, 2)) = "" Then
		Exit Sub
	End If

	If gridRow > 1 And Trim(GRID0.GetGridCell(gridRow - 1, 2)) <> "" Then
		GRID0.InsertRow(gridRow-2)

		For ii = 1 To GRID0.Columns
			GRID0.SetGridCell gridRow-1, ii, GRID0.GetGridCell(gridRow+1, ii)	'데이터 입력
			GRID0.SetPRgb gridRow-1, ii, GRID0.GetPRgb(gridRow+1, ii)			'색입힘
		Next

		GRID0.RemoveRow(gridRow)

		'기본이 1이기 때문에.
		If gridRow =< 1 Then
			gridRow = 2
		End If

		GRID0.Row = gridRow - 1

		GRID0.SetCellFocus GRID0.Row, 1

	End If

End Sub

'아래로
Sub GirdRowDown()
	Dim ii, gridRow

	gridRow = GRID0.Row

	If Trim(GRID0.GetGridCell(gridRow + 1, 2)) <> "" And gridRow >= 1 Then
		GRID0.InsertRow(gridRow + 1)

		For ii = 1 To GRID0.Columns
			GRID0.SetGridCell gridRow+2, ii, GRID0.GetGridCell(gridRow, ii)	'데이터 입력
			GRID0.SetPRgb gridRow+2, ii, GRID0.GetPRgb(gridRow, ii)			'색입힘
		Next

		GRID0.RemoveRow(gridRow-1)

		'최대 데이터가 있는 Row
		If gridRow >= GetGridRows() Then
			gridRow = GetGridRows() -1
		End If

		GRID0.Row = gridRow + 1

		GRID0.SetCellFocus GRID0.Row, 1

	End If

End Sub

