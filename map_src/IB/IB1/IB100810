' 해당 값의 인덱스 찾기
Function GetComboBoxIndex(hCombo, strItem)
	Dim ii, strTemp

'	SYSTEM.Trace "[" & SCREEN.Object(hCombo).Size & "][인자값][" & Trim(strItem) & "]"

	ii = 0
	strTemp = "Temp"

	strTemp = Trim(SCREEN.Object(hCombo).Text)

	Do While Trim(strTemp) <> ""
		SCREEN.Object(hCombo).Index = ii
		strTemp = Trim(SCREEN.Object(hCombo).Text)

		If Trim(strItem) = Trim(strTemp) Then
			Exit Do
		End If

		ii = ii+1
	Loop

	GetComboBoxIndex = ii

End Function

