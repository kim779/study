'수량부분 체크
Function Check_Suryang()
	Check_Suryang = True

	If gp1_jung.Checked Or gp1_cancel.Checked Then	'정정, 취소일때 미체결량 보임
		If ck_meche.Checked Then
			g_strSuryang = "잔량전부"
		Else
			g_strSuryang = cb_meche.Text & "%"
		End If

		If cb_target.Data = 0 Then
			g_strSuryang = g_strSuryang & "(일괄)"
		Else
			g_strSuryang = g_strSuryang & "(최근)"
		End If

	ElseIf gp4_realtime.Checked Then
		If ck_realtime.Checked Then
			g_strSuryang = "미" & cb_realtime.Text & "%"
		Else
			g_strSuryang = "현" & cb_realtime.Text & "%"
		End If
	ElseIf gp4_user.Checked Then
		If gp4_ipgum.Checked Then	'입력금액기준
			g_strSuryang = Trim(ed_user.Text) & "원(" & cb_user.Text & "%)"
		Else	'증거금율 기준
			g_strSuryang = Trim(ed_user.Text) & "원(증 " & cb_user.Text & "%)"
		End If

	ElseIf gp4_jijung.Checked Then
		If Trim(ed_jijung1.Text) = "" Then
			g_strSuryang = ""
			g_strSuryangMsg = "수량을 입력하세요."
			Check_Suryang = False
			Exit Function
		ElseIf Int(Trim(ed_jijung1.Text)) > 0 And Int(Trim(ed_jijung1.Text)) < 100000000 Then
			g_strSuryang = Trim(ed_jijung1.Text) & "주"
		Else
			g_strSuryang = ""
			g_strSuryangMsg = "수량은 99,999,999 까지 등록 가능합니다."
			ed_jijung1.Data = ""
			Check_Suryang = False
			Exit Function
		End If

	ElseIf gp4_jango.Checked Then
		g_strSuryang = cb_jango.Text & "%"

	End If

End Function

'현재 데이터가 있는 그리드 리턴
