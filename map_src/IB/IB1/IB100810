myFILE = "IB100800.INI"

g_JumunGubn = Array("MEDO", "MESU", "JUNG", "CANCEL")
g_JumunGubnNm = Array("매도", "매수", "정정", "취소")
g_JumunColor = Array(66, 193, 176, 177)
g_JumunMode = "Add" '주문추가(마지막데이터 색변경) :Add, 주문수정(현재선택된 데이터 색변경) :Modi

Dim g_strJumun, g_strJumunGubn, g_strGagyeok, g_strSuryang
Dim g_strGagyeokMsg, g_strSuryangMsg, g_strCountMsg

Sub Ini_Read()

	Dim ii, jj, kk, count, strArray, strArrayDiv, strData, strTemp, Totalcount, sOK

	Totalcount = 0

	If SCREEN.CreateObject("Info") Then
		For ii = 0 To 3
			count = Trim(INFO.popData (LOGIN.Name, myFILE, g_JumunGubn(ii), "Count"))

			If Trim(count) <> "" Then

				For jj = 1 To count
					strData = INFO.popData (LOGIN.Name, myFILE, g_JumunGubn(ii), jj)

					Call SetGridColor(ii+1)

					strArray = Split(strData, "|", -1, 0)

					strTemp = strArray(0)

					GRID0.SetGridCell Totalcount + jj, 1, strTemp
					GRID1.SetGridCell Totalcount + jj, 1, strTemp
					GRID1.SetPRgb Totalcount + jj, 1, GRID0.GetPRgb(Totalcount + jj, 1)			'색입힘

					strTemp = strArray(1)

					strArrayDiv = Split(strTemp, vbTab, -1, 0)
					'2 ~ 5
					For kk = 2 To 5
						GRID0.SetGridCell Totalcount + jj, kk, strArrayDiv(kk-2)
						GRID1.SetGridCell Totalcount + jj, kk, strArrayDiv(kk-2)
						GRID1.SetPRgb Totalcount + jj, kk, GRID0.GetPRgb(Totalcount + jj, kk)			'색입힘

					Next
				Next

				Totalcount = Totalcount + count
			End If ' If Trim(count) <> "" Then

		Next

		sOK = Trim(INFO.popData(LOGIN.name, myFILE, "S-ORD", "ORD_CONF"))

		If Trim(sOK) = "" Then
			sOK = "OK"
		End If

		If sOK = "OK" Then
			CHECK0.Checked = True
		Else
			CHECK0.Checked = False
		End If
	End If

End Sub


Function Ini_Write()

	Ini_Write = True

	Dim medoCount, mesuCount, JungCount, CancleCount	'10개가 넘는지 체크하기위해서.
	Dim strType
	Dim ii, count, strData, strTemp, strGubn

	'파일삭제하기 전에 매도,매수,정정,취소의 체크된 것이 10개가 넘는지 확인한다.
	'10개가 넘으면 그리드가 넘어가기때문에 추가하지 못하도록 한다.

	medoCount = 0
	mesuCount = 0
	JungCount = 0
	CancleCount = 0

	For ii = 1 To GRID0.Rows
		strType = GRID0.GetGridCell(ii, 2)	'매도 매수 정정 취소

		If Trim(strType) = "" Then
			Exit For
		End If

		strTemp = GRID0.GetGridCell(ii, 1)	'체크되었는지

'		SYSTEM.Trace "strTemp[" & strTemp & "]"

		If strTemp = "1" Then
			If Trim(strType) = "매도" Then
				medoCount = Int(medoCount) + 1
			ElseIf Trim(strType) = "매수" Then
				mesuCount = Int(mesuCount) + 1
			ElseIf Trim(strType) = "정정" Then
				JungCount = Int(JungCount) + 1
			ElseIf Trim(strType) = "취소" Then
				CancleCount = Int(CancleCount) + 1
			End If
		End If
	Next

'SYSTEM.Trace "medoCount[" & medoCount & "]" & "mesuCount[" & mesuCount & "]" & "JungCount[" & JungCount & "]" & "CancleCount[" & CancleCount & "]"
	'10개가 넘으면 아래쪽을 타지 않도록 하고 메세지를 설정해준다.
	If medoCount > 10 Then
		g_strCountMsg = "매도주문 설정가능 수량은 최대 10개 입니다.[" & medoCount &"개 선택]"
		Ini_Write = False
		Exit Function
	ElseIf mesuCount > 10 Then
		g_strCountMsg = "매수주문 설정가능 수량은 최대 10개 입니다.[" & mesuCount &"개 선택]"
		Ini_Write = False
		Exit Function
	ElseIf JungCount > 10 Then
		g_strCountMsg = "정정주문 설정가능 수량은 최대 10개 입니다.[" & JungCount &"개 선택]"
		Ini_Write = False
		Exit Function
	ElseIf CancleCount > 10 Then
		g_strCountMsg = "취소주문 설정가능 수량은 최대 10개 입니다.[" & CancleCount &"개 선택]"
		Ini_Write = False
		Exit Function
	End If


	If SCREEN.CreateObject("Info") Then

		'맨처음 파일을 삭제한다.
		Dim delFileName
		delFileName = SYSTEM.Home & "\user\" & LOGIN.Name & "\" & myFILE

		If  SCREEN.CreateObject("DX_FILE") = True Then
			If  DX_FILE.Open("c", delFileName) = True Then
				DX_FILE.Seek(0)
				DX_FILE.Write("")
				DX_FILE.Close()
	         End If
	     End If
		' 파일 삭제 끝

		For ii = 1 To GRID0.Rows
			strTemp = GRID0.GetGridCell(ii, 2)	'매도 매수 정정 취소

			If Trim(strTemp) = "" Then
				Exit For
			End If

			'첫번째 그리드 데이터
			strData = Trim(GRID0.GetGridCell(ii, 1)) & "|" & Trim(GRID0.GetGridCell(ii, 2)) & vbTab & Trim(GRID0.GetGridCell(ii, 3)) & vbTab _
			& Trim(GRID0.GetGridCell(ii, 4)) & vbTab & Trim(GRID0.GetGridCell(ii, 5))

			'툴팁데이터
			strData = strData & "|" & Trim(GRID0.GetGridCell(ii, 2)) & "주문(구분:" & Trim(GRID0.GetGridCell(ii, 3)) & " 단가:" _
			& Trim(GRID0.GetGridCell(ii, 4)) & " 수량:" & Trim(GRID0.GetGridCell(ii, 5)) & ")"

'			SYSTEM.Trace "strData[" & strData & "]"

			strGubn = GetJumunGubn(Trim(GRID0.GetGridCell(ii, 2)))

			count = Trim(INFO.popData (LOGIN.Name, myFILE, strGubn, "Count"))

			If Trim(count) = "" Then
				count = 0
			End If

			INFO.PushData LOGIN.Name, myFILE, strGubn, "Count", Int(count)+1
			INFO.PushData LOGIN.Name, myFILE, strGubn, Int(count)+1, strData

		Next

		If CHECK0.Checked = True Then
			INFO.pushdata LOGIN.name, myFILE, "S-ORD", "ORD_CONF", "OK"
		Else
			INFO.pushdata LOGIN.name, myFILE, "S-ORD", "ORD_CONF", "NO"
		End If

	End If

End Function

Function GetJumunGubn(strData)
	GetJumunGubn = ""
	Dim ii

	For ii = 0 To 3

		If StrComp(strData, g_JumunGubnNm(ii)) = 0 Then
			GetJumunGubn = g_JumunGubn(ii)
			Exit For
		End If

	Next

End Function

