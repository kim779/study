Sub SetHogaVisible()
	If  OBJ_sise.GetObject = "IB100110" Then
		Sindex = "0"
		If SCREEN.CreateObject("Info") Then
			Sindex = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB100110", "HOGA_INDEX"))
			If Len(Sindex) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB100110", "HOGA_INDEX", "0"
				Sindex = "0"
			End If
		End If
		If SIndex = "0" Then
			bt_Hoga.Text = "10호가"
		Else
			bt_Hoga.Text = "5호가"
		End If
		OBJ_sise.Proc "ProcSetVisible", Sindex
	End If
End Sub

Sub Set_prc(data)
	If Trim(data) = "" Then
		Exit Sub
	End If

	If SCREEN.Object("OBJ_order.tab_order").id <> 3 Then
		If SCREEN.Object("OBJ_order.obj_odr.CHK_auto").checked = False Then
			SCREEN.Object("OBJ_order.obj_odr.ed_jprc").data = data
		End If
	End If
End Sub

