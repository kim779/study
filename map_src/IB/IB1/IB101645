RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB101645"

Sub p_read_ini()
If SCREEN.CreateObject("Info") Then
 	CHK.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "G_CHCK"))
End If
End Sub


Sub p_write_ini()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "G_CHCK", CHK.text
End If
End Sub

_AW_ONSTART_AW_
p_read_ini()

If CHK.text = "1" Then
	CHK.text = "1"
	OBJ01.SetObject "IB101647"
	B_GUBN.Text = "데이터"
	LB_board.Visible = False
	BUTTON0.Visible = False
Else
	CHK.text = "2"
	OBJ01.SetObject "IB101646"
	B_GUBN.Text = "차 트"
	LB_board.Visible = True
	BUTTON0.Visible = True

End If
	OBJ01.Send

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(r0)
