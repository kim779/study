_AW_ONDECLARE_AW_
Sub send_sise_all(xval)
	'SYSTEM.Trace "send_sise_all="&xval
End Sub

Sub code_change(xval)
	'SYSTEM.Trace "code_change="&xval&" 1301=["&Trim(S1301.Data)&"]"
	Dim codx
	codx = Trim(S1301.Data)
	If codx = "" Or Len(codx) <> 6 Then
		Exit Sub
	End If
	obj_sise.Send
	obj_order.Send

	'자동단가 전송
'	SCREEN.Object("obj_danga.1301").Data = Trim(S1301.Data)
'	obj_danga.Send

	'우측 1번탭 전송 (뉴스탭만 전송)
	If rtab1.ID = 6 Then
		obj_rtab1.Send
	End If

	'우측 2번탭 전송 (잔고탭제외)7
	If rtab2.ID <> 2 And rtab2.ID <> 3 Then
		If rtab2.ID = 0 Then
			obj_rtab2.Proc "send_f", ""
		Else
			obj_rtab2.Send
		End If
	End If
End Sub

Sub move_siseobj(param)
	If param = 1 Then
		obj_sise.SetRect 5, 31, 399, 481
		obj_ltab1.SetRect 1005, 1031, 1399, 1481
		obj_sise.Visible = True
		obj_ltab1.Visible = False
		obj_sise.Proc "Redraw", ""
	Else
		obj_sise.SetRect 1005, 1031, 1399, 1481
		obj_ltab1.SetRect 5, 31, 399, 481
		obj_sise.Visible = False
		obj_ltab1.Visible = True
	End If
End Sub

' 관심종목 창을 닫을때 프로시져 호출
Sub CloseIB202201()
	If rtab1.ID = 7 Then
		obj_rtab1.Proc "OnPortfolio", "start"
		obj_rtab1.Send
	End If
End Sub

Sub ch_order_tab(valx)
	SCREEN.Object("OBJ_order.tab_order").ID = valx
	SCREEN.Proc "OBJ_order.order_tab_change", ""
End Sub

Sub all_account()
	If rtab2.ID = 2 Then
		obj_rtab2.Proc "main_sended", ""
	ElseIf rtab2.ID = 3 Then
		obj_rtab2.Send
	End If
End Sub

