RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"
Call Check_LoginType(zPwd)		'직원/고객에 따른 비밀번호 컨트롤 설정

Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
End If

If CheckInput(zAcntNo, zPwd) = True Then
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim ii, tmpMmgb

	For ii = 1 To GRID0.Rows
		tmpMmgb = Trim(GRID0.GetGridCell(ii, 14))
		GRID0.SetGridCell ii, 14, tmpMmgb

		If tmpMmgb = "매도" Then
			GRID0.SetTRgb ii, 14, "095"
		End If
	Next

	send_btn.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONDBLCLK_AW_
SYSTEM.Push "jmnum", GRID0.GetGridCell(GRID0.Row, 3)
SYSTEM.Push "jcode", GRID0.GetGridCell(GRID0.Row, 5)
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zOrdDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



