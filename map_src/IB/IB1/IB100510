			Exit Sub
		End If

		imok_jo = SCREEN.Object("main.com_imok").Data & ":" & Trim(SCREEN.Object("main.ed_imok").Data)
		Log_data = Log_data & "[감시이익 : " & 	Int(SCREEN.Object("main.ed_imok").Data) & SCREEN.Object("main.com_imok").Text & "]"

