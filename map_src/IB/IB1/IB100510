		End If

		If  CLng(Trim(SCREEN.Object("main.ed_mae").Data)) > CLng(ibo_ga) Then
			MsgBox "이익목표금액은 매입단가보다 낮게 설정할 수 없습니다.", ,"IBK투자증권"
			Exit Sub
		End If

		If  CLng(ibo_ga) < CLng(choi_ga) Then
			MsgBox "하락가격이 최고가설정액보다 작거나 같아야 합니다.", ,"IBK투자증권"
			Exit Sub
		End If


		ibo_jo = SCREEN.Object("main.com_ibo").Data & ":" & Trim(SCREEN.Object("main.ed_ibo").Data)
		choi_jo = SCREEN.Object("main.com_choi").Data & ":" & Trim(SCREEN.Object("main.ed_choi").Data)
		Log_data = Log_data & "[감시보전 : " & 	Int(SCREEN.Object("main.ed_ibo").Data) & SCREEN.Object("main.com_ibo").Text & " / " & Int(SCREEN.Object("main.ed_choi").Data) & SCREEN.Object("main.com_smok").Text & "]"

	End If

	condition =  smok_ga & ":" & imok_ga & ":" & ibo_ga & ":" & choi_ga

	CONTROL1.SetCondition SCREEN.Object("main.ed_sygb").Data, SCREEN.Object("main.ed_date").Data, SCREEN.Object("main.j_num").Data, Trim(condition)


'	S90303.SetGridCell row_t, 18, SCREEN.Object("main.j_num").Data				'RTS 코드
	S90303.SetGridCell row_t, 17, SCREEN.Object("main.j_num").Data				'종목코드
	S90303.SetGridCell row_t, 1, SCREEN.Object("main.j_nam").Data				'종목명
	S90303.SetGridCell row_t, 2, SCREEN.Object("main.ed_juga").Data				'주문가능수량
    S90303.SetGridCell row_t, 3, Trim(SCREEN.Object("main.ed_mae").Data)		'매입단가

	S90303.SetGridCell row_t, 4, smok_ga										'손실목표
	S90303.SetGridCell row_t, 5, imok_ga										'이익목표

	If ibo_ga = "0" Then
		ibo_ga = ""
	End If
	S90303.SetGridCell row_t, 6, ibo_ga											'이익보전

	S90303.SetGridCell row_t, 7, ""
	S90303.SetGridCell row_t, 8, ""
	S90303.SetGridCell row_t, 9, ""
	S90303.SetGridCell row_t, 10, ""

	S90303.SetGridCell row_t, 11, SCREEN.Object("main.ed_sygb").Data			'신용구분

	S90303.SetGridCell row_t, 12, SCREEN.Object("main.ed_date").Data			'대출일

	If Trim(SCREEN.Object("main.order_gubn").Data) <> "" Then
		S90303.SetGridCell row_t, 13, Trim(SCREEN.Object("main.order_gubn").Data)	'
	Else
		S90303.SetGridCell row_t, 13, "00"										'호가구분
	End If


	If Trim(SCREEN.Object("main.order_gubn").Data) = "00" Then
		Log_data = Log_data & "[주문 : 지정가 "
	ElseIf Trim(SCREEN.Object("main.order_gubn").Data) = "03" Then
		Log_data = Log_data & "[주문 : 시장가 "
	ElseIf Trim(SCREEN.Object("main.order_gubn").Data) = "05" Then
		Log_data = Log_data & "[주문 : 조건부 "
	ElseIf Trim(SCREEN.Object("main.order_gubn").Data) = "06" Then
		Log_data = Log_data & "[주문 : 최유리 "
	End If


	Log_data = Log_data & Int(Trim(SCREEN.Object("main.ed_su").Data)) & SCREEN.Object("main.com_su").Text & "   "

	S90303.SetGridCell row_t, 14, Trim(SCREEN.Object("main.com_dan").Data)		'단가구분

	If Trim(SCREEN.Object("main.com_dan").Data) = "9" Then
		S90303.SetGridCell row_t, 27, Trim(SCREEN.Object("main.ed_dan").Data)		'직접입력
	Else
		S90303.SetGridCell row_t, 15, Trim(SCREEN.Object("main.ed_dan").Data)		'단가틱
	End If

	If Trim(SCREEN.Object("main.order_gubn").Data) = "00" Or Trim(SCREEN.Object("main.order_gubn").Data) = "05" Then
		Log_data = Log_data & SCREEN.Object("main.com_dan").Text &  Int(Trim(SCREEN.Object("main.ed_dan").Data))

		If SCREEN.Object("main.com_dan").Data = 9 Then
			Log_data = Log_data & " 원 ];"
		Else
			Log_data = Log_data & " 틱 ];"
		End If
	Else
		Log_data = Log_data & " ];"
	End If

	S90303.SetGridCell row_t, 16, jqty										'주문수량
	S90303.SetGridCell row_t, 28, Trim(SCREEN.Object("main.AN1A").Data)		'계좌번호

	S90303.SetGridCell row_t, 29, smok_jo
	S90303.SetGridCell row_t, 30, imok_jo
	S90303.SetGridCell row_t, 31, ibo_jo
	S90303.SetGridCell row_t, 32, choi_jo
	S90303.SetGridCell row_t, 33, su_jo

	If flag = 1 Then
		rows.Data = row_t
		SCREEN.Object("main.GUIDE1").text = Trim(SCREEN.Object("main.j_nam").Data) & "[" &SCREEN.Object("main.j_num").Data & "]" & " 감시설정 등록이 완료 되었습니다. 감시시작 버튼을 눌러주세요."
	Else
		SCREEN.Object("main.GUIDE1").text = Trim(SCREEN.Object("main.j_nam").Data) & "[" &SCREEN.Object("main.j_num").Data & "]" & " 감시설정 수정이 완료 되었습니다. 감시시작 버튼을 눌러주세요."
	End If

	Log_data = Log_data & SCREEN.Object("main.j_num").Data & ";" & Trim(SCREEN.Object("main.j_nam").Data)
	Write_Log(Log_data)




	SCREEN.Send 0
