Sub Cancel_StopLoss()
	row_t = 0
	For ii = 1 To rows.Data
		name = S90303.GetGridCell(ii, 1)
		gubn = S90303.GetGridCell(ii, 11)
		dat = S90303.GetGridCell(ii, 12)

		'MsgBox Trim(name) & " " & Trim(SCREEN.Object("main.j_nam").Data) & "|" & Trim(gubn) & " " & Trim(ed_sygb.Data)

		If Trim(name) = Trim(SCREEN.Object("main.j_nam").Data) And Trim(gubn) = Trim(SCREEN.Object("main.ed_sygb").Data) And  Trim(dat) = Trim(SCREEN.Object("main.ed_date").Data) Then
			row_t = ii
			Exit For
		End If
	Next

	If row_t = "0" Then
		MsgBox "해당종목은 조건이 없습니다.",  ,"IBK투자증권"
		Exit Sub
	End If

	For ii=row_t To rows.Data
		For jj = 1 To 33
			S90303.SetGridCell ii, jj, Trim(S90303.GetGridCell(ii+1, jj))
		Next
	Next

	For ii= 1 To 33
		S90303.SetGridCell rows.Data, ii, ""
	Next

	rows.Data = rows.Data - 1

'	CONTROL1.DelCondition Trim(SCREEN.Object("main.ed_sygb").Data), Trim(SCREEN.Object("main.j_num").Data)  'vc2019
	CONTROL1.DelCondition Trim(SCREEN.Object("main.ed_sygb").Data), SCREEN.Object("main.ed_date").Data, Trim(SCREEN.Object("main.j_num").Data)
	
	SCREEN.Object("main.GUIDE1").text = Trim(SCREEN.Object("main.j_nam").Data) & "[" &SCREEN.Object("main.j_num").Data & "]" & " 감시설정이 해제 되었습니다."

	Log_data = "설정해제;;"

	Log_data = Log_data & SCREEN.Object("main.j_num").Data & ";" & Trim(SCREEN.Object("main.j_nam").Data)
	Write_Log(Log_data)
	SCREEN.Send 0
End Sub

Sub Start_StopLoss()
	CONTROL1.Start(True)
	SCREEN.Object("main.GUIDE1").text =  "감시가 시작되었습니다."
End Sub

Sub Stop_StopLoss()
	CONTROL1.Start(False)
	SCREEN.Object("main.GUIDE1").text =  "감시가 중지되었습니다."
End Sub

Sub Order_stop(data)

	Dim hogb, cPos, dmsg
	Dim array
	Dim gubn, hnam, typ, hogb_t, dte, max, diff
	Dim jqty, jprc_t, jprc
	Dim dagb, dtick, key
	Dim Log_data

	array = Split(data, ":")

	key = Trim(array(0))
	code = Trim(array(1))
	gubn = Trim(array(2))
	hnam = Trim(array(3))
	curr = Trim(array(4))
	dte = Trim(array(5))
	typ = Trim(array(6))
	max = Trim(array(7))
	diff = Trim(array(8))

	SYSTEM.Trace "ORDER_STOP"

	hnam = Replace(hnam, "/","／")
	'MsgBox key&"|"&code&"|"&gubn&"|"&hnam&"|"&curr&"|"&dte

	If key <> Trim(CONTROL1.GetMapHandle()) Then
		Exit Sub
	End If

	For ii=1 To rows.Data
		If Trim(code) = Trim(S90303.GetGridCell(ii, 17)) And Right(Trim(gubn),2) = Trim(S90303.GetGridCell(ii, 11)) And dte = Trim(S90303.GetGridCell(ii, 12)) Then
			hogb_t = Trim(S90303.GetGridCell(ii, 13))
			dagb =  Trim(S90303.GetGridCell(ii, 14))
			dtick = Trim(S90303.GetGridCell(ii, 15))
			jqty = Trim(S90303.GetGridCell(ii, 16))				'주문수량
			'jprc = Trim(S90303.GetGridCell(ii, 14))
			Exit For
		End If
	Next

	'MsgBox "ii="&ii

	If dagb = "1" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 19)))
	ElseIf dagb = "2" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 20)))
	ElseIf dagb = "3" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 21)))
	ElseIf dagb = "4" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 22)))
	ElseIf dagb = "5" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 23)))
	ElseIf dagb = "6" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 24)))
	ElseIf dagb = "7" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 25)))
	ElseIf dagb = "8" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 26)))
	ElseIf dagb = "9" Then
		jprc_t = Abs(Trim(S90303.GetGridCell(ii, 27)))
	End If

	'MsgBox jprc_t

	If dagb = "9" Then								'주문가
		If hogb_t = "03" Or hogb_t = "06" Then
			jprc = ""
		Else
			jprc = jprc_t
		End If
	Else
		If hogb_t = "03" Or hogb_t = "06" Then
			jprc = ""
		Else
			jprc = CONTROL1.GetTickPrice(jprc_t, dtick, code, 1)
		End If
	End If

	If hogb_t = "00" Then						'호가구분
		hogb = "보통"
	ElseIf hogb_t = "03" Then
		hogb = "시장가"
	ElseIf hogb_t = "05" Then
		hogb = "조건부"
	ElseIf hogb_t = "06" Then
		hogb = "최유리"
	Else
		hogb = "보통"
	End If


	S90303.SetGridCell ii, 7, jprc
	S90303.SetGridCell ii, 8, jqty

	If typ = 0 Then
		S90303.SetGridCell ii, 10, "S"
		Log_data = "손실조건도달;"
		Log_data = Log_data & "(현재가)" & curr & " <= " & Trim(S90303.GetGridCell(ii, 4)) & "(설정액)"
	ElseIf typ = 1 Then
		S90303.SetGridCell ii, 10, "M"
		Log_data = "이익조건도달;"
		Log_data = Log_data & "(현재가)" & curr & " >= " & Trim(S90303.GetGridCell(ii, 5)) & "(설정액)"
	ElseIf typ = 2 Then
		S90303.SetGridCell ii, 10, "T"
		Log_data = "이익보존도달;"
		Log_data = Log_data & "(현재가)" & curr & " <= " & "(고점:" & max & "-" & "고점대비하락액:" & diff &")"
	End If

	Log_data = Log_data & ";" & code & ";" & hnam

	'MsgBox Log_data

	Write_Log(Log_data)

	If SCREEN.Object("main.ck_auto").Checked = True Then
		dmsg = "o_acno" & vbTab & SCREEN.Object("main.AN1A").Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("main.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & hnam & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & jqty & vbLf &_
			"o_jprc" & vbTab & jprc & vbLf

		If Trim(S90303.GetGridCell(ii, 11)) = "00" Then
			SCREEN.CreateWindow 2, "IB10015A /p5 /d", dmsg
			Log_data = "주문접수;"
		ElseIf Trim(S90303.GetGridCell(ii, 11)) = "03" Then
			dmsg = dmsg & "o_sygb" & vbTab & "자기융자상환" & vbLf
			SCREEN.CreateWindow 2, "IB10015B /p5 /d", dmsg
			Log_data = "신용접수;"
		ElseIf  Trim(S90303.GetGridCell(ii, 11)) = "80" Then
			dmsg = dmsg & "o_sygb" & vbTab & "예탁담보대출상환" & vbLf
			SCREEN.CreateWindow 2, "IB10215B /p5 /d", dmsg
			Log_data = "신용접수;"
		ElseIf  Trim(S90303.GetGridCell(ii, 11)) = "01" Then
			dmsg = dmsg & "o_sygb" & vbTab & "유통융자상환" & vbLf
			SCREEN.CreateWindow 2, "IB10215B /p5 /d", dmsg
			Log_data = "신용접수;"
		End If

		If SYSTEM.Pop("stock_mado_order") <> "OK" Then
			'flash_fg.Data = 0
			Log_data = "주문취소;" & "반자동주문취소" & ";" & code & ";" & hnam
			Write_Log(Log_data)
			Exit Sub
		End If
	Else
		If Trim(S90303.GetGridCell(ii, 11)) = "00" Then
			Log_data = "주문접수;"
		ElseIf Trim(S90303.GetGridCell(ii, 11)) = "03" Then
			Log_data = "신용접수;"
		ElseIf  Trim(S90303.GetGridCell(ii, 11)) = "80" Then
			Log_data = "신용접수;"
		ElseIf  Trim(S90303.GetGridCell(ii, 11)) = "01" Then
			Log_data = "신용접수;"
		End If
	End If



	ed_odgb.Data = 1										'매매구분
	ed_acno.Data = Trim(S90303.GetGridCell(ii, 28))			'계좌번호
	ed_pswd.Data = Trim(SCREEN.Object("main.pswd2").Data)	'비밀번호
	ed_ogno.Data = ""
	ed_code.Data = code
	ed_jqty.Data = jqty									'주문수량
	ed_jprc.Data = jprc									'주문가
	ed_hogb.Data = hogb_t								'호가구분
	ed_hnam.Data = hnam

	If Trim(S90303.GetGridCell(ii, 11)) <> "00" Then
		ed_gmo.Data = gubn & dte						'신용주문
		ed_prgb.Data = "B"
	Else
		ed_gmo.Data = ""						'신용주문
		ed_prgb.Data = "X"
	End If
	OBJ_snd.Send
	row = ii


	Log_data = Log_data & "[계좌" & ed_acno.Data & "]" & " 주문단가:" & ed_jprc.Data & " 주문수량:" & ed_jqty.Data & " 호가구분:" & ed_hogb.Data
	Log_data = Log_data & ";" & Trim(ed_code.Data) & ";" & Trim(ed_hnam.Data)
	'MsgBox Log_data
	Write_Log(Log_data)

End Sub

Sub Set_jmno()
Dim	Log_data
	'MsgBox o_jmno.Data
	If Trim(o_jmno.Data) <> "" Then
		S90303.SetGridCell row, 9, Trim(o_jmno.Data)
	Else
		S90303.SetGridCell row, 9, "미실행"
	End If

	Log_data = "주문접수수신;" & SCREEN.Object("main.GUIDE1").text & ";" & Trim(S90303.GetGridCell(row, 17)) & ";" & Trim(S90303.GetGridCell(row, 1))
	Write_Log(Log_data)
	If Trim(o_jmno.Data) = "" Then
		Exit Sub
	Else
		SCREEN.SetTimer 10, False
	End If
End Sub

Sub Set_log()
Dim Log_data
	If Trim(S90303.GetGridCell(row, 11)) = "80" Then
		Log_data = "대출상환접수;" & "매도주문#:" & Trim(o_jmno.Data) & " 수량:" & Trim(S90303.GetGridCell(row, 16)) & ";" & Trim(S90303.GetGridCell(row, 17)) & ";" & Trim(S90303.GetGridCell(row, 1))
		Write_Log(Log_data)
	End If
End Sub


Sub ClearGrid()
	CONTROL1.Reset()
	S90303.Clear
	rows.Data = 0
End Sub

Sub Write_Log(logdata)
Dim array, typ, slog, code, name
	'MsgBox logdata
	array = Split(logdata, ";")
	typ = array(0)
	slog = array(1)
	code = array(2)
	name = array(3)

	CONTROL1.WriteLog typ, slog, code, name
End Sub

