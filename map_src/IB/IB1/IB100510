			End If
			ibo_ga = CONTROL1.GetPriceSetupValue(SCREEN.Object("main.j_num").Data, Trim(SCREEN.Object("main.ed_mae").Data), SCREEN.Object("main.com_ibo").Data, 2, SCREEN.Object("main.ed_ibo").Data)
		End If

