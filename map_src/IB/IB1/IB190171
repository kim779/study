Sub AddJumun(str)

	'MsgBox "["&str&"]"
	Dim no, msg
	no = Mid(str,1,10)
	msg = Mid(str,11,Len(str)-11)
	GRID1.InsertRow GRID1.Rows
	GRID1.SetGridCell GRID1.Rows, 1, no
	GRID1.SetGridCell GRID1.Rows, 2, msg
	SCREEN.Send 0
End Sub

Sub EndJumun()
	Dim ii, val, chk, Total, ival
	If GRID1.Rows > 0 Then
		Total = SCREEN.Object("main.OBJ_ODR.OBJ_FUNDACC.Grid0").rows

		ival = 1
		If Total > 0 Then
			For ii=1 To Total
				chk = SCREEN.Object("main.OBJ_ODR.OBJ_FUNDACC.Grid0").GetGridCell(ii, 22)
				If chk = 1 Then
					Call SCREEN.Object("main.OBJ_ODR.OBJ_FUNDACC.Grid0").SetGridCell(ii, 26, GRID1.GetGridCell(ival, 1))
					Call SCREEN.Object("main.OBJ_ODR.OBJ_FUNDACC.Grid0").SetGridCell(ii, 23, GRID1.GetGridCell(ival, 2))
					ival = ival + 1
				End If
			Next
		End If

		SCREEN.Object("main.OBJ_ODR.o_jmno").data = SCREEN.Object("Object0.OFundOrdNo").data
		SCREEN.Proc "main.OBJ_ODR.AfterOrder", ""
	End If
End Sub

Function GetState(val)
	Dim ss, ret
	ss = CStr(CLng(val))
	Select Case ss
		Case "0"
			ret = "정상"
		Case "6"
