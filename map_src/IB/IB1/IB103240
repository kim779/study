Function add_comma(as_val)
      Dim i, mok, div, size, str

      size = Len(as_val)

      If  as_val = "" Or size <= 3 Then
         add_comma = as_val
      End If

      div = size / 3
      mok = size Mod 3
      str = Mid(as_val, 1, mok )

      For i = 0 To div-1
         If  i = 0 And  mok = 0 Then
            str = Mid(as_val,  mok + 1, mok + 3 )
         Else
            str = str & "," & Mid(as_val, (i * 3) + mok + 1,  3 )
         End If
      Next
      add_comma = str
End Function

