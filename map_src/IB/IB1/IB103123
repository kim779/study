	i_djcode.Data = "A"&startCod.Data

	If SCREEN.GetCodeType(i_djcode.Data) = 9 Then
		i_djcode.Data = "J"&startCod.Data
	ElseIf SCREEN.GetCodeType(i_djcode.Data) = 27 Then
		i_djcode.Data = "Q"&startCod.Data
	Else
		i_djcode.Data = "A"&startCod.Data
	End If
End If


	'시장구분 0:전체 1:코스피 2:코스닥 3:코넥스
zIsuMktTp.Data = "0"
If r1.Checked Then	'전체
	zIsuMktTp.Data = "0"
ElseIf r2.Checked Then '코스피
	zIsuMktTp.Data = "1"
ElseIf r3.Checked Then '코스닥
	zIsuMktTp.Data = "2"
ElseIf r4.Checked Then '코넥스
	zIsuMktTp.Data = "3"
