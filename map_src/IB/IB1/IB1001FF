RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_tr(acno, pwd, mmgb, cod2, pric, flag, zdate)
	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub SetAvailQty()
	If SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jqty").Enable = True Then
		SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jqty").Data = Trim(OrdAbleQty.Data)
	End If
	
	If SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jprc").Enable = True Then
		SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jprc").Data = Trim(dOrdPrc.Data)
	End If
	SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jqty").SetFocus

	If SCREEN.GetMapName(1) = "IB100100" Or SCREEN.GetMapName(1) = "IB100200" Or SCREEN.GetMapName(1) = "IB800000" Or SCREEN.GetMapName(1) = "IB000100" Then
		If SCREEN.Object("main.tab_ordtyp").ID = "0" Or SCREEN.Object("main.tab_ordtyp").ID = "4" Then
			If SCREEN.Object("main.OBJ_order.tab_order").ID = 1 Then
				SCREEN.Object("main.OBJ_order.OBJ_odr.ed_date").Data = SCREEN.Object("parent.syDate").Data
			End If
		End If
	Else
		If SCREEN.Object("main.OBJ_order.tab_order").ID = 1 Then
			SCREEN.Object("main.OBJ_order.OBJ_odr.ed_date").Data = SCREEN.Object("parent.syDate").Data
		End If
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("main.GUIDE").Text = ""

Dim mmgb

AN1A.Data = Trim(SCREEN.Object("main.OBJ_order.AN1A").Data)

If Len(Trim(AN1A.Data)) <> 11 Then
	Call guide_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("main.OBJ_order.AN1A").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
Else
	zPwd.Data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)

	If Len(Trim(zPwd.Data)) < 4 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하여 주십시오."
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Sub
	End If
End If


mmgb = SCREEN.Object("parent.com_mmgb").Data
zBnsTp.Data = mmgb

If zBnsTp.Data = "1" Then 				'매도
	LoanDt.Data = SCREEN.Object("parent.syDate").Data
Else									'매수
	LoanDt.Data = getCurrDay()
End If

zIsuNo.Data = Trim(SCREEN.Object("main.1301").Data)

If Len(Trim(zIsuNo.Data)) < 6 Then
	SCREEN.Object("main.GUIDE").Text = "종목번호를 확인하여 주십시오."
	SCREEN.Object("main.OBJ_order.OBJ_odr.1301").SetFocus
	Exit Sub
End If

If SCREEN.GetCodeType(zIsuNo.Data) = "9" Then
	zIsuNo_A.Data = "J"
ElseIf SCREEN.GetCodeType(zIsuNo.Data) = "27" Then
	zIsuNo_A.Data = "Q"
Else
	zIsuNo_A.Data = "A"
End If

dOrdPrc.Data = Trim(SCREEN.Object("parent.ed_jprc").Data)

LEDGER.Svcd = "SONAQ222"


SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(OrdAbleQty)
_AW_ONCLICK_AW_
Call SetAvailQty()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(OrdAbleAmt)
_AW_ENDSCRIPT_AW_


}



