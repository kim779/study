'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg, smarket 
	Dim sHnam

	SYSTEM.Push "stock_mado_order", ""
	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	sHnam = Replace(Mid(SCREEN.Object("OBJ_hnam.1022").Data,2), "/","／")
	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(shogb.Text, 4)		'매매구분
		smarket = "KRX"

		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & sHnam & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_market" & vbTab & smarket & vbLf &_
			"o_jprc" & vbTab & ed_jprc.Data & vbLf
		If Not ed_date.Visible Then
			SCREEN.CreateWindow 2, "IB10015A /p5 /d", dmsg
		Else
			dmsg = dmsg & "o_sygb" & vbTab & c_sygb.Text & vbLf
			SCREEN.CreateWindow 2, "IB10015B /p5 /d", dmsg
		End If
		If SYSTEM.Pop("stock_mado_order") <> "OK" Then
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

	cPos = OrdCfg.ReadCfg("CursorPos")
	Select Case cPos
		Case "0" : SCREEN.Object("parent.AN1A").SetFocus()
		Case "1" : SCREEN.Object("parent.ed_pswd").SetFocus()
		Case "2" : S1301.SetFocus()
		Case "3" : ed_jqty.SetFocus()
		Case "4" : ed_jprc.SetFocus()
	End Select
End Sub

Sub SetFirstData()
	Dim Nextmon, Nextday


	'
	'ed_sdat.Data = syear & smon & sday

	Nextday = change_indate("d", 1, Date)
	Nextmon = change_indate("d", 1, Date)

	ed_sdat.Data = Nextday
	ed_edat.Data = Nextmon

End Sub

