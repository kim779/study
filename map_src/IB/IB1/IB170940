_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(LEDGER.Ecod) = "3669" Then
	SCREEN.ClearAll 2, 2
	ACNM.Data = Trim(AN12.Name)
	zPwd.Clear
	zPwd.SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	Call send_c()

Else
	SCREEN.Proc "obj.send_f", ""

	If GRID0.Rows > 0 Then
		Dim ii, dat
		For ii=1 To GRID0.Rows
			If Trim(GRID0.GetGridCell(ii, 8)) <> "" Then

				dat = CDbl(GRID0.GetGridCell(ii, 8)) * 100.0

				GRID0.SetGridCell ii, 8, FormatNumber(dat, 2)
			End If
		Next
	End If

	If Trim(lDpsCrbalAmt.Data) = "" Then
		If Trim(lPsnOutAbleAmt.Data) = "" Then
			OutAbleAmt.Data = 0
		Else
			OutAbleAmt.Data = Trim(lPsnOutAbleAmt.Data)
		End If
	Else
		If Trim(lPsnOutAbleAmt.Data) = "" Then
			OutAbleAmt.Data = Trim(lDpsCrbalAmt.Data)
		Else
			OutAbleAmt.Data = CDbl(lDpsCrbalAmt.Data) + CDbl(lPsnOutAbleAmt.Data)
		End If
	End If
End If

