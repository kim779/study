_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj.ClearAll 2

	Dim tmpAccn, tmpAcnm
	tmpAccn = Trim(SYSTEM.Pop("1709_accn"))

	If Len(tmpAccn) <> 11 Then
		domino_acnm.Text = ""

		If Len(Trim(AN12.Data)) = 11 Then
			ACNM.Data = Trim(AN12.Name)
			zPwd.Data = Trim(AN12.Password)
		Else
			SCREEN.ClearAll 0, 2
			obj.ClearAll 2

			AN12.SetFocus
			Exit Sub
		End If
	Else
		tmpAcnm = Trim(SYSTEM.Pop("1709_name"))

		AN12.Data = tmpAccn
		ACNM.Data = tmpAcnm
		domino_acnm.Text = tmpAcnm

		SYSTEM.Push "1709_accn", ""
		SYSTEM.Push "1709_acnm", ""
	End If

	If SYSTEM.ConnectBy = 1 And Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	obj.ClearAll 2

	If domino_acnm.Text = "" Then
		ACNM.Data = Trim(AN12.Name)
	Else
		ACNM.Data = Trim(domino_acnm.Text)
	End If

	LEDGER.Fkey = "C"

'	If SYSTEM.ConnectBy Then
'		zCommdaCode.Data = "00"
'	Else
'		zCommdaCode.Data = "01"
'	End If

	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

