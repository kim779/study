SCREEN.OnSend = False

Dim mapNm
mapNm = Trim(SCREEN.GetMapName(1))

Select Case mapNm
	Case "IB110700"
		IntaccNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

		If Len(Trim(IntaccNo.Data)) <> 11 Then
			Call alert_msg("계좌번호를 확인하여 주십시오.")
			SCREEN.Object("parent.AN1A").SetFocus
			Exit Sub
		End If

		Pwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

		Dim sel
		sel = Trim(SCREEN.Object("parent.sel").Text)

		If Is_numeric(sel) = False Then
			sel = "1"
		End If

		If Len(Trim(Pwd.Data)) < 4 Then
			If CLng(sel) > 10 Then
				Call alert_msg("비밀번호를 확인하여 주십시오.")
			Else
				Call guide_msg("비밀번호를 확인하여 주십시오.")
			End If

			SCREEN.Object("parent.zPwd").SetFocus
			Exit Sub
		End If
	Case "IB622400"
		IntaccNo.Data = Trim(SCREEN.Object("parent.AN15").Data)

		If Len(Trim(IntaccNo.Data)) <> 11 Then
			Call alert_msg("신탁계좌번호(ex.xxx-70-xxxxxx)를 확인하여 주십시오.")
			SCREEN.Object("parent.AN15").SetFocus
			Exit Sub
		End If

		Pwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

		If Len(Trim(Pwd.Data)) < 4 Then
			Call guide_msg("비밀번호를 확인하여 주십시오.")
			SCREEN.Object("parent.zPwd").SetFocus
			Exit Sub
		End If
	Case "IB150400", "IB840200", "IB872500"
		IntaccNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

		If Len(Trim(IntaccNo.Data)) <> 11 Then
			Call alert_msg("계좌번호를 확인하여 주십시오.")
			SCREEN.Object("parent.AN1A").SetFocus
			Exit Sub
		End If

		Pwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

		If Len(Trim(Pwd.Data)) < 4 Then
			Call guide_msg("비밀번호를 확인하여 주십시오.")
			SCREEN.Object("parent.zPwd").SetFocus
			Exit Sub
		End If
End Select

If SYSTEM.UserPass <> Trim(Pwd.Data) Then

	If Trim(Pwd.Data) <> "HEAD" And Len(Trim(Pwd.Data)) >= 4 Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(Pwd.Data))
		Pwd.Data = "HEAD"
	ElseIf Trim(Pwd.Data) = "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = Trim(SCREEN.Object("parent.LEDGER").EPwd)
		Pwd.Data = "HEAD"
	End If
	
	If Trim(Pwd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			SCREEN.Object("parent.zPwd").Data = ""
			SCREEN.Object("parent.zPwd").SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If

End If


