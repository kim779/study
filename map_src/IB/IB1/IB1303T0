_AW_ONDECLARE_AW_
Sub SetInitCustomer()
	Dim iCustomerType
	iCustomerType = SYSTEM.ConnectBy
	SCREEN.Object("obj_Buf.edt_Customer").Data = iCustomerType
	If iCustomerType <> "1" Then '고객
		zPwd.Enable = False
		If Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If
	End If

	If SCREEN.Object("obj_Buf.edt_sndCnt").Data = 0 Then
		Call send_f()
	End If

End Sub


Sub SetPassword(sData)
	Dim Ifind, sAcc, sPass
	ifind = InStr(sData, "-")
	sAcc = Trim( Left(sData, Ifind-1) )
	sPass = Trim( Mid(sData, Ifind+1, Len(sData)- Ifind) )
	If Trim(AN1A.Data) = sAcc Then
		zPwd.data = sPass
		If Trim( SCREEN.Object("obj_Buf.edt_sndCnt").Data) = "0" Then
			Call send_f()
		End If
	End If
End Sub





'== 계좌명, 비밀번호 설정
Sub Set_account()

	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy <> "1" Then '고객
		zPwd.Data = "9999"
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	If Trim( SCREEN.Object("obj_Buf.edt_MapNo").Data) = "" Then
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	If  Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy <> "1" Then '고객
		zPwd.Data = "9999"
	End If

	If  Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
