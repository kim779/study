RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim rows

_AW_ONSTART_AW_
b_next.Enable = False
rows = 0
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim array

If rows = 0 Then
	GRID0.InsertRow(-1)
End If

For ii = 1 To GRID1.Rows
	'SYSTEM.Trace GRID1.GetGridCell(ii, 1)
	rows = rows + 1
	array = Split(GRID1.GetGridCell(ii, 1), ";")
	GRID0.SetGridCell rows, 1, array(0)
	GRID0.SetGridCell rows, 2, array(1)
	GRID0.SetGridCell rows, 3, array(2)

	If Trim(array(3)) = "" Then
		GRID0.SetGridCell rows, 6, array(5)
	Else
		GRID0.SetGridCell rows, 4, array(3)
		GRID0.SetGridCell rows, 5, array(4)
		GRID0.SetGridCell rows, 6, array(5)
	End If
Next

GRID1.Clear

If o_next.Data = "N" Then
	b_next.Enable = False
	i_next.Data = "999999"
ElseIf o_next.Data = "Y" Then
	b_next.Enable = True
	i_next.Data = array(1)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
rows = 0
i_next.Data = "999999"
GRID0.Clear
SCREEN.Send 0
'MsgBox GRID1.Rows
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_next)
_AW_ONCLICK_AW_
'i_next.Data =

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



