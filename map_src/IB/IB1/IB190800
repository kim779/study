Sub send_sise_all(xval)
SCREEN.IgnoreChange True
	If SCREEN.GetCodeType(E1301.Data) <> 9 Then		'ELW이외 종목
		Exit Sub
	End If

'	If Trim(xval) = "account" Then
'		S1301.Data = E1301.Data
'	End If

	E1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", E1301.Data

'	If xval <> "main" Then
'		E1301.Data = S1301.Data
'	Else
'		S1301.Data = E1301.Data
'	End If

	SCREEN.Object("OBJ_order.OBJECT0.o_jmno").clear
	SCREEN.Object("OBJ_order.OBJ_odr.o_jmno").clear


	If Trim(E1301.Data) <> Trim(SCREEN.Object("OBJ_order.OBJECT0.1301").Data) Then
		SCREEN.Object("OBJ_order.OBJECT0.1301").Data = Trim(E1301.Data)
		SCREEN.Proc "OBJ_order.OBJECT0.ChangeCode", ""

	End If

	If Trim(E1301.Data) <> Trim(SCREEN.Object("OBJ_order.OBJ_odr.1301").Data) Then
		SCREEN.Object("OBJ_order.OBJ_odr.1301").Data = Trim(S1301.Data)
		SCREEN.Proc "OBJ_order.obj_odr.ChangeCode", ""

	End If

	obj_sise.ClearAll 2
	SCREEN.Object("obj_sise.1301").Data = Trim(S1301.Data)
	SCREEN.Object("obj_sise").Send
	SCREEN.Object("obj_sSise").Send

SCREEN.IgnoreChange False

End Sub

