Sub SetMapSize()
	' 0 : 전체화면, 1 : 축소화면
	If Trim(size.Data) = "" Then
		size.Data = "1"
	End If

	If Trim(size.Data) = "1" Then
		size.Data = "0"
		SCREEN.Object("obj_order.BTN_expand").Visible = False
		SCREEN.Object("obj_order.BTN_reduce").Visible = True
		SCREEN.SetSize 904, 668
	Else
		size.Data = "1"
		SCREEN.Object("obj_order.BTN_reduce").Visible = False
		SCREEN.Object("obj_order.BTN_expand").Visible = True
		SCREEN.SetSize 535, 668
	End If
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		INFO.PushData LOGIN.Name, "userinfo.ini", SCREEN.GetMapName(1), "size", Trim(size.Data)
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim mapSize
		mapSize = Trim(INFO.PopData(LOGIN.Name, "userinfo.ini", SCREEN.GetMapName(1), "size"))

		If mapSize = "" Then
			mapSize = "0"
		End If

		size.Data = mapSize

		If mapSize = "0" Then
			SCREEN.Object("obj_order.BTN_expand").Visible = False
			SCREEN.Object("obj_order.BTN_reduce").Visible = True
			SCREEN.SetSize 904, 668
		Else
			SCREEN.Object("obj_order.BTN_reduce").Visible = False
			SCREEN.Object("obj_order.BTN_expand").Visible = True
			SCREEN.SetSize 535, 668
		End If
	End If
End Sub

