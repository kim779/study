_AW_ONDECLARE_AW_
Dim xxxx_flag
xxxx_flag = 1

Sub order_tab_change()
	Dim name
	Dim mapname

	Select Case tab_order.ID
	Case "1"
		OBJ_odr.SetObject("IB102150")
		name = "IB102100"&vbTab&"[1021] 대출상환"
	Case "3"
		OBJ_odr.SetObject("IB102170")
		name = "IB102200"&vbTab&"[1022] 대출정정"
	Case "4"
		OBJ_odr.SetObject("IB102180")
		name = "IB102300"&vbTab&"[1023] 대출취소"
	End Select

    mapname = SCREEN.GetMapName(1)
	If mapname = "IB102100" Or mapname = "IB102200" Or mapname = "IB102300" Then
		SCREEN.SetCaption name
	End If

End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password
	SCREEN.Proc "main.Set_account", "jumn"
	SCREEN.Object("obj_odr.o_jmno").Clear
	SCREEN.Object("main.guide").Text = " "

	If xxxx_flag = 1 Then
		SCREEN.Proc "main.chk_xxxx", ""		'비밀번호 체크
		xxxx_flag = 0
	End If
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus : Exit Sub
	End If
End Sub

'=== 가격자동 체크박스 체크값 기억/설정 ===
Dim auto_flag(3)
auto_flag(0) = False : auto_flag(1) = False : auto_flag(2) = False
Sub Set_Auto(mmgb)
	If (mmgb < "1") Or (mmgb > "3") Then Exit Sub
	SCREEN.Object("obj_odr.chk_auto").Checked = auto_flag(mmgb-1)
	SCREEN.Object("obj_odr.cboPrice").Enable = auto_flag(mmgb-1)
End Sub
Sub Get_Auto(mmgb, c_auto)
	If (mmgb < "1") Or (mmgb > "3") Then Exit Sub
	auto_flag(mmgb-1) = c_auto
End Sub

_AW_ONCLOSE_AW_
'주식주문2(IB100200)에서 주문타입변경시 계좌비밀번호 유지
If SCREEN.GetMapName(1) = "IB100200" Or SCREEN.GetMapName(1) = "IB000100" Or SCREEN.GetMapName(1) = "IB100100" Then
	SCREEN.Object("main.xxxx").Text = Trim(AN1A.data&"|"&ed_pswd.Data)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()

'종합화면 하단의 계좌관련 화면이 실행될때 자동조회를 위해 추가
If SCREEN.GetMapName(1) = "IB000100" Or SCREEN.GetMapName(1) = "IB100100" Or SCREEN.GetMapName(1) = "IB100200" Or SCREEN.GetMapName(1) = "IB500000" Or SCREEN.GetMapName(1) = "IB103100" Or SCREEN.GetMapName(1) = "IB282100" Then
	SCREEN.Object("main.obj_account").Send
End If


If SCREEN.GetMapName(1) = "IB103200" Then
	If bOnStart = False Then
		SCREEN.Object("main.AN1A").Data = AN1A.data
		SCREEN.Object("main.ACNM").Data = ACNM.data
		ed_pswd.Data = AN1A.Password
		SCREEN.Object("main.Pwd").Data = ed_pswd.Data
	End If
End If

bOnStart = False

If SCREEN.GetMapName(1) = "IB500000" Then
	If SCREEN.Object("main.tab_tuja").ID = "0" Then
		If SCREEN.Object("main.OBJ_Interest").GetObject() = "IB500013" Or SCREEN.Object("main.OBJ_Interest").GetObject() = "IB500014" Then
			SCREEN.Proc "main.OBJ_Interest.OnGroup", SCREEN.Object("main.OBJ_Interest.intercombo").Data
		End If
	End If
ElseIf SCREEN.GetMapName(1) = "IB000100" Then
	If SCREEN.Object("main.tab_tuja").ID = "0" Then
		If SCREEN.Object("main.OBJ_Interest").GetObject() = "IB000130" Then
			SCREEN.Proc "main.OBJ_Interest.OnGroup", SCREEN.Object("main.OBJ_Interest.intercombo").Data
		End If
	End If

	If SCREEN.Object("main.tab_info2").ID = "8" Then
		If SCREEN.Object("main.OBJ_Interest2").GetObject() = "IB000157" Then
			SCREEN.Proc "main.OBJ_Interest2.OnGroup", SCREEN.Object("main.OBJ_Interest2.intercombo").Data
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_pswd)
_AW_ONCHANGE_AW_
If Trim(ed_pswd.Data) = "" Then
	Exit Sub
End If
SCREEN.Proc "main.all_account", ""
