_AW_SCRIPT_AW_(BTN03)
_AW_ONCLICK_AW_
	SCREEN.CreateWindow 1, "IB120100 /s/t", ""
	Exit Sub
If tab_order.ID <> 1 Then
	SCREEN.CreateWindow 1, "IB120100 /s/t", ""
Else
	If Len(Trim(ed_pswd.Data)) < 4 Then
		MsgBox "비밀번호를 정확히 입력해 주세요",,"IBK투자증권"
		ed_pswd.SetFocus
		Exit Sub
	End If

	Dim dmsg
	dmsg = "AN1A" & vbTab & AN1A.Data & vbLf &_
		   "pswd" & vbTab & ed_pswd.Data & vbLf

	SCREEN.CreateWindow 2, "IB200099 /s/t/d", dmsg

	If  SYSTEM.Pop("realtime_jango") <> "OK" Then
		Exit Sub
	End If
	Dim tmp
	tmp = SYSTEM.Pop("realtime_loan_dt")
	If Trim(tmp)="" Then
		SCREEN.Object("OBJ_odr.R_cash").checked = True
		OBJ_odr.Proc "Set_CashCredit", 0
	Else
		SCREEN.Object("OBJ_odr.R_credit").checked = True
		OBJ_odr.Proc "Set_CashCredit", 1
	End If
	If SCREEN.GetMapName(1) <> "IB500000" Then '시간외 단일가 주문화면이 아니라면
		SCREEN.Object("OBJ_odr.shogb").data = "00"
		SCREEN.Object("OBJ_odr.ed_hogb").data = "00"
		SCREEN.Object("OBJ_odr.ed_jmgb").data = "00"
		SCREEN.Object("OBJ_odr.c_hogb").checked = False
		OBJ_odr.Proc "Set_radio_hogb" , ""
	End If
	'SYSTEM.Trace "구분 : " & SYSTEM.Pop("realtime_gubn")
	'SYSTEM.Trace "가능수량 : " & SYSTEM.Pop("realtime_ganun_num")
	'SYSTEM.Trace "평균단가 : " & SYSTEM.Pop("realtime_danga")
	'SYSTEM.Trace "대출일 : " & SYSTEM.Pop("realtime_loan_dt")

	'팝업창 그리드 데이터 더블클릭시 데이터를 받는다
	SCREEN.Object("OBJ_odr.1301").data = SYSTEM.Pop("realtime_jongmok")

	If Trim(SCREEN.Object("OBJ_odr.1301").data) <> "" Then
		SCREEN.Object("OBJ_odr.OBJ_hnam.1301").data = SCREEN.Object("OBJ_odr.1301").data
		SCREEN.Object("OBJ_odr.OBJ_hnam").Send
	End If

	'SCREEN.Object("OBJ_odr.shogb").data = SYSTEM.Pop("realtime_gubn")
	SCREEN.Object("OBJ_odr.ed_jqty").data = SYSTEM.Pop("realtime_ganun_num")
	SCREEN.Object("OBJ_odr.ed_jprc").data = SYSTEM.Pop("realtime_danga")
	SCREEN.Object("OBJ_odr.ed_date").data = SYSTEM.Pop("realtime_loan_dt")
End If
