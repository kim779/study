RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj.ClearAll 0
	GUIDE.Text = ""

	If Len(Trim(AN1A.Data)) = 11 Then
		ACNM.Data = Trim(AN1A.Name)
		zPwd.Data = Trim(AN1A.Password)

		If SYSTEM.ConnectBy = 0 And zPwd.Enable = False And Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If

		If SYSTEM.ConnectBy = 1 And Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If

		Call send_f()
	Else
		AN1A.SetFocus
		Exit Sub
	End If
End Sub

Sub send_f()
	If Trim(taxTp.Data) = "0" Then
		SCREEN.Proc "obj_taxRate.send_f", ""
	Else
		SCREEN.Proc "obj.send_f", ""
	End If

	editSearch.Data = "1"
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "jango", Trim(zD2balBaseQryTp.Index)
		INFO.PushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "taxx", Trim(taxTp.Index)
		INFO.PushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "tp", Trim(machaeTp.Index)
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim jangoGb, taxGb, machaeGb

		jangoGb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "jango"))
		taxGb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "taxx"))
		machaeGb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "tp"))

		If jangoGb = "" Then
			jangoGb = 0
		End If

		zD2balBaseQryTp.Index = jangoGb

		If taxGb = "" Then
			taxGb = 0
		End If

		taxTp.Index = taxGb

		If machaeGb = "" Then
			machaeGb = 0
		End If

		machaeTp.Index = machaeGb
	End If

	Call SelectTaxTp()
End Sub

Sub SelectTaxTp()
	If Trim(taxTp.Data) = "0" Then
		machaeTp.Enable = True
	Else
		machaeTp.Enable = False
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)		'직원/고객에 따른 비밀번호 컨트롤 설정
Call p_read_ini()
If SCREEN.GetMapName(0) <> "IB121300" Then
	print.Visible = False
End If

editSearch.Data = "0"

SCREEN.SetTimer 5, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Trim(AN1A.Data) <> "" Then
	Exit Sub
End If

Call Set_account()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
