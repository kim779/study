		zLoanPrslAmt.SetFocus
		Exit Sub
	End If
End Sub

Function chkLoanAmt()
	chkLoanAmt = ""
	GRID1.Clear

	Dim obj
	Set obj = SCREEN.Object("main.obj_grid.grid0")

	Dim ii, grdPos, loanAmt, firstChar, jmcd, jmNm, bondBuyDt, bondTaxGubn, loanGrade, loanDueDt, loanAbleAmt

	grdPos = obj.row

	loanAmt = zLoanPrslAmt.Data

	If Trim(lbName.Data) = "" Then
		chkLoanAmt = "NotName"
		Exit Function
	End If

	If CDbl(loanAmt) > 0 Then
		If is_numeric(loanAmt) = True Then
			firstChar = Left(loanAmt, 1)

			If AscW(firstChar) < 48 Or AscW(firstChar) > 57 Then
				chkLoanAmt = "NotNumeric"
				Exit Function
			End If

			loanAbleAmt = Trim(obj.GetGridCell(grdPos, 10))

			If Trim(loanAbleAmt) = "" Then
				loanAbleAmt = 0
			ElseIf is_numeric(loanAbleAmt) = False Then '대출잔고에서 신청했을때
				loanAbleAmt = DaeAblePrc
			End If

'				MsgBox "loanAbleAmt & loanAmt = " & loanAbleAmt & "   ^^^   " & loanAmt
			If CDbl(loanAbleAmt) < CDbl(loanAmt) Then
				chkLoanAmt = "OverAmt"
				Exit Function
			End If

			If (loanAmt Mod 10000) <> 0 Then
				chkLoanAmt = "NotZero"
				Exit Function
			End If

			jmcd = Trim(obj.GetGridCell(grdPos, 1))
			jmNm = Trim(obj.GetGridCell(grdPos, 3))
			bondBuyDt = Trim(obj.GetGridCell(grdPos, 4))
			bondTaxGubn = Trim(obj.GetGridCell(grdPos, 5))
			loanGrade = Trim(obj.GetGridCell(grdPos, 17))
			loanDueDt = Trim(obj.GetGridCell(grdPos, 18))

			GRID1.SetGridCell 1, 1, jmcd
			GRID1.SetGridCell 1, 2, bondBuyDt
			GRID1.SetGridCell 1, 3, bondTaxGubn
			GRID1.SetGridCell 1, 4, "+"
			GRID1.SetGridCell 1, 5, loanAmt
			GRID1.SetGridCell 1, 6, "+0000000000000000"
			GRID1.SetGridCell 1, 7, loanGrade
			GRID1.SetGridCell 1, 8, loanDueDt
			GRID1.SetGridCell 1, 9, jmNm
			GRID1.SetGridCell 1, 10, loanAbleAmt
		End If
	Else
		chkLoanAmt = "NotSet"
		Exit Function
	End If

	chkLoanAmt = "OK"
End Function

