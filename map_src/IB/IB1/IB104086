RESOURCE DIVISION
{


_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
LEDGER.Fkey = "5"
zAcntNo.Data = SCREEN.Object("parent.parent.AN1A").data
zInptPwd.Data = SCREEN.Object("parent.parent.ed_pswd").data

If Trim(zInptPwd.Data) <> "HEAD" And Len(Trim(zInptPwd.Data)) >= 4 Then
	LEDGER.Hsiz = 44
	LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zInptPwd.Data))
	zInptPwd.Data = "HEAD"
ElseIf Trim(zInptPwd.Data) = "HEAD" Then
	LEDGER.Hsiz = 44
	LEDGER.EPwd = Trim(SCREEN.Object("parent.parent.LEDGER").EPwd)
	zInptPwd.Data = "HEAD"
End If

If Trim(zInptPwd.Data) = "HEAD" Then
	If Len(Trim(LEDGER.EPwd)) <> 44 Then
		SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
		SCREEN.Object("parent.parent.ed_pswd").Data = ""
		SCREEN.Object("parent.parent.ed_pswd").SetFocus
		SCREEN.OnSend = False
		Exit Sub
	End If
End If

zRsvOrdInptDt.Data = SCREEN.Object("parent.zRsvOrdDt").data

lRsvOrdNo.Data = l_format(Trim(SCREEN.Object("parent.ed_ogno").data), "0", 9)

If SCREEN.GetCodeType(SCREEN.Object("parent.1301").data) = "27" Then
	zIsuNo.Data = "Q"+SCREEN.Object("parent.1301").data
Else
	zIsuNo.Data = "A"+SCREEN.Object("parent.1301").data
End If

zoccd.Data = SCREEN.Object("parent.ed_occd").data
sdat.Data = SCREEN.Object("parent.ed_sdat").data
edat.Data = SCREEN.Object("parent.ed_edat").data
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
MsgBox GUIDE.Text, , "IBK투자증권"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
LEDGER.Fkey = "5"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


