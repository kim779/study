RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("main.AN50").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call guide_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("main.AN50").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = "1" Then
	If Len(Trim(SCREEN.Object("main.zPwd").Data)) < 4 Then
		Call guide_msg("비밀번호를 확인하여 주십시오.")
		SCREEN.Object("main.zPwd").SetFocus
		Exit Sub
	End If
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	send_c()
Else
	If GRID0.Rows > 0 Then
		Dim SubAcnt
		SubAcnt = Trim(GRID0.GetGridCell(1, 2))

		If Len(SubAcnt) = 3 Then
			SCREEN.Object("parent.subAcnt").Text = SubAcnt
			SCREEN.Proc "parent.send_fund", ""
		End If
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call Find_fund()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zAcntNo)
_AW_ONCHANGE_AW_
'EDIT0.Data = SYSTEM.Pop("fundo")
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim SubAcnt
SubAcnt = Trim(GRID0.GetGridCell(GRID0.Row, 2))

If SubAcnt = "" Then
	Exit Sub
End If

SCREEN.Object("parent.subAcnt").Text = SubAcnt
SCREEN.Proc "parent.send_fund", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



