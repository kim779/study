Function CalcRow()
	Dim cnt, scnt
	cnt = Int((8000-(32+GRID0.Rows*28*2+5)-400)/278) '400은 PB헤더값(340)+60은 여분
	'MsgBox C(cnt,5)
	scnt = CStr(cnt)

	For ii = 1 To 5-Len(scnt)-1
		scnt="0"&scnt
	Next

	CalcRow = scnt
End Function

Function zeropad(str, length)
	Dim strTemp
	strTemp = Trim(str)
	If strTemp = "" Then
		zeropad = ""
		Exit Function
	End If
	zeropad = String(length - Len(strTemp), "0") & strTemp
End Function

