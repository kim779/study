RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim ODR_IDX

Sub SendOrder()
	ODR_IDX = 1
	If OGRID.Rows > ODR_IDX And Trim(OGRID.GetGridCell(ODR_IDX,4))<>"" Then
		SetJumun(ODR_IDX)
		SCREEN.Send 0
	End If
End Sub

Sub SetJumun(idx)
	zBnsTp.Data = "1"
	zAcntNo.Data = OGRID.GetGridCell(idx, 4)
	zPwd.Data = OGRID.GetGridCell(idx, 5)
	zIsuNo.Data = OGRID.GetGridCell(idx, 7)

	Dim jqty
	jqty = "" & CLng(OGRID.GetGridCell(idx, 9))
	lOrdQty.Data = String(15-Len(jqty),"0") & jqty

	If (SYSTEM.ConnectBy) Then
		zCommdaCode.Data = "00"
	Else
		zCommdaCode.Data = "01"
	End If
End Sub

_AW_ONSEND_AW_
If Trim(SCREEN.GetCodeType(zIsuNo.Data)) = "27" Then	'ETN은 'Q'로 시작함
	zIsuNo_A.Data = "Q"
Else
	zIsuNo_A.Data = "A"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
OGRID.SetGridCell ODR_IDX, 16, lOrdNo.Data
OGRID.SetGridCell ODR_IDX, 17, LEDGER.Emsg
ODR_IDX = ODR_IDX + 1

If OGRID.Rows > ODR_IDX And Trim(OGRID.GetGridCell(ODR_IDX,4))<>"" Then
	Call SetJumun(ODR_IDX)
	SCREEN.Send 0
Else
	SCREEN.Proc "parent.RecvOrder", ""
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(OGRID)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



