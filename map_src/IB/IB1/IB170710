_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(stockGrid)
_AW_ONCLICK_AW_
If stockGrid.HitPos <> 3 Then
	Exit Sub
End If

Dim jmcd
jmcd = Trim(stockGrid.GetGridCell(stockGrid.Row, 10))

If Len(jmcd) = 7 Then
	If Left(jmcd, 1) = "A" Then
		S1301.Data = Mid(jmcd, 2)
		S1301.Trigger "", True
	ElseIf Left(jmcd, 1) = "J" Or Left(jmcd, 1) = "Q" Then
		S1301.Data = Mid(jmcd, 2)
		E1301.Data = Mid(jmcd, 2)
		S1301.Trigger "", True
		E1301.Trigger "E1301", True
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(fundGrid)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(futureGrid)
_AW_ONCLICK_AW_
If futureGrid.HitPos <> 3 Then
	Exit Sub
End If

Dim jmcd, gubn, code, rsymb
jmcd = Trim(futureGrid.GetGridCell(futureGrid.Row, 10))

If Len(jmcd) <> 8 Then
	Exit Sub
End If

gubn = Mid(jmcd, 2, 2)

If IsNumeric(gubn) = False Then
	Exit Sub
End If

code = Left(jmcd, 1)

If CLng(gubn) >= 61 Then
	ed_fcod.Data = jmcd
	ed_fcod.Trigger "ed_fcod", True

	If code = "1" Or code = "4" Then
		rsymb = "100301"
	ElseIf code = "2" Or code = "3" Then
		rsymb = "100301"
	End If

	ed_fcod.Trigger rsymb, True
Else
	ed_focod.Data = jmcd
	ed_focod.Trigger "ed_focod", True

	If code = "1" Or code = "4" Then
		rsymb = "30301"
	ElseIf code = "2" Or code = "3" Then
		rsymb = "40301"
	End If

	ed_focod.Trigger rsymb, True
End If

ed_cfocod.Data = jmcd
ed_cfocod.Trigger "ed_cfocod", True
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(rpGrid)
_AW_ENDSCRIPT_AW_


}



