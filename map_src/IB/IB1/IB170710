RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim acntArr, stockArr, gridArr
acntArr = Array("AN1A", "AN50", "AN20", "AN2A")
stockArr = Array("PANEL1", "PANEL2", "PANEL3", "PANEL4", "PANEL5", "PANEL6", "PANEL7", "PANEL8", "PANEL9",_
				 "zDps", "zRcvblAmt", "zLoanAmt", "zMnyoutAbleAmt", "zSubstAmt", "zNSavAmt", "zMloanAmt", "zBookAmt", "zStkEvalAmtAsm")
gridArr = Array("stockGrid", "fundGrid", "futureGrid", "rpGrid")

Dim tabID, stockPos, futurePos

Sub SetScreen()
	Dim ii, arrGridNm, bVis
	tabID = Trim(SCREEN.Object("parent.mainTab").ID)

	For ii = LBound(gridArr) To UBound(gridArr)
		arrGridNm = Trim(gridArr(ii))

		If arrGridNm = Trim(gridArr(tabID)) Then
			bVis = True
		Else
			bVis = False
		End If

		SCREEN.Object(arrGridNm).Visible = bVis
	Next

	If tabID = 0 Then
		bVis = True
	Else
		bVis = False
	End If

	For ii = LBound(stockArr) To UBound(stockArr)
		SCREEN.Object(stockArr(ii)).Visible = bVis
	Next

	If tabID = "1" Then
		obj_subAcnt.Visible = True
	Else
		obj_subAcnt.Visible = False
	End If
End Sub

Sub send_f()
	If tabID <> "1" Then
		SCREEN.ClearAll 0, 2
		stockPos = 1
		futurePos = 1
		LEDGER.Fkey = "C"
		SCREEN.Send 0
	Else
		SCREEN.Proc "obj_subAcnt.send_f", ""
	End If
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	stockGrid.SetDataPosition 2
	fundGrid.SetDataPosition 2
	futureGrid.SetDataPosition 2
	rpGrid.SetDataPosition 2
	SCREEN.Send 0
End Sub


Sub send_fund()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"

Dim acnt, acntCtrl, acntLen
acnt = acntArr(tabID)
Set acntCtrl = SCREEN.Object("parent." & acnt)

If tabID <> 1 Then
	zAcntNo.Data = Trim(acntCtrl.Data)
	acntLen = 11
Else
	zAcntNo.Data = Trim(acntCtrl.Data) & Trim(subAcnt.Text)
	acntLen = 14
End If

If Len(Trim(zAcntNo.Data)) <> acntLen Then
	Call guide_msg("계좌번호를 확인하여 주십시오.")
	acntCtrl.SetFocus
	Exit Sub
End If

zPwd.Data = Trim(SCREEN.Object("parent.zPWd").Data)

If SYSTEM.ConnectBy = 0 And Trim(zPwd.Data) = "" Then
	zPwd.Data = "9999"
End If

If Len(Trim(zPwd.Data)) < 4 Then
	Call guide_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

zBaseDt.Data = Trim(SCREEN.Object("parent.zBaseDt").Data)
zQryTp.Data = Trim(SCREEN.Object("parent.mainTab").ID)

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If ecod = "" Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
	If LEDGER.Next = "Y" Then
		SCREEN.Object("parent.next_btn").Enable = True
	Else
		SCREEN.Object("parent.next_btn").Enable = False
	End If

	Dim ii, jmcd, unit

	If tabID = 0 Then
		If stockGrid.Rows > 0 Then
			For ii = stockPos To stockGrid.Rows
				jmcd = Trim(stockGrid.GetGridCell(ii, 9))

				If Len(jmcd) = 7 And (Left(jmcd, 1) = "A" Or Left(jmcd, 1) = "J" Or Left(jmcd, 1) = "Q") Then
					jmcd = Mid(jmcd, 2)
				End If

				stockGrid.SetGridCell ii, 9, jmcd
			Next

			stockPos = ii
		End If
	ElseIf tabID = 2 Then
		If futureGrid.Rows > 0 Then
			For ii = futurePos To futureGrid.Rows
				unit = Trim(futureGrid.GetGridCell(ii, 18))

				If IsNumeric(unit) = True Then
					unit = FormatNumber(unit, 0)
				End If

				futureGrid.SetGridCell ii, 19, unit
			Next

			futurePos = ii
		End If
	End If
Else

End If

