' 제세금 = 현재가 * 수량 * 0.003
' 수수료 = 현재가 * 수량 * 수수료율
' 매입평균가 = 매입평균가 - 수수료
'평가금액 계산시 수수료 = 10원단위미만 절삭(현재가 * 수량 * 수수료율)
'평가금액 계산시 제세금 = 원단위미만 반올림(현재가 * 잔고 * 0.003)
'평가금액 = 수수료미적용 평가금액 - (수수료 + 제세금 + 세이브수수료(있을경우))
'
'매입금액 계산시 수수료 = 10원단위미만 절삭(매입평균가 * 수량 * 수수료율)
'매입금액 계산시 제세금 = 원단위미만 반올림(매입평균가 * 잔고 * 0.003)
'매입금액 = 수수료미적용 매입금액 + (수수료 + 제세금 + 세이브수수료(있을경우))
	sum = 0
	TotalMaeip = 0
	TotalPyungga = 0
	TotalMoney = 0
	creditMoney = 0
	TotalCredit = 0
'	SYSTEM.Trace "gCount : " & gCount

'	For ii=gCount To GRID0.Rows
	For ii=1 To GRID0.Rows
		presentCost = Trim(GRID0.GetGridCell(ii, 17))					'현재가
		Remain = Trim(GRID0.GetGridCell(ii, 6))							'수량
		maeipCost =	Trim(GRID0.GetGridCell(ii, 43))						'매입금액
		pyunggaCost	= Trim(GRID0.GetGridCell(ii, 34))					'평가금액
		buyCost = Trim(GRID0.GetGridCell(ii, 26))						'매입평균가
		creditMoney = Trim(GRID0.GetGridCell(ii, 19))					'신용금액
		code = Trim(GRID0.GetGridCell(ii, 1))
		codx = Mid (code, 2, Len(code)-1)

		If presentCost = "" Then
			presentCost = 0
		End If
		If Remain = "" Then
			Remain = 0
		End If
		If maeipCost = "" Then
			maeipCost = 0
		End If
		If pyunggaCost = "" Then
			pyunggaCost = 0
		End If
		If buyCost = "" Then
			buyCost = 0
		End If
		If creditMoney = "" Then
			creditMoney = 0
		End If

		If Trim(howtax.Text) <> "" Then
			hTax = FormatNumber(Trim(howtax.Text), 8,-1, 0, 0 )			'수수료율

			If Trim(saveFee.text) <> "" Then
				saveFees = Trim(saveFee.text)							'세이브 수수료
			Else
				saveFees = 0
			End If
		End If


		If Remain <> 0 Then

			rate = (presentCost * Remain * hTax) 							'수수료(현재가 기준)
			rate = Fix(rate)
			rate = ((Fix(rate / 10)) * 10) + saveFees

			fee = presentCost * Remain * 0.003										'제세금(현재가 기준)

			fee = Fix(fee+0.5)


		Else
			rate = 0
			fee = 0
		End If


		'주식/신주인수권일때는 매입평균가가 없어도 계산을 해준다
		If Len(code) = 7 Or Len(code) = 9 Then
			If Remain <> 0 Then
			    maeipRate = (buyCost * Remain * hTax)   								'수수료 = 현재가 * 수량 * 수수료율
				maeipRate = Fix(maeipRate)
				maeipRate = ((Fix(maeipRate / 10)) * 10)  + saveFees
			Else
				maeipRate = 0
			End If
			maeipCost = maeipCost + maeipRate							'매입금액(수수료 포함)
			GRID0.SetGridCell ii, 43, maeipCost
		Else
			If maeipCost <> 0 Then
				If Remain <> 0 Then
 				    maeipRate = (buyCost * Remain * hTax)   								'수수료 = 현재가 * 수량 * 수수료율
					maeipRate = Fix(maeipRate)
					maeipRate = ((Fix(maeipRate / 10)) * 10)  + saveFees
				Else
					maeipRate = 0
				End If
				maeipCost = maeipCost + maeipRate							'매입금액(수수료 포함)
				GRID0.SetGridCell ii, 43, maeipCost
			End If
		End If

		'ELW와 ETF는 수수료만 계산 ETN 추가
		If Len(code) = 7 Then
			If Mid(code, 1, 1) = "J" Or SCREEN.GetCodeType(Mid(Trim(code), 2, 6)) = 6 Or Mid(code, 1, 1) = "Q" Then
'			If Mid(code, 1, 1) = "J" Then
'				SYSTEM.trace "pyunggaCost " & pyunggaCost
'				SYSTEM.trace "rate " & rate
'				SYSTEM.trace "fee " & fee
'				SYSTEM.trace "pyunggaCost " & saveFees
				pyunggaCost = pyunggaCost - (rate)						'평가금액
			Else
				pyunggaCost = pyunggaCost - (rate + fee)
			End If
		Else
			pyunggaCost = pyunggaCost - (rate + fee)						'평가금액
		End If


		'채권일 경우, 현재가가 없으면 손익 0
		If presentCost = 0 And Len(Trim(GRID0.GetGridCell(ii, 1))) = 12 Then
			resultCost = 0															'매도손익금액
		Else
			resultCost = pyunggaCost - maeipCost									'매도손익금액
		End If

		'채권일 경우, 현재가가 없으면 손익률 0
		If presentCost = 0 And Len(Trim(GRID0.GetGridCell(ii, 1))) = 12 Then
			sooikRate = 0.00
		Else

			If maeipCost = 0 And  creditMoney = 0 Then
				sooikRate = 0.00
			Else
				If (maeipCost - creditMoney) <> 0 Then
					sooikRate = ((pyunggaCost - maeipCost) / (maeipCost - creditMoney )) * 100
				Else
					sooikRate = 0.00
				End If
			End If
		End If

		GRID0.SetGridCell ii, 34, pyunggaCost									'평가금액
		GRID0.SetGridCell ii, 16, FormatNumber(sooikRate, 2, -1, 0, 0) + "%"	'손익률

		If  sooikRate > 0 Then
			GRID0.SetTRgb ii, 16, 94
		ElseIf sooikRate < 0 Then
			GRID0.SetTRgb ii, 16, 95
		Else
			GRID0.SetTRgb ii, 16, 69
		End If

		GRID0.SetGridCell ii, 14, resultCost									'매도손익금액

		If  resultCost > 0 Then
			GRID0.SetTRgb ii, 14, 94
		ElseIf resultCost < 0 Then
			GRID0.SetTRgb ii, 14, 95
		Else
			GRID0.SetTRgb ii, 14, 69
		End If


		TotalMaeip = TotalMaeip + maeipCost
		TotalPyungga = TotalPyungga + pyunggaCost
		TotalCredit = TotalCredit + creditMoney

'		SYSTEM.Trace "maeipCost : " & maeipCost & vbTab & "totalMaeip : " & TotalMaeip
'		SYSTEM.Trace "pyunggaCost : " & pyunggaCost & vbTab & "TotalPyungga : " & TotalPyungga
'		SYSTEM.Trace "creditMoney : " & creditMoney & vbTab & "TotalCredit : " & TotalCredit
	Next

'	SYSTEM.Trace "TotalMaeip : " & TotalMaeip
'	SYSTEM.Trace "TotalPyungga : " & TotalPyungga
'	SYSTEM.Trace "TotalCredit : " & TotalCredit



	If Trim(OUTPUT7.Data) = "" Then
		OUTPUT7.Data = 0
	End If

	If Trim(OUTPUT6.Data) = "" Then
		OUTPUT6.Data = 0
	End If

	If Trim(OUTPUT25.Data) = "" Then
		OUTPUT25.Data = 0
	End If

	OUTPUT7.Data = TotalMaeip											'매입총액
	OUTPUT6.Data = TotalPyungga - TotalCredit							'유가증권평가

	If Trim(OUTPUT98.Data) = "" Then
