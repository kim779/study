Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "jango", zD2balBaseQryTp.Index
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "taxx", tax.Index
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "tp", COMBO0.Index
	End If
End Sub


Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim jango, taxx, tp
		jango = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "jango"))
		taxx = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "taxx"))
		tp = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "tp"))

		If jango <> "" Then
			zD2balBaseQryTp.Index = jango
		Else
			zD2balBaseQryTp.Index = 0
		End If

		If taxx <> "" Then
			tax.Index = taxx
		Else
			tax.Index = 0
		End If

		If Trim(tax.Text) = "수수료미적용" Then
			COMBO0.Enable = False
		Else
			COMBO0.Enable = True
		End If

		If tp <> "" Then
			COMBO0.Index = tp
		Else
			COMBO0.Index = 0
		End If

		If Trim(AN1A.Data) <> "" And Trim(zPwd.Data) <> "" Then
			Call send_f()
		End If
	End If
End Sub

