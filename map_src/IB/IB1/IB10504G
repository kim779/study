Sub reDraw()
	For ii = 1 To GRID0.Rows
		Dim str, str2, strDate, strDanga, nPos

		'결제일
		str2 = Trim(GRID0.GetGridCell(ii, 2))

		If Len(str2) = 8 Then
			strDate = Mid(str2, 5, 2) & "/" & Mid(str2, 7, 2)
			GRID0.SetGridCell ii, 2, strDate
		End If

		'단가
		nPos = InStr(1,Trim(GRID0.GetGridCell(ii, 10)), ".", 1) - 1

		If Trim(GRID0.GetGridCell(ii, 10)) = "0" Or Trim(GRID0.GetGridCell(ii, 10)) = "0.00" Then
			GRID0.SetGridCell ii, 10, ""
		ElseIf nPos > 0 Then
			strDanga = Mid(Trim(GRID0.GetGridCell(ii, 10)), 1, nPos)
			GRID0.SetGridCell ii, 10, strDanga
		End If

		'매매구분
		str = Trim(GRID0.GetGridCell(ii, 7))

		If str = "2" Then				'매수
			GRID0.SetTRgb ii, 8, 94
			'GRID0.SetTRgb ii, 9, 94
			'GRID0.SetTRgb ii, 10, 94
		ElseIf str = "1" Then			'매도
			GRID0.SetTRgb ii, 8, 95
			'GRID0.SetTRgb ii, 9, 95
			'GRID0.SetTRgb ii, 10, 95
		Else
			GRID0.SetTRgb ii, 8, 69
			'GRID0.SetTRgb ii, 9, 69
			'GRID0.SetTRgb ii, 10, 69
		End If
	Next
End Sub

