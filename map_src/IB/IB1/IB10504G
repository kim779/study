_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> "3" Then
	Exit Sub
End If

Dim jgyh, qty, price, buyDt, codx
codx = Trim(GRID0.GetGridCell(GRID0.Row, 3))	'종목번호
jgyh  = Trim(GRID0.GetGridCell(GRID0.Row, 5))	'거래구분코드
qty   = Trim(GRID0.GetGridCell(GRID0.Row, 9))	'수량
price = Trim(GRID0.GetGridCell(GRID0.Row, 10))	'단가
buyDt = Trim(GRID0.GetGridCell(GRID0.Row, 2))	'일자

If codx = "" Then
	Exit Sub
End If

codx = Mid(codx, 2)

If IsNumeric(codx) = False Then
	If Len(codx) = 6 Then
		If SCREEN.GetCodeType(codx) < 0 Then
			Exit Sub
		End If
	Else
		If Mid(codx, 1,1) <> "A" And Mid(codx, 1,1) <> "J" And Mid(codx, 1,1) <> "Q" Then
			If SCREEN.GetCodeType(Mid(codx,2)) <> 9 Then
				Exit Sub
			End If
		End If
	End If
End If

SYSTEM.Push "J_qty", qty
SYSTEM.Push "J_jprc", price
SYSTEM.Push "S_date", buyDt
SYSTEM.Push "J_click", "YES"

SCREEN.Object("main.1301").Data = codx

SCREEN.IgnoreChange True
SCREEN.IgnoreChange False

SCREEN.Proc "main.send_sise_all", "account"

SCREEN.SetTimer 5, False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


