	lbSangAmt.Text = add_comma(SangAmt) & " 주"
	lbSangPrc.Text = add_comma(SangPrc) & " 원"
End Sub

Function add_comma(as_val)
      Dim i, mok, div, size, str

      size = Len(as_val)

      If  as_val = "" Or size <= 3 Then
         add_comma = as_val
      End If

      div = size / 3
      mok = size Mod 3
      str = Mid(as_val, 1, mok )

      For i = 0 To div-1
         If  i = 0 And  mok = 0 Then
            str = Mid(as_val,  mok + 1, mok + 3 )
         Else
            str = str & "," & Mid(as_val, (i * 3) + mok + 1,  3 )
         End If
      Next
      add_comma = str
End Function

'날짜 8자리, 구분자
Function SetDateString(as_val, Div_string)
	SetDateString = ""

	If Len(as_val) = 0 Then
		Exit Function
	End If

	SetDateString = Mid(as_val, 1, 4) & Div_string & Mid(as_val, 5, 2) & Div_string & Mid(as_val, 7, 2)
End Function

