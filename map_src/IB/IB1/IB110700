_AW_ONDECLARE_AW_
Option Explicit

Dim Today
Today = getDateSerial(Date)


Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj_chkPwd.ClearAll 2
	obj_list.ClearAll 2

	If Len(Trim(AN1A.Data)) = 11 Then
		ACNM.Data = Trim(AN1A.Name)
		SYSTEM.Trace Trim(AN1A.Password)
		If Len(Trim(AN1A.Password)) <> 44 Then
			zPwd.Data = Trim(AN1A.Password)
		Else
			LEDGER.Hsiz = 44
			LEDGER.Epwd = Trim(AN1A.Password)
	 		zPwd.Data = "HEAD"
		End If

		If SYSTEM.ConnectBy = 1 Then
			If Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			Else
				SCREEN.Proc "obj_chkPwd.send_f", ""
			End If
		Else
			Call OkSend()
		End If
	Else
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   		zPwd.Data = "9999"
	End If
End Sub

Sub OkSend()
	SCREEN.Proc "obj_list.send_f", ""
End Sub

Sub send_f()
	If SYSTEM.ConnectBy = "0" Then
		Call OkSend()
	Else
		Dim acnt
		acnt = Trim(SCREEN.Object("obj_chkPwd.IntaccNo").Data)

		If Trim(acnt) = Trim(AN1A.Data) Then
			If Trim(isPwdChkYn.Text) = "Y" Then
				Call OkSend()
			Else
				SCREEN.Proc "obj_chkPwd.send_f", ""
			End If
		Else
			SCREEN.Proc "obj_chkPwd.send_f", ""
		End If
	End If
End Sub


Sub chgDate(param)
	Dim tmpDt
	tmpDt = 0

	Select Case Trim(param)
		Case "1"
					tmpDt = change_indate("d", -1, Date)
					tmpDt = week_check(tmpDt)

					zQrySrtDt.Data = tmpDt
					zQryEndDt.Data = tmpDt
		Case "2"
					tmpDt = change_indate("d", -5, zQryEndDt.Text)
					tmpDt = week_check(tmpDt)

					zQrySrtDt.Data = tmpDt
		Case "3"
					tmpDt = change_indate("d", -10, zQryEndDt.Text)
					tmpDt = week_check(tmpDt)

					zQrySrtDt.Data = tmpDt
		Case "4"
					tmpDt = change_indate("m", -1, zQryEndDt.Text)
					'tmpDt = week_check(tmpDt)

					zQrySrtDt.Data = tmpDt
	End Select
End Sub

