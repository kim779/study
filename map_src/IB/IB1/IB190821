Dim list
Set list = CreateObject("Scripting.Dictionary")

''*************************************************
''send ui data
''*************************************************
Sub f_vSendUiData()
	Dim accn, pass,tax,mmd

	SCREEN.OnSend False
	VIEWGRID.Clear

	If cbo_mmd.Index = 0 Then
		mmd = out_hts.data
	ElseIf cbo_mmd.Index = 1 Then
		mmd = out_call.data
	ElseIf cbo_mmd.Index = 2 Then
		mmd = out_ars.data
	End If

'	If CheckInput(AN1A, pswd) = False Then
'		SCREEN.ClearAll 0, 2
'		ACNM.Data = AN1A.name
'		pswd.SetFocus
'		Exit Sub
'	Else
		accn = Trim(AN1A.Data)						'계좌번호
		pass = Trim(pswd.Data)						'비밀번호
		tax = cbo_tax.data

		If Len(accn) <> 11 Then
			accn = Trim(SCREEN.Object("main.OBJ_order.AN1A").Data)
			If Len(accn) <> 11 Then
				SCREEN.Object("main.guide").text = "계좌번호를 확인해 주십시오."
				Exit Sub
			End If
		End If

		If Len(pass) < 4 Then
			If SYSTEM.ConnectBy = "0" Then
				pass = "9999"
			Else
				pass = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)
			End If
			If Len(pass) < 4 Then
				SCREEN.Object("main.guide").text = "비밀번호를 확인해 주십시오."
				Exit Sub
			End If
		End If

		Call CONTROL0.Send(accn , pass, tax ,mmd )

'

	SCREEN.Wait = True
End Sub


