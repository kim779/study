Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim tax, mcgb, bep
		tax = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "tax"))
		mcgb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "mcgb"))
		bep = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "bep"))

		If tax <> "" Then
			cbo_tax.Index = tax
		Else
			cbo_tax.Index = 0
		End If

		If cbo_tax.Data = 0 Then
			cbo_mmd.Enable = False
		Else
			cbo_mmd.Enable = True
		End If

		If mcgb <> "" Then
			cbo_mmd.Index = mcgb
		Else
			cbo_mmd.Index = 0
		End If

		If bep <> "" Then
			cbo_bep.index = bep
		Else
			cbo_mmd.Index = 0
		End If

		If cbo_bep.Data = 0 Then
			VIEWGRID.SetColumnVisible 7, True
			VIEWGRID.SetColumnVisible 8, False
		Else
			VIEWGRID.SetColumnVisible 7, False
			VIEWGRID.SetColumnVisible 8, True
		End If

