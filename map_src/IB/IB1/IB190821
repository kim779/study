Dim gubn_code_len
Dim dataLen, dataList, row,tmp, chkb,gubn

dataList = CONTROL0.DataList
dataLen = Len(dataList)
gubn_code_len = 24



SCREEN.Wait = False
If  CONTROL0.Flag = "A" Then
	VIEWGRID.Clear
	VIEWGRID.InsertRows 0, dataList, True
	allCheck.Checked = False
''	SCREEN.Object("Main.GUIDE2.GUIDE").Text = GUIDE.Text
	b_send.Enable = False
	Call SendOBJX()
	SetCreditGubn()
	Call SetDic()
Else
	If DataLen < gubn_code_len Then
		If Left(Trim(GUIDE.Text), 1) = "0" Then
			SCREEN.Object("Main.GUIDE").Trgb = "130"
		Else
			SCREEN.Object("Main.GUIDE").Trgb = "094"
		End If

		SCREEN.Object("Main.GUIDE").Text = GUIDE.Text
		tmp = GUIDE.Text
		If (Mid(tmp,1,4) = "3669") Then
		  MsgBox(Trim(GUIDE.Text))
		End If

		Exit Sub
	End If

	chkb = True
	While chkb
		row = Find_Row(Left(dataList, gubn_code_len))
		gubn  = VIEWGRID.GetGridCell(row, 4) & VIEWGRID.GetGridCell(row, 2) & VIEWGRID.GetGridCell(row, 15) & VIEWGRID.GetGridCell(row, 14)
		If VIEWGRID.Rows = 0 Or row = 0 Then
			chkb = False
		End If

		If Mid(dataList, 1, 24) = gubn Then
			chkb = False
		Else
			SYSTEM.Trace "re-calculate"
			Call SetDic()
		End If
	Wend

	Select Case CONTROL0.Flag
		Case "I"						'insert
				VIEWGRID.InsertRow row
				VIEWGRID.Update row, Right(dataList, dataLen - gubn_code_len)
				SetCreditGubn()
				Call SetDic()
		Case "D"						'delete
				If row < 1 Then
					Exit Sub
				End If

				VIEWGRID.RemoveRow row-1
				SetCreditGubn()
				Call SetDic()
		Case "U"						'update
				If row < 1 Then
					Exit Sub
				End If

				VIEWGRID.Update row-1, Right(dataList, dataLen - gubn_code_len)
				SetCreditGubn()
		Case Else
				If Left(Trim(GUIDE.Text), 1) = "0" Then
					SCREEN.Object("Main.GUIDE").Trgb = "130"
				Else
					SCREEN.Object("Main.GUIDE").Trgb = "094"
				End If

				SCREEN.Object("Main.GUIDE").Text = GUIDE.Text

				tmp = GUIDE.Text

				If (Mid(tmp,1,4) = "3669") Then
					Call ClearData()
				  MsgBox(Trim(GUIDE.Text))
				End If
				Exit Sub				'CONTROL0.Flag = "E"(error flag)
	End Select
End If

