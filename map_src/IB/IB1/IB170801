RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub tabSelect()
	Select Case tab_subHangmok.ID
		Case 0
			obj0.SetObject ""
			obj0.SetObject "IB170810"
			SCREEN.Object("obj0.SecDtlGrid").Visible = False
			SCREEN.Object("obj0.BalStGrid").Visible = True
			SCREEN.SetTimer 3, False
		Case 1
			obj0.SetObject ""
			obj0.SetObject "IB170802"
			obj0.Send
	End Select
End Sub

_AW_ONSTART_AW_
Call tabSelect()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Trim(AN99.Data) = "" Or Len(Trim(AN99.Data)) < 11 Or Trim(zPwd.Data) = "" Or Len(Trim(zPwd.Data)) < 4 Then
	Exit Sub
End If

If SCREEN.Object("main.tab_hangmok").ID = "0" Then
	SCREEN.Object("obj0.zRmnCnfTp").Data = "1"
ElseIf SCREEN.Object("main.tab_hangmok").ID = "1" Then
	SCREEN.Object("obj0.zRmnCnfTp").Data = "0"
End If

SCREEN.Object("obj0.zOtptTp").Data = "1"
SCREEN.Object("obj0.zBalTrxTp").Data = "0"

SCREEN.Proc "obj0.send_f", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(tab_subHangmok)
_AW_ONCLICK_AW_
GUIDE.Text = ""

Call tabSelect()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN99)
_AW_ONCHANGE_AW_
SCREEN.ClearAll 2, 2
zPwd.Clear

If Len(Trim(AN99.Data)) > 10 Then
	ACNM.Data = Trim(AN99.Name)
	zPwd.Data = Trim(AN99.Password)

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
	End If
Else
	AN99.SetFocus
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then
	Call tabSelect()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
If tab_subHangmok.ID = 0 Then
	SCREEN.Proc "obj0.send_f", ""
ElseIf tab_subHangmok.ID = 1 Then
	SCREEN.Proc "obj0.obj0.send_f", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
If tab_subHangmok.ID = 0 Then
