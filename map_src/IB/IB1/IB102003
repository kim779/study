Sub SetJanInfo(szVal)
	Dim szCrdt
	If szVal = "JANGOINFO" Then
		'잔고더블 클릭으로 들어온 정보 처리
		'종목코드
		E_shrt_cd.Data = e_jcode.Data
		Set_EDIT_mkgb(Trim (e_jcode.Data))
		'종목명
		LB_NAME.Data = e_jname.Data

		'잔고신용구분  00:현금 03:자기융자 01:유통융자 80:대출
		szCrdt = Trim(e_crdt.Data)
		E_crdt_typ_cd.Data = szCrdt
		If szCrdt = "00" Then
			RADIO0.Checked = True
			cmb_ordtype.Enable = False
		Else
			If szCrdt = "03" Then
				RADIO1.Checked = True
				cmb_ordtype.Enable = True
				cmb_ordtype.Index = 1

			ElseIf szCrdt = "01" Then
				RADIO1.Checked = True
				cmb_ordtype.Enable = True
				cmb_ordtype.Index = 0
			End If
		End If

		'대출일자 신규주문은 없다 비우자
		E_ln_dt.Data = ""
	ElseIf szVal = "ITEMCHANGE" Then
		'화면 종목 변경으로 들어온 정보 처리
		'종목코드
		E_shrt_cd.Data = e_jcode.Data
		Set_EDIT_mkgb(Trim (e_jcode.Data))
		'종목명
		LB_NAME.Data = e_jname.Data
		'잔고신용구분  00:현금 03:자기융자 01:유통융자 80:대출
		szCrdt = Trim(e_crdt.Data)
		RADIO0.Checked = True
		cmb_ordtype.Enable = False
		E_ln_dt.Data = ""
		Call InitCondCtrls("ALL")
	End If

End Sub


