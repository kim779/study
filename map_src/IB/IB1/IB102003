			edt_cond_2.SetType 200
			edt_cond_3_1.SetType 200
			edt_cond_3_2.SetType 200
			edt_cond_5.SetType 200
		Case 3
			'프리보드
		Case 4, 5, 7
			'장외
		Case 6, 27
			'ETF
			ed_jprc.SetType 240
			edt_cond_1.SetType 240
			edt_cond_2.SetType 240
			edt_cond_3_1.SetType 240
			edt_cond_3_2.SetType 240
			edt_cond_5.SetType 240
		Case 9
			'ELW
			ed_jprc.SetType 250
			edt_cond_1.SetType 250
			edt_cond_2.SetType 250
			edt_cond_3_1.SetType 250
			edt_cond_3_2.SetType 250
			edt_cond_5.SetType 250
		Case Else
			Set_EDIT_mkgb = False
	End Select
End Function

