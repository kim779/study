Function Set_EDIT_mkgb(code)
	Dim retn
	Set_EDIT_mkgb = True
	ed_jprc.SetType 0
	edt_cond_1.SetType 0
	edt_cond_2.SetType 0
	edt_cond_3_1.SetType 0
	edt_cond_3_2.SetType 0
	edt_cond_5.SetType 0
	retn = SCREEN.GetCodeType(code)
	Select Case retn
		Case 1
			'거래소
			ed_jprc.SetType 100
			edt_cond_1.SetType 100
			edt_cond_2.SetType 100
			edt_cond_3_1.SetType 100
			edt_cond_3_2.SetType 100
			edt_cond_5.SetType 100
		Case 2
