_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	BalstGrid.SetDataPosition 2
	SecDtlGrid.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0011"
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim codx, ii, hnam, cheg, jj

If LEDGER.Next = "Y" Then
	Call send_c()
Else
	jj = 1
	For ii = 1 To SecDtlGrid.Rows
	'MsgBox Trim(SecDtlGrid.GetGridCell(ii, 7))
		If Trim(SecDtlGrid.GetGridCell(ii, 7)) = "보통" Then
			GRID0.InsertRow -1
	'		MsgBox Trim(SecDtlGrid.GetGridCell(ii, 4))
			codx = Trim(SecDtlGrid.GetGridCell(ii, 4))
			hnam = Trim(SecDtlGrid.GetGridCell(ii, 5))
			cheg = Trim(SecDtlGrid.GetGridCell(ii, 8))
			S1301.Data = codx

			GRID0.SetGridCell jj, 1, codx
			GRID0.SetGridCell jj, 2, hnam
			GRID0.SetGridCell jj, 3, cheg
			jj = jj + 1
		End If
	'	MsgBox "[" & codx  & "][" & Trim(SecDtlGrid.GetGridCell(ii, 5)) &"]"
		SecDtlGrid.SetGridCell ii, 16, S1301.Data
	Next
End If
'MsgBox jj
'cnt.Data = jj

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(OUTPUT1)
_AW_ENDSCRIPT_AW_


