	Exit Sub
End If

Dim acc, accnm
acc = Trim(BalstGrid.GetGridCell(BalstGrid.Row, 2))
accnm = Trim(BalstGrid.GetGridCell(BalstGrid.Row, 4))

SYSTEM.Push "1709_acnt", acc
SYSTEM.Push "1709_acnm", accnm
SYSTEM.Push "J_click", "YES"
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
SYSTEM.Push	"1709_accn", ""
SYSTEM.Push "1709_name", ""

If BalstGrid.Rows < 1 Then
	Exit Sub
End If

If Trim(BalstGrid.GetGridCell(BalstGrid.Row, 2)) = "" Then
	Exit Sub
End If

Dim acc, MidAcc, accnmm
acc = Trim(BalstGrid.GetGridCell(BalstGrid.Row, 2))
accnmm = Trim(BalstGrid.GetGridCell(BalstGrid.Row, 4))
MidAcc = Mid(acc, 4, 2)

SYSTEM.Push "1709_name", accnmm

Call tab_change(acc, MidAcc)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(trdDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONDBLCLK_AW_
Dim code, hnam, data
Select Case GRID0.HitPos
Case 3	'DATA부 click
'	code = Mid(Trim(GRID0.GetGridCell(GRID0.Row, 1)), 2, 6)
	code = Trim(GRID0.GetGridCell(GRID0.Row, 1))
	hnam = Trim(GRID0.GetGridCell(GRID0.Row, 2))
	data = code & ";" & hnam
	SYSTEM.Trigger "ChangeCode", data, "IB120900"
'	MsgBox data
Case Else
	SCREEN.OnSend = False
	Exit Sub
End Select

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SecDtlGrid)
_AW_ONCLICK_AW_
If SecDtlGrid.HitPos <> 3 Then
	Exit Sub
End If

Dim codx, jqty, jprc, acc, accnm

acc  = Trim(SecDtlGrid.GetGridCell(SecDtlGrid.Row, 1))
accnm  = Trim(SecDtlGrid.GetGridCell(SecDtlGrid.Row, 3))
codx = Trim(SecDtlGrid.GetGridCell(SecDtlGrid.Row, 4))
jqty = Trim(SecDtlGrid.GetGridCell(SecDtlGrid.Row, 8))
jprc = Trim(SecDtlGrid.GetGridCell(SecDtlGrid.Row, 13))

'MsgBox "[" & acc & "]"

Select Case Trim(SCREEN.Object("parent.tab_subSubHangmok").ID)
	Case 0 ' 주식
		SCREEN.Object("parent.1301").Data = Mid(codx, 4, 6)
		S1301.Data = Mid(codx, 4, 6)
		SCREEN.Object("parent.ed_jqty").Data = jqty
		AN1N.data = acc
		SYSTEM.Push "1709_acnt", acc
		SYSTEM.Push "1709_acnm", accnm
		SYSTEM.Push "J_qty", jqty
'		SYSTEM.Push "J_jprc", jprc
		SYSTEM.Push "J_click", "YES"

		S1301.Trigger "", True
		SYSTEM.SetHistory "1301", S1301.Data

	Case 3	'선물
		SCREEN.Object("parent.ed_focod").Data = codx
		ed_focod.Data = codx
		SCREEN.Object("parent.ed_jqty").Data = jqty

'		MsgBox "[" & ed_focod.Data &"]"

		ed_focod.Trigger "", True
		SYSTEM.SetHistory "ed_focod", ed_focod.Data

	Case 4	'옵션
		SCREEN.Object("parent.ed_focod").Data = codx
		ed_focod.Data = codx
		SCREEN.Object("parent.ed_jqty").Data = jqty

'		MsgBox "[" & ed_focod.Data &"]"

		ed_focod.Trigger "", True
		SYSTEM.SetHistory "ed_focod", ed_focod.Data

End Select
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
SYSTEM.Push	"1709_accn", ""
SYSTEM.Push "1709_name", ""

If SecDtlGrid.HitPos <> 3 Then
	Exit Sub
End If

Dim accn
accn = Trim(SecDtlGrid.GetGridCell(SecDtlGrid.Row, 1))

If accn = "" Then
	Exit Sub
End If

Dim accnTp
accnTp = Mid(accn, 4, 2)

Call tab_change(accn, accnTp)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


