RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub SetInitCustomer()
	Dim iCustomerType
	iCustomerType = SYSTEM.ConnectBy
	SCREEN.Object("obj_Buf.edt_Customer").Data = iCustomerType
	If iCustomerType <> "1" Then '고객
		zPwd.Enable = False
		If Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If
	End If

	If SCREEN.Object("obj_Buf.edt_sndCnt").Data = 0 Then
		Call send_f()
	End If

End Sub

Sub SetPassword(sData)
	Dim Ifind, sAcc, sPass
	ifind = InStr(sData, "-")
	sAcc = Trim( Left(sData, Ifind-1) )
	sPass = Trim( Mid(sData, Ifind+1, Len(sData)- Ifind) )
	If Trim(AN1A.Data) = sAcc Then
		zPwd.data = sPass
		If Trim( SCREEN.Object("obj_Buf.edt_sndCnt").Data) = "0" Then
			Call send_f()
		End If
	End If
End Sub




'== 계좌명, 비밀번호 설정
Sub Set_account()

	SCREEN.Object("GUIDE.GUIDE").Text = ""

	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = Trim(AN1A.Password)
	If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy <> "1" Then '고객
		zPwd.Data = "9999"
	End If

	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	If Trim( SCREEN.Object("obj_Buf.edt_MapNo").Data) = "" Then
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	If  Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If  Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	'SCREEN.Object ("GUIDE.GUIDE").Data = ""
	SCREEN.Object("obj_Buf.edt_sndCnt").Data = SCREEN.Object("obj_Buf.edt_sndCnt").Data + 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub CalKospi()
	Dim ii, sum

	sum = 0
	For ii=1 To GRID0.Rows
		kp = Trim(GRID0.GetGridCell(ii, 11))
		sum = sum + kp
	Next

	kospisum.Data = FormatNumber(sum, 2, -1, 0, 0)

	If kospisum.Data > 0 Then
		kospisum.TRgb = 94
	ElseIf kospisum.Data < 0 Then
		kospisum.TRgb = 95
	ElseIf kospisum.Data = 0 Then
		kospisum.TRgb = 130
	End If
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim sort
		sort = ""

		If sortR_asc.Checked = True Then
			sort = "asc"
		Else
			sort = "dsc"
		End If

		INFO.PushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "sort", sort
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim sort
		sort = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "sort"))

		If sort = "" Then
			sort = "asc"
		End If

		If sort = "asc" Then
			sortR_asc.Checked = True
		Else
			sortR_dsc.Checked = True
		End If
	End If
End Sub


Sub SetTermTp()
	Dim val

	If sortR_asc.Checked = True Then
		val = 0
	Else
		val = 3
	End If

	If RADIO0.Checked = True Then
		zStrDt.SetFormat "9999/99/99"
		zEndDt.SetFormat "9999/99/99"

		val = val + 1
	ElseIf RADIO1.Checked = True Then
		zStrDt.SetFormat "9999/99/99"
		zEndDt.SetFormat "9999/99/99"

		val = val + 2
	Else
		zStrDt.SetFormat "9999/99"
		zEndDt.SetFormat "9999/99"

	 	val = val + 3
	End If

	zQryTermTp.Data = val

	Call send_f()
End Sub

