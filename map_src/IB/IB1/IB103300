Sub SetLoanCode()
	Dim var
	var = Trim(SCREEN.Object("obj_grid.GRID0").GetGridCell(SCREEN.Object("obj_grid.GRID0").row, 13))

	If var = "유통융자" Then
		zLoanDtlClssCode.data = "01"
	ElseIf var = "자기융자" Then
		zLoanDtlClssCode.data = "03"
	ElseIf var = "유통대주" Then
		zLoanDtlClssCode.data = "05"
	ElseIf var = "자기대주" Then
		zLoanDtlClssCode.data = "07"
	ElseIf var = "예탁담보자동대출" Then
		zLoanDtlClssCode.data = "40"
	ElseIf var = "증권금융예탁담보신용대출" Then
		zLoanDtlClssCode.data = "51"
	ElseIf var = "증권금융예탁담보자동대출" Then
		zLoanDtlClssCode.data = "52"
	ElseIf var = "증권금융미수담보대출" Then
		zLoanDtlClssCode.data = "55"
	ElseIf var = "수익증권담보대출" Then
		zLoanDtlClssCode.data = "60"
	ElseIf var = "매도대금담보대출" Then
		zLoanDtlClssCode.data = "70"
	ElseIf var = "예탁주식담보융자" Then
		zLoanDtlClssCode.data = "80"
	ElseIf var = "예탁주식담보신용대출" Then
		zLoanDtlClssCode.data = "80"
	ElseIf var = "예탁채권담보융자" Then
