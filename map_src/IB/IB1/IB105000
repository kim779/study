Sub OnPortfolio(msg)
	SCREEN.Proc "main.OBJ_Interest.OnPortfolio", "ok"
	SCREEN.Proc "main.OBJ_Interest2.OnPortfolio", "ok"
End Sub

Sub SetTrData(map,handle,file,bookmark,data,dataLen)
	If map <> "1050" Then
		Exit Sub
	End If

	If tab_acct.ID = 2 Then
		If Trim(handle) <> Trim(SCREEN.Object("OBJ_Interest.CONTROL0").GetMapHandle()) Then
			Exit Sub
		End If

		SCREEN.Object("OBJ_Interest.CfgFile").Data = file
		SCREEN.Object("OBJ_Interest.BookFile").Data = bookmark
		SCREEN.Object("OBJ_Interest.trData").Data = data
		SCREEN.Object("OBJ_Interest.DataLen").Data = dataLen
	End If
End Sub

Sub send_sise_all(xval)

cx_log.axlog "IB105000 send_sise_all", xval
	SYSTEM.Trace "SEND_SISE_ALL"
	SYSTEM.Trace S1301.Data
	SYSTEM.Trace "CODE : " & xval
	SYSTEM.Trace "CODETYPE : " & SCREEN.GetCodeType(S1301.Data)

	If SCREEN.GetCodeType(S1301.Data) <> 9 Then		'ELW이외 종목
		SYSTEM.Trace "NOT ELW"
		Exit Sub
	End If

	If Trim(xval) = "account" Then
		E1301.Data = S1301.Data
	End If

	If xval <> "jumun" Then
  		S1301.Trigger "", False
 	End If
	S1301.Trigger "1301", True

	SCREEN.Object("OBJECT0.1301").Data = Trim(S1301.Data)

	OBJECT0.Send

	SYSTEM.SetHistory "1301", S1301.Data


	SCREEN.IgnoreChange True

'	If xval <> "main" Then
'		E1301.Data = S1301.Data
'	Else
'		E1301.Data = S1301.Data
'	End If

	obj_obj_sise.Send
	SCREEN.IgnoreChange False

	If IsSend = 1 Then
		If xval <> "jumun" Then
			Call Ord_ChangeCode(S1301.Data)
		End If
	End If

	If Trim(xval) <> "sise" Then
		OBJ_sise.Send
	End If

	If UTAB.ID = 2 Then
		obj_stc.Send
	End If

	If MTAB.ID <> 2 And MTAB.ID <> 3 Then
		OBJ_info.Send
	End If



	If tab_acct.ID = 8 Then
		SCREEN.Proc "obj_account.send_main", ""	'주문가능탭
	End If


End Sub

