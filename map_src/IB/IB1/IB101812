_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999912) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "2"

'***************************************************************************
' DESC: 사용자 입력키 Action
'***************************************************************************
Sub OnAxUserKey(key)
'	If OrdCfg.EnterOrder = True Then
'		If key = 13 Then
'			SYSTEM.UserKey	= True
'			DoOrder()
'		End If
'	End If
End Sub

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg
	Dim sHnam

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		flash_fg.Data = 0
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(shogb.Text, 4)		'매매구분

		sHnam = Replace(Mid(SCREEN.Object("OBJ_hnam.1022").Data,2), "/","／")
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & sHnam & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & ed_jprc.Data & vbLf
		If R_cash.Checked Then
			SCREEN.CreateWindow 2, "IB10016A /p5 /d", dmsg
		Else
			dmsg = dmsg & "o_sygb" & vbTab & c_sygb.Text & vbLf
			SCREEN.CreateWindow 2, "IB10016B /p5 /d", dmsg
		End If

		If SYSTEM.Pop("stock_masu_order") <> "OK" Then
			flash_fg.Data = 0
			Exit Sub
		End If
	End If
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")
	Call SetCursor()			'주문 후 커서 설정

	flash_fg.Data = 0
End Sub

'== 주문가능수량 조회 : xval [1:현금가능 ,2:최대가능]
Sub Query_Qty(xval)
	If ed_jprc.Data = 0 Then '주문단가 입력되어있지 않다면..현재가 셋팅
		ed_jprc.SetFocus
	End If

	ed_acno.Data = SCREEN.Object("parent.AN1A").Data
	ed_pswd.Data = SCREEN.Object("parent.ed_pswd").Data

	'== obj:: send_tr(acno, pwd, mmgb, cod2, pric)
	Dim	param, pric

	If ed_jprc.Enable = True Then
		pric = ed_jprc.Data
	Else
		pric = SCREEN.Object("parent.obj_sise.2302").Data

		If shogb.Data = "81" Then 			'시간외종가일경우 현재가 세팅. 2009/12/11
			pric = SCREEN.Object("parent.obj_sise.2023").Data
		ElseIf shogb.Data = "61" Then		'장개시전시간외종가일경우 전일종가 세팅. 2009/12/11
			pric = SCREEN.Object("parent.obj_sise.2320").Data
		End If
	End If

	If shogb.Data = "05" Then '조건부지정가라면
		pric = SCREEN.Object("parent.obj_sise.2302").Data
	End If

	param = ed_acno.Data &","& ed_pswd.Data &","& _
			mmgb &","& S1301.Data &","& pric &","& xval

	If R_credit.Checked Then
		OBJ_trust_avol.Proc "send_tr", param&","& Mid(Date,1,4)&Mid(Date,6,2)&Mid(Date,9,2)
	Else
		OBJ_avol.Proc "send_tr", param
	End If

	'OBJ_avol.Proc "send_tr", param
