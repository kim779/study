'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.Data = AN20.Password

	If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy <> "1" Then
		zPwd.Data = "9999"
		zPwd.Enable = False
	End If

	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 2,2
	ed_focod.Clear

	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	send_btn.Enable = False
	next_btn.Enable =False
	SCREEN.Object("obj_Buf.edt_sndCnt").Data = "1"
	ACNM.Data = AN20.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub


'1000번 버퍼용
Sub SetInitCustomer()
	Dim iCustomerType
	iCustomerType = SYSTEM.ConnectBy
	SCREEN.Object("obj_Buf.edt_Customer").Data = iCustomerType
	If iCustomerType <> "1" Then '고객
		zPwd.Enable = False
	End If
End Sub

Sub SetPassword(sData)
	Dim Ifind, sAcc, sPass
	ifind = InStr(sData, "-")
	sAcc = Trim( Left(sData, Ifind-1) )
	sPass = Trim( Mid(sData, Ifind+1, Len(sData)- Ifind) )

	If Trim(AN20.Data) = sAcc Then
		zPwd.data = sPass
	End If

	If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy <> "1" Then
		zPwd.Data = "9999"
	End If

	If Trim( SCREEN.Object("obj_Buf.edt_sndCnt").Data) = "0" Then
		Call send_f()
	End If
End Sub

