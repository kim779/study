_AW_SCRIPT_AW_(ed_focod)
_AW_ONCHANGE_AW_
Dim name, cdType
name = ""

If Trim(ed_focod.Data) <> "" Then
	cdType = Mid(Trim(ed_focod.Data), 2, 2)

	If Trim(cdType) <> "" Then
		If IsNumeric(cdType) = False Then
			GUIDE.Text = "종목번호를 확인하여 주십시오."
			Exit Sub
		End If

		If cdType < 60 Then
			Select Case Left(Trim(ed_focod.Data), 1)
				Case "1", "4", "A", "D" :											' 선물
					name = SCREEN.GetName(101, ed_focod.Data, 0)
					ed_focod.Trigger "30301", True
					SYSTEM.SetHistory "30301", ed_focod.Data
				Case "2", "3", "B", "C" :											' 콜, 풋
					name = SCREEN.GetName(102, ed_focod.Data, 0)
					ed_focod.Trigger "40301", True
					SYSTEM.SetHistory "40301", ed_focod.Data
			End Select

			ed_focod.Trigger "ed_focod", True
			SYSTEM.SetHistory "ed_focod", ed_focod.Data
		Else
			name = SCREEN.GetName(127, ed_focod.Data, 0)
		End If
	Else
		name = ""
	End If
Else
	name = ""
End If

HNAM.Data = name
g_hnam.Data = HNAM.Data
zFnoIsuNo.Data = ed_focod.Data

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


