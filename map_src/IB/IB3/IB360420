Sub Fixdanga()	'금액매매
	Dim BuyQtyGB, BuyFixPrcQty, DanGa, qry

	BuyQtyGB = Trim(OrdCfg.ReadCfg("BuyQtyGB"))

	If BuyQtyGB <> "2" Then
		MsgBox "주문설정에서 매매금액을 설정하여 주십시오",0,"IBK투자증권"
		Exit Sub
	End If

	BuyFixPrcQty = Trim(OrdCfg.ReadCfg("BuyFixPrcQty"))

	If BuyFixPrcQty = "" Then
		Exit Sub
	End If

	If r_hogb1.Checked <> True Then
		If  ed_jprc.Data = "000000000" Then
		 	DanGa = Trim(SCREEN.Object("obj_obj_sise.2023").Data)
			ed_jprc.Data = DanGa
		Else
		   	DanGa = ed_jprc.Data
		End If
	Else
		If Trim(SCREEN.Object("obj_obj_sise.2302").Data) <> "" Then
		   DanGa = Trim(SCREEN.Object("obj_obj_sise.2302").Data)
		Else
		   MsgBox "시장가 주문이 불가합니다",0,"IBK투자증권"
		   Exit Sub
		End If
	End If

	If DanGa = "" Then
		Exit Sub
	End If

	qry = CDbl(BuyFixPrcQty) / CDbl(DanGa)
	ed_jqty.Data = Fix(qry)

	OBJ_JUNGSAN.Proc "CalcJungsan", ""
End Sub

Sub Log_File_Set()
	Dim myWeekDay
	Dim f, sFileDate

	myDate = Date
	myWeekDay = Weekday(myDate)
	dic = SYSTEM.Home & "/user/" & CONTROL0.IDtoSha(LOGIN.Name) & "/2000log_" & myWeekDay & ".dat"

	Set myFSO = CreateObject("Scripting.FileSystemObject")

	If (myFSO.FileExists(dic)) Then
		Set f = myFSO.GetFile(dic)
		sFileDate = Mid(f.DateCreated,1,4) & Mid(f.DateCreated,6,2) & Mid(f.DateCreated,9,2)

		If sFileDate <> CDAT.Data Then
			myFSO.DeleteFile(dic)
		End If
	End If

	Set f = Nothing
	Set myFSO = Nothing
End Sub

Sub Log_File_Write(xval, pric)
	Dim WriteStuff
	Dim log_xval, ed_jprc_enable, shogb_data, credit_check

	myTime = Time

	Set myFSO = CreateObject("Scripting.FileSystemObject")
	Set WriteStuff = myFSO.OpenTextFile(dic, 8, True)

	WriteStuff.WriteLine("===================================================")
	log_xval = CDAT.Data & " " & myTime & " - xval : " & xval & " [1:현금가능 ,2:최대가능] [2:신용가능]"
	WriteStuff.WriteLine(log_xval)
	ed_jprc_enable = CDAT.Data & " " & myTime & " - ed_jprc.Enable : " & ed_jprc.Enable
	WriteStuff.WriteLine(ed_jprc_enable)

	shogb_data = CDAT.Data & " " & myTime & " - shogb.Data : " & shogb.Data & "  pric : " & pric
	WriteStuff.WriteLine(shogb_data)

	credit_check = CDAT.Data & " " & myTime & " - R_credit.Checked : " & R_credit.Checked
	WriteStuff.WriteLine(credit_check)

	WriteStuff.Close

	Set myFSO = Nothing
	Set WriteStuff = Nothing
End Sub

