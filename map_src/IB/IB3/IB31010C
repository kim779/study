_AW_ONDECLARE_AW_
Dim Mydata

Function data_split()
	Mydata = Split(s_data.data, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)							' 한 레코드를 개체별로 자르는중..

		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(0))				' CUD
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))				' 주문유형
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))				' 시장구분
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))				' 매매구분
		GRID.SetGridCell NREC.Data - ii, 5,Trim(Mydata(ii)(4))				' 계좌번호
		GRID.SetGridCell NREC.Data - ii, 6, "HEAD"
		'GRID.SetGridCell NREC.Data - ii, 6,Trim(Mydata(ii)(5))				' 비밀번호
		GRID.SetGridCell NREC.Data - ii, 7,Trim(Mydata(ii)(6))				' 주문번호
		GRID.SetGridCell NREC.Data - ii, 8,Trim(Mydata(ii)(7))				' 종목코드
		GRID.SetGridCell NREC.Data - ii, 9,Trim(Mydata(ii)(8))				' 종목명
		GRID.SetGridCell NREC.Data - ii, 10,Trim(Mydata(ii)(9))				' 주문수량
		GRID.SetGridCell NREC.Data - ii, 11,Trim(Mydata(ii)(10))			' 주문가격
		GRID.SetGridCell NREC.Data - ii, 12,Trim(Mydata(ii)(11))			' 호가구분
		GRID.SetGridCell NREC.Data - ii, 13,Trim(Mydata(ii)(12))			' 주문조건
		GRID.SetGridCell NREC.Data - ii, 14,Trim(Mydata(ii)(13))			' 모두구분
		GRID.SetGridCell NREC.Data - ii, 15,Trim(Mydata(ii)(14))			' 처리구분
		GRID.SetGridCell NREC.Data - ii, 19,Trim(Mydata(ii)(15))			' 기타
	Next
End Function

Sub AllCancel()
	Dim ii
	For ii = 1 To GRID.Rows
		GRID.SetGridCell ii,6, pswd.Data  '2009.07
	Next
	SCREEN.Send 0
End Sub

Sub Set_account()
	ACNM.Data = AN20.name
'	pswd.Data = AN1A.Password
End Sub

_AW_ONSTART_AW_
'SACMT207 비밀번호검증TR

NREC.Pop("num")
L_CNT.Text = NREC.Data

data_split()

If SYSTEM.ConnectBy = 1 Then
	pswd.Enable = False
Else
	pswd.Enable = True
	If Trim(pswd.Data) = "9999" Then
		pswd.Data = ""
		pswd.SetFocus
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Dim pre_id, pre_br
If SYSTEM.ConnectBy = 1 Then
	If LOGIN.Cani = 0 Then
		MsgBox "본사직원은 주문이 불가합니다.",,"IBK투자증권"
		'SCREEN.OnSend = False
		Exit Sub
	End If
End If

LEDGER.Hsiz = 44
LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(pswd.data))

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
MsgBox GUIDE.Text, ,"주문확인"
SCREEN.CloseWindow()

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
If SCREEN.Object("obj_chkPW.trchk").Data = "F" Then
	SYSTEM.Push "obj_chkPW_trchk", "F"
Else
	SYSTEM.Push "obj_chkPW_trchk", "T"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(B_SEARCH)
_AW_ONCLICK_AW_
SCREEN.Object("obj_chkPW.IntaccNo").data = Trim(AN20.Data)
SCREEN.Object("obj_chkPW.Pwd").data = Trim(pswd.Data)
SCREEN.Object("obj_chkPW.chk").data = "2" 						'일괄정정 : 2
obj_chkPW.Send
