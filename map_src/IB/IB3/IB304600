'***************************************************************************
Function Error_check()
	Dim msg, ret

	GUIDE.Text = ""
	Error_check = False
	S901.Clear
	VIEWGRID.Clear
	If Trim(AN20.Data) = "" Or Len(Trim(AN20.Data)) < 11 Then
		GUIDE.Text = "계좌번호를 확인하세요"
		Exit Function
	End If
	If Trim(zpwd.Data) = "" Or Len(Trim(zpwd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하세요"
		zpwd.SetFocus
		Exit Function
	End If

	ret = P_pswdConfirm(AN20.data, zpwd.data, msg)
	If ret <> True Then
		zpwd.SetFocus
		GUIDE.Text = msg
		Exit Function
	End If

	Error_check = True
End Function

