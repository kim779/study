			mcsu = 	VIEWGRID.GetGridCell (ii, 18)
		End If

		If CDbl(mcsu) > 0 Then
			cnt = cnt + 1
			code = VIEWGRID.GetGridCell(ii, c_code)			'종목코드
'			If SCREEN.GetCodeType(VIEWGRID.GetGridCell(ii, c_code)) = "9" Then
'			     code = "J" & VIEWGRID.GetGridCell(ii, c_code)   '종목코드
