Sub Set_account()
	SCREEN.ClearAll 0, 2
	ANCM.Data = AN20.Name
	h_acnm.Data = AN20.Name
	zpwd.Data = AN20.Password

	If Len(Trim(AN20.Data)) < 11 Then
		AN20.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zpwd.Data)) < 4 Then
			zpwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

