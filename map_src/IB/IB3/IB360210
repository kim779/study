Sub p_read_com()
	If SCREEN.CreateObject("Info") Then
	 	Dim data
	 	data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP"))
		If data = "" Then
			intercombo.Data = "01"
		Else
			intercombo.Data = data
		End If

		arrange.Data = "00"
		'SYSTEM.Trace "!!!!!!!reduce::read combo: " & intercombo.Data
	End If
End Sub

Sub p_write_com()
	If SCREEN.CreateObject("Info") Then
	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP", intercombo.Data
	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "SELECT_ARRANGE", arrange.Data

	  If auto.Checked = True Then
	  	data = 1
	  Else
	  	data = 0
	  End If

	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "INTERAUTO", data

	  If expect.Checked = True Then
	  	data = 1
	  Else
	  	data = 0
	  End If

	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "INTEREXPECT", data
	End If
End Sub

