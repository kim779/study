Sub OptionLoad()
	Dim data

	data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "INTERAUTO"))

	If data = "" Then
		data = 1
	End If

	If data = 1 Then
		auto.Checked = True
	Else
		auto.Checked = False

		data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "INTEREXPECT"))

		If data = "" Then
			data = 0
		End If

		If data = 1 Then
			expect.Checked = True
		Else
			expect.Checked = False
		End If
	End If

	If auto.Checked = True Then
		CONTROL1.SetAutoCheck True
		CONTROL1.SetExpect False

		expect.Enable = False
		expect.Checked = False
	Else
		CONTROL1.SetAutoCheck False
		CONTROL1.SetExpect False

		expect.Enable = True
	End If

	If expect.Checked = True Then
		CONTROL1.SetExpect True

		If RADIO1.Checked = True Then
			CONTROL1.ChangeGroup intercombo.Data
		End If
	Else
		CONTROL1.SetExpect False

		If RADIO1.Checked = True Then
			CONTROL1.ChangeGroup intercombo.Data
		End If
	End If
End Sub

