Sub OnDllValue(sData)
	Dim slist
	slist = Split(sData, vbTab, -1, 1)
	Select Case slist(0)
		Case "SetValue"	'send
			'AccNo-slist(1), PWD-slist(2)
			AN20.Data = slist(1)
			zpwd.Data = slist(2)
			Call send_f()
		Case "MoveWnd"	'resize
			ResizeControl CLng(slist(1)), CLng(slist(2))
		Case "Reset"	'reset
			AN20.Data = ""
			zpwd.Data = ""
			o_migm.Data = ""
			o_pggm.Data  = ""
			o_pgsi.Data = ""
			o_srat.Data = ""
			VIEWGRID.Clear
		Case "POPUP"
			xval = 1
			AN20.Data = slist(1)
			zpwd.Data = slist(2)
			mdsend()
	End Select
End Sub

Function ResizeControl(iwidth, iheight)
	Dim igridw, arRate, idx, lval, lcalc, icontrolw, ileft
	arRate = Array(0.0568,0.0892,0.142,0.1038,0.0974,0.0876,0.0974,0.0892,0.0892,0.1168, 0, 0 ,0,0)
	igridw = iwidth - 10 'left, right space
	icontrolw = igridw / 8

	PANEL17.SetRect -4, 25, iwidth+4 , iheight+5 '라운드 컨텐츠판넬
	VIEWGRID.SetRect 6, 58, iwidth - 8, iheight-10
	ileft = 6
	PANEL1.SetRect ileft, 36, ileft+icontrolw, 56
	ileft = ileft + icontrolw-1
	o_migm.SetRect ileft, 36, ileft+icontrolw, 56

	ileft = ileft + icontrolw-1
	PANEL11.SetRect ileft, 36, ileft+icontrolw, 56
	ileft = ileft + icontrolw-1
	o_pggm.SetRect ileft, 36, ileft+icontrolw, 56

	ileft = ileft + icontrolw-1
	PANEL6.SetRect ileft, 36, ileft+icontrolw, 56
	ileft = ileft + icontrolw-1
	o_pgsi.SetRect ileft, 36, ileft+icontrolw, 56

	ileft = ileft + icontrolw-1
	PANEL3.SetRect ileft, 36, ileft+icontrolw, 56
	ileft = ileft + icontrolw-1
	o_srat.SetRect ileft, 36, ileft+icontrolw, 56

	PANEL0.SetRect 0, 0, iwidth, 25
	ileft = iwidth - 66
	btn_j.SetRect ileft, 3, ileft+60, 23

	'그리드 컬럼너비조정
	arRate = Array(0.120058, 0.126466, 0.05867, 0.056062, 0.053455, 0.078226, 0.07953, 0.139504, 0.088657, 0.078226, 0.11734)
	igridw = iwidth - 14 'left, right space
	igridw = igridw - 20 '스크롤너비

	idx = 0
	For ii = 2 To VIEWGRID.Columns
		lval = VIEWGRID.GetColumnWidth(ii)

		If   VIEWGRID.IsColumnVisible(ii) Then
			lcalc = CDbl  (arRate(idx) ) * CDbl(igridw)
			idx = idx + 1
			VIEWGRID.SetColumnWidth ii, CLng(lcalc)
		End If

	Next
	VIEWGRID.Refresh
End Function

Sub mdsend()
cnt = 0
For ii = 1 To VIEWGRID.Rows
	If VIEWGRID.GetGridCell(ii ,1) = 1 Then
		cnt = cnt + 1								'처리건수카운트
		sycd = Trim(VIEWGRID.GetGridCell(ii, 4))				'구분
		If sycd = "매수" Then
			sycd = "매도"
		Else
			sycd = "매수"
		End If
		jmna = VIEWGRID.GetGridCell(ii, 3)				'종목명
		jmgb = "2"									'주문유형(1:현물,2:선물옵션,3...)
		mkgb = ""									'시장구분(사용안함)
		mmgb = Trim(VIEWGRID.GetGridCell(ii,4))		'매매구분(1:매도 2:매수 3:정정 4:취소)
		If mmgb = "매도" Then
			mmgb = "2"
		Else
			mmgb = "1"
		End If
		accn = Trim(AN20.Data)		'계좌번호
		pass = Trim(zpwd.Data)	'비밀번호
		jmno = ""									'원주문번호(정정취소시)
