_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(62303)
_AW_ONCHANGE_AW_
Dim   r_upgb

SCREEN.IgnoreChange True
	r_upgb = P_GetBigCd(S62303.Data)
	Select Case r_upgb
		Case "001"		'KOSPI
			'S62302.DATA = S62302.Data
			SYMBOL2.Enable = True
		Case "101"		'KOSPI200
			S62302.DATA = "10"
			S62303.Data = "001"
			SYMBOL2.Enable = False
		Case "201"		'KOSDAQ
			S62302.DATA = "90"
			SYMBOL2.Enable = True
		Case Else
			S62303.Data = "001"
			S62302.DATA = "00"
			SYMBOL2.Enable = True
	End Select
SCREEN.IgnoreChange False

SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SYMBOL2)
_AW_ONCLICK_AW_
Dim retn, ln_idx

Select Case S62302.DATA
    Case "00"
        ln_idx = "0"
    Case "90"
        ln_idx = "9"
    Case "10"
        ln_idx = "1"
End Select

Select Case ln_idx
Case "0", "9" : retn = SCREEN.GetCode(104, "62303", "HNAM", ln_idx)
Case "1" : retn = SCREEN.GetCode(107, "62303", "HNAM", 0)
End Select

'If retn <> True Then
'       Exit Sub
'End If

SCREEN.Send ALL
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(62302)
_AW_ONCHANGE_AW_
Select Case S62302.DATA
    Case "00"
        S62303.data="001"
		SYMBOL2.Enable = True

    Case "90"
        S62303.data="201"
		SYMBOL2.Enable = True

    Case "02"
        S62303.data="001"
		SYMBOL2.Enable = False

	Case "06"
        S62303.data="001"
		SYMBOL2.Enable = False

    Case "05"
        S62303.data="001"
		SYMBOL2.Enable = False

    Case "10"
        S62303.data="101"
		SYMBOL2.Enable = False

End Select

SCREEN.Send 0
Exit Sub
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(62307)
_AW_ONCHANGE_AW_
SCREEN.Send 2
_AW_ONENDSUB_AW_
