#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim com
com = SCREEN.Object("parent.upgb").data

Select Case com
    Case "00"			'--KOSPI
        S62303.data="001"
		S62302.Data = com
	Case "90"			'--KOSDAQ
   	    S62303.data="201"
		S62302.Data = com
    Case "10"			'--KOSPI200
        S62303.data="101"
		S62302.Data = com
    Case "22"			'--선물
        S62303.data="001"
		S62302.Data = "02"
	Case "55"			'--콜옵션
        S62303.data="001"
		S62302.Data = "05"
    Case "66"			'--풋옵션
        S62303.data="001"
        S62302.Data = "06"
End Select

If SCREEN.Object("parent.F1").Checked = True Then
	S62307.Data = "06"
Else
	S62307.Data = "05"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(62311)
_AW_ONCLICK_AW_
Select Case S62311.HitPos
Case 2
	SCREEN.Send 2
Case 1
	SCREEN.Send 2
Case 6
	SCREEN.Send 2
Case 5
	SCREEN.Send 2
Case Else
End Select
Exit Sub
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(F1)
_AW_ONCLICK_AW_

