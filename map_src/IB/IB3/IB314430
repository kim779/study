Dim fcod, cprc, jprc, lowcprc, lowjprc
cprc = "0"
jprc = "0"
lowcprc = "0"
lowjprc = "0"

If Trim(ed_evt.Data) = "GRID" Then

	SCREEN.Object("main.OBJ_order.obj_odr.ed_cfocod").data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 3))  '종목코드
	SCREEN.Proc "main.OBJ_order.obj_odr.ChangeCode", ""

	SCREEN.Object("main.OBJ_order.obj_odr.ed_ogno").Data = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 2))  '원주문번호
	SCREEN.Object("main.OBJ_order.obj_odr.ed_jqty").data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 9))  '주문수량
	SCREEN.Object("main.OBJ_order.obj_odr.OrdCfg").Qty = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 9))    '주문환경설정
	SCREEN.Object("main.OBJ_order.obj_odr.ed_omgb").data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 8)) 	'원주문매매구분

	fcod = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 3))

	If jumungb = "STOP" Then
		Select Case Left(Trim(fcod),3)
			Case "185", "186", "187", "A85", "A86", "A87"
				cprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 10)) / 100
			Case Else
				cprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 10))
		End Select
		SCREEN.Object("main.OBJ_order.obj_odr.ed_jprc").data = cprc  '높은 조건가격
	ElseIf jumungb = "STOP LIMIT" Then
		Select Case Left(Trim(fcod),3)
			Case "185", "186", "187", "A85", "A86", "A87"
				cprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 10)) / 100
				jprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 11)) / 100
			Case Else
				cprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 10))
				jprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 11))
		End Select
		SCREEN.Object("main.OBJ_order.obj_odr.ed_ojmgb").data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 7)) '주문구분
		SCREEN.Proc "main.OBJ_order.obj_odr.Set_oHogb", ""
		SCREEN.Object("main.OBJ_order.obj_odr.ed_jprc_con").data = cprc  	'높은 조건가격
		SCREEN.Object("main.OBJ_order.obj_odr.ed_jprc").data = jprc  		'높은 주문가격
	ElseIf jumungb = "OCO" Then
		Select Case Left(Trim(fcod),3)
			Case "185", "186", "187", "A85", "A86", "A87"
				cprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 10)) / 100
				If Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 11)) <> "" Then
					jprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 11)) / 100
				End If

				lowcprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 12)) / 100

				If Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 13)) <> "" Then
					lowjprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 13)) / 100
				End If

			Case Else
				cprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 10))
				jprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 11))
				lowcprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 12))
				lowjprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 13))
		End Select
		SCREEN.Object("main.OBJ_order.obj_odr.ed_ohogb").data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 6)) '주문구분
		SCREEN.Object("main.OBJ_order.obj_odr.ed_ojmgb").data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 7)) '주문구분
		SCREEN.Proc "main.OBJ_order.obj_odr.Set_oHogb", ""
		SCREEN.Object("main.OBJ_order.obj_odr.ed_jprc_con").data = cprc  	'높은 조건가격
		SCREEN.Object("main.OBJ_order.obj_odr.ed_jprc").data = jprc  		'높은 주문가격
		SCREEN.Object("main.OBJ_order.obj_odr.ed_jprc_lowCon").data = lowcprc  '낮은 조건가격
		SCREEN.Object("main.OBJ_order.obj_odr.ed_jprc_low").data = lowjprc           '낮은 주문가격
	End If
End If

If Trim(ed_evt.Data) = "INIT" Then
	SCREEN.Send 0
End If

Dim tmpCode2
tmpCode2 = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 3))

If tmpCode2 = "" Then
	Exit Sub
End If

tmpCode2 = Mid(tmpCode2, 2, 2)

If tmpCode2 >= 1 And tmpCode2 <= 9 Then
	ed_focod.Data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 3))
	ed_focod.Trigger "ed_focod", True
ElseIf tmpCode2 >= 60 And tmpCode2 <= 99 Then
 	ed_fcod.Data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 3))
 	ed_fcod.Trigger "ed_fcod", True
End If

