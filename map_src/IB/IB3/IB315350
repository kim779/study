Sub DoOrder()
	Dim trow, irow, ii, val, chk, val_cnt
	o_jmno.Data = "0"
	SCREEN.Object("main.OBJ_ORDSEND.zFundId").data = Mid(cmb_fund.Data,2)
	trow = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").rows
	SCREEN.Object("main.OBJ_ORDSEND.in2").data = CStr(trow)

	If trow > 0 Then
		val_cnt = 1
		Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").Clear
		SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetRows trow
		For ii = 1 To trow
			chk = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 22)
			If chk = 1 Then
				Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetGridCell(val_cnt, 1,  SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 1))
				Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetGridCell(val_cnt, 2,  "")
				Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetGridCell(val_cnt, 3,  SCREEN.Object("main.OBJ_Sise.100301").Data)
				Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetGridCell(val_cnt, 4,  edit_mgb.Data)
				Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetGridCell(val_cnt, 5,  c_hogbs.Data)
				Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetGridCell(val_cnt, 6,  "03")
				val = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(val_cnt, 24)
				val = makeqty(val)
				Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetGridCell(val_cnt, 7,  val)'"+000000000000002")
				val = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(val_cnt, 25)
				val = makeprice(val)
				Call SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetGridCell(val_cnt, 8,  val)'"+000000203.05")'
				val_cnt = val_cnt+1
				Call SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").SetGridCell(ii, 23, "")
				Call SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").SetGridCell(ii, 26, "")
			End If
		Next
		SCREEN.Object("main.OBJ_ORDSEND.Grid0").SetRows val_cnt-1
		SCREEN.Object("main.OBJ_ORDSEND.in2").data = CStr(val_cnt-1)
	End If
	'Exit Sub
	If OrderConform() Then
		Call SCREEN.Object("main.OBJ_ORDSEND").Send
	End If
End Sub

Function OrderConform()
	If CHECK0.Checked Then
		OrderConform = True
		Exit Function
	End If
	Dim acnt, cnt, code, jprc, s_data, mmgb, hogb, ret, jqty, ii, cf

	For ii = 1 To SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").Rows
		If SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii ,22) = 1 Then
			cnt = cnt + 1
			acnt = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 1)			'계좌번호
			If edit_mgb.Data="1" Then
				mmgb = "매도"
			Else
				mmgb = "매수"
			End If
			'mmgb = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 19)			'매매구분
			hogb = c_hogbs.Text																	'호가구분
			code = SCREEN.Object("main.OBJ_SISE.100301").data									'종목코드
			jqty = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 24)			'주문수량
			jprc = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 25)			'주문단가

			s_data = "#" & s_data
			s_data = jprc & "|" & s_data				'주문단가
			s_data = jqty & "|" & s_data				'주문수량
			s_data = code & "|" & s_data				'종목코드
			s_data = hogb & "|" & s_data				'호가구분
			s_data = mmgb & "|" & s_data				'매매구분
			s_data = acnt & "|" & s_data				'계좌번호
		End If
	Next

	If cnt > 0 Then
		SYSTEM.Push "num", cnt
		'SCREEN.CreateWindow 2, "IB310103 /p5 /d", "s_data" & vbTab & s_data
		SCREEN.CreateWindow 2, "IB315395 /p5 /d", "s_data" & vbTab & s_data & vbLf
	End If
	cf = SYSTEM.Pop("C3153")
	If cnt = 0 Then
		MsgBox "주문 낼 항목을 선택하십시오.",,"IBK투자증권"
		cf = "NO"
	End If
	If cf = "OK" Then
		OrderConform = True
	Else
		OrderConform = False
	End If
End Function

Sub ReadQtyConfig
	Dim data, array, j, i
	If SCREEN.CreateObject("Info") Then
		data = Trim(INFO.PopData(LOGIN.Name, "ordcfg.ini", "IB315300", "812_QtyConfig"))
	End If
	If Trim(data) = "" Then
		data = "1|2|3"
	End If
	array = Split(data, "|", -1, 1)

	j=0
	For Each i in array
	 j = j+1

	 If Trim(array(j-1)) <> "" Then
	 	SCREEN.Object("Qty"&CStr(j)).Text = CStr(CLng(array(j-1)))
	 End If
	Next
End Sub

Sub SetPrice(val)
	Dim trows, ii, chk
	trows = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").Rows
	For ii = 1 To trows
		chk = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 22)
		If chk = 1 Then
			Call SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").SetGridCell(ii, 25,  val)
		End If
	Next
	Call SetBtnTitle()
End Sub

Sub SetQty(val)
	Dim trows, ii, chk, multi,iqty, biyu
	trows = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").Rows
	For ii = 1 To trows
		chk = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 22)
		multi = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 27)
		biyu  = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 28)
		If chk = 1 Then
			If r_p1.Checked Then
				iqty = val*multi/100
				Call SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").SetGridCell(ii, 24,  iqty)
			ElseIf r_p2.Checked Then
				Call SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").SetGridCell(ii, 24,  val)
			Else
				iqty = val*biyu/10000
				Call SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").SetGridCell(ii, 24,  iqty)
			End If
		End If
	Next
	Call SetBtnTitle()
End Sub

Function MakeQty(str)
	If Trim(str) = "" Then
		MakeQty = "+000000000000000"
		Exit Function
	End If
	str = "+"&Mid(str,2)

	MakeQty = str
End Function

Function MakePrice(str)

	str = "+"&Mid(str, 3,Len(str)-4)&"."&Mid(str, Len(str)-1,2)

	MakePrice = str
End Function

Sub ChangeHogaType()
	If c_hogbs.Data = "00" Then
		ed_jprc.Enable = True
		ed_jprc.SetFocus
	ElseIf c_hogbs.Data = "03" Then
		ed_jprc.Enable = False
		ed_jprc.data = 0
	ElseIf c_hogbs.Data = "05" Then
		ed_jprc.Enable = True
		ed_jprc.SetFocus
	ElseIf c_hogbs.Data = "06" Then
		ed_jprc.Enable = False
		ed_jprc.data = 0
	End If
	Call SetPrice(ed_jprc.Data)
End Sub

Sub SetBtnTitle()
	Dim prc,qty,mgb
	If edit_mgb.Data = "1" Then
		mgb = "매도"
	ElseIf edit_mgb.Data = "2" Then
		mgb = "매수"
	End If
	prc = CStr(ed_jprc.Data/100)
	qty = GetTotalQty()
	btn_jumun.Text = mgb & " " & prc & " X " & CStr(qty)
	btn_jumun2.Text = mgb & " " & prc & " X " & CStr(qty)

End Sub


Function GetTotalQty()
	Dim trows, ii, chk, multi,iqty,tqty
	trows = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").Rows
	tqty = 0
	For ii = 1 To trows
		chk = SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 22)

		If chk = 1 Then
			tqty = tqty + SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC.Grid0").GetGridCell(ii, 24)

		End If
	Next
	GetTotalQty = tqty
End Function


Sub LoadCfg()
	Dim ii, str
	If SCREEN.CreateObject("Info") Then
		str = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB315300", "config"))
		If Len(str) < 6 Then
			str = "000001"
		End If
		For ii=0 To 5

			If Mid(str, ii+1, 1) = "1" Then
				SCREEN.Object("CHECK"&CStr(ii)).Checked = True
			Else
				SCREEN.Object("CHECK"&CStr(ii)).Checked = False
			End If
		Next
		'INFO.PushData LOGIN.Name, "userconf.ini", "IB315300", "config", str
	End If
End Sub

Sub AfterOrder()
	If CHECK3.Checked Then
		ed_jqty.Data = 0
		Call SetQty(ed_jqty.Data)
	End If
	If CHECK4.Checked Then
		ed_jprc.Data = 0
		Call SetPrice(ed_jprc.Data)
	End If
	If Not CHECK5.Checked Then
		SCREEN.Proc "OBJ_FUNDACC.SetAllCheck", "0"
	End If
	SCREEN.Proc "main.OBJ_FUNDACC.send_f", ""
End Sub

