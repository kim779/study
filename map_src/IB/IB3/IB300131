'***************************************************************************
' DESC: 가변로우인경우 처음조회시 체크안되는거 방지
'***************************************************************************
Sub set_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		VIEWGRID.SetGridCell ii, 1,"0"
	Next
	btn_chk()
End Sub

'***************************************************************************
' DESC: clear_check
'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, c_code)) = "" Then
			Exit For
		End If
		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
	btn_chk()
End Sub

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)
	Dim ii
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, c_code)) = "" Then
			Exit For
		End If
		If Trim(VIEWGRID.GetGridCell (ii, c_wqty)) > "0" Then
			VIEWGRID.SetGridCell ii, 1, Flag
		End If
	Next
	btn_chk()
End Sub

Sub btn_chk()
	Dim cnt, ii

	cnt = 0
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, c_code)) = "" Then
			Exit For
		End If
		If VIEWGRID.getGridCell(ii, 1) = "1" And Trim(VIEWGRID.GetGridCell (ii, c_wqty)) > "0" Then
			cnt = cnt +1
		End If
	Next

	If cnt > 0 Then
		btn_m.Enable = True
		btn_c.Enable = True
	Else
		btn_m.Enable = False
		btn_c.Enable = False
		allCheck.Checked = False
	End If
End Sub
'***************************************************************************
' DESC: first_send
'***************************************************************************
Sub first_send()
	VIEWGRID.Clear
	If Trim(ed_pswd.Data) <> "" Then
		SCREEN.Send 0
	Else
		VIEWGRID.Clear
	End If
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	SCREEN.Object("parent.guide").text = ""
	ed_accn.Data = Trim(SCREEN.Object("main.OBJ_order.AN20").Data)		'계좌번호
	ed_pswd.Data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)	'비밀번호

	If Trim(ed_pswd.Data) <> "" Then
		Call first_send()
	Else
		VIEWGRID.Clear
	End If
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False
	S901.Clear
	VIEWGRID.Clear
	If Trim(ed_accn.Data) = "" Or Len(Trim(ed_accn.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(ed_pswd.Data) = "" Or Len(Trim(ed_pswd.Data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Exit Function
		End If
	End If

	ret = P_pswdConfirm(ed_accn.data, ed_pswd.data, msg)
	If ret <> True Then
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		SCREEN.Object("main.GUIDE").Text = msg
		Exit Function
	End If

	Error_check = True
End Function

'***************************************************************************
' DESC: 코드체이지
'************************
Sub code_change()
	Dim name, major, minor

	major = Left(focod.Data,1)
	minor = Mid(focod.Data, 2, 2)
	If Trim(major) = "" Then
		HNAM.Data = ""
		Exit Sub
	ElseIf major = "1" Or major = "4" Or major = "A" Or major = "D" Then
		name = SCREEN.GetName(101, focod.data, 0)'지수선물
	Else
		If minor < 10 Then
			name = SCREEN.GetName(102, focod.data, 0)'지수옵션
		Else
			name = SCREEN.GetName(108, focod.data, 0)'주식옵션
		End If
	End If

	If Trim(name) = "" Then
		HNAM.Data = ""
		focod.Data = ""
		Exit Sub
	End If
	HNAM.Data = name
'	SCREEN.IgnoreChange True
'	SCREEN.Object("main.OBJ_order.OBJ_odr.ed_focod").data = focod.Data
'	SCREEN.Proc "main.OBJ_order.OBJ_odr.ChangeCode", ""
'	SCREEN.IgnoreChange False

	Call first_send()
End Sub

'***************************************************************************
' DESC: 상단 주문창으로 데이터 넘기기
'***************************************************************************
Sub data_send()
	Dim jqty, code, name

	If StrComp(SCREEN.Object("main.OBJ_order.OBJ_odr.ed_focod").data,ed_focod.Data,1) <> 0 Then

		Select Case Left(ed_focod.Data, 1)
			Case "1", "4", "A", "D"
				name = SCREEN.GetName (101, ed_focod.Data, 0)
			Case "2", "3", "B", "C"
				name = SCREEN.GetName (102, ed_focod.Data, 0)
		End Select
		If Trim(name) =  "" Then
			ed_focod.Data = ""
		Else
			SCREEN.IgnoreChange True
			SCREEN.Object("main.OBJ_order.OBJ_odr.ed_focod").data = ed_focod.Data
			SCREEN.Proc "main.OBJ_order.OBJ_odr.ChangeCode", ""
			SCREEN.IgnoreChange False
		End If
	End If

	If SCREEN.Object("main.OBJ_order.tab_order").ID < 3 Then
		SYSTEM.push "F_ogno", ""
		SYSTEM.push "F_jprc", ""
		VIEWGRID.SetFocus
		Exit Sub
	End If

	SYSTEM.push "F_ogno", ed_ogno.Data
	SYSTEM.push "F_jprc", Trim(VIEWGRID.GetGridCell(VIEWGRID.row, c_jprc))
	SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jqty").data = ed_jqty.Data
	SCREEN.Object("main.OBJ_order.OBJ_odr.OrdCfg").Qty = ed_jqty.Data
	SCREEN.Proc "main.OBJ_order.OBJ_odr.Get_jmno", ""

	SCREEN.SetTimer 1, False
End Sub

