'***************************************************************************
' DESC: 0보다큰 숫자형식인지 검사. 유효숫자( > 0):true else false
'***************************************************************************
Function Is_numeric(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		num = 0
	End If

	Is_numeric = False
	If IsNumeric(num) = False Then
		Exit Function
	End If
	If CDbl(num) <= 0 Then
		Exit Function
	End If

	Is_numeric = True
End Function

