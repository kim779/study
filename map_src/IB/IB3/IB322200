' 가주문
Sub send_o()
	Dim mstr
	If Trim(zFnolsuNo.data) = "" Then
		Call alert_msg("종목코드를 입력하세요")
		zFnolsuNo.SetFocus
		Exit Sub
	End If

	'주문수량 check
	If IOrdQty.Enable = True And Is_numeric(IOrdQty.Data) = False Then
		MsgBox mstr & "수량을 확인하십시오.", , "IBK투자증권"
		IOrdQty.SetFocus
		Exit Sub
	End If

	Select Case zBnsTp.Data
		Case "1" : mstr = "매도"
		Case "2" : mstr = "매수"
		Case "3" : mstr = "정정"
		Case "4" : mstr = "취소"
	End Select

	'주문단가 check
	If dOrdPrc.Enable = True Then
		If Left(zFnolsuNo.Data,3)<>"401" Then
			If Is_numeric(dOrdPrc.Data) = False Then
				MsgBox mstr & "가격을 입력하십시오.", , "IBK투자증권"
				dOrdPrc.SetFocus
				Exit Sub
			End If
		Else
			' Spread종목의 경우 -가 올 수 있으므로 Is_numeric을 쓰지 않는다. lkm 09.06.04
			If IsNumeric(dOrdPrc.Data) = False Then
				MsgBox mstr & "가격을 입력하십시오.", , "IBK투자증권"
				dOrdPrc.SetFocus
				Exit Sub
			End If
		End If
	End If

	LEDGER.Fkey = "C"
	zTrxTp.Data = "3"
	SCREEN.Send 0
End Sub

