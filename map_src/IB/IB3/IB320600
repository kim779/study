Sub Set_account()
	g_hnam.Data = HNAM.Data
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN20.Name
	h_acnm.Data = AN20.Name
	zpwd.Data = AN20.Password
	HNAM.Data = g_hnam.Data
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

