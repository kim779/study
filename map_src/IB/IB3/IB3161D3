_AW_ONDECLARE_AW_
Function make_cal( a )

	If CDbl(a) > 0 Then
		make_cal = "+" & a
	Else
		make_cal = a
	End If

End Function

Sub cal_basis()

' 이론가 대비 계산
If Len(Trim(S101023.Data)) <> 0 And Len(Trim(S101202.Data)) <> 0 Then
	out1.Data = make_cal( CStr( Round((CDbl(Trim(S101023.Data))-CDbl(Trim(S101202.Data))),2) ) )
End If

' 부모에 매수SP, 매도SP, 이론가SP 계산
SCREEN.Proc "parent.cal",""

End Sub

Sub OnAlert()
	cal_basis()
End Sub

