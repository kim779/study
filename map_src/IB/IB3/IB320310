_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	ACNM.Data = AN20.name
	pswd.Data = AN20.password
End Sub
Dim Mydata

Function data_split()
Dim ii

	Mydata = Split(s_data.data, "#", -1, 1) 						' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)					' 한 레코드를 개체별로 자르는중..
		GRID.InsertRow(0)

		GRID.SetGridCell 1, 1, Trim(Mydata(ii)(0))					' chk
		GRID.SetGridCell 1, 2, Trim(Mydata(ii)(1))					' 구분
		GRID.SetGridCell 1, 3, Trim(Mydata(ii)(2))					' 종목명
		GRID.SetGridCell 1, 4, Trim(Mydata(ii)(3))					' 주문유형
		GRID.SetGridCell 1, 5, Trim(Mydata(ii)(4))					' 시장구분
		GRID.SetGridCell 1, 6, Trim(Mydata(ii)(5))					' 매매구분
		GRID.SetGridCell 1, 7, Trim(Mydata(ii)(6))					' 계좌번호
		GRID.SetGridCell 1, 8, Trim(Mydata(ii)(7))					' 비밀번호
		GRID.SetGridCell 1, 9, Trim(Mydata(ii)(8))					' 원주문번호
		GRID.SetGridCell 1, 10, Trim(Mydata(ii)(9))					' 종목코드
		GRID.SetGridCell 1, 11, Trim(Mydata(ii)(10))				' 매입단가(평균단가)
		GRID.SetGridCell 1, 12, Trim(Mydata(ii)(11))				' 주문수량
		GRID.SetGridCell 1, 13, Trim(Mydata(ii)(12))				' 호가잔량
		GRID.SetGridCell 1, 14, Trim(Mydata(ii)(13))				' 주문가격
		GRID.SetGridCell 1, 15, Trim(Mydata(ii)(14))				' 호가구분
		GRID.SetGridCell 1, 16, Trim(Mydata(ii)(15))				' 주문조건
		GRID.SetGridCell 1, 17, Trim(Mydata(ii)(16))				' 정정취소
		GRID.SetGridCell 1, 18, Trim(Mydata(ii)(17))				' 처리구분
	Next

End Function

Sub AllSell()
Dim pre_id, pre_br,ii,jmga

If SYSTEM.ConnectBy = 1 Then
	If LOGIN.Cani = 0 Then
		MsgBox "본사직원은 주문이 불가합니다.",,"IBK투자증권"
		'SCREEN.OnSend = False
		Exit Sub
	End If
End If

SCREEN.Object("OBJ.NREC").Data = NREC.Data
For ii = 1 To NREC.Data
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 1, GRID.GetGridCell (ii, 1)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 2, GRID.GetGridCell (ii, 4)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 3, GRID.GetGridCell (ii, 5)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 4, GRID.GetGridCell (ii, 6)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 5, GRID.GetGridCell (ii, 7)

	If pswd.Enable  = True Then
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 6, Trim(pswd.Data) '''GRID.GetGridCell (ii, 8)
	Else
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 6, GRID.GetGridCell (ii, 8)
	End If

	SCREEN.Object("OBJ.GRID").SetGridCell ii, 7, GRID.GetGridCell (ii, 9)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 8, GRID.GetGridCell (ii, 10)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 9, GRID.GetGridCell (ii, 12)

	jmga = Trim(GRID.GetGridCell (ii, 14))
	If Trim(jmga) = "" Then jmga = "0"
	jmga = jmga * 100
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 10, jmga

	If RADIO8.Checked = True Then
		SCREEN.Object("OBJ.GRID").SetGridCell ii, 11, "03"
	Else
		SCREEN.Object("OBJ.GRID").SetGridCell ii, 11, GRID.GetGridCell (ii, 15)
	End If
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 12, GRID.GetGridCell (ii, 16)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 13, GRID.GetGridCell (ii, 17)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 14, GRID.GetGridCell (ii, 18)
Next
OBJ.Send
End Sub

