'== 주문가능수량 조회 : xval [1:현금가능 ,2:최대가능]
Sub Query_Qty(xval)
	If ed_jprc.Data = 0 Then '주문단가 입력되어있지 않다면..현재가 셋팅
		ed_jprc.SetFocus
	End If

	If SCREEN.GetMapName(1) = "IB105000" Then
		ed_acno.Data = SCREEN.Object("parent.AN18").Data
	Else
		ed_acno.Data = SCREEN.Object("parent.AN1A").Data
	End If

	ed_pswd.Data = SCREEN.Object("parent.ed_pswd").Data

	'== obj:: send_tr(acno, pwd, mmgb, cod2, pric)
	Dim	param, pric

	If ed_jprc.Enable = True Then
		pric = ed_jprc.Data
	Else
		pric = SCREEN.Object("main.obj_sise.2302").Data

		If shogb.Data = "81" Then 			'시간외종가일경우 현재가 세팅. 2009/12/11
			pric = SCREEN.Object("main.obj_sise.2023").Data
		ElseIf shogb.Data = "61" Then		'장개시전시간외종가일경우 전일종가 세팅. 2009/12/11
			pric = SCREEN.Object("main.obj_sise.2320").Data
		End If
	End If

	If shogb.Data = "05" Then '조건부지정가라면
		pric = SCREEN.Object("main.obj_sise.2302").Data
	End If

	param = ed_acno.Data &","& ed_pswd.Data &","& _
			mmgb &","& S1301.Data &","& pric &","& xval

	If R_credit.Checked Then
		OBJ_trust_avol.Proc "send_tr", param&","& Mid(Date,1,4)&Mid(Date,6,2)&Mid(Date,9,2)
	Else
		OBJ_avol.Proc "send_tr", param
	End If

	'OBJ_avol.Proc "send_tr", param
End Sub

Sub Fixdanga()	'금액매매
	Dim BuyQtyGB, BuyFixPrcQty, DanGa, qry

	BuyQtyGB = Trim(OrdCfg.ReadCfg("BuyQtyGB"))

	If BuyQtyGB <> "2" Then
		MsgBox "주문설정에서 매매금액을 설정하여 주십시오",0,"IBK투자증권"
		Exit Sub
	End If

	BuyFixPrcQty = Trim(OrdCfg.ReadCfg("BuyFixPrcQty"))

	If BuyFixPrcQty = "" Then
		Exit Sub
	End If

	If c_hogb.Checked <> True Then
		If  ed_jprc.Data = "000000000" Then
		 	DanGa = Trim(SCREEN.Object("obj_obj_sise.2023").Data)
			ed_jprc.Data = DanGa
		Else
		   	DanGa = ed_jprc.Data
		End If
	Else
		If Trim(SCREEN.Object("obj_obj_sise.2302").Data) <> "" Then
		   DanGa = Trim(SCREEN.Object("obj_obj_sise.2302").Data)
		Else
		   MsgBox "시장가 주문이 불가합니다",0,"IBK투자증권"
		   Exit Sub
		End If
	End If

	If DanGa = "" Then
		Exit Sub
	End If

	qry = CDbl(BuyFixPrcQty) / CDbl(DanGa)
	ed_jqty.Data = Fix(qry)

	OBJ_JUNGSAN.Proc "CalcJungsan", ""
End Sub

