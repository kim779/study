_AW_ONDECLARE_AW_
Sub send_tr(acno, pwd, gubn, mmgb, cod2, pric, ptnc, flag)
'	SCREEN.ClearAll 1, 2

	ed_acno.Data = acno
	zPwd.Data = pwd
	zQryTp.Data = gubn
	zBnsTp.Data = mmgb
	zFnoIsuNo.Data = cod2
	dOrdPrc.Data = pric
	zFnoOrdprcPtnCode.Data = ptnc
	l_avol.Data = flag

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
If zBnsTp.Data="1" Then
	LABEL20.Text = " 매수청산주문가능수량"
	LABEL24.Text = " 총매도주문가능수량"
Else
	LABEL20.Text = " 매도청산주문가능수량"
	LABEL24.Text = " 총매수주문가능수량"
End If

SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
SCREEN.Proc "main.Set_guide", " "

If Trim(ed_acno.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "계좌번호를 확인하세요"
	Exit Sub
End If
If Trim(zPwd.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "비밀번호를 확인하세요"
	Exit Sub
End If
If Trim(zFnoIsuNo.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "종목코드를 확인하세요"
	Exit Sub
End If
If Trim(dOrdPrc.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "주문가를 확인하세요"
	Exit Sub
End If

dRatVal.Data = FormatNumber(dRatVal.data/100000000,8)

'스프레드종목에 대해 마이너스 처리를 해 변경함. 09.06.04 LKM
If Left(zFnoIsuNo.Data, 3)<>"401" And Left(zFnoIsuNo.Data, 3)<>"D01" Then
	dOrdPrc.Data = FormatNumber(dOrdPrc.data/100,2)
Else
	' 에디트 컨트롤이 Numeric타입에 마이너스 값을 가질 경우
	' Data값 안에 공백이 존재하게 된다. 하여 Replace로 공백을 제거하는 루틴을 삽입
	dOrdPrc.Data = FormatNumber( Replace(dOrdPrc.data, " ", "")/100, 2)
	If Left(dOrdPrc.Data, 1)="-" Then
		dOrdPrc_s.Data = "-"
		dOrdPrc.Data = Replace(dOrdPrc.Data, "-", "0")
	Else
		dOrdPrc_s.Data = "+"
	End If
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod),1) > 1 Then
	MsgBox LEDGER.Emsg, , "IBK투자증권"
	SCREEN.CloseWindow
Else
	ldOrdAbleQty.Text = Replace(lOrdAbleQty.Text, "+", "") & " "
	ldNewOrdAbleQty.Text = Replace(lNewOrdAbleQty.Text, "+", "")  & " "
	ldLqdtOrdAbleQty.Text = Replace(lLqdtOrdAbleQty.Text, "+", "")  & " "
End If

