RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Public Today
Today = getCurrDay()

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	ACNM.Data = AN20.Name
	zPwd.Data = AN20.Password

	If Len(Trim(AN20.Data)) <> 11 Then
		AN20.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0,2
	ACNM.Data = AN20.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"
Call Check_LoginType(zPwd)

SCREEN.IgnoreChange True
zQryStrDt.Data = change_date("d", -7)
zQryEndDt.Data = Today
SCREEN.IgnoreChange False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
End If

If CheckInput(AN20, zPwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
Else
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
