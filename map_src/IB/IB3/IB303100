pswd = SCREEN.Object("main.OBJ_ACNT.ed_pswd").Data
Select Case tab_top.ID
Case 2
	OBJ_order.SetObject ("IB303101")
	If tab_bottom.ID = 1 And mapid <> "IB303111" Then
		OBJ2.SetObject ("IB303111")
		If SYSTEM.ConnectBy = "1" Then
			If Len(Trim(pswd)) >= 4 Then
				SCREEN.Proc "main.OBJ2.send_f", ""
			End If
		Else
			SCREEN.Proc "main.OBJ2.send_f", ""
		End If
	End If
Case 1
	OBJ_order.SetObject ("IB303102")
	If tab_bottom.ID = 1 And mapid <> "IB303112" Then
		OBJ2.SetObject ("IB303112")
		If SYSTEM.ConnectBy = "1" Then
			If Len(Trim(pswd)) >= 4 Then
				SCREEN.Proc "main.OBJ2.send_f", ""
			End If
		Else
			SCREEN.Proc "main.OBJ2.send_f", ""
		End If
	End If
Case Else
