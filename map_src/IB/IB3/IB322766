_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False

	If Trim(ed_accn.Data) = "" Or Len(Trim(ed_accn.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If
	If Trim(zpwd.Data) = "" Or Len(Trim(zpwd.Data)) < 4 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Function
	End If

	Error_check = True
End Function

'==계좌번호, 비밀번호 체크
Function l_CheckInput(ed_accn, zpwd)
 	l_CheckInput = False
	If Trim(ed_accn.data) = "" Or Len(Trim(ed_accn.data)) <> 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
 		ed_accn.Setfocus
 		Exit Function
	End If

	If Len(Trim(zpwd.data)) = 0 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
 		zpwd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zpwd.data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
	 		zpwd.Setfocus
	 		Exit Function
		End If
	End If
	l_CheckInput = True
End Function

_AW_ONINDECLARE_AW_
#LOAD IB888833
#LOAD IB888887
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Fkey = "C"
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.clearall 0, 2

ed_accn.Data = Trim(SCREEN.Object("parent.AN20").Data)		'계좌번호
zpwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)	'비밀번호
zOrdDt.Data = Trim(SCREEN.Object("parent.zOrdDt").Data)
EDIT0.Data = Trim(SCREEN.Object("parent.zOrdDt").Data)
' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = 1 Then
	If Error_check() = False Then				'주문전 Error Check
		SCREEN.OnSend = False
		LEDGER.Fkey = "C"
		Exit Sub
	End If
Else
	zpwd.Data = "9999"
End If

If l_CheckInput(ed_accn, zpwd) = True Then
	SCREEN.ClearAll 0, 2
	SCREEN.onsend = True
Else
	SCREEN.ClearAll 0, 2
	zpwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable True
	next_btn.SetFocus
Else
	next_btn.Enable False
	send_btn.SetFocus
End If

