Sub SetDic()
	Dim sCode, sGubn, sDate, jGubn, row, key
	list.RemoveAll
	For row = 1 To VIEWGRID.Rows
		sCode = Trim(VIEWGRID.GetGridCell (row, 2))
		sGubn = Trim(VIEWGRID.GetGridCell (row, 15))
		sDate = Trim(VIEWGRID.GetGridCell (row, 16))
		jGubn = Trim(VIEWGRID.GetGridCell (row, 4))

		key = sCode & sGubn & sDate & jGubn
		SYSTEM.Trace "key : " & key
		If list.Exists(key) Then
			SYSTEM.Trace "SetDIC list key exist"
		Else
			list.Item(key) = row
		End If
	Next
End Sub

'***************************************************************************
'	Func : Find_Row
'***************************************************************************
Function Find_Row(sKey)
	Dim sCode, sGubn, sDate, jGubn,row, key

	jGubn = Trim(Mid(skey, 1, 2))		'잔고구분
	sCode = Trim(Mid(sKey, 3, 12))	'코드
	sDate = Trim(Mid(sKey, 15, 8))	'대출일
	sGubn = Trim(Mid(sKey, 23, 2))	'신용구분

	key = sCode & sGubn & sDate & jGubn
	If list.Exists(key) Then
		row = list.Item(key)
		Find_Row = row
	Else
		Find_Row = 0
		SYSTEM.Trace "Find_row is 0"
	End If

	Find_Row = row
End Function

