'***************************************************************************
' DESC: 0보다큰 숫자형식인지 검사. 유효숫자( > 0):true else false
'***************************************************************************
Function Is_numeric(data)
	Dim number
	number = Trim(data)

	If number = "" Then
		number = 0
	End If

	Is_numeric = False
	If IsNumeric(number) = False Then
		Exit Function
	End If
	If CDbl(number) <= 0 Then
		Exit Function
	End If

	Is_numeric = True
End Function

''*************************************************
''send ui data
''*************************************************
Sub f_vSendUiData()
	Dim accn, pass,tax,mmd

	SCREEN.OnSend False
	VIEWGRID.Clear

	If cbo_mmd.Index = 0 Then
		mmd = out_hts.data
	ElseIf cbo_mmd.Index = 1 Then
		mmd = out_call.data
	ElseIf cbo_mmd.Index = 2 Then
		mmd = out_ars.data
	End If

'	If CheckInput(AN1A, pswd) = False Then
'		SCREEN.ClearAll 0, 2
'		ACNM.Data = AN1A.name
'		pswd.SetFocus
'		Exit Sub
'	Else
		accn = Trim(AN1A.Data)						'계좌번호
		pass = Trim(pswd.Data)						'비밀번호
		tax = cbo_tax.data
'		SYSTEM.Trace " f_vSendUiData()"

		If Len(accn) <> 11 Then
			accn = Trim(SCREEN.Object("main.OBJ_order.AN1A").Data)
			If Len(accn) <> 11 Then
				SCREEN.Object("main.guide").text = "계좌번호를 확인해 주십시오."
				Exit Sub
			End If
		End If

		If Len(pass) < 4 Then
			If SYSTEM.ConnectBy = "0" Then
				pass = "9999"
			Else
				pass = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)
			End If
			If Len(pass) < 4 Then
				SCREEN.Object("main.guide").text = "비밀번호를 확인해 주십시오."
				Exit Sub
			End If
		End If

		If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
			If cxMarket.sMarket = "KRX" Then
				Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, ctype, "1")
			ElseIf cxMarket.sMarket = "NXT" Then
				Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, ctype, "2")
			ElseIf cxMarket.sMarket = "통합" Then
				Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, ctype, "3")
			End If
		End If

		If UCase(TypeName( SCREEN.Object("Main.1301"))) <> "NOTHING" Then
			cxMarket.sCode = SCREEN.Object("Main.1301").Data
		End If


	SCREEN.Wait = True
End Sub

