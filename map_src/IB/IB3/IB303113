'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Error_check = False
	If Trim(ed_accn.Data) = "" Then
		SCREEN.Object("main.OBJ_ACNT.AN20").SetFocus
		Call guide_msg("선물 계좌번호를 확인하십시오")
		Exit Function
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(ed_pswd.Data)) < 4 Then
			SCREEN.Object("main.OBJ_ACNT.ed_pswd").SetFocus
			Call guide_msg("비밀번호를 확인하십시오")
			Exit Function
		End If
	End If
	Error_check = True
End Function

Sub Password_setting(ed_str) 		' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "1" Then
		ed_str.Data = SCREEN.Object("main.OBJ_ACNT.ed_pswd").Data
	Else
		ed_str.Data = "9999"
	End If
End Sub

