_AW_SCRIPT_AW_(RADIO6)
_AW_ONCLICK_AW_
Dim Day1, Day2, mm, dd

Day2 = getDateSerial(edate.Data)
Day1 = DateAdd("m", -1, Day2)

If Month(Day1) < 10 Then
	mm = "0" & Month(Day1)
Else
	mm = Month(Day1)
End If

If Day(Day1) < 10 Then
	dd = "0" & Day(Day1)
Else
	dd = Day(Day1)
End If

sdate.data = Year(Day1) & mm & dd
Call send_f()
_AW_ONENDSUB_AW_
