Function MakeQty(str)
	If Trim(str) = "" Then
		MakeQty = "+000000000000000"
		Exit Function
	End If
	str = "+"&Mid(str,2)

	MakeQty = str
End Function

Function MakeJuNo(str)
	Dim slen
	If Trim(str) = "" Then
		MakeQty = "+000000000"
		Exit Function
	End If
	str = Trim(Mid(str,2))
	slen = Len(str)
	For ii=slen+1 To 9
		str = "0"&str
	Next


	str = "+"&str

	MakeJuNo = str
End Function

Function MakePrice(str)
	If Trim(str)="" Then
		MakePrice = "+000000000.00"
		Exit Function
	End If
	str = "+"&Mid(str, 3,Len(str)-4)&"."&Mid(str, Len(str)-1,2)

	MakePrice = str
End Function

Sub DoModify(tval)
	Dim trow, irow, ii, val, chk, val_cnt, juno
	SCREEN.Object("main.OBJ_MODIFY.zFundId").data = Mid(SCREEN.Object("main.OBJ_ODR.cmb_fund").Data,2)
	trow = GRID0.rows
	SCREEN.Object("main.OBJ_MODIFY.in2").data = CStr(trow)

	If trow > 0 Then
		val_cnt = 1
		Call SCREEN.Object("main.OBJ_MODIFY.Grid0").Clear
		SCREEN.Object("main.OBJ_MODIFY.Grid0").SetRows trow
		For ii = 1 To trow
			chk = GRID0.GetGridCell(ii, 14)
			If chk = 1 Then
				Call SCREEN.Object("main.OBJ_MODIFY.Grid0").SetGridCell(val_cnt, 1,  GRID0.GetGridCell(ii, 1))
				Call SCREEN.Object("main.OBJ_MODIFY.Grid0").SetGridCell(val_cnt, 2,  "")
				Call SCREEN.Object("main.OBJ_MODIFY.Grid0").SetGridCell(val_cnt, 3,  GRID0.GetGridCell(ii, 5))
				val = GRID0.GetGridCell(ii, 2)
				val = makejuno(val)
				Call SCREEN.Object("main.OBJ_MODIFY.Grid0").SetGridCell(val_cnt, 4,  val)
				If tval=1 Then
					Call SCREEN.Object("main.OBJ_MODIFY.Grid0").SetGridCell(val_cnt, 5,  "00")
				ElseIf tval=0 Then
					Call SCREEN.Object("main.OBJ_MODIFY.Grid0").SetGridCell(val_cnt, 5,  "03")
				End If
				val = GRID0.GetGridCell(ii, 16)

				val = makeqty(val)

				Call SCREEN.Object("main.OBJ_MODIFY.Grid0").SetGridCell(val_cnt, 6,  val)'"+000000000000002")
				val = GRID0.GetGridCell(ii, 15)
				If tval=1 Then
					val = makeprice(val)
				ElseIf tval=0 Then
					val = makeprice("")
					Call GRID0.SetGridCell(ii, 15, "+000000000.00")
				End If
				Call SCREEN.Object("main.OBJ_MODIFY.Grid0").SetGridCell(val_cnt, 7,  val)'"+000000203.05")'
				Call GRID0.SetGridCell(ii, 17, "")
				Call GRID0.SetGridCell(ii, 18, "")
				val_cnt = val_cnt+1
			End If
		Next
		SCREEN.Object("main.OBJ_MODIFY.Grid0").SetRows val_cnt-1
		SCREEN.Object("main.OBJ_MODIFY.in2").data = CStr(val_cnt-1)
	End If
	If OrderConform(tval) Then
		Call SCREEN.Object("main.OBJ_MODIFY").Send
	End If
End Sub

Function OrderConform(tval)
	If CHECK1.Checked Then
		OrderConform = True
		Exit Function
	End If
	Dim acnt, cnt, code, jprc, s_data, mmgb, hogb, ret, jqty, ii, cf, Orno

	For ii = 1 To GRID0.Rows
		If GRID0.GetGridCell(ii ,14) = 1 Then
			cnt = cnt + 1
			Orno = GRID0.GetGridCell(ii, 2)			'원부문번호
			acnt = GRID0.GetGridCell(ii, 1)			'계좌번호
			mmgb = GRID0.GetGridCell(ii, 4)			'매매구분
			If tval = 1 Then
				hogb = "지정가"
			Else
				hogb = "시장가"
			End If
			code = GRID0.GetGridCell(ii, 5)			'종목코드
			jqty = GRID0.GetGridCell(ii, 16)			'주문수량
			jprc = GRID0.GetGridCell(ii, 15)			'주문단가

			s_data = "#" & s_data
			s_data = jprc & "|" & s_data				'주문단가
			s_data = jqty & "|" & s_data				'주문수량
			s_data = code & "|" & s_data				'종목코드
			s_data = hogb & "|" & s_data				'호가구분
			s_data = mmgb & "|" & s_data				'매매구분
			s_data = Orno & "|" & s_data				'원주문번호
			s_data = acnt & "|" & s_data				'계좌번호
		End If
	Next

	If cnt > 0 Then
		SYSTEM.Push "num", cnt
		'SCREEN.CreateWindow 2, "IB310103 /p5 /d", "s_data" & vbTab & s_data
		SCREEN.CreateWindow 2, "IB315396 /p5 /d", "s_data" & vbTab & s_data & vbLf
	End If
	cf = SYSTEM.Pop("C3153")
	If cnt = 0 Then
		MsgBox "주문 낼 항목을 선택하십시오.",,"IBK투자증권"
		cf = "NO"
	End If
	If cf = "OK" Then
		OrderConform = True
	Else
		OrderConform = False
	End If
End Function

