	SCREEN.Object("main.OBJ_CANCEL.in2").data = CStr(trow)

	If trow > 0 Then
		val_cnt = 1
		Call SCREEN.Object("main.OBJ_CANCEL.Grid0").Clear
		SCREEN.Object("main.OBJ_CANCEL.Grid0").SetRows trow
		For ii = 1 To trow
			chk = GRID0.GetGridCell(ii, 14)
			If chk = 1 Then
				Call SCREEN.Object("main.OBJ_CANCEL.Grid0").SetGridCell(val_cnt, 1,  GRID0.GetGridCell(ii, 1))
				Call SCREEN.Object("main.OBJ_CANCEL.Grid0").SetGridCell(val_cnt, 2,  "")
				Call SCREEN.Object("main.OBJ_CANCEL.Grid0").SetGridCell(val_cnt, 3,  GRID0.GetGridCell(ii, 5))
				val = GRID0.GetGridCell(ii, 2)
				val = makejuno(val)
				Call SCREEN.Object("main.OBJ_CANCEL.Grid0").SetGridCell(val_cnt, 4,  val)

				val = GRID0.GetGridCell(ii, 16)
				val = makeqty(val)
				Call SCREEN.Object("main.OBJ_CANCEL.Grid0").SetGridCell(val_cnt,5,  val)'"+000000000000002")
				Call GRID0.SetGridCell(ii, 17, "")
				Call GRID0.SetGridCell(ii, 18, "")
				val_cnt = val_cnt+1
			End If
		Next
		SCREEN.Object("main.OBJ_CANCEL.Grid0").SetRows val_cnt-1
		SCREEN.Object("main.OBJ_CANCEL.in2").data = CStr(val_cnt-1)
	End If
	If OrderConform2() Then
		Call SCREEN.Object("main.OBJ_CANCEL").Send
	End If
End Sub

Sub LoadCfg()
	Dim ii, str
	If SCREEN.CreateObject("Info") Then
		str = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB315300", "config"))
		If Len(str) < 6 Then
			str = "000001"
		End If
		For ii=0 To 5

			If Mid(str, ii+1, 1) = "1" Then
				SCREEN.Object("CHECK"&CStr(ii)).Checked = True
			Else
				SCREEN.Object("CHECK"&CStr(ii)).Checked = False
			End If
		Next
		'INFO.PushData LOGIN.Name, "userconf.ini", "IB315300", "config", str
	End If
End Sub

