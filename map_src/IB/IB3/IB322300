_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.Data = AN20.Password
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If
	Call send_f()
End Sub

'== 조회
Sub send_f()
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 다음
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub


Sub passchk()
	SCREEN.Object("chk_pass.IntaccNo").data = AN20.data
	SCREEN.Object("chk_pass.Pwd").data = zPwd.data
	chk_pass.Send
End Sub

Sub passPW()
	Call send_f()
End Sub

Sub NopassPW()
	zPwd.Clear
	zPwd.SetFocus
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

	' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
	   zPwd.Data = "9999"
	End If

If CheckInput(AN20, zPwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
Else
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'비밀번호 오류시
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2,2
	ACNM.Data = AN20.Name
	zPwd.Clear
	zPwd.SetFocus
ElseIf Left(Trim(LEDGER.Ecod), 1) = "0" Then
	Dim ii, var
	For ii = 1 To GRID0.Rows
		var = Trim(GRID0.GetGridCell(ii, 10))

		If var = "매수" Then
			GRID0.SetTRgb ii, 10, 94
		Else
			GRID0.SetTRgb ii, 10, 95
		End If
	Next
End If

If selection.Data = "1" Then
	zPwd.SetFocus
ElseIf selection.Data = "2" Then
	send_btn.SetFocus
ElseIf selection.Data = "3" Then
	next_btn.SetFocus
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN20)
_AW_ONCHANGE_AW_
Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	selection.Data = "1"
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


