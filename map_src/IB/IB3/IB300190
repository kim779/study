Sub order_tab_change()
	If Left(SCREEN.GetMapName(1),5) = "IB301" Then	'== 미니주문
		SCREEN.Proc "main.order_mini_change", ""
	End If
		Select Case tab_order.ID
		Case "1" : OBJ_odr.SetObject("IB300150")
		Case "2" : OBJ_odr.SetObject("IB300160")
		Case "3" : OBJ_odr.SetObject("IB300170")
		Case "4" : OBJ_odr.SetObject("IB300180")
		End Select

	If SCREEN.GetMapName(1) = "IB330000" Or SCREEN.GetMapName(1) = "IB300100" Then
		If tab_order.ID = 1 Then
			mdpanel.Visible = True
			mspanel.Visible = False
			jcpanel.Visible = False
		ElseIf tab_order.ID = 2 Then
			mdpanel.Visible = False
			mspanel.Visible = True
			jcpanel.Visible = False
		Else
			mdpanel.Visible = False
			mspanel.Visible = False
			jcpanel.Visible = True
		End If
	End If

	If SYSTEM.Pop("accountdata") <> "" Then
		SCREEN.SetTimer 3, False
	End If
End Sub

