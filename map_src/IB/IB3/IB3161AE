	Flag = 0
	For i = 1 To S104310.Rows
		AccVol = S104310.GetGridCell(i, 8)
		If Len(Trim(AccVol)) = 0 Then
			Exit For
		ElseIf CLng(AccVol) = g_BefAccVol Then
			Flag = 1
			Exit For
		End If
	Next

	If Flag = 1 And i - 1 >= 1 Then
		j = i - 1
		Do While(1)
			If j <= 0 Then
				Exit Do
			End If
			ArrData = Array("", "", "", "", "", "", "", "", "", "", "", "")
			'0:시간 혹은 일자
			'1:시가, 2:고가, 3:저가, 4:종가
			'5:전일대비, 6:체결량, 7:거래량
			'8:미결제, 9:미결제증감, 10:Basis, 11:현물가

			Dim f, s, out

			If Trim(S104310.GetGridCell (1, 11)) = "" Then
				f = 0
			Else
				f = CDbl(Trim(S104310.GetGridCell (1, 11)))
			End If

			If Trim(S104310.GetGridCell (2, 11)) = "" Then
				s = 0
			Else
				s = CDbl(Trim(S104310.GetGridCell (2, 11)))
			End If

			out = f - s
'			SYSTEM.Trace "3161=["&out&"]"
			ArrData(0) = (S104310.GetGridCell(j,1))
			ArrData(1) = (S104310.GetGridCell(j,2))
			ArrData(2) = (S104310.GetGridCell(j,3))
			ArrData(3) = (S104310.GetGridCell(j,4))
			ArrData(4) = (S104310.GetGridCell(j,5))
			ArrData(5) = (S104310.GetGridCell(j,6))
			ArrData(6) = (S104310.GetGridCell(j,7))
			ArrData(7) = (S104310.GetGridCell(j,8))
			ArrData(8) = (S104310.GetGridCell(j,9))
			ArrData(9) = (out)
			ArrData(10) = (S104310.GetGridCell(j,12))
			ArrData(11) = (S104310.GetGridCell(j,13))

			Data = Join(ArrData, "|")
			SCREEN.Proc "parent.ProcSetData", Data
			j = j - 1
		Loop
	End If
		If Trim(S104310.GetGridCell(1,8)) = "" Then
		g_BefAccVol = 0
	Else
		g_BefAccVol = CLng(S104310.GetGridCell(1,8))
	End If

