'-----------------------------------------------------------------------
Function Str2Int(Data)
	Str2Int = 0
	AData = Trim(Data)
	If Len(AData) = 0 Then
		Exit Function
	End If
	Str2Int = CLng(AData)
End Function
'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	If Data > 0 Then
		SetSign = "+" & Data
	End If
End Function
'-----------------------------------------------------------------------
Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function
