'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.Data = AN20.Password
	If Len(Trim(AN20.Data)) <> 11 Then
		AN20.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0,2
	ACNM.Data = AN20.Name
	HNAM.Data = Trim(g_hnam.Data)
	LEDGER.Fkey = "C"
	SCREEN.Send 0
	count.Data = 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
	count.Data = count.Data + 1
