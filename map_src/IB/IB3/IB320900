global_var = 0
SCREEN.OnSend = False

	' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
	   zPwd.Data = "9999"
	End If
	
If CheckInput(AN20, zPwd) = True Then
	SCREEN.onsend = True
	global_var = 1
	SCREEN.Object("OBJECT0.account").data = AN20.Data
	SCREEN.Object("OBJECT0.zPwd").data = zPwd.Data
	SCREEN.Object("OBJECT0.zPdGrpCode").data = zPdGrpCode.Data
