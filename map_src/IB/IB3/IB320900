_AW_ONDECLARE_AW_
Dim global_var

'== 계좌명, 비밀번호 설정
Sub Set_account()
	GRID.Clear
	ACNM.Data = AN20.Name
	zPwd.Data = AN20.Password
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.Object("OBJECT0.LEDGER").Fkey = "C"

	SCREEN.Send 0
End Sub

