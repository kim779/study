_AW_ONDECLARE_AW_
Dim ii, tmpAA, tmp, splSign, strEdits, divEdits
' dCsgnMgnrat   위탁증거금 에디트 박스
' CC  위탁 증거금 입력단 에디트 박스
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False

'==== 소숫점 자릿수 맞추는 부분 : 입력 형식 XXX.XX =============================
'======= IB350100 과 동일 ======================================================
 	If InStr(CC.data, ".") = 0 Then		'정수만 입력됐다는 의미

 		tmp = Split(CC.data," ")
 		tmpAA = tmp(0) + ".00"
 		CC.Data = tmpAA
 		dCsgnMgnrat.Data = "+" & l_zeropad(CC)
 	Else
 		tmp = Split(CC.Data, ".")
 		editint.Data = tmp(0)
 		editfloat.Data = tmp(1)
 		editint.Data = l_zeropad(editint)

 		If InStr(editfloat.Data, " ") = 2 Then
 			editfloattmp.Data = editfloat.Data
 			dCsgnMgnrat.Data = "+" + editint.Data + "." + editfloattmp.Data + "0"
 		Else
 			dCsgnMgnrat.Data = "+" + editint.Data + "." + editfloat.Data
 		End If
 	End If
'======== 소숫점 자리수 설정 부분 끝 ===========================================
'======== 입력단에 +, - 기호 들어올 경우의 부호 입력 처리 ======================
'======== 기본적으로 "000" 천단위 숫자임 =======================================

 	strEidts = AA.Data + "|" + BB.Data   '반복문으로 처리하기 위해 입력값들을 한데 모음
 	divEdits = Split(strEidts, "|")		'반복문 처리를 위해 | 를 구분으로 배열로 만듬

	tmpResult = "|" + "|"			'최종 결과값을 저장할 변수 생성
	tmpResult = Split(tmpResult, "|") '최종 결과값을 반복문으로 저장할 수 있게 배열로 만듬

 For ii=0 To 1
 	chkSign.Data = divEdits(ii) '첫째자리의 부호여부와, 부호값을 검사하기 위해 한자리 크기의 에디트 박스에 넣음
 	noSign.Data = divEdits(ii) '첫째자리에 부호가 없을 경우 대비

 	If chkSign.Data = "-" Then		'- 부호라면
		splSign = Split(divEdits(ii), "-")	'- 부호 앞뒤를 기준으로 나누어
		tmpData.Data = splSign(1) '뒷부분에는 실데이터값(부호제외) 들어있으므로 - (부호부분은 이미 위에서 split함수로 제거)
		tmpResult(ii) = "-" & l_zeropad(tmpData) '- 부호를 붙인후에 값을 출력

	ElseIf 	chkSign.Data = "+" Then ' + 부호는 - 부호와 동일하게 처리
		splSign = Split(divEdits(ii), "+")
		tmpData.Data = splSign(1)
		tmpResult(ii) = "+" & l_zeropad(tmpData)
 	Else
 		tmpResult(ii) = "+" & l_zeropad(noSign)  ' 부호없이 입력된 것들은 그래도 + 만 붙여서 출력
 	End If
 Next
 lTotEvalPnlSrtSect.Data = tmpResult(0)
 lTotEvalPnlEndSect.Data = tmpResult(1)

SCREEN.Send 0

End Sub



