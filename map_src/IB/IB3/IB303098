RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sCode
sCode = ""

Sub first_send()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub continue_send()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub send_tr(acno, cod2)
	SCREEN.ClearAll 0, 2
'	brnNo.Data = Left(acno, 3)
	ed_accn.Data = acno
	sCode = cod2
	
	If SYSTEM.ConnectBy = 0 Then
		ed_pswd.Data = "9999"
	Else
		ed_pswd.Data = SCREEN.Object("main.OBJ_order.ed_pswd").Data
	End If
	 
	first_send()
End Sub


'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False

	If Trim(ed_accn.Data) = "" Or Len(Trim(ed_accn.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(ed_pswd.Data) = "" Or Len(Trim(ed_pswd.Data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하십시오."
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Exit Function
		End If
	End If

	ret = P_pswdConfirm(ed_accn.data, ed_pswd.data, msg)
	If ret <> True Then
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		SCREEN.Object("main.GUIDE").Text = msg
		Exit Function
	End If

	Error_check = True
End Function

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.Object("Main.GUIDE").Text = ""

If Trim(ed_accn.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "선물계좌번호를 확인하세요"
	SCREEN.Object("parent.AN20").SetFocus
	Exit Sub
End If

If Trim(ed_pswd.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "비밀번호를 확인하세요"
	SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
	Exit Sub
End If

If Trim(sCode) = "" Then
	SCREEN.Proc "main.Set_guide", "종목코드를 확인하세요"
	SCREEN.Object("parent.1301").SetFocus
	Exit Sub
End If

If Error_check() = False Then				'주문전 Error Check
	SCREEN.OnSend = False
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim codx, data

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
	Call alert_msg(Trim(LEDGER.Emsg))
	Exit Sub
End If

If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If LEDGER.Next = "Y" Then
		continue_send()
	Else
		data = 0
		
		For ii = 1 To GRID0.Rows
		
			codx = Trim(GRID0.GetGridCell(ii,2))
			
			If Len(codx) = 7 Then
				codx = Mid(codx, 2)
			End If
			
			If codx = sCode Then
				data = Trim(GRID0.GetGridCell(ii,13))	'해지가능수량이 가능수량으로 세팅
				Exit For
			End If		
		Next
		
		If data = "" Then
			data = 0
		End If
		
		SCREEN.Proc "parent.set_avol", data		
			
	End If

End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim codx, jqty, jprc

If GRID0.HitPos <> 3 Then
	Exit Sub
End If

codx = Trim(GRID0.GetGridCell(GRID0.row, 3))	'종목코드
jqty = ""
Select Case GRID0.Column
Case 9, 13 '지정 / 해지가능 수량
	jqty = Trim(GRID0.GetGridCell(GRID0.row, GRID0.Column)) 	'주문수량
Case 3, 4 '종목코드/명
	jqty = "0"
Case Else
	Exit Sub
End Select

If codx = "" Then
	Exit Sub
End If

SCREEN.Object("main.OBJ_order.tab_order").id = 7
SCREEN.Proc "main.OBJ_order.order_tab_change", ""		' 해지/지정 탭으로

SCREEN.Object("main.1301").Data = codx
SCREEN.Proc "main.send_sise_all", "account"

SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jqty").Data = jqty
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
first_send()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_next)
