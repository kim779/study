'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.Data = AN20.Password
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call johoi()
End Sub

Function l_zeropd(ed_str)
	Dim sln, str
	str = Trim(ed_str)
	If str = "" Then
		l_zeropd = "000000000000000"
		Exit Function
	End If
	l_zeropd = String(Len(ed_str) - Len(str), "0") & str
End Function

'== 조회
Sub johoi()
	'In2까지만 업
	'위탁금 출력
	In2_2.Data = "0000"
	btn_check.Data = "1"
	SCREEN.Send 0
End Sub

'==모두 청산조회
Sub allselljhoi()
	'그리드까지 업
	'위탁증거금 출력
	GRID_in.Clear
	btn_check.Data = "2"


	'Rows 계산
	Dim var, i, j, count
	count = 0
	For i = 1 To GRID_out.Rows
		var = Trim(GRID_out.GetGridCell(i, 1))
		If var <> "" Then
			count = count + 1
		End If
	Next

	'output그리드 -> input그리드 데이터 복사
	For i = 1 To count
		For j = 1 To GRID_out.Columns
			var = GRID_out.GetGridCell(i, j)

			If j = 5 Then
				GRID_in.SetGridCell i, 5, l_zeropd(var)
				GRID_in.SetGridCell i, 7, l_zeropd(var)
			ElseIf j = 7 Then

			ElseIf j = 9 Then
				GRID_in.SetGridCell i, j, l_zeropd(var)
			Else
				GRID_in.SetGridCell i, j, var
			End If
		Next
	Next

	In2_2.Data = count
	In2_2.Data = l_zeropd(In2_2.Data)

	SCREEN.Send 0
End Sub

