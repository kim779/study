'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim ret, msg
	GUIDE.Text = ""
	Error_check = False
	S901.Clear
	VIEWGRID.Clear

	If CheckInput(AN20, zPwd) = False Then
		Exit Function
	End If

	ret = P_pswdConfirm(AN20.data, zPwd.data, msg)
	If ret <> True Then
		zPwd.SetFocus
		GUIDE.Text = msg
		Exit Function
	End If

	Error_check = True
End Function

