Sub OnDllValue(sData)
	Dim slist
	slist = Split(sData, vbTab, -1, 1)
	Select Case slist(0)
		Case "SetValue"	'send
			'AccNo-slist(1), PWD-slist(2)
			AN20.Data = slist(1)
			zPwd.Data = slist(2)
			Call first_send()
		Case "MoveWnd"	'resize
			ResizeControl CLng(slist(1)), CLng(slist(2))
		Case "Reset"	'reset
			AN20.Data = ""
			zPwd.Data = ""
			S901.Clear
			VIEWGRID.Clear
		Case "POPUP"
			AN20.Data = slist(1)
			zPwd.Data = slist(2)
			If xval = 0 Then
				jjsend()
			Else
				ccsend()
			End If
	End Select
End Sub

Function ResizeControl(iwidth, iheight)
	Dim igridw, arRate, idx, lval, lcalc, ileft
	PANEL_bg.SetRect 0, 0, iwidth, 25 '상

	ileft = iwidth - 128 - 37 '60+60++1

	btn_m.SetRect ileft, 3, ileft+60, 23
	ileft = ileft + 60 + 1
	btn_c.SetRect ileft, 3, ileft+60, 23
	ileft = ileft + 60 + 1
	next_btn.SetRect ileft, 3, ileft+36, 23
	ileft = ileft + 36 + 1

	PANEL63.SetRect -4, 25, iwidth +4, iheight+1
	VIEWGRID.SetRect 6, 35, iwidth - 6, iheight-10
	'그리드 컬럼너비조정
	arRate = Array(0.09358, 0.30481, 0.163101, 0.15775, 0.14705, 0.13368)

	igridw = iwidth - 15 - 20 'left, right space, checkcolumn
	igridw = igridw - 16 '스크롤너비
	idx = 0
	For ii = 2 To VIEWGRID.Columns

		lval = VIEWGRID.GetColumnWidth(ii)

		If  lval > 0 And VIEWGRID.IsColumnVisible(ii) Then
			lcalc = CDbl  (arRate(idx) ) * CDbl(igridw)
			idx = idx + 1
			VIEWGRID.SetColumnWidth ii, CLng(lcalc)
		End If

	Next
	VIEWGRID.Refresh
End Function

