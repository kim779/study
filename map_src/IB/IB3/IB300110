_AW_ONDECLARE_AW_
Sub OnAlert()
	If ( SCREEN.Object("parent.OBJ_order.tab_order").ID = "1" Or SCREEN.Object("parent.OBJ_order.tab_order").ID = "2") Then
		If SCREEN.Object("parent.OBJ_order.OBJ_odr.CHK_auto").Checked = True And SCREEN.Object("parent.OBJ_order.OBJ_odr.r_hogb0").Checked Then
			If SCREEN.Object("parent.OBJ_order.OBJ_odr.flash_fg").Data = 0 Then
				Dim code
				code = Left(SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_focod").Data, 1)
				If code = "1" Or code = "4" Then
					Select Case SCREEN.Object("parent.OBJ_order.OBJ_odr.cboPrice").Data
						Case "025" : SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_jprc").Data = S31025.Data
						Case "023" : SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_jprc").Data = S31023.Data
						Case "026" : SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_jprc").Data = S31026.Data
					End Select
				End If
			End If
		End If
	End If
End Sub

