Sub SettHoga()
	If Left(Trim(ed_fcod.Data), 3) = "186" Or Left(Trim(ed_fcod.Data), 3) = "486" Or _
	   Left(Trim(ed_fcod.Data), 3) = "A86" Or Left(Trim(ed_fcod.Data), 3) = "D86" Then
		r_hogb0.Checked = True
		r_hogb1.Enable = False
		c_hogb.Data = "00"
		c_hogb.Enable = False
	Else
		r_hogb1.Enable = True
		c_hogb.Enable = True
	End If
End Sub

Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		BTN_JQTY_1.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_1"))
		BTN_JQTY_2.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_2"))
		BTN_JQTY_3.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_3"))
		BTN_JQTY_4.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_4"))
		If BTN_JQTY_1.Text="" Then BTN_JQTY_1.Text = 0 End If
		If BTN_JQTY_2.Text="" Then BTN_JQTY_2.Text = 10 End If
		If BTN_JQTY_3.Text="" Then BTN_JQTY_3.Text = 50 End If
		If BTN_JQTY_4.Text="" Then BTN_JQTY_4.Text = 100 End If
	End If
	Call SaveConfig()
End Sub

Sub SaveConfig()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_1", BTN_JQTY_1.Text
		INFO.PushData LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_2", BTN_JQTY_2.Text
		INFO.PushData LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_3", BTN_JQTY_3.Text
		INFO.PushData LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_4", BTN_JQTY_4.Text
	End If
End Sub

Sub ChangeMMgb()
	mmgb = ed_mmgb.Data
	If mmgb = "1" Then
		PANEL3.PRgb = 171
		RADIO1.Checked = True
	Else
		PANEL3.PRgb = 170
		RADIO0.Checked = True

	End If


End Sub

Sub LoadinterCode()
	If SCREEN.CreateObject("INFO") Then
		Dim jqty, y, x, tmp

		For y=1 To 4
			jqty = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB316100", "btn_inter"&y))
			Select Case y
				Case 1
				  btn_inter1.text = jqty
				Case 2
				  btn_inter2.text = jqty
				Case 3
				  btn_inter3.text = jqty
				Case 4
				  btn_inter4.text = jqty
			End Select
		Next
	End If
End Sub

