RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999922) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "2"

Const myFILE = "userconf.ini"

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder(tp)
	Dim hogb, cPos, prc, dmsg, odgb, curr, tmpCode
	If ed_mmgb.Data <> tp Then
		MsgBox "주문구분이 일치하지 않습니다.", ,"IBK투자증권"
		Exit Sub
	End If
	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If


	If tmpCode = "185" Or tmpCode = "186" Or tmpCode = "187" Or tmpCode = "485" Or tmpCode = "486" Or tmpCode = "487" Or _
	   tmpCode = "A85" Or tmpCode = "A86" Or tmpCode = "A87" Or tmpCode = "D85" Or tmpCode = "D86" Or tmpCode = "D87" Then
		prc = ed_jprc.Data
	Else
		prc = FormatNumber((ed_jprc.Data)/100, 2, -1, 0)
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(c_hogb.Text, 4)		'매매구분
		odgb = Mid(c_hogb.Data,1,1)
		curr = "( " & Trim(SCREEN.Object("main.OBJ_SISE.101023").data) & " )"
		If odgb = "0" Then
			odgb = "일반"
		ElseIf odgb = "1" Then
			odgb = "IOC"
		ElseIf odgb = "2" Then
			odgb = "FOK"
		End If
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & ed_fcod.Data & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & CCur(ed_jqty.Data) & vbLf &_
			"o_jprc" & vbTab & prc & vbLf &_
			"o_odgb" & vbTab & odgb & vbLf &_
			"o_curr" & vbTab & curr & vbLf
		If tp = "1" Then
			SCREEN.CreateWindow 2, "IB316191 /p5 /d", dmsg
			If SYSTEM.Pop("fo_mado_order") <> "OK" Then
				Exit Sub
			End If
		Else
			SCREEN.CreateWindow 2, "IB316192 /p5 /d", dmsg
			If SYSTEM.Pop("fo_masu_order") <> "OK" Then
				Exit Sub
			End If
		End If
	End If
