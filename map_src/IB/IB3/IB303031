_AW_ONRECEIVE_AW_
Dim codx

If LEDGER.Next = "Y" Then
	b_next.Enable = True
Else
	b_next.Enable = False
End If

For ii = 1 To GRID0.Rows
	codx = Trim(GRID0.GetGridCell(ii,2))
	If codx = "" Then
		Exit For
	End If
	
	If Len(codx) = 7 Then
		GRID0.SetGridCell ii, 3, Mid(codx, 2,6)
	Else
		GRID0.SetGridCell ii, 3, codx
	End If
	
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim codx, jqty, jprc

Select Case GRID0.HitPos
Case 3	' 데이터부
	codx = Trim(GRID0.GetGridCell(GRID0.row, 3))	'종목코드
	jqty = ""
	Select Case GRID0.Column
	Case 9, 13 '지정 / 해지가능 수량
		jqty = Trim(GRID0.GetGridCell(GRID0.row, GRID0.Column)) 	'주문수량
	Case 3, 4 '종목코드/명
		jqty = "0"
	Case Else
		Exit Sub
	End Select
	
	If codx = "" Then
		Exit Sub
	End If
	
	SCREEN.Object("main.OBJ_order.tab_order").id = 7
	SCREEN.Proc "main.OBJ_order.order_tab_change", ""		' 해지/지정 탭으로
	
	SCREEN.Object("main.1301").Data = codx
	SCREEN.Proc "main.send_sise_all", "account"
	
	SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jqty").Data = jqty
	
Case 2	' Page Down
	If b_next.Enable = True Then
		Call send_c()
	End If
End Select 

