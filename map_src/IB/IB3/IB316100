_AW_ONDECLARE_AW_
Dim flag '4601에서 넘길 계좌번호등을 셋팅하기위한 플래그

Sub send_sise_all(gubn)
	Dim code, fogb, rsymb, acnm
	code = Left(ed_fcod.Data, 1)
	If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
		fogb = 127
		rsymb = "100301"
		OBJ_sise.SetObject("IB316110")

'	ElseIf code = "2" Or code = "3" Then
'		fogb = 102
'		rsymb = "111301"
'		OBJ_sise.SetObject("IB314115")
'		OBJ_sise2.Send
	End If

	HNAM.Data = SCREEN.GetName (fogb, ed_fcod.Data, 0)
	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = HNAM.data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_fcod").data = ed_fcod.data
		SCREEN.IgnoreChange False
	End If

	Call tab_info_change()

	acnm = Trim(SCREEN.Object("OBJ_order.acnm").data)
	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 2, 2
		SCREEN.Object("OBJ_order.acnm").data = acnm
		OBJ_sise.Send

		Exit Sub
	Else
		ed_fcod.Trigger "ed_fcod", True
		ed_fcod.Trigger rsymb, True
		ed_fcod.Trigger rsymb, False
		SYSTEM.SetHistory rsymb, ed_fcod.Data
		SYSTEM.SetHistory "ed_fcod", ed_fcod.Data
	End If

	OBJ_sise.Send
	obj1.Send
'	SYSTEM.Trace CLng(Trim(tab_account.index))
	If CLng(Trim(tab_account.index)) =3 Or CLng(Trim(tab_account.index)) =4 Then
		SCREEN.Proc "OBJ_account.Set_contents", ""
		OBJ_account.Send
	End If

	SCREEN.Proc "OBJ_order.AddHistory", ed_fcod.Data
End Sub

