RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_flag
g_flag = "Q"

Sub Set_input
	If RADIO0.Checked = True Then
		type1.Data = "D"
	ElseIf RADIO1.Checked = True Then
		type1.Data = "A"
	ElseIf RADIO2.Checked = True Then
		type1.Data = "B"
	ElseIf RADIO3.Checked = True Then
		type1.Data = "C"
	End If

	If RADIO10.Checked = True Then
		tymt.Data = "1"
	ElseIf RADIO11.Checked = True Then
		tymt.Data = "2"
	End If

'''''''''''''''''''''''''''''''''''''''''''''''''
	If Len(Trim(CIMG.text)) <> 0 Then
		tymi.Data = CIMG.text
	Else
		tymi.Data = "BLANK"
	End If

'''''''''''''''''''''''''''''''''''''''''''''''''

	If Len(Trim(scr1.text)) <> 0 Then
		tyms.Data = scr1.text
	Else
		tyms.Data = "BLANK"
	End If

	tyf1.Data = "BLANK"
	'tyf2.Data = "BLANK"
	tyf3.Data = "BLANK"
	'tyf4.Data = "BLANK"

	If Len(Trim(ed_startdate.text)) <> 0 Then
		tyf2.Data = ed_startdate.text
	Else
		tyf2.Data = "BLANK"
	End If
	'ed_enddate

	If Len(Trim(ed_enddate.text)) <> 0 Then
		tyf4.Data = ed_enddate.text
	Else
		tyf4.Data = "BLANK"
	End If

		SYSTEM.Trace "tyf2.Data:"&tyf2.Data
		SYSTEM.Trace "tyf4.Data:"&tyf4.Data
End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
For ii = 0 To 8
	Dim tmp
	tmp = Trim(SCREEN.Object("OUTPUT"&ii).text)


	Select Case ii
		Case 0	'0. 팝업 타입
				Select Case tmp
					Case "D"	'NONE TYPE
						RADIO0.Checked = True
					Case "A"	'1X1 TYPE
						RADIO1.Checked = True
					Case "B"	'2X1 TYPE
						RADIO2.Checked = True
					Case "C"	'3X1 TYPE
						RADIO3.Checked = True
				End Select

		Case 1 	'1. 팝업 이미지 이름
			CIMG.Data = tmp

		Case 2	'2. 팝업 or url 타입 (1화면 2url)
				Select Case tmp
					Case "1"	'A TYPE
						RADIO10.Checked = True
					Case "2"	'B TYPE
						RADIO11.Checked = True
				End Select

		Case 3 '3. 업데이트 날짜
			updatedate.Data = Mid(tmp,1,4) & "/" &  Mid(tmp,5,2) & "/" &  Mid(tmp,7,2) & " "& Mid(tmp,9,2) & ":" & Mid(tmp,11,2)

		Case 4 '4. 1번 팝업 이동할 내용
			scr1.Data = tmp

	End Select
Next

If g_flag = "U" Then
	If RADIO0.Checked = True Then
		type1.Data = "D"
	ElseIf RADIO1.Checked = True Then
		type1.Data = "A"
	ElseIf RADIO2.Checked = True Then
		type1.Data = "B"
	ElseIf RADIO3.Checked = True Then
		type1.Data = "C"
	End If
 	g_flag = "Q"
 	func.Data = "Q"
	SCREEN.Send 0
End If

'SCREEN.Proc "main.Set_tab"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SBTN)
_AW_ONCLICK_AW_
func.Data = "U"
g_flag = "U"
Call Set_input
Dim hhmm
hhmm =  Hour(Now)*100 + Minute(Now)
tyud.Data = Replace(Date,"-","") & hhmm


If Len(Trim(ed_startdate.Data)) <> 12 Or Len(Trim(ed_enddate.Data)) <> 12 Then
	MsgBox "날짜를 확인해 주세요."
	If Len(Trim(ed_startdate.Data)) <> 12 Then
		ed_startdate.SetFocus
		Exit Sub
	End If
	If Len(Trim(ed_enddate.Data)) <> 12 Then
		ed_enddate.SetFocus
		Exit Sub
	End If
End If
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CIMG)
_AW_ONKEYCHANGE_AW_
'If SCREEN.Key = "13" Then  '-- Enter 키 입력
'	BUTTON0.SetFocus
'End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON4)
_AW_ONCLICK_AW_
CIMG.Data = cx_upload.GetFilePath()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON5)
_AW_ONCLICK_AW_
cx_upload.upload2(CIMG.Data)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cx_upload)
_AW_ONCHANGE_AW_
'EMSG.Data = "파일전송 완료"
MsgBox "파일 업로드 완료" & vbCrLf & "등록 및 수정 필요합니다."
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON6)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB960012 /p5", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UTAB0)
_AW_ONCLICK_AW_
Select Case UTAB0.ID
Case 1	'1X1 TYPE
	tyin.Data = "A"
	BUTTON5.Enable = True

Case 2	'2X1 TYPE
	tyin.Data = "B"
	BUTTON5.Enable = True

Case 3	'3X1 TYPE
	tyin.Data = "C"
	BUTTON5.Enable = True

Case 4	'NONE TYPE
	tyin.Data = "D"
	BUTTON5.Enable = False

Case Else
	Exit Sub
End Select
func.Data = "Q"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(scr1)
_AW_ONCLICK_AW_
Dim text
SCREEN.CreateWindow 2, "IB960001 /p5", ""

text = SYSTEM.pop ("IB960001_TEXT")
If Len(Trim(text)) >= 0 Then
		scr1.text = text
		SYSTEM.Push "IB960001_TEXT", ""
	Exit Sub
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



