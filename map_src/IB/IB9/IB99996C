	'MsgBox msg, , "IBK투자증권"
	SYSTEM.Push "BEST_EXECUTION_C", "NO"
'	SCREEN.CloseWindow()
	Exit Sub
End If

CONTROL1.Navigate(Trim(ed_url.Data))

