_AW_ONDECLARE_AW_
Dim myFILE, myMAP
myFILE = "userconf.ini"

Sub writeFileConfirm()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, "PDF_CONFIRM" , "best_excution", "1"
		
		Dim myTime, myHour, myMinute, sval
	
		AMonth = Month(Date)
		If Len(AMonth) = 1 Then
			AMonth = "0" & AMonth
		End If
		ADay = Day(Date)
		If Len(ADay) = 1 Then
			ADay = "0" & ADay
		End If
		
		
		myTime = Time
		myHour = Hour(myTime)
		myMinute = Minute(myTime)
		sval = AMonth & ADay & myHour & myMinute
		
		INFO.pushData LOGIN.Name, myFILE, "PDF_CONFIRM" , "best_excution_time", sval
	End If
End Sub

_AW_ONSTART_AW_
SYSTEM.Push "BEST_EXECUTION_C", "NO"
L_title.Data = " " & Trim(ed_title.Data)

ed_url.Data = "https://www.ibks.com/files/cs/clause/ibks_BestExecution.pdf"

If SCREEN.CreateObject("Info") Then
	INFO.pushData LOGIN.Name, myFILE, "PDF_CONFIRM" , "best_excution", "0"
	INFO.pushData LOGIN.Name, myFILE, "PDF_CONFIRM" , "best_excution_time", ""
End If

SCREEN.SetTimer 2, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
