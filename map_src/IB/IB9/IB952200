				SCREEN.Object("OBJECT0.IN_DATE").data = Replace(Date,"-","")
				OBJECT0.Send
				SCREEN.SetTimerX 1, 300, False
			End If
		End If
	ElseIf GRID0.Column = 16 Then
		If Len(Trim(GRID0.GetGridCell(GRID0.Row,12))) > 0 Then
		msg = "처리구분을 출고취소으로 업데이트하겠습니까?"

