GLOBAL DIVISION
{

MAPNAME(IB959901)
MAPSIZE(68, 264)
VERSION(000)
MAPKIND(NORMAL)
MAPGROUP(1)
MAPDESC("PUSH 발송")
MAPPUBLIC(";")
FONT("MS Sans Serif", 9, NORMAL)
TITLE("PUSH 발송")
TOPATH(AXIS)
METHOD(FORM)
MAPTYPE(FIXED)
HEADER(NOP)
}



FORM DIVISION
{

PANEL  PANEL15(0, 0, 350, 71)  LIMAGE(0)  LINEW(4)  STRESS(93)  STRESSW(1)  LINETYPE(4)  LINECOLOR(64)      COLOR(181, 232)  CUR(0)    AL_CENTER    ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
BUTTON  btn_yes(55, 40, 130, 60)  '예'  TP_USER|IMAGETEXT|AL_STRETCH        FONT("굴림체", 9, BOLD)  FOCUS  COLOR(208, 186)  CUR(0)    "6BTN_조회.BMP"    TABORDER(2)  ENABLE  &
  VISIBLE  IMAGETEXT  HOVER  HINTTYPE(IH_NONE)
BUTTON  btn_no(140, 40, 210, 60)  '아니오'  TP_PUSH|IMAGETEXT|AL_STRETCH        FOCUS  COLOR(208, 186)  CUR(0)    "6BTN.BMP"    TABORDER(1)  ENABLE  &
  VISIBLE  IMAGETEXT  HINTTYPE(IH_NONE)
PANEL  PANEL_NO_DIV(16, 15, 331, 39)  '[본가동] 메세지를 발송 하시겠습니까?'        COLOR(228, 94)  CUR(0)    AL_LEFT  FONT("굴림", 9, BOLD)  ENABLE  &
  VISIBLE  TRANSPARENT  HINTTYPE(IH_NONE)
PANEL  PANEL_DIV(16, 15, 331, 39)  '[개발계] 메세지를 발송 하시겠습니까?'        COLOR(228, 232)  CUR(0)    AL_LEFT  FONT("굴림", 9, BOLD)  ENABLE  &
  VISIBLE  TRANSPARENT  HINTTYPE(IH_NONE)
EDIT  DEV(425, 5, 460, 25)  LEN(1)  IO_NUM|EDIT_INPUT|FA_WRAP|FA_SKIP    COLOR(192, 232)  CUR(0)  TP_NONE          TABORDER(3)  IOORDER(1)  ENABLE  &
  HINTTYPE(IH_NONE)
}



RESOURCE DIVISION
{


_AW_ONSTART_AW_
If DEV.Data = "0" Then	'운영
	SCREEN.SetCaption "[본가동] PUSH 발송"
	PANEL_NO_DIV.Visible = True
	PANEL_DIV.Visible = False
Else					'개발
	SCREEN.SetCaption "[개발계] PUSH 발송"
	PANEL_NO_DIV.Visible = False
	PANEL_DIV.Visible = True
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(btn_yes)
_AW_ONCLICK_AW_
SYSTEM.Push "ISOK", "TRUE"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn_no)
_AW_ONCLICK_AW_
SYSTEM.Push "ISOK", "FALSE"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



