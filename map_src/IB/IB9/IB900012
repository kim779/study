'				Exit For
'			Else
'				If chk = "1" Then
'					cnt = cnt +1
'				End If
'			End If

		End If

	Next

	m_count = cnt
	count.Text = m_count
	chkCount = m_count

End Function

'***************************************************************************
' DESC: DeleteRow
'***************************************************************************
Sub deleteRow()
	Dim ii, name

	For ii = S90303.Rows To 1 Step -1
		name = Trim(S90303.GetGridCell(ii, 4))

		If name = "" Then
			S90303.RemoveRow(ii-1)
		End If
	Next
End Sub

'***************************************************************************
' DESC: Check Kospi
'***************************************************************************
Sub chkKospi()
	Dim cnt , code, codetype
	cnt = 0


	Call all_chk("0")


	For ii = 1 To S90303.Rows
		If Trim(S90303.GetGridCell (ii, 3)) <> "" Then


			code = Trim(S90303.GetGridCell (ii, 3))
			codetype = Trim(SCREEN.GetCodeType(code))

			If cnt < maxCount Then
				If codetype = 1 Then
					cnt = cnt + 1
					S90303.SetGridCell ii, 1, 1
				End If
			Else
				MsgBox "최대 " & maxCount & "개까지만 종목 연동이 가능합니다"
				Exit For
			End If

		End If
	Next

	m_count = cnt
	count.Text = m_count
End Sub

'***************************************************************************
' DESC: Check Kosdaq
