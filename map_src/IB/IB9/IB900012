Sub chkKosdaq()
	Dim cnt , code, codetype
	cnt = 0


	Call all_chk("0")


	For ii = 1 To S90303.Rows
		If Trim(S90303.GetGridCell (ii, 3)) <> "" Then


			code = Trim(S90303.GetGridCell (ii, 3))
