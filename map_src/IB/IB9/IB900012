Dim m_count, maxCount


maxCount = 12
'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_chk(Flag)
	Dim cnt
	cnt = 0
	For ii = 1 To S90303.Rows
		If Trim(S90303.GetGridCell (ii, 3)) <> "" Then

			If Flag = 1 Then
				cnt = cnt + 1
			End If

			If cnt <= maxCount Then
				S90303.SetGridCell ii, 1, Flag
			Else
				MsgBox "최대 " & maxCount & "개까지만 종목 연동이 가능합니다"
				cnt = cnt - 1

				Exit For
			End If

		End If
	Next

	m_count = cnt
	count.Text = m_count
End Sub

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Function chkCount()
chkCount = 0
	Dim chk, cnt, temp_check

	chk = 0
	cnt = 0

	If Trim(count.Data) <> "" Then
		temp_check = CLng(Trim(count.Data))
	Else
		temp_check = 0
	End If

	If Trim(S90303.GetGridCell(S90303.Row, 1)) = "1" Then
		temp_check = temp_check + 1
	End If

	If temp_check > maxCount Then
		MsgBox "최대 " & maxCount & "개까지만 종목 연동이 가능합니다"
		S90303.SetGridCell S90303.Row, 1, "0"
		Exit Function
	End If

	For ii = 1 To S90303.Rows
		If Trim(S90303.GetGridCell (ii, 3)) <> "" Then
			chk = Trim(S90303.GetGridCell(ii, 1))

			If chk = "1" Then
				cnt = cnt +1
			End If

'			If cnt > maxCount Then
'				MsgBox "최대 " & maxCount & "개까지만 종목 연동이 가능합니다"
