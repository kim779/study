Public Function cp_lpad(as_string, ai_count, as_filler)
	Dim ls_str, li_cnt
    '대상 String이 NULL이면 Filler로 채운 문자열 Return
	If IsNull(as_string) Then
		cp_lpad = String(ai_count, as_filler)
	Else
		ls_str = Trim(as_string) ' 공백 Trimming
		SCREEN.CreateObject("DX_CSTRING")
		DX_CSTRING.Text = ls_str
		li_cnt = ai_count - DX_CSTRING.GetLength()
		If li_cnt >= 0 Then
			cp_lpad = String(li_cnt, as_filler) & ls_str
		Else
			cp_lpad = Right(ls_str, ai_count)
		End If
	End If
End Function

