'== 주문obj를포함한 main의 공통함수
Sub SetPrice(code, Price)
	If code <> "" Then
		If Len(code) = 7 Then
			code = Mid(code, 2)
		End If
'		SYSTEM.Trace "mapName : " & SCREEN.GetMapName(1) & "code : " & code & " objCode : " & S1301.data

		If code = S1301.data Then
			If SCREEN.GetMapName(1) <> "IB303100" Then
				If SCREEN.GetMapName(1) = "IB103200" Or SCREEN.GetMapName(1) = "IB103300" Then
					If tab_ordtyp.ID = 0 Then
						If	SCREEN.Object("OBJ_order.obj_odr.ed_jprc").Enable = True Then
							SCREEN.Object("OBJ_order.obj_odr.ed_jprc").data = Price
						End If
					End If
				Else
					If	SCREEN.Object("OBJ_order.obj_odr.ed_jprc").Enable = True Then
						SCREEN.Object("OBJ_order.obj_odr.ed_jprc").data = Price
						SCREEN.Object("OBJ_order.obj_odr.ed_jprc").SetFocus
					End If
				End If
			End If
		End If
	End If
End Sub

Sub SetStopPrice(code, Price)
	If code <> "" Then
		If Len(code) = 7 Then
			code = Mid(code, 2)
		End If

		If code = S1301.data Then
			If SCREEN.GetMapName(1) = "IB103200" Or SCREEN.GetMapName(1) = "IB103300" Then
				If tab_ordtyp.ID = 0 Then
					If UCase(TypeName( SCREEN.Object("OBJ_order.obj_odr.edStopPrc"))) <> "NOTHING" Then
						If	SCREEN.Object("OBJ_order.obj_odr.edStopPrc").Enable = True Then
							SCREEN.Object("OBJ_order.obj_odr.edStopPrc").data = Price
						End If
					End If
				End If
			Else
				If UCase(TypeName( SCREEN.Object("OBJ_order.obj_odr.edStopPrc"))) <> "NOTHING" Then
					If	SCREEN.Object("OBJ_order.obj_odr.edStopPrc").Enable = True Then
						SCREEN.Object("OBJ_order.obj_odr.edStopPrc").data = Price
						SCREEN.Object("OBJ_order.obj_odr.edStopPrc").SetFocus
					End If
				Else
					SYSTEM.Trace "!!!!!!!!!!!!!999913  edStopPrc no exist"
				End If
			End If
		End If
	End If
End Sub

