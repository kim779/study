Sub Set_mini_domino(xval)
	Dim sdata, mkgb, codx
	'-- CreatWindow로 미니주문 open시
	'   domino_data = "종목코드 | 주문번호 | 주문가격 | 주문수량 | "

	' 도미노 파싱
	domino_data.data = SYSTEM.Pop("domino_data")
	If Trim(domino_data.Data) = "" Then
		Exit Sub
	End If
	SCREEN.Object("OBJ_order.obj_odr.isQueryHoga").Data = "1"
	sdata = Split(domino_data.Data,"|")
SCREEN.IgnoreChange True

	SYSTEM.Push "S_code", sdata(0)	' 종목코드
	SYSTEM.Push "S_ogno", sdata(1)	' 원주문번호
	SYSTEM.Push "S_jprc", sdata(2)	' 주문가격
	SYSTEM.Push "S_jqty", sdata(3)	' 주문수량
	mkgb = sdata(4)					' 시장구분 1:KRX 2:NXT S:SOR
	codx = SYSTEM.Pop("S_code")

	' 시장구분자 변경
	Call Spread_mkgb(codx, mkgb)

SYSTEM.Trace "IB999913 upbound = " & UBound(sdata)

	SCREEN.Object("OBJ_order.obj_odr.OBJ_hnam.1301").Data = SYSTEM.Pop("S_code")
	SCREEN.Object("OBJ_order.obj_odr.1301").Data = SYSTEM.Pop("S_code")
	SCREEN.Object("OBJ_order.obj_odr.OBJ_hnam").Send
	S1301.Data = sdata(0)
	SCREEN.Object("OBJ_order.obj_odr.ed_ogno").Data = SYSTEM.Pop("S_ogno")

	If SCREEN.Object("OBJ_order.obj_odr.ed_jqty").Enable Then
'		SYSTEM.Trace "1001 domino qty :::: " & sdata(3)
		SCREEN.Object("OBJ_order.obj_odr.ed_jqty").Data = SYSTEM.Pop("S_jqty")
	End If

	If xval = "3" Then	'-- 정정인 경우
		SCREEN.Object("OBJ_order.obj_odr.ed_jprc").Data = SYSTEM.Pop("S_jprc")
		If UBound(sdata) > 4 Then
			If InStr(sdata(4), "스톱") > 0 Then
				SCREEN.Object("OBJ_order.obj_odr.shogb").Data = "01"
			ElseIf InStr(sdata(4), "중간") > 0 Then
				SCREEN.Object("OBJ_order.obj_odr.shogb").Data = "02"
			End If
		End If
	End If

	SYSTEM.Push "S_ogno", ""
	SYSTEM.Push "S_jprc", ""
	SYSTEM.Push "S_jqty", ""
	SYSTEM.Push "S_code", ""

	obj_sise.Send

SCREEN.IgnoreChange False
	domino_data.Clear
	SYSTEM.Push "domino_data", ""

	SCREEN.Object("OBJ_order.obj_odr.ed_jqty").SetFocus
End Sub

