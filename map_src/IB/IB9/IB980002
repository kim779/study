RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub refresh()
	CONTROL0.Navigate2 "http://www.ibks.com/customer/ranking/index.jsp?popup=Y&hts=Y",False
End Sub

_AW_SCRIPT_AW_(BROWSER0)
_AW_ONDBLCLK_AW_
If SCREEN.CreateObject("Info") Then
	bEdge = Trim(INFO.PopData("", "WEBINFO.INI", Trim(edmap.Data), "EDGE"))
	url = Trim(INFO.PopData("", "WEBINFO.INI", Trim(edmap.Data), "EDGE_URL"))
End If

SYSTEM.Trace "[IB980000][EDGE] OnStart  bEdge = " & bEdge & " url = " & url
SYSTEM.Trace "[IB980000][EDGE] OnStart  edmap.Data = " & Trim(edmap.Data)

If SCREEN.CreateObject("Info") Then
	width = Trim(INFO.PopData("", "WEBINFO.INI", edmap.Data, "width"))
	height = Trim(INFO.PopData("", "WEBINFO.INI", edmap.Data, "height"))
	SCREEN.SetSize width, height
End If

If  Len(Trim(url)) = 0 Then
	BROWSER0.Navigate2 1, edmap.Data
Else
	edurl.Data = url
	BROWSER0.Navigate(edurl.Data)
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
BROWSER0.Navigate(edurl.Data)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
BROWSER0.Navigate2 1, edmap.Data

Dim width
Dim height
If SCREEN.CreateObject("Info") Then
width = Trim(INFO.PopData("", "WEBINFO.INI", edmap.Data, "width"))
height = Trim(INFO.PopData("", "WEBINFO.INI", edmap.Data, "height"))
SCREEN.SetSize width, height + 20
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


