RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	GRID01.Clear
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
Dim sss
sss = Trim(SCREEN.Object("main.SVER").data)
If sss = "" Then
	SCREEN.OnSend = False
	Exit Sub
End If
SVIP.data = sss
If FUNC.Data <> "S" And FUNC.Data <> "F" Then
	FUNC.Data = "V"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
FUNC.Data = "V"
USID.SetFocus

SCREEN.Object("parent.output0").Data = GRID01.Page

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID01)
_AW_ONCLICK_AW_
GRID01.Column = 2
If GRID01.Hitpos = 3 And Trim(GRID01.Cell) <> "" Then
	USID.Enable = True
	USID.Data = GRID01.Cell
	R_USR.Checked = True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SYMBOL14)
_AW_ONCLICK_AW_
Dim dmsg

If Trim(MEMO.Text) = "" Then
	MsgBox "전문내용을 입력하세요"
	MEMO.SetFocus
	Exit Sub
End If

FUNC.Data = "S"

If R_ALL.Checked = True Then
	dmsg = "전체서버 사용자에게 전문전달 합니다."
ElseIf R_SVR.Checked = True Then
	dmsg = "선택서버의 전체사용자에게 전문전달 합니다."
ElseIf R_USR.Checked = True Then
	If Trim(USID.Data) = "" Then
		MsgBox "사용자 ID를 입력하세요", ,"긴급전문전달"
		USID.SetFocus
		Exit Sub
	End If
	dmsg = "선택사용자 [" & Trim(USID.Data) & "] 에게 전문전달 합니다."
Else
	Exit Sub
End If
dmsg = dmsg & vbLf & vbLf & "전송하시겠습니까?"

If MsgBox(dmsg, vbExclamation + vbYesNo, "긴급전문전달") = 7 Then
	Exit Sub
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(R_ALL)
_AW_ONCLICK_AW_
USID.Clear
USID.Enable = False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(R_USR)
_AW_ONCLICK_AW_
USID.Enable = True
USID.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(R_SVR)
_AW_ONCLICK_AW_
USID.Clear
USID.Enable = False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
