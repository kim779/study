RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Function Null_check(Data)
    Null_check = Data
    If Trim(data) = "" Then
        Null_check = "NO"
        Exit Function
    End If
End Function

_AW_ONSTART_AW_
SYSTEM.Push "rtn_OrderConfirm", "NO"

If SCREEN.CreateObject("info") Then
	 If INFO.PopData("", "AXIS.INI", "MODE", "DEV") = "1" Then
	 	btn_dec.Visible = True
	 Else
	 	btn_dec.Visible = False
	 End If
End If

Dim yn
If SCREEN.CreateObject("info") Then
	yn = Null_check(Trim(INFO.popdata(LOGIN.name, "userconf.ini", "S-ORD", "ORD_CONF")))
	cx_log.WriteHlog "Hlog.ini", "IB999920", "[onstart]ORD_CONF", yn
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BTN_Y)
_AW_ONCLICK_AW_
Dim yn

If r_ConF.Checked = True Then
	yn = "NO"   '주문확인창 보기
Else
	yn = "OK"   '주문확인창 안보기
End If

SYSTEM.Push "rtn_OrderConfirm", yn

If SCREEN.CreateObject("info") Then
   	INFO.pushdata LOGIN.name, "userconf.ini", "S-ORD", "ORD_CONF", yn
End If

cx_log.WriteHlog "Hlog.ini", "IB999920", "ORD_CONF", yn

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_N)
