RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Query(innm, senm, skey, indt)
'	SYSTEM.Trace "Query start - [" & innm & "][" & senm & "][" & skey & "][" & indt
	GUBN.Data = "Q"
	INI_NAME.Data = innm
	SECT_NAME.Data = senm
	SECT_KEY.Data = skey
	IN_DATE.Data = indt
	SCREEN.Send 0
End Sub

Sub Insert(innm, senm, skey, valu)
'	SYSTEM.Trace "Insert start - " & innm & "][" & senm & "][" & skey & "][" & valu & "]"
	GUBN.Data = "I"
	INI_NAME.Data = innm
	SECT_NAME.Data = senm
	SECT_KEY.Data = skey
	VALUE.Data = valu
	SCREEN.Send 0
End Sub

Sub Delete(innm, senm, skey)
'	SYSTEM.Trace "Delete start - " & innm & "][" & senm & "][" & skey & "]"
	GUBN.Data = "D"
	INI_NAME.Data = innm
	SECT_NAME.Data = senm
	SECT_KEY.Data = skey
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
SCREEN.OnSend = False
USER_ID.Data = SYSTEM.UserID
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.SetTimer 1, False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
