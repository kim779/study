_AW_ONDECLARE_AW_
Sub createFile()
	Dim path
	Dim fileName

	If Trim(trname.data) = "" Then
		MsgBox "먼저 서비스ID 조회를 해주세요."
	Else
		'바탕화면 경로
		path = CreateObject("WScript.Shell").SpecialFolders("Desktop")
		fileName = path & "\" & Trim(usid.data) & "_" & Trim(trname.data) & ".txt"

		'파일쓰기
    	Call TextStrimWrite(fileName)
	End If
End Sub

'파일쓰기
Sub TextStrimWrite(strPathName)
	Dim myArr()					'배열
	Dim tempStr
	Dim itemDtype				'데이터형
	Dim itemLen					'크기(반복수)
	Dim gridFlag				'그리드 체크 플래그
	ReDim myArr(cnt)			'배열 크기 재지정

    Set objStream = CreateObject("ADODB.Stream")
    objStream.Charset = "UTF-8"
    objStream.Open

	objStream.WriteText data.data

    '설정 부분
    Set BinaryStream = CreateObject("adodb.stream")
    BinaryStream.Type = 1
    BinaryStream.Mode = 3
    BinaryStream.Open
    objStream.Position = 3
    objStream.CopyTo BinaryStream
    objStream.Flush
    objStream.Close
    BinaryStream.SaveToFile strPathName, 2
    BinaryStream.Close
    Set objStream = Nothing
    Set BinaryStream = Nothing
End Sub

