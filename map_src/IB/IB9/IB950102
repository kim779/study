Sub SelectComboBoxItem(hCombo, strItem)
	Dim i, value , temp, bSame
	i = 0
	temp =""
	SCREEN.Object(hCombo).Index = i

	bSame = False

	value = Trim(SCREEN.Object(hCombo).Data)

'	SYSTEM.Trace "hCombo.Data===>" & Trim(SCREEN.Object(hCombo).Data)
'	SYSTEM.Trace "strItem===>" & strItem

	Do While Trim(value) <> ""
		SCREEN.Object(hCombo).Index = i
		value = SCREEN.Object(hCombo).Data

		If Trim(strItem) = Trim(value) Or Trim(value) = Trim(temp) Then
			bSame = True
			Exit Do
		End If

		temp = value
'		SYSTEM.Trace "hCombo.Index===>" & i
'		SYSTEM.Trace "hCombo.Data===>" & value

		i = i+1
	Loop

	If bSame = False Then
		SCREEN.Object(hCombo).Index = 0
	End If
End Sub

