_AW_ONDECLARE_AW_
Sub send_f()
	GRID01.Clear
	FUNC.Data = "Y"
	SVIP.Data = GetSVIP("Host")
	CHCK.Data = GetCHCK("Gubn")
	SCREEN.Send 0
End Sub

Function GetSVIP(ObjName)
	GetSVIP = "999.999.999.999"

	Select Case Trim(SCREEN.Object(ObjName).Data)
	Case "B11"			GetSVIP = "211.255.204.71"
	Case "B12"			GetSVIP = "211.255.204.72"
	Case "B13"			GetSVIP = "211.255.204.73"
	Case "B14"			GetSVIP = "211.255.204.74"
	Case "B15"			GetSVIP = "211.255.204.75"
	Case "B16"			GetSVIP = "211.255.204.76"

	Case "B21"			GetSVIP = "172.16.222.34"
	Case "B22"			GetSVIP = "172.16.222.35"
	Case "B23"			GetSVIP = "172.16.222.36"
	Case "B24"			GetSVIP = "172.16.222.37"
	Case "B25"			GetSVIP = "172.16.222.38"
	Case "B26"			GetSVIP = "172.16.222.39"

	Case "KHT"			GetSVIP = "172.16.202.106"
	Case "BPT"			GetSVIP = "172.16.202.150"
	End Select

End Function


Function GetCHCK(ObjName)
	GetCHCK = "TOT"

	If Trim(SCREEN.Object(ObjName).Data) <> "" Then
		GetCHCK = SCREEN.Object(ObjName).Data
	End If
End Function


Sub CountUser()
	Dim term, id		' 터미널명, 사용자 ID
	Dim ctime, ApiTs 	' 접속시간, API여부
	Dim customer, employee, unknown	' HTS - 고객, 직원, 미상
	Dim wts, mwts		' WTS, Mobile WTS
	Dim eApi, cApi		' API
	Dim mst				' 증권통
	Dim msp				' 증권플러스
	Dim	staff			' 직원

	' 출력 메시지
	Dim msg, msg2, msg3, Total, Total2, Total3

	' 합계
	Total = 0
	Total2 = 0
	Total3 = 0

	' HTS
	customer = 0
	employee = 0
	unknown = 0

	' WTS
	wts = 0
	mwts = 0

	' API
	eApi = 0
	cApi = 0

	' 제휴매체 (증권통/증권플러스)
	msp = 0
	mst = 0

	' MTS
	iphone = 0
	android = 0

	For i = 1 To GRID01.Rows
		term = Trim(GRID01.GetGridText(i, 9))	' 터미널 명
		id   = Trim(GRID01.GetGridText(i, 4))	' 접속자 ID

		If Len(term)=0 Then
			Exit For
		End If

		term  = Left(term, 1)					' 접속 터미널 구분 : C(고객) T(직원) S(아이폰) U(안드로이드) m(Mobile-WTS)

		ApiTs = Trim(GRID01.GetGridText(i, 10))	' API 여부 구분자
		staff = IsNumeric(id)					' 숫자형 ID는 직원으로 간주

		If id = "##ibk9" Then					' ##ibk9 (WTS) ID도 직원으로 간주
			staff = True
		End If

		Select Case Trim(term)
		Case "T":	' 직원
			If ApiTs="Y" Then	'API 사용자
				eApi = eApi + 1
				SetRowColor i, 95
				GRID01.SetGridCell i, 11, "직원용 API"
				GRID01.SetGridCell i, 3, "직(A)"
			Else
				employee = employee + 1
				If Trim(id) = "##ibk9" Then	'##ibk9이면 (WTS)
					GRID01.SetGridCell i, 11, "직원용 HTS - 조회용"
					GRID01.SetGridCell i, 3, "직(H)"
				Else
					GRID01.SetGridCell i, 11, "직원용 HTS"
					GRID01.SetGridCell i, 3, "직(H)"
				End If
			End If

		Case "C":	' 고객
			If ApiTs="Y" Then	'API 사용자
				cApi = cApi + 1
				SetRowColor i, 95
				'GRID01.SetTRgb i, 2, 95
				GRID01.SetGridCell i, 11, "고객용 API"
				GRID01.SetGridCell i, 3, "고(A)"
			Else
				If Trim(id) = "##ibk9" Then	'##ibk9이면 (WTS)
					wts = wts + 1
					GRID01.SetGridCell i, 11, "고객용 WTS"
					GRID01.SetGridCell i, 3, "고(W)"
				Else
					customer = customer + 1
					GRID01.SetGridCell i, 11, "고객용 HTS"
					GRID01.SetGridCell i, 3, "고(H)"
				End If
			End If

		Case "O":	' 증권통
			mst = mst + 1
			GRID01.SetGridCell i, 3, "증(T)"
			GRID01.SetGridCell i, 11, "증권통"

		Case "Q":	' 증권플러스
			msp = msp + 1
			GRID01.SetGridCell i, 3, "증(P)"
			GRID01.SetGridCell i, 11, "증권플러스(카카오스톡)"

		Case "S":	' 신 아이폰
			If staff = True Then
				If ApiTs="Y" Then	'API 사용자
					eApi = eApi + 1
					SetRowColor i, 95
					GRID01.SetGridCell i, 11, "직원용 API"
					GRID01.SetGridCell i, 3, "직(A)"
				Else
					employee = employee + 1
					GRID01.SetGridCell i, 11, "직원용 HTS"
					GRID01.SetGridCell i, 3, "직(H)"
				End If
			Else
				iphone = iphone + 1
				GRID01.SetGridCell i, 3, "아(M)"
				GRID01.SetGridCell i, 11, "아이폰"
			End If

		Case "U":	' 신 안드로이드
			android = android + 1
			GRID01.SetGridCell i, 3, "안(M)"
			GRID01.SetGridCell i, 11, "안드로이드폰"

		Case "W":	' WTS
			wts = wts + 1
			If Trim(id) = "##ibk9" Then	'##ibk9이면 서(W)
				GRID01.SetGridCell i, 3, "서(W)"
				GRID01.SetGridCell i, 11, "서버용 WTS"
			Else
				GRID01.SetGridCell i, 3, "WTS"
				GRID01.SetGridCell i, 11, "웹 WTS"
			End If

		Case "m":	' 모바일 WTS
			mwts = mwts + 1
			If Trim(id) = "##ibk9" Then	'##ibk9이면 서(W)
				GRID01.SetGridCell i, 3, "서(m)"
				GRID01.SetGridCell i, 11, "서버용 Mobile WTS"
			Else
				GRID01.SetGridCell i, 3, "고(m)"
				GRID01.SetGridCell i, 11, "Mobile  WTS"
			End If

		Case Else	' 미정의
			unknown = unknown + 1
			GRID01.SetGridCell i, 3, "???"
			GRID01.SetGridCell i, 11, "미정의[" & term & "]"

		End Select

	Next

	Total  = customer + employee + cApi + eApi + unknown
	Total2 = iphone + android + mst + msp
	Total3 = wts + mwts
	msg  = "고(" & customer & ") 직(" & employee & ") API(" & cApi + eApi & ") ETC(" & unknown & ")"
	msg2 = "아(" & iphone   & ") 안(" & android  & ") 통("  & mst         & ") 플("  & msp     & ")"
	msg3 = "WTS("& wts & ") IONE(" & mwts & ")"
	COUNTER.Data  = "HTS(" & Total  & ")=" & msg
	COUNTER2.Data = "MTS(" & Total2 & ")=" & msg2
	COUNTER3.Data = "WTS(" & Total3 & ")=" & msg3

	HTSCNT.Data      = customer + employee	' HTS     : 고객 + 직원
	IPHONECNT.Data   = iphone			    ' iPhone  : iPhone
	ANDROIDCNT.Data  = Android			    ' Android : And
	APICNT.Data      = cApi + eApi		    ' API
	WTSCNT.Data      = wts				    ' WTS
	IONECNT.Data     = mwts				    ' Mobile WTS (ionebank)
	mstcnt.Data      = mst				    ' 증권통
	mspcnt.Data      = msp				    ' 증권플러스
	unknowncnt.data  = unknown
	LABEL2.Data = "합계 : " & GRID01.Rows
End Sub

