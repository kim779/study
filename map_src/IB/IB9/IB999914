_AW_ONDECLARE_AW_
Sub send_tr(acno, pwd, gubn, mmgb, cod2, pric, ptnc, flag)
'	SCREEN.ClearAll 1, 2

	ed_acno.Data = acno
	zPwd.Data = pwd
	zQryTp.Data = gubn
	zBnsTp.Data = mmgb
	zFnoIsuNo.Data = cod2
	dOrdPrc.Data = pric
	zFnoOrdprcPtnCode.Data = ptnc
	l_avol.Data = flag

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
SCREEN.Proc "main.Set_guide", " "

SCREEN.Object("In").Data = "00001"

If Trim(ed_acno.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "계좌번호를 확인하세요"
	Exit Sub
End If

'직원일 경우
If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(zPwd.data)) < 4 Then
		SCREEN.Proc "main.Set_guide", "비밀번호를 확인하세요"
 		Exit Sub
	End If
End If

If Trim(zFnoIsuNo.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "종목코드를 확인하세요"
	Exit Sub
End If
If Trim(dOrdPrc.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "주문가를 확인하세요"
	Exit Sub
End If

dRatVal.Data = FormatNumber(dRatVal.data/100000000,8)

'스프레드종목에 대해 마이너스 처리를 해 변경함. 09.06.04 LKM
If Left(zFnoIsuNo.Data, 1)<>"4" And Left(zFnoIsuNo.Data, 1)<>"D" Then
	If Left(zFnoIsuNo.Data, 3) <> "185" And Left(zFnoIsuNo.Data, 3) <> "186" And Left(zFnoIsuNo.Data, 3) <> "187" Or _
	   Left(zFnoIsuNo.Data, 3) <> "A85" And Left(zFnoIsuNo.Data, 3) <> "A86" And Left(zFnoIsuNo.Data, 3) <> "A87" Then
		dOrdPrc.data = dOrdPrc.data / 100
	End If
	dOrdPrc.Data = Replace(FormatNumber(dOrdPrc.data,2), ",", "")

	dOrdPrc_s.Data = "+"

Else
	' 에디트 컨트롤이 Numeric타입에 마이너스 값을 가질 경우
	' Data값 안에 공백이 존재하게 된다. 하여 Replace로 공백을 제거하는 루틴을 삽입
	dOrdPrc.Data = FormatNumber( Replace(dOrdPrc.data, " ", "")/100, 2)
	If Left(dOrdPrc.Data, 1)="-" Then
		dOrdPrc_s.Data = "-"
		dOrdPrc.Data = Replace(dOrdPrc.Data, "-", "0")
	Else
		dOrdPrc_s.Data = "+"
	End If
End If

'SYSTEM.Trace dOrdPrc_s.Data &" "& lOrdAmt_S.Data &" "& dRatVal_S.data

SCREEN.OnSend = True

