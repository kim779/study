USID.Enable = False
chk_staff.Enable = False
chk_cust.Enable =  False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(R_MTS_SVR)
_AW_ONCLICK_AW_
USID.Clear
USID.Enable = False
chk_staff.Enable = False
chk_cust.Enable = False
