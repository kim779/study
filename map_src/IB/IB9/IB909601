RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

_AW_ONSEND_AW_
Dim sss
sss = Trim(SCREEN.Object("main.SVER").data)
If sss = "" Then
	SCREEN.OnSend = False
	Exit Sub
End If
SVIP.data = sss

If FUNC.Data <> "S" And FUNC.Data <> "F" Then
	FUNC.Data = "V"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
FUNC.Data = "V"
USID.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SYMBOL14)
_AW_ONCLICK_AW_
Dim dmsg, smsg

MEMO0.Text = ""

If Trim(MEMO.Text) = "" Then
	MsgBox "전문내용을 입력하세요"
	MEMO.SetFocus
	Exit Sub
End If

If LenB(Trim(MEMO.Text)) > 600 Then
	MsgBox "현재 "&LenB(Trim(MEMO.Text))&"byte 입력 / "&Abs(LenB(Trim(MEMO.Text))-600)&"byte 초과 하였습니다."
	MEMO.SetFocus
	Exit Sub
End If

MEMO0.Text = Trim(MEMO.Text)

FUNC.Data = "S"

If R_HTS_SVR.Checked = True Or R_HTS_ALL.Checked = True Then
	If chk_staff.Checked=True And chk_cust.Checked=True Then
		smsg = "[HTS 고객/직원]"
	ElseIf chk_staff.Checked=True Then
		smsg = "[HTS 직원]"
	ElseIf chk_cust.Checked=True Then
		smsg = "[HTS 고객]"
	Else
		MsgBox "전송대상을 하나 이상 선택하십시오."
		Exit Sub
	End If
Else
	smsg = "[MTS 고객]"
End If

If R_HTS_ALL.Checked = True Or R_MTS_ALL.Checked = True Then
	dmsg = "전체서버 " & smsg & " 에게 전문전달 합니다."
ElseIf R_HTS_SVR.Checked = True Or R_MTS_SVR.Checked = True Then
	dmsg = "선택서버의 " & smsg & " 에게 전문전달 합니다."
ElseIf R_USR.Checked = True Then
	If Trim(USID.Data) = "" Then
		MsgBox "사용자 ID를 입력하세요", ,"긴급전문전달"
		USID.SetFocus
		Exit Sub
	End If
	dmsg = "선택사용자 [" & Trim(USID.Data) & "] 에게 전문전달 합니다."
Else
	Exit Sub
End If

dmsg = dmsg & vbLf & vbLf & "전송하시겠습니까?"
dmsg = dmsg & vbLf & String(60, "=")
dmsg = dmsg & vbLf & vbLf & Trim(MEMO.Text)



If MsgBox(dmsg, vbExclamation + vbYesNo, "긴급전문전달") = 7 Then
	Exit Sub
End If

If R_HTS_ALL.Checked = True Then
	If chk_staff.Checked=True And chk_cust.Checked=True Then
		chck.Data = "100"
	ElseIf chk_staff.Checked=True Then
		chck.Data = "098"
	ElseIf chk_cust.Checked=True Then
		chck.Data = "099"
	End If
ElseIf R_HTS_SVR.Checked = True Then
	If chk_staff.Checked=True And chk_cust.Checked=True Then
		chck.Data = "010"
	ElseIf chk_staff.Checked=True Then
		chck.Data = "008"
	ElseIf chk_cust.Checked=True Then
		chck.Data = "009"
	End If
ElseIf R_MTS_ALL.Checked = True Then
	chck.Data = "207"
ElseIf R_MTS_SVR.Checked = True Then
	chck.Data = "027"

ElseIf R_MTS_SVR.Checked = True Then


Else
	chck.Data = "001"
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(R_HTS_ALL)
_AW_ONCLICK_AW_
USID.Clear
USID.Enable = False
chk_staff.Enable = True
chk_cust.Enable = True
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(R_USR)
_AW_ONCLICK_AW_
USID.Enable = True
chk_staff.Enable = False
chk_cust.Enable = False
USID.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID01)
_AW_ONCLICK_AW_
GRID01.Column = 2
If GRID01.Hitpos = 3 And Trim(GRID01.Cell) <> "" Then
	USID.Enable = True
	USID.Data = GRID01.Cell
	R_USR.Checked = True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(R_HTS_SVR)
_AW_ONCLICK_AW_
USID.Clear
USID.Enable = False
chk_staff.Enable = True
chk_cust.Enable = True
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
If Trim(USID.data) = "" Then
	MsgBox "고객 ID를 입력하세요.", 0, "에러"
	Exit Sub
End If
FUNC.Data = "F"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
MEMO.Clear()
MEMO.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(R_MTS_ALL)
_AW_ONCLICK_AW_
