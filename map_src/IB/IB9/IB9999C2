RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim gubn, mapNm

Sub paymentBnk(TrdAmt)		'입금
    SYSTEM.Trace "paymenbnk logic start"
	gubn = "입금"
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	zTrxTp.Data = "1"
	zTrdAmt.Data = TrdAmt
	SCREEN.Send 0
End Sub

Sub contributionBnk(TrdAmt)	'출금
    SYSTEM.Trace "contributionBnk logic start"
	gubn = "출금"
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	zTrxTp.Data = "2"
	'SYSTEM.Trace "zTrdAmt.Data:"&zTrdAmt.Data
	zTrdAmt.Data = TrdAmt
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"
zAgrmCardMsdata.Data = ""

mapNm = Left(Trim(SCREEN.GetMapName(1)), 6)


	zAcntNo.Data = Trim(SCREEN.Object("main.AN3A").Data)
	zPwd.Data = Trim(SCREEN.Object("main.pswd").Data)
    'SYSTEM.Trace "zPwd.Data:" & zPwd.Data

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call guide_msg("계좌번호를 확인하여 주십시오.")
	Exit Sub
End If

SYSTEM.Trace "1"

zLnkBnkCode.Data = "003"	'은행 예수금방식은 기업은행에서만 개설 가능함.

If Len(Trim(zPwd.Data)) < 4 Then
	Call guide_msg("비밀번호를 확인하여 주십시오.")
	Exit Sub
End If

SYSTEM.Trace "2"

If Is_numeric(zTrdAmt.Data) = False Then
	Exit Sub
End If

SYSTEM.Trace "3"

zTrdAmt_giho.Data = "+"
zTrdAmt.Data = l_zeropad(zTrdAmt)

SYSTEM.Trace "SDPKT410_send_zTrdAmt.Data:" & zTrdAmt.Data

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Or LEDGER.Ecod = "2200" Then
	If gubn = "출금" Then
		SYSTEM.Trace "출금완료"
		SCREEN.Proc "Main.obj_exchange.send_f", "1"
	End If
Else
	MsgBox Trim(LEDGER.Emsg), , "IBK투자증권"

	If Trim(zBnkRspnsCode.Data) <> "" Then
		If Trim(zBnkRspnsCode.Data) <> "0000" Then
			MsgBox Trim(zBnkMsgCnts.Data), , "IBK투자증권"
		End If
	End If

	SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
}



