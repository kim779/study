_AW_ONDECLARE_AW_
Dim Today, tmp

'If SCREEN.CreateObject("Info") Then
'	Today = INFO.PopData("", "NOTICECOOKIE.INI", "7700", "TODAY")
'End If

Function GetToday()
	YY = Year(Date)
	MM = Month(Date)
	If Len(MM) = 1 Then
		MM = "0" & MM
	End If
	DD = Day(Date)
	If Len(DD) = 1 Then
		DD = "0" & DD
	End If
	GetToday = YY & MM & DD
End Function

Today = GetToday()

Function DateCheck()
	Dim dflag
	dflag = 0
	DateCheck = "Y"

	If sdat.Data = "        " Then
		MsgBox "시작 날짜를 입력해주세요"
		dflag = 1
		DateCheck = "N"
		sdat.SetFocus
	ElseIf edat.Data = "        " Then
		MsgBox "종료 날짜를 입력해주세요"
		dflag = 1
		DateCheck = "N"
		edat.SetFocus
	End If

	If sdat.Data > edat.Data And dflag = 0 Then
		MsgBox "시작 날짜가 종료 날짜보다 클 수 없습니다."
		sdat.Data = Left(Today, 6) & "01"
		edat.Data = Today
	End If

End Function

Sub TodayCheck()
	sdat.Data = Left(Today, 6) & "01"
	edat.Data = Today
End Sub

Sub CheckYear()
	year1.Data = Left(Today, 4)
End Sub

Sub FormatYear()
	If gubn.Data = "1" Then
		For ii = 1 To GRID0.Rows
			yy = Left(GRID0.GetGridCell(ii, 1), 4)
			mm = Mid(GRID0.GetGridCell(ii, 1), 5, 2)
			dd = Mid(GRID0.GetGridCell(ii, 1), 7, 2)

			tmp = yy & "/" & mm & "/" & dd
			GRID0.SetGridCell ii, 1, tmp
		Next
	ElseIf gubn.Data = "2" Then
		For ii = 1 To GRID0.Rows
			yy = Left(GRID0.GetGridCell(ii, 1), 4)
			mm = Mid(GRID0.GetGridCell(ii, 1), 5, 2)

			tmp = yy & "/" & mm
			GRID0.SetGridCell ii, 1, tmp
		Next
	End If
End Sub

_AW_ONSTART_AW_
TodayCheck()
SCREEN.SEND 0

