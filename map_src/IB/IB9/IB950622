_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(LGRD)
_AW_ONCLICK_AW_
Select Case LGRD.HitPos
  Case "4"
	If LGRD.Column = 3 Then
	    LGRD.SetColumnVisible 2, True
	    LGRD.SetColumnVisible 3, False
	End If
	If LGRD.Column = 2 Then
	    LGRD.SetColumnVisible 3, True
	    LGRD.SetColumnVisible 2, False
	End If
  Case "3"
	If Trim(LGRD.GetGridCell(LGRD.row, 2)) <> "" Then
		L_SVR.Text = Trim(LGRD.GetGridCell(LGRD.row, 3))
		FUNC.Data = "X"
		SVIP.Data = LGRD.GetGridCell( LGRD.row, 2)
		SCREEN.Send 0
	End If
End Select
