RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_ArrCtrl

g_ArrCtrl = Array(ed_MapNum, ed_Dummy, ed_Type, ed_Url)
'-----------------------------------------------------------------------
Sub InitCtrl()
	For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
		g_ArrCtrl(i).Data = ""
	Next
End Sub
'-----------------------------------------------------------------------
Sub Grid2Edit(Row)
	Data = Trim(GRID0.GetGridCell(Row, 1))
	If Len(Data) = 0 Then
		Exit Sub
	End If
	For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
		g_ArrCtrl(i).Data = GRID0.GetGridCell(Row, i + 1)
	Next
End Sub
'-----------------------------------------------------------------------
Function CheckInputData()
	CheckInputData = False
	If ed_Gubn.Data = "U" Then
		Data = Trim(ed_MapNum.Data)
		If Len(Data) = 0 Then
			SCREEN.OnSend = False
		End If
		For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
			If Len(Trim(g_ArrCtrl(i).Data)) = 0 Then
				g_ArrCtrl(i).SetFocus
				GUIDE.Text = "데이타를 정확히 입력해주세요"
				Exit Function
			End If
		Next
	End If
	CheckInputData = True
End Function
'-----------------------------------------------------------------------
Sub SaveIni()
	If SCREEN.CreateObject("Info") Then

			TrNum = Trim(ed_MapNum.Data)
			Dummy = Trim(ed_Dummy.Data)
			AType = Trim(ed_Type.Data)
			Url = Trim(ed_Url.Data)


			INFO.PushData "", "WEBINFO.INI", TrNum, "Dummy", Dummy
			INFO.PushData "", "WEBINFO.INI", TrNum, "Type", AType
			INFO.PushData "", "WEBINFO.INI", TrNum, "URL", Url

			INFO.pushdata "", "AXIS.INI", "Select", TrNum, "980000"

		    Sindex = Trim(INFO.PopData("", "WEBINFO.INI", TrNum, "width"))

		   If Sindex = "" Then

				INFO.PushData "", "WEBINFO.INI", TrNum, "Width", 755
				INFO.PushData "", "WEBINFO.INI", TrNum, "Height", 540

			End If

	End If
End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
GUIDE.Text = ""

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
GUIDE.Text = OUTPUT0.Data
InitCtrl

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = "3" Then
	Grid2Edit(GRID0.Row)
	If GRID0.Column = 5 Then
		msg = "내용을 삭제하겠습니까?"

		val = MsgBox (msg, vbYesNo, "URL 삭제")
		If val = "6" Then
			ed_Gubn.Data = "D"
			SCREEN.Send 0
			ed_Gubn.Data = "Q"
			GRID0.Column = 1
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(LABEL3)
_AW_ONCLICK_AW_
'SCREEN.ChangeMap "IB95100A"
