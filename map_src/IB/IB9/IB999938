Sub Password_initSetting(ed_str) 		' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "1" Then
		ed_str.Data = SCREEN.Object("main.OBJ_order.ed_pswd").Data
	Else
		ed_str.Data = "9999"
	End If

	If Trim(SYSTEM.UserPass) <> Trim(ed_str.Data) Then
		If Len(Trim(ed_str.Data)) >= 4 And Trim(ed_str.Data) <> "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(ed_str.Data))
			ed_str.Data = "HEAD"
		ElseIf Trim(ed_str.Data) = "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = Trim(SCREEN.Object("main.OBJ_order.LEDGER").EPwd)
			ed_str.Data = "HEAD"
		End If
	End If

	If Trim(ed_str.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			SCREEN.Object("main.OBJ_order.ed_pswd").Data = ""
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If
End Sub

