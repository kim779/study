RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_init()
	LEDGER.Rcnt = "0007"
	zEmpNo.Data = SYSTEM.UserID
	'zEmpNo.Data = "101087"
	zQrySrtDt.Data = Replace(Date,"-","")
	zQryEndDt.Data = Replace(DateAdd("d", 14, Date),"-","")
	zPrdTp.Data = "00"
	zEmpTp.Data = "0"
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	Call Set_init()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0007"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim i
	For i=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,7)) <> "" Then
			SCREEN.CreateWindow 1, "IB872000 /s/t/p5/d", "EmpType" & vbTab & "0" & vbLf
			Exit Sub
		End If
	Next
End If

SCREEN.Object("parent.OBJECT13").Proc "send_f",""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


