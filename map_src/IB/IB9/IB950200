	svcd = Trim(GRID.GetGridCell(ii, 8))	' 서비스명
	bpip = Trim(GRID.GetGridCell(ii, 6))	' BP IP

	' 서비스명에 따른 하이라이트 기능
	If COLOUR.Checked = True Then
		Select Case Trim(svcd)
		Case "SBPLI301", "SBPLI303" ' 로그인 빨간색 강조
			For jj = 1 To GRID.Columns
				Call GRID.SetTRgb(ii, jj, 94)
			Next

		Case "SBPLT304"				' 로그아웃 파란색 강조
			For jj = 1 To GRID.Columns
				Call GRID.SetTRgb(ii, jj, 95)
			Next

		Case "SBPGT170", "SBPGT307", "SBPGT336", "SBPGT339", "SBPGT348", "SBPGT350", "SBPGT384", "ATON0109", "ATON0104"	 ' (공동인증/간편인증)
			' (공동인증/간편인증) 초록색 강조
			For jj = 1 To GRID.Columns
				Call GRID.SetTRgb(ii, jj, 228)
			Next

		Case "SAMSQ001", "SAMSQ002", "SAMSQ003", "SAMST002"	' FDS 회색 BLUR 처리
			For jj = 1 To GRID.Columns
				Call GRID.SetTRgb(ii, jj, 242)
			Next

		Case "SOFST501", "SOFST502", "SONAT000", "SONAT001", "SONAT002", "SONAT013", "SONAT040", "SONAT043", "SONAT080", "SONAT081", "SONAT082", "SONAT200", "SONAT201", "SONAT202", "SONAT203", "SONAT400", "SONAT401", "SONAT402", "SONAT500", "SONAT501", "SONAT502", "SONBT001", "SONBT002", "SONBT003", "SONBT004", "COSAT002", "COSAT003", "COSAT004"
			' 주문 보라색 강조
			For jj = 1 To GRID.Columns
				Call GRID.SetTRgb(ii, jj, 86)
			Next

		Case "SONAQ452", "SONAQ052", "SACMT238"	' 잔고조회, 비밀번호 검증 남색 강조
			For jj = 1 To GRID.Columns
				Call GRID.SetTRgb(ii, jj, 230)
			Next

		Case Else
			Select Case Left(Trim(svcd), 3)
			Case "ATO" ' (간편인증 & OTP) 초록색 강조
				For jj = 1 To GRID.Columns
					Call GRID.SetTRgb(ii, jj, 228)
				Next

			Case "COS"	' 해외주식 전문 주황색 강조
				For jj = 1 To GRID.Columns
					Call GRID.SetTRgb(ii, jj, 210)
				Next

			Case "CON"	' 국내주식 해외 스위칭 전문 주황색 강조
				For jj = 1 To GRID.Columns
					Call GRID.SetTRgb(ii, jj, 210)
				Next

			Case "SBP"	' 인증정보 관련 전문 초록색 강조
				For jj = 1 To GRID.Columns
					Call GRID.SetTRgb(ii, jj, 228)
				Next

			Case Else	' 통상전문 : 검정색 글자 색상
				For jj = 1 To GRID.Columns
					Call GRID.SetTRgb(ii, jj, 69)
				Next
			End Select
		End Select
	Else
		For jj = 1 To GRID.Columns
			Call GRID.SetTRgb(ii, jj, 69)
		Next
	End If

