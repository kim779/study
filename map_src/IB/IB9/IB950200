		gubn.Data = "0"
	Else
		gubn.Data = "1"
	End If
Else
	If svc = "" Then
		gubn.Data = "2"
	Else
		gubn.Data = "3"
	End If
End If

If CHECK0.Checked Then
	gubn.Data = "4"
End If

usid.Data = Trim(usid.Data)
trxc.Data = Trim(trxc.Data)


If range.Checked = True Then
	sterm.Data = stime.Data
	eterm.Data = etime.Data
Else
	sterm.Clear
	eterm.Clear
End If

' 입력일자 없을경우 오늘날자 세팅
If Trim(idat.Data) = "" Then
	idat.Data = gettoday()
End If

