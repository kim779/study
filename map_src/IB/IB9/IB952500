Sub FormatYear()
	If gubn.Data = "1" Then
		For ii = 1 To GRID0.Rows
			yy = Left(GRID0.GetGridCell(ii, 1), 4)
			mm = Mid(GRID0.GetGridCell(ii, 1), 5, 2)
			dd = Mid(GRID0.GetGridCell(ii, 1), 7, 2)

			tmp = yy & "/" & mm & "/" & dd
			GRID0.SetGridCell ii, 1, tmp
		Next
	ElseIf gubn.Data = "2" Then
		For ii = 1 To GRID0.Rows
			yy = Left(GRID0.GetGridCell(ii, 1), 4)
			mm = Mid(GRID0.GetGridCell(ii, 1), 5, 2)

			tmp = yy & "/" & mm
			GRID0.SetGridCell ii, 1, tmp
		Next
	End If
End Sub

