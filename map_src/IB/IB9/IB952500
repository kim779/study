Function GetToday()
	YY = Year(Date)
	MM = Month(Date)
	If Len(MM) = 1 Then
		MM = "0" & MM
	End If
	DD = Day(Date)
	If Len(DD) = 1 Then
		DD = "0" & DD
	End If
	GetToday = YY & MM & DD
End Function

Today = GetToday()

Function DateCheck()
	Dim dflag
	dflag = 0
	DateCheck = "Y"

	If sdat.Data = "        " Then
		MsgBox "시작 날짜를 입력해주세요"
		dflag = 1
		DateCheck = "N"
		sdat.SetFocus
	ElseIf edat.Data = "        " Then
		MsgBox "종료 날짜를 입력해주세요"
		dflag = 1
		DateCheck = "N"
		edat.SetFocus
	End If

	If sdat.Data > edat.Data And dflag = 0 Then
		MsgBox "시작 날짜가 종료 날짜보다 클 수 없습니다."
		sdat.Data = Left(Today, 6) & "01"
		edat.Data = Today
	End If

End Function

Sub TodayCheck()
	sdat.Data = Left(Today, 6) & "01"
	edat.Data = Today
End Sub

