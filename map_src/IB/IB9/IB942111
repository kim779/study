RESOURCE DIVISION
{


_AW_ONSTART_AW_
SCREEN.CreateObject("Info")
INFO.pushdata LOGIN.name, "userconf.ini", "IB900100", "confirm", ""

Dim data, array, i, j, k
j = 0

data = Replace(g_memo.data, "／", "/")

array = Split(data, "｜", -1, 1)


For Each i in array
	j = j + 1
	memo.InsertRow -1
	memo.SetGridCell memo.Rows, 1, i
Next

If j < 20 Then
	For i = j To 20
		memo.InsertRow -1
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
