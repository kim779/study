RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim oYear, oMonth, oDay, cYear, cMonth
Dim gridFocus, cday
gridFocus = -1
cday = "0"

Sub startDay(y, m)
	zStrDt.Data = y & m & "01"
	zEndDt.Data = y & m & "31"
	TDM.Data = "5"
	SCREEN.Send 0
End Sub

Sub zeroUp()
	gridFocus = -1
	cday = 0
End Sub

_AW_ONRECEIVE_AW_
SCREEN.Object("main.obj_gmsg.gmsg").data = Trim(GUIDE.Data)

Dim ii
Dim sesum, scsum, sjsum, stsum

sesum = 0
scsum = 0
sjsum = 0
stsum = 0

For ii = 1 To GRID0.Rows
	If IsNumeric(GRID0.GetGridCell(ii, 4)) = True Then
		sesum = sesum + CDbl(GRID0.GetGridCell(ii, 4))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 5)) = True Then
		scsum = scsum + CDbl(GRID0.GetGridCell(ii, 5))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 6)) = True Then
		sjsum = sjsum + CDbl(GRID0.GetGridCell(ii, 6))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 9)) = True Then
		stsum = stsum + CDbl(GRID0.GetGridCell(ii, 9))
	End If
Next

desum.Data = sesum
dcsum.Data = scsum
djsum.Data = sjsum
dtsum.Data = stsum

oYear = SCREEN.Object("main.yesYear").text
oMonth = SCREEN.Object("main.yesMonth").text
oDay = Left(GRID0.GetGridCell(GRID0.Rows, 1), 2)

If flag.Text = "0" Then
	SCREEN.Object("main.yesDay").text = oDay
End If
flag.Text = "0"

If cday = "0" Then
	SCREEN.Object("obj0.zStrDt").Data = oYear & oMonth & oDay
	SCREEN.Object("obj0.zEndDt").Data = oYear & oMonth & oDay
Else
	SCREEN.Object("obj0.zStrDt").Data = oYear & oMonth & cday
	SCREEN.Object("obj0.zEndDt").Data = oYear & oMonth & cday
End If
SCREEN.Object("obj0.TDM").Data = "6"
obj0.Send

cday = SCREEN.Object("main.yesDay").text

If gridFocus = -1 Then
	GRID0.Index = CLng(GRID0.rows) - 1
Else
	GRID0.Index = CLng(gridFocus) - 1
End If
GRID0.SetFocus()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then

cYear = SCREEN.Object("main.year").data
cMonth = Trim(SCREEN.Object("main.yesMonth").text)
gridFocus = GRID0.Row

cday = Left(GRID0.GetGridCell(GRID0.row, 1), 2)

If Trim(cday) <> "" Then
	SCREEN.Object("main.yesDay").text = cday
	SCREEN.Object("obj0.TDM").Data = "6"
	SCREEN.Object("obj0.zStrDt").Data = cYear & cMonth & cday
	SCREEN.Object("obj0.zEndDt").Data = cYear & cMonth & cday
	obj0.Send
End If

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



