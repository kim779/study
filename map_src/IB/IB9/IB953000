			SCREEN.Send 0
		Else
			outmsg.Data = "이미 승인한 건은 재승인이 불가합니다."
		End If
	Else
		outmsg.Data = "조회 후 승인 대상을 선택하세요"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_DEL)
_AW_ONCLICK_AW_
If Trim(usid.Data) = Trim(reg_id.Data) Then
	If Len(Trim(INPUT7.Data)) > 0 Then
		If Trim(proc_yn.Data) = "N" Then
			gubn.Data = "30"
			SCREEN.Send 0
		Else
			outmsg.Data = "처리된 건은 삭제가 불가합니다. (단, 승인 후 처리되지 않은 건은 삭제 가능)"
		End If
	End If
