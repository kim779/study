_AW_ONDECLARE_AW_
Sub setattr()
	Dim ii
	For ii=1 To 7
		SCREEN.Object("SET"&ii).Data = SCREEN.Object("INPUT"&ii).Data
		'SCREEN.Object("INPUT"&ii).Data = ""
	Next
End Sub

Sub clicktab(id)
UTAB0.ID = id
Select Case id
	Case 1 :
			 PANEL2.Visible = False
	         PANEL5.Visible = True
	         PANEL6.Visible = False
	         BTN_ADD.Visible = True
	         BTN_ADD.Enable = True
	         BTN_DEL.Visible = False
	         BTN_DEL.Enable = False
	         BTN_APRV.Visible = False
	         BTN_APRV.Enable = False
	         BTN_PROC.Visible = False
	         BTN_PROC.Enable = False
	Case 2 :
			 PANEL2.Visible = True
	         PANEL5.Visible = False
	         PANEL6.Visible = False
	         BTN_ADD.Visible = False
	         BTN_ADD.Enable = False
	         BTN_DEL.Visible = True
	         BTN_DEL.Enable = True
	         BTN_APRV.Visible = False
	         BTN_APRV.Enable = False
	         BTN_PROC.Visible = False
	         BTN_PROC.Enable = False
	Case 3 :
			 PANEL2.Visible = False
	         PANEL5.Visible = False
	         PANEL6.Visible = True
	         BTN_ADD.Visible = False
	         BTN_ADD.Enable = False
	         BTN_DEL.Visible = False
	         BTN_DEL.Enable = False
	         BTN_APRV.Visible = True
	         BTN_APRV.Enable = True
	         BTN_PROC.Visible = False
	         BTN_PROC.Enable = False
	Case 4:
			 PANEL2.Visible = False
	         PANEL5.Visible = True
	         PANEL6.Visible = False
	         BTN_ADD.Visible = False
	         BTN_ADD.Enable = False
	         BTN_DEL.Visible = False
	         BTN_DEL.Enable = False
	         BTN_APRV.Visible = False
	         BTN_APRV.Enable = False
	         BTN_PROC.Visible = True
	         BTN_PROC.Enable = True
End Select
End Sub


Sub send_f()
	gubn.Data = "10"	'결재권자
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
name.Data = LOGIN.name
usid.Data = LOGIN.User
If Trim(usid.Data) = "081393" Or Trim(usid.Data) = "071002" Then
	usertype.Data = "2"	'결재권자
Else
	usertype.Data = "1"	'기안자
End If
clicktab(UTAB0.id)
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
setattr()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	If usertype.Data = "1" Then
		If Trim(GRID0.GetGridCell(GRID0.Row, 13)) <> "Y" Then
	    	clicktab(2)
	    Else
	    	clicktab(4)
