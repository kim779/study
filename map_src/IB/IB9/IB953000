If Len(Trim(INPUT7.Data)) > 0 Then
	If Trim(usid.Data) = Trim(reg_id.Data) Then
		If Trim(aprv_yn.Data) = "Y" Then
			If Trim(proc_yn.Data) <> "Y" Then
				SCREEN.CreateWindow 2, "IB953001 /p5/t/s /d", _
				"zClntId" & vbTab & INPUT3.Data & vbLf & _
				"zClntName" & vbTab & INPUT2.Data
				If SYSTEM.Pop("aprv_exe_yn") = "OK" Then
					gubn.Data = "50"
					SCREEN.Send 0
				End If
			Else
				outmsg.Data = "이미 처리되었습니다."
			End If
		Else
			outmsg.Data = "승인후 처리 하시기 바랍니다."
		End If
	Else
		outmsg.Data = "등록한 직원만이 처리할 수 있습니다."
	End If
