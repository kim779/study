	End If

	dayd = Mid(Trim(GRID0.GetGridCell (i, 1)), 1, 2)
	dayd = FormatNumber(dayd, 0)

	If (year.Data = 2020 And month.Data = 12 And dayd >= 4) Or (year.Data > 2020) Then
		htot = CLng(Trim(GRID0.GetGridCell (i, 12)))
		Total = htot + wuser + muser + juser + kuser + mwuser
	Else
		htot = emp + acust + bcust
		Total = htot + wuser + muser + juser + kuser + mwuser
	End If

	GRID0.SetGridCell i, 5, htot - emp
	GRID0.SetGridCell i, 7, htot
	GRID0.SetGridCell i, 14, Total
	Next

Else
	For i = 1 To GRID0.Rows
	If Trim(GRID0.GetGridCell (i, 4)) = "" Then
		emp =0
	Else
		emp = CLng(Trim(GRID0.GetGridCell (i, 4)))
	End If

	If Trim(GRID0.GetGridCell (i, 5)) = "" Then
		acust = 0
	Else
		acust = CLng(Trim(GRID0.GetGridCell (i, 5)))
	End If

	If Trim(GRID0.GetGridCell (i, 6)) = "" Then
		bcust = 0
	Else
		bcust = CLng(Trim(GRID0.GetGridCell (i, 6)))
	End If

		If Trim(GRID0.GetGridCell (i, 8)) = "" Then
		wuser = 0
	Else
		wuser = CLng(Trim(GRID0.GetGridCell (i, 8)))
	End If

	If Trim(GRID0.GetGridCell (i, 9)) = "" Then
		muser = 0
	Else
		muser = CLng(Trim(GRID0.GetGridCell (i, 9)))
	End If


	htot = emp + acust + bcust
	Total = htot + wuser + muser

	GRID0.SetGridCell i, 5, acust + bcust
	GRID0.SetGridCell i, 7, htot
	GRID0.SetGridCell i, 14, Total
	Next

