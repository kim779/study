	SCREEN.CreateObject("DX_CSTRING")
	ls_data = as_output
	DX_CSTRING.Text = ls_data
	n_len = DX_CSTRING.GetLength()
	If DX_CSTRING.Right(1) = vbLf Then
		ls_data = DX_CSTRING.Left(n_len - 1)
		DX_CSTRING.Text = ls_data
		n_len = 0
		n_len = DX_CSTRING.GetLength()
	End If

	If Right(ls_data, 1) = vbTab Then
		ls_data = DX_CSTRING.Left(n_len - 1)
		DX_CSTRING.Text = ls_data
		n_len = 0
		n_len = DX_CSTRING.GetLength()
	End If

	If (SYSTEM.SystemID = "D") Then			'// 대투 원장 헤더
		LEDGER.MgrApprTp 		=	DX_CSTRING.Mid(104, 1)
		LEDGER.MgrApprEmpno	=	DX_CSTRING.Mid(105, 5)
		LEDGER.MgrApprSeqno	=	DX_CSTRING.Mid(118, 5)

	   as_errcode = DX_CSTRING.Mid(127, 6)
	   as_ErrMsg  = DX_CSTRING.Mid(134, 130)
	   LEDGER.LstKey  = DX_CSTRING.Mid(269, 6)

	   as_svc_no  = DX_CSTRING.Mid(325, 4)
	   LEDGER.NextKey = DX_CSTRING.Mid(275, 50)
	   LEDGER.trcontyn = DX_CSTRING.Mid(264, 1)
		as_Data    = DX_CSTRING.Mid(400, n_len - 400)
	Else												'// 하나 원장 헤더
