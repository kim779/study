'**********************************************************************
' 기능     : SCREEN.service 호출 함수
' 파라메터 : as_svc_name   : 턱시도 서비스명
'            as_job_cd     : 작업구분(1 조회, 2 입력, 3 수정, 4 삭제)
'            as_input      : 입력데이타
'            as_last_key   : 연속거래키
' 리턴값   : cp_make_head
' 개발자   : 김동겸	04/09/08
' 수정자1  :
'**********************************************************************

Public Function cp_service_call(as_svc_name, as_job_cd, as_tr_cont_yn, as_last_key, as_input, byref as_errmsg)

	Dim ll_ret, ls_head, ls_input, ll_pos, ls_bp_protocol
	Dim TIMEOUT

	ci_svc_no = cp_lpad(cp_nvl(ci_svc_no, 0) + 1, 4, "0") 'service no 부여함.

	ls_bp_protocol = "pibotuxq"
'	통신Packet Header 구성
	ls_head = cp_make_head(as_job_cd, as_svc_name, as_tr_cont_yn, as_last_key, ci_svc_no)
	ls_input = ls_head & as_input
	SCREEN.CreateObject("DX_CSTRING")
	DX_CSTRING.Text = ls_input

	If Not SCREEN.service(ls_bp_protocol, ls_input, DX_CSTRING.GetLength(), 0) Then
		as_errmsg	= "서버와의 통신(Service Call)에 실패했습니다."
		cp_service_call = -1
	Else
		as_ErrMsg = ""
		cp_service_call = ci_svc_no
	End If
End Function
'**********************************************************************
' 기능     : SCREEN.service 호출 함수
' 파라메터 : as_svc_name   : 턱시도 서비스명
'            as_job_cd     : 작업구분(1 조회, 2 입력, 3 수정, 4 삭제)
'            as_input      : 입력데이타
'            as_last_key   : 연속거래키
' 리턴값   : cp_make_head
' 개발자   : 김동겸	04/09/08
' 수정자1  :
'**********************************************************************

Public Function cp_serviceEx_call(as_svc_name, as_job_cd, as_tr_cont_yn, as_last_key, as_input, byref as_errmsg, as_timeout)

	Dim ll_ret, ls_head, ls_input, ll_pos, ls_bp_protocol, n_len, ls_data
	Dim TIMEOUT

	ci_svc_no = cp_lpad(cp_nvl(ci_svc_no, 0) + 1, 4, "0") 'service no 부여함.

	ls_bp_protocol = "pibotcal"
'	통신Packet Header 구성
	ls_head = cp_make_head(as_job_cd, as_svc_name, as_tr_cont_yn, as_last_key, ci_svc_no)
	ls_input = ls_head & as_input
	SCREEN.CreateObject("DX_CSTRING")
	DX_CSTRING.Text = ls_input
   ls_data = SCREEN.serviceEX(ls_bp_protocol, ls_input, DX_CSTRING.GetLength(), 0, as_timeout)

	SCREEN.CreateObject("DX_CSTRING")
	DX_CSTRING.Text = ls_data

	n_len = DX_CSTRING.GetLength()
	If (SYSTEM.SystemID = "D") Then
	   cp_serviceEx_call  = DX_CSTRING.Mid(400, n_len - 400)
	Else
	   cp_serviceEx_call  = DX_CSTRING.Mid(450, n_len - 450)
	End If
End Function


