RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim array

Sub parsing(data)

	array = Split(data, " ", -1, 1)
	arraylen = UBound(array) - LBound(array) + 1

	SYSTEM.Trace data
	arraylen = UBound(array) - LBound(array) + 1

	If arraylen <> 10 Then
		SCREEN.OnSend  = False
		MsgBox "종목을 모두 입력해 주세요", 0, "IBK 투자증권"
		Exit Sub
	End If

	For ii = 0 To GRID0.Rows - 1

	'data = Trim(GRID0.GetGridCell(ii+1, 1))
	code = array(ii)

	GRID0.SetGridCell ii+1, 1, code
	GRID0.SetGridCell ii+1, 2, ii+1

	Next

	NCNT.Data = ii

End Sub

_AW_ONSEND_AW_
If SCREEN.Object("main.UTAB1").Index = 0 Then
	Gubn.Data = "1"
ElseIf SCREEN.Object("main.UTAB1").Index  = 1 Then
	Gubn.Data = "4"
End If



For ii = 1 To GRID0.Rows
	code = GRID0.GetGridCell (ii, 1)
	code = Trim(code)
	SYSTEM.Trace code
	If code = "" Then
		SCREEN.OnSend  = False
		MsgBox "종목을 모두 입력해 주세요", 0, "IBK 투자증권"
		Exit For
	End If

Next

