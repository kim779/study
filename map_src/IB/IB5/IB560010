'***************************************************************************
' DESC: 0보다큰 숫자형식인지 검사. 유효숫자( > 0):true else false
'***************************************************************************
Function Is_numeric(data)
	Dim number
	number = Trim(data)

	If number = "" Then
		number = 0
	End If

	Is_numeric = False
	If IsNumeric(number) = False Then
		Exit Function
	End If

	Is_numeric = True
End Function

