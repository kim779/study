RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim fg

_AW_ONSTART_AW_

SCREEN.Object ("obj1.upgb").data = "0"
SCREEN.Proc "obj1.send_f", ""

S300901.DATA = c_upgb.DATA
If c_upgb.DATA = 889 Then
	S300901.Enable = False
	UBUT.Enable = False
	cb1.Enable = False
Else
	S300901.Enable = True
	UBUT.Enable = True
	cb1.Enable = True
End If

SCREEN.SetTimer 5 , False

fg = 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If S300301.Data = 1 Then
	S301300.SetFocus
	S301300.INDEX = 0
ElseIf S300301.Data = "-1" Then
	S301300.SetFocus
	S301300.INDEX = S301300.Rows-1
End If

S301300.SetFocus

If OUTPUT0.Data  > S300307.Data Then
	'윗 페이지로 이동시 하단부터 보이도록 포커스 이동
	'하나로는 기능이 정상작동하지 않아 여러건을 걸었음.
	S301300.Index S301300.Rows - 3
	S301300.Index S301300.Rows - 2
	S301300.Index S301300.Rows - 1
Else
	S301300.Index 0
End If

S301300.SetFocus


OUTPUT0.Data = S300307.Data

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If cb1.Focus = True And SCREEN.Key = 13 Then
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(company)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To S301300.Rows
	str = str & Right(Trim(S301300.GetGridCell(i, 1)), 6)
	str = str & vbTab
	str = str & Trim(S301300.GetGridCell(i, 3))
	str = str & vbLf
Next

If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, S301300.Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(301300)
_AW_ONCLICK_AW_
Select Case S301300.HitPos
Case 3	'DATA부 click
	If Len(Trim(S301300.GetGridCell(S301300.Index +1, 1))) = 7 Then
		S1301.DATA = Right(Trim(S301300.GetGridCell(S301300.Index +1, 1)),6)
		If Trim(S1301.DATA) = "" Then
		    Exit Sub
		End If

		S1301.Trigger "", False
		S1301.Trigger "", True
	   SYSTEM.SetHistory "1301", S1301.DATA
	End If
Case Else
	SCREEN.OnSend = fasle
	Exit Sub
End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UBUT)
_AW_ONCLICK_AW_
Dim retn

Select Case c_upgb.Data
	Case "001", "101", "401"		'KOSPI, KOSPI200, KOSPI100
		retn = SCREEN.GetCode(104, "300901", "20022", 0)
	Case "201", "301"							'KOSDAQ
		retn = SCREEN.GetCode(104, "300901", "20022", 9)
End Select


If (retn <> True) Then
	S300901.SetFocus
	Exit Sub
Else
	S300901.SetFocus
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(300901)
_AW_ONCHANGE_AW_
Dim	cod
If (Len(Trim(S300901.Data)) <> 3) Then
	S300901.SetFocus
	Exit Sub
Else
	SCREEN.IgnoreChange True
	c_upgb.Data = S300901.Data

	SCREEN.Send 0
	SCREEN.IgnoreChange False
End If
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 Then
	If(Len(Trim(S20301.Data)) <> 3) Then
'			S20301.Clear
			S20301.SetFocus
			Exit Sub
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_upgb)
_AW_ONCHANGE_AW_

'KOSPI
If c_upgb.DATA = "001" Then
	SCREEN.Object ("obj1.upgb").data = "0"
	SCREEN.Proc "obj1.send_f", ""
'KOSDAQ
ElseIf c_upgb.DATA = "201" Then
	SCREEN.Object ("obj1.upgb").data = "2"
	SCREEN.Proc "obj1.send_f", ""
'KOSPI200
ElseIf c_upgb.DATA = "101" Then
	SCREEN.Object ("obj1.upgb").data = "1"
	SCREEN.Proc "obj1.send_f", ""
'KOSPI100
ElseIf c_upgb.DATA = "401" Then
   cb1.SetItems "401" & vbTab & "401KOSPI100"
'전체(ELW제외)
ElseIf c_upgb.DATA = "889" Then
	cb1.SetItems "889" & vbTab & "889전체"
End If

SCREEN.IgnoreChange True
S300901.Data = c_upgb.Data
SCREEN.IgnoreChange False

If S300901.DATA = 889 Then
	S300901.Enable = False
	UBUT.Enable = False
	cb1.Enable = False
Else
	S300901.Enable = True
	UBUT.Enable = True
	cb1.Enable = True
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
OBJECT0.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cb1)
_AW_ONCHANGE_AW_
'
'
SCREEN.IgnoreChange True
S300901.DATA = cb1.DATA
OBJECT0.Proc "set_cb1", cb1.DATA
SCREEN.IgnoreChange False
'
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_

S300307.Data = 0
OUTPUT0.Data = 0

If fg = 0 Then
	OBJECT0.Visible = True
	S301300.Visible = False
	fg = 1
	OBJECT0.Proc "set_cb1", S300901.DATA
Else
	OBJECT0.Visible = False
	S301300.Visible = True
	fg = 0
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



