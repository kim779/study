	S1301.Data = code
	If Trim(S1301.Data) = "" Then
	    Exit Sub
	End If
	SCREEN.Proc "main.send_sise", "top" & "," & S1301.Data

	'If S1301.Data > 500000 Then
	If SCREEN.GetCodeType(S1301.Data) = 9 Then
		E1301.Data = S1301.Data
		E1301.Trigger "E1301", True
	End If
End Sub

