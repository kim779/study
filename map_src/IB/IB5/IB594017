If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		If Len(Trim(GRID0.GetGridText(1, 5))) > 0 Then  '상대기관계좌번호

			stmp = "01" & vbTab
			For ii = 1 To GRID0.Rows
				If Len(Trim(GRID0.GetGridText(ii, 5))) > 0 Then
					If ii < 10 Then
						tmps = "0" & ii
					Else
						tmps = ii
					End If
					stmp = stmp  & tmps & Trim(GRID0.GetGridText(ii, 5)) & vbTab
				End If
			Next

			SCREEN.Object("Parent.COMBO1").SetItems(stmp)
			SCREEN.Object("Parent.COMBO1").Index = 0

			stmp = Replace(Trim(SCREEN.Object("Parent.COMBO1").text), "-","")
			SCREEN.Object("Parent.EDIT_ACCT").Data = stmp

			stmp = ""
			For ii = 1 To GRID0.Rows '계좌번호, 계좌명, 상대기관코드, 상대계좌명, 통화코드, 거래기관명
				If Len(Trim(GRID0.GetGridText(ii, 5))) > 0 Then
					stmp = stmp  & Trim(GRID0.GetGridText(ii, 5)) & vbTab & Trim(GRID0.GetGridText(ii, 2)) &_
					vbTab & Trim(GRID0.GetGridText(ii, 3)) & vbTab & Trim(GRID0.GetGridText(ii, 6)) &_
					vbTab & Trim(GRID0.GetGridText(ii, 9)) & vbTab & Trim(GRID0.GetGridText(ii, 4)) & vbLf

SYSTEM.Trace "IB594017 promised acc = " & stmp
				End If
			Next

			If Len(stmp) > 0 Then
				SCREEN.Proc "Parent.SetSrcData", stmp
				SCREEN.Proc "Parent.SetBnkCode", SCREEN.Object("Parent.EDIT_ACCT").text
			End If

		End If
	End If
Else
	SYSTEM.Trace "Mapmame : " & SCREEN.GetMapName(0)
	SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)
End If

