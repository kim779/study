_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID0.Clear
	chk.Data = 0
	acntno.Data = acntno.Data = SCREEN.Object("parent.CMB_ACCT").Data
	LEDGER.Fkey = "C"
	SCREEN.SetTimer 2, False
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'메인에서 약정계좌인지 조회시 사용
Sub send_check()
	GRID0.Clear
	chk.Data = 1
	LEDGER.Fkey = "C"
	SCREEN.Object("Parent.EDIT_ACCT").Data = ""
	SCREEN.Object("Parent.COMBO1").SetItems("13" &vbTab& "")
	acntno.Data = SCREEN.Object("Parent.CMB_ACCT").Data
	SCREEN.send 0
End Sub

'은행->증권에서 사용
Sub send_bank()
	GRID0.Clear
	chk.Data = 2
	LEDGER.Fkey = "C"
	SCREEN.send 0
End Sub

Dim main_acct, ii, acct, result

'메인의 입금계좌번호가 약정계좌인지 조회
Sub find_YJAcct()
	Dim main_acct, result, ii, acct
	main_acct = Trim(SCREEN.Object("parent.EDIT_ACCT").data)
	result = 0

	If main_acct <> "" Then
		For ii = 1 To GRID0.Rows
			acct = Trim(GRID0.GetGridCell(ii, 3))

			If StrComp(main_acct, acct, 1) = 0 Then
				result = 1
				Exit For
			End If
		Next
	End If

	Call Setting_main(result)
End Sub


Sub Setting_main(data)
'
'	If data = 1 Then
'		SCREEN.Proc "parent.BNK_SEND", ""	'약정계좌
'	Else
'		SCREEN.Proc "parent.OTP_chk", ""	'미약정계좌
'	End If

	SCREEN.Proc "parent.sendStatus", data
End Sub

'은행->증권에서 로그인시 약정계좌 세팅
Sub Setting_acct()
	GRID0.Sort 1, True, True
	Dim ii, items, code, name, acct, item, yitems, names

	For ii=1 To GRID0.Rows
		If Trim(GRID0.getgridcell(ii, 3)) <> "" Then
			code = Trim(GRID0.GetGridText(ii, 1))
			name = Trim(GRID0.GetGridtext(ii,2))
			acct = Trim(GRID0.GetGridtext(ii,3))

			item = code & " " & name & " " & acct
			items = items & vbTab & item
			yitems = yitems & vbTab & acct
			names = names & vbTab & name
		End If
	Next

	SCREEN.Object("parent.CMB_ACCT2").SetItems(items)
	SCREEN.Object("parent.CMB_YACCT").SetItems(yitems)
	SCREEN.Object("parent.CMB_NAME").SetItems(names)
	SCREEN.Object("parent.BTNNAME").SetFocus
End Sub

Function GetToday()
	Dim AYear,AMonth,ADay
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
	AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
	ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function

