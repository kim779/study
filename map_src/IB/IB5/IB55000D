_AW_ONDECLARE_AW_
Function result(num,modtmp)
	result = num - Int(num / modtmp) * modtmp 
End Function

_AW_ONSEND_AW_
If SYSTEM.ConnectBy ="1" Then
	ed_comcode.Data = "00"
Else
	ed_comcode.Data = "  "
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
Dim sdata
Dim val
Dim ii, jj
ecod = Trim(LEDGER.Ecod)
val = SCREEN.Object("parent.out_OdUnit").Data
If Left(ecod, 1) = "0" Then
	If ed_qrytp.Data = "1" Then '외화
		Select Case SCREEN.Object("parent.cb_fc").index
		Case 0	' 선택
			SCREEN.Object("parent.ed_jqty").Data = 0
			' Do Nothing

		Case 1	' 최대
			SCREEN.Object("parent.ed_jqty").Data =   o_ordableqty.Data - (o_ordableqty.Data Mod val)

		Case 2	' 75%
			If IsNumeric(o_ordableqty.Data) = True Then
				
				'SCREEN.Object("parent.ed_jqty").Data = CInt(o_ordableqty.Data) * 0.75 - CInt(o_ordableqty.Data) * 0.75 Mod val
				SCREEN.Object("parent.ed_jqty").Data = Fix(o_ordableqty.Data) * 0.75 - Result(Fix(o_ordableqty.Data) * 0.75, val)
			End If

		Case 3	' 50%
			If IsNumeric(o_ordableqty.Data) = True Then
				SCREEN.Object("parent.ed_jqty").Data = Fix(o_ordableqty.Data) * 0.5 - Result(Fix(o_ordableqty.Data) * 0.5, val)
			End If

		Case 4	' 25%
			If IsNumeric(o_ordableqty.Data) = True Then
				SCREEN.Object("parent.ed_jqty").Data = Fix(o_ordableqty.Data) * 0.25 - Result(Fix(o_ordableqty.Data) * 0.25, val)
			End If

		Case Else
			SCREEN.Object("parent.ed_jqty").Data = 0
			' Do Nothing

		End Select

	Else					'외화 + 원화
		Select Case SCREEN.Object("parent.cb_wfc").index
		Case 0	' 선택
			SCREEN.Object("parent.ed_jqty").Data = 0
			' Do Nothing

		Case 1	' 최대
			SCREEN.Object("parent.ed_jqty").Data =   o_ordableqty.Data - (o_ordableqty.Data Mod val)

		Case 2	' 75%
			If IsNumeric(o_ordableqty.Data) = True Then
				SCREEN.Object("parent.ed_jqty").Data = Fix(o_ordableqty.Data) * 0.75 - Result(Fix(o_ordableqty.Data) * 0.75, val)
			End If

		Case 3	' 50%
			If IsNumeric(o_ordableqty.Data) = True Then
				SCREEN.Object("parent.ed_jqty").Data = Fix(o_ordableqty.Data) * 0.5 - Result(Fix(o_ordableqty.Data) * 0.5, val)
			End If

		Case 4	' 25%
			If IsNumeric(o_ordableqty.Data) = True Then
				SCREEN.Object("parent.ed_jqty").Data = Fix(o_ordableqty.Data) * 0.25 - Result(Fix(o_ordableqty.Data) * 0.25, val)
			End If

		Case Else
			SCREEN.Object("parent.ed_jqty").Data = 0
			' Do Nothing

		End Select

	End If

	SCREEN.Proc "Parent.CalWon", ""
End If

