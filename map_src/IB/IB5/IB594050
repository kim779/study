{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	GRID0.SetDataPosition 0
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False
LEDGER.Rcnt = "0010"

ed_In.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("main.OBJ1.CMB_ACCT").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("main.OBJ1.CMB_ACCT").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = "0" Then
   ed_pswd.Data = "9999"
Else
	If Len(Trim(SCREEN.Object("parent.OBJ1.zPwd").data)) < 4 Then
			Call alert_msg("계좌번호 비밀번호를 확인하여 주십시오.")
		SCREEN.Object("main.OBJ1.zPwd").SetFocus
		Exit Sub
	End If

	LEDGER.Hsiz = 44
	LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(SCREEN.Object("parent.OBJ1.zPwd").data))
	ed_pswd.Data = "HEAD"
End If

ed_stdt.Data = zStrDt.Data
ed_eddt.Data = zEndDt.Data

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod, ii, tong, curr

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = "0" Then
	For ii = 1 To GRID0.Rows
		GRID0.SetGridCell ii, 1, Trim(GRID0.GetGridCell(ii, 13))   '이체일자
		GRID0.SetGridCell ii, 2, Trim(GRID0.GetGridCell(ii, 14))   '처리시간
		GRID0.SetGridCell ii, 3, Trim(GRID0.GetGridCell(ii, 15))   '이체번호
		GRID0.SetGridCell ii, 4, Trim(GRID0.GetGridCell(ii, 16))   '거래명
		GRID0.SetGridCell ii, 5, Trim(GRID0.GetGridCell(ii, 21))   '입금은행계좌
		GRID0.SetGridCell ii, 6, Trim(GRID0.GetGridCell(ii, 22))   '은행계좌명

		' 통화
		tong = Trim(GRID0.GetGridCell(ii, 41))
		If Trim(tong) = "" Then
			tong = "KRW"
		End If
		GRID0.SetGridCell ii, 7, Trim(tong)   '통화

		' 통화별 이체금액 Setting
		Select Case Trim(tong)
		Case "KRW"	' 원화
			GRID0.SetGridCell ii, 9, GRID0.GetGridText(ii, 23)   '거래금액
		Case Else
			curr = Replace(Trim(GRID0.GetGridText(ii, 42)), "+", "")
			GRID0.SetGridCell ii, 8, Trim(curr)   '거래금액
		End Select

		GRID0.SetGridCell ii, 10, GRID0.GetGridCell(ii, 24)   '수수료
		GRID0.SetGridCell ii, 11, GRID0.GetGridCell(ii, 28)   '이체상태
		GRID0.SetGridCell ii, 12, GRID0.GetGridCell(ii, 29)   '불능사유

	Next
End If

