RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub DoReceive()
	Dim ii, items, items2, accnCell, accnText, acnm, accnGubn, items3
	items = ""
	items2 = ""
	items3 = ""

	For ii = 1 To GRID0.Rows
		accnCell = Trim(GRID0.GetGridCell(ii, 9))
		accnText = Trim(GRID0.GetGridText(ii, 9))
		acnm     = Trim(GRID0.GetGridCell(ii,10))
		accnGubn = ""

		If Trim(accnCell) = "" Then
			Exit For
		End If



		If (CLng(Left(accnCell, 3)) < 551 Or CLng(Left(accncell, 3)) > 558) And  CLng(Left(accncell, 3)) <> 561 Then	'551~555(은행예수금계좌) 제외 556추가	'160119 557계좌 추가 '190103 561계좌추가
																														'201006 558계좌 추가(은행예수금계좌, IBK주거래생활금융통장)

			If CLng(Mid(accnCell, 4, 2)) <> 55 Then ' 신연금계좌 제외

				If Trim(items) = "" Then
					items  = accnCell
				End If

				If Trim(GRID0.GetGridCell(ii, 11)) = "1" And Trim(GRID0.GetGridCell(ii, 12)) = "동일인" Then
					Select Case Mid(Trim(accnCell), 4, 2)
						Case "10" : accnGubn = "위탁    "
						Case "11" : accnGubn = "ELW전용 "
						Case "12" : accnGubn = "코넥스  "
						Case "20" : accnGubn = "선물옵션"
						Case "21" : accnGubn = "옵션전용"
						Case "30" : accnGubn = "일반저축"
						Case "51" : accnGubn = "CMA전용 "
						Case "52" : accnGubn = "RP전용  "
						Case "53" : accnGubn = "수익증권"
						'Case "55" : accnGubn = "신연금  "
						Case "70" : accnGUbn = "신탁    "
						Case Else : accnGubn = "        "
					End Select

					If Left(accnText, 3) <> "571" Then
						If Mid(accnText, 5, 2) = "10" And Len(accnCell) = 11 Then
							items  = items  & vbTab & accnCell & accnText & "   " & accnGubn & "   " & acnm
							items2 = items2 & vbTab & acnm
 							items3 = items3 & accnCell & vbTab & Trim(GRID0.GetGridCell(ii, 7)) & vbLf   '계좌번호 지점번호
'							SYSTEM.Trace "items " & items
						End If
					End If
				End If
			End If
		End If
	Next



	SYSTEM.Push "IB594001_AccList", items
	SYSTEM.Push "IB594001_AccNameList", items2

	SCREEN.Object("main.OBJ1.CMB_ACCT").SetItems(items)
	SCREEN.Object("main.OBJ1.CMB_ACNM").SetItems(items2)
	'SCREEN.Object("main.OBJPOP.CMB_ACCT").SetItems(items) 팝업띄우기

	SCREEN.Proc "main.OBJ1.acct_set", ""  '--계좌번호, 계좌명 세팅
	SCREEN.Proc "main.OBJ1.SetAcntData", items3

	If SCREEN.Object("main.UTAB0").ID <> "3" Then
		SCREEN.Object("main.OBJ1.zPwd").Setfocus
	End If

'UTAB0
	If SCREEN.Object("main.UTAB0").ID = "2" Then
		SCREEN.Object("main.OBJ1.COMBO1").SetItems(items)
	End If
End Sub

_AW_ONSEND_AW_
LEDGER.Rcnt = "0025"

zElecfnUserId.Data = LEDGER.Usid

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(LEDGER.Next) = "Y" Then
	send_c()
Else
	GRID0.Sort 9, True, True
	Call DoReceive()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(Out)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



