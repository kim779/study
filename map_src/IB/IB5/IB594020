Function checkTotalAccn()
	checkTotalAccn = False

	Dim tmpAccn, tmpMidAccn

	If F1.Checked = True Then
		tmpAccn = Trim(CMB_ACCT2.Text)
	ElseIf F2.Checked = True Then
		tmpAccn = Trim(EDIT_ACCT.Text)
	End If

	If tmpAccn = "" Then
		alert_msg("이체계좌번호를 확인하여 주십시오.")

		If F1.Checked = True Then
			CMB_ACCT2.SetFocus
		ElseIf F2.Checked = True Then
			EDIT_ACCT.SetFocus
		End If

		Exit Function
	End If

	Dim tmpMsg

	If Trim(Mid(tmpAccn, 5, 2)) = "00" Then
		tmpMsg = "종합계좌번호(ex.001-00-123456)는 이체가 불가합니다." & vbLf & vbLf &_
		         "개별계좌번호(ex.001-10-123456)를 입력하여 주십시오."

		Call alert_msg(tmpMsg)

		If F1.Checked = True Then
			CMB_ACCT2.SetFocus
		ElseIf F2.Checked = True Then
			EDIT_ACCT.SetFocus
		End If

		Exit Function
	End If

	If CLng(Left(Trim(tmpAccn), 3)) >= 551 And CLng(Left(Trim(tmpAccn), 3)) <= 561 Then	'2016.01.19 557계좌 추가 '20190103 561계좌 추가 '201006 558계좌 추가(은행예수금계좌, IBK주거래생활금융통장)
		tmpMsg = "IBK주식투자통장으로는 이체가 불가합니다."

		Call alert_msg(tmpMsg)

		If F1.Checked = True Then
			CMB_ACCT2.SetFocus
		ElseIf F2.Checked = True Then
			EDIT_ACCT.SetFocus
		End If

		Exit Function
	End If

	checkTotalAccn = True
End Function

'********************************************************
' 입력값이 숫자인지를 확인
'********************************************************
Function checkInptVal(inpt)
	checkInptVal = False

	Dim num
	num = Trim(inpt)

	If num = "" Then
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Exit Function
	End If

	If CDbl(num) <= 0 Then
		Exit Function
	End If

	Dim ii, char

	For ii = 1 To Len(num)
		char = Mid(num, ii, 1)

		If AscW(char) < 48 Or AscW(char) > 57 Then
			Exit Function
		End If
	Next

	checkInptVal = True
End Function

