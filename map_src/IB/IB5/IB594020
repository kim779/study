Function GetTransferValue(svalue, idisit)
	GetTransferValue = 0
SYSTEM.Trace "svalue = " & svalue
	If InStr(1, svalue, ".", 1) = 0 Then
		tmps = String((CDbl(idisit) - 5) - Len(CDbl(svalue)) - 1 , "0") & CDbl(svalue)
		GetTransferValue = "+" & tmps & ".0000"
SYSTEM.Trace "GetTransferValue = " & "+" & tmps & ".0000"
		Exit Function
	End If

	Dim ipos
	ipos = Len(svalue) - InStr(1, svalue, ".", 1) + 1
	stmp = Mid(svalue, InStr(1, svalue, ".", 1) + 1, ipos)   '입력받은 숫자에서 소수점자리값만 추줄
	stmp = Trim(stmp & String(4 - Len(stmp), "0"))             '추출한 소수점자리값에 0을 붙여서 4자리 만듬
SYSTEM.Trace "stmp = " & stmp
	tmps = Trim(Left(svalue, InStr(1, svalue, ".", 1) - 1))
SYSTEM.Trace "tmps = " & tmps
	tmps = String((CDbl(idisit) - 5) - Len(tmps) - 1 , "0") & tmps
	GetTransferValue = "+" & tmps & "." & stmp
End Function

