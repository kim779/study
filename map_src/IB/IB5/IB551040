RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Public Today
Today = getCurrDay()

'== 첫 조회
Sub send_f()
	VIEWGRID.Clear
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	VIEWGRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB999938
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SCREEN.IgnoreChange True
ed_Dt_skip.Data = Today
ed_Dt.Data = Today
SCREEN.IgnoreChange False
send_f()
l_initimax("ctrl_code")

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend =  False

LEDGER.Rcnt = "0019"

SYSTEM.Trace Trim(ed_pswd.Data)


If SYSTEM.ConnectBy = "0" Then
	   ed_pswd.Data = "9999"
Else
	If Len(Trim(ed_pswd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 입력하십시오."
		Exit Sub
	End If

	If SYSTEM.UserPass <> Trim(ed_pswd.Data) Then
		If  Len(Trim(ed_pswd.Data)) >= 4 Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(ed_pswd.Data))
			ed_pswd.Data = "HEAD"
		End If

		If Trim(ed_pswd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				GUIDE.Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요.."
				ed_pswd.Data = ""
				ed_pswd.SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If

pass = Trim(ed_pswd.Data)					'비밀번호

If Len(Trim(pass)) < 4 Then
	GUIDE.Text = "비밀번호를 확인하여 주십시오."
	ed_pswd.SetFocus
	Exit Sub
End If


'ed_mkgubn.Data = cbo_mkgubn.Data	'시장구분 0전체 1홍콩 2중국 3미국
ed_Dt.Data = ed_Dt_skip.Data        '조회일자
ed_mkcode.Data = cbo_TrdGubn.Data   '주문시장코드 10:lek  20:초상증권
ed_Sgubn.Data = "1"    				'조회구분 1:당일 2:일별

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod, stmp
Dim i, j
ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = "0" Then
	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		For ii = 1 To VIEWGRID.Rows
			stmp = Trim(VIEWGRID.GetGridCell(ii, 4))
			VIEWGRID.SetGridCell ii, 4, VIEWGRID.GetGridCell(ii, 3)
			VIEWGRID.SetGridCell ii, 3, stmp

			stmp = Trim(VIEWGRID.GetGridCell(ii, 5))
			VIEWGRID.SetGridCell ii, 6, Trim(stmp)

