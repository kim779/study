	SCREEN.OnSend = False
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'공지사항 연계
Dim str, codx, chk_7val, chk_8val
If Trim(SCREEN.Object("main.chk_8777").data) <> "" Then
'6 ddr256
'21 sdram

	chk_7val = CLng(Trim(SCREEN.Object("main.chk_8777").data))
	Select Case chk_7val
		Case 1
			chk_8val = 6
		Case 2
			chk_8val = 22
		Case Else
			chk_8val = 1
	End Select

	str = GRID0.GetGridCell(chk_8val, 2)
	codx = GRID0.GetGridCell(chk_8val, 1)
	GRID0.SetFocus
	GRID0.Index = chk_8val -1
Else
	str = GRID0.GetGridCell(1, 2)
	codx = GRID0.GetGridCell(1, 1)
End If

str = Trim(str)
cox = Trim(codx)
If str = "" Or codx = "" Then
	Exit Sub
End If

SCREEN.Object ("main.symb").text = codx
SCREEN.Object ("main.jnam").text = str
SCREEN.Object ("main.obj30").send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim str, codx
If GRID0.HitPos <> 3 Then
	Exit Sub
End If
str = GRID0.GetGridCell(GRID0.Row, 2)
codx = GRID0.GetGridCell(GRID0.Row, 1)
str = Trim(str)
cox = Trim(codx)
If str = "" Or codx = "" Then
	Exit Sub
End If

SCREEN.Object ("main.select").data = 1
SCREEN.Object ("main.symb").text = codx
SCREEN.Object ("main.jnam").text = str
SCREEN.Object ("main.obj30").send
