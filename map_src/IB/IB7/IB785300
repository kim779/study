_AW_ONDECLARE_AW_
Sub Order_maintab()
	select Case Main_Tab.ID
		Case 0
				gubn.Data = "0"
				SCREEN.SetCaption "IB785300"&vbTab&"[7853] 반도체 현물가격"
		Case 1
				gubn.Data = "1"
				SCREEN.SetCaption "IB785400"&vbTab&"[7854] 반도체 장기공급가격"
	End select
End Sub

_AW_ONSTART_AW_
gubn.Data = "0"
SCREEN.Object("MAIN.OBJ10").Send

_AW_ONENDSUB_AW_
_AW_ONSELECT_AW_
Select Case data
	Case "7853"	'현물가격
		Main_Tab.ID = 0
	Case "7854"	'장기공급가격
		Main_Tab.ID = 1
	Case Else
		Exit Sub
End Select

Order_maintab()
'SCREEN.Send 2

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(gubn_tab)
_AW_ONCLICK_AW_
select Case gubn_tab.Index
	Case 0
		OBJ20.SetObject "IB785320"
	Case 1
		OBJ20.SetObject "IB785321"
	Case Else
		Exit Sub
End select

OBJ20.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(Main_Tab)
_AW_ONCLICK_AW_
Order_maintab()

select Case Main_Tab.Index
	Case 0
		gubn.Data = "0"
	Case 1
		gubn.Data = "1"
	Case Else
		Exit Sub
End select


OBJ10.Send
