_AW_ONDECLARE_AW_
Dim ichk
Function chk_jisu(str_jisu)

	For ichk = 1 To GRID.Rows
		If Trim(str_jisu) = Trim(GRID.GetGridCell(ichk, 1)) Then
			chk_jisu = ichk
			Exit For
		End If
	Next
End Function

_AW_ONRECEIVE_AW_
'공지사항과 연계로 수정
Dim str, codx, chk_7val, chk_8val
If Trim(SCREEN.Object("main.chk_8777").data) <> "" Then
	chk_7val = CLng(Trim(SCREEN.Object("main.chk_8777").data))
	Select Case chk_7val
		Case 1'다우
			chk_8val = chk_jisu(".DJI")
			'chk_8val = 1
		Case 2'S&P500
			chk_8val = chk_jisu("SPX")
			'chk_8val = 3
		Case 3'나스닥
			chk_8val = chk_jisu("COMP")
			'chk_8val = 2
		Case 4'니케이
			chk_8val = chk_jisu("JP#NI225")
			'chk_8val = 15
		Case 5'항셍
			chk_8val = chk_jisu("HK#HS")
			'chk_8val = 16
		Case Else
			chk_8val = 1
	End Select
	str = GRID.GetGridCell(chk_8val, 2)
	codx = GRID.GetGridCell(chk_8val, 1)
	str = Trim(str)
	cox = Trim(codx)
	GRID.Index =chk_8val
'	GRID.SetFocus
Else
	str = GRID.GetGridCell(1, 2)
	codx = GRID.GetGridCell(1, 1)
	str = Trim(str)
	cox = Trim(codx)
End If
If str = "" Or codx = "" Then
	Exit Sub
End If

JNAM.Text = str
SCREEN.Object ("main.symb").text = codx
SCREEN.Object ("main.jnam").text = str
SCREEN.Object ("main.jnam30").text = str
SCREEN.Object ("main.obj20").send
SCREEN.Object ("main.obj30").send
SCREEN.Object ("main.obj40").send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID)
_AW_ONCLICK_AW_
Dim str, codx
If GRID.HitPos <> 3 Then
	Exit Sub
End If
SCREEN.Object("main.chk_8777").clear
str = GRID.GetGridCell(GRID.Row, 2)
codx = GRID.GetGridCell(GRID.Row, 1)
str = Trim(str)
cox = Trim(codx)
If str = "" Or codx = "" Then
	Exit Sub
End If

JNAM.Text = str
SCREEN.Object ("main.symb").text = codx
SCREEN.Object ("main.jnam").text = str
SCREEN.Object ("main.jnam30").text = str
