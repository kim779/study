Dim retn

Select Case gubn.Data
	Case "s"
		retn = SCREEN.GetCode(100, "scod", "name", 0 )
		If retn <> True Then
       		Exit Sub
		End If

	Case "u"
		retn = SCREEN.GetCode(104, "ucod", "name", 99 )
		If retn <> True Then
		       Exit Sub
		End If

	Case "f", "o"
		retn = SCREEN.GetCode(103, "fcod", "name", 2 )
		If retn <> True Then
