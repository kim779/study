_AW_ONDECLARE_AW_
Sub clear()
	scod.Data = ""
	ucod.Data = ""
	fcod.Data = ""
	scod.visible True
	ucod.Visible = False
	fcod.Visible = False
	BUTTON1.TRgb = 94
	BUTTON2.TRgb = 130
	BUTTON3.TRgb = 130
	gubn.Data = "s"
	name.Clear
End Sub

Sub Setting(cod)
'	SYSTEM.Trace cod & " " & SCREEN.GetCodeType(cod)
	Select Case SCREEN.GetCodeType(cod)
		Case 11, 12, 13
			scod.Visible = False
			ucod.Visible = False

			fcod.Visible = True

			fcod.Data = cod
			Select Case Mid(fcod.Data, 1, 1)
				Case "1", "4", "A", "D" :											' 선물
					name.Data = SCREEN.GetName(101, fcod.Data, 0)
					gubn.Data = "f"
				Case "2", "3", "B", "C" :											' 콜, 풋
					name.Data = SCREEN.GetName(102, fcod.Data, 0)
					gubn.Data = "o"
			End Select

			BUTTON1.TRgb = 130
			BUTTON2.TRgb = 130
			BUTTON3.TRgb = 94
		Case 1, 2, 3, 9, 6
			scod.Visible = True
			ucod.Visible = False
			fcod.Visible = False

			scod.Data = cod
			name.Data = SCREEN.GetName(100, scod.Data, 0)
			BUTTON1.TRgb = 94
			BUTTON2.TRgb = 130
			BUTTON3.TRgb = 130
			gubn.Data = "s"
		Case Else
			scod.Visible = False
			ucod.Visible = True
			fcod.Visible = False

			ucod.Data = cod
			name.Data = SCREEN.GetName(104, ucod.Data, 99)
			BUTTON1.TRgb = 130
			BUTTON2.TRgb = 94
			BUTTON3.TRgb = 130
			gubn.Data = "u"
	End Select
End Sub

_AW_ONSTART_AW_
Call clear()

_AW_ONENDSUB_AW_
