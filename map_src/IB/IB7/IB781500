Dim codx

codx = symb.Data
codx = Trim(codx)

If codx = "" Then
	symb.Data = "CME$SP"
	codx = "CME$SP"
End If

Select Case codx
	Case "CME$SP"
		hnam.Data = "S&P500선물"
	Case "CME$ES"
		hnam.Data = "e-mini S&P500"
	Case "CME$ND"
		hnam.Data = "NASDAQ100 선물"
	Case "CME$NQ"
