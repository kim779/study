	Case "HSI@HSCI"
		hnam.Data = "항셍종합지수"
	Case "SHS@000002"
		hnam.Data = "상해 A-Share"
	Case "USDKRWSMBS"
		hnam.Data = "원/달러"
End Select

If Len(codx) <= 0 Then
	SCREEN.OnSend = False
	Else
	OBJ01.send
End If

