	obj0.ClearAll 2
	obj1.ClearAll 2
	zAcntNo.Clear			'매수계좌번호
	zIvstfndCode.Clear		'매수펀드
	lBuyOrdAmt.Clear		'매수신청금액

	SCREEN.Object("obj0.ms_tran").data = "00"	'매수유형
