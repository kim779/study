Function Setdata(data,Len1,Len2)
	Dim i,SLen,Sdata,ELen,Edata,fulldata
	data = Replace(data,",","")
	fulldata = Split(data, ".", -1,1)
	For i = LBound(fulldata) To UBound(fulldata)
	Next
	If i = 1 Then
		Sdata = fulldata(0)
		SLen = Len(fulldata(0))
		SLen = Len1 - SLen
		For i=1 To SLen
			Sdata = "0"&Sdata
		Next
		Edata = ""
		For i=1 To Len2
			Edata = Edata&"0"
		Next
		Setdata=Sdata&"."&Edata
	ElseIf i = 2 Then
		Sdata = fulldata(0)
		SLen = Len(Trim(fulldata(0)))
		SLen = Len1 - SLen
		For i=1 To SLen
			Sdata = "0"&Sdata
		Next
		Edata = fulldata(1)
		ELen = Len(fulldata(1))
		ELen = Len2 - ELen
		For i=1 To ELen
			Edata = Edata&"0"
		Next
		Setdata=Sdata&"."&Edata
	Else
		Sdata = ""
		Edata = ""
		For i=1 To Len1
			Sdata = Sdata&"0"
		Next
		For i=1 To Len2
			Edata = Edata&"0"
		Next
		Setdata=Sdata&"."&Edata
	End If
End Function

Function Error_check()

	Const scr_name = "장외채권 가상투자"
	Error_check = False

	If CDbl(Buydanga.Data) = 0 Then
		MsgBox "매매단가를 입력하세요", , scr_name
		Buydanga.SetFocus
		Exit Function
	End If

	If CHECK0.Checked = True Then
		If CDbl(BnsQty_.Data) = 0 Then
			MsgBox "매매수량을 입력하세요", , scr_name
			BnsQty_.SetFocus
			Exit Function
		End If
	Else
		If CDbl(BuyAmt_.Data) = 0 Then
			MsgBox "매수금액을 입력하세요", , scr_name
			BuyAmt_.SetFocus
			Exit Function
		End If
	End If

	If Trim(Replace(BuyDt_.Data,"-","")) >= Trim(Replace(SellDt_.Data,"-","")) Then
		MsgBox "매수일이 만기일(" & SellDt_.Data & ")을 경과하였습니다. 매수일을 확인하세요.", , scr_name
		Exit Function
	End If

	Error_check = True

End Function

