			row10 =  row10 + CDbl(GRID0.GetGridCell(i,10))
		End If

		GRID0.SetGridCell i, 12, sumrow12

		If GRID0.GetGridCell(i,12) <> "" And IsNumeric(GRID0.GetGridCell(i,12)) <> False Then
			row12 =  row12 + CDbl(GRID0.GetGridCell(i,12))
		End If

	Next

	If  GRID0.Rows > 0 Then
		GRID0.InsertRow GRID0.Rows+1

		GRID0.SetGridCell GRID0.Rows, 3, "합계"
