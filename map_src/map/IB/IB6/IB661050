			row6 =  row6 + CDbl(GRID0.GetGridCell(i,6))
			sumrow12 = sumrow12 + CDbl(GRID0.GetGridCell(i,6))
		End If

		If GRID0.GetGridCell(i,7) <> "" And IsNumeric(GRID0.GetGridCell(i,7)) <> False Then
			row7 =  row7 + CDbl(GRID0.GetGridCell(i,7))
			sumrow12 = sumrow12 + CDbl(GRID0.GetGridCell(i,7))
