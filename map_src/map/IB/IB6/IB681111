Sub OnAlert()
	Dim md, ms, mdsum, mssum
	mdsum = 0
	mssum = 0

	For ii = 1 To 5
		 md = Trim(MDTABLE.GetTableCell(ii))
		 If md <> "" Then
		 	mdsum = mdsum + md
		 End If

		 ms = Trim(MSTABLE.GetTableCell(ii))
		 If ms <> "" Then
		 	mssum = mssum + ms
		 End If
	Next

	TABLE11.SetTableCell 1, mdsum
	TABLE13.SetTableCell 1, mssum
End Sub

