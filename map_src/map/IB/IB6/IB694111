RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim pos, grid, rowPos
Set grid = SCREEN.Object("parent.viewGrid")

Sub send_f(gridPos)
	SCREEN.ClearAll 0, 2
	pos = gridPos

	If SCREEN.GetMapName(1) = "IB694100" Then
		rowPos = 2
	ElseIf SCREEN.GetMapName(1) = "IB150400" Then
		rowPos = 6
	End If

	S1301.Data = Trim(grid.GetGridCell(pos, rowPos))
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1777.Data =  "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "≈Î«’" Then
		S1777.Data =  "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
grid.SetGridCell pos, rowPos, Trim(S1301.Data)

If CLng(pos) < CLng(grid.Rows) Then
	Call send_f(pos + 1)
End If

_AW_ONENDSUB_AW_
}



