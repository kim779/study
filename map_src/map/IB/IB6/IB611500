	Call alert_msg("펀드계좌번호(ex.001-53-123456)를 확인하여 주십시오.")
	AN50.SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(zPwd.Data)) < 4 Then
		Call alert_msg("비밀번호를 확인하여 주십시오..")
		zPwd.SetFocus
		Exit Sub
	End If
End If

Dim msg, getDataArr

SYSTEM.Push "fundo", ""
SCREEN.CreateWindow 2, "IB610610  /t /s /p?/d" , "EDIT0" & vbTab & Trim(AN50.Data)

msg = Trim(SYSTEM.Pop("fundo"))
If msg = "NO" Then
	SYSTEM.Push "fundo", ""
	Exit Sub
End If

SYSTEM.Push "fundo", ""

getDataArr = Split(msg, "|")
If UBound(getDataArr) < 2 Then Exit Sub

subAN50.Data = Trim(getDataArr(0))
zIvstfndCode.Data = Trim(getDataArr(1))
FundName.Text = Trim(getDataArr(2))

If Len(Trim(zIndivisualPwd.Data)) < 4 Then
	zIndivisualPwd.SetFocus
Else
	send_btn.SetFocus
End If
