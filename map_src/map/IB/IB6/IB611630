Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub search_word()
	Dim ii, jj,search, sect, fundnm, cod, fcod, dt, comp

	jj = 1
	GRID1.Clear

	If Trim(gubn.data) = "0" Then
		EDIT1.Data = Trim(fundname.Data)
		sect = 5
		If EDIT1.Data = "" Then
			sect = 1
		End If
	ElseIf Trim(gubn.data) = "1" Then
		EDIT1.Data = "KRZ"&Trim(EDIT0.Data)
		sect = 4
		If Trim(EDIT1.Data) = "KRZ" Then
			sect = 1
		End If
	End If
'SYSTEM.Trace sect
	search = Trim(EDIT1.Data)
	For ii=1 To GRID0.Rows
		cod = Trim(GRID0.GetGridCell(ii, 3))
