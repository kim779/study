'펀드 검색
Sub Find_fund()
	Dim ii, pos, sect
	pos = 0

	If Trim(gubn.data) = "0" Then
		EDIT1.Data = Trim(fundname.Data)
		sect = 3
		If EDIT1.Data = "" Then
			sect = 1
		End If
	ElseIf Trim(gubn.data) = "1" Then
		EDIT1.Data = "KRZ"&Trim(EDIT0.Data)
		sect = 2
		If Trim(EDIT1.Data) = "KRZ" Then
			sect = 1
		End If
	End If

	If sect <> 1 Then
		For ii = GRID1.rows To 1 Step -1
			pos = InStr(Trim(GRID1.GetGridCell(ii, sect)), Trim(EDIT1.data))
			If pos = 0 Then
				GRID1.RemoveRow ii-1
			End If
		Next
	End If
End Sub

