_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub fndOrderList()
	Dim OrdNo, ii, grdOrdNo, availAmt, prc, mmgb, flag
	OrdNo = Trim(SCREEN.Object("parent.ed_ogno").Data)
	availAmt = ""
	flag = "N"

	For ii = 1 To GRID.Rows
		grdOrdNo = Trim(GRID.GetGridCell(ii, 5))

		If Trim(OrdNo) = Trim(grdOrdNo) Then
			flag = "Y"
			mmgb = Trim(GRID.GetGridCell(ii, 10))
			availAmt = Trim(GRID.GetGridCell(ii, 20))
			Exit For
		End If
	Next

	If flag = "Y" Then
		If Trim(mmgb) = "매수" Then
			If IsNumeric(availAmt) = True Then
				SCREEN.Proc "parent.modifyChaeProc", availAmt
			End If
		Else
			SCREEN.Proc "parent.send_o", ""
		End If
	Else
		MsgBox "주문번호를 확인하여 주십시오.", , "IBK투자증권"
		SCREEN.Object("parent.ed_ogno").SetFocus
		Exit Sub
	End If
End Sub

