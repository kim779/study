	SCREEN.Object("main.AN1A").SetFocus
	Exit Sub
End If

Dim sPass
sPass = Trim(SCREEN.Object("main.ed_pswd").Data)

PASS.Data = sPass

If CLng(SYSTEM.ConnectBy) = 0 Then
	If sPass = "" Then
		sPass = "9999"
	End If
End If

If Len(Trim(PASS.Data)) < 4 And Len(Trim(PASS.Data)) > 8 Then
	SCREEN.Object("main.ed_pswd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

