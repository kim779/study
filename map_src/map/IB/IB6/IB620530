RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt = "0001"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

If CheckInput(SCREEN.Object("parent.AN12"), SCREEN.Object("parent.zPwd")) = True Then
	AcntNo.Data = SCREEN.Object("parent.AN12").Data
	zPwd.data = SCREEN.Object("parent.zPwd").Data
	RpBnsTp.data = SCREEN.Object("parent.zRpBnsTp").Data
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(LEDGER.Ecod) = "3669" Then
	SCREEN.ClearAll 2, 2
	SCREEN.Object("parent.zPwd").Clear
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim ii, dat, prc
	For ii=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(ii, 6)) <> "" Then
			dat = Trim(GRID0.GetGridCell(ii, 6)) * 100
			GRID0.SetGridCell ii, 6, FormatNumber(dat, 2, 0, 0)
		End If

		If Trim(GRID0.GetGridCell(ii, 5)) <> "" Then
			prc = Trim(GRID0.GetGridCell(ii, 5))
			GRID0.SetGridCell ii, 5, FormatNumber(prc, 2, 0, 0)
		End If
	Next


	SCREEN.Object("parent.GUIDE").Text = Trim(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
'	aa.SetFocus

	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


