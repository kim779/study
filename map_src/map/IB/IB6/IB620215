	'3. 현재 투자목적을 고려한 투자예정기간
	For i = 1 To 5
		If Eval("RADIO4_" & i).Checked = True Then
			Quest4.Data = i
			Chk4 = 1
		End If
	Next
	Dim msg
	If Chk1 = 1 And Chk1 = 1 And Chk2 = 1 And Chk3 = 1 And Chk4 = 1 Then
		SCREEN.SetTimerX 1, 100, False
	Else
		msg = "입력되지 않은 항목이 있습니다." & vbLf  & "답변사항을 확인하여 주세요."
		Call alert_msg(msg)

		For i = 1 To 4
			If Eval("Chk" & i) <> 1 Then
				Eval("BOX" & i).Visible = True
			End If
		Next
	End If
End Sub

Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function

