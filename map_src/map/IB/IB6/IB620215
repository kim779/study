Sub SetCheck()
	Dim Chk1,Chk2,Chk3,Chk4
	Chk1 = 0
	Chk2 = 0
	Chk3 = 0
	Chk4 = 0
	'1.현재 투자목적
	For i = 1 To 5
		If Eval("RADIO1_" & i).Checked = True Then
			Quest1.Data = i
			Chk1 = 1
		End If
	Next

	'2.현재 투자목적을 고려한 손실 감내 수준
	'2-1 원금보존태도
	For i = 1 To 2
		If Eval("RADIO2_" & i).Checked = True Then
			Quest2.Data = i
			Chk2 = 1
		End If
	Next

	'2-2 손실 감내 수준
	'2_2 CHECK 경우
	If RADIO2_2.Checked = True Then
		For i = 1 To 5
			If Eval("RADIO3_" & i).Checked = True Then
				Quest3.Data = i
				Chk3 = 1
			End If
		Next
	Else
		Quest3.Data = ""
		Chk3 = 1
		For i = 1 To 5
			Eval("RADIO3_" & i).Enable = False
			Eval("RADIO3_" & i).Checked = False
		Next
