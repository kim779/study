Sub Set_account()
	SCREEN.ClearAll 0, 2
	ed_accn.Data = SCREEN.Object("main.AN1A").data
	zPwd.Data = SCREEN.Object("main.AN1A").Password

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	Else
		zPwd.Data = "9999"
	End If

	Call send_f()
End Sub

