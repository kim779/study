'***************************************************************************
Sub Set_account()
	SCREEN.Object("obj_jumn.ed_accn").Data = AN1A.data
	SCREEN.Object("obj_account.ed_accn").Data = AN1A.data
	'obj_account.ClearAll 2
	SCREEN.Proc "obj_account.send_f", ""

	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password

End Sub

'***************************************************************************
' DESC: 화면별 탭 클릭
'***************************************************************************

Sub tab1_change()
	Select Case tab_sise.ID
		Case "1" : sise_list.SetObject("IB661010")

	End Select
End Sub

Sub tab2_change()
	Select Case tab_account.ID
	Case 1 :
		obj_account.SetObject("IB661030")
		b_next.Visible = True
	End Select
	SCREEN.Proc "obj_account.send_f", ""
End Sub

Sub tab3_change()
	Select Case tab_order.ID
		Case "1" : obj_jumn.SetObject("IB661040")
	End Select
End Sub


'***************************************************************************
' DESC: 투자정보확인
'***************************************************************************

Sub complete_cusstatus()

	Dim check_char,tujaNM

	If Trim(SCREEN.Object("obj_cusstatus.OUTPUT7").Data)  = "0" Or Trim(SCREEN.Object("obj_cusstatus.chkGrdNm").Data)  = "N" Then
		'0불원, 1제공 , chkGrdNm 없으면..
		SCREEN.CreateWindow 1, "IB820982 /t/s/p5", ""
		check_char = "00"
	Else
		If Trim(SCREEN.Object("obj_cusstatus.OUTPUT6").Data)  = "0" Then '전문 투자자
			check_char = "40" '전문투자자는 최고위험이하 상품표시
		Else
			tujaNM = Trim(SCREEN.Object("obj_cusstatus.zGrdNm").Data)

			If tujaNM = "안정형" Then
				check_char = "00" '초저위험
			ElseIf tujaNM = "안정추구형" Then
				check_char = "10" '저위험
			ElseIf tujaNM = "위험중립형" Then
				check_char = "20" '중위험
			ElseIf tujaNM = "적극투자형" Then
				check_char = "30" '고위험
			ElseIf tujaNM = "공격투자형" Then
				check_char = "40" '초고위험
			Else
				check_char = "00"
			End If
		End If
	End If

	SCREEN.Object("sise_list.EDIT4").data = check_char
	COMBO1.data = check_char
	SCREEN.Proc "sise_list.send_f", ""
End Sub

