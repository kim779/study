RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_sise_all(xval)
SCREEN.IgnoreChange True
	S1301.Trigger "", True

	If xval <> "jumun" Then
		Call Ord_ChangeCode(S1301.Data)
	End If
	OBJ_sise.Send
SCREEN.IgnoreChange False
End Sub

Sub all_account()
	OBJ_account.Send
End Sub

_AW_ONINDECLARE_AW_
#Load IB999913

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
If tab_account.id = 3 Then
	btn_send.Visible = True
Else
	btn_send.Visible = False
End If

Call send_sise_all("main")

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If Len(Trim(S1301.Data)) <> 6 Then
	SCREEN.OnSend False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(tab_account)
_AW_ONCLICK_AW_
Select Case tab_account.ID
Case 1 : OBJ_account.SetObject("IB690130")
		 btn_send.Visible = False
Case 2 : OBJ_account.SetObject("IB690131")
		 btn_send.Visible = False
Case 3 : OBJ_account.SetObject("IB690132")
		 btn_send.Visible = True
Case 4 : OBJ_account.SetObject("IB690133")
		 btn_send.Visible = False
End Select

OBJ_account.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
Dim Myvar, name

name = SCREEN.GetName(100, S1301.data, 0)
If (name <> "") Then
	Call send_sise_all("main")
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn_send)
_AW_ONCLICK_AW_
OBJ_account.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


