_AW_ONDECLARE_AW_
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN35.Name
	zpwd.Data = AN35.Password
	If Trim(AN35.Data) = "" Then
		AN35.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If
End Sub

Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

Sub send_o()
	SCREEN.ClearAll 0, 2

	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub DoOrder()
	SYSTEM.Push "rp_order_cancel", ""

	zAcntNo.Data = SCREEN.Object("parent.AN51").data	'이 부분 AN34 -> AN10 으로 수정함. AN51으로 다시 수정.
	zpwd.Data = SCREEN.Object("parent.zpwd").data

	If Len(Trim(zAcntNo.Data)) < 11 Then
		MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"
		SCREEN.Object("parent.AN51").SetFocus
		Exit Sub
	End If

	If Len(Trim(zpwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		SCREEN.Object("parent.zpwd").SetFocus
		Exit Sub
	End If

	If i_SettNo.Data = "000000000" Then
		MsgBox "취소할 매매내역을 선택하여 주십시오.", , "IBK투자증권"
		Exit Sub
	End If

	SYSTEM.Push "rp_order_cancel", "No"

	Dim dmsg
	dmsg = "o_juno" & vbTab & CDbl(i_SettNo.Data) & vbLf & _
		   "o_acno" & vbTab & Trim(zAcntNo.Data) & vbLf & _
		   "o_acnm" & vbTab & Trim(SCREEN.Object("main.ACNM").Data) & vbLf & _
		   "o_gubn" & vbTab & "매도" & vbLf & _
		   "o_rpgb"	& vbTab & Trim(SCREEN.Object("main.zRpBnsTp").Text) & vbLf


	SCREEN.CreateWindow 2, "IB620405 /t /p5 /d", dmsg

	If Trim(SYSTEM.Pop("rp_order_cancel")) <> "OK" Then
		Exit Sub
	End If

	If IsBnkAccnType(zAcntNo) = True Then
		SCREEN.Proc "obj_getMoney.contributionBnk", mmPrc.Data
	Else
		Call send_o()
	End If
End Sub

