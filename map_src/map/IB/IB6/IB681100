Sub send_amt()
	Dim amt1, amt2, amt3

	If IsNumeric(Trim(S1352.data)) Then
		amt1 = Trim(S1352.data)
	Else
		amt1 =0
	End If

	If IsNumeric(Trim(S2023.Data)) Then
		amt2 = Trim(S2023.Data)
	Else
		amt2 =0
	End If

	If IsNumeric(Trim(SCREEN.Object("OBJECT0.2023").Data)) Then
		amt3 = Trim(SCREEN.Object("OBJECT0.2023").Data)
	Else
		amt3 =0
	End If

	' 현재가 + 행사가 - 기초자산현재가 = 프리미엄
	rate.Data =  (Abs(CCur(amt1)) + Abs(CCur(amt2)))  -  Abs(CCur(amt3))

	If Len(Trim(S1379.Data)) = 0 Then
		rate.Data = 0
	End If

End Sub



