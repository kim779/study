Function Setdata(data,Len1,Len2)
	Dim i,SLen,Sdata,ELen,Edata,fulldata
	data = Replace(data,",","")
	fulldata = Split(data, ".", -1,1)
	For i = LBound(fulldata) To UBound(fulldata)
	Next
	If i = 1 Then
		Sdata = fulldata(0)
		SLen = Len(fulldata(0))
		SLen = Len1 - SLen
		For i=1 To SLen
			Sdata = "0"&Sdata
		Next
		Edata = ""
		For i=1 To Len2
			Edata = Edata&"0"
		Next
		Setdata=Sdata&"."&Edata
	ElseIf i = 2 Then
		Sdata = fulldata(0)
		SLen = Len(Trim(fulldata(0)))
		SLen = Len1 - SLen
		For i=1 To SLen
			Sdata = "0"&Sdata
		Next
		Edata = fulldata(1)
		ELen = Len(fulldata(1))
		ELen = Len2 - ELen
		For i=1 To ELen
			Edata = Edata&"0"
		Next
		Setdata=Sdata&"."&Edata
	Else
		Sdata = ""
		Edata = ""
		For i=1 To Len1
			Sdata = Sdata&"0"
		Next
		For i=1 To Len2
			Edata = Edata&"0"
		Next
		Setdata=Sdata&"."&Edata
	End If
End Function

