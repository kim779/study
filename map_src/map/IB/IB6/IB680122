'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Error_check = False
	If Trim(AN1A.Data) = "" Then
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus
		Call guide_msg("계좌번호를 확인하십시오")
		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Call guide_msg("비밀번호를 확인하십시오")
			Exit Function
		End If
	End If

	Error_check = True
End Function

Sub SetCustomerType()
	If SYSTEM.ConnectBy = "0" Then
		If Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If
	End If
End Sub

