RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Const topPanelLT = 0
Const topPanelRBY = 27
Const bgPanelLTX = -3
Const bgPanelLTY = 27
Const tabLTX = 6
Const tabLTY = 36
Const tabRBY = 62
Const objLTX = 6
Const objLTY = 62
Const GUIDELTX = 24
Const GUIDEImageLTX = 4
Const GUIDEImage = 14
Const GUIDEArounLTX = -2

Sub SetSystemPushData()
	Dim param
	param = Trim(SYSTEM.Pop("Domino_6112"))


	If Trim(param) <> "" Then
		Domino_6112.Data = param
		Call SetDominoData()
	Else
		Domino_6112.Data = ""
	End If

	Call SetScreen()
End Sub

Sub SetDominoData()
	Dim dataArr
	dataArr = Split(Trim(Domino_6112.Data), "|")

	zAcntNo.Data  = dataArr(0)
	ACNM.Data     = dataArr(1)
	fundCode.Data = dataArr(2)
	fundName.Data = dataArr(3)

	'Domino_6112.Data = ""
End Sub


Sub SetScreen()
	Dim objWidth, objHeight, objRBX, objRBY

	GUIDE.Text = ""
	LABEL2.Visible = False
	zPwd.Visible = False
	send_btn.Visible = True

	Select Case tab_hangmok.ID
		Case 0 : objWidth = 508 : objHeight = 302
		Case 1 : objWidth = 554 : objHeight = 155
		Case 2 : objWidth = 360 : objHeight = 508
		Case 3 : objWidth = 390 : objHeight = 305
	End Select

	objRBX = objWidth + OBJLTX
	objRBY = objHeight + OBJLTY

	SCREEN.SetSize objRBX + 6, objRBY + 7 + 24
	topPanel.SetRect topPanelLT, topPanelLT, objRBX + 6, topPanelRBY
	send_btn.SetRect objRBX - 37, 3, objRBX - 1, 23
	bgPanel.SetRect bgPanelLTX, bgPanelLTY, objRBX + 9, objRBY + 8
	tab_hangmok.SetRect tabLTX, tabLTY, objRBX, tabRBY
	obj0.SetRect objLTX, objLTY, objRBX, objRBY
	GUIDE_around.SetRect GUIDEArounLTX, objRBY + 6, objRBX + 10 - 2, objRBY + 7 + 24
	GUIDE_image.SetRect GUIDEImageLTX, objRBY + 7 + 6 - 2, GUIDEImage + GUIDEImageLTX, objRBY + 7 + 6 + GUIDEImage - 2
	GUIDE.SetRect GUIDELTX, objRBY + 7 + 4, objRBX + 6 - 40, objRBY + 7 + 4 + 16

	Select Case tab_hangmok.ID
		Case 0
				obj0.SetObject "IB498977"
				SCREEN.Object("obj0.fundcode").Data = fundCode.Data
				If Trim(fundCode.Data) <> "" Then
					SCREEN.Proc "obj0.send_f", ""
				End If
		Case 1
				obj0.SetObject "IB611210" '펀드상세
				LABEL2.Visible = True
				zPwd.Visible = True

				If SYSTEM.ConnectBy = 0 Then
					SCREEN.Proc "obj0.send_f", ""
				Else
					zPwd.Clear
					zPwd.SetFocus
				End If
		Case 2
				send_btn.Visible = False
				obj0.SetObject "IB611220" '일별기준
				SCREEN.Proc "obj0.send_f",""
		Case 3
				obj0.SetObject "IB611230" '기간수익
				SCREEN.Object("obj0.fundcode").Data = Trim(fundCode.Data)
				SCREEN.Proc "obj0.send_f",""
				SCREEN.Object("obj0.ed_name").Data = Trim(fundName.Data)
				SCREEN.Object("obj0.TABLE0").Data = Trim(fundName.Data)
	End Select
End Sub

Sub tab_change()
	Select Case tab_hangmok.ID
		Case 0
			SCREEN.SetSize 520, 373
			topPanel.SetRect 0, 0, 520, 27

			PANEL1.Visible = True
			PANEL1.SetRect 0,0, 520,334
			tab_hangmok.SetRect 5,4,518,28

			obj0.SetRect 5, 28, 516, 330
			obj0.SetObject ""
			obj0.SetObject "IB498977" '펀드개요

			SCREEN.Object("obj0.fundcode").Data = fundCode.Data
			SCREEN.Proc "obj0.send_f",""
		Case 1
			SCREEN.SetSize 561, 203

			PANEL1.SetRect 0,0, 561,35
			tab_hangmok.SetRect 3,4,557,28

			obj0.SetRect 0, 28, 561, 202
			obj0.SetObject ""
			obj0.SetObject "IB611210" '펀드상세


			SCREEN.Object("obj0.EDIT0").data = EDIT0.Data
			SCREEN.Object("obj0.zPwd").data = zPwd.Data
			obj0.send
		Case 2
			SCREEN.SetSize 347, 558

			PANEL1.SetRect 0,0, 347,40
			tab_hangmok.SetRect 3,4,344,28

			obj0.SetRect 0, 28, 348, 559
			obj0.SetObject ""
			obj0.SetObject "IB611220" '일별기준

			SCREEN.Object("obj0.fundcode").data = fundCode.DATA
			SCREEN.Object("obj0.ed_name").data = ed_name.Data
			SCREEN.Proc "obj0.send_f",""
		Case 3
			SCREEN.SetSize 399, 345

			PANEL1.SetRect 0,0, 399,40
			tab_hangmok.SetRect 3,4,397,28

			obj0.SetRect 0, 28, 400, 346
			obj0.SetObject ""
			obj0.SetObject "IB611230" '기간수익

			SCREEN.Object("obj0.fundcode").data = fundCode.DATA
			SCREEN.Object("obj0.ed_name").data = ed_name.Data
			SCREEN.Object("obj0.TABLE0").data = ed_name.Data
			SCREEN.Proc "obj0.send_f",""
	End Select
End Sub

