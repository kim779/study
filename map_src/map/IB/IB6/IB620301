RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

'==계좌번호, 비밀번호 체크
Function P_CheckInput(zAcntNo, zPwd)
 	P_CheckInput = False
	If Trim(zAcntNo.data) = "" Then
		SCREEN.Object("parent.AN51").SetFocus
		Call guide_msg("계좌번호를 확인하십시오")
  		Exit Function
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.data)) < 4 Then
			SCREEN.Object("parent.zpwd").SetFocus
			Call guide_msg("비밀번호를 확인하십시오")
	 		Exit Function
		End If
	End If
	P_CheckInput = True
End Function

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)
LEDGER.Rcnt = "0025"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("main.GUIDE").Text = ""

If CheckInput(SCREEN.Object("parent.AN51"), SCREEN.Object("parent.zpwd")) = True Then
	zAcntNo.Data = Trim(SCREEN.Object("parent.AN51").Data)
	zPwd.Data = Trim(SCREEN.Object("parent.zpwd").Data)

'	zBaseDate.Data = SCREEN.Object("parent.zOrdDt").Data

	If SCREEN.Object("parent.RADIO0").Checked = True Then
		zRpBnsTp.Data = 2
	ElseIf SCREEN.Object("parent.RADIO1").Checked = True Then
		zRpBnsTp.Data = 1
	Else
		zRpBnsTp.Data = 7
	End If

'	SYSTEM.Trace "zBaseDate.Data = " & zBaseDate.Data
'	SYSTEM.Trace "zRpBnsTp.Data = " & zRpBnsTp.Data
	SCREEN.OnSend = True
Else

End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	SCREEN.Object("parent.next_btn").Enable = True
Else
	SCREEN.Object("parent.next_btn").Enable = False
	SCREEN.Object("parent.price").SetFocus
End If

Dim ii, bef, rat, aft
For ii = gridPos To GRID0.Rows
'	SYSTEM.Trace "ii = " & ii
	rat= Trim(GRID0.GetGridCell(ii, 8))
	bef = Trim(GRID0.GetGridCell(ii, 9))
	aft = Trim(GRID0.GetGridCell(ii, 10))
	If bef = "" Or rat = "" Or aft = "" Then
		Exit Sub
	End If
	GRID0.SetGridCell ii, 8, FormatNumber(rat * 100, 2)
	GRID0.SetGridCell ii, 9, FormatNumber(bef * 100, 2)
	GRID0.SetGridCell ii, 10, FormatNumber(aft * 100, 2)
Next

gridPos = GRID0.Rows + 1

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim tmpMsDt, tmpRpDays, tmpMsPr,tmpRpPrergDt,tmppundacc
tmpMsDt = Trim(GRID0.GetGridCell(GRID0.row, 1))		'매수일
tmpRpDays = Trim(GRID0.GetGridCell(GRID0.row, 7))	'RP일수
tmpMsPr = Trim(GRID0.GetGridCell(GRID0.row, 3))		'매매금액
tmpRpPrergDt = Trim(GRID0.GetGridCell(GRID0.row, 6)) '환매예정일
tmppundacc = Trim(GRID0.GetGridCell(GRID0.row, 13)) '펀드계좌번호
If tmpMsDt = "" Or tmpRpDays = "" Then
	Exit Sub
End If

SCREEN.Object("main.zOrdDt").Data = tmpMsDt
SCREEN.Object("main.i_lRpDays").Data = tmpRpDays
SCREEN.Object("main.price").Data = tmpMsPr
SCREEN.Object("main.RpPrergDt").Data = tmpRpPrergDt
SCREEN.Object("main.FundOpAcntNo").Data = tmppundacc
