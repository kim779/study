Function l_format(str, char, sln)
	If Trim(str) = "" Then
		l_format = ""
		Exit Function
	End If
	l_format = String(sln - Len(str), char) & str
End Function


Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

