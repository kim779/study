Function l_CheckInput(ANCT, zPwd)
 	l_CheckInput = False
	If Trim(ANCT.data) = "" Or Len(Trim(ANCT.data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하십시오.")
 		ANCT.Setfocus
 		Exit Function
	End If

	If Len(Trim(zPwd.data)) < 4 Then
		Call alert_msg("비밀번호를 확인하십시오.")
		zPwd.Setfocus
		Exit Function
	End If

	If Trim(fundcode.data) = "" Or Len(Trim(fundcode.data)) <> 8 Then
		Call alert_msg("펀드코드를 확인하십시오.")
 		fundcode.Setfocus
