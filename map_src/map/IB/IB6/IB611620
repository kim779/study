	End If

	If cncl.Checked = False Then
		If (Trim(OrgMchndIttCode.data)) = "" Then
			Call alert_msg("이동대상 판매사를 확인하십시오.")
			OrgMchndIttCode.Setfocus
			Exit Function
		End If
	End If


	l_CheckInput = True
End Function

