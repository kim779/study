{


_AW_ONDECLARE_AW_
Sub Onalert()

Dim cen_val, giho,  smsu
smsu = Trim(t_smsu.GetTableCell(1))
If Len(smsu) > 0 Then
	If InStr(1, smsu, "+") > 0 Then
		giho = "+"
	ElseIf InStr(1, smsu, "-") > 0 Then
		giho = "-"
	End If
	smsu = Replace(smsu, giho, "")
	smsu = FormatCurrency(smsu)
	smsu = Mid(smsu, 2, Len(smsu)-1)
	TABLE5.SetTableCell 1, giho&smsu
End If
End Sub

_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.1301").Data
Dim scode
scode = SCREEN.object("main.scode").Data
CONTROL7.Send scode
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
