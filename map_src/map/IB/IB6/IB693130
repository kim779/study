RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
Dim cy_date, cy_d2date

Dim yy, mm, dd, cday, MyWeek

cday = DateAdd("d", -2, Date)
MyWeek = Weekday(cday)
If MyWeek = 1 Then
	cday= DateAdd("d", -2 , cday)
ElseIf MyWeek = 7 Then
	cday= DateAdd("d", -1 , cday)
End If

yy = Year(cday)
mm = Month(cday)
If Len(mm) = 1 Then mm = "0"&mm

dd = Day(cday)
If Len(dd) = 1 Then dd = "0"&dd

cday = yy&mm&dd
cy_d2date = CDbl(cday)

'날짜 컨트롤
If SCREEN.CreateObject("Info") Then
	cy_date = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "CB_IB693130"))
End If

If Trim(cy_date) = "" Then
	zAppySrtDt.Data = cy_d2date
Else
	zAppySrtDt.Data = cy_date
End If

Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim ii, str, data, Indx
	ii = 1
	For i = GRID0.Rows To 1 Step -1

		If (InStr(Trim(GRID0.GetGridCell(i, 18)), "ELS") <> 0  Or InStr(Trim(GRID0.GetGridCell(i, 18)), "DLS") <> 0  Or InStr(Trim(GRID0.GetGridCell(i, 18)), "ELB") <> 0  Or InStr(Trim(GRID0.GetGridCell(i, 18)), "DLB") <> 0 ) 	Then
			str = GRID0.GetGridCell(i, 1)
			If Left(str, 1) <> "A" Then
				GRID1.InsertRow ii

				For jj = 1 To 20
