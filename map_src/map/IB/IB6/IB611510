_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	zPwd.Clear
	subAN50.Clear
	zIvstfndCode.Clear
	FundName.Text = ""
	zIndivisualAcnm.Text = ""
	zIndivisualPwd.Clear

	obj_yjStatus.ClearAll 0


	If Len(Trim(AN50.Data)) = 11 Then
		ACNM.Text = Trim(AN50.Name)
		zPwd.Data = Trim(AN50.Password)

		Call LoadAccounts()

		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If

	Else
		AN50.SetFocus
		Exit Sub
	End If

	getHoldFundBtn.SetFocus
End Sub


Function Error_Check(param)
	Error_Check = False

	If Len(Trim(AN50.Data)) <> 11 Then
		GUIDE.Text = "계좌번호를 확인하여 주십시오."
		AN50.SetFocus
		Exit Function
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하여 주십시오."
		zPwd.SetFocus
		Exit Function
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하여 주십시오."
		zPwd.SetFocus
		Exit Function
	End If

	If Len(Trim(subAN50.Data)) < 3 Or Len(Trim(zIvstfndCode.Data)) < 8 Or Trim(FundName.Text) = "" Then
		GUIDE.Text = "펀드번호를 확인하여 주십시오."
		getHoldFundBtn.SetFocus
		Exit Function
	End If

	If Trim(param) = "inquery" Then
		Error_check = True
		Exit Function
	End If

	If Len(Trim(zIndivisualAcnt.Data)) < 11 Then
		GUIDE.Text = "위탁계좌번호를 확인하여 주십시오."
		zIndivisualAcnt.SetFocus
		Exit Function
	End If

	If Len(Trim(zIndivisualAcnt.Data)) < 11 Then
		GUIDE.Text = "위탁계좌번호를 확인하여 주십시오."
		zIndivisualAcnt.SetFocus
		Exit Function
	End If

	If Len(Trim(zIndivisualPwd.Data)) < 4 Then
		GUIDE.Text = "위탁계좌비밀번호를 확인하여 주십시오."
		zIndivisualPwd.SetFocus
		Exit Function
	End If

	Error_Check = True
End Function

Sub checkYJStatus()
	If Error_Check("inquery") = False Then
		Exit Sub
	Else
		SCREEN.Proc "obj_yjStatus.send_f", ""
	End If
End Sub

Sub LoadAccounts()
	VGRID.Clear

	Dim accList, ii, indiAcct, acct, acno, acName, acid, actp, idx
	accList = Split(CX_DTS.GetTypeData ("4","" ), vbLf, -1, vbTextCompare)
	idx = 1

	For ii = 0 To UBound(accList)
		indiAcct = Trim(accList(ii))

		If Len(Trim(indiAcct)) > 11 Then
			acct = Split(indiAcct, "|", -1, vbTextCompare)

			acno = Trim(Mid(acct(0), 1, 11))
			acName = Mid(acct(0), 12)
			acName = Trim(Replace(acName, vbTab, ""))
			acid = Trim(acct(1))
			actp = Mid(acno, 4, 2)

			If actp="10" Then
				VGRID.SetGridCell idx, 1, acno
				VGRID.SetGridCell idx, 2, acName
				VGRID.SetGridCell idx, 3, acid
				VGRID.SetGridCell idx, 4, acno
				idx = idx + 1
			End If
		End If
	Next

	Dim acnt1, acnt3, grAcnt, grAcnt1, grAcnt3, items, grAcnm
	acnt1 = Left(Trim(AN50.Data), 3)
	acnt3 = Right(Trim(AN50.Data), 6)
	items = ""

	For ii = 1 To VGRID.Rows
		grAcnt = Trim(VGRID.GetGridCell(ii, 1))

		If Trim(grAcnt) = "" Then
			Exit For
		End If

		grAcnt1 = Left(Trim(grAcnt), 3)
		grAcnt3 = Right(Trim(grAcnt), 6)

		If Trim(acnt1) = Trim(grAcnt1) And Trim(acnt3) = Trim(grAcnt3) Then
			If items = "" Then
				items = grAcnt
			End If

			items = items & vbTab & grAcnt & Trim(VGRID.GetGridText(ii, 4))
			grAcnm = Trim(VGRID.GetGridCell(ii, 2))
		End If
	Next

	zIndivisualAcnt.SetItems items
	zIndivisualAcnm.Text = grAcnm
End Sub

Sub send()
	SYSTEM.Push "fundVaccineCancel", ""

	If Error_Check("order") = False Then
		Exit Sub
	End If

	Dim dmsg
	dmsg = "acno" & vbTab & Trim(AN50.Data) & vbLf &_
	       "acnm" & vbTab & Trim(ACNM.Text) & vbLf &_
	       "fundName" & vbTab & Trim(FundName.Text) & vbLf &_
	       "oppAcno" & vbTab & Trim(zIndivisualAcnt.Data) & vbLf &_
	       "oppAcnm" & vbTab & Trim(zIndivisualAcnm.Text) & vbLf

	SYSTEM.Push "fundVaccineCancel", "Yes"

	SCREEN.CreateWindow 2, "IB611511 /t /s /p5 /d", dmsg

	If Trim(SYSTEM.Pop("fundVaccineCancel")) = "No" Then
		Exit Sub
	End If

	SCREEN.Proc "obj_snd.send_o", "cancel"
End Sub

