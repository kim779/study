Sub Set_Ptn()
	Dim Nxt, GR1
	For nxt = 1 To GRID0.Rows
		GR1 = GRID0.GetGridCell(nxt, 1)
		Select Case GR1
			Case "01"
				GRID0.SetGridCell nxt, 2, "주식형"
			Case "02"
				GRID0.SetGridCell nxt, 2, "주식혼합형"
			Case "03"
				GRID0.SetGridCell nxt, 2, "채권혼합형"
			Case "04"
