_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
	SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
	SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg
End Sub

Sub setAccUsid()
	SCREEN.ClearAll 0, 2
	SCREEN.Object("main.GUIDE").Text = ""
	If RADIO0.Checked Then
		LABEL0.Visible = False
		LABEL2.Visible = False
		LABEL3.Visible = True
		LABEL4.Visible = True
	ElseIf RADIO1.Checked Then
		LABEL3.Visible = False
		LABEL4.Visible = False
		LABEL0.Visible = True
		LABEL2.Visible = True
	End If
End Sub

Sub Setting_Sinyong()
	If chk_sPos.Checked = False Then
		VIEWGRID.SetColumnVisible 2, True
		VIEWGRID.SetColumnVisible 3, True
		VIEWGRID.SetColumnVisible 4, False
		VIEWGRID.SetColumnVisible 5, False
	Else
		VIEWGRID.SetColumnVisible 2, False
		VIEWGRID.SetColumnVisible 3, False
		VIEWGRID.SetColumnVisible 4, True
		VIEWGRID.SetColumnVisible 5, True
	End If
End Sub

