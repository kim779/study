Sub calc()

	If Len(Trim(ed_lsuNo.Data)) <> 12 Then
		Call dataClear()
		Exit Sub
	End If

	If Is_numeric(ed_BnsBndUprc.Data) = False Or ed_BnsBndUprc.Data <= 0 Then
		Call dataClear()
		Exit Sub
	End If

	If Is_numeric(ed_BnsBndErnrat.Data) = False Or ed_BnsBndErnrat.Data <= 0 Then
		Call dataClear()
		Exit Sub
	End If

	Dim acnt
	acnt = Trim(SCREEN.Object("main.AN1A").Data)

	If acnt = "" Then
		Call dataClear()
		Exit Sub
	End If

'	If Is_numeric(ed_BnsQty.Data) = False Then
'		Call dataClear()
'		Exit Sub
'	End If

	buytotal.Data = Fix(CDbl(CDbl(ed_BnsQty.Data *1000 * ed_BnsBndUprc.Data) / 10000))

End Sub


