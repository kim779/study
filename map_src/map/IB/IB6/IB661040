Sub complete_cusstatus()
	'MsgBox "complete_cusstatus"
	Dim check_char,tujaNM,wee,wee_char,tujasang,dmsg , tmpinfoYN

	tmpinfoYN = Trim(SCREEN.Object("main.obj_cusstatus.OUTPUT8").Data)

	If Trim(SCREEN.Object("obj_cusstatus.chkGrdNm").Data) = "N" Then
		'chkGrdNm 없으면..
		If tmpinfoYN <> "0" Then '미등록시 팝업, 미제공했으면 안띄움
