' DESC: 은행예수금(은행->증권) 사전 체크
'***************************************************************************
Sub getMoneychk()

    Dim zDpsBalAmt               '예수금잔고금액
    Dim zPsnOutAbleAmt           '인출가능금액
    Dim zMnyrclAmt               '현금미수금액
    Dim zIntrstDlinqAmt          '이자미납금액
    Dim zEtclnd                  '기타대여금
    Dim zOldUnRfundAmt           '(구) 미상환금액
    Dim zPrsmptMnyoutAbleAmtD2   '추정인출가능금 D+2
    Dim zBnkDps                  '은행예수금

    zDpsBalAmt                = SCREEN.Object("obj_SDPAQ066.DpsBalAmt").Data
    zPsnOutAbleAmt            = SCREEN.Object("obj_SDPAQ066.PsnOutAbleAmt").Data
    zMnyrclAmt                = SCREEN.Object("obj_SDPAQ066.MnyrclAmt").Data
    zIntrstDlinqAmt           = SCREEN.Object("obj_SDPAQ066.IntrstDlinqAmt").Data
    zEtclnd                   = SCREEN.Object("obj_SDPAQ066.Etclnd").Data
    zOldUnRfundAmt            = SCREEN.Object("obj_SDPAQ066.OldUnRfundAmt").Data
    zPrsmptMnyoutAbleAmtD2    = SCREEN.Object("obj_SDPAQ066.PrsmptMnyoutAbleAmtD2").Data
    zBnkDps                   = SCREEN.Object("obj_SDPAQ066.BnkDps").Data

    SYSTEM.Trace "zDpsBalAmt:"&zDpsBalAmt
    SYSTEM.Trace "zPsnOutAbleAmt:"&zPsnOutAbleAmt
    SYSTEM.Trace "zMnyrclAmt:"&zMnyrclAmt
    SYSTEM.Trace "zIntrstDlinqAmt:"&zIntrstDlinqAmt
    SYSTEM.Trace "zEtclnd:"&zEtclnd
    SYSTEM.Trace "zOldUnRfundAmt:"&zOldUnRfundAmt
    SYSTEM.Trace "zPrsmptMnyoutAbleAmtD2:"&zPrsmptMnyoutAbleAmtD2
    SYSTEM.Trace "zBnkDps2:"&zBnkDps

    Dim zmisu
    zmisu = 0
    If Trim(zMnyrclAmt) = "" Then
       zMnyrclAmt = 0
    End If

    If Trim(zIntrstDlinqAmt) = "" Then
       zIntrstDlinqAmt = 0
    End If

    If Trim(zEtclnd) = "" Then
       zEtclnd = 0
    End If

    If Trim(zOldUnRfundAmt) = "" Then
       zOldUnRfundAmt = 0
    End If

    If Trim(zPsnOutAbleAmt) = "" Then
       zPsnOutAbleAmt = 0
    End If
    SYSTEM.Trace "step1_zmisu:"& zmisu
	'미수체크
    zmisu = zMnyrclAmt + zIntrstDlinqAmt + zEtclnd + zOldUnRfundAmt
    SYSTEM.Trace "step1_zmisu:"& zmisu
    If CDbl(zmisu) > 0 Then
       MsgBox "계좌에 미수/미납금이 존재합니다. 변제 후 매수 가능합니다." , , "IBK투자증권"
       SYSTEM.Trace "zmisu:"& CDbl(zmisu)
       Exit Sub
    End If


    '인출가능금액 >= 매수금액
    Dim ableAmt
    ableAmt = 0
    SYSTEM.Trace "buytotal : "& CDbl(Trim(buytotal.text))
    ableAmt = CDbl(zPsnOutAbleAmt) - CDbl(Trim(buytotal.text))
    If ableAmt < 0 Then
       MsgBox "잔액이 부족합니다. 입금후 매수해 주세요." , , "IBK투자증권"
       SYSTEM.Trace "ableAmt:"& CDbl(ableAmt)
       Exit Sub
    End If

	'은행->증권 (은행예수금방식 계좌는 증권예수금 상태를 고려하지않고 일단 가져오고 매수진행한다)
 	SCREEN.Proc "obj_getMoney.contributionBnk", zPsnOutAbleAmt

End Sub

