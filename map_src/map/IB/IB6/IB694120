RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"

	SCREEN.Send 0

End Sub

Sub Set_obj()
	obj.SetObject "IB694121"
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.AM99").Data)

If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(zAcntNo.Data)) <> 11 Then
		'Call alert_msg("계좌번호를 확인하여 주십시오.")
		SCREEN.Object("parent.AM99").SetFocus
		Exit Sub
	Else
		If Mid(Trim(zAcntNo.Data), 4, 2) <> "00" Then
		'	Call alert_msg("종합계좌번호를 입력하여 주십시오.")
			SCREEN.Object("parent.AM99").SetFocus
			Exit Sub
		End If
	End If
End If

If SYSTEM.ConnectBy = 0 And Trim(SCREEN.Object("parent.zPwd").Data) = "" Then
	zPwd.Data = "9999"
Else
	zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)
End If

If Len(Trim(zPwd.Data)) < 4 Then
'	Call alert_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

zQryDt.Data = Trim(SCREEN.Object("parent.zQryDt").Data)

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, oday, oweek, omonth
Dim o_day, o_week, o_month
Dim ben_day, ben_week, ben_month, ben_3month
Dim ben_6month, ben_year, ben_total

For ii = 1 To  GRID0.Rows
	oday = GRID0.GetGridCell(ii, 1)
	oweek = GRID0.GetGridCell(ii, 2)
	omonth = GRID0.GetGridCell(ii, 3)

	o_day = FormatNumber(oday, 2)
	o_week = FormatNumber(oweek, 2)
	o_month = FormatNumber(omonth, 2)
	'MsgBox oday
	GRID0.SetGridCell ii, 1, o_day
	GRID0.SetGridCell ii, 2, o_week
	GRID0.SetGridCell ii, 3, o_month

	If ii = 3 Or ii = 4 Then
		ben_day = GRID0.GetGridCell(ii, 1)
		If ben_day > 0 Then
			GRID0.SetTRgb ii, 1, 94
		ElseIf ben_day < 0 Then
			GRID0.SetTRgb ii, 1, 95
		End If

		ben_week = GRID0.GetGridCell(ii, 2)
		If ben_week > 0 Then
			GRID0.SetTRgb ii, 2, 94
		ElseIf ben_week < 0 Then
			GRID0.SetTRgb ii, 2, 95
		End If

		ben_month = GRID0.GetGridCell(ii, 3)
		If ben_month > 0 Then
			GRID0.SetTRgb ii, 3, 94
		ElseIf ben_month < 0 Then
			GRID0.SetTRgb ii, 3, 95
		End If

		ben_3month = GRID0.GetGridCell(ii, 4)
		If ben_3month > 0 Then
			GRID0.SetTRgb ii, 4, 94
		ElseIf ben_3month < 0 Then
			GRID0.SetTRgb ii, 4, 95
		End If

		ben_6month = GRID0.GetGridCell(ii, 5)
		If ben_6month > 0 Then
			GRID0.SetTRgb ii, 5, 94
		ElseIf ben_6month < 0 Then
			GRID0.SetTRgb ii, 5, 95
		End If

		ben_year = GRID0.GetGridCell(ii, 6)
		If ben_year > 0 Then
			GRID0.SetTRgb ii, 6, 94
		ElseIf ben_year < 0 Then
			GRID0.SetTRgb ii, 6, 95
		End If

		ben_total = GRID0.GetGridCell(ii, 7)
		If ben_total > 0 Then
			GRID0.SetTRgb ii, 7, 94
		ElseIf ben_total < 0 Then
			GRID0.SetTRgb ii, 7, 95
		End If

	End If
Next

