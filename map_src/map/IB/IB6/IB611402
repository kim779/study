RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0050"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

fundcode.Text = Trim(SCREEN.Object("parent.fundcode").Data)
If Len(Trim(fundcode.Text)) <> 8 Then
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	For ii = 1 To GRID1.Rows
'		SYSTEM.Trace "a = " & Trim(GRID1.GetGridCell(ii, 1))
'		SYSTEM.Trace "b = " & Trim(fundcode.Text)
		If Trim(GRID1.GetGridCell(ii, 1)) = Trim(fundcode.Text) Then
			SCREEN.Object("parent.FundName").Text = Trim(GRID1.GetGridCell(ii, 2))
			SCREEN.Proc "parent.send_f", ""
			Exit Sub
		End If
	Next

	SCREEN.Object("main.FundName").text = ""
	SCREEN.Object("main.GUIDE").Text = "펀드코드를 확인하십시오."
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID1)
_AW_ONDBLCLK_AW_
Dim msg

msg = GRID1.GetGridCell(GRID1.row, 1) & "|" & GRID1.GetGridCell(GRID1.Row, 2)
If Trim(GRID1.GetGridCell(GRID1.row, 1)) <> "" Then
	SYSTEM.Push "fundmsg", msg
End If
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_

Dim msg

msg = GRID1.GetGridCell(GRID1.row, 1) & "|" & _
	GRID1.GetGridCell(GRID1.row, 2)
If Trim(GRID1.GetGridCell(GRID1.row, 1)) <> "" Then
	SYSTEM.Push "fundmsg", msg
End If
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



