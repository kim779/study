_AW_ONDECLARE_AW_
Sub tuja_change()
	Select Case Trim(tujaNM_t.Data)
	Case "안정형" :
		'tmptujaGD = "매우낮은위험"
		lb1.Text = "예금 또는 적금 수준의 수익률을 기대하며"
		lb2.Text = "투자원금에 손실이 발생하는것을 원하지 않는"
		lb3.Text = "유형입니다."
		CONTROL0.SetImageFile "미스터리쇼핑_내투자성향_05_안정형.BMP"
	Case "안정추구형" :
		'tmptujaGD = "보통위험이하"
		lb1.Text = "투자원금의 손실위험은 최소화하고, 이자소득이나"
		lb2.Text = "배당소득 중심의 안정적인 투자를 목표로하는"
		lb3.Text = "유형입니다."
		CONTROL0.SetImageFile "미스터리쇼핑_내투자성향_04_안정추구형.BMP"
	Case "위험중립형" :
		'tmptujaGD = "다소높은위험이하"
		lb1.Text = "주식형과 채권형에 적절하게 배분하여 투자하는 것을"
		lb2.Text = "선호하며, 예적금보다 상당히 높은 수익을 기대할 수 있다면"
		lb3.Text = "손실위험을 감수할 수 있는 유형입니다."
		CONTROL0.SetImageFile "미스터리쇼핑_내투자성향_03_위험중립형.BMP"
	Case "적극투자형" :
		'tmptujaGD = "높은위험이하"
		lb1.Text = "투자원금의 보전보다는 투자수익을 추구하는 유형입니다."
		lb2.Text = "투자자금의 상당부분을 주식형 및 대안투자형 등의 위험"
		lb3.Text = "자산에 투자할 의향이 있습니다."
		CONTROL0.SetImageFile "미스터리쇼핑_내투자성향_02_적극투자형.BMP"
	Case "공격투자형" :
		'tmptujaGD = "매우높은위험이하"
		lb1.Text = "시장평균 수익률을 훨씬 넘어서는 높은 수준의 투자수익을"
		lb2.Text = "추구하며, 이를 위해 자산가치의 변동에 따른 손실위험을"
		lb3.Text = "적극 수용하는 유형입니다."
		CONTROL0.SetImageFile "미스터리쇼핑_내투자성향_01_공격투자형.BMP"
	End Select

End Sub

