	LEDGER.Fkey = "7"
	GRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	If Trim(SCREEN.Object("main.AN1A").Data) = "" Then
		Exit Sub
	End If

	LEDGER.Fkey = "C"
	SCREEN.Object("main.GUIDE").Text = ""
	Dim sPass
	sPass = Trim(SCREEN.Object("main.ed_pswd").Data)
	If CLng(SYSTEM.ConnectBy) = 0 Then
		If sPass = "" Then
			sPass = "9999"
		End If
	End If

	PASS.Data = sPass
	If CheckInput(SCREEN.Object("main.AN1A"), PASS) = False Then
		Exit Sub
	End If

	AN50.Data = Trim(SCREEN.Object("main.AN1A").Data)

	SCREEN.Send 0
End Sub

