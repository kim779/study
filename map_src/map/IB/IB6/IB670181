_AW_SCRIPT_AW_(GRID)
_AW_ONCLICK_AW_
Dim p4
If GRID.HitPos <> 3 Then
	Exit Sub
End If

If Trim(GRID.GetGridCell(GRID.Row,1)) = "" Then
	Exit Sub
End If

If Trim(GRID.Column) = "8" And Trim(GRID.GetGridCell(GRID.row, 8)) <> "" Then
	SCREEN.Object("main.tab_order").ID = "5"
	SCREEN.Proc "main.order_tab_change", ""
	SCREEN.Object("main.obj_jumn.jscd").data = Trim(GRID.GetGridCell(GRID.Row,1))
	SCREEN.Proc "main.obj_jumn.changecode", "2"

	SCREEN.Object("main.obj_jumn.ed_jqty").data = Trim(GRID.GetGridCell(GRID.Row,8))
ElseIf Trim(GRID.GetGridCell(GRID.row, 8)) <> "" And Trim(GRID.GetGridCell(GRID.row, 6)) = "" Then
	SCREEN.Object("main.tab_order").ID = "5"
	SCREEN.Proc "main.order_tab_change", ""
	SCREEN.Object("main.obj_jumn.jscd").data = Trim(GRID.GetGridCell(GRID.Row,1))
	SCREEN.Proc "main.obj_jumn.changecode", "2"

	SCREEN.Object("main.obj_jumn.ed_jqty").data = Trim(GRID.GetGridCell(GRID.Row,8))
Else
	sycd = Trim(GRID.GetGridCell(GRID.Row,1))
	SCREEN.Object("main.tab_order").ID = "1"
	SCREEN.Proc "main.order_tab_change", ""
	SCREEN.Object("main.obj_jumn.jscd").data = sycd
	SCREEN.Proc "main.obj_jumn.changecode", "2"
	If SCREEN.CreateObject("Info") Then
		p4 = INFO.PopData("", "bondoption.ini", "jprc", "ro2")
	  	If p4 <> "0" Then
	  		SCREEN.Object("main.obj_jumn.ed_jqty").data = CDbl(Trim(GRID.GetGridCell(GRID.Row,6))) / 1000
	  	Else
	  		SCREEN.Object("main.obj_jumn.ed_jqty").data = Trim(GRID.GetGridCell(GRID.Row,6))
	  	End If
	End If
End If


SCREEN.Object("main.obj_jumn.ed_date").data = Trim(GRID.GetGridCell(GRID.Row,3))
If Trim(GRID.GetGridCell(1,4)) = "종합과세" Then
	SCREEN.Object("main.obj_jumn.txgb").data = "1"
	SCREEN.Object("main.obj_jumn.ed_txgb").data = "1"
Else
	SCREEN.Object("main.obj_jumn.txgb").data = "2"
	SCREEN.Object("main.obj_jumn.ed_txgb").data = "2"
End If

SCREEN.Object("main.obj_jumn.ed_jqty").SetFocus
