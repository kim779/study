Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c(param)
	Dim dataArr
	If Trim(param) <> "" Then
		dataArr = Split(Trim(param), "|")
		zAcntNo.Data  = dataArr(0)
		zPwd.Data = dataArr(1)
		send_f()
	End If
End Sub


Sub CalcRcvData()
	Dim tmpSubacc, facc, param, dataArr

	param = Trim(SYSTEM.Pop("Domino_6112P"))

	If Trim(param) <> "" Then
		dataArr = Split(Trim(param), "|")
		zAcntNo.Data  = dataArr(0)
		zPwd.Data = dataArr(1)
		tmpSubacc = OUTPUT4.Data
		facc = Mid(tmpSubacc,1,3) & "-" & Mid(tmpSubacc, 4, 2) & "-" & Mid(tmpSubacc, 6,6) & "-" & Mid(tmpSubacc, 12,3) & "  " & Trim(dataArr(2))
	End If

	f_name.Data = OUTPUT7.Data
	f_acc.Data = facc
	f_type.Data = OUTPUT9.Data
	f4.Data = OUTPUT24.Data

	If Trim(f4.Data) = "자유적립식" Then
		f7.Data = Trim(CLng(Replace(OUTPUT28.Data,"+","")))  & "개월"
	Else
		f7.Data = "-"
	End If
	CheckDt.Data = OUTPUT3.Data
End Sub

