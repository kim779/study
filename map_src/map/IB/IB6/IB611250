Dim param, dataArr
	param = Trim(SYSTEM.Pop("Domino_6112P"))
If Trim(param) <> "" Then
	dataArr = Split(Trim(param), "|")
	zAcntNo.Data  = dataArr(0)
	zPwd.Data = dataArr(1)
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"

If Len(Trim(zAcntNo.Data)) <> 14 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	Exit Sub
End If

If Len(Trim(zPwd.Data)) < 4 Then
	Call alert_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
Else
