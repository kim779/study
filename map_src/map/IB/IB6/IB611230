_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0,2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub CalcRcvData()
	Dim sdata,stmp

    TABLE1.Row = 1
	If Len(Trim(TABLE1.Data)) > 0 Then
		stmp = FormatNumber(TABLE1.Data,2)
		TABLE1.Data = stmp
	End If

	sdata = Replace(GRID0.GetGridCell(1,1),"+","")
	GRID0.SetGridCell 1, 1,sdata

	sdata = Replace(GRID0.GetGridCell(1,2),"+","")
	GRID0.SetGridCell 1, 2,sdata

	sdata = Replace(GRID0.GetGridCell(1,3),"+","")
	GRID0.SetGridCell 1, 3,sdata

	sdata = Replace(GRID0.GetGridCell(1,4),"+","")
	GRID0.SetGridCell 1, 4,sdata

	sdata = Replace(GRID0.GetGridCell(1,5),"+","")
	GRID0.SetGridCell 1, 5,sdata

	sdata = Replace(GRID0.GetGridCell(1,6),"+","")
	GRID0.SetGridCell 1, 6,sdata

	OUTPUT4.Data = Replace(OUTPUT4.Data,"+","")

	Call drawGraph()

	Dim ii, value
	For ii = 1 To GRID0.Columns
		value = Trim(GRID0.GetGridCell(1, ii))

		If value <> "" Then
			If IsNumeric(value) = True Then
				If CDbl(value) > 0 Then
					GRID0.SetTRgb 1, ii, 94
				ElseIf CDbl(value) < 0 Then
					GRID0.SetTRgb 1, ii, 95
				Else
					GRID0.SetTRgb 1, ii, 69
				End If
			End If
		End If
	Next

End Sub

'''graph
Sub drawGraph()

''///Head   169
	Dim	nHead          ''[2];	    '// data Head 개수
	Dim	nData          ''[6];	    '// 수신 data 개수
	Dim	irSize         ''[2];	    '// 1 index 데이타 크기
	Dim	drSize         ''[2];	    '// 1 value 데이타 크기
	Dim	pday           ''[8];	    '// 최근영업일자
	Dim	mgap           ''[4];	    '// 분봉갭
	Dim	xtype          ''   ;		'// 시계열의 문자열여부
	Dim	xUnit(3)       ''[3][16];	'// 하/좌/우단 단위
	Dim	tipName        ''[64];	    '// tooltip name(비시계열에 사용)
	Dim	reserve        ''[32];	    '// reserve

''//BODY  84
	Dim	filler				'''[2];	'//"XX"				*/
	Dim	name				'''[32];	'//이름				*/
	Dim	digit				'''[2];	'//소수점 자리수		*/
	Dim	rtscode				'''[12];	'//실시간 코드			*/
	Dim	symbol				'''[5];	'//실시간 심볼			*/
	Dim	rtsSign				'''[1];	'//' ' 0 1실시간 데이타의 부호필드 여부*/
	Dim	pivot				'''[14];	'//기준값			*/
	Dim	reserve2			'''[16];	'//reserve			*/

	Dim sTot,Test1,idx,yyyymmdd,a,workday

	If GRID0.rows = 1 Then

		If Trim(LOGIN.Day0) <> "" And Trim(LOGIN.Day1) <> "" And Trim(LOGIN.Day2) <> "" Then
			yyyymmdd = DateSerial(Left(LOGIN.Day1, 4), Mid(LOGIN.Day1, 5, 2), Mid(LOGIN.Day1, 7, 2))
			a = Weekday(CDate(Trim(yyyymmdd)))

			workday = Date
			'오늘이 토요일 이거나 일요일 이면 전영업일로 초기화
			If a = 7 Or a = 1 Then
				workday = LOGIN.Day0
			End If
		End If

		nHead  = 1
		nData  = GRID0.Columns-1
		irSize = 14
		drSize = 14
		pday   = workday
		mgap   = "0000"
		xtype  = "1"
		xUnit(0)= " "
		xUnit(1)= " "
		xUnit(2)= " "
		tipName = " "
		reserve = " "

