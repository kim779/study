'**********************************************************************
' 기능     : Size만큼 filler 값으로 오른쪽 채움
' 파라메터 : as_string : 문자열
'            as_cnt    : 문자열의 길이
'            as_filler : filler
' 리턴값   : cp_rpad
' 개발자   : 김동겸	04/09/08
' 수정자1  :
'**********************************************************************
Public Function cp_rpad(as_string, ai_count, as_filler)
	Dim ls_str, li_cnt
	'대상 String이 NULL이면 Filler로 채운 문자열 Return
	If IsNull(as_string) Then
		cp_rpad = String(ai_count, as_filler)
	Else
		ls_str = Trim(as_string) ' 공백 Trimming
		SCREEN.CreateObject("DX_CSTRING")
		DX_CSTRING.Text = ls_str
		li_cnt = ai_count - DX_CSTRING.GetLength()
		If li_cnt >= 0 Then
			cp_rpad = ls_str & String(li_cnt, as_filler)
		Else
			cp_rpad = Left(ls_str, ai_count)
		End If
	End If
End Function

'**********************************************************************
' 기능     : Size만큼 filler 값으로 왼쪽 채움
' 파라메터 : as_string : 문자열
'            as_cnt    : 문자열의 길이
'            as_filler : filler
' 리턴값   : cp_lpad
' 개발자   : 김동겸	04/09/08
' 수정자1  :
'**********************************************************************
Public Function cp_lpad(as_string, ai_count, as_filler)
	Dim ls_str, li_cnt
    '대상 String이 NULL이면 Filler로 채운 문자열 Return
	If IsNull(as_string) Then
		cp_lpad = String(ai_count, as_filler)
	Else
		ls_str = Trim(as_string) ' 공백 Trimming
		SCREEN.CreateObject("DX_CSTRING")
		DX_CSTRING.Text = ls_str
		li_cnt = ai_count - DX_CSTRING.GetLength()
		If li_cnt >= 0 Then
			cp_lpad = String(li_cnt, as_filler) & ls_str
		Else
			cp_lpad = Right(ls_str, ai_count)
		End If
	End If
End Function


Sub findDate()
	Dim InquiryDt, myWeek, yy, mm, dd
	InquiryDt = Trim(zSrtDt.Data)

	If InquiryDt = "" Then
		Call SetDay()
	End If

	InquiryDt = DateSerial(Mid(InquiryDt,1,4),Mid(InquiryDt,5,2),Mid(InquiryDt,7,2))
	InquiryDt = DateAdd("d", 1, InquiryDt)
	myWeek = Weekday(InquiryDt)

	If myWeek = 1 Then	'일요일
		InquiryDt = DateAdd("d", 1, InquiryDt)
	ElseIf myWeek = 7 Then	'토요일
		InquiryDt = DateAdd("d", 2, InquiryDt)
	End If

	yy = Year(InquiryDt)
	mm = Month(InquiryDt)
	If Len(mm) = 1 Then mm = "0"&mm
	dd = Day(InquiryDt)
	If Len(dd) = 1 Then dd = "0"&dd

	zSrtDt.Data = yy&mm&dd
End Sub

Sub SetDay()
	Dim srtDt
	srtDt = getCurrDay()
	srtDt = week_check(srtDt)

	zSrtDt.Data = srtDt
End Sub

