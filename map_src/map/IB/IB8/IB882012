RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim count

Sub IsReal_check()
	If is_real.Checked = False Then
		S1301.Clear
		S1021.Clear
		count = 0
	Else
		S1301.Data = save_code.Data

		'ELW인지 주식종목인지 구별
		If Trim(save_code.Data) <> "" Then

			If IsNumeric(Left(Trim(save_code.Data), 1)) = False Then
				Exit Sub
			End If

			If Trim(SCREEN.GetCodeType(save_code.Data)) = "27" Then	'ETN은 'Q'로 시작함
				S1021.Data = "Q" + save_code.Data
			Else
				If Left(Trim(save_code.Data), 1) < 5 Or Left(Trim(save_code.Data), 1) > 8 Then
					S1021.Data = "A" + save_code.Data
				Else
					S1021.Data = "J" + save_code.Data
				End If
			End If
		End If

		If count = 0 Then
			SCREEN.Send 0
			count = 1
		End If

	End If
End Sub

_AW_ONSTART_AW_
count = 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.1301").Data
If Len(Trim(S1301.Data)) <> 6 Then
	SCREEN.OnSend False
End If

'전일대비 배경색 안 닦이는 문제 해결
If Trim(save_code.Data) = "" Then
	S1301.Data = S1301.Data
End If

If Trim(save_code.Data) <> Trim(S1301.Data) Then
'	SYSTEM.Trace "pass to if "
	S11310.Clear
	save_code.Data = S1301.Data
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(11310)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(real_push)
_AW_ONCLICK_AW_
real_push.Visible False
real_pop.Visible True
real_pop.Checked False

Call IsReal_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(real_pop)
_AW_ONCLICK_AW_
real_push.Visible True
real_pop.Visible False
real_push.Checked True

Call IsReal_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



