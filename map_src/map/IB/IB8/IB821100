_AW_ONDECLARE_AW_
Option Explicit

'PrslRjtTp. Q : 조회, P : 허가, A : 불가

Sub send_f()
	SCREEN.Certify False
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	PrslRjtTp_in.Data = "Q"
	SCREEN.Send 0
End Sub

Sub send_o()
'	Call checkPwd()
'
'	If Trim(confirmPwd.Text) = "N" Then
'		Exit Sub
'	End If

'	If gubn.Data = 0 Then
'		SCREEN.Certify True
'	End If
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub DoRecieve()
	If Trim(PrslRjtTp_out.Data) = "P" Then
		state.Text = " 허용 "
	Else
		state.Text = " 불가 "
	End If

	accessBtn.Enable = False
	denyBtn.Enable = False

	If Trim(confirmPwd.Text) = "Y" Then
		Call SetBtnState()
	End If
End Sub

Sub fullpass_send()
	confirmPwd.Text = "Y"
	Call SetBtnState()
End Sub

Sub SetBtnState()
	If Trim(PrslRjtTp_out.Data) = "P" Then
		accessBtn.Enable = False
		denyBtn.Enable = True
		denyBtn.SetFocus
	Else
		accessBtn.Enable = True
		denyBtn.Enable = False
		accessBtn.SetFocus
	End If
End Sub

Sub checkPwd()
	Dim IsYn
	IsYn = SYSTEM.CheckPasswd(Trim(zPwd.Data))

	If IsYn = True Then
		confirmPwd.Text = "Y"
		Call SetBtnState()
	Else
		MsgBox "접속비밀번호를 잘못 입력하셨습니다. 접속비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		confirmPwd.Text = "N"
		GUIDE.Text = ""
		accessBtn.Enable = False
		denyBtn.Enable = False
		zPwd.Clear
		zPwd.SetFocus
		Exit Sub
	End If
End Sub

_AW_ONSTART_AW_
confirmPwd.Text = "N"

accessBtn.Enable = False
denyBtn.Enable = False

EDIT0.Data = Trim(LOGIN.Name)
custID.Data = Trim(SYSTEM.UserID)
custIDLabel.Text = "[ " & Trim(SYSTEM.UserID) & " ]"

Dim Logintype

If SCREEN.CreateObject("INFO") Then
	Logintype = Trim(INFO.PopData("", "AXISENC.INI", "LOGINTYPE", "TYPE"))
End If

If Logintype = "0" Then
	gubn.Data = "1"
	zPwd.Visible = False
	LABEL4.Visible = False
	LABEL12.Visible = True
End If


Call send_f()
zPwd.SetFocus

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

In_in.Data = "00001"


SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	Call DoRecieve()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
If gubn.Data = 1 Then
	obj0.proc "certsend" ,""
Else
	If Len(Trim(zPwd.Data)) > 3 Then
		TrdmdaCode_in.Data = "00"
		Call checkPwd()
	Else
		MsgBox "접속비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zPwd.SetFocus
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(accessBtn)
_AW_ONCLICK_AW_
TrdmdaCode_in.Data = "00"
PrslRjtTp_in.Data = "P"
Call send_o()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(denyBtn)
_AW_ONCLICK_AW_
PrslRjtTp_in.Data = "A"
TrdmdaCode_in.Data = "00"
Call send_o()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then
	If Len(Trim(zPwd.Data)) > 3 Then
		Call checkPwd()
	Else
		zPwd.SetFocus
	End If
End If
