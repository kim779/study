Dim ii
Function setscreen(mode)
	If mode = "1" Then
		For ii=4 To 6
			SCREEN.Object("main.OBJ0.PANEL"&ii-1).Visible = True
			SCREEN.Object("main.OBJ0.HGRID"&ii).Visible = True
			SCREEN.Object("main.OBJ0.DGRID"&ii).Visible = True
		Next
		For ii=7 To 12
			SCREEN.Object("main.OBJ0.HGRID"&ii).Visible = True
			SCREEN.Object("main.OBJ0.DGRID"&ii).Visible = True
		Next
	ElseIf mode = "2" Then
		For ii=4 To 6
			SCREEN.Object("PANEL"&ii-1).Visible = False
			SCREEN.Object("main.OBJ0.HGRID"&ii).SetRect (ii-4)*204, 179, (ii-4)*204+203, 179+37
			SCREEN.Object("main.OBJ0.DGRID"&ii).SetRect (ii-4)*204, 216, (ii-4)*204+203, 216+144
		Next

		For ii=7 To 12
			SCREEN.Object("main.OBJ0.HGRID"&ii).Visible = False
			SCREEN.Object("main.OBJ0.DGRID"&ii).Visible = False
		Next
	End If
End Function

