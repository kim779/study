'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	'ACNM.Data = AN1A.Name
	'zPwd.Data = AN1A.Password
	If Error_check() = False Then
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Error_check = False
	If Trim(AN1A.Data) = "" Then
		SCREEN.Object("main.AN1A").SetFocus
		Call guide_msg("계좌번호를 확인하십시오")
		Exit Function
	End If
	If Len(Trim(zPwd.Data)) < 4 Then
		SCREEN.Object("main.ed_pswd").SetFocus
		Call guide_msg("비밀번호를 확인하십시오")
		Exit Function
	End If
	Error_check = True
End Function


Sub SetCustomerType()
	If SYSTEM.ConnectBy = "0" Then
		If Trim(pswd.Data) = "" Then
			pswd.Data = "9999"
		End If
	End If
End Sub

