	obj_clientNum.Send
	zOtpVrfVal.Data = ""
	zOtpVrfVal.SetFocus
	SCREEN.SetTimer 10, False
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
