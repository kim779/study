_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 2, "IB810190 /t /s /p5 /d", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
If Trim(zMdaSeqno.data) = "" Then
	MsgBox "매체일련번호를 입력하세요",0,"IBK투자증권"
Else
	If SCREEN.Object("parent.obj_otp1.zOnesfCnfPtnTp").data = "S" Then
		If CHECK0.Checked = True Then
			SCREEN.Object("parent.obj_otp1.obj_op").send
		Else
			SCREEN.Object("parent.obj_otp1.obj_ox").send
		End If
	Else
		SCREEN.Proc "parent.Confirm_Send", ""
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
'ctrl_motp.CertOTP ClientNum.Data, zOtpVrfVal.Data
ctrl_motp.CertOTP ClientNum.Data, zOtpVrfVal.Data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctrl_motp)
_AW_ONCLICK_AW_
'MOTP 인증성공시
SYSTEM.Trace "onclick"
If ctrl_motp.OTPState = 1 Then                     'MTOP 일련번호 조회 -> 조회성공후 자동검증
	SYSTEM.Trace " MTOP search ecode = " &  ctrl_motp.ERRcode & "  OTP seqnum = "  & ctrl_motp.OTPSeqNo
Else
	If SCREEN.GetMapName(1) = "IB810100" Then
		SCREEN.Proc "parent.send", ""
		SCREEN.Proc "parent.OTP_hide", ""
	Else
		SCREEN.Proc "parent.obj_snd.send_o", ""
		SCREEN.Object("parent.obj_showCerti").Visible = False
	End If
End If
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
'MOTP 인증실패시

If ctrl_motp.OTPState = 1 Then                     'MTOP 일련번호 조회 -> 조회성공후 자동검증
	SYSTEM.Trace " MTOP search ecode = " &  ctrl_motp.ERRcode

	alert_msg(Trim(ctrl_motp.ERRMsg))
Else
	Dim msg
	msg = "MOTP Cert return Ecode = " & ctrl_motp.ERRcode
	SYSTEM.Trace msg
	msg = "MOTP cert Result = " & ctrl_motp.OTPsuccYN
	SYSTEM.Trace msg
	msg = "MOTP max error cnt = " & ctrl_motp.OTPMaxErrCnt
	SYSTEM.Trace msg
	msg = "MOTP err cnt = " & ctrl_motp.OTPErrCnt
	SYSTEM.Trace msg

'000000	OTP검증성공
'000101	필수항목누락
'000102	필수항목길이오류
'010101	mSB버전정보불일치
'100101	Connection 실패
'100102	SQL 수행 오류
'040101	등록되지 않은 OTP일련번호
'040103	OTP일련번호와 고객번호 불일치
'040104	OTP 잠김 상태
'040105	OTP 폐기 상태
'040201	유효하지않은 거래번호
'040202	OTP값 암복호화 오류
'040203	OTP값 불일치
'040204	OTP값 중복검증 요청
'900404	OTP검증실패

	msg = Trim(ctrl_motp.ERRMsg)

	If ctrl_motp.ERRcode = "040203" Then
		msg = msg & vbLf & vbLf & "재시도 가능횟수는 "& CInt(ctrl_motp.OTPMaxErrCnt) - CInt(ctrl_motp.OTPErrCnt) & "회 남았습니다."
	End If

	alert_msg(msg)
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ClientNum)
_AW_ONKEYCHANGE_AW_
'== 보안카드번호 입력 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	SCREEN.Proc "parent.Confirm_Send", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON4)
_AW_ONCLICK_AW_

If SCREEN.GetMapName(1) = "IB810100" Then
	SCREEN.Object("parent.OBJ_MOTP").Visible = False
	SCREEN.Object("parent.BTN_BANK").SetFocus
Else
	SCREEN.Object("parent.obj_showCerti").Visible = False
	SCREEN.Object("parent.sendBtn").SetFocus
End If

zOtpVrfVal.Clear
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


