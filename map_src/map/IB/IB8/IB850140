_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB850100"

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
	 	ac_data.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "AC_DATA"))
	 	ac_name.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "AC_NAME"))
	End If
End Sub


Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
	  INFO.PushData LOGIN.Name, myFILE, myMAP, "AC_DATA", ac_data.text
	  INFO.PushData LOGIN.Name, myFILE, myMAP, "AC_NAME", ac_name.text
	End If
End Sub

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Proc "OBJECT1.send_f", ""
End Sub

'==연장신청
Sub confirm()
	If CheckInput(AN1A, zPwd) = False Then
		Exit Sub
	End If

	If Len(Trim(S1301.Data)) < 6 Then
		alert_msg("종목번호를 입력하세요")
		S1301.SetFocus
		Exit Sub
	End If

	If Len(Trim(zLoanDt.Data)) < 8 Then
		alert_msg("대출일자를 입력하세요")
		zLoanDt.SetFocus
		Exit Sub
	End If

	dmsg = "acno" & vbTab & AN1A.Data & vbLf &_
		   "acnm" & vbTab & AN1A.Name & vbLf &_
		   "hnam" & vbTab & Mid(SCREEN.Object("OBJECT0.1022").Data, 2) & vbLf &_
		   "basedate" & vbTab & zLoanDt.Data & vbLf &_
		   "exdate" & vbTab & CLng(ILoanDtChgDays.Data) & "일" & vbLf &_
		   "sygb" & vbTab & sygb.Data & vbLf

			SCREEN.CreateWindow 2, "IB85014A /p5 /d", dmsg

			If SYSTEM.Pop("request") <> "OK" Then
				Exit Sub
			Else
				LEDGER.Fkey = "C"
				SCREEN.Send 0
			End If
End Sub

Sub oper_obj(data)
	SCREEN.Object("OBJECT0.1301").data = data
	OBJECT0.send
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'타이머를 줘서 1초 뒤부터는 계좌컨트롤 OnChange 허용한다
'timer.Data = 0
'SCREEN.SetTimer 10, True

timer.Data = 1

'계좌 가져오기
p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

If CheckInput(AN1A, zPwd) = True Then
	zPrslYn.Data = "1"
	If Trim(S1301.Data) = "" Then
		zIsuNo_A.Data = ""
	Else
		If SCREEN.GetCodeType(Trim(S1301.Data)) <> 27 Then
			zIsuNo_A.Data = "A"
		Else
			zIsuNo_A.Data = "Q"
		End If
	End If
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 1,2
	ACNM.Data = AN1A.Name
	zPwd.Clear
	zPwd.SetFocus
ElseIf Left(Trim(LEDGER.ECod), 1) = "0" Then
	Call alert_msg("신청이 완료되었습니다")
	SCREEN.Object("OBJECT1.LEDGER").Fkey = "C"
	SCREEN.Object("OBJECT1.account").data = AN1A.Data
	SCREEN.Object("OBJECT1.zPwd").data = zPwd.Data
	OBJECT1.Send
End If

If sec.Data = "1" Then
	zPwd.SetFocus
ElseIf sec.Data = "2" Then
	send_btn.SetFocus
ElseIf sec.Data = "3" Then
	next_btn.SetFocus
ElseIf sec.Data = "4" Then
    extend_btn.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
timer.Data = 1

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
