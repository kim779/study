_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(B_CANCEL)
_AW_ONCLICK_AW_
SYSTEM.Push "applyLoanConfirm8503", "NO"

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


