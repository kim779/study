RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Function data_split()
	Dim ii, LoanArr, loanData
	LoanArr = Split(s_data.data, "#", -1, 1) 							' 레코드 단위로 자르고 있는중..

	For ii = 1 To UBound(LoanArr)
		GRID0.InsertRow -1
		loanData = Split(LoanArr(ii), "|", -1 , 1)

		GRID0.SetGridCell GRID0.Rows, 1, Trim(loanData(0))
		GRID0.SetGridCell GRID0.Rows, 2, Trim(loanData(1))
		GRID0.SetGridCell GRID0.Rows, 3, Trim(loanData(2))

		'SYSTEM.Trace "Trim(loanData(0)):"&Trim(loanData(0))
		SYSTEM.Trace "Trim(loanData(0)):"&Trim(loanData(1))
		SYSTEM.Trace "Trim(loanData(0)):"&Trim(loanData(2))

		If CLng(Trim(loanData(2))) <> "" Then
			loanactnum.Data = CLng(Trim(loanData(2))) + CLng(loanactnum.Data)
		End If
	Next

End Function

Sub fullpass_send()
	SYSTEM.Push "applyLoanConfirm8503", "OK"
  SCREEN.CloseWindow
End Sub

_AW_ONSTART_AW_
SYSTEM.Push "applyLoanConfirm8503", "NO"

SYSTEM.Trace "popup_acntno:"&Trim(SYSTEM.Pop("applyLoanConfirm8503_acntno"))

acntno.Data = Trim(SYSTEM.Pop("applyLoanConfirm8503_acntno"))

loanactnum.Data = 0

Call data_split()

loanactnum.Data = Trim(loanactnum.Data) + "원"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(B_OK)
_AW_ONCLICK_AW_
obj0.proc "certsend" ,""
