_AW_ONDECLARE_AW_
Option Explicit
Dim gridPos

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	GRID0.SetDataPosition 2
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub send_o()
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub DoMemo()
	Dim AfirTp, PrdtTp, OrdDt, OrdMktCode, MgmtBrnNo, lOrdNo, lCtrctNo, lExecNo, AcntNo, UserId, dmsg
	AfirTp = "3"											'업무구분
	PrdtTp = zPrdtTp.Data									'상품구분
	OrdDt = Trim(GRID0.GetGridCell(GRID0.Row, 1))			'주문일

	If Trim(OrdDt) = "" Then
		Exit Sub
	End If

	OrdMktCode = Trim(GRID0.GetGridCell(GRID0.Row, 2))		'주문시장코드
	MgmtBrnNo = Trim(GRID0.GetGridCell(GRID0.Row, 4))		'관리지점번호
	lOrdNo = "+" & String(9 - Len(Trim(GRID0.GetGridCell(GRID0.Row, 5))), "0") & Trim(GRID0.GetGridCell(GRID0.Row, 5))			'주문번호
	lCtrctNo = Trim(GRID0.GetGridCell(GRID0.Row, 6))		'약정번호
	lExecNo = Trim(GRID0.GetGridCell(GRID0.Row, 7))			'체결번호
	AcntNo = Trim(GRID0.GetGridCell(GRID0.Row, 8))			'계좌번호
	UserId = Trim(GRID0.GetGridCell(GRID0.Row, 13))			'계좌번호

	dmsg = "zAfirTp" 	 & vbTab & AfirTp 	  & vbLf &_
		   "zPrdtTp" 	 & vbTab & PrdtTp 	  & vbLf &_
		   "zOrdDt" 	 & vbTab & OrdDt 	  & vbLf &_
		   "zOrdMktCode" & vbTab & OrdMktCode & vbLf &_
		   "zMgmtBrnNo"  & vbTab & MgmtBrnNo  & vbLf &_
		   "zlOrdNo" 	 & vbTab & lOrdNo 	  & vbLf &_
		   "zlCtrctNo"   & vbTab & lCtrctNo   & vbLf &_
		   "zlExecNo"    & vbTab & lExecNo 	  & vbLf &_
		   "zAcntNo"     & vbTab & AcntNo 	  & vbLf &_
		   "zUserId"     & vbTab & UserId 	  & vbLf

	SCREEN.CreateWindow 2, "IB873801 /t /p99 /d", dmsg
End Sub

Sub DoCheck()
	If zAfirTp.Data = "1" Then
		Exit Sub
	End If
End Sub

Sub DoAlarmMethod()
	Dim gridNm
	gridNm = "obj_howInformation.GRID0"

	SCREEN.Object(gridNm).Clear

	Dim ii, jj, sms, vst, wrlin, etc, chk_sms, chk_vst, chk_wrlin, chk_etc, PrdtTp, OrdDt, OrdMktCode, MgmtBrnNo, lOrdNo, lCtrctNo, lExecNo, AcntNo, UserId

	For ii = 1 To GRID0.Rows
		sms   = Trim(GRID0.GetGridCell(ii, 20))
		vst   = Trim(GRID0.GetGridCell(ii, 21))
		wrlin = Trim(GRID0.GetGridCell(ii, 22))
		etc   = Trim(GRID0.GetGridCell(ii, 23))

		If Trim(sms) <> "1" Then
			sms = "0"
		End If

		If Trim(vst) <> "1" Then
			vst = "0"
		End If

		If Trim(wrlin) <> "1" Then
			wrlin = "0"
		End If

		If Trim(etc) <> "1" Then
			etc = "0"
		End If

		chk_sms   = Trim(GRID0.GetGridCell(ii, 25))
		chk_vst   = Trim(GRID0.GetGridCell(ii, 26))
		chk_wrlin = Trim(GRID0.GetGridCell(ii, 27))
		chk_etc   = Trim(GRID0.GetGridCell(ii, 28))

		If Trim(chk_sms) <> "1" Then
			chk_sms = "0"
		End If

		If Trim(chk_vst) <> "1" Then
			chk_vst = "0"
		End If

		If Trim(chk_wrlin) <> "1" Then
			chk_wrlin = "0"
		End If

		If Trim(chk_etc) <> "1" Then
			chk_etc = "0"
		End If

		If Trim(sms) <> Trim(chk_sms) Or Trim(vst) <> Trim(chk_vst) Or _
			Trim(wrlin) <> Trim(chk_wrlin) Or Trim(etc) <> Trim(chk_etc) Then

			OrdDt = Trim(GRID0.GetGridCell(GRID0.Row, 1))			'주문일

			If Trim(OrdDt) = "" Then
				Exit Sub
			End If

			OrdMktCode = Trim(GRID0.GetGridCell(ii, 2))		'주문시장코드
			MgmtBrnNo  = Trim(GRID0.GetGridCell(ii, 4))		'관리지점번호
			lOrdNo     = "+" & String(9 - Len(Trim(GRID0.GetGridCell(ii, 5))), "0") & Trim(GRID0.GetGridCell(ii, 5))			'주문번호
			lCtrctNo   = Trim(GRID0.GetGridCell(ii, 6))		'약정번호
			lExecNo    = Trim(GRID0.GetGridCell(ii, 7))		'체결번호
			AcntNo 	   = Trim(GRID0.GetGridCell(ii, 8))		'계좌번호
			UserId 	   = Trim(GRID0.GetGridCell(ii, 13))	'주문자ID

			SCREEN.Object(gridNm).InsertRow -1

			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  1, OrdDt
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  2, OrdMktCode
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  3, MgmtBrnNo
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  4, lOrdNo
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  5, lCtrctNo
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  6, lExecNo
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  7, AcntNo
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  8, chk_sms
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows,  9, chk_vst
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows, 10, chk_wrlin
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows, 11, chk_etc
			SCREEN.Object(gridNm).SetGridCell SCREEN.Object(gridNm).Rows, 12, UserId
		End If
	Next

	If SCREEN.Object(gridNm).Rows > 0 Then
		SCREEN.Proc "obj_howInformation.insert_infoMethod", ""
	Else
		MsgBox "변경 내역을 확인 후 확인버튼을 클릭하여 주십시오.", , "IBK투자증권"
	End If
End Sub

