RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sect, dmsg
sect = 0

'----------------- 공모주청약
Sub Set_jusik()
	zIsuNo_chae.Visible = False
	chae_nm.Visible = False
	zIsuNo.Visible = True
	obj.Visible = True
	SCREEN.object("obj.17413").visible = True
	obj.Send
	sym_jusik.Visible = True
	sym_chae.Visible = False
End Sub

Sub Set_chae()
	zIsuNo_chae.Visible = True
	chae_nm.Visible = True
	zIsuNo.Visible = False
	obj.Visible = False
	SCREEN.object("obj.17413").visible = False
	'chae_nm.Data = SCREEN.GetName(105, zIsuNo_chae.Data, 0)
	sym_jusik.Visible = False
	sym_chae.Visible = True
End Sub

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2

	zRebatAcntNo.SetItems("")

	SCREEN.Object("obj_entacc.grid0").clear
	zRebatAcntNo_nm.SetItems("")

	h_acnm.Clear
	h_acnm1.Clear

	ANCM.Data = AN1A.Name
	h_acnm.Data = AN1A.Name
	'zpwd.Clear
	zpwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If

	'Call send_f()

End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
'	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'-- 입고계좌 처음세팅
Sub acct_set()
	Dim cnt, ii
	cnt = 0

	zRebatAcntNo.Index = cnt

	For ii = 0 To cb_count.Data

		If Trim(r_account.data) = Trim(zRebatAcntNo.data) Then
			zRebatAcntNo_nm.Index = zRebatAcntNo.Index
			ANCM1.data = zRebatAcntNo_nm.text
			h_acnm1.Data = ANCM1.data
		Else
			cnt = cnt + 1
			zRebatAcntNo.Index = cnt
		End If

	Next

'	account = Replace(zRebatAcntNo.text, "-", "")
'	zRebatAcntNo.data = account

End Sub

'== 입고계좌 선택시 이벤트
Sub chg_acct_set()
	zRebatAcntNo_nm.Index = zRebatAcntNo.Index
	ANCM1.data = zRebatAcntNo_nm.text
	h_acnm1.Data = ANCM1.data
End Sub

Sub Order()

	If jusik.Checked = True Then
		nm = Mid(SCREEN.Object("OBJ.1022").Data,2)
	ElseIf chae.Checked = True Then
		nm = chae_nm.Data
	End If

	dmsg = "o_acno" & vbTab & AN1A.Data & vbLf &_
	   "o_acnm" & vbTab & ANCM.Data & vbLf &_
	   "o_hnam" & vbTab & nm & vbLf &_
	   "o_jqty" & vbTab & lAppyQty.data & vbLf &_
	   '"o_jprc" & vbTab & val.Data & vbLf &_
	   "o_yuqty" & vbTab & zRebatAcntNo.Text & vbLf

		SCREEN.CreateWindow 2, "IB84084A /p5 /d", dmsg

	If SYSTEM.Pop("resv_masu_order") <> "OK" Then
		Exit Sub
	Else
		SCREEN.OnSend = True
	End If
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
val.data = 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

SCREEN.OnSend = False
r_account.Data = AN1A.Data
'MsgBox code.data
Dim str

If CheckInput(AN1A, zpwd) = True Then

	ANCM.Data = h_acnm.Data
	ANCM1.Data = h_acnm1.Data

	If Trim(zRebatAcntNo.data) = "" Then
		obj_entacc.Send
		Exit Sub
	End If
	If Trim(zIsuNo.Data) <> "" Or Trim(zIsuNo_chae.Data) <> "" Then

		If jusik.Checked = True Then
			s_zIsuNo.Skip = False
			s_zIsuNo_chae.Skip = True
			zIsuNo_chae.clear
			s_zIsuNo.Data = "A" & zIsuNo.Data
		Else
			zIsuNo.Clear
			s_zIsuNo.Skip = True
			s_zIsuNo_chae.Skip = False
			s_zIsuNo_chae.Data = zIsuNo_chae.Data
		End If

		str = Trim(lAppyQty.data) * 1
		If str = 0 Or str < 0 Then
			Call alert_msg("청약예약수량을 확인하여 주십시오.")
			lAppyQty.SetFocus
		    Exit Sub
		Else
			'주문전송 확인
			'If OrdCfg.OrderConfirm = True Then
				Call Order()
			'Else
			'	SCREEN.onSend = True
			'End If
			'SCREEN.OnSend = True
		End If
	Else
		Call alert_msg("종목번호를 입력하여 주십시오.")
		If jusik.Checked = True Then
