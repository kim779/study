_AW_ONDECLARE_AW_
Dim PsTp
PsTp = 0
Sub Set_account()
	ACNM.Data = AN99.name

	If Trim(AN99.Data) = "" Then
		AN99.SetFocus
	ElseIf Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
	End If
	GUIDE.text = ""
End Sub

Sub passPW()
		If TrxTp.Data = 1 Then
			SCREEN.Proc "OBJECT0.send_c", ""
		ElseIf TrxTp.Data = 2 Then
			If TSend.Data <> 1 Then
				SCREEN.Proc "OBJECT1.send_f", ""
			Else
				SCREEN.Proc "OBJECT0.send_f", ""
				TSend.Data = 0
			End If
		End If
End Sub

Sub checkPW()
	Dim tmpPwd,tmpAcct

	tmpAcct = Trim(SCREEN.Object("main.AN99").data)
	tmpPwd = Trim(SCREEN.Object("main.zPwd").data)

	If Len(tmpPwd) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		SCREEN.Object("main.zPwd").SetFocus
	Else
		SCREEN.Object("chk_passwd.IntaccNo").data = tmpAcct
		SCREEN.Object("chk_passwd.Pwd").data = tmpPwd
		chk_passwd.Send
	End If
End Sub


Sub Setobj(data)
	PsTp = data
	SCREEN.SetTimer 10, False
End Sub

_AW_ONTIMER_AW_
If PsTp = 1 Then
	OBJECT0.SetObject ("IB820891")
	UTAB0.ID = 1
	RADIO0.Checked = True
Else
	OBJECT0.SetObject ("IB820892")
	UTAB0.ID = 2
	RADIO0.Checked = False
End If

TrxTp.Data = "2"
TSend.Data = "1"
Call checkPW()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then
	SCREEN.Proc "obj0.send_f", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


