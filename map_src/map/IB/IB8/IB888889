'숫자 유효성 검사
Function l_cdbl(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		l_cdbl = 0
		Exit Function
	End If

	If IsNumeric(num) = False Then
		l_cdbl = 0
		Exit Function
	End If

	l_cdbl = CDbl(num)
End Function


'****************************************************************************************************************************
' 주문번호 : c_jmno, 원주문번호 : c_ojno,  종목코드 : c_code, 종목명   : c_hnam, 주문구분 : c_jmgb, 호가구분   : c_hogb,
' 체결합   : c_damt, 주문가격   : c_jprc,  주문수량 : c_jqty, 체결수량 : c_dqty, 체결가격 : c_dprc, 미체결수량 : c_wqty,
' 주문상태 : c_stat, 처리시각   : c_time
'****************************************************************************************************************************
' DESC :  주식  실시간 주문 체결
'****************************************************************************************************************************
Sub sCont_Notice(RTSGRID, VIEWGRID)
SYSTEM.Trace ""
SYSTEM.Trace ""
SYSTEM.Trace "================ sCont_Notice ==========================================="
Dim r_stat, r_jmno, r_ojno, row_F, row_O, r_stopPrc, r_stopStat
	r_stat = Trim(RTSGRID.GetGridCell(1, 11))					' 접수구분
	r_jmno = Trim(RTSGRID.GetGridCell(1, 2))						' 주문번호
	r_ojno = Trim(RTSGRID.GetGridCell(1, 3))						' 원주문번호
	r_stopPrc = Trim(RTSGRID.GetGridCell(1, r_culSPrc))					' 스탑가격
	r_stopStat = Trim(RTSGRID.GetGridCell(1, r_culSStat))					' 스탑유효

	SYSTEM.Trace "sCont_Notice r_stopPrc = " & r_stopPrc & "r_stopStat = " &  r_stopStat


	If InStr(r_stat,"접수") > 0 Then									' 기본셋팅
		Call RTSGRID.SetGridCell (1,13, "0")
		Call RTSGRID.SetGridCell (1,14, "0")
	ElseIf r_stat = "거부" Or r_stat = "접수오류" Then
		Call RTSGRID.SetGridCell (1, 13, "0")
		Call RTSGRID.SetGridCell (1, 14, "0")
	End If

' *********     VIEWGRID가 empty일 경우     *********
	If VIEWGRID.Rows = 0  Then
		VIEWGRID.InsertRow 0
		Update_Row(1)
		Call ckID
		RTSGRID.RemoveRow 0
		Exit Sub
	End If


	Dim tempCode
	tempCode = Trim(RTSGRID.GetGridCell(1, 6))

	If tempCode <> "" Then
		If Len(tempCode) = 7 Then
			tempCode = Mid(tempCode, 2)
		End If
	End If

	If chk_cod.Checked = True Then
		If Trim(S1301.Data) <> tempCode Then
			Exit Sub
		End If
	End If

	row_F = Find_Row(r_jmno)
' ********* 동일한 주문번호가 존재하는 경우 *********
	If row_F > 0 Then
		If r_stat = "체결" Then
			Call Modify_dqty(RTSGRID.GetGridCell(1, 13), row_F)
			cal_damt(row_F)
			RTSGRID.RemoveRow 0
			Exit Sub
		ElseIf r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
'			If row_O > 0 And r_stat = "정정확인"	Then
			If row_O > 0 Then
					Modify_wqty(row_O)
			End If

			cal_damt(row_F)																							' 체결합
			VIEWGRID.SetGridCell row_F, c_wqty, Trim(RTSGRID.GetGridCell(1, 8))				' 미체결수량
			VIEWGRID.SetGridCell row_F, c_stat, Trim(RTSGRID.GetGridCell(1,11))				' 접수구분
			VIEWGRID.SetGridCell row_F, c_mdgb, Left(r_stat, 2)								' 정정/취소 구분
			RTSGRID.RemoveRow 0
			Exit Sub
		ElseIf r_stat = "거부" Or r_stat = "접수오류" Then
		ElseIf InStr(r_stat,"접수") > 0 Then
		Else
			RTSGRID.RemoveRow 0
			Exit Sub
		End If
' ********* 일치하는 주문번호가 없는경우 *********
	Else
		If r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
'			If row_O > 0 And r_stat = "정정확인"	Then
			If row_O > 0 Then
					Modify_wqty(row_O)
			End If
			Call RTSGRID.SetGridCell (1, 13, "0")
			Call RTSGRID.SetGridCell (1, 14, "0")
		End If
		VIEWGRID.InsertRow 0
		row_F = 1
	End If

	Call ckID
	Update_Row(row_F)
	RTSGRID.RemoveRow 0

	SYSTEM.Trace "sCont_Notice"
End Sub

