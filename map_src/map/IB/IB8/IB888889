Sub Modify_dqty(amt, row_F)
	Dim amt_T, ccnt
	amount = VIEWGRID.GetGridCell (row_F, c_dqty)											' 체결수량
	amount = l_cdbl(amount) + l_cdbl(amt)
	Call VIEWGRID.SetGridCell (row_F, c_dqty, amount)
	Call VIEWGRID.SetGridCell (row_F, c_stat, Trim(RTSGRID.GetGridCell(1,11)))				' 처리구분
	Call VIEWGRID.SetGridCell (row_F, c_wqty, Trim(RTSGRID.GetGridCell(1,8)))				' 미체결수량

	Call VIEWGRID.SetGridCell (row_F, c_sPrc , Trim(RTSGRID.GetGridCell(1,r_culSPrc)))
	Call VIEWGRID.SetGridCell (row_F, c_sStat , Trim(RTSGRID.GetGridCell(1,r_culSStat)))

	If Trim(RTSGRID.GetGridCell(1, 14)) <> "" Then
		Call VIEWGRID.SetGridCell (row_F, c_dprc, Trim(l_cdbl(RTSGRID.GetGridCell(1, 14))))	' 체결가격
	End If

	' 분할체결 처리.
	ccnt = l_cdbl(RTSGRID.GetGridCell(1, 17))
	Call VIEWGRID.SetGridCell (row_F, 21, ccnt)   '체결수량
	If ccnt > 1 Then
		Call SetChegCountDisplay(VIEWGRID, 15, 21, row_F) '체결가격  체결수량
	End If

End Sub

Sub Modify_wqty(row)
	Dim h_qty
	h_qty = RTSGRID.GetGridCell (1, 13)										' 정정/취소 확인수량,  13 : 체결수량
SYSTEM.Trace "체결수량(c_wqty) = " & h_qty
	If Trim(VIEWGRID.GetGridCell (row, c_wqty)) <> "" Then
		h_qty = l_cdbl(VIEWGRID.GetGridCell (row, c_wqty)) - h_qty
	Else
		h_qty = "0"
	End If

	Dim stat
	stat = Trim(RTSGRID.GetGridCell(1, r_culSStat))
	If InStr(stat,"효력") > 0 Then
		h_qty = "0"
	End If

	Call VIEWGRID.SetGridCell (row, c_wqty, h_qty)
End Sub

Function Find_Row(jm_num)														' 주문번호/원주문번호가 일치하는 Row Return
	For row = 1 To VIEWGRID.Rows
		If Trim(jm_num) = Trim(VIEWGRID.GetGridCell(row, c_jmno)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

Sub cal_damt(row)																	' 체결합계산
	If Trim(RTSGRID.GetGridCell(1, 8)) <> "" Then
		VIEWGRID.SetGridCell row, c_damt, (l_cdbl(Trim(RTSGRID.GetGridCell(1, 9))) - l_cdbl(Trim(RTSGRID.GetGridCell(1, 8))))
	Else
		VIEWGRID.SetGridCell row, c_damt, Trim(RTSGRID.GetGridCell(1, 9))
	End If
End Sub

