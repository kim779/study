		If ccnt > 1 Then
			juno = Trim(VIEWGRID.GetGridCell(row, c_jmno))
			'jprc = Trim(VIEWGRID.GetGridCell(row, 11))
			hogb = Trim(VIEWGRID.GetGridCell(row, c_hogb))
			If hogb="시장가" Then
