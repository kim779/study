'****************************************************************************************************************************
' DESC :  분할체결된 정보가 존재할 경우 체결량에 "※" 표시를 해준다.
'      :  row 가 -1일 경우 모든 row에 대해 적용한다.
'****************************************************************************************************************************
Sub SetChegCountDisplay(grid, dqty_idx, dseq_idx, row)
SYSTEM.Trace "SetChegCountDisplay dqty_idx = " & dqty_idx & " dseq_idx = " & dseq_idx & " row = " & row
	Dim dqty, st, ed

	If row < 1 Then
		st = 1
		ed = grid.Rows
	Else
		st = row
		ed = row
	End If

	For ii=st To ed
'		SYSTEM.Trace "DQTY : " & Trim(grid.GetGridCell(ii, dqty_idx)) & ", DSEQ : " & Trim(grid.GetGridCell(ii, dseq_idx))
		If l_cdbl(grid.GetGridCell(ii, dseq_idx))>1 Then
			dqty = Trim(grid.GetGridCell(ii, dqty_idx))
			If Left(dqty, 2)<>"※" Then
				grid.SetGridCell ii, dqty_idx, "※" & dqty
SYSTEM.Trace "SetChegCountDisplay dqty_idx = " & "※" & dqty
			End If
		End If
	Next
End Sub

