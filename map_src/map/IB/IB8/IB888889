Function get_ho_msg(msg)
	get_ho_msg = "현금"
	If InStr(msg, "융자") > 0 Then
		get_ho_msg = "융자"
	ElseIf InStr(msg, "예담") > 0 Then
		get_ho_msg = "예담"
	ElseIf InStr(msg, "대주") > 0 Then
		get_ho_msg = "대주"
	ElseIf InStr(msg, "신용") > 0 Then
		get_ho_msg = "신용"
	ElseIf InStr(msg, "매입") > 0 Then
		get_ho_msg = "매입"
	End If
End Function

