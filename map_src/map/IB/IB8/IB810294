RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Send_F()
	Call startinit()
	LEDGER.Fkey = "C"
	'SCREEN.Send 0
	GUIDE.Text = LEDGER.Emsg
End Sub

Sub startinit
	S1.Data = "00001"
	S2.Data = Trim(SCREEN.Object("parent.chkN").data)
End Sub

_AW_ONSEND_AW_
Call Send_F()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Select Case S5.Data
Case "R"
	MsgBox "[등록되었습니다]",0,"IBK투자증권"
	If SCREEN.Object("parent.NauthY").data <> "0" Then
		SCREEN.Proc "parent.NYChange_1",""
	End If
	SCREEN.Proc "parent.TCHauth_2",""
Case "B"
	MsgBox "[처리중 입니다]",0,"IBK투자증권"
Case "V"
	MsgBox "[인증이 완료 되었습니다]",0,"IBK투자증권"
	If SCREEN.Object("parent.NauthY").data <> "0" Then
		SCREEN.Proc "parent.NYChange_1",""
	Else
		If Trim(SCREEN.Object("Main.mapname").Data) = "IB283200" Then	' 연금저축계좌 대체용 ONLY
			SYSTEM.Trigger "SetAuth", "04", "IB283200"
		Else

			If SYSTEM.pop("bond_IB6610A4") = "OK" Then
				SYSTEM.Trigger "SetAuth", "", "IB6610A4"
				SYSTEM.Trigger "SetAuth", "", "IB620209"
			ElseIf SYSTEM.pop("RP_IB620212") = "OK" Then
				SYSTEM.Trigger "SetAuth", "", "IB620212"
			ElseIf SYSTEM.pop("FD_IB498706") = "OK" Then
				SYSTEM.Trigger "SetAuth", "", "IB498706"
			Else
				SYSTEM.Trigger "SetAuth", "04", "IB810100"
			End If
		
		End If

		SCREEN.CloseWindow
	End If
	SCREEN.Proc "parent.TCHauth_2",""
Case "F"
	MsgBox "[인증에 실패 하였습니다]",0,"IBK투자증권"
	SCREEN.Proc "parent.TCHauth_2",""
Case "A"
	MsgBox "[기처리된 번호 입니다]",0,"IBK투자증권"
	SCREEN.Proc "parent.TCHauth_2",""
End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call Send_F()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


