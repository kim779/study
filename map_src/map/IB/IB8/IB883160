'***************************************************************************
' DESC: 사용자 입력키 Action
'***************************************************************************
Sub OnAxUserKey(key)
'	If OrdCfg.EnterOrder = True Then
'		If key = 13 Then
'			SYSTEM.UserKey	= True
'			DoOrder()
'		End If
'	End If
End Sub

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(c_hogb.Text, 4)		'매매구분
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & ed_jprc.Data & vbLf
		SCREEN.CreateWindow 2, "IB30016A /p5 /d", dmsg
		If SYSTEM.Pop("fo_masu_order") <> "OK" Then
			Exit Sub
		End If
	End If
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

	Call ClearLastStat()

End Sub

Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		BTN_JQTY_1.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_1"))
		BTN_JQTY_2.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_2"))
		BTN_JQTY_3.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_3"))
		BTN_JQTY_4.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_4"))
		BTN_JQTY_5.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_5"))
		If BTN_JQTY_1.Text="" Then BTN_JQTY_1.Text = 1 End If
		If BTN_JQTY_2.Text="" Then BTN_JQTY_2.Text = 2 End If
		If BTN_JQTY_3.Text="" Then BTN_JQTY_3.Text = 3 End If
		If BTN_JQTY_4.Text="" Then BTN_JQTY_4.Text = 5 End If
		If BTN_JQTY_5.Text="" Then BTN_JQTY_5.Text = 10 End If
	End If
	Call SaveConfig()
End Sub

Sub SaveConfig()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_1", BTN_JQTY_1.Text
		INFO.PushData LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_2", BTN_JQTY_2.Text
		INFO.PushData LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_3", BTN_JQTY_3.Text
		INFO.PushData LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_4", BTN_JQTY_4.Text
		INFO.PushData LOGIN.Name, myFILE, "IB883100", "BTN_JQTY_5", BTN_JQTY_5.Text
	End If
End Sub

Sub LoadLastStat()
'	If LOGIN.Brno="903" Or LOGIN.Brno="813" Then
		Dim jprc, jqty
		jprc = SYSTEM.Pop("IB8831_JPRC")
		jqty = SYSTEM.Pop("IB8831_JQTY")
