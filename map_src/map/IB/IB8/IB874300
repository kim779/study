		SCREEN.Object(object1).PRgb = "192"
		SCREEN.Object(object1).TRgb = "232"
	Next
	VIEWGRID.Clear
End Sub

Sub type_search()
	VIEWGRID.Clear
	text1 = ""
	For i =1 To 20
		object1 = "PANEL"&i
		object2 = "CHECK"&i


		If SCREEN.Object(object2).Checked Then

			If Trim(text1) = "" Then
				text1 = Trim(SCREEN.Object(object1).text)

			Else
				text1 = text1 & "," & Trim(SCREEN.Object(object1).text)
			End If

		End If

	Next

	EDIT2.Data = text1
	flag = "N"
	SCREEN.Send 0
End Sub

