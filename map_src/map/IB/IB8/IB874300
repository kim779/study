		object2 = "CHECK"&i

		SCREEN.Object(object2).Checked = False
		SCREEN.Object(object1).PRgb = "192"
		SCREEN.Object(object1).TRgb = "232"
	Next

	SCREEN.Object("C1").Checked = False
	SCREEN.Object("P1").PRgb = "192"
	SCREEN.Object("P1").TRgb = "232"

