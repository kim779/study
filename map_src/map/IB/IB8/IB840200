RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim startFlag
startFlag = 0

Sub clearSelData()
	jmcd.Clear
	jmnm.Clear
	strtDt.Clear
	gubn.Clear
	isProc.Clear
	isTJSMDown.Clear
End Sub

Sub SetUtab0()
	UTAB0.Index = 1
	obj3.SetObject "IB840240"
End Sub

Sub SetJmInfo()
	If Trim(SCREEN.Object("main.isProc").Data) <> "진행중" Then
		Exit Sub
	End If

	If Trim(SCREEN.Object("main.jmcd").Data) = "" Then
		Exit Sub
	End If

	If Len(Trim(jmcd.Data)) <> 7 Then
		SCREEN.Object("obj1.chae").Checked = True
		SCREEN.Object("obj1.zIsuNo_chae").Data = Trim(jmcd.Data)
		SCREEN.Object("obj1.chae_nm").Data = Trim(jmnm.Data)
		SCREEN.Proc "obj1.set_chae", ""
	Else
		SCREEN.Object("obj1.jusik").checked = True
		SCREEN.Object("obj1.zIsuNo").data = Mid(Trim(jmcd.Data), 2)
		SCREEN.Object("obj1.jusik_nm").data = Trim(jmnm.Data)
		SCREEN.Proc "obj1.set_jusik", ""
	End If
End Sub

Sub SetTujaRegYn()
	SCREEN.Object("obj1.zTujaReg_YN").Data = "Y"
	SCREEN.Proc "obj1.setTJSMReg", ""
	SCREEN.Proc "obj1.obj_chkTJSMDown.send_f", ""
End Sub

_AW_ONSTART_AW_
' 화면 중단 좌측 :: default - 청약 신청화면 세팅
UTAB1.Index = 0
obj1.SetObject "IB840260"

' 화면 하단 :: default - 청약유의사항 화면 세팅
UTAB0.Index = 0
obj3.SetObject "IB840250"


SCREEN.SetTimer 10, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If startFlag = 0 Then
	' SCREEN.CreateWindow 4, "IB840212 /t/s/p5/", ""
	startFlag = 1
End If

_AW_ONENDSUB_AW_
_AW_ONTIMERX_AW_
Select Case Trim(id)
Case 77	' OBJ2 하단 오브젝트 조회
	SCREEN.Proc "obj3.send_f", ""
End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(UTAB1)
_AW_ONCLICK_AW_
GUIDE.Text = ""

Select Case UTAB1.Index
	Case 0
			obj1.SetObject "IB840260" 	'청약신청
	Case 1
			obj1.SetObject "IB840270"	'청약취소
	Case 2
			obj1.SetObject "IB840280"	'추납신청
	Case 3
			obj1.SetObject "IB840290"	'추납취소
	Case Else
			UTAB1.Index = 0
			obj1.SetObject "IB840260" 	'청약신청
End Select



If UTAB1.Index <> 0 Then
	If UTAB0.Index <> 1 Then
		Call SetUtab0()
	End If
End If

SCREEN.SetTimerX 77, 30, False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 2, "IB841500 /t/d", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 2, "IB840291 /t/d", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UTAB0)
_AW_ONCLICK_AW_
GUIDE.Text = ""

Select Case UTAB0.Index
	Case 0	' 유의사항
		obj3.SetObject "IB840250"
	Case 1	' 청약내역조회
		obj3.SetObject "IB840240"
		SCREEN.Proc "obj3.send_f", ""
	Case 2 	' 청약경쟁률
		obj3.SetObject "IB840230"
	Case 3	' 우대기준조회
		obj3.SetObject "IB84026C"
End Select
