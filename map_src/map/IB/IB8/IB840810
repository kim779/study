RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0008"

'== 일주일 전날짜 구하기

Dim yy, mm, dd, cday, MyWeek

cday = DateAdd("d", -15, Date)
MyWeek = Weekday(cday)
If MyWeek = 1 Then
	cday= DateAdd("d", -2 , cday)
ElseIf MyWeek = 7 Then
	cday= DateAdd("d", -1 , cday)
End If

yy = Year(cday)
mm = Month(cday)
If Len(mm) = 1 Then mm = "0"&mm

dd = Day(cday)
If Len(dd) = 1 Then dd = "0"&dd

cday = yy&mm&dd
zQrySrtDt.Data = CDbl(cday)

SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
GRID0.Clear

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim Today, i, str

Today = Year(Now) & Right("0" & Month(Now), 2) & Right("0" & Day(Now), 2)

For i=1 To GRID0.Rows

	str = Trim(GRID0.GetGridCell (i, 3))
	If Left(str, 1) = "A" Then
		GRID0.SetGridCell i, 3, Mid(str, 2, Len(str))
	End If

	If Trim(GRID0.GetGridCell(i, 10)) <> "" Then
		If CDbl(Today) > CDbl(GRID0.GetGridCell(i, 10)) Then
			GRID0.SetGridCell i, 1, "마감"
		Else
			GRID0.SetGridCell i, 1, "진행중"
		End If
	End If
Next


If LEDGER.Next = "Y" Then
	Call send_c()
End If

send_btn.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zQrySrtDt)
_AW_ONCHANGE_AW_
If SCREEN.Key = 13 Then
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

If GRID0.Column = 13 Then
	SCREEN.CreateWindow 1, "IB840211 /t/s/p5/d", "zAppyIsuNo" & vbTab & GRID0.GetGridCell(GRID0.row, 3) & vbLf & "zAppySrtDt_in" & vbTab & GRID0.GetGridCell(GRID0.row, 2) & vbLf & "zLstdDt_in" & vbTab & GRID0.GetGridCell(GRID0.row, 9)
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
SCREEN.Object("main.obj3.next_btn").enable = False

Dim str, dt, amt
str = Trim(GRID0.GetGridcell(GRID0.row, 3))

amt = Trim(GRID0.GetGridCell(GRID0.row, 5))
SCREEN.Object("main.obj1.amt").data = amt

dt = Trim(GRID0.GetGridCell(GRID0.row, 2))

If Len(str) <> 6  Then
	SCREEN.Object("main.OBJ1.chae").checked = True
	SCREEN.Object("main.obj1.zIsuNo_chae").data = str
	SCREEN.Object("main.obj1.chae_nm").data = Trim(GRID0.GetGridcell(GRID0.row, 4))
	SCREEN.Proc "main.OBJ1.set_chae", ""
	SCREEN.Object("main.obj1.objrecv").send
	SCREEN.Object ("main.obj1.zAppySrtDt").data = dt
Else
	SCREEN.Object("main.OBJ1.jusik").checked = True
	SCREEN.Object("main.obj1.zIsuNo").data = str
	SCREEN.Proc "main.OBJ1.set_jusik", ""
	SCREEN.Object("main.obj1.objrecv").send
	SCREEN.Object ("main.obj1.zAppySrtDt").data = dt
End If

If Len(str) <> 6 Then
	SCREEN.Object("main.OBJ3.chae").checked = True
	SCREEN.Object("main.obj3.zIsuNo_chae").data = str
	SCREEN.Object("main.obj3.chae_nm").data = Trim(GRID0.GetGridcell(GRID0.row, 4))
	SCREEN.Object ("main.obj3.zAppySrtDt").data = dt
	SCREEN.Proc "main.obj3.set_chae", ""
	SCREEN.proc "main.obj3.send_f", ""
Else
	SCREEN.Object("main.OBJ3.jusik").checked = True
	SCREEN.Object("main.obj3.no").data = str
	SCREEN.Object("main.obj3.obj").send
	SCREEN.Object ("main.obj3.zAppySrtDt").data = dt
	SCREEN.Proc "main.obj3.set_jusik", ""
	SCREEN.proc "main.obj3.send_f", ""
End If

SCREEN.Object("main.obj1.tjsmDn").enable = True
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 Then
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



