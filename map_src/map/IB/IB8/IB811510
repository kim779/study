RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim i
Dim code, name
Dim pdc
Dim data

For i = 1 To GRID0.Rows
	code = GRID0.GetGridCell(i, 1)
	name = Trim(GRID0.GetGridCell(i, 2))

	If Trim(code) <> "091" Then
		pdc = pdc & "|" & code & name
		data = vbTab & pdc
	End If
Next

SCREEN.Proc "parent.SettingCB", pdc

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



