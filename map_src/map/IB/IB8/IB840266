		"zAppyIsuNo" & vbTab & jmcd 								   		 & vbLf &_
		"zAppySrtDt" & vbTab & Trim(SCREEN.Object("main.strtDt").Data)       & vbLf &_
		"regYn" 	 & vbTab & Trim(SCREEN.Object("main.isTJSMDown").Data)   & vbLf

If Trim(zStrtDt.Data) <> "" And Trim(zEndDt.Data) <> "" Then
	If CDbl(zToday.Data) < CDbl(zStrtDt.Data) Then
		MsgBox "청약예정 종목입니다. 청약기간을 확인하여 주십시요.", , "IBK투자증권"
		Exit Sub
	ElseIf CDbl(zToday.Data) > CDbl(zEndDt.Data) Then
		MsgBox "청약이 마감된 종목입니다. 청약기간을 확인하여 주십시요.", , "IBK투자증권"
		Exit Sub
	Else
		SCREEN.CreateWindow 2, "IB840267 /p5 /d", param
	End If
Else
	SCREEN.CreateWindow 2, "IB840267 /p5 /d", param
End If

If SYSTEM.Pop("Dn_Success") <> "OK" Then
	Exit Sub
End If

SCREEN.Object("main.isTJSMDown").Data = "Y"

If Trim(SCREEN.Object("main.isProc").Data) = "진행중" Then
	tjsmChk.Enable = True
	tjsmChk2.Enable = True
	tjsmChk3.Enable = True
	tjsmChk4.Enable = True
	s_btn.Enable = True
	c_btn.Enable = True
Else
