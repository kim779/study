_AW_ONDECLARE_AW_
Option Explicit

'--계좌번호, 계좌명 세팅
Sub acct_set()
	If Len(CMB_ACCT.Data) = 11 Then
		Dim tmpAcnm
		tmpAcnm = Split(Trim(CMB_ACCT.Text), " ")

		ACNM.Data = tmpAcnm(2)

		If SYSTEM.ConnectBy = "0" Then
			zPwd.Data = "9999"
		End If

		SCREEN.Proc "obj.send_f", ""
	Else
		CMB_ACCT.SetFocus
	End If
End Sub

Sub SetDate()
	zSrtDt.Data = change_indate("d", -14, zEndDt.Text)
End Sub

Sub SetQryTp()
	Dim grd
	Set grd = SCREEN.Object("obj.GRID0")

	If Trim(zQryTp.data) = "0" Then
		grd.SetColumnVisible 1, True
		grd.SetColumnwidth  2, 160
		grd.SetColumnwidth  3, 160
		grd.SetColumnwidth  4, 160
	Else
		grd.SetColumnVisible 1, False
		grd.SetColumnwidth  2, 188
		grd.SetColumnwidth  3, 188
		grd.SetColumnwidth  4, 189
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'직원/고객에 따른 비밀번호 컨트롤 설정
Call Check_LoginType(zPwd)

SCREEN.Proc "obj_getAcnt.send_f", ""	'계좌번호 가져오기(CX_DATATRANS)
Call SetDate()							'결제 시작일을 2주일 전으로 세팅

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
