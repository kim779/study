RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"
zTrxTp.Data = "3"
zRmnno.Data = Trim(LOGIN.Juno)
zAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Exit Sub
End If

zAppyIsuNo.Data = Trim(SCREEN.Object("main.jmcd").Data)
zDlvrDt.Data = ""		'등록여부를 확인하는 조회성이기 때문에 NULL값
zSndMthdCode.Data = ""
zDownTime.Data = ""
zAppyDlvrUrl.Data = ""

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod, mapNm
ecod = Trim(LEDGER.Ecod)
mapNm = Trim(SCREEN.GetMapName(1))

If chkNumericData(ecod) = False Then
	Exit Sub
End If


If Left(ecod, 1) = "0" Then
	' 투자설명서 교부 받은 상태
	If mapNm = "IB840200" Then
		Dim method, Domino, showTime, tmpHour

		' 투자설명서 교부 방법
		Select Case Trim(zSndMthdCode_out.Data)
			Case "01"
				method = "책자"
			Case "02"
				method = "CD"
			Case "03"
				method = "전자문서"
			Case "04"
				method = "이메일"
			Case "05"
				method = "우편"
			Case "06"
				method = "거절"
		End Select

		showTime = Trim(zDownTime_out.Data)

		If chkNumericData(showTime) = True Then
			If Len(showTime) = 6 Then
				showTime = Left(showTime, 2) & ":" & Mid(showTime, 3, 2) & ":" & Right(showTime, 2)
				tmpHour = Left(showTime, 2)

				If CLng(tmpHour) >= 0 And CLng(tmpHour) < 12 Then
					showTime = "오전 " & showTime
				Else
					If CLng(tmpHour) >= 13 Then
						tmpHour = tmpHour - 12
					End If

					showTime = "오후 " & tmpHour & Mid(showTime, 3)
				End If
			Else
				showTime = ""
			End If
		Else
			showTime = ""
		End If

		Domino = "dt" & vbTab & Trim(zDlvrDt_out.Data) & vbLf &_
			     "time" & vbTab & showTime & vbLf &_
			     "trans" & vbTab & method & vbLf

		SCREEN.CreateWindow 2, "IB84026B /p5 /d", Domino

		SCREEN.Object("main.isTJSMDown").Data = "Y"
		'SCREEN.Proc "parent.scrDisAble", ""
		'SCREEN.Proc "parent.chkTJSMDown", ""
		'SCREEN.Proc "parent.enterPwd", ""
		SCREEN.Proc "parent.enterPwd", ""
	Else
		SCREEN.Object("parent.regYn").Data = "Y"
		SCREEN.Object("parent.obj_yesu").Send
		SCREEN.Object("parent.obj0.tjsmDn").Enable = True
		SCREEN.Object("parent.lAppyQty").Enable = True
		SCREEN.Object("parent.AppyQtyBtn").Enable = True	'청약가능수량 버튼
		SCREEN.Object("parent.zRebatAmtMtrsfBnkAcntNo").Enable = True
		SCREEN.Object("parent.zRebatAcntNo").Enable = True
		SCREEN.Object("parent.obj0.acrDn").Enable = True
		SCREEN.Object("parent.BUTTON1").Enable = True
		SCREEN.Object("parent.obj0.tjsmChk").Enable = False
		SCREEN.Object("parent.obj0.s_btn").Enable = False
		SCREEN.Object("parent.obj0.c_btn").Enable = False
	End If
Else
	' 투자설명서 교부받지 않은 상태
	If mapNm = "IB840200" Then
		SCREEN.Object("main.isTJSMDown").Data = "N"
		SCREEN.Proc "parent.scrDisAble", ""

		If ecod = "2679" Then
			' Highlight
			SCREEN.SetTimerX 1, 3, False
			Call guide_msg("투자설명서를 다운받아 주십시오.")
		Else
			Call guide_msg(Trim(LEDGER.Emsg))
		End If
	Else
		SCREEN.Object("parent.regYn").Data = "N"
		SCREEN.Object("parent.tjsmDn").Enable = True
		SCREEN.Object("parent.lAppyQty").Enable = False
		SCREEN.Object("parent.AppyQtyBtn").Enable = False	'청약가능수량 버튼
		SCREEN.Object("parent.zRebatAmtMtrsfBnkAcntNo").Enable = False
		SCREEN.Object("parent.zRebatAcntNo").Enable = False
		SCREEN.Object("parent.obj0.acrDn").Enable = True
		SCREEN.Object("parent.BUTTON1").Enable = False
		SCREEN.Object("parent.obj0.tjsmChk").Enable = False
		SCREEN.Object("parent.obj0.s_btn").Enable = False
		SCREEN.Object("parent.obj0.c_btn").Enable = False

		Call guide_msg(Trim(LEDGER.Emsg))
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMERX_AW_
Select Case Trim(id)
Case 1
	SCREEN.Object("Parent.obj0.HIGHLIGHT").Visible = True
	SCREEN.SetTimerX 2, 1500, False
Case 2
	SCREEN.Object("Parent.obj0.HIGHLIGHT").Visible = False
End Select

_AW_ONENDSUB_AW_
