zBnkAcntNo.Data = SCREEN.Object("parent.bank_acct").data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod),1) = "0" Then
	SCREEN.Object("parent.OUT_ACNM").data = zDpsPsnNm.Data
	SCREEN.Object("parent.EDIT_NAME").data = zDpsPsnNm.Data

	Select Case SCREEN.Object("main.UTAB0").ID
		Case 1 : SCREEN.Object("parent.AMT").SetFocus
		Case 3 : SCREEN.Object("parent.EDIT_PWD").SetFocus
	End Select
Else
	If Trim(LEDGER.Ecod) <> "3130" Then
		alert_msg(Trim(LEDGER.Emsg))
	End If

	If Trim(zBnkMsgCnts.Data) <> "" Then
		MsgBox Trim(zBnkMsgCnts.Data), , "은행메세지"
	End If

	If SCREEN.Object("main.UTAB0").ID = 1 Then
		SCREEN.Object("parent.edit_acct").SetFocus
	End If
End If

