_AW_ONDECLARE_AW_
Option Explicit

Dim flag

'== 첫 조회
Sub send_f()
	flag = "C"
	GRID0.Clear
	GRID1.Clear
	gridPos.Data = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	flag = "7"
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition 2
	SCREEN.Send 0
End Sub

'청약단위 조회
Sub getAppyQty()
	GRID0.Clear

	Dim ii, jj

	jj = 1
	For ii = 1 To GRID1.Rows
		If CDbl(Trim(lAppyQty.Data)) <= CDbl(Trim(GRID1.GetGridCell(ii, 1))) Then
			GRID0.InsertRow -1
			GRID0.SetGridCell jj, 1, GRID1.GetGridCell(ii, 1)
			GRID0.SetGridCell jj, 2, GRID1.GetGridCell(ii, 2)
			jj = jj + 1
		End If
	Next
End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0100"
lAppyQty.Data = ""

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"

If Trim(zAppyIsuNo.Data) <> "" Then
	SCREEN.OnSend = True
Else
	Call alert_msg("왼쪽 청약내역화면에서 종목을 더블클릭하여 주십시오.")
End If

zlAppyQty.Data = "+000000000000000"

If SCREEN.GetMapName(1) = "IB872500" Then
	If SCREEN.Object("main.UTAB0").ID <> 2 Then
		SCREEN.Object("object0.zAppyAcntNo").data = SCREEN.Object("main.obj3.AN1A").Data
	Else
		Exit Sub
	End If
Else
	SCREEN.Object("object0.zAppyAcntNo").data = SCREEN.Object("main.obj1.AN1A").Data
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(LEDGER.Ecod, 1) = "0" Then
	If LEDGER.Next = "Y" Then
		' 연속조회가 남아 있는 경우 끝까지 조회 후 GRID 처리
		Call send_c()
	Else

		Dim ii, cnt
		cnt = 1

		If GRID1.Rows > 0 Then
			If Trim(lAppyQty.Data) = "000000000000000" Then
				'----------------------------------------------------------------------
				' 청약 단위 지정조회가 없는 경우 Bypass로 화면 표기 GRID에 데이터 세팅
				'----------------------------------------------------------------------
				For ii = gridPos.Data To GRID1.Rows
					GRID0.InsertRow -1
					GRID0.SetGridCell ii, 1, Trim(GRID1.GetGridCell(ii, 1))
					GRID0.SetGridCell ii, 2, Trim(GRID1.GetGridCell(ii, 2))
				Next

				gridPos.Data = GRID1.Rows + 1
			Else
				'-------------------------------------------------------------------------------------------
				' 청약 단위 지정조회가 있는 경우 청약단위 조회 미만은 필터링 후 화면 표기 GRID에 데이터 세팅
				'-------------------------------------------------------------------------------------------
				If IsNumeric(lAppyQty.Data) = True Then
					' 조회그리드에 데이터 있는지 CHK
					If Trim(GRID1.GetGridCell(GRID1.Rows, 1)) = "" Then
						Exit Sub
					End If

					'------------------------------------------------------------------
					' 조회된 가장 마지막 데이터가 청약단위 조회 미만인 경우 연속조회
					' 2023.12.20 무조건 연속조회 끝까지 하는것으로 변경해서 여기 안탐
					'------------------------------------------------------------------
					If CDbl(lAppyQty.Data) > CDbl(GRID1.GetGridCell(GRID1.Rows, 1)) Then
						If LEDGER.Next = "Y" Then
							GRID1.Clear
							gridPos.Data = 1
							Call send_c()
							Exit Sub
						End If
					End If


					For ii = gridPos.Data To GRID1.Rows
						' 조회그리드에 데이터 있는지 CHK
						If Trim(GRID1.GetGridCell(ii, 1)) = "" Then
							Exit For
						End If

						'------------------------------------------------------------------
						' 현재 ROW의 청약단위 데이터가 청약단위조회 미만인 경우 해당 ROW DELETE
						'------------------------------------------------------------------
						If CDbl(lAppyQty.Data) > CDbl(Trim(GRID1.GetGridCell(ii, 1))) Then
							GRID1.RemoveRow ii - 1
							ii = ii - 1
						Else
							Exit For
						End If
					Next

					For ii = gridPos.Data To GRID1.Rows
						GRID0.InsertRow -1
						GRID0.SetGridCell ii, 1, Trim(GRID1.GetGridCell(ii, 1))
						GRID0.SetGridCell ii, 2, Trim(GRID1.GetGridCell(ii, 2))
					Next

					gridPos.Data = GRID1.Rows + 1
				End If
			End If
		End If

		SCREEN.SetTimer 2, False

		' 화면 표기 그리드에 빈 값이 있으면 제거
		For ii = GRID0.Rows To 1 Step -1
			If Trim(GRID0.GetGridCell(ii, 1)) = "" Then
				GRID0.RemoveRow ii - 1
			End If
		Next

		OBJECT0.Send
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Is_numeric(d3GrpAppyMgnrt.Data) = True Then
	Dim tmp
	tmp = FormatNumber((d3GrpAppyMgnrt.Data), 2, 0, 0, 0)
