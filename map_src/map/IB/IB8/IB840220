				End If
			Else
				If UCase(TypeName( SCREEN.Object("main.obj1.obj0.invest_info1") )) <> "NOTHING" Then
					SCREEN.Object("main.obj1.obj0.invest_info1").Visible = True
					SCREEN.Object("main.obj1.obj0.invest_info2").Visible = True
					SCREEN.Object("main.obj1.obj0.invest_info3").Visible = True
					SCREEN.Object("main.obj1.obj0.invest_info4").Visible = True
					SCREEN.Object("main.obj1.obj0.invest_info5").Visible = True
					SCREEN.Object("main.obj1.obj0.tjsmChk4").Visible = True
					SCREEN.Object("main.obj1.obj0.tjsmChk4").Checked = False
				End If
			End If
	
			SCREEN.Object("main.obj1.obj0.viewD3GrpAppyMgnrt").Data = viewD3GrpAppyMgnrt.Data
		End If
	End If
End If

