	If SCREEN.GetMapName(1) = "IB840200" Then
		If SCREEN.Object("main.UTAB1").ID = "0" Then
			If tmp = 100 Then
				If UCase(TypeName( SCREEN.Object("main.obj1.obj0.invest_info1") )) <> "NOTHING" Then
					SCREEN.Object("main.obj1.obj0.invest_info1").Visible = False
					SCREEN.Object("main.obj1.obj0.invest_info2").Visible = False
					SCREEN.Object("main.obj1.obj0.invest_info3").Visible = False
					SCREEN.Object("main.obj1.obj0.invest_info4").Visible = False
					SCREEN.Object("main.obj1.obj0.invest_info5").Visible = False
					SCREEN.Object("main.obj1.obj0.tjsmChk4").Visible = False
