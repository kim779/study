RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim gridPos			'다음 그리드 시작 위치
gridPos = 1

Const MYFILE = "userconf.ini"
Const MYMAP = "IB873400"

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "EmpTp", EmpTp.Data
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim temp
		temp = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "EmpTp"))
		SCREEN.IgnoreChange True
		If temp <> "" Then
			EmpTp.Data = temp
		End If
		SCREEN.IgnoreChange False
	End If
End Sub

'== 첫 조회
Sub send_f()
	gridPos = 1
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"
zEmpNo.Data = SYSTEM.UserID
Call p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False

If Trim(IsuNo.Data) = "" Then
	FundName.Text = ""
End If

If CheckInput_1(zEmpNo, zEmpPwd) = True Then
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0,2
	zEmpPwd.Clear
	zEmpPwd.SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
	next_btn.SetFocus
Else
	next_btn.Enable = False

	'조회 완료후 합계 구함
	If GRID0.Rows > 0 Then
		Dim ii, sumHldUnit, sumEvalAmt, sumPayAmt, sumMthPayAsmAmt
		sumHldUnit = 0
		sumEvalAmt = 0
		sumPayAmt  = 0
		sumMthPayAsmAmt = 0

'		SYSTEM.Trace "grid0.Rows = " & GRID0.Rows

		For ii = 1 To GRID0.Rows

			If Trim(GRID0.GetGridCell(ii, 7)) <> "" Then '보유좌수
				sumHldUnit = sumHldUnit + Trim(GRID0.GetGridCell(ii, 7))
			End If

			If Trim(GRID0.GetGridCell(ii, 10)) <> "" Then '평가금액
				sumEvalAmt = sumEvalAmt + Trim(GRID0.GetGridCell(ii, 10))
			End If

			If Trim(GRID0.GetGridCell(ii, 11)) <> "" Then '납입금액
				sumPayAmt = sumPayAmt + Trim(GRID0.GetGridCell(ii, 11))
			End If

			If Trim(GRID0.GetGridCell(ii, 17)) <> "" Then '월납입누계금액
				sumMthPayAsmAmt = sumMthPayAsmAmt + Trim(GRID0.GetGridCell(ii, 17))
			End If
		Next

		GRID0.InsertRow(-1) '마지막 행에 열 추가

		GRID0.SetGridCell GRID0.Rows, 2,  "총합"
		GRID0.SetGridCell GRID0.Rows, 7,  sumHldUnit
		GRID0.SetGridCell GRID0.Rows, 10, sumEvalAmt
		GRID0.SetGridCell GRID0.Rows, 11, sumPayAmt
		GRID0.SetGridCell GRID0.Rows, 17, sumMthPayAsmAmt
	End If
End If


Dim jj
For jj = gridPos To GRID0.Rows
	Dim tmpTel
	tmpTel = Trim(GRID0.GetGridCell(jj, 13))

	If tmpTel = "--" Then
		GRID0.SetGridCell jj, 13, ""
	End If
Next

gridPos = GRID0.Rows + 1

'Select Case sec.data
'	Case "1"	zEmpNo.SetFocus
'	Case "2"	zEmpPwd.SetFocus
'	Case "3"	send_btn.SetFocus
'	Case "4"    next_btn.SetFocus
'End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
sec.Data = "3"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
sec.Data = "3"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BalBaseTp)
