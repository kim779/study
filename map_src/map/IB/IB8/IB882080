_AW_ONDECLARE_AW_
Sub ReadQtyConfig
	Dim data, array, j, i
	If SCREEN.CreateObject("Info") Then
		data = Trim(INFO.PopData(LOGIN.Name, "ordcfg.ini", "IB882000", "812_QtyConfig"))
	End If
'	SYSTEM.Trace "data: " & data
	If Trim(data) = "" Then
		data = "10|100|1000|10000"
	End If
	array = Split(data, "|", -1, 1)

	j=0
	For Each i in array
	 j = j+1

	 If Trim(array(j-1)) <> "" Then
	 	'GRID0.SetGridCell j, 1, CStr(CLng(array(j-1)))
	 	'GRID0.SetGridCell j, 2, CStr(CLng(array(j-1)))
'	 	SYSTEM.Trace array(j-1)
	 	GRID0.SetGridCell j, 1, array(j-1)
	 	GRID0.SetGridCell j, 2, array(j-1)
	 End If
	Next
End Sub

_AW_ONSTART_AW_
Call ReadQtyConfig()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

