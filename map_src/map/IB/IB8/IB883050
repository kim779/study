Sub SaveLastStat()
	SYSTEM.Push "IB8830_JPRC", ed_jprc.Data
	SYSTEM.Push "IB8830_JQTY", ed_jqty.Data
End Sub

Sub ClearLastStat()
	SYSTEM.Push "IB8830_JPRC", ""
	SYSTEM.Push "IB8830_JQTY", ""

	' 스프레드 종목은 주문 직후 주문이 나갈 수 없게, 주문단가를 Clear
	If Left(Trim(ed_cfocod.Data), 1) = "4" And Left(Trim(ed_cfocod.Data), 1) = "D" Then
		ed_jprc.Clear
	End If
End Sub

Sub SettHoga()
	If Left(Trim(ed_cfocod.Data), 3) = "186" Or Left(Trim(ed_cfocod.Data), 3) = "486" Or _
	   Left(Trim(ed_cfocod.Data), 3) = "A86" Or Left(Trim(ed_cfocod.Data), 3) = "D86" Then
		r_hogb0.Checked = True
		r_hogb1.Enable = False
		c_hogb.Data = "00"
		c_hogb.Enable = False
	Else
		r_hogb1.Enable = True
		c_hogb.Enable = True

		' 스프레드 종목은 탭 변경 직후 주문이 나갈 수 없게, 주문단가를 Clear
		If Left(Trim(ed_cfocod.Data), 1) = "4" Or Left(Trim(ed_cfocod.Data), 1) = "D" Then
			ed_jprc.Clear
		End If
	End If

End Sub

