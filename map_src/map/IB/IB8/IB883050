RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Const myFILE = "userconf.ini"

Dim start_f
start_f = 1

' 공통함수(IB999922) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "1"

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg, prc, tmpCode

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		flash_fg.Data = 0
		Exit Sub
	End If

	tmpCode = Left(Trim(ed_cfocod.Data), 3)

	If tmpCode = "185" Or tmpCode = "186" Or tmpCode = "187" Or tmpCode = "485" Or tmpCode = "486" Or tmpCode = "487" Or _
	   tmpCode = "A85" Or tmpCode = "A86" Or tmpCode = "A87" Or tmpCode = "D85" Or tmpCode = "D86" Or tmpCode = "D87" Then
		prc = ed_jprc.Data
	Else
		prc = FormatNumber((ed_jprc.Data)/100, 2, -1, 0)
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(c_hogb.Text, 4)		'매매구분
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("Main.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & prc & vbLf
		SCREEN.CreateWindow 2, "IB31415A /p5 /d", dmsg
		If SYSTEM.Pop("fo_mado_order") <> "OK" Then
			flash_fg.Data = 0
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")
	flash_fg.Data = 0
	Call ClearLastStat()
End Sub

Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		BTN_JQTY_1.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB883000", "BTN_JQTY_1"))
