RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos, NextData	'nextData는 다음버튼을 클릭했는지 구분자. 다음버튼 클릭시 이전의 데이터와 비교하기 위함.

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	NextData = "No"

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	NextData = "Yes"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub sumAccn()
	Dim ii, jj, mmgb, tColor

'	For ii = gridPos To GRID0.Rows
	ii = gridPos

	While ii <= GRID0.Rows + 1
'		SYSTEM.Trace "ii1 = " & ii
'		SYSTEM.Trace "grid0.Rows1 = " & GRID0.Rows

		If ii = 1 Then
			chkAccn.Text = Trim(GRID0.GetGridCell(1, 1))
			startSum.Text = "1"

'			SYSTEM.Trace "chkannc = " & Trim(chkAccn.Text)
		End If

		mmgb = Trim(GRID0.GetGridCell(ii, 4))

		If mmgb = "B" Then
			tColor = 94
		ElseIf mmgb = "S" Then
			tColor = 95
		End If

		GRID0.SetTRgb ii, 20, tColor
		GRID0.SetTRgb ii, 22, tColor
		GRID0.SetTRgb ii, 24, tColor

		If NextData = "No" Then
			If ii >= 2 Then
				Dim TotalAmt, tmpAmt
				If Trim(chkAccn.Text) <> Trim(GRID0.GetGridCell(ii, 1)) Then
					For jj = CDbl(startSum.Text) To ii - 1
						tmpAmt = Trim(GRID0.GetGridCell(jj, 24))

						If tmpAmt = "" Then
							tmpAmt = 0
						End If

						If IsNumeric(tmpAmt) = False Then
							tmpAmt = 0
						End If

						TotalAmt = TotalAmt + CDbl(tmpAmt)
					Next

					GRID0.InsertRow ii - 1

					GRID0.SetGridCell ii, 3, "소계"
					GRID0.SetGridCell ii, 24, TotalAmt

					TotalAmt = 0

					ii = ii + 1

					If ii <= GRID0.Rows Then
						startSum.Text = ii
						chkAccn.Text = Trim(GRID0.GetGridCell(ii, 1))
					End If
				End If
			End If
		Else
			If ii = gridPos Then
				If Trim(chkAccn.Text) = Trim(GRID0.GetGridCell(ii, 1)) Then
					GRID0.RemoveRow ii - 2

					'ii = ii - 1
				Else
					startSum.Text = ii
					chkAccn.Text = Trim(GRID0.GetGridCell(ii, 1))
				End If
			End If

			If Trim(chkAccn.Text) <> Trim(GRID0.GetGridCell(ii, 1)) Then
				Call insertTotalAmt(ii)
			End If
		End If

		ii = ii + 1
	Wend


	gridPos = GRID0.Rows + 1
End Sub

Sub insertTotalAmt(ii)
	Dim jj, tmpAmt, TotalAmt

	For jj = CDbl(startSum.Text) To ii - 1
		tmpAmt = Trim(GRID0.GetGridCell(jj, 24))

		If tmpAmt = "" Then
			tmpAmt = 0
		End If

		If IsNumeric(tmpAmt) = False Then
			tmpAmt = 0
		End If

		TotalAmt = TotalAmt + CDbl(tmpAmt)
	Next

	GRID0.InsertRow ii - 1

	GRID0.SetGridCell ii, 3, "소계"
	GRID0.SetGridCell ii, 24, TotalAmt

	TotalAmt = 0

	ii = ii + 1

	If ii <= GRID0.Rows Then
		startSum.Text = ii
		chkAccn.Text = Trim(GRID0.GetGridCell(ii, 1))
	End If
End Sub

