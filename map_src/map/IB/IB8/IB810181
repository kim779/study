RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Dim acct1, acct2
Sub send_f()
	GRID0.Clear

	acct.Data = Trim(zAcntNo.data)
	iTp.Data = Tp.Data

	LEDGER.Fkey = "C"
	SCREEN.SetTimer 2, False
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub addCompany()
	For ii=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell (ii, 1)) = "" Then
			GRID0.SetGridCell ii, 1, "068"
			GRID0.SetGridCell ii, 2, "IBK투자증권"
		End If

		If Trim(GRID0.GetGridCell (ii, 1)) = "068" Then
			GRID0.SetFormat ii, 3, "999-99-999999"
		Else
			GRID0.SetFormat ii, 3, "99999999999999999999"
		End If
	Next
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
SYSTEM.Push "recent", "Cancel"
send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		Call addCompany()
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

SYSTEM.Push "recent", "OK"
SYSTEM.Push "bank_code", Trim(GRID0.GetGridCell(GRID0.row, 1))
SYSTEM.Push "bank_name", Trim(GRID0.GetGridCell(GRID0.row, 2))
SYSTEM.Push "bank_acctNum", Trim(GRID0.GetGridCell(GRID0.row, 3))

If Tp.Data ="3" Then
	SYSTEM.Push "bank_Nick", Trim(GRID0.GetGridCell(GRID0.row, 5))
ElseIf Tp.Data ="4" Then
	SYSTEM.Push "bank_Nick", Trim(GRID0.GetGridCell(GRID0.row, 4))
End If

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
SYSTEM.Push "bank_OK", "NO"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SYSTEM.Push "recent", "NO"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


