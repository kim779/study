			tick_gap = 1
		End If

		bungap.Data = bun_gap
		tickgap.Data = tick_gap

		Select Case gubn
		Case 1
			Call Query_Chart(gubn, 0)
		Case 2
			Call Query_Chart(gubn, 0)
		Case 3
			Call Query_Chart(gubn, 0)
		Case 6
			Call Query_Chart(gubn, 0)
		Case 4
			unit = bun_gap
			COMBO0.Data = l_format(unit, "0", 3)
			Call Query_Chart(gubn, unit)
		Case 5
			unit = tick_gap
			COMBO0.Data = l_format(unit, "0", 3)
			Call Query_Chart(gubn, unit)
		Case Else
			Exit Sub
		End Select


	End If
End Sub

}



