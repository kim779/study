Sub reSettingGriddata()
	Dim rowCode, rowName, rowStatus, rowColor, tempCode, tempName, tempStatus, tempColor

	'πËø≠≈©±‚∏∏≈≠ π›∫π(√π¡Ÿ)
	For i = LBound(g_ArrBankCode) To UBound(g_ArrBankCode)
