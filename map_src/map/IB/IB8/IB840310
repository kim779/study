'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	lAppyQty.Clear
	lAppyQty1.Clear

	OverAppyQty.Clear
	lMktcplAppyQty1.Clear

	ANCM.Data = AN1A.Name
	h_acnm.Data = AN1A.Name
	zpwd.Data = AN1A.Password

	If Len(Trim(AN1A.Data)) <> 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	SCREEN.Object("main.obj2").Send

	If Len(Trim(zpwd.Data)) < 4 Then
		zpwd.SetFocus
		Exit Sub
	End If
End Sub

