_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
SCREEN.ClearAll 0, 2
LEDGER.Fkey = "C"
SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"

If SCREEN.GetMapName(1) = "IB850300" Then
	zAcntNo.Data = Trim(SCREEN.Object("parent.AN19").Data)
ElseIf SCREEN.GetMapName(1) = "IB103200" Or SCREEN.GetMapName(1) = "IB103300" Then
	zAcntNo.Data = Trim(SCREEN.Object("main.AN1A").Data)
Else
	zAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)
End If

If Len(Trim(zAcntNo.Data)) <> 11 Then
	MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"

	If SCREEN.GetMapName(1) = "IB850300" Then
		SCREEN.Object("parent.AN19").SetFocus
	ElseIf SCREEN.GetMapName(1) = "IB103200" Or SCREEN.GetMapName(1) = "IB103300" Then
		SCREEN.Object("main.AN1A").SetFocus
	Else
		SCREEN.Object("parent.AN1A").SetFocus
	End If

	Exit Sub
End If

zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

If Len(Trim(zPwd.Data)) < 4 Then
	MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

zLoanDt.Data = Trim(SCREEN.Object("parent.zLoanDt").Data)

Dim jmcd

If SCREEN.GetMapName(1) = "IB103200" Or SCREEN.GetMapName(1) = "IB103300" Then
	jmcd = Trim(SCREEN.Object("parent.zIsuNo").Data)
Else
	jmcd = Trim(SCREEN.Object("parent.1301").Data)
End If

If SCREEN.GetCodeType(jmcd) = "9" Then
	zIsuNo.Data = "J" & jmcd
ElseIf SCREEN.GetCodeType(jmcd) = "27" Then
	zIsuNo.Data = "Q" & jmcd
Else
	zIsuNo.Data = "A" & jmcd
End If

If Len(Trim(zIsuNo.Data)) < 6 Then
	MsgBox "종목번호를 확인하여 주십시오.", , "IBK투자증권"

	If SCREEN.GetMapName(1) = "IB103200" Or SCREEN.GetMapName(1) = "IB103300" Then
		SCREEN.Object("main.1301").SetFocus
	Else
		SCREEN.Object("parent.1301").SetFocus
	End If

	Exit Sub
End If

zLoanDtlClssCode.Data = Trim(SCREEN.Object("parent.zLoanDtlClssCode").Data)
zLoanQty.Data = Trim(SCREEN.Object("parent.lRfundQty").Data)

If Is_numeric(zLoanQty.Data) = False Then
	MsgBox "상환수량을 확인하여 주십시오.", , "IBK투자증권"
	SCREEN.Object("parent.lRfundQty").SetFocus
	Exit Sub
End If

zLoanQty_giho.Data = "+"
zLoanQty.Data = l_zeropad(zLoanQty)
zAbleAmt.Data = "+000000000000000"

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If Trim(zRfundAmt.Data) = "" Then
		zRfundAmt.Data = 0
	End If

	If Trim(zCrdtIntrstAmt.Data) = "" Then
		zCrdtIntrstAmt.Data = 0
	End If

	Dim getMoney, ret
	getMoney = CDbl(zRfundAmt.Data) + CDbl(zCrdtIntrstAmt.Data)

	SCREEN.Proc "parent.obj_getMoney.contributionBnk", getMoney

'	ret = MsgBox(getmoney & "원을 상환하시겠습니까?", vbOKCancel, "IBK투자증권")

'	If ret = 1 Then
'		SCREEN.Proc "parent.obj_getMoney.contributionBnk", getMoney
'	Else

'	End If
Else
	MsgBox Trim(LEDGER.Emsg), , "IBK투자증권"
	SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
