_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
	SCREEN.Object("main.GUIDE").Text = ""
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
	SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg
End Sub

Sub setAddressSearch()
	SCREEN.ClearAll 0, 2
	SCREEN.Object("main.GUIDE").Text = ""
	If RADIO0.Checked Then
		QryTp.Data ="1"
		LABEL0.Visible = False
		LABEL2.Visible = False
		LABEL3.Visible = True
		LABEL4.Visible = True
	ElseIf RADIO1.Checked Then
		QryTp.Data = "2"
		LABEL3.Visible = False
		LABEL4.Visible = False
		LABEL0.Visible = True
		LABEL2.Visible = True
	End If
End Sub

Sub Setting_StreetAddress()
	If CHECK0.Checked = False Then
		GRID0.SetColumnVisible 6, True
		GRID0.SetColumnVisible 7, True
		GRID0.SetColumnVisible 4, False
		GRID0.SetColumnVisible 5, False
	Else
		GRID0.SetColumnVisible 6, False
		GRID0.SetColumnVisible 7, False
		GRID0.SetColumnVisible 4, True
		GRID0.SetColumnVisible 5, True
	End If
End Sub

_AW_ONINDECLARE_AW_
