Sub Order()
	' ====================================================
	' 주식종목코드 혹은 채권종목코드 Check
	' ====================================================
	If Trim(zIsuNo.data) <> "" Or Trim(zIsuNo_chae.Data) <> "" Then
		If jusik.Checked = True Then
			' 주식의 경우
			s_zIsuNo.Skip = False
			s_zIsuNo_chae.Skip = True
			zIsuNo_chae.Clear
			s_zIsuNo.Data = "A" & Trim(zIsuNo.Data)
		Else
			' 채권의 경우
			zIsuNo.Clear
			s_zIsuNo.Skip = True
			s_zIsuNo_chae.Skip = False
			s_zIsuNo_chae.Data = zIsuNo_chae.Data
		End If
	Else
		Call alert_msg("청약내역조회 탭에서 내역을 선택해 주세요.")
		If SCREEN.Object("Main.UTAB0").Index = 1 Then
			SCREEN.Proc "Main.obj3.view_highlight", ""
		End If
		Exit Sub
	End If

	' ====================================================
	' 청약 번호 SETTING Check
	' ====================================================
	If Trim(lAppyNo.data) <> "" Then
		slAppyNo.Data = l_zeropad(lAppyNo)
	Else
		Call alert_msg("청약내역조회 탭에서 내역을 선택하거나, 추가납입 원하는 청약번호를 입력해 주세요.")
		lAppyNo.SetFocus
		Exit Sub
	End If
	' ====================================================

	' ====================================================
	' 추가납입금액 입력 SETTING Check
	' ====================================================
	If Trim(lAddPayAmt.Data) = "" Then
		Call alert_msg("추가납입금액을 입력해 주세요.")
		lAddPayAmt.SetFocus()
		Exit Sub
	End If

	If IsNumeric(lAddPayAmt.Data) = False Then
		Call alert_msg("추가납입금액을 입력해 주세요.")
		lAddPayAmt.SetFocus()
		Exit Sub
	End If

	If CDbl(lAddPayAmt.Data) = 0 Then
		Call alert_msg("추가납입금액을 입력해 주세요.")
		lAddPayAmt.SetFocus()
		Exit Sub
	End If


	' 증권예수금 계좌일 경우만 출금가능 금액을 확인하자
	' 은행예수금 계좌는 출금가능금액이 0으로 조회 된다.
	If IsBnkAccnType(AN1A) <> True Then
		' ====================================================
		' 출금가능금액 Check
		' ====================================================
		If Trim(lBfbalAmt.Data) = "" Then
			Call alert_msg("출금가능 금액을 확인해 주세요.")
			send_btn.SetFocus()
			Exit Sub
		End If

		If IsNumeric(lBfbalAmt.Data) = "" Then
			Call alert_msg("출금가능 금액을 확인해 주세요.")
			send_btn.SetFocus()
			Exit Sub
		End If

		If CDbl(lBfbalAmt.Data) = 0 Then
			Call alert_msg("출금가능 금액을 확인해 주세요.")
			send_btn.SetFocus()
			Exit Sub
		End If

		' ====================================================
		' 추가납입금액 입력 SETTING Check 2
		' ====================================================
		' 추가납입금액 : lAddPayAmt.data
		' 출금가능금액 : lBfbalAmt.Data
		If CDbl(lAddPayAmt.data) > CDbl(lBfbalAmt.Data) Then
			Call alert_msg("출금가능금액이 부족합니다. 추가납입금액을 확인해 주세요.")
			send_btn.SetFocus()
			Exit Sub
		End If
	End If

	' ====================================================
	' 주문확인창
	' ====================================================
	dmsg = "o_acno" & vbTab & AN1A.Data & vbLf &_
	       "o_acnm" & vbTab & ANCM.Data & vbLf &_
	       "o_hnam" & vbTab & Trim(hnam.Text) & vbLf &_
	       "o_jqty" & vbTab & lAppyNo.Data & vbLf &_
	   	   "o_jprc" & vbTab & lAddPayAmt.Data & vbLf

	SCREEN.CreateWindow 2, "IB84028A /p5 /d", dmsg

	If SYSTEM.Pop("kongmo_add_order") <> "OK" Then
		Exit Sub
	Else
		If IsBnkAccnType(AN1A) = True Then
			SCREEN.Proc "obj_getMoney.contributionBnk", Trim(lAddPayAmt.Data)
		Else
			Call send_o()
		End If
	End If
End Sub

Sub Set_focus()
	If Len(Trim(AN1A.Data)) < 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If Len(Trim(zpwd.Data)) < 4 Then
		zpwd.SetFocus
		Exit Sub
	End If

	If Len(Trim(lAppyNo.Data)) < 1 Then
		lAppyNo.SetFocus
		Exit Sub
	End If

	lAddPayAmt.SetFocus
End Sub


' 계좌 비밀번호 검증
Function l_pswdConfirm(accn, pswd, msg)
	Dim ret, sdata

	l_pswdConfirm = False

	If SYSTEM.ConnectBy = "0" Then
		If Len(Trim(accn)) <> 11 Then
			msg = "계좌번호를 확인하여 주십시오."
			MsgBox msg, , "IBK투자증권"
			Exit Function
		End If

		If Len(Trim(pswd)) > 8 Or Len(Trim(pswd)) < 4 Then
			msg = "비밀번호를 확인하여 주십시오."
			MsgBox msg, , "IBK투자증권"
			Exit Function
		End If
		msg = ""

		sdata = accn&pswd
		ret = SCREEN.ServiceEx("pibopswd", accn&pswd, Len(sdata), 0, 600000)
		If Left(ret,1) <> "1" Then
			msg = Mid(ret,2,99)
			If Trim(msg) = "" Then
				msg = "대기 시간 초과입니다. 결과를 꼭 확인 바랍니다."
			End If

			If InStr(msg, "3669") > 0 Then
				MsgBox msg, , "IBK투자증권"
			End If

			SCREEN.Object("Main.GUIDE").Text = Trim(msg)
			Exit Function
		End If
	End If

	l_pswdConfirm = True
End Function

