_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Function Find_Row(acc_no, mtp,code)


	For row = 1 To GRID0.Rows
		If Trim(acc_no) = Trim(GRID0.GetGridCell (row, 2)) _
				And Trim(mtp) = Trim(GRID0.GetGridCell (row, 4)) _
				And Trim(code) = Trim(GRID0.GetGridCell (row, 6)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

_AW_ONSEND_AW_
SCREEN.OnSend = False
LEDGER.Fkey = "5"
grp_no.Data = SCREEN.Object("parent.grp_no").data
grp_name.Data = SCREEN.Object("parent.grp_name").data
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, jj, Ordqty, chgqty


SYSTEM.Push "ChangeLawGroup", "1"
MsgBox GUIDE.Text
If LEDGER.Ecod = "0147" Then

	SCREEN.Object("parent.Grid0").Clear
	SCREEN.Proc "main.send_f", ""

	If req_gb.Data = "I" Then
		SCREEN.Object("parent.grp_no").data = grp_no.Data
		SCREEN.Object("parent.grp_name").data = grp_name.Data
		GRID0.Clear
		'SCREEN.Object("parent.obj_query").Send
	ElseIf req_gb.Data = "U" Then
		SCREEN.Object("parent.grp_no").data = grp_no.Data
		SCREEN.Object("parent.grp_name").data = grp_name.Data
		SCREEN.Object("parent.obj_query").Send
	Else
		SCREEN.Object("parent.grp_no").data = ""
		SCREEN.Object("parent.grp_name").data = ""
		SCREEN.Object("parent.obj_query.Grid0").Clear
	End If
End If
SCREEN.Object("main.Guide").Text = GUIDE.Text

