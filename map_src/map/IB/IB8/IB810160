RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'--계좌번호, 계좌명 세팅
Sub acct_set()
	Dim account, acct1, acct2
	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text

	account = Replace(CMB_ACCT.Text, "-", "")
	zAcntNo.Data = account

	acct1 = Mid(zAcntNo.data,1,3)
	acct2 = Mid(zAcntNo.data, 6, 6)

	totacnt.Data  = acct1 & "00" & acct2

	zPwd.Clear
	lMnyrclOdpntRepayAmt.Clear
	SCREEN.Object("main.guide").text = ""
	zBncertSellIsuNo.Clear
	zBncertSellIsuSeqno.Clear
End Sub

'--펀드계좌 여부 체크
Sub fund_chk()
	If Mid(CMB_ACCT.text, 5,2) = "53" Then
		CMB_ACCT2.Visible = False
		CMB_MY.Visible = True

		OBJ_set.SetObject "IB810113"
	Else
		CMB_MY.Visible = False
		CMB_ACCT2.Visible = True

		OBJ_set.SetObject "IB810114"
	End If
End Sub

'--은행개설계좌 여부 체크
Sub bank_chk()
	If Left(CMB_ACCT.text, 1) = "7" Then	'은행개설계좌일 경우
		bchk.Text = "1"
		F2.Enable = False
		EDIT_ACCT.Visible = False
		CMB_ACCT2.Visible = True

		Call OTP_chk()
	Else
		bchk.Text = "0"					'영업점개설계좌인 경우
		If F1.Checked = True Then
			OBJ_sec2.Visible = False
			OBJ_otp2.Visible = False
			OBJ_bank.Visible = False
		Else								'미약정계좌일 경우
			Call OTP_chk()
		End If
	End If
End Sub

'--출금가능금액조회
Sub AMT_send()
	SCREEN.Object("OBJ1.zIntaccNo").DATA = totacnt.Data
	SCREEN.Object("OBJ1.zPwd").DATA = SCREEN.Object("OBJ_set.zPwd").Data
	SCREEN.Object("OBJ1.EDIT_act").DATA = zAcntNo.Data
	OBJ1.Send
End Sub

Sub F1_chk()	'--약정계좌 셋팅
	OBJ_set2.SetObject "IB810125"
	CMB_ACCT2.Visible = True
	CMB_MY.Visible = False
	PAN_ACT.Visible = False
	PAN_F1.Visible = True
	PAN_F2.Visible = False
	EDIT_ACCT.Visible = False
	OBJ_yact.Send

	If gubn.text = "1" Then
		OBJ_sec2.Visible = True
	ElseIf gubn.text = "3" Then
		OBJ_otp2.Visible = True
	Else
		OBJ_bank.Visible = True
	End If

End Sub

Sub F2_chk()		'--미약정계좌 셋팅
	OBJ_set2.SetObject "IB810126"
	EDIT_ACCT.Clear
	CMB_ACCT2.Visible = False
	CMB_MY.Visible = True
	PAN_ACT.Visible = True
	PAN_F1.Visible = False
	PAN_F2.Visible = True
	EDIT_ACCT.Visible = True

	OBJ_bank.Visible = False

	If gubn.text  = "1" Then
		OBJ_sec2.Visible = True
	ElseIf gubn.text = "3" Then
	 	OBJ_otp1.Send
	 	OBJ_otp2.Visible = True
	End If

	EDIT_ACCT.Setfocus
End Sub

Sub Input_set()
	If F1.Checked = True Then
		bank_code.Data = Left(Trim(CMB_ACCT2.text), 3)
		bank_acct.Data = Right(Trim(CMB_ACCT2.text), 11)
	Else
		bank_code.Data = Trim(CMB_MY.Data)
		bank_acct.Data = Trim(EDIT_ACCT.DATA)
	End If
End Sub

Sub OBJ_SEND()
	If gubn.Text = "1" Then
		OBJ_sec2.Send
	ElseIf gubn.Text = "3" Then
	 	OBJ_otp2.Send
	ElseIf F1.Checked = True And gubn.Text <> "1" And gubn.Text <> "3" Then
		OBJ_bank.Send
	End If
End Sub

Sub OTP_chk()
	If gubn.text = "1" Then
		OBJ_sec2.Visible = True
		OBJ_otp2.Visible = False
		OBJ_bank.Visible = False
	ElseIf gubn.text = "3" Then
		OBJ_sec2.Visible = False
		OBJ_bank.Visible = False
		OBJ_otp1.Send
		OBJ_otp2.Visible = True
	Else
		OBJ_sec2.Visible = False
		OBJ_otp2.Visible = False
		OBJ_bank.Visible = True
	End If
End Sub

Sub Clear()
	SCREEN.Object("OBJ_set.zPwd").Clear
	SCREEN.Object("OBJ_set.lMnyrclOdpntRepayAmt").Clear
	SCREEN.Object("main.guide").text = ""
	SCREEN.Object("OBJ_set.zBncertSellIsuNo").Clear
	SCREEN.Object("OBJ_set.zBncertSellIsuSeqno").Clear
	ERR_1.Clear
	ERR_2.Clear
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Input_set()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(CMB_ACCT)
_AW_ONCHANGE_AW_
If Trim(SCREEN.Object("OBJ_set.zPwd").Data) <> "" Then
	Call bank_chk()
End If

Call acct_set()
Call fund_chk()
If F1.Checked = True Then
	Call F1_chk()
Else
	Call F2_chk()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTNSEND)
_AW_ONCLICK_AW_
Call Input_set()
Call OBJ_SEND()
BANK_SEND.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(F1)
_AW_ONCLICK_AW_
Call F1_chk()
Call Input_set()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(F2)
_AW_ONCLICK_AW_
Call F2_chk()
Call Input_set()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call OBJ_SEND()
STOCK_SEND.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(EDIT_PWD)
_AW_ONCHANGE_AW_
If Len(Trim(EDIT_ACCT.Data)) = 12 Then
	If Left(EDIT_ACCT.Data , 1) = "7" Then
		OBJ_bank.Visible = True
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB140200 /t/d/p5/S", _
				"AN1A" & vbTab & SCREEN.Object("OBJ1.CMB_ACCT").data
