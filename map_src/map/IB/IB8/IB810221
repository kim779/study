RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub


'지점 검색
Sub Find_branch()
	Dim ii, pos, jj
	pos = 0
	GRID1.Clear
	jj=1
	For ii=1 To SCREEN.Object("OBJ1.GRID0").Rows
		pos = InStr(UCase(Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii, 2))), UCase(Trim(search_bran.data)))

		If pos > 0 Then

			GRID1.InsertRow -1

			GRID1.SetGridCell jj, 1, Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii,1))
			GRID1.SetGridCell jj, 2, Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii,2))
			GRID1.SetGridCell jj, 3, Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii,3))
			GRID1.SetGridCell jj, 4, Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii,4))

			jj = jj + 1
'			SCREEN.Object("OBJ1.GRID0").Index = ii - 1
'			indx.Data = ii + 1
'			SCREEN.Object("OBJ1.GRID0").Setfocus

'			JNUM.Text = Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii, 1))
'			JNAME.Text = Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii, 2))
'			Exit Sub
		End If
	Next
	If jj = 1 Then
		alert_msg("찾으시는 지점이 없습니다")
	End If
End Sub

Sub branchSend(grdPos)
	KNUM.Text = Trim(GRID0.GetGridCell(grdPos, 1))
	KNAME.Text = Trim(GRID0.GetGridCell(grdPos, 3))
	SYSTEM.Push "KNAME", KNAME.text

	If Trim(KNUM.text) <> "" Then
		SCREEN.Proc "OBJ1.send_f", ""
	End If
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SYSTEM.Push "companyNo_8102", "NO"
SYSTEM.Push "companyNm_8102", "NO"
SYSTEM.Push "branchNo_8102", "NO"
SYSTEM.Push "branchNm_8102", "NO"

GUIDE.Text = "회사명 검색을 사용하여 주십시오."
Search_com.SetFocus

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0162"
GUIDE.Text = ""

SCREEN.OnSend = False

zIn.Data = "00001"

If Trim(Search_com.Data) = "" Then
	Call alert_msg("입고하실 증권사를 검색하여 주십시오.")
	Search_com.SetFocus
	Exit Sub
End If

Search_com.Data = UCase(Search_com.Data)

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		If GRID0.Rows > 0 Then
			Call branchSend(1)
		End If
	End If
Else
	If ecod <> "2679" Then
		Call alert_msg(Trim(LEDGER.Emsg))
	Else
		Call GUIDE_msg(Trim(LEDGER.Emsg))
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(Search_com)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
SYSTEM.Push "KNUM", "NO"
SYSTEM.Push "JNUM", "NO"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
If Trim(KNUM.Text) = "" Then
	Call alert_msg("입고증권사를 선택하여 주십시오.")
	Search_com.SetFocus
	Exit Sub
End If

SYSTEM.Push "companyNo_8102", Trim(KNUM.Text)
SYSTEM.Push "companyNm_8102", Trim(KNAME.Text)
SYSTEM.Push "branchNo_8102", Trim(JNUM.Text)
SYSTEM.Push "branchNm_8102", Trim(JNAME.Text)

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(search_bran)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call Find_branch()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
Call Find_branch()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = "3" Then
	GRID1.Clear
	Call branchSend(GRID0.Row)
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
JNUM.Text = Trim(GRID1.GetGridCell(GRID1.row, 1))
JNAME.Text = Trim(GRID1.GetGridCell(GRID1.row, 2))

'--
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



