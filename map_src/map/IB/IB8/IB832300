_AW_ONDECLARE_AW_
Sub chkpwd()
	If Len(Trim(ed_pswd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 입력하시기 바랍니다."
		Exit Sub
	End If
	If chkpwdyn.Data = "N" Then
		SCREEN.Object("obj_chkPW.IntaccNo").data = Trim(AN1C.Data)
		SCREEN.Object("obj_chkPW.Pwd").data = Trim(ed_pswd.Data)
		SCREEN.Object("obj_chkPW.chk").data = "1"
		obj_chkPW.Send
	Else
		Call send_f()
	End If
End Sub

Sub AllSell()
	chkpwdyn.Data = "Y"
	csinfo.Send
End Sub

Sub Set_account()
	chkpwdyn.Data = "N"
	r1.Checked = False
	r2.Checked = False
	r1.Enable = False
	r2.Enable = False
	mobilenum.Data = ""
	homenum.Data = ""
	ACNM.Data = AN1C.name
	ed_pswd.Data = AN1C.Password
	GUIDE.Text = ""
End Sub

Sub send_f()
	r1.Checked = False
	r2.Checked = False
	gubn.Data = "Q"
	SCREEN.Send 0
End Sub

Sub save_f()
	gubn.Data = "I"
	If chkpwdyn.Data = "N" Then
		GUIDE.Text = "조회후 등록/변경 하세요"
		Exit Sub
	End If
	If r1.Enable = False And r2.Enable = False Then
		GUIDE.Text = "등록가능한 전화번호가 없습니다."
		Exit Sub
	End If
	If r1.Checked = False And r2.Checked = False Then
		GUIDE.Text = "등록할 전화번호를 선택하세요."
		Exit Sub
	End If
	SCREEN.Send 0
End Sub

Sub del_f()
	gubn.Data = "D"
	If chkpwdyn.Data = "N" Then
		GUIDE.Text = "조회후 해지 하세요"
		Exit Sub
	End If
	If r1.Enable = False And r2.Enable = False Then
		GUIDE.Text = "해지가능한 전화번호가 없습니다."
		Exit Sub
	End If
	If r1.Checked = False And r2.Checked = False Then
		GUIDE.Text = "해지할 전화번호를 선택하세요."
		Exit Sub
	End If
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
juno.Data = LOGIN.juno
clntname.Data = LOGIN.Name

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
acno.Data = AN1C.Data
If r1.Checked Then
	telgb.Data = "0"
	telno.Data = Trim(Replace(mobilenum.Data, "-", ""))
Else
	telgb.Data = "1"
	telno.Data = Trim(Replace(homenum.Data, "-", ""))
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim telnum

GUIDE.Text = o_msg.Data

If CLng(o_reccnt.Data) > 0 Then
	telnum = Replace(o_telno.Data, " ", "")
	Set re = New RegExp
	re.Global = True
	re.IgnoreCase = True
	re.MultiLine = True
	re.Pattern = "(0(?:2|[0-9]{2}))([0-9]+)([0-9]{4}$)"
	If o_telgb.Data = "0" Then
		r1.Checked = True
		mobilenum.Data = re.Replace(telnum,"$1-$2-$3")
	ElseIf o_telgb.Data = "1" Then
		r2.Checked = True
		homenum.Data = re.Replace(telnum,"$1-$2-$3")
	End If
End If

