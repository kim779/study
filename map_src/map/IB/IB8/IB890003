RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub SetAlert()
	Dim IsBool

	If Trim(gubn.Data) = "lessRisk" Then
		LABEL40.Text = "공격투자형 이상이어야 파생상품 거래가 가능합니다."
		LABEL41.Text = "투자자정보 확인서를 변경하시겠습니까?"

		IsBool = True
	Else
		LABEL40.Text = "거래경험 조건 미충족시 거래경험을 변경하시거나"
		LABEL41.Text = "부적합 금융투자상품(파생상품등) 거래확인서를 " & "제출하셔야 거래가 가능합니다."

		IsBool = False
	End If

	BUTTON0.Visible = IsBool
	BUTTON1.Visible = IsBool
	BUTTON2.Visible = Not IsBool
	BUTTON3.Visible = Not IsBool
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call SetAlert()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If Trim(OUTPUT20.Data) <> "" Then
		'최종고객성향
		If Trim(OUTPUT20.Data) <> "공격투자형" Then
			Call SetAlert("lessRisk")
			Exit Sub
		End If
	Else
		'정보제공구분
		If Trim(OUTPUT8.Data) = "0" Then
			Call SetAlert("lessRisk") '미제공
		Else
			Call SetAlert("lessRisk") '미등록
		End If

		Exit Sub
	End If

	Dim age
	age = CLng(Year(Now)) - CLng(Left(OUTPUT0.Data, 4)) + 1

	If age < 65 Then
		If CLng(OUTPUT24.Data) < 12 Then
			Call SetAlert("lessExpi")
			Exit Sub
		End If
	Else
		If CLng(OUTPUT24.Data) < 36 Then
			Call SetAlert("lessExpi")
			Exit Sub
		End If
	End If
ElseIf Trim(LEDGER.Ecod) = "3167" Then
	Call SetAlert("lessRisk") '미제공
ElseIf Trim(LEDGER.Ecod) = "3956" Then
	Call SetAlert("lessRisk") '미등록"
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
