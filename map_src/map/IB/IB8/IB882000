Sub MainHistory(str)
	Dim xcode, spos, ii, jump
	xcode = str
	jump = 0
	spos = InStr(xcode, "(")
	If (spos=0) And (Len(xcode)=6) Then

	ElseIf (Len(xcode)<6) Then
		Exit Sub
	Else
		xcode = Mid(xcode,spos+1,Len(xcode)-spos-1)
	End If

	find = False
	For ii=1 To 8
		If xcode = SCREEN.Object("BCODE"+CStr(ii)).Text Then
			find = True
			Exit For
		End If
	Next
	If Not find Then
		BUTTON8.Text = BUTTON7.Text
		BUTTON7.Text = BUTTON6.Text
		BUTTON6.Text = BUTTON5.Text
		BUTTON5.Text = BUTTON4.Text
		BUTTON4.Text = BUTTON3.Text
		BUTTON3.Text = BUTTON2.Text
		BUTTON2.Text = BUTTON1.Text
		BUTTON1.Text = SCREEN.GetName(100, xcode, 0)

		BCODE8.Text = BCODE7.Text
		BCODE7.Text = BCODE6.Text
		BCODE6.Text = BCODE5.Text
		BCODE5.Text = BCODE4.Text
		BCODE4.Text = BCODE3.Text
		BCODE3.Text = BCODE2.Text
		BCODE2.Text = BCODE1.Text
		BCODE1.Text = xcode
	End If
	'send_sise_all("main")
End Sub

Sub ReadQtyConfig
	Dim data, array, j, i
	If SCREEN.CreateObject("Info") Then
		data = Trim(INFO.PopData(LOGIN.Name, "ordcfg.ini", "IB882000", "812_QtyConfig"))
	End If
	If Trim(data) = "" Then
		data = "10|100|1000|10000"
	End If
	array = Split(data, "|", -1, 1)

	j=0
	For Each i in array
	 j = j+1

	 If Trim(array(j-1)) <> "" Then
	 	SCREEN.Object("main.Qty"&CStr(j)).Text = CStr(CLng(array(j-1)))
	 End If
	Next
End Sub

