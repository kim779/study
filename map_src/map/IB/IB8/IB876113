RESOURCE DIVISION
{


_AW_ONSTART_AW_
    Dim diff
    Dim yy, mm, dd, cday, MyWeek

    Dim sagonal

    ''''''''''''''''''''''
    '이후 장애 발생시 아래 변수 sagonal 만 수정해주면 됨
    '수정시에는 반드시 YYYY-MM-DD 양식으로 변경해줘야함!
    '2021-11-03 피코그램 상장 장애발생
    '2024-06-24 한중엔시에스 상장 장애발생
    sagonal = "2024-06-24"
    ''''''''''''''''''''''''
    ''''절대장애발생금지''''
    ''''''''''''''''''''''''
    ''''''''''''''''''''''''

	cday = DateAdd("d", 0, Date) '오늘날짜
	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)

	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&"-"&mm&"-"&dd
    SYSTEM.Trace "cday:"&CStr(cday)

    '사고날부터 일자 계산
    diff = DateDiff("d", CStr(sagonal), CStr(cday))

    SYSTEM.Trace "diff:"&diff


    data1.Text = CStr(diff)
    data2.Text = "("&Mid(sagonal,1, 4)&"/"&Mid(sagonal,6, 2)&"/"&Mid(sagonal,9, 2)&"~)"

_AW_ONENDSUB_AW_
}



