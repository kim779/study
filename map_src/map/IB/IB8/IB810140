RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	GRID0.SetDataPosition 0
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False
LEDGER.Rcnt = "0012"

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("main.OBJ1.CMB_ACCT").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("main.OBJ1.CMB_ACCT").SetFocus
	Exit Sub
End If

If SCREEN.Object("main.UTAB0").ID <> "4" Then
	If SYSTEM.ConnectBy = "0" And Trim(SCREEN.Object("main.OBJ1.zPwd").Data) = "" Then
		zPwd.Data = "9999"
	Else
		zPwd.Data = SCREEN.Object("main.OBJ1.zPwd").Data
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		Call alert_msg("비밀번호를 확인하여 주십시오.")
		SCREEN.Object("main.OBJ1.zPwd").SetFocus
		Exit Sub
	End If
Else
	zPwd.Data = "9999"
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zStrDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zEndDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


