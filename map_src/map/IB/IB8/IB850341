If SYSTEM.ConnectBy = "0" And Trim(SCREEN.Object("main.obj0.zPwd").Data) = "" Then
	zPwd.Data = "9999"
End If

If Len(Trim(AN19.Data)) <> 11 Then
	MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"
	SCREEN.Object("main.obj0.AN19").SetFocus
	Exit Sub
End If

