_AW_ONDECLARE_AW_
Sub fullpass_send()
  SYSTEM.Push "madoRdmtnApplication", "OK"
  SCREEN.CloseWindow
End Sub

_AW_ONSTART_AW_
SYSTEM.Push "madoRdmtnApplication", "NO"

SYSTEM.Trace "o_acno:"&o_acno.Data
SYSTEM.Trace "o_acnm:"&o_acnm.Data
SYSTEM.Trace "o_jskm:"&o_jskm.Data
SYSTEM.Trace "o_kskm:"&o_kskm.Data

Dim data1, data2
data1 = o_jskm.Data
data2 = o_kskm.Data

acntno.Data      = Mid(Trim(o_acno.Data), 1, 3) + "-" + Mid(Trim(o_acno.Data), 4, 2) + "-" + Mid(Trim(o_acno.Data), 6, 6) + "  " + Trim(o_acnm.Data)
pastdayloan.Data = Trim(o_jskm.Data) + "원"
todayloan.Data   = Trim(o_kskm.Data) + "원"

If Len(Trim(o_jskm.Data)) = 0 Then
    data1 =0
    SYSTEM.Trace "data1="&data1
End If

If Len(Trim(o_kskm.Data)) = 0 Then
    data2 =0
    SYSTEM.Trace "data2="&data2
End If


sum.Data         = Trim(CLng(data1) + CLng(data2)) + "원"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(B_CANCEL)
_AW_ONCLICK_AW_
SYSTEM.Push "madoRdmtnApplication", "NO"

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(B_OK)
_AW_ONCLICK_AW_
obj0.proc "certsend" ,""
_AW_ONENDSUB_AW_
