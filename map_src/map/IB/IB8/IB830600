_AW_ONDECLARE_AW_
'--계좌번호, 계좌명 세팅
Sub acct_set()
	Dim account
	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text

	account = Replace(CMB_ACCT.Text, "-", "")
	zAcntno.Data = account
End Sub

Sub Query()
	LEDGER.Fkey = "C"
	zTrxTp.Data = "1"
	I_lOnceLmtAmt.Data = "+000000000000000"
	I_lDailyLmtAmt.Data = "+000000000000000"
	SCREEN.Send 0


End Sub

Sub Send()
	LEDGER.Fkey = "5"
	zTrxTp.Data = "3"
	I_lOnceLmtAmt.Data = "+" & l_zeropad(Once)
	I_lDailyLmtAmt.Data = "+" & l_zeropad(Daily)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
OBJ_acct.Send

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(zTrxTp.data) = 1 Then
	Once.Data = lOnceLmtAmt.Data
	Daily.Data = lDailyLmtAmt.Data
	O_Once.Clear
	O_Daily.Clear
	lOnceLmtAmt.Clear
	lDailyLmtAmt.Clear
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call Query()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BtnSend)
_AW_ONCLICK_AW_
Call Send()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CMB_ACCT)
_AW_ONCHANGE_AW_
Call acct_set()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(PANEL3)
_AW_ONCLICK_AW_
MsgBox PAN_pwd.Top &"_"& PAN_pwd.Bottom
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BtnQuery)
