RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim flag_date
flag_date = "N"

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub chkDate()
	Dim srtDt, EndDt, betDate, DateSel, Today
	srtDt = Trim(SCREEN.Object("parent.zSrtDt").Data)
	EndDt = Trim(SCREEN.Object("parent.zEndDt").Data)
	DateSel = Trim(SCREEN.Object("parent.dateSel").Text)
	Today = getCurrDay()

	If CLng(srtDt) > CLng(Today) Or CLng(EndDt) > CLng(Today) Then
		flag_date = "over"
		srtDt = change_indate("d", -14, getDateSerial(Today))
		EndDt = Today

		SCREEN.Object("parent.zSrtDt").Data = srtDt
		SCREEN.Object("parent.zEndDt").Data = EndDt
	Else
		If CLng(srtDt) > CLng(EndDt) Then
			flag_date = "srtOver"
			srtDt = change_indate("d", -14, getDateSerial(EndDt))
			SCREEN.Object("parent.zSrtDt").Data = srtDt
		End If
		
		If DateSel = "1" Then
			betDate = change_indate("m", 3, Trim(SCREEN.Object("parent.zSrtDt").Text))

			If CLng(EndDt) > CLng(betDate) Then
				flag_date = "3months"
				EndDt = betDate
				SCREEN.Object("parent.zEndDt").Data = EndDt
			End If
		Else
			betDate = change_indate("m", -3, Trim(SCREEN.Object("parent.zEndDt").Text))

			If CLng(srtDt) < CLng(betDate) Then
				flag_date = "Y"
				srtDt = betDate
				SCREEN.Object("parent.zSrtDt").Data = srtDt
			End If
		End If
	End If

	zSrtDt.Data = srtDt
	zEndDt.Data = EndDt
End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0020"

SCREEN.OnSend = False

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.CMB_ACCT").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.CMB_ACCT").SetFocus
	Exit Sub
End If

zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

If Len(Trim(zPwd.Data)) < 4 Then
	Call alert_msg("계좌비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

Call chkDate()

zQryTp.Data = Trim(SCREEN.Object("parent.zQryTp").Data)
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If ecod= "3669" Then
	SCREEN.ClearAll 0, 2
	zPwd.SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" And ecod <> "0136" Then
	Call send_c()
Else
	If flag_date = "3months" Then
		Call alert_msg("결제일의 조회기간은 최대 3개월까지 조회 가능합니다.")
	ElseIf flag_date = "srtOver" Then
		Call alert_msg("결제일의 시작일이 종료일보다 이후입니다.")
	ElseIf flag_date = "over" Then
		Call alert_msg("조회일이 오늘보다 이후입니다.")
	End If
	
	flag_date = "N"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zSrtDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zEndDt)
_AW_ENDSCRIPT_AW_


}



