_AW_ONDECLARE_AW_
'그리드 클릭시 데이터 전달
Sub click_grid()
		Dim	jongmok_code, base_date

		'종목번호
		jongmok_code = Trim(GRID0.GetGridCell(GRID0.Row, 3))
		'기준일
		base_date = GRID0.GetGridCell(GRID0.Row, 1)

		SCREEN.proc "Main.setOrder", jongmok_code&","&base_date

		SCREEN.Object("main.OBJECT0.send_btn").Enable = True

End Sub

Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
'next_btn.enable = False

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 1,2
End If

If LEDGER.Next = "Y" Then
'	next_btn.Enable = True
	'LEDGER.Fkey = "7"
	'GRID0.SetDataPosition(2)
	'SCREEN.Send 0
	Call send_c()
End If

If Trim(SCREEN.object("main.OBJECT0.zpwd").Data) = "" Then
	SCREEN.object("main.OBJECT0.zpwd").SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zRgptnCode)
_AW_ONCHANGE_AW_
SCREEN.send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	'트리거 날리기
	S1301.DATA = Trim(GRID0.GetGridCell(GRID0.Row, 3))

	If S1301.DATA = "" Then
		Exit Sub
	End If


	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
If GRID0.HitPos = 3 Then
	Call click_grid()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


