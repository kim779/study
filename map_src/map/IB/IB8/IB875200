RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim MYFILE, MYMAP
Dim cmbstr, bgarray, cellattr
bgarray = Array(33023,65535,65280)
MYFILE = "userconf.ini"
MYMAP = SCREEN.GetMapName(0)
cellattr = Array("","","")

Sub popwindow()
	SCREEN.CreateWindow 2, "IB875191 /p?", ""
End Sub

Sub Setdate()
	Dim Day1, Day2, mm, dd
	Day2 = getDateSerial(edate.Data)
	Day1 = DateAdd("m", -12, Day2)

	If Month(Day1) < 10 Then
		mm = "0" & Month(Day1)
	Else
		mm = Month(Day1)
	End If

	If Day(Day1) < 10 Then
		dd = "0" & Day(Day1)
	Else
		dd = Day(Day1)
	End If

	SCREEN.IgnoreChange True
	sdate.data = Year(Day1) & mm & dd
	SCREEN.IgnoreChange False
End Sub
Sub p_write_ini()
	Dim var1, var2, var3
	If SCREEN.CreateObject("INFO") Then
		For ii=1 To 3
			var1 = Trim(SCREEN.Object("cell"&ii&"1").Data)
			var2 = Trim(SCREEN.Object("cell"&ii&"2").Data)
			If Len(var1) > 0 And Len(var2) > 0 Then
				If CDbl(var1) > CDbl(var2) Then
					var3 = var1
					var1 = var2
					var2 = var3
				End If
				If CDbl(var1) >= -1 And CDbl(var2) <= 1 Then
					INFO.PushData LOGIN.Name, MYFILE, MYMAP, "CELL"&ii&"1", var1
					INFO.PushData LOGIN.Name, MYFILE, MYMAP, "CELL"&ii&"2", var2
				Else
					INFO.PushData LOGIN.Name, MYFILE, MYMAP, "CELL"&ii&"1", ""
					INFO.PushData LOGIN.Name, MYFILE, MYMAP, "CELL"&ii&"2", ""
				End If
			Else
				INFO.PushData LOGIN.Name, MYFILE, MYMAP, "CELL"&ii&"1", ""
				INFO.PushData LOGIN.Name, MYFILE, MYMAP, "CELL"&ii&"2", ""
			End If
		Next
	End If
End Sub

Sub p_read_ini()
	Dim var1, var2, var3
	If SCREEN.CreateObject("INFO") Then
		For ii=1 To 3
			var1 = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "CELL"&ii&"1"))
			var2 = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "CELL"&ii&"2"))
			SCREEN.IgnoreChange True
			cellattr(ii-1) = Array(var1, var2)
			SCREEN.IgnoreChange False
		Next
		If cellattr(0)(0) = "" And cellattr(1)(0) = "" And cellattr(2)(0) = "" Then
			cell11.Data = "0.00"
			cell12.Data = "0.20"
			cell21.Data = "0.40"
			cell22.Data = "0.60"
			cell31.Data = "0.60"
			cell32.Data = "1.00"
		Else
			For ii=1 To 3
				If Len(cellattr(ii-1)(0)) > 0 And Len(cellattr(ii-1)(1)) > 0 Then
					If CDbl(cellattr(ii-1)(0)) > CDbl(cellattr(ii-1)(1)) Then
						var3 = cellattr(ii-1)(0)
						cellattr(ii-1)(0) = cellattr(ii-1)(1)
						cellattr(ii-1)(1) = var3
					End If
					If CDbl(cellattr(ii-1)(0)) >= -1 And CDbl(cellattr(ii-1)(1)) <= 1 Then
						SCREEN.Object("cell"&ii&"1").Data = cellattr(ii-1)(0)
						SCREEN.Object("cell"&ii&"2").Data = cellattr(ii-1)(1)
					End If
				End If
			Next
		End If
	End If
End Sub

Sub chkrange()
	Dim Day1, Day2, mm, dd

	GUIDE.Text = ""

	Day2 = CDate(edate.Text)
	Day1 = DateAdd("yyyy", -3, Day2)

	If Month(Day1) < 10 Then
		mm = "0" & Month(Day1)
	Else
		mm = Month(Day1)
	End If

	If Day(Day1) < 10 Then
		dd = "0" & Day(Day1)
	Else
		dd = Day(Day1)
	End If

	'sdate.Data = Year(Day1) & mm & dd
	If CLng(Year(Day1) & mm & dd) > CLng(sdate.Data) Then
		GUIDE.Text = "조회기간은 최대 3년입니다."
		sdate.Data = Year(Day1) & mm & dd
	End If
End Sub

Sub getcorr()
	Dim ret
	GUIDE.Text = ""
	ret = ELSGrid.IsLoading
	If ret <> "False" Then
		'MsgBox "조회가 완료되지 않았습니다.", , "IBK투자증권"
		'popwindow()
		GUIDE.Text = "조회가 완료되지 않았습니다."
		Exit Sub
	Else
		clscolor()
		setcolor()
		ELSGrid.Send date.Data, gign.Data
	End If
End Sub

Sub clscolor()
	Call ELSGrid.SetRangeColor(0, -1.0, 1.0, 16777215)
	Call ELSGrid.SetRangeColor(1, -1.0, 1.0, 16777215)
	Call ELSGrid.SetRangeColor(2, -1.0, 1.0, 16777215)
End Sub

Sub Setcolor()
	Dim ii, jj, vala, valb, valc, ret
	jj=0
	For ii=1 To 3
		vala = Trim(SCREEN.Object("cell"&ii&"1").Data)
		valb = Trim(SCREEN.Object("cell"&ii&"2").Data)
		If Len(vala) <> 0 And Len(valb) <> 0 Then
			If CDbl(vala) > CDbl(valb) Then
				valc = vala
				vala = valb
				valb = valc
			End If
		 	If CDbl(vala) >= -1.0 And CDbl(valb) =< 1.0 Then
		 		'If chkrange(ii-1) = 1 Then
					ret = ELSGrid.SetRangeColor(jj, vala, valb, bgarray(ii-1))
					jj = jj+1
'					SYSTEM.Trace "vala="&vala&" valb="&valb
				'End If
			End If
		End If
	Next
End Sub

Sub send_chart()
	OBJ11.Send
	OBJ12.Send
	OBJ13.Send
	OBJ14.Send
End Sub

Sub makejcomb()
	Dim grid, ii, item, item2, txt
	Dim cdtp, cod2, name

	item = ""
	item2 = ""
	cmbstr = ""
	Set grid = SCREEN.Object("OBJ90.GRID0")
	For ii=1 To grid.Rows
		cdtp = grid.GetGridCell(ii, 1)
		cod2 = grid.GetGridCell(ii, 2)
		name = Trim(grid.GetGridCell(ii, 3))
		If name = "" Then
			Exit For
		End If
		txt = cdtp&cod2&name
		item = item & txt & vbTab
		item2 = item2 & txt & vbTab
		cmbstr = cmbstr & txt & vbTab
		If ii = 1 Then
			item = cdtp&cod2&vbTab&item
		End If
		If ii = 2 Then
			item2 = cdtp&cod2&vbTab&item2
		End If
	Next
	jcod1.SetItems item
	jcod2.SetItems item2

	send_chart
End Sub

Function mkspace(param)
	Dim ii, stmp
	stmp = Trim(param)
	For ii=Len(stmp)+1 To 17
		stmp = stmp & " "
	Next
	mkspace = stmp
End Function

