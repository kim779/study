Function P_pswdConfirm(accn, pswd, msg)
	Dim ret, sdata

	If accn = g_s88Accn And Len(Trim(pswd)) <> 0 Then
		'NextKey = Trim(LEDGER.Next)
'		SYSTEM.Trace "1 P_pswdConfirm is Next" & "|" & pswd & "|" & accn
		If g_s88Pswd = pswd Then
'			SYSTEM.Trace "P_pswdConfirm is Next" & "|" & pswd & "|" & accn
			P_pswdConfirm = True
			Exit Function
		End If
	End If
	g_s88Pswd = pswd
	g_s88Accn = accn

	P_pswdConfirm = False

'	SYSTEM.Trace "P_pswdConfirm = False"


		If Len(Trim(accn)) <> 11 Then Exit Function
		If Len(Trim(pswd)) > 8 Then Exit Function
'		SYSTEM.Trace "P_pswdConfirm = 1 "
		msg = ""
		sdata = accn&pswd
		ret = SCREEN.ServiceEx("pibopswd", accn&pswd, Len(sdata), 0, 600000)
'		SYSTEM.Trace "ret : "& ret
		If Left(ret,1) <> "1" Then
			msg = Mid(ret,2,99)
			If Trim(msg) = "" Then
				msg = "대기 시간 초과입니다. 결과를 꼭 확인 바랍니다."
			End If
			If InStr(msg, "3669") > 0 Then
				MsgBox msg, , "IBK투자증권"
			End If
			Exit Function
		End If

'	SYSTEM.Trace "P_pswdConfirm = True "
	P_pswdConfirm = True
End Function

Function CheckInput(ANCT, zpwd)

 	CheckInput = False
	If Trim(ANCT.data) = "" Or Len(Trim(ANCT.data)) <> 11 Then
		MsgBox "계좌번호를 확인하십시오.", , "IBK투자증권"
 		ANCT.Setfocus
 		Exit Function
	End If

	If Len(Trim(zpwd.data)) < 4 Then
		MsgBox "비밀번호를 확인하십시오.", , "IBK투자증권"
 		zpwd.Setfocus
 		Exit Function
	End If

	CheckInput = True
End Function

