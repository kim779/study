Sub send_e()
	If CheckInput(AN1A, zPwd) = False Then
		Exit Sub
	End If

	If Trim(S1301.Data) = "" Then
		alert_msg("종목코드를 입력하세요")
		S1301.SetFocus
		Exit Sub
	End If

	If Trim(ICancQty.Data) <= 0 Then
		alert_msg("취소수량을 입력하세요")
		ICancQty.SetFocus
		Exit Sub
	End If

	If Trim(ITrxNo.Data) <= 0 Then
		alert_msg("원처리번호를 입력하세요")
		ITrxNo.SetFocus
		Exit Sub
	End If

	If Trim(zLoanDt.Data) <= 0 Then
		alert_msg("대출일자를 입력하세요")
		zLoanDt.SetFocus
		Exit Sub
	End If

	dmsg = "acno" & vbTab & AN1A.Data & vbLf &_
		   "acnm" & vbTab & AN1A.Name & vbLf &_
		   "hnam" & vbTab & Mid(SCREEN.Object("OBJECT0.1022").Data, 2) & vbLf &_
		   "credit" & vbTab & zLoanDtlClssCode.Text & vbLf &_
		   "capa" & vbTab & ICancQty.Data & vbLf &_
		   "loandate" & vbTab & zLoanDt.Data & vbLf &_
		   "basenum" & vbTab & ITrxNo.Data & vbLf

			SCREEN.CreateWindow 2, "IB85016A /p5 /d", dmsg

			If SYSTEM.Pop("request") <> "OK" Then
				Exit Sub
			Else
				LEDGER.Fkey = "C"
				SCREEN.Send 0
			End If
End Sub

