RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim ArrData

ArrData = Array()
ReDim ArrData( GRID0.Rows - 1)
'----------------------------------------------------------------------
Sub GetHNamList()
	ArrItem = Array("", "")

	For i = 1 To GRID0.Rows
		HNam = Trim(GRID0.GetGridCell( i, 2 ))
		If Len(HNam) = 0 Then
			Exit For
		End If
		Code = GRID0.GetGridCell( i, 1 )
		CdTp = Trim(GRID0.GetGridCell( i, 3 ))

		Data  = Code & CdTp
		ArrItem(0) = Data
		ArrItem(1) = HNam


		Item = Join(ArrItem, "~")
'		SYSTEM.Trace Item
		ArrData(i - 1) = Item
	Next
	Data = Join(ArrData, "|")
	Cnt = i

	SCREEN.Proc "main.SetCodeList", Data & ", " & Cnt
End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Proc "parent.comb_list_done", ""

_AW_ONENDSUB_AW_
}



