RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"
zTrxCode.Data = "00"
zAppyGrpCode.Data = "03"	'일반투자자
zAppyAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

If Len(Trim(zAppyAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

zPwd.Data = Trim(SCREEN.Object("parent.zpwd").Data)

If SYSTEM.ConnectBy = 0 And Trim(zPwd.Data) = "" Then
	zPwd.Data = "9999"
End If

If Len(Trim(zPwd.Data)) < 4 Then
	Call alert_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

zAppyIsuNo.Data = Trim(SCREEN.Object("main.jmcd").Data)
lAppyQty.Data = "+000000000000000"

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

' 예수금
SCREEN.Object("parent.lBfbalAmt").Data = Trim(lDps.Data)

'---------------------------------------------------
' 예수금 상위 화면 표기 ::
' 은행연계 계좌의 경우 출금가능금액이 0이고,
' 은행예수금이 잡혀 있어서 데이터가 0으로 표기되는데,
' 이는 정상임 (은행 예수금으로 잡혀 있음)
'---------------------------------------------------
SCREEN.Object("Parent.L_ABLE").Visible = False
If Trim(lDps.Data) <> "" Then
	If IsNumeric(lDps.Data) = True Then
		If CDbl(lDps.Data) <> 0 Then
			SCREEN.Object("parent.ABLE").Text = Trim(SCREEN.Object("parent.lBfbalAmt").Text & " 원")
			SCREEN.Object("Parent.L_ABLE").Visible = True
		End If
	End If
End If

'기존에 하단 if문 안에 있는사항을 밖으로 뺌
SCREEN.object("parent.obj_entacc").Send

If Left(ecod, 1) = "0" Then
	SCREEN.Proc "parent.checkPwdAfter", ""

	'If Is_numeric(lDps.Data) = True Then
	'	SCREEN.object("parent.obj_entacc").Send
	'End If
Else
	If ecod = "3669"Then
		SCREEN.ClearAll 0, 2
		SCREEN.Object("parent.zpwd").SetFocus
	End If

	If ecod = "2679" Or ecod = "3669" Then
		'Call guide_msg(Trim(LEDGER.Emsg))
	Else
		Call alert_msg(Trim(LEDGER.Emsg))
	End If
End If

_AW_ONENDSUB_AW_
}



