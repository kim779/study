RESOURCE DIVISION
{


_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If SCREEN.Object("main.UTAB0").ID = "4" Then
	zAcntNo.Data = Left(Replace(Trim(SCREEN.Object("parent.bank_acct").text), "-", ""), 11)
Else
	If SCREEN.Object("parent.F1").checked = True Then
		zAcntNo.Data = Left(Replace(Trim(SCREEN.Object("parent.CMB_ACCT2").text), "-", ""), 11)
	Else
		zAcntNo.Data = Left(Trim(SCREEN.Object("parent.EDIT_ACCT").data), 11)
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If Trim(zBnkBrnNm.Data) <> "" Then
'		SCREEN.Object("parent.OUT_ACNM").data = Mid(zBnkBrnNm.Data, 4, 40)
		SCREEN.Object("parent.OUT_ACNM").data = Trim(zBnkBrnNm.Data)
	End If

	If SCREEN.Object("main.UTAB0").ID = "4" Then
		SCREEN.Object("parent.Nick").SetFocus

	Else
		SCREEN.Object("parent.AMT").SetFocus
	End If

ElseIf Trim(LEDGER.Ecod) = "1143" Then
	If SCREEN.Object("main.UTAB0").ID = "2" Then
		Call alert_msg("이체계좌번호를 잘못 입력하셨습니다.")
		SCREEN.Object("main.GUIDE.GUIDE").Text = LEDGER.Ecod & "[" & Time & "]" & "이체계좌번호를 잘못 입력하셨습니다."
		SCREEN.Object("main.OBJ1.EDIT_ACCT").Clear
		SCREEN.Object("main.OBJ1.EDIT_ACCT").SetFocus
	End If
Else
	Call alert_msg(Trim(LEDGER.Emsg))
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


