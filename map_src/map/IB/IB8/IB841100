RESOURCE DIVISION
{


_AW_ONDECLARE_AW_

Dim bFirstSend

Sub ChangeCode()
    SYSTEM.SetHistory "1301", S1301.Data
    S1301.Trigger "", True
	SCREEN.Object("OBJ01.1301").Data = S1301.Data
	OBJ01.Send
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_

QrySrtDt.Data = change_date("m", -3)

bFirstSend = True
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

LEDGER.Rcnt = "0045"

If r_all.Checked = True Then
	IsuNo.Data = ""
Else
	If Len(Trim(S1301.Data))<>0 Then
		If SCREEN.GetCodeType(Trim(S1301.Data)) <> 27 Then
			IsuNo.Data = Trim("A" & S1301.Data)
		Else
			IsuNo.Data = Trim("Q" & S1301.Data)
		End If
	End If
End If

If bFirstSend=True Then
	LEDGER.Fkey = "C"
Else
	GRID0.SetDataPosition 2
	LEDGER.Fkey = "7"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

btn_Next.Enable = (LEDGER.Next = "Y")

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
Call ChangeCode()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_GETCODE)
_AW_ONCLICK_AW_
SCREEN.GetCode 100, "1301", "1022", 0
Call ChangeCode()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(QrySrtDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(QryEndDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn_Send)
_AW_ONCLICK_AW_
bFirstSend = True
IsuNo.Data = S1301.Data
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn_Next)
_AW_ONCLICK_AW_
bFirstSend = False
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim code
If GRID0.HitPos = 3 Then
	code = GRID0.GetGridCell(GRID0.row, 2)
	If Trim(code) <> "" Then
		S1301.Data = Mid(code, 2, Len(code))
	    Call ChangeCode()
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r_all)
_AW_ONCLICK_AW_
S1301.Enable = False
BTN_GETCODE.Enable = False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r_jongmok)
_AW_ONCLICK_AW_
S1301.Enable = True
BTN_GETCODE.Enable = True
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



