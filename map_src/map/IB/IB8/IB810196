_AW_ONDECLARE_AW_
Sub Send_F()
	Call startinit()
	LEDGER.Fkey = "C"
'	SCREEN.Send 0
	GUIDE.Text = LEDGER.Emsg
End Sub

Sub startinit()
	INA.Data = "00001"
	TrxTp.Data ="I"
	UserId.Data = SYSTEM.UserId
'	PCI.Load()
'	TermKey.Data = Trim(PCI.GetPCData(4)) '하드디스크 정보식별자
'	TermKey2.Data = Trim(PCI.GetPCData(13)) 'MAC 정보식별자

If SCREEN.CreateObject("info") Then
	TermKey.Data = INFO.PopData("", "AXIS.INI", "PCDATA", "sGetPCData_4")
	TermKey2.Data = INFO.PopData("", "AXIS.INI", "PCDATA", "sGetPCData_13")
End If

End Sub

Sub navi()
	SCREEN.CreateWindow 1, "IB890400 /t /s /p5", ""
End Sub


Sub PCLogic()
	If SCREEN.Object("parent.TpText2").Data = "2" Then
		If SCREEN.Object("parent.parent.gubn").data = "3" Then
		'	MsgBox "OTP사용 고객입니다.(이체)",0,"IBK투자증권"
			SCREEN.Proc "parent.parent.BNK_SEND2", " "
		Else
		'	MsgBox "추가인증방법 신청자입니다.",0,"IBK투자증권"
			SCREEN.Proc "parent.parent.BNK_SEND1", Rmnno1.Data
		End If
	End If

	If SCREEN.Object("parent.TpText2").Data = "3" Then
		If Trim(NmdTermYn.Data) <> 1 Then
			If SCREEN.Object("parent.parent.gubn").data = "3" Then
				'MsgBox "OTP사용 고객입니다.(이체)",0,"IBK투자증권"
				SCREEN.Proc "parent.parent.BNK_SEND2", "02"
			Else
				SCREEN.Proc "parent.parent.BNK_SEND1", Rmnno1.Data
			End If
		Else
			'MsgBox "지정된 이용PC 입니다.(이체실행)",0,"IBK투자증권"
			SCREEN.Proc "parent.parent.BNK_SEND2", "02"
		End If
	End If

	If SCREEN.Object("parent.TpText2").Data = "1" Then
		If Trim(NmdTermYn.Data) <> 1 Then
			MSG = MsgBox ("현재 PC는 자금이체를 위해 등록된 PC가 아닙니다." & vbCrLf & "인증서 자금이체를 위해서는 이용PC로의 등록이 필요합니다" & vbCrLf & "이용PC 등록 신청/해지 화면으로 이동하시겠습니까?",4,"IBK투자증권")
			If MSG = 6 Then
				SCREEN.SetTimerx 1, 5, False
			Else
				'MsgBox "지정된 이용PC가 아닙니다.(종료)",0,"IBK투자증권"
				Exit Sub
			End If
		Else
			'MsgBox "지정된 이용PC 입니다.(이체실행)",0,"IBK투자증권"
			SCREEN.Proc "parent.parent.BNK_SEND2", "02"
		End If
	End If
End Sub

_AW_ONSEND_AW_
Call Send_F()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim MSG
If ExctTrxYn.Data <> "1" Then
	Call PCLogic()
Else
	OBJECT0.Send
End If

_AW_ONENDSUB_AW_
_AW_ONTIMERX_AW_
If Id = 1 Then
	Call navi()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call Send_F()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


