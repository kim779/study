'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	SCREEN.ClearAll 0, 2

	ACNM.Data = AN10.name
	zPwd.Data = AN10.Password

	If Len(Trim(AN10.Data)) = 11 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If

		Call send_f()
	Else
		AN10.SetFocus
		Exit Sub
	End If
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	ACNM.Data = Trim(AN10.Name)
	GUBN.Data = "1"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub cofirmOrder()
	Dim dmsg

	SYSTEM.Push "madoRdmtnApplication", ""

	If Len(Trim(AN10.Data)) <> 11 Then
		MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"
		AN10.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zPwd.SetFocus
		Exit Sub
	End If

	If Is_numeric(JSKM.Data) = False And Is_numeric(KSKM.Data) = False Then
		If Is_numeric(JSKM.Data) = False Then
			MsgBox "전일매도분 신청금액을 확인하여 주십시오.", , "IBK투자증권"
			JSKM.SetFocus
			Exit Sub
		End If

		If Is_numeric(KSKM.Data) = False Then
			MsgBox "금일매도금 신청금액을 확인하여 주십시오.", , "IBK투자증권"
			KSKM.SetFocus
			Exit Sub
		End If
	End If

	dmsg = "o_acno" & vbTab & Trim(AN10.Data) & vbLf &_
		   "o_acnm" & vbTab & Trim(ACNM.Data) & vbLf &_
		   "o_jskm" & vbTab & Trim(JSKM.Data) & vbLf &_
		   "o_kskm" & vbTab & Trim(KSKM.Data) & vbLf

	SCREEN.CreateWindow 2, "IB85041A /t /p5 /d", dmsg

	If SYSTEM.Pop("madoRdmtnApplication") = "OK" Then
		Call send_o()
	End If

	SYSTEM.Push "madoRdmtnApplication", ""
End Sub

Sub send_o()
	GUBN.Data = "2"
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub


Sub complete_cusstatus()

	Dim char,check_char,tmptujaYN,tmpinfoYN,tmptujaNM,tmptujaGD,tempYN

	tmptujaYN = Trim(SCREEN.Object("obj_cusstatus.OUTPUT7").Data)
	tmpinfoYN = Trim(SCREEN.Object("obj_cusstatus.OUTPUT8").Data)
	tmptujaNM = Trim(SCREEN.Object("obj_cusstatus.zGrdNm").Data)

	If Trim(tmptujaYN) = "0" Then
		tmptujaYN = "미희망"
	Else
		tmptujaYN = "희망"
	End If

	If tmptujaNM = "안정형" Then
		check_char = 1
	ElseIf tmptujaNM = "안정추구형" Then
		check_char = 2
	ElseIf tmptujaNM = "위험중립형" Then
		check_char = 3
	ElseIf tmptujaNM = "적극투자형" Then
		check_char = 4
	ElseIf tmptujaNM = "공격투자형" Then
		check_char = 6
	End If

	If Trim(tmpinfoYN) = "0" Then
		tmptujaNM = ""
		tmpinfoYN = "미제공"
		'check_char = 7
	Else
		tmpinfoYN = "제공"
	End If

	Select Case check_char
		Case 1 :
			tmptujaGD = "매우낮은위험이하"
		Case 2 :
			tmptujaGD = "낮은위험이하"
		Case 3 :
			tmptujaGD = "보통위험이하"
		Case 4 :
			tmptujaGD = "다소높은위험이하"
		Case 6 :
			tmptujaGD = "매우높은위험이하"
		Case 7 :
			tmptujaGD = ""
	End Select

	If Trim(SCREEN.Object("obj_cusstatus.LEDGER").Ecod) = "3956" Then '"미등록"
			tmptujaNM   = "없음(미등록)"
			tmptujaGD   = "-"
			'Exit Sub
	ElseIf CDbl(SCREEN.Object("obj_cusstatus.zToday").Data) > CDbl(SCREEN.Object("obj_cusstatus.zDueDate").Data) Then '만료일
		tmptujaNM   = "없음(만료)"
		tmptujaGD   = "-"
		'Exit Sub

	ElseIf Trim(SCREEN.Object("obj_cusstatus.OUTPUT6").Data) = "0" Then ' 전문금융소비자 일경우 스킵
		tmptujaNM   = "전문금융소비자"
		SYSTEM.Trace "profess111"
'	ElseIf tmpinfoYN = "미제공" Or tmptujaYN = "미희망" Then '미희망은 요건 없어짐
'		If tmpinfoYN = "미제공" Then
'			tmptujaNM   = "없음(정보미제공)"
'			tmptujaGD   = "-"
'		End If
	Else '일반금융소비자

    End If

	If tmptujaNM = "안정형" Then
		sentence1.Data = "고객님의 투자성향은 안정형으로 매우낮은위험 이하 등급의 상품이 적합합니다."
	ElseIf tmptujaNM = "안정추구형" Then
		sentence1.Data = "고객님의 투자성향은 안정추구형으로 보통위험 이하 등급의 상품이 적합합니다."
	ElseIf tmptujaNM = "위험중립형" Then
		sentence1.Data = "고객님의 투자성향은 위험중립형으로 다소높은위험 이하 등급의 상품이 적합합니다."
	ElseIf tmptujaNM = "적극투자형" Then
		sentence1.Data = "고객님의 투자성향은 적극투자형으로 높은위험 이하 등급의 상품이 적합합니다."
	ElseIf tmptujaNM = "공격투자형" Then
		sentence1.Data = "고객님의 투자성향은 공격투자형으로 매우높은위험 이하 등급의 상품이 적합합니다."
	End If
	    'tmptujaGD = "매우높은위험"


    If tmptujaNM = "전문금융소비자" Then
        sentence1.Data = "고객님은 전문금융소비자로, 매우높은 위험 이하 등급의 상품이 적합합니다."
        SYSTEM.Trace "profess222"
    End If

    If tmpinfoYN = "미제공" Then
		sentence1.Data = "고객님은 당사에 투자자정보 제공을 원하지 않으세요. "
    End If

    If tmptujaGD = "-" Then
		sentence1.Data = "투자자정보확인서가 작성되지 않았거나, 유효기간이 만료되었습니다."
    End If

End Sub

