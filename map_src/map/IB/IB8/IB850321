RESOURCE DIVISION
{


_AW_ONDECLARE_AW_

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0030"
Call Check_LoginType(zPwd)

'SCREEN.SetTimer 8, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
'SYSTEM.Trace "IB850321 onsend start"
SCREEN.OnSend = False

AN19.Data = Trim(SCREEN.Object("parent.AN19").Data)
zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
End If

If Len(Trim(SCREEN.Object("parent.AN19").Data)) < 11 Then
	MsgBox "계좌번호를 확인하십시오.", , "IBK투자증권"
	SCREEN.Object("main.obj0.AN19").SetFocus
	Exit Sub
End If

If Len(Trim(SCREEN.Object("parent.zpwd").Data)) = True Then
	MsgBox "비밀번호를 확인하십시오.", , "IBK투자증권"
	SCREEN.Object("main.obj0.zpwd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	SCREEN.Object("parent.next_btn").Enable = True
Else
	SCREEN.Object("parent.next_btn").Enable = False
End If

SCREEN.Object("main.GUIDE").text = LEDGER.Emsg
SCREEN.Object("parent.zPwd").SetFocus

If SCREEN.Object("main.UTAB0").Index = 3 Then '담보대출 탭일 경우
	If Trim(LEDGER.Ecod) <> "" Then
		If Trim(LEDGER.Ecod) = "0001" Then				'조회가 완료되었습니다.
			Dim mtkcode
			For ii = 1 To GRID0.Rows
				mtkcode = Trim(GRID0.GetGridCell(ii, 16))
				If mtkcode <> "" And mtkcode <> "00" Then
					MsgBox "해외주식담보대출은 담보교체가 불가합니다. (상환 후 재대출)", , "IBK투자증권"
					Exit Sub
				End If
			Next
		End If
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Len(Trim(SCREEN.Object("parent.AN19").Data)) < 11 Then
	Exit Sub
End If

If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(SCREEN.Object("parent.zPwd").Data)) < 4 Then
		Exit Sub
	End If
End If

Call send_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_

If GRID0.HitPos = 3 Then
	Dim str,smkgubn,scode
	SCREEN.Object("parent.zStrDt").data = GRID0.GetGridCell(GRID0.Index +1, 4)
'	SCREEN.Object("parent.obj2.zStrDt").data = GRID0.GetGridCell(GRID0.Index +1, 4)

	smkgubn = GRID0.GetGridCell(GRID0.Index +1, 16)

	If smkgubn = "00" Then
		'SCREEN.Object("parent.1301").data = Left(GRID0.GetGridCell(GRID0.Index +1, 2), 6)

		If SCREEN.Object("main.UTAB0").Index = 2 Then '만기연장 탭일 경우
			SCREEN.Object("parent.1301_1").data = Mid(GRID0.GetGridCell(GRID0.Index +1, 2), 2, 6)
			SCREEN.Object("parent.EDIT0").data = "80"
			SCREEN.Proc "parent.oper_obj", Mid(GRID0.GetGridCell(GRID0.Index +1, 4),2, 6)		'--종목번호
		Else
			SCREEN.Object("parent.1301").data = Mid(GRID0.GetGridCell(GRID0.Index +1, 2), 2, 6)
		End If
		zLoanDtlClssCode.Data = "80"
	Else
		'scode = GRID0.GetGridCell(GRID0.Index +1, 1) & GRID0.GetGridCell(GRID0.Index +1, 2)
		scode = GRID0.GetGridCell(GRID0.Index +1, 2)
		SCREEN.Object("parent.EDIT0").data = "83"
		zLoanDtlClssCode.Data = "83"

		SCREEN.Object("parent.zfrgncod2").data = scode
		SCREEN.Object("parent.FcurrMktCode").data = smkgubn

		SCREEN.Proc "parent.SetmktVisible", smkgubn
		SCREEN.Proc "parent.ChangeIMaxCode", smkgubn & "," & scode

	End If
'	SCREEN.Object("parent.obj2.1301").data = Left(GRID0.GetGridCell(GRID0.Index +1, 2), 6)

	str = Trim(GRID0.GetGridCell(GRID0.Index +1, 9))
	str = "+" & String(15 - Len(str), "0") & str
	SCREEN.Object("parent.lChgObjLoanTrxQty").data = str
	SCREEN.Proc "parent.oper_obj", Left(GRID0.GetGridCell(GRID0.Index +1, 2), 6)
	S1301.DATA = GRID0.GetGridCell(GRID0.Row, 2)
	SCREEN.Object("parent.obj0").Send

	SCREEN.Object("parent.EDIT1").data = ""
'	SCREEN.Object("parent.OUTPUT6").data = ""
	'SCREEN.Object("parent.obj2.zLoanDtlClssCode").data = zLoanDtlClssCode.Data

	SCREEN.proc "parent.obj2.send_f", ""

	If Trim(S1301.DATA) = "" Then
		Exit Sub
	End If

	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN19)
_AW_ONCHANGE_AW_
