If GRID0.HitPos = 3 Then
	Dim account, code, name, qty, gubn,msg

	account = Trim(GRID0.GetGridCell(GRID0.row, 3))			'계좌
	code = Mid(Trim(GRID0.GetGridCell(GRID0.row, 5)), 2)	'종목번호
	name = Trim(GRID0.GetGridCell(GRID0.row, 4))			'계좌명
	qty = Trim(GRID0.GetGridCell(GRID0.row, 6))				'수량


	If Trim(code) = "" Then
	    Exit Sub
	End If

	If Len(code) <> 6 Then
	    Exit Sub
	End If

	If SCREEN.GetCodeType(code) < 0 Then
		Exit Sub
	End If

	SYSTEM.Push "an1a8723", account
	SYSTEM.Push "ancm8723", name

	msg = code & "|" & "" & "|" & "" & "|" & qty & "|" & "1"
	'SCREEN.CreateWindow 1, "IB550000 /t/s/p5/d", "1301" & vbTab & Mid(code, 2) & vbLf & "domino_data" & vbTab & msg & vbLf
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


