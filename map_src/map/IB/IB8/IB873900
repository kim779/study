_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
Dim DELI, strx, str, cate, i, ii,ret

DELI = Chr(127)
cate = SYSTEM.UserID
strx =  "사원(" & cate & ")관리계좌 종목" & DELI

For ii=1 To GRID0.Rows
	ret = 0
	If Trim(GRID0.GetGridCell(ii, 16)) <> "" Then
		If ii <> 1 Then
			For i=1 To ii-1
				If Trim(GRID0.GetGridCell(ii, 16)) = Trim(GRID0.GetGridCell(i, 16)) Then
					ret  = 1
				End If
			Next
		End If
		If ret = 0 Then
			str = Trim(GRID0.GetGridCell(ii, 16)) & DELI
			strx = strx & str
		End If
	End If
Next


SCREEN.CreateWindow 1, "IB566000 /t/s/d", "appendGROUP" & _
			vbTab & strx & vbLf & "map" & vbTab & "1" & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


