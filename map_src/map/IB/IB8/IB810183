RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_o()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub confirm()
	SYSTEM.Push "favorate_register", ""
	SYSTEM.Push "favorate_nick", ""

	Dim Domino
	Domino = "bank" & vbTab & Trim(zBnkName.Data)     & vbLf &_
	         "acct" & vbTab & Trim(zBnkAcntNo.Data)   & vbLf &_
	         "nick" & vbTab & Trim(zBnkAcntNm.Data)   & vbLf &_
	         "name" & vbTab & Trim(zBnkAcntNick.Data) & vbLf
	'닉네임에 계좌명을 넣고 있어서 바꿈

	SCREEN.CreateWindow 2, "IB81018D /p5 /d", Domino

	If Trim(SYSTEM.Pop("favorate_register")) <> "OK" Then
		Exit Sub
	Else
		Dim regNick
		regNick = Trim(SYSTEM.Pop("favorate_nick"))

		If regNick <> "" Then
			zBnkAcntNick.Data = regNick
		End If

		Call send_o()
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"
zTrxTp.Data = "1"
zUserId.Data = Trim(LOGIN.User)

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

Call alert_msg(Trim(LEDGER.Emsg))

_AW_ONENDSUB_AW_
}



