			'SYSTEM.Trace i & "|" & Cd & "|" & Value
			If i <= g_ArrCd(0) + 1 Or i = UBound(g_ArrCd) Then
				AYear = Year(DateAdd("m", g_ArrCd(1) * (i - 1), FirstDate))
				AMon = Month(DateAdd("m", g_ArrCd(1) * (i - 1), FirstDate))
