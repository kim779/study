Function GetMin(Data1, Data2)
	If Len(Trim(Data1)) = 0 Or Len(Trim(Data2)) Then
		GetMin = -1
	End If
	If Data1 > Data2 Then
		GetMin = CLng(Len(Trim(Data2)))
	Else
		GetMin = CLng(Len(Trim(Data1)))
	End If
End Function
'-------------------------------------------------------
Function GetDate(StrDate)
	AYear = Mid(StrDate, 1, 4)
	AMon = Mid(StrDate, 5, 2)
	ADay = Mid(StrDate, 7, 2)
	GetDate = DateSerial(AYear, AMon, ADay)
End Function
