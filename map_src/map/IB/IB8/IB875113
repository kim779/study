'-------------------------------------------------------
Sub SetItemCd(Data)
	ArrData = Split(Data, "|")
	If UBound(ArrData) < 1 Then
		Exit Sub
	End If
	ed_ItemCd1.Data = ArrData(0)
	ed_ItemCd2.Data = ArrData(1)
End Sub
'-------------------------------------------------------
Sub SetIndex(Data)
	g_Index = Data
End Sub
'-------------------------------------------------------
Function GetItemValue(ItemCd, Value)
	Ret = 0
	If Len(Trim(ItemCd)) = 6 Then
		If Value Mod 100 = 0 Then
			Ret = Value \ 100
		Else
			Ret = Value \ 100 + 1
		End If
	Else
		If (Value*100) Mod 100 = 0 Then
			Ret = Value/100
		Else
			Ret = Value/100 + 0.005
		End If
		Ret = FormatNumber(Ret, 2, -2, -2, 0)
	End If
	GetItemValue = Ret
End Function
