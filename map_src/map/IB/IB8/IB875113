Sub SetCdData(Data)
	ArrData = Split(Data, "|")
	For i = LBound(ArrData)To UBound(ArrData)
		If i > UBound(g_ArrCd) Then
			Exit For
		End If

		g_ArrCd(i) = CLng(ArrData(i))
	Next
	CalcCdData
