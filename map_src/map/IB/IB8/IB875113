	For i = 2 To UBound(g_ArrCd)
		Cd = Trim(g_ArrCd(i))
		If Len(Cd) <> 0 Then
			Value1 = Prc1 * Cd
			Value2 = Prc2 * Cd
			Value1 = GetItemValue(ed_ItemCd1.Data, Value1)
			Value2 = GetItemValue(ed_ItemCd2.Data, Value2)
			'SYSTEM.Trace Value
