	For i = LBound(g_ArrCtrls) To UBound(g_ArrCtrls)
		g_ArrCtrls(i)(0) = 0
		g_ArrCtrls(i)(1).Data = ""
		g_ArrCtrls(i)(2).Data = ""
		g_ArrCtrls(i)(3).Data = ""
	Next
	ot_KI.Data = "KI가격"
