Sub SetDecAndSrchData()
	ArrData = Array(0, 0, 0, 0, 0, 0)
	ArrData(0) = Trim(dt_Date.Data)
	ArrData(1) = Trim(ot_DecPrc1.Data)
	ArrData(2) = Trim(ot_DecPrc2.Data)

	ArrData(3) = dt_SrchDate.Data
	ArrData(4) = Trim(ot_SercPrc1.Data)
	ArrData(5) = Trim(ot_SercPrc2.Data)

	Data1 = Join(ArrData, "|")

	ArrData1 = Array(0, 0, 0, 0, 0, 0, 0, 0, 0)
	If Trim(Len(dt_Date.Data)) <> 8 Then
		Exit Sub
	End If

	BDate = ""
	StdDate = GetDate(dt_Date.Data)
	For i = LBound(g_ArrCtrls) To UBound(g_ArrCtrls) - 1
		ADate = Mid(g_ArrCtrls(i)(1).Data, 1, 4) &_
			Mid(g_ArrCtrls(i)(1).Data, 6, 2) &_
			Mid(g_ArrCtrls(i)(1).Data, 9, 2)
		ADate = Trim(ADate)
		If Len(ADate) = 0 Then
			Exit For
		End If
		BDate = GetDate(ADate)
		ADiff = DateDiff("d", StdDate, BDate)
		ArrData1(i) = ADiff
	Next
	Data2 = Join(ArrData1, "|")

	If Len(BDate) = 0 Then
		Exit Sub
	End If

	SrchDate = GetDate(dt_SrchDate.Data)
	BDiff = DateDiff("d", SrchDate, BDate)

	CDiff = DateDiff("d", StdDate, SrchDate)
	Data3 = ADiff & "|" & BDiff & "|" & CDiff
	'SYSTEM.Trace Data3
	Data = Data1 & "@" & Data2 & "@" & Data3
	SCREEN.Proc "Parent.SetDecAndSrchData", g_Index & "," & Data
End Sub
