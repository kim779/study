RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	isPwdChkYn.Text = "N"

	SCREEN.ClearAll 0, 2
	obj.ClearAll 2

	If Len(Trim(AN1A.Data)) = 11 Then
		ACNM.Data = Trim(AN1A.Name)
		zPwd.Data = Trim(AN1A.Password)

		If SYSTEM.ConnectBy = "0" Then
			zPwd.Data = "9999"
		ElseIf SYSTEM.ConnectBy = 1 And Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If

		Call send_f()
	Else
		AN1A.SetFocus
		Exit Sub
	End If
End Sub

Sub send_f()
	If SYSTEM.ConnectBy = 0 Then
		SCREEN.Proc "obj.send_f", ""
	Else
		If Trim(isPwdChkYn.Text) = "Y" Then
			SCREEN.Proc "obj.send_f", ""
		Else
			SCREEN.Proc "obj_chkpwd.send_f", ""
		End If
	End If
End Sub


Sub OkSend()
	SCREEN.Proc "obj.send_f", ""
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zAppySrtDt)
