_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	ACNM.Data = HNAM.Data
	SCREEN.Send 0
End Sub

Sub Set_account()
	SCREEN.ClearAll 2, 2
	GUIDE.Text = ""

	ACNM.Data = AN97.Name
	HNAM.Data = ACNM.Data
	zpwd.Data = AN97.Password

	If Trim(AN97.Data) = "" Then
		AN97.SetFocus
		Exit Sub
	End If

	zpwd.Data = "9999"


	Call send_f()
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zpwd)

_AW_ONENDSUB_AW_
