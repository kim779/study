_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt="0025"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
SCREEN.Object("parent.GUIDE").Text = ""

account.Data = Trim(SCREEN.Object("parent.AN1A").Data)
zPwd.Data = Trim(SCREEN.Object("parent.zpwd").Data)

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
End If

If Len(Trim(account.Data)) < 11 Then
	MsgBox "계좌번호를 확인하십시오.",,"IBK투자증권"
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하십시오.",,"IBK투자증권"
		SCREEN.Object("parent.zpwd").SetFocus
		Exit Sub
	End If
End If

SCREEN.onsend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'SYSTEM.Trace "850141 onrecieve"

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 1,2
	zPwd.Clear
	zPwd.SetFocus
Else
	yday_new.Data = lUnsttNewMloan.Data + lUnsttNewSloan.Data
	yday_refund.Data = lUnsttMloanRfund.Data + lUnsttSloanRfund.Data
End If

If SCREEN.Object("main.sec").Data = "1" Then
	SCREEN.Object("main.zPwd").SetFocus
ElseIf SCREEN.Object("main.sec").Data = "2" Then
	SCREEN.Object("main.send_btn").SetFocus
ElseIf SCREEN.Object("main.sec").Data = "3" Then
	SCREEN.Object("main.next_btn").SetFocus
ElseIf SCREEN.Object("main.sec").Data = "4" Then
    SCREEN.Object("main.extend_btn").SetFocus
End If

If LEDGER.Next = "Y" Then
	SCREEN.Object("parent.next_btn").Enable = True
Else
	SCREEN.Object("parent.next_btn").Enable = False
End If

SCREEN.Object("parent.GUIDE").Text = Trim(LEDGER.Emsg)

SCREEN.Object("parent.zPwd").SetFocus

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(SCREEN.Object("parent.zpwd").Data)) < 4 Then
		Exit Sub
	End If
End If

