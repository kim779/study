RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'-------------------------------------------------------
Sub SendData(Data)
	ArrData = Split(Data, "|")
	'0:구분, 1:종목코드

	If UBound(ArrData) <> 1 Then
		Exit Sub
	End If

	ed_gubn.Data = ArrData(0)
	ed_code.Data = ArrData(1)
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
SCREEN.Proc "Parent.SetRecvMsg", " "

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Code = Trim(ot_code.Data)

If Len(Code) = 7 Then
	Code = Mid(Code, 2, 6)
	SCREEN.Proc "Parent.SendData", Code
End If

RecvMsg = Trim(ot_omsg.Data)
SCREEN.Proc "Parent.SetRecvMsg", RecvMsg

_AW_ONENDSUB_AW_
}



