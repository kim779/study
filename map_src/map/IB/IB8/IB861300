RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'--계좌번호, 계좌명 세팅
Sub acct_set()
	zPwd.Clear

	If Len(CMB_ACCT.Data) = 11 Then
		Dim tmpAcnm
		tmpAcnm = Split(Trim(CMB_ACCT.Text), " ")

		ACNM.Data = tmpAcnm(2)

		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	Else
		CMB_ACCT.SetFocus
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SCREEN.Proc "obj_getAcnt.send_f", ""

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	SCREEN.Proc "obj.send_f", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Proc "obj.send_f", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CMB_ACCT)
_AW_ONCHANGE_AW_
Call acct_set()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


