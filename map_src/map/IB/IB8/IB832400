RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_TrType
Dim g_ArrCtrls
Dim g_STARTCOL, g_ENDCOL

g_TrType = "Q"
g_ArrCtrls = Array(Array(ed_SelN1, ed_AcNo1), Array(ed_SelN2, ed_AcNo2),_
	Array(ed_SelN3, ed_AcNo3), Array(ed_SelN4, ed_AcNo4), Array(ed_SelN5, ed_AcNo5))
g_STARTCOL = 2
g_ENDCOL = 6
'---------------------------------------------------------------
Sub InitCtrls()
	For i = LBound(g_ArrCtrls) To UBound(g_ArrCtrls)
		g_ArrCtrls(i)(0).Data = " "
		g_ArrCtrls(i)(1).Data = " "
	Next
End Sub
'---------------------------------------------------------------
Sub SendQ_TR()
	g_TrType = "Q"
	SCREEN.Send 0
End Sub
'---------------------------------------------------------------
Sub RowInit(Row)
	For i = g_STARTCOL To g_ENDCOL
		GRID0.SetGridCell Row, i, "0"
	Next
End Sub
'---------------------------------------------------------------
Sub SetCheck(Row, Column)
	Cnt = 0
	If Column <> 1 And Column <> 7 Then
		For i = g_STARTCOL To g_ENDCOL
			If GRID0.GetGridText(Row, i) = "1" Then
				Cnt = Cnt + 1
			End If
		Next

		If Cnt >= 2 Then
			For i = g_STARTCOL To g_ENDCOL
				If GRID0.GetGridText(Row, i) = "1" Then
					If CLng(Column) <> i Then
						alert_msg("이미 선택한 번호입니다. 다시 확인해주시기 바랍니다.")
						'GRID0.SetGridCell Row, i, "0"
						GRID0.SetGridCell Row, Column, "0"
					End If
				End If
			Next
		End If
		SetRowCheck Row, Column
	ElseIf Column = 7 Then
		RowInit Row
	End If
End Sub
'---------------------------------------------------------------
Sub SetRowCheck(Row,Column)
	For i = 1 To GRID0.Rows
		Data = Trim(GRID0.GetGridText(i, Column))
'		SYSTEM.Trace Data
		If Data = "1" And i <> Row Then
			alert_msg("이미 선택한 번호입니다. 다시 확인해주시기 바랍니다.")
			GRID0.SetGridCell Row, Column, "0"
		End If
	Next
End Sub
'---------------------------------------------------------------
Sub Setting()
	OBJ1.Send
End Sub
'---------------------------------------------------------------
Sub	InitGrid()
	For i = 1 To GRID0.Rows
		For j = g_STARTCOL To g_ENDCOL
			GRID0.SetGridCell i, j, "0"
			If i + 1 = j Then
				AcNo = Trim(GRID0.GetGridCell(i, 1))
				If Len(AcNo) > 0 Then
					GRID0.SetGridCell i, j, "1"
				End If
			End If
		Next
	Next
End Sub
'---------------------------------------------------------------
Sub SetGridData(Data)
	'InitGrid
	ArrData = Split(Data, "|")

	For i = LBound(ArrData) To UBound(ArrData)
		GRID0.SetGridCell i + 1, 1, ArrData(i)
	Next

	'InitGrid
End Sub
'---------------------------------------------------------------
Function GetCheck(Row)
	GetCheck = 0
	For Index = g_STARTCOL To g_ENDCOL
		Data = Trim(GRID0.GetGridText(Row, Index))
		If Data = "1" Then
			GetCheck = Index - 1
			Exit For
		End If
	Next
End Function

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
guide_flag = 1
'InitGrid
SCREEN.SetTimer 3, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
ed_TrType.Data = g_TrType
ed_JuNo.Data = LOGIN.Juno
Cnt = 0
InitCtrls
For i = 1 To GRID0.Rows
	AcNo = Trim(GRID0.GetGridCell(i, 1))
	If Len(AcNo) > 1 Then
		If Cnt >= 5 Then
			Exit For
		End If
		SelN = GetCheck(i)
'		SYSTEM.Trace SelN & "|" & AcNo
		If SelN <> 0 Then
			g_ArrCtrls(Cnt)(0).Data = SelN
			g_ArrCtrls(Cnt)(1).Data = AcNo
			Cnt = Cnt + 1
		End If
	End If
Next

If Cnt = 0 And g_TrType = "I" Then
	alert_msg("단축번호 하나 이상 신청 가능합니다.")
	SCREEN.OnSend = False
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
GUIDE.Text = ot_OMsg.Data
For i = 1 To GRID0.Rows
	RowInit i
Next

If g_TrType <> "D" Then
	If CLng(ot_Nrec.Data) = 0 Then
		Exit Sub
	End If
Else
	Exit Sub
End If

For i = 1 To CLng(ot_Nrec.Data)
	Index = Trim(GRID1.GetGridCell(i, 1))
	If Len(Index) = 0 Then
		Exit For
	End If
	If Index <> 0 Then
		AcNo1 = Trim(GRID1.GetGridCell(i, 2))
		For j = 1 To GRID0.Rows
			AcNo0 = Trim(GRID0.GetGridCell(j, 1))
			If AcNo1 = AcNo0 Then
				RowInit j
				GRID0.SetGridCell j, Index + 1, "1"
				Exit For
			End If
		Next
	End If
Next

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Setting

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	GUIDE.Text = ""
	SetCheck GRID0.Row, GRID0.Column
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
For i = 1 To GRID0.Rows
	For j = g_STARTCOL To g_ENDCOL
		GRID0.SetGridCell i, j, "0"
	Next
Next
SendQ_TR
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
If RADIO0.Checked Then
	g_TrType = "I"
Else
	g_TrType = "D"
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONDBLCLK_AW_
Call grid_DblClick("GRID1")
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



