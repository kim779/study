If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim Today, i, gubn, jmcd, StrtDt, EndDt, gbn
	Today = getCurrDay()

	For i = GRID0.Rows To 1 Step -1

		' Short CODE :: A005930 -> 005930 변환
		jmcd = Trim(GRID0.GetGridCell(i, 3))
		If jmcd <> "" Then
			If Len(jmcd) = 7 And Left(jmcd, 1) = "A" Then
				jmcd = Mid(jmcd, 2)
			End If
			GRID0.SetGridCell i, 4, jmcd
		End If

		' 날짜 연산을 통한 공모 상태 세팅
		StrtDt = Trim(GRID0.GetGridCell(i, 2))	'청약개시일
		EndDt = Trim(GRID0.GetGridCell(i, 9))	'청약종료일

		If IsNumeric(StrtDt) = False Then
			StrtDt = ""
		End If

		If IsNumeric(EndDt) = False Then
			EndDt = ""
		End If

		If StrtDt <> "" And EndDt <> "" Then
			If CDbl(Today) < CDbl(StrtDt) Then
				GRID0.SetGridCell i, 1, "청약예정"
			ElseIf CDbl(Today) > CDbl(EndDt) Then
				GRID0.SetGridCell i, 1, "완료"
			Else
				GRID0.SetGridCell i, 1, "진행중"
			End If
		End If

		' 공모구분 Space Trim
		gbn = Trim(GRID0.GetGridCell (i, 14))
		GRID0.SetGridCell i, 14, Trim(gbn)


	Next

	' 조회 건수가 1개이면 자동으로 조회
	If GRID0.Rows = 1 Then
		Call autoSend()
	End If
End If

