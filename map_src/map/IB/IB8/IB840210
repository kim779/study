Option Explicit

'== 첫 조회
Sub send_f()
	GRID0.Clear()
	GRID0.Refresh()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'== D-2 날짜 구하기
Sub getD_2()
	Dim yy, mm, dd, cday, MyWeek

	cday = DateAdd("d", -2, Date)
	MyWeek = Weekday(cday)

	If MyWeek = 1 Then
		cday= DateAdd("d", -2 , cday)
	ElseIf MyWeek = 7 Then
		cday= DateAdd("d", -1 , cday)
	End If

	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)

	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd
	zQrySrtDt_view.Data = CDbl(cday)
End Sub


'청약종목이 하나일 때 청약증거금 및 자동세팅
Sub autoSend()
	Dim strtDt											'청약 개시일
	strtDt = Trim(GRID0.GetGridCell(1, 2))

	If strtDt = "" Then
		Exit Sub
	End If

	SCREEN.Proc "main.clearSelData", ""
	SCREEN.Object("main.obj0").ClearAll 2

	If SCREEN.GetMapName(1) = "IB840200" Then
		SCREEN.Object("main.obj1.lAppyQty").Clear
	End If

	Dim fullcd, jmcd, jmnm, gubn
	fullcd = Trim(GRID0.GetGridcell(1, 3))		'종목코드
	jmcd   = Trim(GRID0.GetGridcell(1, 4))		'종목코드
	jmnm   = Trim(GRID0.GetGridCell(1, 5))		'종목명
	gubn   = Trim(GRID0.GetGridCell(1, 1))		'구분

	SCREEN.Object("main.jmcd").Data = fullcd
	SCREEN.Object("main.jmnm").Data = jmnm
	SCREEN.Object("main.strtDt").Data = strtDt
	SCREEN.Object("main.isProc").Data = gubn

	SCREEN.Object("main.obj0.lAppyQty").Clear

	SCREEN.Object("main.obj0.zAppyIsuNo").Data = fullcd
	SCREEN.Object("main.obj0.zAppySrtDt").Data = strtDt
	SCREEN.Proc "main.obj0.send_f", ""

	If SCREEN.GetMapName(1) = "IB840200" Then
		If Len(jmcd) <> 6 Then
			SCREEN.Object("main.OBJ1.chae").Checked = True
			SCREEN.Object("main.obj1.zIsuNo_chae").Data = jmcd
			SCREEN.Object("main.obj1.chae_nm").Data = jmnm
			SCREEN.Proc "main.OBJ1.set_chae", ""
		Else
			SCREEN.Object("main.OBJ1.jusik").checked = True
			SCREEN.Object("main.obj1.zIsuNo").data = jmcd
			SCREEN.Object("main.obj1.jusik_nm").data = jmnm
			SCREEN.Proc "main.OBJ1.set_jusik", ""
		End If

		If SCREEN.Object("main.UTAB1").ID = "0" Then
			SCREEN.Object("main.obj1.zAppySrtDt").Data = strtDt
			SCREEN.Proc "main.obj1.scrDisAble", ""

'			If Len(Trim(SCREEN.Object("main.obj1.AN1A").Data)) = 11 And Len(Trim(SCREEN.Object("main.obj1.zPwd").Data)) >= 4 Then
'				SCREEN.Proc "main.obj1.chkTJSMDownYn", ""
'			End If
		End If

		' 조회를 명시적으로 할 수 있도록
		SCREEN.Proc "Main.obj1.view_highlight", ""
	End If
End Sub

