RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	SCREEN.ClearAll 0, 2
	aa.Clear
	obj.ClearAll 2
	obj_list.ClearAll 2

	If Len(Trim(AN50.Data)) = 11 Then
		ACNM.Data = Trim(AN50.Name)
		zPwd.Data = Trim(AN50.Password)

		If Trim(SCREEN.Object("main.zAcntNo").Data) <> Trim(AN50.Data) Then
			SCREEN.Object("main.zAcntNo").Data = Trim(AN50.Data)
			SCREEN.Object("main.zPwd").Data = ""
		Else
			If Trim(zPwd.Data) = "" And Len(Trim(SCREEN.Object("main.zPwd").Data)) >= 4 Then
				zPwd.Data = Trim(SCREEN.Object("main.zPwd").Data)
			End If
		End If

		If SYSTEM.ConnectBy = 1 Then
			If Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If
		End If

		SCREEN.Proc "obj_list.send_f", ""
	Else
		SCREEN.Object("main.zAcntNo").Data = ""
		SCREEN.Object("main.zPwd").Data = ""

		AN50.SetFocus
		Exit Sub
	End If
End Sub

Sub chgScreen()
	If SCREEN.Object("parent.UTAB0").ID = "2" Then
		LABEL2.Text = "상환금"
		LABEL4.Visible = True
		lTotRfundRqrdAmt.Visible = True
		order_btn.Text = "현금상환신청"
		obj.SetObject "IB850521"
	Else
		LABEL2.Text = "원처리번호"
		LABEL4.Visible = False
		lTotRfundRqrdAmt.Visible = False
		order_btn.Text = "현금상환취소신청"
		obj.SetObject "IB850530"
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call chgScreen()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN50)
_AW_ONCHANGE_AW_
Call Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If CheckInput(AN50, zPwd) = False Then
		Exit Sub
	End If

	SCREEN.Object("main.zAcntNo").Data = Trim(AN50.Data)
	SCREEN.Object("main.zPwd").Data = Trim(zPwd.Data)

	If Is_numeric(aa.Data) = True Then
		Call send_f()
	Else
		aa.SetFocus
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(order_btn)
_AW_ONCLICK_AW_
SCREEN.Proc "obj.confirmOrder", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(lTotRfundRqrdAmt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(aa)
_AW_ONCHARCHANGE_AW_
If Left(Trim(aa.Data), 1) = "-" Or Left(Trim(aa.Data), 1) = "+" Then
	aa.Data = Mid(Trim(aa.Data), 2)
End If
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If CheckInput(AN50, zPwd) = True Then
		SCREEN.Proc "obj.send_f", ""
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Proc "obj.send_f", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


