_AW_ONDECLARE_AW_
'그리드 클릭시 데이터 전달
Sub click_grid()
		Dim	jongmok_code, base_date

		'종목번호
		jongmok_code = Trim(GRID0.GetGridCell(GRID0.Row, 6))
		'기준일
		base_date = Trim(GRID0.GetGridCell(GRID0.Row, 8))
		SCREEN.proc "Main.setOrder2", jongmok_code & "," & base_date
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zpwd.Data) = "" Then
   zpwd.Data = "9999"
End If

If CheckInput(account, zpwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 1,2
	zpwd.Clear
	zpwd.SetFocus
ElseIf Left(Trim(LEDGER.ecod), 1) = "0" Then
	Dim ii, var
	For ii=1 To GRID0.Rows
		var = GRID0.GetGridCell(ii, 24)
		GRID0.SetGridCell ii, 16, var
	Next
End If

'Select Case SCREEN.Object("main.sec").Data
'	Case "1" SCREEN.proc "Main.SetFocusBtn", "zpwd"
'	Case "2" SCREEN.Proc "Main.SetFocusBtn", "send_btn"
'End Select

If LEDGER.Next = "Y" Then
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End If

SCREEN.Object("main.OBJECT0").Proc "Set_focus", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zpwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	'트리거 날리기
	S1301.DATA = Trim(GRID0.GetGridCell(GRID0.Row, 6))

	If S1301.DATA = "" Then
		Exit Sub
	End If


	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
If GRID0.HitPos = 3 Then
	Call click_grid()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


