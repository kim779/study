Sub Set_account()
	SCREEN.ClearAll 2, 2

	If Trim(zAppyAcntNo.Data) = "" Then
		zAppyAcntNo.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.Send 0
End Sub

_AW_ONRECEIVE_AW_
Dim i, jongmok, Trim_a
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	For i = 1 To GRID0.Rows
		jongmok = Trim(GRID0.GetGridCell(i, 3))

		If Len(jongmok) = 7 Then
			Trim_a = Right(jongmok, 6)
			GRID0.SetGridCell i, 3, Trim_a
		End If
	Next
End If

