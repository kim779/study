_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zPwd.SetFocus
	Else
		If AN98.Visible = False Then
			SCREEN.Object("chk_passwd.IntaccNo").data = AN99.data
		Else
			SCREEN.Object("chk_passwd.IntaccNo").data = AN98.data
		End If
		SCREEN.Object("chk_passwd.Pwd").data = zPwd.Data
		chk_passwd.Send
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
If Len(Trim(zPwd.Data)) < 4 Then
	MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
	zPwd.SetFocus
Else
	If AN98.Visible = False Then
		SCREEN.Object("chk_passwd.IntaccNo").data = AN99.data
	Else
		SCREEN.Object("chk_passwd.IntaccNo").data = AN98.data
	End If
	SCREEN.Object("chk_passwd.Pwd").data = zPwd.Data
	chk_passwd.Send
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


