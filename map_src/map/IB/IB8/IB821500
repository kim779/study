RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim startFlag
startFlag = 1

'== 계좌명, 비밀번호 설정
Sub Set_account(acntCtrl)
	If acntCtrl.Visible = True Then
		SCREEN.ClearAll 0, 2
		obj.ClearAll 2
		GUIDE.Text = ""
		zPwd.Clear

		If Len(Trim(acntCtrl.Data)) = 11 Then
			ACNM.Data = acntCtrl.Name
			zPwd.Data = acntCtrl.Password

'			If Len(Trim(ACNM.Password)) = 44 Then
'				If zPwd.Data <> "HEAD" Then
'					LEDGER.Hsiz = 44
'					LEDGER.Epwd = Trim(ACNM.Password)
'					zPwd.Data = "HEAD"
'				End If
'			End If

			'If SYSTEM.ConnectBy = 0 Then
			'	If Trim(zPwd.Data) = "" Then
			'		zPwd.Data = "9999"
			'	End If
			'End If

			Call selSubTab()
		Else
			acntCtrl.SetFocus
			Exit Sub
		End If
	End If
End Sub

Sub selMainTab()
	GUIDE.Text = ""
	If mainTab.ID = 1 Then
		LABEL0.Text = "종합계좌번호"
		AN98.VIsible False
		AN99.Visible True
		ACNM.SetRect 222, 4, 286, 24
		subTab.SetTabVisible 3, True
		subTab.SetTabVisible 4, True
	Else

		LABEL0.Text = "계좌번호"
		AN98.VIsible True
		AN99.Visible False
		ACNM.SetRect 198, 4, 262, 24
		subTab.SetTabVisible 3, False
		subTab.SetTabVisible 4, False

		If subTab.ID >= 3 Then
			subTab.ID = 1
		End If
	End If

	Call selSubTab()
End Sub

Sub selSubTab()
	If mainTab.ID = 1 Then
		Select Case subTab.ID
			Case 1 : obj.SetObject "IB821511"
			Case 2 :
				SCREEN.Proc "obj.IBK_Input_Visible", ""
				obj.SetObject "IB821512"
			Case 3 : obj.SetObject "IB821513"
			Case 4 : obj.SetObject "IB821514"
		End Select
	Else
		If subTab.ID = 1 Then
			Dim acntTp

			If Trim(AN98.Data) = "" Then
				Call alert_msg("계좌번호를 확인하여 주십시오.")
				AN98.SetFocus
				Exit Sub
			End If

			acntTp = Mid(Trim(AN98.Data), 4, 2)

			Select Case acntTp
				Case "10", "11", "12", "51", "52"		: obj.SetObject "IB82152A"	'------ 위탁
				Case "20", "21"           		  		: obj.SetObject "IB82152B"	'------ 선물
				Case "30", "31", "37"	    	 		: obj.SetObject "IB82152C"	'------ 저축
				Case "53", "55", "57"         	  		: obj.SetObject "IB82152D"	'------ 수익증권
				Case Else
					obj.SetObject "IB82152A"
					Exit Sub
			End Select
		Else
			obj.SetObject "IB821522"
		End If
	End If
	If startFlag = 2 Then
		Call send_f()
	End If
End Sub

Sub send_f()
	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zPwd.SetFocus
	Else
		If mainTab.ID = 1 Then
			If subTab.ID = 1 Then
				SCREEN.Proc "obj.obj.send_f", ""
			Else
				SCREEN.Proc "obj.send_f", ""
			End If
		Else
			SCREEN.Proc "obj.send_f", ""
			SCREEN.Proc "obj.object0.send_f", ""
		End If
	End If
End Sub


Sub passPW()
	startFlag = 2
	Call send_f()
End Sub

