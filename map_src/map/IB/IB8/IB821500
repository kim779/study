AN98.Visible = False
AN99.visible = True

Call selMainTab()

Dim ipop
ipop = SYSTEM.Pop("IB821500")
SYSTEM.Push "IB821500", "0"
If ipop = "1" Then
	subTab.ID = 2
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
