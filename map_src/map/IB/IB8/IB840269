				' 상품위험등급 > 고객투자성향
				'---------------------------------------------------------------
				If Trim(zGrdNm.Data) <> "적극투자형" And Trim(zGrdNm.Data) <> "공격투자형" Then
					' Domino : 계좌번호, 종목번호(Standard), 종목번호(Full), 고객투자성향
					dmsg = "acct" 	   	   & vbTab & Trim(acct.Data) 		 & vbLf  &_
						   "f_num" 	   	   & vbTab & Trim(f_num.Data) 		 & vbLf  &_
						   "full_f_num"    & vbTab & Trim(full_f_num.Data)   & vbLf  &_
						   "zGrdNm"    	   & vbTab & Trim(zGrdNm.Data)   & vbLf
					SCREEN.CreateWindow 2, "IB84025C /p5 /d", dmsg

					retn = Trim(SYSTEM.Pop ("public_masu_confirm"))
					If Trim(retn) <> "YES" Then
						msg =	"공모주청약을 위해서는 " & vbLf &_
								"투자성향에 적합(적정)하지 않은 상품에 대한 " & vbLf &_
								"거래 의사 확인이 필요합니다." & vbLf & vbLf &_
								"공모주청약을 다시 진행하여 주십시오."
						MsgBox msg, , "IBK투자증권"
						Exit Sub
					End If

					' 투자성향 부적정에 대한 거래의사 등록 후 주문 실행
					SCREEN.Proc "parent.Order", ""

				Else
					' 투자 성향에 적합하면 청약 주문 실행
					SCREEN.Proc "parent.Order", ""
				End If
				'---------------------------------------------------------------

			Else
				'---------------------------------------------------------------
				' 최종고객성향 미존재
				'---------------------------------------------------------------

				'정보제공요건
				If Trim(OUTPUT7.Data) = "0" And Trim(OUTPUT8.Data) = "0" Then
					'---------------------------------------------------------------
					'투자권유 미희망 투자자정보제공 미제공일 경우 주문 진행
					'---------------------------------------------------------------
					' 투자성향 부적정에 대한 거래의사 등록 후 주문 실행
					SCREEN.Proc "parent.Order", ""

				Else
					'---------------------------------------------------------------
					' 투자정보 미등록인 경우 - 여기 이 케이스 생기려나 모르겠음
					'---------------------------------------------------------------
					SCREEN.Object("parent.cus_status").Data = "미등록"

					' 투자권유확인 (YES / NO)
					dmsg = "checkregi" & vbTab & "NO" & vbLf
					SCREEN.CreateWindow 2, "IB84025A /p5 /d", dmsg

					retn = Trim(SYSTEM.Pop("send_update"))
					Select Case retn
					Case "OK"	' 투자정보확인서 Default 값으로 등록 후 프로세스 진행
								' 투자자구분1 : 일반금융소비자
								' 투자자구분2 : 해당없음
								' 투자권유희망여부 : 희망하지 않음
								' 투자자정보제공여부 : 제공하지 않음
								' 본인대리인구분 : 본인

						' bFlag2가 NO인 경우 send_update()에서 신규 등록으로 진행
						bFlag2 = "NO"
						send_update()
					Case Else
						msg = "투자권유를 희망하거나, 투자자정보 제공 후 청약이 가능합니다."
						MsgBox msg, , "IBK투자증권"
						SCREEN.CreateWindow 1, "IB821200 /p5", ""

						' 주문 상태 해제
						SCREEN.Object("Parent.isOrder").Data = "0"
						Exit Sub
					End Select
					'---------------------------------------------------------------
				End If
			End If
		End If
	End If



Case Else	' 조회 로직 :: Enable Components
		' 기존 로직에서는 투자자 등록이 된 경우에만 Components를 Enable 시켰기에
		' 그 로직을 그대로 재활용
		' TO-BE에서는 청약 주문 시 투자자 등록 여부 등을 확인하는 로직으로 변경되었다
		' 2023.12.19
		SCREEN.Object("parent.cus_status").Data = ""
		SCREEN.Object("parent.zTujaReg_YN").Data = "Y"


		'==============================================================
		'계좌방식에 따라(은행예수금 or 증권예수금) 각 component들 세팅
		'==============================================================
		SCREEN.Proc "parent.setTJSMReg", ""

		' 투자설명서 교부 여부 확인 :: 기 교부된 경우 간단한 팝업으로 교부 여부를 사용자에게 안내한다.
		SCREEN.Proc "parent.obj_chkTJSMDown.send_f", ""


End Select

