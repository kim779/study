_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub addCompany()
	Dim ii, indx, chk, accn, text, acnm

	VIEWGRID.Clear()

	' VIEWGRID Start Count
	indx = 1

	' GRID0 Data to VIEWGRID
	For ii = 1 To GRID0.Rows


		' 계좌명
		acnm  = Trim(GRID0.GetGridCell (ii, 2))

		' 유효 계좌 확인 및 VIEWGRID Insert
		For jj = 1 To GRID0.Columns
			chk = ""
			Select Case jj
			Case 5  ' 위탁
				' 계좌 유효 확인
				chk  = Trim(GRID0.GetGridCell (ii, jj))
				text = "위탁"

			Case 7  ' 증권저축
				' 계좌 유효 확인
				chk  = Trim(GRID0.GetGridCell (ii, jj))
				text = "증권저축"

			Case 9  ' 선물옵션
				' 계좌 유효 확인
				chk  = Trim(GRID0.GetGridCell (ii, jj))
				text = "선물옵션"

			Case 11	' 투자신탁
				' 계좌 유효 확인
				chk  = Trim(GRID0.GetGridCell (ii, jj))
				text = "투자신탁"

			Case Else
				' DO NOTHING
			End Select

			If chk = "활동" Then	' 유효 계좌
				accn = Trim(GRID0.GetGridCell (ii, jj-1))	' 계좌번호

				' 계좌입력
				Call insert_row (indx, accn, text, acnm)
				indx = indx + 1
			End If

		Next
	Next

	For ii = 1 To VIEWGRID.Rows

	Next
End Sub

' VIEWGRID에 계좌 입력
Sub insert_row(i_indx, i_accn, i_text, i_acnm)
	VIEWGRID.InsertRow (i_indx)
	VIEWGRID.SetGridCell i_indx, 1, "068"			' 당사코드
	VIEWGRID.SetGridCell i_indx, 2, "IBK투자증권"	' 당사명
	VIEWGRID.SetGridCell i_indx, 3, Trim(i_accn)	' 계좌번호
	VIEWGRID.SetGridCell i_indx, 4, Trim(i_text)	' 계좌구분
	VIEWGRID.SetGridCell i_indx, 5, Trim(i_acnm)	' 계좌명
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
SYSTEM.Push "MyACCN", "Cancel"
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"

' 고객정보구분
i_gubn.Data = "2"

' 계좌상태코드
i_stat.Data = "00"

' 지점번호
i_brno.Data = "000"

' 고객확인번호
i_juno.Data = Trim(LOGIN.Juno)


SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If LEDGER.Next = "Y" Then
		' 연속 조회
		Call send_c()
	Else
		' 당사 코드 세팅
		Call addCompany()
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim bnkCode, bnkName, bnkAcntNo, bnkAcntNm, bnkAcntNick
bnkCode = Trim(GRID0.GetGridCell(GRID0.Row, 1))
bnkName = Trim(GRID0.GetGridCell(GRID0.Row, 2))
bnkAcntNo = Trim(GRID0.GetGridCell(GRID0.Row, 3))
bnkAcntNm = Trim(GRID0.GetGridCell(GRID0.Row, 4))
bnkAcntNick = Trim(GRID0.GetGridCell(GRID0.Row, 5))

If GRID0.Column <> "6" Then
	SYSTEM.Push "MyACCN", "OK"
	SYSTEM.Push "bank_code", bnkCode
	SYSTEM.Push "bank_name", Trim(GRID0.GetGridCell(GRID0.row, 2))
	SYSTEM.Push "bank_acctNum", bnkAcntNo
	SYSTEM.Push "bank_Nick", Trim(GRID0.GetGridCell(GRID0.row, 5))
	SCREEN.CloseWindow
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(VIEWGRID)
_AW_ONCLICK_AW_
If VIEWGRID.HitPos <> 3 Then
	Exit Sub
End If

Dim bnkCode, bnkName, bnkAcntNo, bnkAcntNm, bnkAcntNick
bnkCode = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 1))			' 금융코드
bnkName = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 2))			' 금융기관명
bnkAcntNo = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 3))			' 계좌번호
bnkAcntNm = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 5))			' 계좌구분
bnkAcntNick = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 4))		' 계좌명


SYSTEM.Push "MyACCN", "OK"
SYSTEM.Push "bank_code", bnkCode
SYSTEM.Push "bank_name", bnkName
SYSTEM.Push "bank_acctNum", bnkAcntNo
SYSTEM.Push "bank_Nick", Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 4))
SYSTEM.Push "bnkAcntNm", Trim(bnkAcntNm)

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


