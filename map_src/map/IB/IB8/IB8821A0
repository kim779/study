RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_ArrItem
Dim g_ArrData
Dim g_ArrCtrls

'Index :
'	0 - 종목코드
'	1 - 매도호가
'	2 - 매도수량
'	3 - 매수호가
'	4 - 매수수량
'	5 - 행사가격
g_ArrItem = Array("", 0, 0, 0, 0, 0)

'Index :
'	0 - 선물
'	1 - 콜옵션
'	2 - 풋옵션
g_ArrData = Array(g_ArrItem, g_ArrItem, g_ArrItem)

g_ArrCtrls = Array(Array(ot_Con, ot_ConVol, ot_Rev, ot_RevVol),_
	Array(rb_Con, rb_Rev))
'------------------------------------------------------
Sub SendData(FutItemCd, OptItemCd)
	FUT_OBJ.Proc "SendFutData", FutItemCd
	COPT_OBJ.Proc "SendOptData", "2" & Mid(OptItemCd, 2, 7)
	POPT_OBJ.Proc "SendOptData", "3" & Mid(OptItemCd, 2, 7)
End Sub
'------------------------------------------------------
Sub SetData(Data)
	ArrData = Split(Data, "|")

	Index = -1
	If Mid(ArrData(0), 1, 1) = "1" Or Mid(ArrData(0), 1, 1) = "A" Then			'선물
		Index = 0
	ElseIf Mid(ArrData(0), 1, 1) = "2" Or Mid(ArrData(0), 1, 1) = "B" Then		'콜옵션
		Index = 1
	ElseIf Mid(ArrData(0), 1, 1) = "3" Or Mid(ArrData(0), 1, 1) = "C" Then		'풋옵션
		Index = 2
	Else
		Exit Sub
	End If

	For i = LBound(g_ArrData(Index)) To UBound(g_ArrData(Index))
		'SYSTEM.Trace i & "|" & ArrData(i)
		If Index = 2 Then
			'SYSTEM.
		End If
		If i > 0 Then
			g_ArrData(Index)(i) = Abs(CDbl(ArrData(i)))
		Else
			g_ArrData(Index)(i) = ArrData(i)
		End If
	Next
	CalcData
End Sub
'------------------------------------------------------
Function GetMinVol(ArrVolData)
	GetMinVol = ArrVolData(0)

	For i = 1 To UBound(ArrVolData)
		If GetMinVol > ArrVolData(i) Then
			GetMinVol = ArrVolData(i)
		End If
	Next
End Function
'------------------------------------------------------
Sub CalcData()
	If Len(g_ArrData(1)(0)) = 0 Or Len(g_ArrData(2)(0)) = 0 Then
		Exit Sub
	End If

	'SYSTEM.Trace g_ArrData(1)(3)
	ExerPrc = g_ArrData(1)(5)

	ArrVolData = Array(0, 0, 0)
	'컨버젼
	FutAskPrc = g_ArrData(0)(1)
	CBidPrc = g_ArrData(1)(3)
	PAskPrc = g_ArrData(2)(1)

	If FutAskPrc = 0 Or CBidPrc = 0 Or PAskPrc = 0 Then
		Exit Sub
	End If

	Con = ExerPrc + CBidPrc - PAskPrc - FutAskPrc
	'LABEL0.Data Con & "|" & ExerPrc & "|" & CBidPrc & "|" & PAskPrc & "|" & FutAskPrc
	ArrVolData(0) = g_ArrData(0)(2)
	ArrVolData(1) = g_ArrData(1)(4)
	ArrVolData(2) = g_ArrData(2)(2)

	Vol = GetMinVol(ArrVolData)
	If Con > 0 Then
		g_ArrCtrls(0)(0).Data = "+" & FormatNumber(Con, 2, -2, -2, 0)
	Else
		g_ArrCtrls(0)(0).Data = FormatNumber(Con, 2, -2, -2, 0)
	End If
	g_ArrCtrls(0)(1).Data = Vol
	'리버셜
	FutBidPrc = g_ArrData(0)(3)
	CAskPrc = g_ArrData(1)(1)
	PBidPrc = g_ArrData(2)(3)

	If FutBidPrc = 0 Or CAskPrc = 0 Or PBidPrc = 0 Then
		Exit Sub
	End If
	Rev = FutBidPrc - (ExerPrc + CAskPrc - PBidPrc)

	ArrVolData(0) = CLng(g_ArrData(0)(4))
	ArrVolData(1) = CLng(g_ArrData(1)(2))
	ArrVolData(2) = CLng(g_ArrData(2)(4))
	Vol = GetMinVol(ArrVolData)

	If Rev > 0 Then
		g_ArrCtrls(0)(2).Data = "+" & FormatNumber(Rev, 2, -2, -2, 0)
	Else
		g_ArrCtrls(0)(2).Data = FormatNumber(Rev, 2, -2, -2, 0)
	End If
	g_ArrCtrls(0)(3).Data = Vol

	ExecOrder

End Sub
'-------------------------------------------------------------------------------------
Function GetData(StrData, DataType)
	GetData = 0

	Data = Trim(StrData)
	If Len(Data) = 0 Then
		Exit Function
	Else
		If DataType = 1 Then			'CDBL
			GetData = CDbl(Data)
		Else							'CLNG
			GetData = CLng(Data)
		End If
	End If
End Function
'------------------------------------------------------
Sub ExecOrder()
	If Not ck_Order.Checked Then
		Exit Sub
	End If

	SetValue = GetData(ed_Prc.Data, 2)/100
	SetVol = GetData(ed_Vol.Data, 1)

	If SetVol = 0 Then
		Exit Sub
	End If

	OrdValue = 0
	OrdVol = 0

	'LABEL0.Data = "STEP 0"

	'0:종목코드, 1:매도(1), 매수(3), 2:가격, 3:수량
	FutArrItem = Array("", 0, 0, 0)
	COptArrItem = Array("", 0, 0, 0)
	POptArrItem = Array("", 0, 0, 0)
	If rb_Con.Checked Then				'컨버젼
		OrdValue = GetData(ot_Con.Data, 1)
		OrdVol = GetData(ot_ConVol.Data, 2)

		'LABEL0.Data = OrdValue & "|" & SetValue & "|" & ot_Con.Data

		If OrdVol = 0 Then
			Exit Sub
		End If

		If SetVol > OrdVol Then
			Exit Sub
		End If

		If SetValue > OrdValue Then
			Exit Sub
		End If

		If OrdVol > SetVol Then
			OrdVol = SetVol
		End If

		SetItem 0, 3, OrdVol, FutArrItem
		SetItem 1, 1, OrdVol*5, COptArrItem
		SetItem 2, 3, OrdVol*5, POptArrItem
	Else								'리버셜
		OrdValue = GetData(ot_Rev.Data, 1)
		OrdVol = GetData(ot_RevVol.Data, 2)
		'LABEL0.Data = "STEP 1"
		If OrdVol = 0 Then
			Exit Sub
		End If
		'LABEL0.Data = "STEP 2"
		If SetVol > OrdVol Then
			Exit Sub
		End If
		'LABEL0.Data = "STEP 3"
		If SetValue > OrdValue Then
			Exit Sub
		End If
		'LABEL0.Data = "STEP 4"

		If OrdVol > SetVol Then
			OrdVol = SetVol
		End If

		SetItem 0, 1, OrdVol, FutArrItem
		SetItem 1, 3, OrdVol*5, COptArrItem
		SetItem 2, 1, OrdVol*5, POptArrItem
	End If
	FData = Join(FutArrItem, "~")
	CData = Join(COptArrItem, "~")
	PData = Join(POptArrItem, "~")

	Data = FData & "|" & CData & "|" & PData
	'LABEL0.Data = OrdVol & "|" & SetVol
	'데이타를 넘겨주는곳
	LABEL0.Data = Data
	ck_Order.Checked = False
End Sub
'------------------------------------------------------
Sub SetItem(ItemIdx, AskBidType, Vol, ArrData)
	ArrData(0) = g_ArrData(ItemIdx)(0)
	ArrData(1) = AskBidType
	ArrData(2) = g_ArrData(ItemIdx)(AskBidType)
	ArrData(3) = Vol
End Sub

_AW_ONSTART_AW_
ed_Prc.SetRange -99999999, 99999999
ed_Prc.SetType 370

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ot_Con)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ot_ConVol)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ot_Rev)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ot_RevVol)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
FutItemCd = "101F6000"
OptItemCd = "201F4280"
LABEL0.Data = ""
SendData FutItemCd, OptItemCd
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



