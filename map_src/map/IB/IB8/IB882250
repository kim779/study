Sub LoadLastStat()
	Dim jprc, jqty
	jprc = SYSTEM.Pop("IB8822_JPRC")
	jqty = SYSTEM.Pop("IB8822_JQTY")

'	SYSTEM.Trace "jprc = " & jprc
'	SYSTEM.Trace "jqyt = " & jqty
	If Not IsNull(jprc) Then
		ed_jprc.Data = jprc
	End If

	If Not IsNull(jqty) And Trim(jqty)<>"" Then
		ed_jqty.Data = jqty
	Else
		ed_jqty.Data = "0"
	End If
End Sub

Sub SaveLastStat()
	SYSTEM.Push "IB8822_JPRC", ed_jprc.Data
	SYSTEM.Push "IB8822_JQTY", ed_jqty.Data
End Sub

Sub ClearLastStat()
	SYSTEM.Push "IB8822_JPRC", ""
	SYSTEM.Push "IB8822_JQTY", ""

	' 스프레드 종목은 주문 직후 주문이 나갈 수 없게, 주문단가를 Clear
	If Left(Trim(ed_fcod.Data), 1) = "4" Or Left(Trim(ed_fcod.Data), 1) = "D"  Then
		ed_jprc.Clear
	End If
End Sub

Sub SettHoga()
	' 스프레드 종목은 탭 변경 직후 주문이 나갈 수 없게, 주문단가를 Clear
	If Left(Trim(ed_fcod.Data), 1) = "4" Or Left(Trim(ed_fcod.Data), 1) = "D"  Then
		ed_jprc.Clear
	End If
End Sub

