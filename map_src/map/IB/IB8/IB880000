_AW_ONDECLARE_AW_

Sub send_f()
	SCREEN.ClearAll 0, 2
	total_order.Data = "0"
	total_chg.Data = "0"
	total_buy.Data = "0"
	total_sell.Data = "0"
	total_trade.Data = "0"
	chg_rate.Data = "0.00"
	tot_fee_sell.Data = "0"
	tot_fee_buy.Data = "0"

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub GroupComboChange()
	CONTROL0.SetFilterAcc "00000000"
	total_order.Data = "0"
	total_chg.Data = "0"
	total_buy.Data = "0"
	total_sell.Data = "0"
	total_trade.Data = "0"
	chg_rate.Data = "0.00"
	tot_fee_sell.Data = "0"
	tot_fee_buy.Data = "0"

	acc_gb.Data = COMBO0.Data
	SCREEN.Object("OBJECT2.GRID1").Clear
	GRID0.Clear

	If COMBO0.Data = "1" Then
		send_btn.Enable = False
		grp_no.Data = SCREEN.Object("OBJECT0.Grid0").GetGridCell(COMBO0.Index+1, 1)

		SCREEN.Object("OBJECT1.grp_no").data = grp_no.Data
		SCREEN.Object("OBJECT1.grp_name").data = SCREEN.Object("OBJECT0.Grid0").GetGridCell(COMBO0.Index+1, 2)
		OBJECT1.Send
	Else
		send_f()
	End If
End Sub

Sub Tree_Click()

If CHECK0.Checked Then
	CONTROL1.Visible(True)
	GRID0.Visible = False
Else
	CONTROL1.Visible(False)
	GRID0.Visible = True
End If

End Sub

Sub Expand_Click()

If CHECK1.Checked Then
	CONTROL1.ExpandTree( True )
Else
	CONTROL1.ExpandTree( False )
End If

End Sub


'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Function Find_Row(acc_no, mtp,code)


	For row = 1 To GRID0.Rows
		If Trim(acc_no) = Trim(GRID0.GetGridCell (row, 2)) _
				And Trim(mtp) = Trim(GRID0.GetGridCell (row, 4)) _
				And Trim(code) = Trim(GRID0.GetGridCell (row, 6)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

Function Add_Alert( row, b )

Dim str

	For col = 1 To GRID0.Columns
		str = str & GRID0.GetGridCell( row, col )
		str = str & vbTab
	Next
	str = str & vbNewLine

	If b = True Then
		CONTROL1.RemoveAlert( str )
	Else
		CONTROL1.AddAlert(str)
	End If

End Function

