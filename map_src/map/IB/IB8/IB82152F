_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
SCREEN.OnSend = False

zPwd = SCREEN.Object("main.zPwd").data

If Len(Trim(zPwd)) < 4 Then
	Exit Sub
End If


EDIT0.Data = "00001"
AcntNo.Data = SCREEN.Object("main.AN98").data
AccountType = Mid(AcntNo.Data, 4,2)
If AccountType = "10" Or AccountType = "11" Then
	TrxTp.Data = "3"
ElseIf AccountType = "20" Then
	TrxTp.Data = "2"
Else
	Exit Sub
End If

pwd.Data = zPwd


SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
BascMny = OUTPUT2.Data
BascMny = Mid(BascMny, 2, 15)

If Len(Trim(BascMny)) > 0 Then
	BascMny = FormatNumber(BascMny, 0)
	SCREEN.Object("parent.BscMny").data = BascMny
End If

Select Case InvstrTp.Data
Case "1"
	SCREEN.Object("parent.InvstrTp").data = "기존투자자요건충족자(전문개인투자자 대우)"
Case "2"
	SCREEN.Object("parent.InvstrTp").data = "신규투자자(사전교육, 모의투자 이수 후 선물매매가능)"
Case "3"
	SCREEN.Object("parent.InvstrTp").data = "신규투자자(사전교육,모의투자 이수 및 거래 경험 충족 후 선물옵션매매 가능)"
End Select

