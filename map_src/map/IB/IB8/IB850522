_AW_ONDECLARE_AW_
Option Explicit

Dim Today
Today = getCurrDay()

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2

	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888
#Load IB888833

_AW_ONENDSUB_AW_
