_AW_ONDECLARE_AW_
Dim c_item, c_list
Dim ii
Dim idx_ini_nm, idx_sect_nm, idx_sect_key

Function fill_space(item)
	Dim pos, char, rlen

	rlen = 0
	For pos = 1 To Len(item)
		char = Mid(item, pos, 1)
		If Asc(char) < 0 Then
			rlen = rlen + 2
		Else
			rlen = rlen + 1
		End If
	Next

	For ii = rlen+1 To 100 Step 1
		item = item & " "
	Next

	fill_space = item
End Function

c_item = "-- 선택 --"
c_item = fill_space(c_item)
c_list = c_item & vbTab & c_item & c_item

Sub combo_start()
	INI_NM.SetItems(c_list)
	SECT_NM.SetItems(c_list)
	SECT_KEY.SetItems(c_list)
End Sub

Sub combo_set(col_n)
	Dim row_n, data, list, index, ii, jj, item
	list = ""
	list = c_list
	GRID0.Column = col_n

	For row_n = 1 To GRID0.Rows
		GRID0.Row = row_n
		item = Trim(GRID0.text)
		ii = 0
		If row_n > 1 Then
			For ii = row_n-1 To 1 Step -1
				GRID0.Row = ii
				If item = Trim(GRID0.Data) Then
					Exit For
				End If
			Next
		End If
		If ii = 0 Then
			item = fill_space(item)
			list = list & vbTab & item & item
		End If
	Next
	If col_n = "2" Then
		INI_NM.Setitems list
	ElseIf col_n = "3" Then
		SECT_NM.Setitems list
	ElseIf col_n = "4" Then
		SECT_KEY.Setitems list
	End If
End Sub

Sub re_combo_set(col_n)
	Dim list, item
	list = ""
	list = c_list
	GRID0.Column = col_n

	If col_n = "2" Then
		item = INI_NM.Text
		list = list & vbTab & item & item
		INI_NM.Setitems list
		INI_NM.Index = 1
	ElseIf col_n = "3" Then
		item = SECT_NM.Text
		list = list & vbTab & item & item
		SECT_NM.Setitems list
		SECT_NM.Index = 1
	ElseIf col_n = "4" Then
		item = SECT_KEY.Text
		list = list & vbTab & item & item
		SECT_KEY.Setitems list
		SECT_KEY.Index = 1
	End If
End Sub

_AW_ONSTART_AW_
combo_start()
user_id.SetFocus()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If idx_ini_nm = 0 Then
	combo_set("2")
Else
	re_combo_set("2")
End If

If idx_sect_nm = 0 Then
	combo_set("3")
Else
	re_combo_set("3")
End If

If idx_sect_key = 0 Then
	combo_set("4")
Else
	re_combo_set("4")
End If

idx_ini_nm=INI_NM.Index
idx_sect_nm = SECT_NM.Index
idx_sect_key = SECT_KEY.index

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(user_id)
_AW_ONCHANGE_AW_
combo_start()
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


