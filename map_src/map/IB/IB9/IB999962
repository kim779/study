'--------------------------------------------------------------------------
Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function

Sub CloseScreen(sval)
	SYSTEM.Push "999963closed", 1
	SCREEN.CloseWindow()
End Sub

Function check_edge()
	check_edge = 0
	Dim val
	If SCREEN.CreateObject("Info") Then
		val = Trim(INFO.PopData(LOGIN.Name, myFILE, "PDF_CONFIRM", "pop"))
		If val = "browser" Then
			check_edge = 1
		Else
			check_edge = 0
		End If
	End If

End Function

