Sub change_option(gubn)
	OrdCfg.ItemCd = ed_cfocod.Data
	If (mmgb = "1" Or mmgb = "2") And gubn = "account" Then
		'단가설정
		If c_hogb.Data = "00" Or c_hogb.Data = "05" Then			'지정, 조건부지정
