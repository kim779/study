					Exit Function
				End If

				If ed_jprc.Enable = True And IsNumeric(ed_jprc.Data) = False Then
					MsgBox sen & "실행가격을 확인하십시오.", , "IBK투자증권"
					ed_jprc.SetFocus
					Exit Function
				End If

				If jumunGb = "OCO" Then
					sen = "낮은 조건의 "

					If IsNumeric(ed_jprc_lowCon.Data) = False Then
						MsgBox sen & "조건가격을 확인하십시오.", , "IBK투자증권"
