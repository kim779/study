'***************************************************************************
' 주식 정정/취소시 원주문번호,주문단가 셋팅
'***************************************************************************
Sub Get_jmno()
	Dim ret, prc, num, cPos

	num = SYSTEM.Pop ("F_ogno")
	If num <> "" Then
		prc = SYSTEM.Pop ("F_jprc")
		SYSTEM.Push "F_ogno", ""
		SYSTEM.Push "F_jprc", ""
	Else
		o_jmno.data = ""
		num = SYSTEM.Pop ("FO_ogno")
		prc = SYSTEM.Pop ("FO_jprc")
	End If

	If Trim(num) <> "000000" Or Trim(num) <> ""Then
		ed_ogno.data = num
	End If

	Select Case SCREEN.Object("parent.tab_order").ID
		Case 3, 4
			If Trim(prc) <> "" Then
				If OrdCfg.ReadCfg("JJPrcGb") = "2" Then
					'정정주문의 주문단가 조회
					ed_jprc.data = prc

					If jumunGb <> "Stop" Then
						ed_jprc_con.data = prc

						If jumunGb = "OCO" Then
							ed_jprc_lowCon.data = prc
							ed_jprc_low.data = prc
						End If
					End If
				End If
			End If
	End Select
End Sub


'***************************************************************************
' 선물/옵션 주문 포커스 관리(정정/취소)
'***************************************************************************
Sub ogno_focus()
	Dim cPos, flag

	If Trim(ed_ogno.data) = "" Or Trim(ed_ogno.data) < "1" Then
		flag = False
	Else
		flag = True
	End If

	If flag = True Then
		If Trim(SCREEN.Object("parent.AN20").data) = "" Or Trim(ed_pswd.data) = "" Then
			SCREEN.SetTimer 1, False
			Exit Sub
		End If

		If OrdCfg.OrderGB = "2" Then					'정정일때만 커서 셋팅
			cPos = OrdCfg.ReadCfg("JJCursorPos")	'수량,유형,가격
			Select Case cPos
				Case "0" : ed_jqty.Setfocus
				Case "1" : ed_hogb.Setfocus
				Case "2" : ed_jqty.Setfocus 'ed_jprc.Setfocus
			End Select
		ElseIf OrdCfg.OrderGB = "3" Then
			JUMUN_B.Setfocus
		End If
	Else
		cPos = OrdCfg.ReadCfg("NotMoveCode") '커서유지

		If cPos = "1"Then
			ed_cfocod.Setfocus
		Else
			SCREEN.SetTimer 2, False
		End If
	End If
End Sub


