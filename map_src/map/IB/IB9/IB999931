'***************************************************************************
' DESC: 호가조건 ComboBox 전환시 Setting
'			00:지정가 03:시장가 05:조건부지정가 06:최유리지정가
'			07:최우선지정가 09:자사주 10:자사주스톡옵션 12:자사주신탁
'			61:장개시전시간외 81:시간외종가 91:시간외단일가
'        호가구분에따라 단가를 enable/disable
'***************************************************************************
Sub Set_comb_hogb()
SCREEN.IgnoreChange True
	ed_hogb.Data = c_hogb.Data

	Select Case c_hogb.Data
		Case "00", "10", "20"			'보통/지정가(' ', IOC, FOK)
			ed_jprc.Enable = True

			If jumunGb = "OCO" Then
				ed_jprc_low.Enable = True
				o_hogb.Enable = True
			End If
		Case "03", "13", "23"			'시장가(' ', IOC, FOK)
			ed_jprc.Data = "0"
			ed_jprc.Enable = False

			If jumunGb = "OCO" Then
				ed_jprc_low.Data = "0"
				ed_jprc_low.Enable = False

				o_hogb.Data = 0
				o_hogb.Enable = False
			End If
		Case "05"						'조건부
			ed_jprc.Enable = True

			If jumunGb = "OCO" Then
				ed_jprc_low.Enable = True
				o_hogb.Enable = True
			End If
		Case "06", "16", "26", "07"		'최유리(' ', IOC, FOK), 최우선
			ed_jprc.Data = "0"
			'ed_jprc_con.Data = "0"

			ed_jprc.Enable = False

			If jumunGb = "OCO" Then
				'ed_jprc_lowCon.Data = "0"
				ed_jprc_low.Data = "0"

				ed_jprc_low.Enable = False

				o_hogb.Data = 0
				o_hogb.Enable = False
			End If
		Case "61", "81"				'장전시간외(61), 장마감시간외(81)
			ed_jprc.Data = "0"
			'ed_jprc_con.Data = "0"

			ed_jprc.Enable = False

			If jumunGb = "OCO" Then
				'ed_jprc_lowCon.Data = "0"
				ed_jprc_low.Data = "0"

				ed_jprc_low.Enable = False
			End If
	End Select

	c_pric.Enable = ed_jprc.Enable
	If jumunGb = "OCO" Then
		c_pric_low.Enable = ed_jprc_low.Enable
	End If

	'-- 주문조건 (0:없음, 1:IOC, 2:FOK)
	ed_hogb.Data = c_hogb.Data
	ed_jmgb.Data = o_hogb.Data			'0:일반, 1:FOC, 2:IOC
SCREEN.IgnoreChange False
End Sub


'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Error_check = False

	Dim mstr

	If Trim(ed_acno.Data) = "" Then
		SCREEN.Object("parent.AN20").SetFocus
		MsgBox "계좌번호를 확인하십시오.", , "IBK투자증권"
		Exit Function
	End If

	If Len(Trim(ed_pswd.Data)) < 4 Then
		SCREEN.Object("parent.ed_pswd").SetFocus
		MsgBox "비밀번호를 확인하십시오.", , "IBK투자증권"
		Exit Function
	End If

	If Left(Trim(ed_cfocod.Data), 1) = "4" Or Left(Trim(ed_cfocod.Data), 1) = "D" Then
		MsgBox "스프레드 종목은 주문이 불가능합니다.", , "IBK투자증권"
		Exit Function
	End If

	Select Case mmgb
		Case "1" : mstr = "매도"
		Case "2" : mstr = "매수"
		Case "3" : mstr = "정정"
		Case "4" : mstr = "취소"
	End Select

	If mstr = "정정" Or mstr = "취소" Then
		If Is_numeric(ed_ogno.Data) = False Then
			MsgBox "원주문번호를 확인하십시오.", , "IBK투자증권"
			ed_ogno.SetFocus
			Exit Function
		End If
	End If

	'주문수량 check
	If ed_jqty.Enable = True And Is_numeric(ed_jqty.Data) = False Then
		MsgBox mstr & "수량을 입력하십시오.", , "IBK투자증권"
		ed_jqty.SetFocus
		Exit Function
	End If

	'주문단가 check
	Dim sen

	If mstr <> "취소" Then
		If Left(ed_cfocod.Data, 1) <> "4" And Left(ed_cfocod.Data, 1) <> "D" Then
			If jumunGb = "Stop" Or jumunGb = "StopLimit" Then
				sen = ""
			ElseIf jumunGb = "OCO" Then
				sen = "높은조건의 "
			End If

			If jumunGb = "Stop" Then
				If ed_jprc.Enable = True And Is_numeric(ed_jprc.Data) = False Then
					MsgBox sen & "조건가격을 확인하십시오.", , "IBK투자증권"
					ed_jprc.SetFocus
					Exit Function
				End If
			Else
				If Is_numeric(ed_jprc_con.Data) = False Then
					MsgBox sen & "조건가격을 확인하십시오.", , "IBK투자증권"
					ed_jprc_con.SetFocus
					Exit Function
				End If

				If ed_jprc.Enable = True And Is_numeric(ed_jprc.Data) = False Then
					MsgBox sen & "실행가격을 확인하십시오.", , "IBK투자증권"
					ed_jprc.SetFocus
					Exit Function
				End If

				If jumunGb = "OCO" Then
					sen = "낮은 조건의 "

					If Is_numeric(ed_jprc_lowCon.Data) = False Then
						MsgBox sen & "조건가격을 확인하십시오.", , "IBK투자증권"
						ed_jprc_lowCon.SetFocus
						Exit Function
					End If

					If ed_jprc_low.Enable = True And Is_numeric(ed_jprc_low.Data) = False Then
						MsgBox sen & "실행가격을 확인하십시오.", , "IBK투자증권"
						ed_jprc_low.SetFocus
						Exit Function
					End If
				End If
			End If
		Else	'스프레드
			If jumunGb = "StopLimit" Then
				sen = ""
			ElseIf jumunGb = "OCO" Then
				sen = "높은조건의 "
			End If

			If jumunGb = "Stop" Then
				If ed_jprc.Enable = True And IsNumeric(ed_jprc.Data) = False Then
					MsgBox sen & "조건가격을 확인하십시오.", , "IBK투자증권"
					ed_jprc.SetFocus
					Exit Function
				End If
			Else
				If IsNumeric(ed_jprc_con.Data) = False Then
					MsgBox sen & "조건가격을 확인하십시오.", , "IBK투자증권"
