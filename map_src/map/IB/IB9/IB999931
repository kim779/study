						ed_jprc_low.SetFocus
						Exit Function
					End If
				End If
			End If
		End If
	End If

	'주문착오방지를 위한 모범규준 check
	If chk_mistake_order(ed_cfocod.Data) = False Then
		Exit Function
	End If

	If Condition_check = False Then
		Exit Function
	End If

	Error_check = True
End Function


