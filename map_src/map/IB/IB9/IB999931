Dim mmgb, jumunGb, yn	'jumunGb : STOPLIMIT 주문인지 OCO주문인지 구분. 각 화면 declaration에서 설정.

Function l_Null_check(Data)
    l_Null_check = Data
    If Trim(data) = "" Then
        l_Null_check = "NO"
        Exit Function
    End If
End Function

'****************************************************************************
' input: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
'****************************************************************************
Sub SetConfig()
	SCREEN.Object("parent.AN20").TabStop = OrdCfg.TabAccount
	SCREEN.Object("parent.ed_pswd").TabStop = OrdCfg.TabPassword

	ed_cfocod.TabStop = OrdCfg.TabCode
	ed_jqty.TabStop = OrdCfg.TabQty
	JUMUN_B.TabStop = OrdCfg.TabButton

	If mmgb <> "4" Then
		ed_jprc.TabStop = OrdCfg.TabPrc			'실행가격 or 높은 조건의 실행가격.
		ed_jprc_con.TabStop = OrdCfg.TabPrc		'조건가격 or 높은 조건의 조건가격.
		ed_jprc_lowCon.TabStop = OrdCfg.TabPrc	'낮은조건 조건가격
		ed_jprc_low.TabStop = OrdCfg.TabPrc		'낮은조건 실행가격
	End If

	If mmgb = "1" Or mmgb = "2" Then		'매도/매수 주문시
		c_hogb.TabStop = OrdCfg.TabMMGB
		SCREEN.Proc "parent.Set_Auto", mmgb
	End If

	Select Case mmgb
		Case "1" : cboPrice.Data = OrdCfg.ReadCfg("SellPrcGB")
		Case "2" : cboPrice.Data = OrdCfg.ReadCfg("BuyPrcGB")
'		Case "3" : cboPrice.Data = OrdCfg.ReadCfg("JJPrcGB")
	End Select
End Sub


'***************************************************************************
' DESC: 주문환결설정 Setting
' input: "parent.clearpush + (_buy, _sell, _jj, _cancel)"
'***************************************************************************
Sub init_option(clearpush)
	OrdCfg.PushPrefix = CStr(SCREEN.Major)
	OrdCfg.OrderGB = mmgb-1
	OrdCfg.LoadInfo

	If SCREEN.Object(clearpush).data = "1" Then
		SCREEN.Object(clearpush).data = "0"
		'첫번째 화면실행시에는 메모리정보 Clear
		OrdCfg.ClearPush
	Else
		OrdCfg.Pop
	End If

	OrdCfg.ItemCd = ed_cfocod.Data
	OrdCfg.SetDoQty(True)
	Call QueryOption("common")
	If SCREEN.CreateObject("info") Then
		yn = l_Null_check(Trim(INFO.popdata(LOGIN.name, "userconf.ini", "S-ORD", "ORD_CONF")))
	End If

	If yn = "NO" Then
		chk_OrderConfirm.Checked = SCREEN.Object("parent.chk_OrderConfirm").Checked
	Else
		chk_OrderConfirm.Checked = False
	End If
	'chk_OrderConfirm.Checked = SCREEN.Object("parent.chk_OrderConfirm").Checked
End Sub


'***************************************************************************
' DESC: 주문시 반드시 초기화해야 할 값
'***************************************************************************
Sub init_data()
SCREEN.IgnoreChange True
	ed_acno.Data = SCREEN.Object("parent.AN20").data	'계좌번호
	ed_pswd.Data = SCREEN.Object("parent.ed_pswd").data	'비밀번호

	If ed_prgb.data = "B" Then
		ed_odgb.Data = "3"			'주문유형(예약)

		If mmgb < 4 Then
			If chk_date.checked = True Then
				If Trim(ed_fdate.data) = "" Then ed_fdate.data = LOGIN.Day0
				If Trim(ed_edate.data) = "" Then ed_edate.data = LOGIN.Day0
				ed_gmm.data = "2"&ed_fdate.data&ed_edate.data
			Else
				ed_gmm.data = "1"
			End If
		End If
	Else
		'ed_odgb.Data = "2"			'00:stop  01:stop limit  02:oco '각 주문화면마다 고정.
	End If

	ed_mmgb.Data = mmgb			'매매구분
	ed_cfocod.Data = SCREEN.Object("main.ed_cfocod").Data
	hnam.Data = SCREEN.Object("main.hnam").Data

	Select Case mmgb
		Case "3"
			ed_hogb.data = c_hogb.Data
'			ed_hogb.Data = "99"			'호가구분 - 원주문호가(99)

			If	jumunGb <> "Stop" Then
				ed_jmgb.Data = o_hogb.Data	'주문조건
			End If
		Case "4"
			ed_jprc.Data = ""			'주문단가	'실행가격 or 높은 조건의 실행가격.
			ed_jprc_con.Data = ""		'조건가격 or 높은 조건의 조건가격.
			ed_jprc_lowCon.Data = ""	'낮은조건 조건가격
			ed_jprc_low.Data = ""		'낮은조건 실행가격

			'ed_hogb.Data = ""			'호가구분
			'ed_jmgb.Data = "00"		'주문조건
			ed_hogb.Data = c_hogb.Data

			If jumunGb <> "Stop" Then
				ed_jmgb.Data = o_hogb.Data
			End If
		Case Else
			ed_ogno.Data = ""			'원주문번호
			ed_mdgb.Data = ""			'정정취소
	End Select

	o_jmno.Clear				'주문번호

	SCREEN.Object("main.guide").Text = " "					'메세지
SCREEN.IgnoreChange False
End Sub


'****************************************************************************
' DESC: 주문옵션적용 when: common(주문전), after(주문후)
'****************************************************************************
Sub QueryOption(when)
	Dim qtyOpt, cfgGB, prc, ret

	ret = SYSTEM.Pop ("F_ogno")
	If ret <> "" Then
		Exit Sub
	End If

	If when = "after" Then
		If OrdCfg.KeepQty = False Then		'-- 수량유지안함
			ed_jqty.Data = "0"
		End If

		' 금감원 원칙으로 주문후 원주문번호 clear
		Select Case mmgb
		Case "3", "4"
			ed_ogno.Data = ""
		End Select

		'매매구분 clear
		If mmgb = "3" Or mmgb = "4" Then
			ed_omgb.Clear		'매매구분
			ed_ommgb.Clear  	'미실행조건주문에서 전달받은 매매구분 구분자

			If jumunGb <> "Stop" Then
				ed_ojmgb.Clear		'미실행조건주문에서 전달받은 주문조건 구분자
			End If

			If jumunGb = "OCO" Then
				ed_ohogb.Clear	'미실행조건주문에서 전달받은 호가구분(구분) 구분자
			End If
		End If

		If mmgb <> "4" And OrdCfg.KeepPrc = False Then		'-- 단가유지안함
			ed_jprc.Data = "0"
			ed_jprc_con.Data = "0"					'조건가격 or 높은 조건의 조건가격.
			ed_jprc_lowCon.Data = "0"			'낮은조건 조건가격
			ed_jprc_low.Data = "0"				'낮은조건 실행가격
		End If

		Exit Sub
	End If

	Select Case mmgb
		Case "1" : cfgGB = "SellQtyGB"
		Case "2" : cfgGB = "BuyQtyGB"
		Case "3"
			qtyOpt = OrdCfg.ReadCfg("JJPrcGB")
			Select Case qtyOpt
				Case "0"
					ed_jprc.Data = "0"
					ed_jprc_con.Data = "0"
					ed_jprc_lowCon.Data = "0"
					ed_jprc_low.Data = "0"
				Case "1"
					Call QueryHoga()			'기본단가설정 사용
				Case "2"
					prc = SYSTEM.Pop("FO_jprc")
					If Trim(prc) = "" Then prc = "0"

					ed_jprc.data = prc
					ed_jprc_con.Data = prc
					ed_jprc_lowCon.Data = prc
					ed_jprc_low.Data = prc
			End Select

			Exit Sub
		Case "4" : Exit Sub
	End Select

	'단가설정
	Select Case Right(c_hogb.Data,1)
	Case "0", "5"			'지정(00,10,20), 조건부지정
		If when = "common" Or OrdCfg.KeepPrc = False Then	'주문전 or 주문수량유지안함
			Call QueryHoga()	'OrdCfg.QueryHoga			'기본단가설정 사용
		End If
	Case Else
		ed_jprc.Data = "0"
		ed_jprc_con.Data = "0"
		ed_jprc_lowCon.Data = "0"
		ed_jprc_low.Data = "0"
	End Select

	'수량설정
	ret = SYSTEM.Pop ("F_jqty")
	If ret <> "" Then
		ed_jqty.data = ret
		SYSTEM.Push "F_jqty", ""
		Exit Sub
	End If

	If when = "common" Or OrdCfg.KeepQty = False Then		'주문전 or 주문단가유지안함
		qtyOpt = OrdCfg.ReadCfg(cfgGB)							'수량설정 index
		Select Case qtyOpt
			Case "0", "2"				'수량, 금액매수 Set
				OrdCfg.QueryQty
			Case "1"						'매도가능수량 Set				'
				SCREEN.SetTimer 3, False
			Case Else
		End Select
	End If

	SCREEN.Object("main.guide").Text = " "					'메세지
End Sub


'****************************************************************************
' DESC: 현재가 가져오기
'****************************************************************************
Sub QueryHoga()
	Dim siseObj, prcOpt, cfgGB, tmpJmgb
	siseObj = "main.OBJ_sise."

	Select Case mmgb
		Case "1" : cfgGB = "SellPrcGB"
		Case "2" : cfgGB = "BuyPrcGB"
		Case "3"
			If OrdCfg.ReadCfg("JJPrcGb") <> "1" Then
				Exit Sub
			End If

			prcOpt = "023"
		Case Else : Exit Sub
	End Select

	If Right(c_hogb.Data,1) = "3" Or Right(c_hogb.Data,1) = "6" Then	'시장가. 최유리지정가
		ed_jprc.Data = "0"				'실행가격 or 높은 조건의 실행가격.
		ed_jprc_con.Data = "0"			'조건가격 or 높은 조건의 조건가격.
		ed_jprc_lowCon.Data = "0"	'낮은조건 조건가격
		ed_jprc_low.Data = "0"		'낮은조건 실행가격
		Exit Sub
	End If

	If mmgb < "3" Then
		prcOpt = OrdCfg.ReadCfg(cfgGB)
	End If

	If Trim(prcOpt) = "" Then
		prcOpt = "023"
	End If

	tmpJmgb = Mid(Trim(ed_cfocod.Data), 2, 2)

	If Trim(tmpJmgb) = "" Then
		Exit Sub
	End If

	If IsNumeric(tmpJmgb) = False Then
		Exit Sub
	End If

	If  CDbl(tmpJmgb) >= 60 Then
		Select Case Left(ed_cfocod.Data,1)
			Case "1", "4", "A", "D" :
				prcOpt = "101" & prcOpt
			Case "2", "3", "B", "C" :
				prcOpt = "111" & prcOpt
			Case Else
				Exit Sub
		End Select
	Else
		Select Case Left(ed_cfocod.Data,1)
			Case "1", "4", "A", "D" :
				prcOpt = "31" & prcOpt
			Case "2", "3", "B", "C" :
				prcOpt = "41" & prcOpt
			Case Else
				Exit Sub
		End Select
	End If

	If Len(Trim(prcOpt)) < 5 Then
		Exit Sub
	End If

	prcOpt = siseObj & prcOpt

	If Left(ed_cfocod.Data,3) = "185" Or Left(ed_cfocod.Data,3) = "186" Or Left(ed_cfocod.Data,3) = "187" Or _
	   Left(ed_cfocod.Data,3) = "485" Or Left(ed_cfocod.Data,3) = "486" Or Left(ed_cfocod.Data,3) = "487" Or _
	   Left(ed_cfocod.Data,3) = "A85" Or Left(ed_cfocod.Data,3) = "A86" Or Left(ed_cfocod.Data,3) = "A87" Or _
	   Left(ed_cfocod.Data,3) = "D85" Or Left(ed_cfocod.Data,3) = "D86" Or Left(ed_cfocod.Data,3) = "D87" Then	'금, 돼지
		ed_jprc.Data = SCREEN.Object(prcOpt).Data & ".00"
		ed_jprc_con.Data = SCREEN.Object(prcOpt).Data & ".00"
		ed_jprc_lowCon.Data = SCREEN.Object(prcOpt).Data & ".00"
		ed_jprc_low.Data = SCREEN.Object(prcOpt).Data & ".00"

		OrdCfg.Price = CStr(ed_jprc.Data)
	Else
		ed_jprc.Data = SCREEN.Object(prcOpt).Data
		ed_jprc_con.Data = SCREEN.Object(prcOpt).Data
		ed_jprc_lowCon.Data = SCREEN.Object(prcOpt).Data
		ed_jprc_low.Data = SCREEN.Object(prcOpt).Data

		OrdCfg.Price = CStr(ed_jprc.Data / 100)
	End If

	OrdCfg.Push

	If mmgb = "3" Then
		Exit Sub
	End If

	If chk_auto.Checked = False Then
		ed_jprc.Data = "0"						'실행가격 or 높은 조건의 실행가격.
		ed_jprc_con.Data = "0"	'조건가격 or 높은 조건의 조건가격.
		ed_jprc_lowCon.Data = "0"	'낮은조건 조건가격
		ed_jprc_low.Data = "0"		'낮은조건 실행가격
		Exit Sub
	End If
End Sub


'***************************************************************************
' DESC: 종목코드 변경시 Setting
'***************************************************************************
Sub ChangeCode()
	Dim cPos, jmNm

SCREEN.IgnoreChange True
	If Len(Trim(ed_cfocod.Data)) <> 8 Then
		Exit Sub
	End If

	Call Hoga_unit(ed_cfocod.Data)

	If Left(Trim(ed_cfocod.Data), 1) = "4" Or Left(Trim(ed_cfocod.Data), 1) = "D" Then
		ed_jprc.SetRange -999999, 999999
		ed_jprc_con.SetRange -999999, 999999
		ed_jprc_lowCon.SetRange -999999, 999999
		ed_jprc_low.SetRange -999999, 999999
	Else
		ed_jprc.SetRange 0, 999999
		ed_jprc_con.SetRange 0, 999999
		ed_jprc_lowCon.SetRange 0, 999999
		ed_jprc_low.SetRange 0, 999999
	End If

	If jumunGb = "OCO" Then
		''돈육은 지정가만 됨. Stop Limit 무조건 지정가
		If Left(ed_cfocod.Data, 3) = "186" Or Left(ed_cfocod.Data, 3) = "A86" Then
			c_hogb.Data = "00"
			c_hogb.Enable = False
			o_hogb.Enable = True
			o_hogb.Data = "0"
			Call Set_comb_hogb()
		Else
			c_hogb.Enable = True
			Call Set_comb_hogb()
		End If
	End If

	If SCREEN.Object("main.ed_cfocod").Data = ed_cfocod.Data Then
		Exit Sub
	End If

	If Len(ed_cfocod.Data) < 8 Or Trim(ed_cfocod.Data) = "" Then
		ed_jprc.data = "0"
		ed_jprc_con.data = "0"
		ed_jprc_lowCon.data = "0"
		ed_jprc_low.data = "0"

		ed_jqty.data = "0"

		c_hogb.Setfocus
	End If

	SCREEN.Object("main.ed_cfocod").Data = ed_cfocod.Data
	SCREEN.Proc "main.send_sise_all", "jumn"
	OrdCfg.ItemCd = ed_cfocod.Data


'	Call QueryOption("common")
'	cPos = Ordcfg.ReadCfg("NotMoveCode")
'	If cPos = "1" Then	'커서유지
'		ed_cfocod.Setfocus
'	End If

SCREEN.IgnoreChange False

End Sub

Sub afterSendSiseJumn()
	Dim cPos

	Call QueryOption("common")
	cPos = Ordcfg.ReadCfg("NotMoveCode")
	If cPos = "1" Then	'커서유지
		ed_cfocod.Setfocus
	End If
End Sub
'***************************************************************************
' DESEC: 선물/옵션 호가단위 Setting
' 상품명, 코드번호
' 돈육 				: 300
' 금 				: 310
' 3년국채, 5년국채  : 320
' 10년국채 			: 330
' 통화 				: 340

' 예) 돈육의 단가를 표시하고 싶은 경우 :: 단가컨트롤명.SetType(300)
'***************************************************************************
Sub Hoga_unit(code)
	If Len(Trim(code)) <> 8 Then
		Exit Sub
	End If

	Dim retn, floatval
	floatval = 2

	SYSTEM.Trace "IB999931 hoga_unit : " & code

	Select Case Left(code,3)
		Case "101", "A01"        ', "401"			'지수선물
			ed_jprc.SetType(110)
			ed_jprc_con.SetType(110)
			ed_jprc_lowCon.SetType(110)
			ed_jprc_low.SetType(110)

