Sub get_avol()
	Dim	param, hogb, flag, pric

	ed_acno.Data = SCREEN.Object("parent.AN20").Data
	ed_pswd.Data = SCREEN.Object("parent.ed_pswd").Data

	If SYSTEM.ConnectBy = 0 Then	'고객으로 로그인시 비밀번호 체크통과하게. 2009/09/07추가 by 230
		ed_pswd.Data = "9999"
	End If

	If Len(Trim(ed_acno.data)) < 11 Then
		MsgBox "계좌번호를 확인하여 주십시오.", 0, "IBK 투자증권"
		SCREEN.Object("parent.AN20").SetFocus
		Exit Sub
	End If

	If Len(Trim(ed_pswd.data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", 0, "IBK 투자증권"
		SCREEN.Object("parent.ed_pswd").SetFocus
		Exit Sub
	End If

	'== obj:: (acno, pwd, gubn, mmgb, cod2, pric, ptnc, flag)
	'gubn : 1.일반 2.금액 3.비율
	'mmgb : 1.매도 2.매수
	'ptnc : 호가구분
	'flag : 가능수량종류 (1.주문가능수량 2.신규 3.청산)

	Select Case c_hogb.Data
	Case "03", "05", "06"
		hogb = c_hogb.Data
	Case Else
		hogb = "00"
	End Select

	If mmgb = "1" Then
		flag = "1"
	Else
		flag = "2"
	End If

	param = ed_acno.Data &","& ed_pswd.Data &","& "1," &_
			mmgb &","& ed_cfocod.Data &","& ed_jprc.Data &","&hogb&","&flag

	OBJ_avol.Proc "send_tr", param
	ed_jqty.SetFocus
End Sub


