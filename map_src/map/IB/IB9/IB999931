Sub Set_cursor()
	Dim cPos

	cPos = OrdCfg.ReadCfg("CursorPos")
	Select Case cPos
		Case "0"
			SCREEN.Object("parent.AN20").SetFocus()
		Case "1"
			SCREEN.Object("parent.ed_pswd").SetFocus()
		Case "2"
			ed_cfocod.Setfocus()
		Case "3"
			ed_jqty.SetFocus()
		Case "4"
			ed_jprc.SetFocus()
	End Select
End Sub


'***************************************************************************
' 선물/옵션 주문조건 체크
' StopLimit : 매수 - 조건가격이 현재가 보다 커야함.
'			  매도 - 조건가격이 현재가 보다 작아야함.
' OCO : 높은 조건의 조건가격은 현재가 보다 커야함.
'       낮은 조건의 조건가격은 현재가 보다 작아야 함.
'		높은 조건의 주문가격은 낮은 조건의 주문가격보다 커야함.
'***************************************************************************
Function Condition_check()
	Condition_check = False

	Dim curPrice, jmNm

	jmNm = SCREEN.GetName(127, Trim(ed_cfocod.Data), 0)

	If jmNm = "" Then

		If Left(Trim(ed_cfocod.Data), 1) = "1" Or Left(Trim(ed_cfocod.Data), 1) = "4" Or _
		   Left(Trim(ed_cfocod.Data), 1) = "A" Or Left(Trim(ed_cfocod.Data), 1) = "D" Then
			curPrice = SCREEN.Object("main.OBJ_sise.31023").Text
		ElseIf Left(Trim(ed_cfocod.Data), 1) = "2" Or Left(Trim(ed_cfocod.Data), 1) = "3" Or _
		       Left(Trim(ed_cfocod.Data), 1) = "B" Or Left(Trim(ed_cfocod.Data), 1) = "C" Then
			curPrice = SCREEN.Object("main.OBJ_sise.41023").Text
		End If
	Else
		curPrice = SCREEN.Object("main.OBJ_sise.101023").Text
	End If

	If IsNumeric(curPrice) = False Then
		curPrice = 0
	End If

	curPrice = CDbl(curPrice)

	If jumunGb = "StopLimit" Then
		Select Case mmgb
		Case 1		'매도일 경우 조건가격이 현재가보다 작거나 같아야 함.
'			MsgBox "curPrice & ed_jprc_con = " & curPrice & " & " & CDbl(ed_jprc_con.Text)
			If CDbl(ed_jprc_con.Text) >= curPrice Then
				MsgBox "조건가격은 현재가보다 작아야합니다.", , "IBK투자증권"
				ed_jprc_con.SetFocus
				Exit Function
			End If
		Case 2		'매수일 경우 조건가격이 현재가보다 크거나 같아야 함. -> 커야함.
			If CDbl(ed_jprc_con.Text) <= curPrice Then
				MsgBox "조건가격은 현재가보다 커야합니다.", , "IBK투자증권"
				ed_jprc_con.SetFocus
				Exit Function
			End If
		Case 3
			If Trim(ed_omgb.Data) = "매도" Then
				ed_ommgb.Data = 1
			ElseIf Trim(ed_omgb.Data) = "매수" Then
				ed_ommgb.Data = 2
			End If

			If ed_ommgb.Data = 1 Then
				If CDbl(ed_jprc_con.Text) >= curPrice Then
					MsgBox "조건가격은 현재가보다 작아야합니다.", , "IBK투자증권"
					ed_jprc_con.SetFocus
					Exit Function
				End If
			ElseIf ed_ommgb.Data = 2  Then
				If CDbl(ed_jprc_con.Text) <= curPrice Then
					MsgBox "조건가격은 현재가보다 커야합니다.", , "IBK투자증권"
					ed_jprc_con.SetFocus
					Exit Function
				End If
			End If
		End Select
	ElseIf jumunGb = "OCO" Then
		If mmgb <> "4" Then
'			MsgBox "curPrice & ed_jprc_con = " & curPrice & " & " & CDbl(ed_jprc_con.Text)
			If CDbl(ed_jprc_con.Text) <= curPrice Then		'높은 조건의 조건가격은 현재가 보다 커야함.
				MsgBox "높은 조건의 조건가격은 현재가보다 커야합니다.",, "IBK투자증권"
				ed_jprc_con.SetFocus
				Exit Function
			End If

'			MsgBox "curPrice & ed_jprc_lowcon = " & curPrice & " & " & CDbl(ed_jprc_lowCon.Text)
			If CDbl(ed_jprc_lowCon.Text) >= curPrice Then	'낮은 조건의 조건가격은 현재가 보다 작아야 함.
				MsgBox "낮은 조건의 조건가격은 현재가보다 작아야합니다.",, "IBK투자증권"
				ed_jprc_lowCon.SetFocus
				Exit Function
			End If

'			MsgBox "ed_jprc & ed_jprc_low = " & CDbl(ed_jprc.Text) & " & " & CDbl(ed_jprc_low.Text)
			If ed_jprc.Enable = True And ed_jprc_low.Enable = True Then
				If CDbl(ed_jprc.Text) <= CDbl(ed_jprc_low.Text) Then	'높은 조건의 주문가격은 낮은 조건의 주문가격보다 커야함.
					MsgBox "높은 조건의 실행가격은 낮은 조건의 실행가격보다 커야합니다.",, "IBK투자증권"
					ed_jprc_low.SetFocus
					Exit Function
				End If
			End If
		End If
	End If

	Condition_check = True
End Function


Sub saveLastStat()
	Dim mapNm
	mapNm = Mid(Trim(SCREEN.GetMapName(1)), 1, 6)

	If Trim(ed_cfocod.Data) <> "" Then
		SYSTEM.Push mapNm & "_jmcd", 		Trim(ed_cfocod.Data)
		SYSTEM.Push mapNm & "_jprc_con", 	Trim(ed_jprc_con.Data)
		SYSTEM.Push mapNm & "_jprc", 		Trim(ed_jprc.Data)
		SYSTEM.Push mapNm & "_jprc_lowCon", Trim(ed_jprc_lowCon.Data)
		SYSTEM.Push mapNm & "_jprc_low",	Trim(ed_jprc_low.Data)
		SYSTEM.Push mapNm & "_jqty",		Trim(ed_jqty.Data)
	Else
		Call clearLastStat()
	End If
End Sub

Sub loadLastStat()
	Dim mapNm, jmcd, jprc_con, jprc, jprc_lowCon, jprc_low, jqty
	mapNm 		= Mid(Trim(SCREEN.GetMapName(1)), 1, 6)
	jmcd 		= Trim(SYSTEM.Pop(mapNm & "_jmcd"))
	jprc_con 	= Trim(SYSTEM.Pop(mapNm & "_jprc_con"))
	jprc 		= Trim(SYSTEM.Pop(mapNm & "_jprc"))
	jprc_lowCon = Trim(SYSTEM.Pop(mapNm & "_jprc_lowCon"))
	jprc_low 	= Trim(SYSTEM.Pop(mapNm & "_jprc_low"))
	jqty 		= Trim(SYSTEM.Pop(mapNm & "_jqty"))

	If Trim(ed_cfocod.Data) <> "" Then
		If Trim(ed_cfocod.Data) = jmcd Then
			If Trim(jprc_con) <> "" Then
				ed_jprc_con.Data = jprc_con
			End If

			If Trim(jprc) <> "" Then
				ed_jprc.Data = jprc
			End If

			If Trim(jprc_lowCon) <> "" Then
				ed_jprc_lowCon.Data = jprc_lowCon
			End If

			If Trim(jprc_low) <> "" Then
				ed_jprc_low.Data = jprc_low
			End If

			If Trim(jqty) <> "" Then
				ed_jqty.Data = jqty
			End If
		Else
			Call clearLastStat()
		End If
	Else
		Call clearLastStat()
	End If
End Sub

Sub clearLastStat()
	Dim mapNm
	mapNm = Mid(Trim(SCREEN.GetMapName(1)), 1, 6)

	SYSTEM.Push mapNm & "_jmcd",		""
	SYSTEM.Push mapNm & "_jprc_con", 	""
	SYSTEM.Push mapNm & "_jprc", 		""
	SYSTEM.Push mapNm & "_jprc_lowCon", ""
	SYSTEM.Push mapNm & "_jprc_low",	""
	SYSTEM.Push mapNm & "_jqty",		""
End Sub


Sub DoJprcOnChange(comp)
	Dim jprcCom
	Set jprcCom = comp

	If jprcCom.Enable = False Then
		jprcCom.Data = "0"
	Else
		If Trim(ed_cfocod.Data) = "" Then
			Exit Sub
		End If

		If IsNumeric(CDbl(jprcCom.Data)) = False Then
			Exit Sub
		End If

'		If CDbl(jprcCom.Data) <> 0 Then
'			Exit Sub
'		End If

		Dim gubn, mkgb, symb
		gubn = Left(Trim(ed_cfocod.Data), 1)
		mkgb = Mid(Trim(ed_cfocod.Data), 2, 2)
		symb = "main.OBJ_sise."

		If Is_numeric(mkgb) = False Then
			Exit Sub
		End If

		If gubn = "1" Or gubn = "4" Or  gubn = "A" Or gubn = "D" Then
			If mkgb >= 61 And mkgb <= 99 Then
				symb = symb & "101023"
			Else
				symb = symb & "31023"
			End If
		ElseIf gubn = "2" Or gubn = "3" Or  gubn = "B" Or gubn = "C" Then
			If mkgb >= 61 And mkgb <= 99 Then
				If CDbl(ed_jprc.Data) <> 0 Then	Exit Sub
				symb = symb & "111023"
			Else
				symb = symb & "41023"
			End If
		Else
			Exit Sub
		End If

		If Len(symb )> 0 And CDbl(jprcCom.Data) = 1  And mkgb > 60  And mkgb <= 70 Then 	'국채 선물
			jprcCom.Data = SCREEN.Object(symb).Data
		ElseIf Len(symb )> 0 And CDbl(jprcCom.Data) = 10  And mkgb > 70  And mkgb < 80 Then 	'국채 선물
			jprcCom.Data = SCREEN.Object(symb).Data
		ElseIf Len(symb )> 0 And CDbl(jprcCom.Data) = 10  And mkgb = 85 Then 	'금 선물
			jprcCom.Data = SCREEN.Object(symb).Data
		ElseIf Len(symb )> 0 And CDbl(jprcCom.Data) = 5  And mkgb = 86 Then 	'돈육 선물
			jprcCom.Data = SCREEN.Object(symb).Data
		ElseIf Len(symb )> 0 And CDbl(jprcCom.Data) = 10  And mkgb = 87 Then 	'미니금 선물
			jprcCom.Data = SCREEN.Object(symb).Data
		End If
		 	'ed_jprc.Data = SCREEN.Object(symb).Data
	End If

	'환경설정용 단가에 저장할것
	OrdCfg.Price = CStr(jprcCom.Data / 100)
	OrdCfg.Push
End Sub

Sub DoJprcOnFocus(comp)
	Dim jprcCom
	Set jprcCom = comp

	If Trim(ed_cfocod.Data) = "" Then
		Exit Sub
	End If

	If IsNumeric(jprcCom.Data) = False Then
		Exit Sub
	End If

	If CDbl(jprcCom.Data) <> 0 Then
		Exit Sub
	End If

	Dim gubn, mkgb, symb
	gubn = Left(Trim(ed_cfocod.Data), 1)
	mkgb = Mid(Trim(ed_cfocod.Data), 2, 2)
	symb = "main.OBJ_sise."

	If Is_numeric(mkgb) = False Then
		Exit Sub
	End If

	If gubn = "1" Or gubn = "4" Or gubn = "A" Or gubn = "D" Then
		If mkgb >= 61 And mkgb <= 99 Then
			symb = symb & "101023"
		Else
			symb = symb & "31023"
		End If
	ElseIf gubn = "2" Or gubn = "3" Or gubn = "B" Or gubn = "C"Then
		If mkgb >= 61 And mkgb <= 99 Then
			If CDbl(jprcCom.Data) <> 0 Then	Exit Sub
			symb = symb & "111023"
		Else
			symb = symb & "41023"
		End If
	Else
		Exit Sub
	End If

	jprcCom.Data = SCREEN.Object(symb).Data
	If Left(ed_cfocod.Data, 1) <>"4" And (ed_cfocod.Data, 1) <>"D" Then
		If CDbl(jprcCom.Data) <= 0.00 Then
			jprcCom.Data = SCREEN.Object(symb).Data
		End If
	Else
		' 스프레드의 경우 숫자가 아닐경우에만 현재가 세팅한다.
		If IsNumeric(jprcCom.Data) <> True Then
			jprcCom.Data = SCREEN.Object(symb).Data
		End If
	End If
End Sub

