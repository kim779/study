_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim cqty, camt

GUIDE.Text = "[" & Trim(o_ecod.Data) & "] " & o_emsg.Data

cqty = 0
camt = 0
For i=1 To GRID0.Rows
	cqty = cqty + GRID0.GetGridCell(i, 4)
	camt = camt + GRID0.GetGridCell(i, 3) * GRID0.GetGridCell(i, 4)
Next

l_cqty.SetTableCell 1, cqty
If IsNumeric(cqty) Then
	If cqty>0 Then
		l_cprc.SetTableCell 1, FormatNumber(camt/100.0/cqty, 4)
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Trim(juno.Data)<>"" Then
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn_close)
_AW_ONCLICK_AW_
