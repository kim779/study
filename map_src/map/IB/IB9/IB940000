Dim data, array, i, j, k

data = Replace(g_memo.data, "／", "/")

array = Split(data, "｜", -1, 1)

j=0
For Each i in array
	j = j+1
	memo.SetGridCell j, 1, i
Next
If j<20 Then
	memo.SetRows 20
Else
	memo.SetRows j
End If

