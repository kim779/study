RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_input
	If RADIO0.Checked = True Then
		ievent.Data = "0"
	ElseIf RADIO1.Checked = True Then
		ievent.Data = "1"
	ElseIf RADIO2.Checked = True Then
		ievent.Data = "2"
	ElseIf RADIO8.Checked = True Then
		ievent.Data = "3"
	ElseIf RADIO9.Checked = True Then
		ievent.Data = "4"
	End If

	If RADIO3.Checked = True Then
		comp.Data = "2"
	ElseIf RADIO4.Checked = True Then
		comp.Data = "1"
	ElseIf RADIO5.Checked = True Then
		comp.Data = "0"
	End If

	If RADIO6.Checked = True Then
		evsl.Data = "Y"
	ElseIf RADIO7.Checked = True Then
		evsl.Data = "N"
	End If
End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If oevent.Data = "0" Then
	RADIO0.Checked = True
ElseIf	oevent.Data = "1" Then
	RADIO1.Checked = True
ElseIf	oevent.Data = "2" Then
	RADIO2.Checked = True
ElseIf	oevent.Data = "3" Then
	RADIO8.Checked = True
ElseIf	oevent.Data = "4" Then
	RADIO9.Checked = True
End If


If ocomp.Data = "2" Then
	RADIO3.Checked = True
ElseIf ocomp.Data = "1" Then
	RADIO4.Checked = True
ElseIf ocomp.Data = "0" Then
	RADIO5.Checked = True
End If

If oevisl.Data = "Y" Then
	RADIO6.Checked = True
ElseIf oevisl.Data = "N" Then
	RADIO7.Checked = True
End If


SCREEN.Proc "main.Set_tab", oevent.Data & ";" & ocomp.Data & ";" & oevisl.Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SBTN)
_AW_ONCLICK_AW_
func.Data = "U"

Call Set_input






SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



