If RADIO0.Checked = True Then
	DTYP.Data = "A"
ElseIf RADIO1.Checked = True Then
	DTYP.Data = "S"
ElseIf RADIO2.Checked = True Then
	DTYP.Data = "T"
ElseIf RADIO3.Checked = True Then
	DTYP.Data = "U"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
MsgBox "발송 완료하였습니다.",0,"IBK투자증권"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(sendBtn)
_AW_ONCLICK_AW_
EDIT2.Data = Trim(MEMO0.Text)

Dim i, ii, msg
i = Len(Trim(MEMO0.Text))
If i > 3000 Then
	MsgBox "현재 "&i&"글자 입력 / "&Abs(95-i)&"글자 초과 하였습니다."
Else

	Dim DEV, bOK

	DEV = "0"

	EDIT2.Data = Replace(Trim(MEMO0.Text), vbCrLf, " ")

	If SCREEN.CreateObject("INFO") Then
		'0이면 운영 1이면 개발
		DEV = Trim(INFO.PopData(LOGIN.Name, LOGIN.Name & ".ini", "MODE", "DEV"))
	End If

	SCREEN.CreateWindow 2, "IB959901 /t /s /p5 /d", "DEV" & vbTab & DEV & vbLf

	bOK = SYSTEM.Pop("ISOK")

	If Trim(EDIT2.Data) <> "" And bOK = "TRUE" Then
		SCREEN.Send 0
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


