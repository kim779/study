Function cp_isdate(as_val)
	If IsDate( Mid(as_val,1,4) & "/" & Mid(as_val,5,2) & "/" &  Mid(as_val,7,2) ) Then
		cp_isdate = True
	Else
		cp_isdate = False
	End If
End Function



'**********************************************************************
' 기능     : 날짜체크
' 파라메터 : s_title    : 제목
'            s_message  : 팝업창에 나타날 내용
'            i_button_gubun : 팝업창에 보여질 버튼 모양 (유효값 범위 : 1 ~ 5)
'            i_default_button : 팝업창이 보여질 때 default로  선택될 버튼 (유효값 범위 : 1 ~ 4)
'            i_defalut_style  : 아이콘 모양 (유효값 범위 : 1 ~ 4)
' 리턴값   : 눌러진 버튼값
' 개발자   : 이상기	04/12/13
' 수정자1  :
'**********************************************************************
Function cp_MsgBox(s_title, s_message, i_button_gubun, i_default_button, i_default_style)
	Dim	i_button_kind , i_style ,s_kind_and_style_and_default
	If(Len(Trim(s_message)) = 0 ) Then
				MsgBox "입력된 메세지가 없습니다.", vbOKOnly+vbExclamation, "[메세지호출에러]"
				Exit Function
	End If

	If(Len(Trim(s_title)) = 0) Then
				s_title = "알림박스입니다."
	End If


	If(i_default_button = 1) Then
			i_default_button = vbDefaultButton1
	ElseIf(i_default_button = 2) Then
			i_default_button = vbDefaultButton2
	ElseIf(i_default_button = 3) Then
			i_default_button = vbDefaultButton3
	ElseIf(i_default_button = 4) Then
			i_default_button = vbDefaultButton4
	Else
			i_deafult_button = vbDefaultButton1
   End If


	If i_button_gubun = 1 Then
			i_button_kind = vbYesNo
			If(i_default_button > vbDefaultButton2) Then
						i_default_button = vbDefaultButton1
			End If
	ElseIf i_button_gubun = 2 Then
			i_button_kind = vbOKOnly
			If(i_default_button > 0) Then
						i_default_button = vbDefaultButton1
			End If
	ElseIf i_button_gubun = 3 Then
			i_button_kind = vbRetryCancel
			If(i_default_button > vbDefaultButton2) Then
						i_default_button = vbDefaultButton1
			End If
	ElseIf i_button_gubun = 4 Then
			i_button_kind = vbOKCancel
			If(i_default_button > vbDefaultButton2) Then
						i_default_button = vbDefaultButton1
			End If
	ElseIf i_button_gubun = 5 Then
			i_button_kind = vbAbortRetryIgnore
			If(i_default_button > vbDefaultButton3) Then
						i_default_button = vbDefaultButton1
			End If
	ElseIf i_button_gubun = 6 Then
			i_button_kind = vbYesNoCancel
			If(i_default_button > vbDefaultButton3) Then
						i_default_button = vbDefaultButton1
			End If
	Else
			i_button_kind = vbOKCancel
			If(i_default_button > vbDefaultButton1) Then
						i_default_button = vbDefaultButton1
			End If
	End If

	If(i_default_style = 1) Then
				i_style = vbQuestion
	ElseIf(i_default_style = 2) Then
				i_style = vbInformation
	ElseIf(i_default_style = 3) Then
				i_style = vbExclamation
	ElseIf(i_default_style = 4) Then
				i_style = vbCritical
	Else i_style = vbQuestion
	End If

   s_kind_and_style_and_default = i_button_kind + i_style + i_default_button
   cp_MsgBox = MsgBox(s_message, s_kind_and_style_and_default, s_title)
End Function

'**********************************************************************
' 기능     : 천단위 콤마찍기
' 파라메터 : as_val    : 값
'
' 리턴값   : cp_asterisk_right
' 개발자   : 김동겸	04/09/08
' 수정자1  :
'**********************************************************************
Function cp_asterisk_right(as_val, ai_count, mark)

      Dim i, mok, div, size, str

      size = Len(as_val)

      If  as_val = "" Or size <= 3 Then
         cp_asterisk_right = as_val
      End If

      div = size / 3
      mok = size Mod 3
      str = Mid(as_val, 1, mok )

      For i = 0 To div-1
         If  i = 0 And  mok = 0 Then
            str = Mid(as_val,  mok + 1, mok + 3 )
         Else
            str = str & "," & Mid(as_val, (i * 3) + mok + 1,  3 )
         End If
      Next
      str= mark & str
      str = cp_lpad(str, ai_count, " ")
      cp_asterisk_right = str

End Function

