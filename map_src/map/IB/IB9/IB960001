RESOURCE DIVISION
{


_AW_ONSTART_AW_
If Len(Trim(memo.Data)) >  0 Then
	memo.Data = Replace(memo.Data,"|", vbCrLf)
	memo.Data = Replace(memo.Data,"$$", "/")
	MEMO0.Text = memo.Data
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(REL_BTN)
_AW_ONCLICK_AW_
SYSTEM.Push "IB960001_TEXT", Trim(MEMO0.Text)
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(DEL_BTN)
_AW_ONCLICK_AW_
SYSTEM.Push "IB960001_TEXT", ""
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(memo)
_AW_ONCLICK_AW_
Dim text,dmsg

dmsg = "MEMO0" & vbTab & desc.Data & vbLf

'SCREEN.CreateWindow 2, "IB960001 /p5", ""
SCREEN.CreateWindow 2, "IB960001 /p5 /d", dmsg


text = SYSTEM.pop ("IB960001_TEXT")
If Len(Trim(text)) > 0 Then
		desc.data = text
		SYSTEM.Push "IB960001_TEXT", ""
	Exit Sub
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



