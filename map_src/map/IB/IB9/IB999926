{


_AW_ONDECLARE_AW_
Dim objnm
objnm = "parent.obj_odr"

_AW_ONSEND_AW_
Dim code, sygb, sydt, tabtext, pre_id

If Trim(SCREEN.Object(objnm & ".jmbtclick").data) = 0 Then
	SCREEN.OnSend = False
	Exit Sub
End If

If SYSTEM.ConnectBy = 1 Then
	If LOGIN.Cani = 0 Then
		MsgBox "본사직원은 주문이 불가합니다.",,"IBK투자증권"
		SCREEN.OnSend = False
		Exit Sub
	End If
End If


SYSTEM.push "FO_ogno", ""
SYSTEM.push "FO_jprc", ""

ed_accn.Data = SCREEN.Object(objnm & ".ed_acno").data		'계좌번호
ed_pswd.Data = SCREEN.Object(objnm & ".ed_pswd").data		'비밀번호
ed_ojno.Data = SCREEN.Object(objnm & ".ed_ogno").data		'원예약번호
ed_cod2.Data = SCREEN.Object(objnm & ".ed_cfocod").data		'종목코드
ed_fdtp.Data = SCREEN.Object(objnm & ".ed_odgb").data		'주문구분    00:서버STOP, 01:서버STOP, LIMIT 02:서버OCO
ed_hogb.Data = SCREEN.Object(objnm & ".ed_hogb").data		'호가유형
ed_cdgb.Data = SCREEN.Object(objnm & ".ed_jmgb").data		'주문조건
ed_mmgb.Data = SCREEN.Object(objnm & ".ed_mmgb").data		'매매구분

en_accn.Data = Mid(ed_accn.Data, 1, 8) 	'계좌번호암호화

ed_jqty.Data = SCREEN.Object(objnm & ".ed_jqty").data		'주문수량

Dim fgubn
fgubn = Left(Trim(ed_cod2.Data), 3)

If ed_fdtp.Data = "00" Then
	If fgubn = "185" Or fgubn = "186" Or fgubn = "187" Or _
	   fgubn = "A85" Or fgubn = "A86" Or fgubn = "A87" Then
		ed_cpr1.Data = SCREEN.Object(objnm & ".ed_jprc").data & "00"		'주문조건1
	Else
		ed_cpr1.Data = SCREEN.Object(objnm & ".ed_jprc").data				'주문조건1
	End If
ElseIf ed_fdtp.Data = "01" Then
	If fgubn = "185" Or fgubn = "186" Or fgubn = "187" Or _
	   fgubn = "A85" Or fgubn = "A86" Or fgubn = "A87" Then
		ed_cpr1.Data = SCREEN.Object(objnm & ".ed_jprc_con").data & "00"	'주문조건1
		ed_prc1.Data = SCREEN.Object(objnm & ".ed_jprc").data & "00"		'주문가격1
	Else
		ed_cpr1.Data = SCREEN.Object(objnm & ".ed_jprc_con").data			'주문조건1
		ed_prc1.Data = SCREEN.Object(objnm & ".ed_jprc").data				'주문가격1
	End If
ElseIf ed_fdtp.Data = "02" Then
	If fgubn = "185" Or fgubn = "186" Or fgubn = "187" Or _
	   fgubn = "A85" Or fgubn = "A86" Or fgubn = "A87" Then
		ed_cpr1.Data = SCREEN.Object(objnm & ".ed_jprc_con").data & "00"	'주문조건1
		ed_prc1.Data = SCREEN.Object(objnm & ".ed_jprc").data & "00"		'주문가격1
		ed_cpr2.Data = SCREEN.Object(objnm & ".ed_jprc_lowCon").data & "00"	'주문조건2
		ed_prc2.Data = SCREEN.Object(objnm & ".ed_jprc_low").data & "00"	'주문가격2
	Else
		ed_cpr1.Data = SCREEN.Object(objnm & ".ed_jprc_con").data			'주문조건1
		ed_prc1.Data = SCREEN.Object(objnm & ".ed_jprc").data				'주문가격1
		ed_cpr2.Data = SCREEN.Object(objnm & ".ed_jprc_lowCon").data		'주문조건2
		ed_prc2.Data = SCREEN.Object(objnm & ".ed_jprc_low").data			'주문가격2
	End If
End If

If Trim(SCREEN.Object(objnm & ".jmbtclick").data) = 1 Then
	SCREEN.Object(objnm & ".jmbtclick").data = 0
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod

If Left(Trim(o_emsg.Data), 1) = "0" Then
	If SCREEN.Object("main.tab_account").ID = "1" Then
		'SCREEN.Object("main.OBJ_account").Send
		SCREEN.Proc "main.OBJ_account.init", ""
	End If
Else
	MsgBox Trim(o_emsg.Data), , "IBK투자증권"
End If

SCREEN.Object("main.guide").text = o_emsg.Data			'메시지

