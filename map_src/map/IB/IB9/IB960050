Sub Upper_Row(row) '그리드 ROW UP 버튼
	For ii = 1 To 9
		Dim tmp

		If RTYPE1.Checked Then
			tmp = GRID0.GetGridCell(row, ii)
			GRID0.SetGridCell row, ii, GRID0.GetGridCell(row-1, ii)
			GRID0.SetGridCell row-1, ii, tmp
		End If
	Next
	Grid2Edit(row)
End Sub
'-----------------------------------------------------------------------
Sub Lower_Row(row) '그리드 ROW DOWN 버튼
	For ii = 1 To 9
		Dim tmp

		If RTYPE1.Checked Then
			tmp = GRID0.GetGridCell(row, ii)
			GRID0.SetGridCell row, ii, GRID0.GetGridCell(row+1, ii)
			GRID0.SetGridCell row+1, ii, tmp
		End If
	Next
	Grid2Edit(row)
End Sub
