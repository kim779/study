_AW_ONDECLARE_AW_
Dim g_flag
Dim g_ArrCtrl
Dim dic, myFSO, WriteStuff, ReadStuff, line, lines


'dic = SYSTEM.Home & "/dev/" & "cfgtmp2.ini"
dic = SYSTEM.Home & "/tab/" & "BANNERINFO.INI"
itmp.Data = dic

g_ArrCtrl = Array(ed_seq, Nonum, ed_etc, ed_startdate, ed_enddate, ed_eventtitle, ed_eventsubtitle, _
	ed_imgfilename, ed_view, ed_ispopup,ed_downloadurl )
'-----------------------------------------------------------------------
Sub InitCtrl() 'Edit Box 초기화
	For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
		If i <> 0 Then
			g_ArrCtrl(i).Data = ""
		End If
	Next
End Sub
'-----------------------------------------------------------------------
Sub Grid2Edit(Row) '그리드 Row 클릭시, 하단 EditBox에 Road

	Data = Trim(GRID0.GetGridCell(Row, 1))

'	If Len(Data) = 0 Then
'		Exit Sub
'	End If

	For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
		g_ArrCtrl(i).Data = GRID0.GetGridCell(Row, i + 1)
		If i = 10 And Len(Trim(g_ArrCtrl(i).Data)) = 0 Then
			g_ArrCtrl(i).Data = "https://download.ibks.com/mts/"
		End If
	Next


End Sub
'-----------------------------------------------------------------------
Sub Edit2Grid(Row) '그리드 저장 버튼 클릭시, 해당 row 그리드에 Save
	Dim tmp
	For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
		If i <> 0 Then
				If i = 1 Then
					tmp = l_format(Trim(g_ArrCtrl(i).text), "0", 2)
					GRID0.SetGridCell Row, i + 1, tmp
				Else
					GRID0.SetGridCell Row, i + 1, g_ArrCtrl(i).Data
				End If
		End If
	Next
End Sub
'-----------------------------------------------------------------------
Sub FileWrite(str) 'INI FILE WRITE
	Set myFSO = CreateObject("Scripting.FileSystemObject")
	Set WriteStuff = myFSO.CreateTextFile(dic, True)

	WriteStuff.WriteLine(str)
	WriteStuff.Close

	Set myFSO = Nothing
	Set WriteStuff = Nothing
End Sub
'-----------------------------------------------------------------------
Sub Fileread(Rtype)	'INI FILE ROAD
	Dim kk, tm
	lines = ""
	lines = ""
	Set myFSO = CreateObject("Scripting.FileSystemObject")
	If myFSO.FileExists(dic) = False Then
		MsgBox "설정파일이 없습니다. " & dic
		Exit Sub
	End If
	Set f = myFSO.GetFile(dic)
	Set readStuff = myFSO.OpenTextFile(dic, 1, True)

	kk = 0
	Do Until readStuff.AtEndOfStream
		line = readStuff.ReadLine
		If Len(Trim(line)) > 0 Then
			lines = lines & line & vbCrLf
			kk = kk + 1
		End If
	Loop

	data = Split(lines, vbCrLf, -1, 1)
	yy=1
	If Trim(lines) <> "" Then
		For ii = 0 To kk-1
			myline = Split(data(ii), "|", -1, 1)

			For jj = 0 To 10
				If Left(myline(0),1) = Rtype Then
					GRID0.SetGridCell yy, jj+1, Trim(myline(jj))
				End If
			Next
			If Left(myline(0),1) = Rtype Then
				GRID0.InsertRow(yy+1)
				yy = yy+1
			End If
		Next
	End If


	'빈 구분값 채우기
	Dim Formatstr
	For gg = yy To 30
		tmp = l_format(gg, "0", 2)
		'MsgBox Rtype & tmp
		GRID0.SetGridCell gg, 1, Rtype & tmp
		GRID0.InsertRow(gg+1)
	Next

	readStuff.Close

	updatedate.Data = f.DateLastModified

	Set myFSO = Nothing
	Set readStuff = Nothing
End Sub
