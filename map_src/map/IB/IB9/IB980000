RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim dmsg

_AW_ONSELECT_AW_
Dim map, title, bEdge, url

WebCtrl.Home = SYSTEM.Home
WebCtrl.Menu = data
WebCtrl.UserID = LOGIN.User

If SCREEN.CreateObject("Info") Then
	bEdge = Trim(INFO.PopData("", "WEBINFO.INI", data, "EDGE"))
	url = Trim(INFO.PopData("", "WEBINFO.INI", data, "EDGE_URL"))
End If

SYSTEM.Trace "[IB980000[EDGE] OnSelect data = " & data & "  bEdge = " & bEdge & " url = " & url

If bEdge = "1" Then
	dmsg = "edmap" & vbTab & data
	SCREEN.SetTimerX 4,5, False
	Exit Sub
End If

WebCtrl.ItemCode = SYSTEM.GetHistory(True, "1301")

WebCtrl.Navigate

SCREEN.SetSize WebCtrl.Width-4, WebCtrl.Height-4
SCREEN.SetTimerX 5,5, False
SCREEN.SetCaption WebCtrl.GetCaption

_AW_ONENDSUB_AW_
_AW_ONTIMERX_AW_
If id = 5 Then
	SCREEN.SetSize WebCtrl.Width-3, WebCtrl.Height-3
ElseIf id = 4 Then

	SYSTEM.Trace "[IB980000]ontimer  dmsg = " & dmsg
	SCREEN.CreateWindow 1, "IB980002 /p5 /d", dmsg

	SCREEN.CloseWindow
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
WebCtrl.ItemCode = S1301.Data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



