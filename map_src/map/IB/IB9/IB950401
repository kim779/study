_AW_ONDECLARE_AW_
Dim val
Sub click_grid()
	Dim val
	Dim v_key

	val = GRID0.Row
	SCREEN.Object("main.CRGB").data = "0"
'	SCREEN.Object("main.COD2").data = GRID0.GetGridCell(val, 2)
	SCREEN.Object("main.TITL").data = GRID0.GetGridCell(val, 5)

	v_key = GRID0.GetGridCell(val, 8)
	SCREEN.Object("main.ILJA1").data = Mid(v_key, 1, 8)
''	SCREEN.Object("main.GUBN").data = Mid(v_key, 7, 1)
''	SCREEN.Object("main.SUBG").data = Mid(v_key, 8, 4)
	SCREEN.Object("main.SEQN").data = Mid(v_key, 14, 9)
	SCREEN.Send 1

End Sub

