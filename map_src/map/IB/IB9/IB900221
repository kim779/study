RESOURCE DIVISION
{


_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim rec, ii, dept, common_nm
SCREEN.OnSend = False
If SCREEN.CreateObject("Info") Then
	dept = Trim(INFO.PopData("", "ACCNTDEPT.INI", "ACCNTDEPT", "DEPT"))
	common_nm = Trim(INFO.PopData("", "ACCNTDEPT.INI", "ACCNTDEPT", "COMMONNM"))
End If

usid.Data = "9" & dept & common_nm

gid.Data = l_format(Trim(SCREEN.Object("main.obj0.grp_combo").data), "0", 4)

If Trim(gid.data) = "" Then
	SCREEN.Object("parent.GRID0").Clear
	Exit Sub
End If

gnm.Data = Trim(SCREEN.Object("main.obj0.grp_combo").text)
act.Data = "U"

rec = 0
GRID1.Clear
GRID1.SetRows 1000

For ii =1 To SCREEN.Object("parent.GRID0").Rows
	If Trim(SCREEN.Object("parent.GRID0").GetGridCell(ii, 2)) = "" Then
		Exit For
	End If
		GRID1.InsertRow(ii)
		GRID1.SetGridCell ii, 1, Trim(SCREEN.Object("parent.GRID0").GetGridCell(ii, 2))
		GRID1.SetGridCell ii, 2, Trim(SCREEN.Object("parent.GRID0").GetGridCell(ii, 4))
		rec = rec + 1
Next

nrec.Data = l_format(rec, "0", 4)

If rec > 0 Then
	GRID1.SetRows rec
Else
	GRID1.SetRows 0
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Call CONTROL0.Refresh813(0)
SCREEN.SetTimer 10, False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Proc "parent.query", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(CONTROL0)
_AW_ONDBLCLK_AW_
'MsgBox "Control: "+CONTROL0.data
Dim DataList, spos, dpos, symb, data, cnt
cnt = 1
DataList = CONTROL0.data
'MsgBox "DataList: "+ DataList
dpos = 0
spos = InStr(DataList, "|")
While spos <> 0
	symb = Mid(DataList,dpos+1,spos-dpos-1)
	'MsgBox "symb: "+ symb
	dpos = InStr(spos+1,DataList, "|")
	data = Mid(DataList, spos+1, dPos-spos-1)
	spos = InStr(dpos+1,DataList, "|")
	SCREEN.Object(symb).data = data

Wend
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



