_AW_ONDECLARE_AW_
Dim g_flag
g_flag = "Q"

Sub Set_input
	If RADIO0.Checked = True Then
		ievent.Data = "0"
	ElseIf RADIO1.Checked = True Then
		ievent.Data = "1"
	ElseIf RADIO2.Checked = True Then
		ievent.Data = "2"
	ElseIf RADIO8.Checked = True Then
		ievent.Data = "3"
	ElseIf RADIO9.Checked = True Then
		ievent.Data = "4"
	End If

	If RADIO3.Checked = True Then
		comp.Data = "2"
	ElseIf RADIO4.Checked = True Then
		comp.Data = "1"
	ElseIf RADIO5.Checked = True Then
		comp.Data = "0"
	End If

	If RADIO6.Checked = True Then
		evsl.Data = "Y"
	ElseIf RADIO7.Checked = True Then
		evsl.Data = "N"
	End If


	If RADIO14.Checked = True Then
		type1.Data = "A"
	ElseIf RADIO15.Checked = True Then
		type1.Data = "B"
	ElseIf RADIO16.Checked = True Then
		type1.Data = "C"
	End If

	If RADIO10.Checked = True Then
		tymt.Data = "1"
	ElseIf RADIO11.Checked = True Then
		tymt.Data = "2"
	End If

	If RADIO12.Checked = True Then
		tyst.Data = "1"
	ElseIf RADIO13.Checked = True Then
		tyst.Data = "2"
	End If

	If Len(Trim(CIMG.text)) <> 0 Then
		tymi.Data = CIMG.text
	Else
		tymi.Data = "BLANK"
	End If

	If Len(Trim(CIMG2.text)) <> 0 Then
		tysi.Data = CIMG2.text
	Else
		tysi.Data = "BLANK"
	End If

	If Len(Trim(scr1.text)) <> 0 Then
		tyms.Data = scr1.text
	Else
		tyms.Data = "BLANK"
	End If

	If Len(Trim(scr2.text)) <> 0 Then
		tyss.Data = scr2.text
	Else
		tyss.Data = "BLANK"
	End If

	tyf1.Data = "BLANK"
	tyf2.Data = "BLANK"
	tyf3.Data = "BLANK"
	tyf4.Data = "BLANK"



End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
For ii = 0 To 11
	'MsgBox Trim(SCREEN.Object("OUTPUT"&ii).text)
	Dim tmp
	tmp = Trim(SCREEN.Object("OUTPUT"&ii).text)

	Select Case ii
		Case 0	'0 현재 보여줄 배너 타입
				Select Case tmp
					Case "A"	'A TYPE
						RADIO14.Checked = True
					Case "B"	'B TYPE
						RADIO15.Checked = True
					Case "C"	'C TYPE
						RADIO16.Checked = True
				End Select

		Case 1 '1 메인 이미지 이름
			CIMG.Data = tmp
		Case 2	'2 서브 이미지 이름
			CIMG2.Data = tmp
		Case 3	'3 메인화면 or url 타입 1화면 2url
				Select Case tmp
