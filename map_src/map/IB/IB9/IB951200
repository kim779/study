RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim gridFocus
gridFocus = -1

_AW_ONSTART_AW_
yesYear.Text = Left(DateAdd("d", -1, Date), 4)
yesMonth.Text = Mid(DateAdd("d", -1, Date), 6, 2)
yesDay.Text = Right(DateAdd("d", -1, Date), 2)

year.Data = yesYear.Text

zStrDt.Data = yesYear.Text & "0101"
zEndDt.Data = yesYear.Text & "1231"

SCREEN.ClearAll 2, 2
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("obj_gmsg.gmsg").data = Trim(GUIDE.Data)

Dim ii
Dim fesum, fcsum, fjsum, ftsum

fesum = 0
fcsum = 0
fjsum = 0
ftsum = 0

For ii = 1 To GRID0.Rows

	If IsNumeric(GRID0.GetGridCell(ii, 4)) = True Then
		fesum = fesum + CDbl(GRID0.GetGridCell(ii, 4))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 5)) = True Then
		fcsum = fcsum + CDbl(GRID0.GetGridCell(ii, 5))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 6)) = True Then
		fjsum = fjsum + CDbl(GRID0.GetGridCell(ii, 6))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 9)) = True Then
		ftsum = ftsum + CDbl(GRID0.GetGridCell(ii, 9))
	End If
Next

mesum.Data = fesum
mcsum.Data = fcsum
mjsum.Data = fjsum
mtsum.Data = ftsum

If gridFocus = -1 Then
	GRID0.Index = CLng(GRID0.rows) - 1
Else
	GRID0.Index = CLng(gridFocus) - 1
End If
GRID0.SetFocus()


If Trim(yesMonth.Text) <> "" Then
	obj0.Proc "startDay", yesYear.Text & "," & yesMonth.Text
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then

	yesMonth.Text = Left(GRID0.GetGridCell(GRID0.row, 1), 2)
	gridFocus = GRID0.Row
	If Trim(yesMonth.Text) <> "" Then
		SCREEN.Object("obj0.TDM").Data = "5"
		SCREEN.Object("obj0.zStrDt").Data = year.Data & yesMonth.Text & "01"
		SCREEN.Object("obj0.zEndDt").Data = year.Data & yesMonth.Text & "31"
		obj0.proc "zeroUp", ""
		obj0.Send
	End If

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
zStrDt.Data = yesYear.Text & "0101"
zEndDt.Data = yesYear.Text & "1231"

SCREEN.Object("obj0.flag").text = "1"

SCREEN.ClearAll 2, 2
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
Select Case excelSelect.Index
	Case 0 : GRID0.Excel True,True,""
	Case 1 : SCREEN.Object("obj0.GRID0").Excel True,True,""
	Case 2 : SCREEN.Object("obj0.obj0.GRID0").Excel True,True,""
End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(year)
_AW_ONCHANGE_AW_
zStrDt.Data = year.Data & "0101"
zEndDt.Data = year.Data & "1231"

obj0.ClearAll 0
SCREEN.Object("obj0.obj0").clearAll 0

SCREEN.ClearAll 2, 2
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



