RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub sep_memo()
	Dim str, ii, jj, slen, cnt, comp, piece
	str = Trim(MEMO0.Text)
	slen = Len(str)
	If slen <= 0 Then
		Exit Sub
	End If

	cnt = Int(slen / 50)

	jj = 1
	For ii = 0 To cnt
		piece = Trim(Mid(str, jj, 50))
		jj = jj + 50
		comp = "PANEL"&ii
		SCREEN.Object(comp).Text = piece
		SCREEN.Object(comp).Visible = True
	Next

	SCREEN.SetSize 540-1, ((cnt+2) * 20) + 40
	PANEL.SetRect 0, 0, 540, ((cnt+2) * 20) + 40
End Sub

_AW_ONSTART_AW_
If Trim(i_fnam.Data) <> "" Then
	i_type.Data = "V"
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim data

data = Trim(MEMO0.Text)

MEMO0.Text = Replace(data, vbLf, vbCrLf)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
If Trim(i_usid.Data) = "" Or Trim(i_hnam.Data) = "" Or Trim(i_bpip.Data) = "" Or Trim(i_term.Data) = "" Then
	MsgBox "로그를 수집하고자 하는 사용자 정보를 그리드에서 선택해주십시오."
	GMSG.Data = "로그를 수집하고자 하는 사용자 정보를 그리드에서 선택해주십시오."
	Exit Sub
End If

If Trim(i_fnam.Data) = "" Then
	MsgBox "수집할 파일명을 기입해주세요."
	GMSG.Data = "수집할 파일명을 기입해주세요."
	i_fnam.SetFocus()
	Exit Sub
End If

i_type.Data = "G"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
GRID0.Clear()
If Trim(i_usid.Data) = "" Then
	MsgBox "검색할 사용자 ID를 입력해 주십시오."
	GMSG.Data = "검색할 사용자 ID를 입력해 주십시오."
	i_usid.SetFocus()
	Exit Sub
End If

i_type.Data = "F"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
i_type.Data = "R"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


