GLOBAL DIVISION
{

MAPNAME(IB932100)
MAPSIZE(720, 640)
VERSION(000)
MAPKIND(NORMAL)
MAPGROUP(1)
MAPDESC("Untitled")
MAPPUBLIC(";")
FONT("굴림", 9, NORMAL)
TITLE("투자성향적정성판단보고서")
TOPATH(AXIS)
METHOD(FORM)
MAPTYPE(FIXED)
HEADER(NOP)
}



FORM DIVISION
{

OBJECT  OBJECT0(0, 0, 640, 720)    "IB932101"  TABORDER(1)  IOORDER(1)  ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
OBJECT  OBJECT1(0, 0, 640, 720)    "IB932102"  TABORDER(2)  IOORDER(2)  ENABLE  &
  HINTTYPE(IH_NONE)
}



RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub SetObject(gubn)
	If gubn = "0"Then
		OBJECT0.Visible = True
		OBJECT1.Visible = False
	Else
		OBJECT0.Visible = False
		OBJECT1.Visible = True
	End If
End Sub

}



