_AW_ONDECLARE_AW_
Public start
start = 1

Const file = "newsinfo.ini"

Function ReadConf()
	If SCREEN.CreateObject("Info") Then
	 	ReadConf = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "ITEMS"))
	Else
		ReadConf = ""
	End If
End Function

Function ReadVersion()
	If SCREEN.CreateObject("Info") Then
	 	ReadVersion = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "VERSION"))
	Else
		ReadVersion = ""
	End If
End Function

Sub rd_click()
	Dim ii

	If r2_1.Checked Then
		For ii=1 To 20
			If ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	ElseIf r2_2.Checked Then
		For ii=1 To 20
			If ii = 2 Then
				SCREEN.Object("GUBN"&ii).Checked = True
			Else
				SCREEN.Object("GUBN"&ii).Checked = False
			End If
		Next
	ElseIf r2_3.Checked Then
		For ii=1 To 20
			If ii = 2 Or ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	Else

	End If
End Sub

Sub Onalert()
	Dim	v_gubn
	Dim	v_name
	Dim strKeys
	Dim c_list , f, c_yn
	SYSTEM.Trace "onalert()"
	SYSTEM.Trace "실시간 Code" & Trim(GRID8.GetGridCell(1,4))

	If Trim(GRID8.GetGridCell(1,4)) = "" Then
		SYSTEM.Trace "clear(1)"
		GRID8.Clear()
		Exit Sub
	End If

	c_yn = "N"

	If Trim(GRID8.GetGridCell(1,12)) <> "" Then
	SYSTEM.Trace "복수 종목 실시간 Code" & Trim(GRID8.GetGridCell(1,12))
		c_list = Split(Trim(GRID8.GetGridCell(1,12)) , "A", -1, 1)
		For Each f in c_list
			If Len(f) <> 0 And Trim(cod2.data) = f Then
				c_yn = "Y"
				Exit For
			End If
		Next
	End If

	If Trim(GRID8.GetGridCell(1,4)) <> Trim(cod2.data) And c_yn = "N" Then
		SYSTEM.Trace "clear(2)"
		GRID8.Clear()
		Exit Sub
	End If

	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "test_log.dat", "IB201400", "TABLE0", Trim(GRID8.GetGridCell(1,4))
		INFO.PushData LOGIN.Name, "test_log.dat", "IB201400", "cod2", Trim(cod2.data)
	End If

	If Trim(GRID8.GetGridCell(1,8)) = "" Then
		SYSTEM.Trace "clear(3)"
		Exit Sub
	End If

	If IsNumeric(GRID8.GetGridCell(1,8)) = False Then
		SYSTEM.Trace "clear(4)"
		Exit Sub
	End If

	v_gubn = CLng(GRID8.GetGridCell(1,8))

	If v_gubn < 1 Or v_gubn > 20 Then
		Exit Sub
	End If

	Select Case v_gubn
	Case 1
		If GUBN1.Checked = False Then
			Exit Sub
		End If
		v_name = "시황"
	Case 2
		If GUBN2.Checked = False Then
			Exit Sub
		End If
		v_name = "공시"

		v_subgubn = GRID8.GetGridCell(1,9)

		If v_subgubn = 99 Then
			v_name = "코스닥공시"
		ElseIf v_subgubn = 88 Then
			v_name = "프리보드공시"
		Else
			v_name = "거래소공시"
		End If
	Case 3
		If GUBN3.Checked = False Then
			Exit Sub
		End If
		v_name = "이투데이"
	Case 4
		If GUBN4.Checked = False Then
			Exit Sub
		End If
		v_name = "시황속보"
	Case 5
		If GUBN5.Checked = False Then
			Exit Sub
		End If
		v_name = "전자신문"
	Case 6
		If GUBN6.Checked = False Then
			Exit Sub
		End If
		v_name = "이데일리"
	Case 7
		If GUBN7.Checked = False Then
			Exit Sub
		End If
		v_name = "월드인덱스"
	Case 8
		If GUBN8.Checked = False Then
			Exit Sub
		End If
		v_name = "연합뉴스"
	Case 9
		If GUBN9.Checked = False Then
			Exit Sub
		End If
		v_name = "머니투데이"
	Case 10
		If GUBN10.Checked = False Then
			Exit Sub
		End If
		v_name = "한경뉴스"
	Case 11
		If GUBN11.Checked = False Then
			Exit Sub
		End If
		v_name = "매경뉴스"
	Case 12
		If GUBN12.Checked = False Then
			Exit Sub
		End If
		v_name = "아시아경제"
	Case 13
		If GUBN13.Checked = False Then
			Exit Sub
		End If
		v_name = "헤럴드경제"
	Case 14
		If GUBN14.Checked = False Then
			Exit Sub
		End If
		v_name = "촉n토크"
	Case 15
		If GUBN15.Checked = False Then
			Exit Sub
		End If
		v_name = "IR GO"
	Case 16
		If GUBN16.Checked = False Then
			Exit Sub
		End If
		v_name = "컨슈머타임스"
	Case 17
		If GUBN17.Checked = False Then
			Exit Sub
		End If
		v_name = "뉴스웨이"
	End Select

	strKeys = editFilter.Data

	If Trim(strKeys) <> "ALL" Then
		If InStr(strKeys,Trim(v_name)) < 1 Then
			Exit Sub
		End If
	End If

	'If Trim(S1301.data) = Trim(cod2.data) Then

	For ii = 1 To GRID8.Rows
		If Trim(GRID8.GetGridCell(ii,4))<>"" Then
			c_yn = "N"
			If Trim(GRID8.GetGridCell(ii,12)) <> "" Then
				c_list = Split(Trim(GRID8.GetGridCell(ii,12)) , "A", -1, 1)
				For Each f in c_list
					If Len(f) <> 0 And Trim(cod2.data) = f Then
						c_yn = "Y"
						Exit For
					End If
				Next
			End If
			SYSTEM.Trace "c_yn: "&c_yn
			If Trim(GRID8.GetGridCell(ii,4)) = Trim(cod2.data) Or c_yn = "Y" Then
				' add GRID row
				GRID0.InsertRow 0
				SYSTEM.Trace "2014NewsSet"
				' set GRID data
				' TIME
				GRID0.SetGridCell 1, 2, GRID8.GetGridCell(ii,6)
				'
