RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"

Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		RD1.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RD1"))="True")
		RD2.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RD2"))="True")
		RD3.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RD3"))="True")
		RD4.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RD4"))="True")
		If Not RD1.Checked And Not RD2.Checked And Not RD3.Checked And Not RD4.Checked Then
			RD1.Checked = True
		End If

		RADIO1.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO1"))="True")
		RADIO2.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO2"))="True")
		If Not RADIO1.Checked And Not RADIO2.Checked Then
			RADIO1.Checked = True
		End If
	End If
End Sub

Sub SaveConfig()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RD1", ""&RD1.Checked
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RD2", ""&RD2.Checked
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RD3", ""&RD3.Checked
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RD4", ""&RD4.Checked
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO1", ""&RADIO1.Checked
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO2", ""&RADIO2.Checked
	End If
End Sub

Sub SendRequest()
	If RADIO1.Checked Then
		OBJECT0.SetObject "IB230810"
	Else
		OBJECT0.SetObject "IB230820"
	End If

	If RD2.Checked Then
		SCREEN.Object("OBJECT0.flag").Data = "0100"
	ElseIf RD3.Checked Then
		SCREEN.Object("OBJECT0.flag").Data = "0010"
	ElseIf RD4.Checked Then
		SCREEN.Object("OBJECT0.flag").Data = "0001"
	Else
		SCREEN.Object("OBJECT0.flag").Data = "1000"
	End If

	'MsgBox SCREEN.Object("OBJECT0.flag").Data

	OBJECT0.Send
End Sub

_AW_ONSTART_AW_
Call LoadConfig()
Call SendRequest()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
Call SaveConfig()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(RD1)
