				Call p_read_ini2()
		End Select
	End If

End Sub

Sub p_read_ini2()
	If SCREEN.CreateObject("INFO") Then
		Dim vol, amt, acc
		vol = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB290800", "vol"))
		amt = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB290800", "amt"))
		acc = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB290800", "acc"))

		If vol <> "0" Then
			stock.data = vol
			future.Data = amt
			coption.data = acc
		ElseIf amt<> "0" Then
			stock.data = vol
			future.Data = amt
			coption.data = acc
		ElseIf acc <> "0" Then
			stock.data = vol
			future.data = amt
			coption.data = acc
		Else
			stock.data = vol
			future.Data = amt
			coption.data = acc
		End If

		obj1.Send
	End If
End Sub

