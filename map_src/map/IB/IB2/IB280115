'End Sub

_AW_ONSTART_AW_
count = 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.E1301").Data
If Len(Trim(S1301.Data)) <> 6 Then
	SCREEN.OnSend False
End If

'전일대비 배경색 안 닦이는 문제 해결
If Trim(save_code.Data) = "" Then
	S1301.Data = S1301.Data
End If

If Trim(save_code.Data) <> Trim(S1301.Data) Then
'	SYSTEM.Trace "pass to if "
	S11310.Clear
	save_code.Data = S1301.Data
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Call IsReal_check()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(11310)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(is_real)
_AW_ONCLICK_AW_
Call IsReal_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(real_push)
_AW_ONCLICK_AW_
real_push.Visible False
real_pop.Visible True
real_pop.Checked False

Call IsReal_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(real_pop)
_AW_ONCLICK_AW_
real_push.Visible True
real_pop.Visible False
real_push.Checked True

Call IsReal_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


