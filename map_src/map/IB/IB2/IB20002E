Sub rd_click()
	Dim ii

	If r2_1.Checked Then
		For ii=1 To 20
			If ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	ElseIf r2_2.Checked Then
		For ii=1 To 20
			If ii = 2 Then
				SCREEN.Object("GUBN"&ii).Checked = True
			Else
				SCREEN.Object("GUBN"&ii).Checked = False
			End If
		Next
	ElseIf r2_3.Checked Then
		For ii=1 To 20
			If ii = 2 Or ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	Else

	End If
End Sub

Sub click_grid()
		Dim	key_value, key_text
		key_value = GRID0.GetGridCell(GRID0.Row, 7)
		If Trim(key_value) <= "" Then
			Exit Sub
		End If
		key_text = GRID0.GetGridCell(GRID0.Row, 4)
		If Trim(key_text) <= "" Then
			Exit Sub
		End If
		key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.

		SCREEN.CreateWindow 4, "IBNEWSXX /S/t/d/p1", "015"& vbTab & key_text & vbLf & _
			"016" & vbTab & key_value & vbLf & "1301" & vbTab & SCREEN.Object("main.1301").Data
End Sub

Dim save
save = ""

Sub Check_edit()
	Dim scode

	scode = Trim(SCREEN.Object("main.1301").data)
	If Trim(scode) = "" Then
		Exit Sub
	End If

	If StrComp(save, scode, 1) <> 0 Then
		save = scode
		cod2.Data = SCREEN.object("parent.1301").Data
		isrn.Data = ""
	End If

End Sub

