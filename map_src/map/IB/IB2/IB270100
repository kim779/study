_AW_ONDECLARE_AW_
Dim g_Data
g_Data = ""
'------------------------------------------------------------------------
Sub SetComboData(Data)
	'SYSTEM.Trace "SET COMBO"

	ArrData = Split(Data, "|")
	SYSTEM.Trace Data
	If UBound(ArrData) = 1 Then
		If ArrData(0) = "START" Then
			g_Data = "0001" & vbTab &  ArrData(1)
		End If
	Else
		If ArrData(0) = "END" Then
			TMCB.SetItems g_Data
			'SCREEN.Send 0
			SetTmcdData()
		Else
			g_Data = g_Data & vbTab & ArrData(0)
		End If
	End If


End Sub


Sub SetTmcdData()
'2017-12-28 추가 섹터콤보
	varTmcd = Trim(tmcd.Data)
	If Len(varTmcd) > 0 Then
		Itmcd = CInt(varTmcd)
		If Itmcd >= 100 Then
			TMCB.Data = "0" & Itmcd
		ElseIf Itmcd >10 And Itmcd < 100 Then
			TMCB.Data = "00" & Itmcd
		ElseIf Itmcd < 10 Then
			TMCB.Data = "000" & Itmcd
		Else
			TMCB.Data = "0001"
		End If
	End If

	SCREEN.Send 0
End Sub

Sub Clearcombo()
	TMCB.SetItems(" ")
End Sub

Sub Change_MKGubn_Main(sMKGubn)

SYSTEM.Trace "[IB250400]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0
End Sub

