RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MYFILE = "userconf.ini"
Const MYMAP = "IB290600"


'upgb 801
'KTOP 30(812) 2초

'upgb 201
'KOSDAQ150(305) 2초

'upgb 101
'KOSPI200(116) 경기방어 2초
'KOSPI200(117) 중소형주지수 10초
'KOSPI200(118) 산업재 2초
'KOSPI200(119) 건강관리 2초

Sub check_UpJong()
	Select Case Trim(S20301.Data)
	' 1초 주기 지수
	Case 	101, 107, 108, 109, 110,       _
			111, 112, 113, 114, 116,       _
			117, 130, 305, 310, 311,       _
			312, 313, 314, 315, 316,       _
			317, 620, 621, 622, 628,       _
			629, 630, 631, 632, 633,       _
			997, 998, 999, 650
			SEC.Text = "1초"
			SEC.Visible = True
			r_2sec.Visible  = True
			r_10sec.Visible = True

	' 2초 주기 지수
	Case	118, 120, 121, 122, 123,       _
			127, 128, 129, 307, 308,       _
			601, 602, 603, 604, 606,       _
			607, 609, 610, 612, 613,       _
			615, 616, 623, 624, 625,       _
			626, 627, 801, 802, 803,       _
			804, 805, 812, 813, 814
			SEC.Text = "2초"
			SEC.Visible = True
			r_2sec.Visible  = True
			r_10sec.Visible = True

	' 10초 주기 지수
	Case Else
			SEC.Visible = False
			SEC.Clear()
			r_2sec.Visible  = False
			r_10sec.Visible = True

			If r_2sec.Checked = True Then
				r_10sec.Checked = True
			End If
	End Select
End Sub

Sub	Set_object()
	If r_2sec.Checked = True Then
		OBJECT0.SetObject "IB290610"
	ElseIf r_10sec.Checked = True Then
		If upgb.Data = "101" Or upgb.Data = "303" Or upgb.Data = "999" Or (upgb.Data >= 601 And upgb.Data <= 699) Then
			OBJECT0.SetObject "IB290630"
		Else
			OBJECT0.SetObject "IB290610"
		End If
	ElseIf r_1min.Checked = True Then
		If upgb.Data = "707" Then
			OBJECT0.SetObject "IB290610"
		Else
			OBJECT0.SetObject "IB290630"
		End If
	ElseIf r_10min.Checked = True Then
		OBJECT0.SetObject "IB290630"
	ElseIf r_day.Checked = True Then
		OBJECT0.SetObject "IB290620"
	End If

	OBJECT0.Send
End Sub

Sub Up_name()
	Dim name
	name = SCREEN.GetName(104, S20301.Data, 99)

	If name <> "" Then
		S20022.Data = name
	End If
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim selRadio
		If r_2sec.Checked = True Then
			selRadio = 1
		ElseIf r_10sec.Checked = True Then
			selRadio = 2
		ElseIf r_1min.Checked = True Then
			selRadio = 3
		ElseIf r_10min.Checked = True Then
			selRadio = 4
		ElseIf r_day.Checked = True Then
			selRadio = 5
		End If

		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "upGubn", upgb.Data
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "upjong", S20301.Data
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "radio",  selRadio
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim upGubn, upjong
		upGubn   = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "upGubn"))
		upjong   = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "upjong"))
		selRadio = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "radio"))

		SCREEN.IgnoreChange True
		If upGubn = "" Then
			upgb.Data = "001"
		Else
			upgb.Data = upGubn
		End If

		If upjong = "" Then
			S20301.Data = "001"
		Else
			S20301.Data = upjong
		End If

		If selRadio = "" Then
			If upgb.Data = "101" Then
				r_2sec.Checked = True
'			ElseIf upgb.Data = "701" Then  프리보드 지수 삭제
'				r_1min.Checked = True
			Else
				r_10sec.Checked = True
			End If
		Else
			Select Case SelRadio
				Case 1 : r_2sec.Checked = True
				Case 2 : r_10sec.Checked = True
				Case 3 : r_1min.Checked = True
				Case 4 : r_10min.Checked = True
				Case 5 : r_day.Checked = True
			End Select
		End If

		SCREEN.IgnoreChange False
	End If
End Sub


Dim upcd_flg
upcd_flg = 1


Sub p_write_com()
	If SCREEN.CreateObject("Info") Then
	  	INFO.PushData LOGIN.Name, myFILE, myMAP, "COMBO1", S20301.Data
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "upGubn", upgb.Data
	End If
End Sub

Sub p_read_com()
	If SCREEN.CreateObject("Info") Then
	 	S20301.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COMBO1"))
	 	upgb.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "upGubn"))
	End If

	If Len(Trim(S20301.data)) = 0 Then
		S20301.data = "001"
		upgb.DATA = "001"
	End If

End Sub

