_AW_SCRIPT_AW_(20301)
_AW_ONCHANGE_AW_
Dim  r_upgb
SCREEN.IgnoreChange True
	r_upgb = P_GetBigCd(S20301.Data)
	Select Case r_upgb
		Case "001"		'KOSPI
			upgb.Data = r_upgb
		Case "101"		'KOSPI200
			upgb.Data = r_upgb
		Case "201"		'KOSDAQ
			upgb.Data = r_upgb
		Case "301"		'KOSDAQ50
			If S20301.Data = "303" Then
				upgb.Data = S20301.Data
			ElseIf S20301.Data = "305" Or (S20301.Data >= 309 And S20301.Data <= 317) Then
				upgb.Data = "201"
			Else
				upgb.Data = r_upgb
			End If
		Case "401"		'KOSPI100
			upgb.Data = r_upgb
		Case "303"		'KOSTA
			upgb.Data = r_upgb
		Case "999"		'KRX100
			upgb.Data = r_upgb
		Case "998"		'KRX300
			upgb.Data = r_upgb
		Case "997"		'KRX200
			upgb.Data = r_upgb
		Case "601"		'SECTOR
			upgb.Data = r_upgb
		Case "701"		'SECTOR
			upgb.Data = r_upgb
		Case "801"		'기타
			upgb.Data = r_upgb
		Case Else
		   S20301.Data = "001"
		   upgb.Data = "001"
	End Select

Call check_UpJong()
'Call Set_Object()

If upcd_flg = 1 Then
	upcd_flg = 2
Else
	Call p_write_com()

End If

SCREEN.Send 0
SCREEN.SetTimer 1, False
SCREEN.IgnoreChange False

S20301.SetFocus
Up_name()
