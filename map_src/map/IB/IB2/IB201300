Dim code
If GRID.HitPos = 3 Then
	code = GRID.GetGridCell(GRID.index +1, 2)
	If Trim(code) <> "" Then
		S1301.Data = Mid(code, 2, Len(code))
		S1301.Trigger "", True
      SYSTEM.SetHistory "1301", S1301.Data
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(gubn)
_AW_ONCHANGE_AW_
SCREEN.IgnoreChange True
Select Case gubn.Data
	Case "0"
		LAB01.Text = "일자"
		CDAT.Visible = True
		TRAD.Visible = False
		r_kp.Visible = False
		r_kq.Visible = False
		'CDAT.data = EDIT0.Data
		dgub.Data = CDAT.data
	Case "1"
		LAB01.Text = "회원"
		CDAT.Visible = False
		TRAD.Visible = True
		r_kp.Visible = False
		r_kq.Visible = False
		TRAD.Index = 0
		dgub.Data = TRAD.data
	Case "2"
		LAB01.Text = "시장"
		CDAT.Visible = False
		TRAD.Visible = False
		r_kp.Visible = True
		r_kq.Visible = True
		r_kp.Checked = True
		dgub.Data = "1"
End Select
SCREEN.SEND 0
SCREEN.IgnoreChange False
