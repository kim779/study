_AW_ONDECLARE_AW_
Public Function change_date2(dat,diff, tday)
	Dim cday, yy, mm, dd
	Dim y, m,d, temp
	y = Mid(tday,1,4)
	m = Mid(tday,5,2)
	d = Mid(tday,7,2)



	temp = DateSerial(y, m, d)

	cday = DateAdd(dat, diff, temp)

	yy = Year(cday)
	mm = Month(cday)
	If Len(mm) = 1 Then mm = "0"&mm
	dd = Day(cday)
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd

	change_date2 = CDbl(cday)
End Function

