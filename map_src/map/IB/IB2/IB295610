RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 0
	SCREEN.Send 0
End Sub

Sub OnAlert()

	If SCREEN.Object("parent.TYPEE").text = "금액" Then
		Call SetMoney()
		Exit Sub
	End If

	Dim i, j, colPos, val, pGrid, pSum
	Set pGrid = SCREEN.Object("parent.GRID")

'	SYSTEM.Trace "rows = " & GRID.Rows

	For i = 1 To GRID.Rows
		If Trim(pGrid.GetGridCell(i, 4)) = Trim(GRID.GetGridCell(i, 4)) Then
			colPos = 8
		Else
			colPos = 1
			'pGrid.SetPrgb i, 4, 94	'test용
		End If

		For j = colPos To GRID.Columns
			val = GRID.GetGridCell(i, j)

			If j = 4 Then
				Dim gb
				gb = Trim(GRID.GetGridCell(i, 3))

				If gb = "" Then
					val = " " & val
				Else
					val = gb & val
				End If
			End If

			If j = 6 Then
				Dim giho
				giho = Trim(GRID.GetGridCell(i, 7))
				giho = Left(giho, 1)

				If giho = "+" Or giho = "-" Then
					val = giho & val
				End If
			End If

			If j = 9 Then	'순매수 금액
				val = GRID.GetGridCell(i, j)

				If Len(Trim(val)) <> 0 Then
					 If Int(val) > 0 Then
						val = "+" & val
					End If
				End If
			End If

			pGrid.SetGridCell i, j, val
		Next
	Next

	If Len(Trim(Sum1.Data)) <> 0 Then
		 If Int(Sum1.Data) > 0 Then
			Sum1.Data = "+" & Sum1.Data
		End If
	End If

	For i = 1 To 7
		pSum = "Sum" & i

		SCREEN.Object("parent." & pSum).Data = SCREEN.Object(pSum).Data
	Next

	SCREEN.Object("parent.OUTPUT0").Data = Sum3.data
	SCREEN.Object("parent.OUTPUT1").Data = Sum6.data
End Sub

Sub SetMoney()

	Dim i, j, colPos, val, pGrid, pSum, cur

	Set pGrid = SCREEN.Object("parent.GRID")

	For i = 1 To GRID.Rows
		If Trim(pGrid.GetGridCell(i, 4)) = Trim(GRID.GetGridCell(i, 4)) Then
			colPos = 8
		Else
			colPos = 1
		End If

		For j = colPos To GRID.Columns
			val = GRID.GetGridCell(i, j)
			cur = GRID.GetGridCell(i, 6)

			If (j >= 9 And j <= 15) Then
					If(Len(Trim(val)) = 0 Or Len(Trim(cur)) = 0) Then
						val = 0
					Else
						val = Fix(Int(cur) * Int(val) / 1000000)	' 현재가 * 값 / 백만
					End If

			End If

			Select Case j
				Case 9	' 순매수 금액
					Sum1.Data = Sum1.Data + val

					If Len(Trim(val)) <> 0 Then
						 If Int(val) > 0 Then
							val = "+" & val
						End If
					End If
				Case 10 ' 매수금액
					Sum2.Data = Sum2.Data + val
				Case 11	' 매수 공시금액
					Sum3.Data = Sum3.Data + val
				Case 12 ' 매수 정정공시
					Sum4.Data = Sum4.Data + val
				Case 13 ' 매도금액
					Sum5.Data = Sum5.Data + val
				Case 14 ' 매도 공시금액
					Sum6.Data = Sum6.Data + val
				Case 15 ' 매도 정정공시
					Sum7.Data = Sum7.Data + val
				Case Else

			End Select

			pGrid.SetGridCell i, j, val
		Next
	Next

	If Len(Trim(Sum1.Data)) <> 0 Then
		 If Int(Sum1.Data) > 0 Then
			Sum1.Data = "+" & Sum1.Data
		End If
	End If


	For i = 1 To 7
		pSum = "Sum" & i

		SCREEN.Object("parent." & pSum).Data = SCREEN.Object(pSum).Data
	Next

	SCREEN.Object("parent.OUTPUT0").Data = Sum3.data
	SCREEN.Object("parent.OUTPUT1").Data = Sum6.data

End Sub

_AW_ONSEND_AW_
If SCREEN.Object("parent.chkAutoSend").Checked = False Then
	SCREEN.OnSend = False
	Exit Sub
End If

trgb.Data = Trim(SCREEN.Object("parent.TRGB").Data)
sort.Data = Trim(SCREEN.Object("parent.SORT").Data)
rtsGubn.Data = "1"
pageInptNum.Data = Trim(SCREEN.Object("parent.pageOutNum").Data)
EDIT0.Data = Trim(SCREEN.Object("parent.EDIT0").Data)

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Call OnAlert()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID)
_AW_ENDSCRIPT_AW_


}



