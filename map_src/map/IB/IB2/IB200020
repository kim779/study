'0:5호가, 1:10호가, 2:최초 화면열었을 때 인덱스
g_IniIndex = ""
'-----------------------------------------------------------------------
Sub SetIniName(IniIndex)
	g_IniIndex = IniIndex
	Sindex = "0"
	If SCREEN.CreateObject("Info") Then
		Sindex = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB200020", "HOGA_INDEX" & g_IniIndex))
		If Len(Sindex) = 0 Then
			INFO.PushData LOGIN.Name, "userconf.ini", "IB200020", "HOGA_INDEX" & g_IniIndex, "0"
			Sindex = "0"
		End If
	End If
	ArrHogaCtrl(2) = Sindex
	SetHogaVisible Sindex
End Sub
'-----------------------------------------------------------------------
Sub SetHogaVisible(SIndex)
	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB200020", "HOGA_INDEX" & g_IniIndex, SIndex
	End If

	If SIndex = "0" Then
		ArrHogaCtrl(0).visible = True
		ArrHogaCtrl(1).Visible = False
		bt_Hoga.Text = "10호가"
	Else
		ArrHogaCtrl(0).visible = False
		ArrHogaCtrl(1).Visible = True
		bt_Hoga.Text = "5호가"
	End If
End Sub

