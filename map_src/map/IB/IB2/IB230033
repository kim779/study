	End If
	If Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data) = "" Then
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

