Option Explicit

Sub SetTradList()
	Dim TRADNm, pos
	pos = 0
	TRAD.Index = pos
	TRADNm = ""

'	SYSTEM.Trace "trad.Data = " & TRAD.Data
'	SYSTEM.Trace "tradnm = " & TRADnm

	While Trim(TRAD.Text) <> Trim(TRADNm)
		TRADNm = Trim(TRAD.Text)
'		SYSTEM.Trace "pos = " & pos
'		SYSTEM.Trace "tradnm2 = " & TRADnM
		GRID0.InsertRow -1
		GRID0.SetGridCell GRID0.Rows, 1, Trim(TRAD.Text)
		pos = pos + 1
		TRAD.Index = pos
	Wend

	GRID0.SetFocus
	GRID0.Index = 1
	TRAD.Index = GRID0.Index
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
