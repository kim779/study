RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Const myFILE = "userconf.ini"

Dim start_f
start_f = 0

Sub ToggleChart()
	If Trim(B_GUBN.Text) = "데이터" Then '데이터를 보여줌.
		B_GUBN.Text = "차트"
		obj_date.SetObject "IB230202"
		obj_time.SetObject "IB230201"
		CHK.Text = "2"
	Else
		B_GUBN.Text = "데이터"
		obj_date.SetObject "IB230205"
		obj_time.SetObject "IB230204"
		CHK.Text = "1"
	End If
End Sub

Sub objSend()
	If Trim(ed_trcd.Data) <> "" Then
		Exit Sub
	End If
	
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Proc "obj_date.send_f", ""
	SCREEN.Proc "obj_time.send_f", ""
End Sub


Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	Send_Screen()
End Sub

Sub Send_Screen()
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
End Sub

Sub Send_OBJ()
	cxMarket.sCode = Trim(S1301.Data)

	obj_date.Send
	obj_time.Send
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

Dim ii, row, comNm, bNm
row = 1


If TRAD.Data = "888" Then
	ed_trcd.Data = TRAD.Data
End If

For ii = 0 To 999
	TRAD.Index = ii
	comNm = Trim(TRAD.Text)

	If Trim(comNm) = bNm Then
		Exit For
	End If

	GRID0.InsertRow -1

	GRID0.SetGridCell GRID0.Rows, 1, comNm
	bNm = Trim(TRAD.Text)
Next

TRAD.Index = 1
GRID0.Index = 1

SCREEN.SetTimer 0.5, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

If Trim(ed_trcd.Data) <> "" Then
	Exit Sub
End If

Send_OBJ()

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.IgnoreChange True

If Trim(ed_trcd.Data) <> "" Then
	TRAD.Data = ed_trcd.Data

	'TR2014 회원사탭등에서 선택시
	'선택한 회원사로 포커스를 줌
	Dim trNm, ii, grTrNm
	trNm = Trim(TRAD.Text)

	For ii = 1 To GRID0.Rows
		grTrNm = Trim(GRID0.GetGridCell(ii, 1))

		If trNm = grTrNm Then
			GRID0.Index ii - 1
			Exit For
		End If
	Next
Else
	Exit Sub
End If

ed_trcd.Clear

Call objSend()

SCREEN.IgnoreChange False

S1301.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(TRAD)
_AW_ONCHANGE_AW_
sect.Data = 1

Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )

If retn <> True Then
       Exit Sub
End If

obj_hnam.Send
Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTN)
_AW_ONCLICK_AW_
sect.Data = 5

Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(B_GUBN)
_AW_ONCLICK_AW_
sect.Data = 4
Call ToggleChart()
Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim codx
codx = S1301.Data
codx = Trim(codx)
'SCREEN.CreateWindow 1, "IB230300 /t/d/p?/S","1301" & vbTab & codx
SCREEN.ChangeMap "IB230300"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
sect.Data = 2

obj_hnam.Send

If start_f = 0 Then
	start_f = 1
Else
	Call objSend()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB202201 /t/s/p5/d", "appendCODE" & _
			vbTab & S1301.Data & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctl_Category)
_AW_ONCLICK_AW_
Dim codx
codx = ctl_Category.GetPreCode(S1301.Data)

If Trim(codx) = "" Then
	Exit Sub
End If

S1301.Data = codx
S1301.Trigger "",True

cxMarket.sCode = Trim(S1301.Data)
obj_hnam.Send
Call objSend()
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim codx
codx = ctl_Category.GetNextCode(S1301.Data)

If Trim(codx) = "" Then
	Exit Sub
End If

S1301.Data = codx
S1301.Trigger "",True

obj_hnam.Send
Call objSend()
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
S1301.Data = ctl_Category.GetCurCode
S1301.Trigger "",True

SCREEN.Send 0

obj_hnam.Send
Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	TRAD.Index = GRID0.Index
	Call objSend()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
Send_OBJ()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



