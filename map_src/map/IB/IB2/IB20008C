{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos, pw_symb

Dim jango, bond, sangjang, feeGubn, maeche, feePro, checha, mesuFee, medoFee, medoTax, pdaycday, loan, credit, feeProT

Sub InitOption()
	jango = "1"
	bond = "0"
	sangjang = "0"

	feeGubn = SCREEN.Object("parent.cbo_tax").data

	If feeGubn = 1 Then
		medoFee = 1
		medoTax = 1
	End If
	Select Case SCREEN.Object("parent.cbo_mmd").data
		Case "0"
			maeche = "01"
		Case "1"
			maeche = "00"
		Case "2"
			maeche = "07"
	End Select

	Dim nPos, strTemp
	If feePro = "" Or feePro = "0" Then
		feePro = "0.0000"
		feeProT = feePro
		strTemp = "+" & "0.0000"
	ElseIf feePro = "100" Then
		feeProT = feePro
		strTemp = "+" & "1.0"
	ElseIf CDbl(feePro) = 0 Then
		feePro = "0.0000"
		feeProT = feePro
		strTemp = "+" & "0.0000"
	Else
		feeProT = feePro
		strTemp = "+" & Trim(feePro)/100
	End If

	If Len(Trim(strTemp)) <> 11 Then
		Dim ii, strZero
		strZero = ""
		For ii = 0 To 11 - Len(Trim(strTemp))
			strZero = strZero & "0"
		Next

		feePro = strTemp & strZero
	Else
		feePro = strTemp
	End If

	If Trim(checha) = "" Or Len(Trim(Replace(checha, "0", ""))) = 0 Then
		checha = "+000000000000000"
	ElseIf Len(Trim(checha)) = 15 Then
		checha = "+" & checha
	End If

	If Trim(mesuFee) = "" Then
		mesuFee = "0"
	End If

	If Trim(medoFee) = "" Then
		medoFee = "0"
	End If

	If Trim(medoTax) = "" Then
		medoTax = "0"
	End If

	If Trim(pdaycday) = "" Then
		pdaycday = "0"
	End If

	If Trim(loan) = "" Then
		loan = "0"
	End If

	If Trim(credit) = "" Then
		credit = "0"
	End If

	'수수료 미적용시 매수, 매도, 매도제세금을 0으로 보낸다.
	If Trim(feeGubn) = "0" Then
		mesuFee = medoFee = medoTax = 0
	End If

	zD2balBaseQryTp.Data = jango
	zBalCreTp.Data = bond
	zOtptPtnTp.Data = sangjang
	zCmsnAmtAppTp.Data = feeGubn
	zCommdaCode.Data = maeche
	zCmsnAmtRat.Data = feePro
	zAddCmsnAmtLevyAmt.Data = checha

	zOtptTp1.Data = mesuFee
	zOtptTp2.Data = medoFee
	zOtptTp3.Data = medoTax
	zOtptTp4.Data = pdaycday
	zOtptTp5.Data = loan
	zOtptTp6.Data = credit
	zOtptTp7.Data = credit
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	Call InitOption()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Function chkNumData(num)
	chkNumData = False

	If Trim(num) = "" Then
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Exit Function
	End If

	chkNumData = True
End Function


Sub OnClear()
	out_can.Data = ""
	out_d2.Data = ""
	out_ass.Data = ""
	out_cred.Data = ""
