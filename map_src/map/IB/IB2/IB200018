RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub func_r2()
	AMTF.Data = "2"
	SCREEN.Object("OBJ.AMTF").Data = AMTF.Data
End Sub

Sub func_r1()
	AMTF.Data = "1"
	SCREEN.Object("OBJ.AMTF").Data = AMTF.Data
	SCREEN.Object("OBJ.DAN").Data = "0"
End Sub

Sub func_r3()
	AMTF.Data = "1"
	SCREEN.Object("OBJ.AMTF").Data = AMTF.Data
	SCREEN.Object("OBJ.DAN").Data = "1"
End Sub

_AW_ONSTART_AW_
Dim radio

If SCREEN.CreateObject("Info") Then
	GUBN.data = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200018_COM1"))

	radio = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200018_RDO1"))
	Select Case radio
		Case "1"
			R1.Checked = False
			R2.Checked = True
			R3.Checked = False
			func_r2()
		Case "2"
			R1.Checked = True
			R2.Checked = False
			R3.Checked = False
			func_r1()
		Case "3"
			R1.Checked = False
			R2.Checked = False
			R3.Checked = True
			func_r3()
	End Select
End If

SCREEN.SetTimer 5, True

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.Object("main.1301").Data
OBJ.Send

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
S1301.SetFocus

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
OBJ.Send

_AW_ONENDSUB_AW_
