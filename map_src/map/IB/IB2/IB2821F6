RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim IsClick

IsClick = False

'================================================================================
' 메인에서 send_sise_all()시 호출됨. tab_account전환시 호출
' 화면이 처음뜰 때 obj_currentVal에서 매수가격(현재가)를 가져온 후 chkCondition()으로..
'================================================================================
Sub send_main()
	jmcd.Data = Trim(SCREEN.Object("main.1301").Data)
	obj_currentVal.Send
End Sub


'================================================================================
' 현금/신용 구분 및 매매구분으로 화면 세팅값 가져옴.
'================================================================================
Sub chkCondition()
	Dim OrderMap

	OrderMap = SCREEN.Object("main.OBJ_order.OBJ_odr").GetObject()

	Call getMapInfo(OrderMap)

	If Trim(mmgb.Data) = "1" Or Trim(mmgb.Data) = "2" Then
		com_mmgb.Data = mmgb.Data
	End If
End Sub


'===============================================================================
' IB100100일 때 현금/신용구분 및 매매구분값 가져옴.
' 주문화면보다 tab_ordertyp이 늦게 뜨기 때문에 하나하나 풀어서 적음.
'===============================================================================
Sub getMapInfo(mapNm)
	Select Case Trim(mapNm)
		Case "IB100150"
			mmgb.Data = "1"

			If SCREEN.Object("main.OBJ_order.OBJ_odr.r_cash").Checked = True Then
				sygubn.Data = "0"
			Else
				sygubn.Data = "1"
			End If
			com_sygubn.Data = sygubn.Data
		Case "IB100160"
			mmgb.Data = "2"

			If SCREEN.Object("main.OBJ_order.OBJ_odr.r_cash").Checked = True Then
				sygubn.Data = "0"
			Else
				sygubn.Data = "1"
			End If
			com_sygubn.Data = sygubn.Data
		Case "IB100170"
			mmgb.Data = "3"
		Case "IB102150"
			mmgb.Data = "1"
			sygubn.Data = "1"
		Case "IB102170"
			mmgb.Data = "3"
			com_mmgb.Data = "1"
			sygubn.Data = "1"
		Case "IB103011"
			mmgb.Data = "1"
			sygubn.Data = "0"
		Case "IB103012"
			mmgb.Data = "3"
			com_mmgb.Data = "1"
			sygubn.Data = "0"
	End Select
End Sub

Sub setRadio(data)
	'SYSTEM.Trace "setRadio : " & data
	If data = 1 Then
		r1.Checked False
		r2.Checked True
	Else
		r1.Checked True
		r2.Checked False
	End If
End Sub
'===============================================================================
' 현금/신용구분, 매매구분으로 화면 세팅
'===============================================================================
Sub SetSrc()
	com_sygubn.Enable = True
	com_mmgb.Enable = True


	If Trim(mmgb.Data) = "1" Or Trim(mmgb.Data) = "2" Then
		com_sygubn.Enable = False

		mmgbLabel.Visible = False
		com_mmgb.Visible = False

		If mmgb.Data = "1" And sygubn.Data = "1" Then
			syDateLabel.Visible = True
			syDate.Visible = True
			syDate.Data = Trim(SCREEN.Object("main.OBJ_order.OBJ_odr.ed_date").Data)
		Else
			syDateLabel.Visible = False
			syDate.Visible = False
		End If
	Else
		com_sygubn.Enable = True
		com_mmgb.Enable = True

		mmgbLabel.Visible = True
		com_mmgb.Visible = True

		If sygubn.Data = "0" Then
			syDateLabel.Visible = False
			syDate.Visible = False
		Else
			If com_mmgb.Data = "1" Then
				syDateLabel.Visible = True
				syDate.Visible = True
			Else
				syDateLabel.Visible = False
				syDate.Visible = False
			End If

			If SCREEN.Object("main.OBJ_order.OBJ_odr").GetObject() = "IB102170" Then
				com_mmgb.Data = 1
				com_mmgb.Enable = False
				com_sygubn.Data = 1
				com_sygubn.Enable = False
			ElseIf SCREEN.Object("main.OBJ_order.OBJ_odr").GetObject() = "IB103012" Then
				com_mmgb.Data = 1
				com_mmgb.Enable = False
				com_sygubn.Data = 0
				com_sygubn.Enable = False
			End If
		End If
	End If

	If Trim(sygubn.Data) = "" Then
		sygubn.Data = Trim(com_sygubn.Data)
	End If

	Dim checkCombo
	'호가유형타잎 결정
	If sygubn.Data = "0" Then
		obj0.SetObject("IB1001FE")

		If IsClick = True Then
			If r2.Checked = True Then
				SCREEN.Object("obj0.zCommdaCode").data = "99"
			Else
				SCREEN.Object("obj0.zCommdaCode").data = "00"
			End If
			IsClick = False
		Else

			checkCombo = Trim(SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data)

			If checkCombo = "81" Or checkCombo = "82" Or checkCombo = "61" Then
				r1.Checked = False
				r2.Checked = True
				SCREEN.Object("obj0.zCommdaCode").data = "99"
			Else
				r1.Checked = True
				r2.Checked = False
				SCREEN.Object("obj0.zCommdaCode").data = "00"
			End If
		End If

	Else
		obj0.SetObject("IB1001FF")

		If IsClick = True Then
			If r2.Checked = True Then
				SCREEN.Object("obj0.EDIT0").data = "81"
			Else
				SCREEN.Object("obj0.EDIT0").data = Trim(SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data)
			End If
			IsClick = False
		Else
			checkCombo = Trim(SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data)

			If checkCombo = "81" Or checkCombo = "82" Or checkCombo = "61" Then
				r1.Checked = False
				r2.Checked = True
				SCREEN.Object("obj0.EDIT0").data = "81"
			Else
				r1.Checked = True
				r2.Checked = False
				SCREEN.Object("obj0.EDIT0").data = checkCombo
			End If
		End If

	End If

End Sub


Sub send_f()
	Call chkCondition()
	Call SetSrc()

	If sygubn.Data = "0" Then
		obj0.SetObject("IB1001FE")
	Else
		obj0.SetObject("IB1001FF")
	End If

	If IsNumeric(ed_jprc.Data) = True Then
		If CDbl(ed_jprc.Data) = 0 Then
			ed_jprc.Data = SCREEN.Object("main.OBJ_sise.2023").Data
		End If

		SCREEN.Proc "obj0.send_f", ""
	Else
		Call guide_msg(Trim(com_mmgb.Text) & "가격을 확인하여 주십시오.")
		ed_jprc.SetFocus
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

If Len(Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)) < 4 Then
	Exit Sub
End If

Call send_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_jprc)
_AW_ONCHARCHANGE_AW_
Dim prc
prc = Trim(ed_jprc.Data)

If Left(prc, 1) = "+" Or Left(prc, 1) = "-" Then
	ed_jprc.Data = Mid(prc, 2)
End If
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then
	If Trim(ed_jprc.Data) <> "" Then
		If Is_numeric(ed_jprc.Data) = True Then
			Call send_f()
		Else
			Call guide_msg("매수가격을 확인하여 주십시오.")
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
IsClick = True
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(com_sygubn)
_AW_ONCHANGE_AW_
sygubn.Data = com_sygubn.Data
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(com_mmgb)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(syDate)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r1)
_AW_ONCLICK_AW_
IsClick = True
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r2)
_AW_ONCLICK_AW_
IsClick = True
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



