_AW_ONDECLARE_AW_
Sub p_write_ini(data)
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB290800", "mapName", data
	End If
End Sub

Sub p_write_ini2()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB290800", "vol", stock.data
		INFO.PushData LOGIN.Name, "userconf.ini", "IB290800", "amt", future.data
		INFO.PushData LOGIN.Name, "userconf.ini", "IB290800", "acc", coption.data
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim mapName

		mapName = Trim(INFO.PopData(LOGIN.Name, "userconf.ini","IB290800", "mapName"))
'		SYSTEM.Trace "Mapname ; " & mapName

		Select Case mapName
			Case "IB290800"
				Call p_read_ini2()
			Case "IB290830"
				SCREEN.changemap "IB290830"
			Case "IB290840"
				SCREEN.changemap "IB290840"
			Case "IB290850"
				SCREEN.changemap "IB290850"
		End Select



	End If

End Sub

Sub p_read_ini2()


	If SCREEN.CreateObject("INFO") Then

		Dim vol, amt, acc
		vol = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB290800", "vol"))
		amt = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB290800", "amt"))
		acc = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB290800", "acc"))

'			SYSTEM.Trace "IB290800 ; vol " &  vol
'			SYSTEM.Trace "IB290800 ; amt " &  amt
'			SYSTEM.Trace "IB290800 ; amt " & acc
		If vol <> "0" Then
			stock.data = vol
			future.Data = amt
			coption.data = acc
			Call clickVol()
		ElseIf amt<> "0" Then
			stock.data = vol
			future.Data = amt
			coption.data = acc
			Call clickAmt()
		ElseIf acc <> "0" Then
			stock.data = vol
			future.data = amt
			coption.data = acc
			Call clickAcc()
		Else
			stock.data = vol
			future.Data = amt
			coption.data = acc
			Call clickAcc()
		End If
	End If
End Sub

