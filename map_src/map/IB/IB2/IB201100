_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB201100"

Sub p_read_com()
If SCREEN.CreateObject("Info") Then

 	BUTTON1.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COMBO1"))
 	Dim tmp
 	tmp = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COMBO2"))
 	If tmp = "1" Then
  		RADIO0.Checked = True
	ElseIf tmp = "2" Then
	  	RADIO1.Checked = True
	ElseIf tmp = "3" Then
	  	RADIO2.Checked = True
	End If

End If
End Sub

Sub p_write_com()
If SCREEN.CreateObject("Info") Then

  INFO.PushData LOGIN.Name, myFILE, myMAP, "COMBO1", BUTTON1.Text

End If
End Sub

Sub changeObj()
	If BUTTON1.text = "차트" Then
		If RADIO0.Checked = True Then
			obj.SetObject ("IB201111")
		ElseIf RADIO1.Checked = True Then
			obj.SetObject ("IB201121")
		Else
			obj.SetObject ("IB201131")
		End If
		'SCREEN.SetSize 824, 408
		BUTTON1.text = "데이터"
	Else
		If RADIO0.Checked = True Then
			obj.SetObject ("IB201110")
		ElseIf RADIO1.Checked = True Then
			obj.SetObject ("IB201120")
		Else
			obj.SetObject ("IB201130")
		End If
		'SCREEN.SetSize 824, 408
		BUTTON1.text = "차트"
	End If


	'SYSTEM.Push "BUTTON1_f", BUTTON1.text
	cxMarket.sCode = Trim(S1301.Data)
	obj.Send
End Sub


