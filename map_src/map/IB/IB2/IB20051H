		Exit Sub
	End If

	If g_ArrPrc(0) <> Str2Int(S2023.Data) Then
		SetBox
	End If

	If Str2Int(g_ArrPrc(1)) <> Str2Int(S2023.Data) Then
		SetBox
	End If

	g_ArrPrc(0) = Str2Int(S2023.Data)
	g_ArrPrc(1) = Str2Int(S3051.Data)

