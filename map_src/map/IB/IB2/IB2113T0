If c_upgb.Data = 889 Then
	S200901.Enable = False
	UBUT.Enable = False
Else
	S200901.Enable = True
	UBUT.Enable = True
End If

SCREEN.SetTimer 1, True

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If IsStart = False Then
	SCREEN.OnSend = False
	Exit Sub
End If

If cxMarket.sMarket = "KRX" Then
	S200777.DATA = "1"
ElseIf cxMarket.sMarket = "NXT" Then
	S200777.DATA = "2"
ElseIf cxMarket.sMarket = "통합" Then
	S200777.DATA = "3"
End If

If Start.DATA = "0" Then
	SCREEN.OnSend = False
	SCREEN.SetTimer 2, False
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If S209300.Page <> 1  Then
	S209300.SetFocus
	S209300.INDEX = 0

	S1301.DATA = S209300.GetGridCell(S209300.INDEX +1, 3)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If

If S200301.Data = 1 Then
	S209300.SetFocus
	S209300.INDEX = 0
ElseIf S200301.Data = "-1" Then
	S209300.SetFocus
	S209300.INDEX = S209300.Rows-1
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Start.Data = "1" Then
	IsStart = True
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(209300)
