_AW_ONCHANGE_AW_
Dim	cod
If (Len(Trim(S200901.Data)) <> 3) Then
	S200901.SetFocus
	Exit Sub
Else
	SCREEN.IgnoreChange True
	r_upgb = P_GetBigCd(S200901.DATA)
	If S200901.Data = 889 Then
		r_upgb = 889
	End If
	Select Case r_upgb
		Case "001"		'KOSPI
			c_upgb.DATA = r_upgb
		Case "101"		'KOSPI200
			c_upgb.DATA = r_upgb
		Case "201"		'KOSDAQ
			c_upgb.DATA = r_upgb
		Case "301"		'KOSDAQ50
			c_upgb.DATA = r_upgb
		Case "303"		'KOSTAR
			c_upgb.DATA = r_upgb
		Case "401"		'KOSPI100
			c_upgb.DATA = r_upgb
		Case "888"		'ELW
			c_upgb.DATA = r_upgb
		Case "889"
			c_upgb.Data = r_upgb
		Case Else
		   S200901.DATA = "001"
		   c_upgb.DATA = "001"
	End Select
	SCREEN.Send 2
	SCREEN.IgnoreChange False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_upgb)
