Function Is_numeric(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		Is_numeric = 0
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Is_numeric = 0
		Exit Function
	End If

	Is_numeric = CDbl(num)
End Function

Sub sendobj()
Dim i
	vagb.Data = 1 '수량
	If Left(Trim(SCREEN.Object("parent.TABLE14").GetHead(1)) , 1) <> "M" Then
		For i = 1 To 3
			SCREEN.Object("v"&i).visible = True
		Next
		For i = 4 To 6
			SCREEN.Object("v"&i).visible = False
		Next
	Else
		For i = 1 To 3
			SCREEN.Object("v"&i).visible = False
		Next
		For i = 4 To 6
			SCREEN.Object("v"&i).visible = True
		Next
	End If
End Sub

