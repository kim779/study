	End If

	codx = Trim(data)
	If Left(codx, 1) = "m" Then
		Exit Sub
	End If

	If Len(codx) = 3 Then
		Exit Sub

	ElseIf Len(codx) = 6 Then
		S1301.Data = codx
		SCREEN.Proc "Send_sise_all", codx
	Else
		Exit Sub
	End If
End Sub


