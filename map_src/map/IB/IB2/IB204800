_AW_ONDECLARE_AW_
Sub jongmoksetting()
	SYSTEM.Trace "jongmok" & CHECK0.checked
	If CHECK0.checked = True Then
		S1301.Enable = True
		BUTTON1.Enable = True
	Else
		S1301.Enable = False
		BUTTON1.Enable = False
	End If
	send_f()
End Sub

Sub send_f()
	SCREEN.Send 2
'	SCREEN.Object("OBJ0").send
	OBJ0.send
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0
	OBJ0.Send
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

jongmoksetting()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1777.Data =  "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1777.Data =  "3"
	End If
	SYSTEM.Trace "yes cxMarket 1777 = " & S1777.Data
Else
	SYSTEM.Trace "no cxMarket map = " & SCREEN.GetMapName(0)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SBTN)
_AW_ONCLICK_AW_
send_f()
'obj2.Send

S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(day1)
