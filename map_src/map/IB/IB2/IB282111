RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub sep_memo()
	Dim str, ii, jj, slen, cnt, comp, piece
	str = Trim(MEMO0.Text)
	slen = Len(str)
	If slen <= 0 Then
		Exit Sub
	End If

	cnt = Int(slen / 50)

	jj = 1
	For ii = 0 To cnt
		piece = Trim(Mid(str, jj, 50))
		jj = jj + 50
		comp = "PANEL"&ii
		SCREEN.Object(comp).Text = piece
		SCREEN.Object(comp).Visible = True
	Next

	SCREEN.SetSize 540-1, ((cnt+2) * 20) + 40
	PANEL.SetRect 0, 0, 540, ((cnt+2) * 20) + 40
End Sub

_AW_ONSTART_AW_
If Trim(cod2.Data) <> "" Then
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
cod2.Clear()
NAME.Data = Trim(HNAM.Text)
sep_memo()

_AW_ONENDSUB_AW_
}



