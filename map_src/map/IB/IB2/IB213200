'--------------------------------------------------------------------------------------------------------------
Sub SaveLaststate()
	Dim sState

	If rdKospi.Checked = True Then
		sState = "0"
	Else
		sState = "1"
	End If

	If rdupdown.Checked = True Then
		sState = sState & "!" & "0"
	Else
		sState = sState & "!" & "1"
	End If

	If rdupdown.Checked = True Then
		sState = sState & "!" & COMBO2.Index
	Else
		sState = sState & "!" & COMBO3.Index
	End If

	SYSTEM.Push "MARKETMAP", sState
End Sub


'--------------------------------------------------------------------------------------------------------------
Sub LoadLaststate()
	Dim sState, arr
	sState = SYSTEM.Pop("MARKETMAP")

	If Len(Trim(sState)) = 0 Then
		ShowLabel()
		Exit Sub
	End If

	arr = Split(sState, "!")

	If arr(0) = "0" Then					'코스피
		rdKospi.Checked = True
	Else									'코스닥
		rdKosdaq.Checked = True
	End If

	If arr(1) = "0" Then					'등락
		rdupdown.Checked = True
		rdsugb.Checked = False
		COMBO2.Visible = True				'시가총액 거래량 거래대금 콤보
		COMBO3.Visible = False

		If arr(2) = "0" Then
			COMBO2.Index = 0
		ElseIf arr(2) = "1" Then
			COMBO2.Index = 1
		ElseIf arr(2) = "2" Then
			COMBO2.Index = 2
		End If

	Else
		rdupdown.Checked = False								'수급
		rdsugb.Checked = True
		COMBO2.Visible = False
		COMBO3.Visible = True

