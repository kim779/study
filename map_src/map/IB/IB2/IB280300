_AW_ONDECLARE_AW_
Dim r_grjm, r_upjm, r_dnjm, r_alljm

Const myFILE = "userconf.ini"
Const myMAP = "IB280300"

Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_grjm",  R1.Checked
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_upjm",  R2.Checked
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_dnjm",  R3.Checked
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_alljm", R4.Checked
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
		r_grjm  = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_grjm"))
		r_upjm  = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_upjm"))
		r_dnjm  = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_dnjm"))
		r_alljm = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_alljm"))

		'첫 조회시(userconf.ini 파일에 내용이 없을 때)
		If r_grjm = "" Or r_upjm = "" Or r_dnjm = "" Or r_alljm = ""Then
			R1.Checked = True
			GUBN.Data = "1"
			Exit Sub
		End If

		If r_grjm = "-1" Then
			R1.Checked = True
			GUBN.DATA="1"
		ElseIf r_upjm = "-1" Then
			R2.Checked = True
			GUBN.DATA="2"
		ElseIf r_dnjm = "-1" Then
			R3.Checked = True
			GUBN.DATA="3"
		ElseIf r_alljm = "-1" Then
			R4.Checked = True
			GUBN.DATA="4"
		End If
	End If
End Sub

