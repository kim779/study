Sub send_f()
	futureList.Clear
	If SCREEN.Object("parent.parent.gubn").data = "1" Then
		Call mysend(14)
	Else
		Call mysend(1)
	End If
End Sub

_AW_ONSERVICE_AW_
datas = Split(data, Chr(9))
If datas(1) <> "" Then
	If Left(Trim(datas(0)),1) <> "4" Then
		idx = CLng(datas(1))
		If SCREEN.Object("parent.parent.gubn").data = "1" Then
			futureList.Data = Trim(futureList.Data) & "|" & idx & Trim(datas(0))
			mysend(idx+1)
		Else
			idx = idx
			futureList.Data = Trim(futureList.Data) & "|" & "0"&idx & Trim(datas(0))
			mysend(idx+1)
		End If
	End If
End If

