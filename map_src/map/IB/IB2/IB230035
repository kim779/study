Sub data_send()
	Dim jqty, code, name

	If StrComp(SCREEN.Object("main.OBJ_order.OBJ_odr.ed_fcod").data,ed_fcod.Data,1) <> 0 Then

		name = SCREEN.GetName (130, ed_fcod.Data, 0)

