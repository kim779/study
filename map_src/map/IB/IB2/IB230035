			jprc = VIEWGRID.GetGridCell(ii, c_jprc)			'주문가격(or 정정가격)
			jmsu = VIEWGRID.GetGridCell(ii, c_jqty)			'주문수량
			jmnu = VIEWGRID.GetGridCell(ii, c_jmno)			'주문번호
			jmna = VIEWGRID.GetGridCell(ii, c_hnam)			'종목명


			s_data = "#" & s_data
			s_data = ii & "|" & s_data					'ii			16
			s_data = "X" & "|" & s_data					'처리구분	15
			s_data = "2" & "|" & s_data					'모두구분	14
			s_data = "0" & "|" & s_data					'주문조건	13
			s_data = "99" & "|" & s_data				'호가구분	12
			s_data = jprc & "|" & s_data				'주문가격	11
			s_data = mcsu & "|" & s_data				'주문수량(정정, 취소수량)	10
			s_data = jmna & "|" & s_data				'종목명		9
			s_data = code & "|" & s_data				'종목코드	8
			s_data = jmnu & "|" & s_data				'주문번호	7
			s_data = pswd2 & "|" & s_data				'비밀번호	6
			s_data = ACCN2 & "|" & s_data				'계좌번호	5
			s_data = "4" & "|" & s_data					'매매구분	4
			s_data = mkgb2 & "|" & s_data				'시장구분	3
			s_data = "2" & "|" & s_data					'주문유형	2
			s_data = "1" & "|" & s_data					'CUD		1
		End If
	End If
Next

If cnt > 0 Then
	SYSTEM.Push "num", cnt
	SCREEN.CreateWindow 2, "IB310104 /p5 /d", "s_data" & vbTab & s_data
	clear_check()
End If
