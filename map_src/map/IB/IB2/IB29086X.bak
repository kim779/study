	COLINFO("340")  LEN(12)  WIDTH(80)  HEAD("매수금액")  COLALIGN(AL_CENTER, AL_RIGHT)  HEADCOLOR(3, 232)  IO_NUM|FA_COMMA|FA_RIGHT    COLOR(68, 69)  COLCUR(0, 0)  COLHINTTYPE(IH_NONE)    &
	COLINFO("343")  LEN(12)  WIDTH(80)  HEAD("순매수수량")  COLALIGN(AL_CENTER, AL_RIGHT)  HEADCOLOR(3, 232)  IO_NUM|FA_COMMA|FA_RIGHT|FA_CORGB|SA_COSIGN    COLOR(77, 69)  COLCUR(0, 0)  COLHINTTYPE(IH_NONE)    COLUMN_VISIBLE  IFRGB(94, 95)  &
	COLINFO("344")  LEN(12)  WIDTH(80)  HEAD("순매수금액")  COLALIGN(AL_CENTER, AL_RIGHT)  HEADCOLOR(3, 232)  IO_NUM|FA_COMMA|FA_RIGHT|FA_CORGB|SA_COSIGN    COLOR(77, 69)  COLCUR(0, 0)  COLHINTTYPE(IH_NONE)    IFRGB(94, 95)  IOORDER(173)  ENABLE
BOX  BOX3(41, 0, 42, 135)    COLOR(75, 75)  LINEW(1)  BX_LINE    ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
EDIT  mkcd(15, 15, 35, 35)  LEN(1)  IO_NUM|EDIT_INPUT|FA_WRAP    COLOR(192, 232)  CUR(0)  TP_NONE  INIT("2")          TABORDER(2)  IOORDER(2)  ENABLE  &
  HINTTYPE(IH_NONE)
PANEL  PANEL2(188, 236, 358, 256)  '시장구분 1:KRX 2:NXT 3:통합'  LINECOLOR(238)      COLOR(200, 232)  CUR(0)    AL_CENTER    ENABLE  &
  HINTTYPE(IH_NONE)
}



RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub sendobj()
	Dim i
	vagb.Data = 1 '수량

	' ALL Init
	For i = 1 To 24
		SCREEN.Object("v"&i).visible = False
	Next

	Select Case Left(Trim(SCREEN.Object("parent.LABEL4").data) , 1)
	Case "콜"	' KP200 옵션
SYSTEM.Trace("IB2908V3 send OPTION")
		For i = 1 To 6
			SCREEN.Object("v"&i).visible = True
		Next

	Case "미"	' KP200 미니 옵션
SYSTEM.Trace("IB2908V3 send MINI")
		For i = 7 To 12
			SCREEN.Object("v"&i).visible = True
		Next

	Case "W"	' KP200 위클리 옵션 (목)
SYSTEM.Trace("IB2908V3 send weekly THU")
		For i = 13 To 18
			SCREEN.Object("v"&i).visible = True
		Next

	Case "M"	' KP200 위클리 옵션 (월)
SYSTEM.Trace("IB2908V3 send weekly MON")
		For i = 19 To 24
			SCREEN.Object("v"&i).visible = True
		Next

	Case Else	' DEFAULT : KP200 옵션
		For i = 1 To 6
			SCREEN.Object("v"&i).visible = True
		Next

	End Select
End Sub

_AW_ONSEND_AW_
Call sendobj()

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
Else
	SYSTEM.Trace "IB29086X  No cxMarket"
End If

_AW_ONENDSUB_AW_
}



