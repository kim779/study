'-----------------------------------------------------------------------
Function GetIniData(Section, Default)
	Data = ""
	If SCREEN.CreateObject("Info") Then
		Data = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB201500", Section))
		If Len(Data) = 0 Then
			INFO.PushData LOGIN.Name, "userconf.ini", "IB201500", Section, Default
			Data = Default
		End If
	End If
	GetIniData = Data
End Function
'-----------------------------------------------------------------------
Sub SetIniData(Section, Data)
	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB201500", Section, Data
	End If
End Sub
'-----------------------------------------------------------------------
Sub ChangeGrid()
	SCREEN.Proc "SUBMAP.ch_grid", ""
End Sub


Sub Onstart()
	SCREEN.OnSend = False
	SCREEN.IgnoreChange True

	'종목코드
	UpCd = GetIniData("UPCD", "001")
	S20301.Data = UpCd


	SCREEN.Object("UPJM.20301").DATA = S20301.Data
	UPJM.Send

	SCREEN.Object("JMOBJ.20301").data = S20301.Data
