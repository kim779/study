Sub change_chart(key, nxt)
	'	drChart.DelAllBozoMsg()'
	'	drChart.AddBozoMsg 1, "UD", key


	Dim inputData
	Dim tnkey

	Dim    cod2 	'[15];            종목코드
	Dim    sDate 	'[8];             검색시작일
	Dim    nrec		'[4];             조회건수
	Dim    unit		'[3];             조회단위 1분봉, 3분봉
	Dim    gubn		'[1];             조회구분
					'				  0 : 틱, 1 : 분, 2 : 일
					'				  3 : 주, 4 : 월
	Dim    egbn		'[1];             수정주가 구분
	Dim    smod		'[1];             조회모드
	Dim    nkey		'[23];      Next Key
	Dim    bgbn		'[1];             허봉, 실봉구분
					'				  0: 허봉 1: 실봉
	Dim    dgbn		'[1];             당일 구분
	Dim    temp
	CStr   str
	Select Case key
			Case 0 gubn = "0"
			Case 1 gubn = "1"
			Case 2 gubn = "2"
			Case 3 gubn = "3"
			Case 4 gubn = "4"
			Case 5 gubn = "5"
			Case 6 gubn = "6"
	End Select

	ed_ckdt.Data = SCREEN.Object("main.ed_date").Data
	ed_code.Data = SCREEN.Object("main.1301").Data

	cod2 = ed_code.Data
	sDate = ed_ckdt.Data

	temp = 120
	nrec=Trim(temp)

	If(Len(nrec)=3) Then
	    str = " "
		nrec = str & nrec
	End If
	If(Len(nrec)=2) Then
	    str = "  "
		nrec = str & nrec
	End If
	If(Len(nrec)=1) Then
	    str = "   "
		nrec = str & nrec
	End If

	If(Len(nrec)=0) Then
		nrec = " 120"
		request_count.Data = 120
	End If

	If cb_gb.Data = 0 Then
		p_read_ini()
	End If

	If gubn = "0" Then
		If cb_gb.Data = 1 Then
			gubn = "1"
		ElseIf cb_gb.Data = 2 Then
			gubn = "2"
		ElseIf cb_gb.Data = 3 Then
			gubn = "3"
		ElseIf cb_gb.Data = 4 Then
			gubn = "4"
		ElseIf cb_gb.Data = 5 Then
			gubn = "5"
		ElseIf cb_gb.Data = 6 Then
			gubn = "6"
		End If
	End If

	tnkey = LTrim(drChart.GetNextKey())

	If tnkey = "" Then
		nkey = "                       "
	Else
		If nxt = "1" Then
		nkey = tnkey & "                 "
		Else
			nkey = "                       "
		End If
	End If

	unit = g_gunit
	egbn = "1"
	smod = "1"
	'nkey = "                       "
	bgbn = "1"
	dgbn = "0"

	If gubn = "6" Then
		drChart.DelAllPacketRQ
		drChart.AddPacketRQ "0;보조일자;;;YYYYMMDD;무;"
		drChart.AddPacketRQ "1;자료일자;date;8;YYYYMMDD;무;"
		drChart.AddPacketRQ "1;현재가;curr;9;× 1;무;"
		drChart.AddPacketRQ "1;당일체결;data;12;× 0.01;무;"
	Else
		drChart.DelAllPacketRQ
		drChart.AddPacketRQ "0;보조일자;;;YYYYMMDD;무;"
		drChart.AddPacketRQ "1;자료일자;date;8;YYYYMMDD;무;"
		drChart.AddPacketRQ "1;현재가;curr;9;× 1;무;"
		drChart.AddPacketRQ "1;당일체결;data;12;× 1;무;"
	End If


	SYSTEM.Trace "change_chart unit : " & unit & " g_unit : " & g_gunit
	'drChart.SetSubMsg "UM", "E"
	inputData = cod2 & sDate & nrec & gubn & nkey & smod & bgbn

	szTR = "pibg2724"

	drChart.SendTr szTR, cod2, inputData,1

End Sub


'----------------------------------------------------------
Sub SendData(Data)
	ArrData = Split(Data, "|")
	If UBound(ArrData) < 1 Then
		Exit Sub
	End If
	If ArrData(0) = "1" Then
		ed_cttp.Data = ArrData(1)
	Else
		'ArrData - 0:Type, 1:종목코드, 2:차트타입, 3:연속일자
		ed_code.Data = ArrData(1)
		ed_cttp.Data = ArrData(2)
		ed_ckdt.Data = ArrData(3)
		If Len(Trim(ed_ckdt.Data)) = 0 Then
			Exit Sub
		End If
	End If
	SCREEN.Send 0
End Sub
'----------------------------------------------------------
Sub SetInit()
	AYear = Year(Date)
	AMon = Month(Date)
	If Len(AMon) = 1 Then
		AMon = "0" & AMon
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If

	ed_date.Data = AYear & AMon & ADay
End Sub

Sub p_write_ini()
	Dim combo_no
	If RADIO0.Checked = True Then
		combo_no = 1
	ElseIf RADIO1.Checked = True Then
		combo_no = 2
	ElseIf RADIO2.Checked = True Then
		combo_no = 3
	ElseIf RADIO3.Checked = True Then
		combo_no = 4
	ElseIf RADIO4.Checked = True Then
		combo_no = 5
	ElseIf RADIO5.Checked = True Then
		combo_no = 6
	End If

	If SCREEN.CreateObject("INFO") Then
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "combo", combo_no
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim combo_no
		combo_no = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "combo"))
	End If

	If combo_no = "1" Then
		Set_combo(1)
	ElseIf combo_no = "2" Then
		Set_combo(2)
	ElseIf combo_no = "3" Then
		Set_combo(3)
	ElseIf combo_no = "4" Then
		Set_combo(4)
	ElseIf combo_no = "5" Then
		Set_combo(5)
	ElseIf combo_no = "6" Then
		Set_combo(6)
	Else
		Set_combo(1)
	End If

End Sub

