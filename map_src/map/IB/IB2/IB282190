	Array("종가", "5", "05"), Array("전일대비", "6", "06"), Array("등락률", "7", "07"))

'-----------------------------------------------------------------------
Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim ArrCols, i
		ArrCols = Array("", "", "", "")

		For i = LBound(ArrCols) To UBound(ArrCols)
			Dim tmpCol
			tmpCol = "col" & Trim(i + 2)

			INFO.PushData LOGIN.Name, "userconf.ini", "IB282190", tmpCol, GRID0.GetHead(i + 3)
		Next
	End If
End Sub
'-----------------------------------------------------------------------
Sub p_read_ini()
	Dim ArrCols, i, HeadData
	If SCREEN.CreateObject("INFO") = True Then
		ArrCols = Array("", "", "", "")

		Dim tmp
		tmp = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB282190", "col2"))

		If tmp = "" Or IsNumeric(tmp) = True Then		'isnumeric체크이유는 이전에 숫자로 저장했기때문. 2010.03.19
			For i = LBound(ArrCols) To UBound(ArrCols)
				ArrCols(i) = g_arrData(i)(0)
			Next
		Else
			For i = LBound(ArrCols) To UBound(ArrCols)
				Dim tmpCol
				tmpCol = "col" & Trim(i + 2)

				ArrCols(i) = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB282190", tmpCol))
			Next
		End If

		For i = LBound(ArrCols) To UBound(ArrCols)
			GRID0.SetHead i + 3, ArrCols(i)
		Next
	End If
End Sub
'-----------------------------------------------------------------------
Sub progMm(cvol)
	Dim ii, tmpCvol
	tmpCvol = cvol

	For ii = 3 To GRID0.Columns
		If GRID0.GetHead(ii) = "프로그램" Then
			If CDbl(cvol) > 0 Then
				tmpCvol = "+" & cvol
			End If

			GRID0.SetGridCell 1, ii, tmpCvol
		End If
	Next
End Sub
'-----------------------------------------------------------------------
Sub SetItems()
	Dim i, j, HeadData, PrcFlag, PrgFlag
	PrcFlag = 0
	PrgFlag = 0

	For i = 3 To 6
		HeadData = GRID0.GetHead(i)

		If HeadData = "종가" Then
			PrcFlag = 1
		ElseIf HeadData = "프로그램" Then
			PrgFlag = 1
		ElseIf HeadData = "등락률" Then
			PrcFlag = 1
		End If

		For j = LBound(g_ArrData) To UBound(g_ArrData)
			If HeadData = g_ArrData(j)(0) Then
				g_ArrItems(i - 3).Data = g_ArrData(j)(1)
				Exit For
			End If
		Next
	Next

	OBJ1.Proc "SetFlag", PrcFlag
	obj_mm.Proc "SetFlag", PrgFlag
End Sub
'-----------------------------------------------------------------------
Function NullCheck(Data)
	If Trim(data) = "" Then
		Null_check = 0
		Exit Function
	End If
	Null_check  = CLng(Data)
End Function
'-----------------------------------------------------------------------
Sub ProcSetData(Data)
	Dim ArrData, CurPrc, Rate, i, Head

	ArrData = Split(Data, "|")
	CurPrc = ArrData(1)
	Rate = ArrData(2)

	For i = 3 To 6
		Head = GRID0.GetHead(i)
		If Head = "종가" Then
			Dim tmpCurPrc
			tmpCurPrc = CDbl(Trim(CurPrc))

'			SYSTEM.Trace "tmpCurPrc = " & tmpCurPrc

			If tmpCurPrc < 0 Then
				GRID0.SetGridCell 1, i, Abs(tmpCurPrc)
				GRID0.SetTRgb 1, i, 95
			ElseIf tmpCurPrc > 0 Then
				GRID0.SetGridCell 1, i, tmpCurPrc
				GRID0.SetTRgb 1, i, 94
			Else
				GRID0.SetGridCell 1, i, tmpCurPrc
				GRID0.SetTRgb 1, i, 69
			End If


		ElseIf Head = "등락률" Then
			GRID0.SetGridCell 1, i, Rate
		End If
	Next
End Sub
'-----------------------------------------------------------------------
'종가일경우 마이너스 기호를 없애야 함.
Sub jggaRemoveGiho()
	Dim ii, jj

	For jj = 3 To GRID0.Columns
		If GRID0.GetHead(jj) = "종가" Then
				For ii = 1 To GRID0.Rows
					Dim tmpJgga
					tmpJgga = Trim(GRID0.GetGridCell(ii, jj))

					If tmpJgga <> "" Then
						tmpJgga = CDbl(tmpJgga)

						If tmpJgga < 0 Then
							GRID0.SetGridCell ii, jj, Abs(GRID0.GetGridCell(ii, jj))
							GRID0.SetTRgb ii, jj, 95
						End If
					End If
				Next
		End If
	Next
End Sub

