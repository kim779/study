	If Trim(S1301.Data) <> "" And Len(Trim(S1301.Data)) = 6 Then
		If SCREEN.GetCodeType(S1301.Data) = "6" Then
			S1301.Data = Trim(S1301.Data)
			S1301.Trigger "", False
			S1301.Trigger "", True
			SCREEN.Object("obj0.131301").Data = Trim(S1301.Data)
			SCREEN.Object("obj0.131500").Clear
			SCREEN.Send 2
		Else
			SCREEN.ClearAll 2, 2
			SCREEN.Object("obj0.131301").Clear
			SCREEN.Object("obj0.131500").Clear
			SCREEN.Send 2
		End If
	End If

	S1301.SetFocus
End Sub

