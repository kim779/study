RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim start_f
start_f = 0

Sub send_f()
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
End Sub

Sub SetTradList()
	Dim TRADNm, pos
	pos = 1
	TRAD.Index = pos
	TRADNm = ""

'	SYSTEM.Trace "trad.Data = " & TRAD.Data
'	SYSTEM.Trace "tradnm = " & TRADnm

	While Trim(TRAD.Text) <> Trim(TRADNm)
		TRADNm = Trim(TRAD.Text)
'		SYSTEM.Trace "pos = " & pos
'		SYSTEM.Trace "tradnm2 = " & TRADnM
		GRID0.InsertRow -1
		GRID0.SetGridCell GRID0.Rows, 1, Trim(TRAD.Text)
		pos = pos + 1
		TRAD.Index = pos
	Wend

	GRID0.SetFocus
	GRID0.Index = 0
	TRAD.Index = GRID0.Row
End Sub

Sub Change_MKGubn_Main(sMKGubn)

	SYSTEM.Trace "[IB240500]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	Call SetTradList()

	cxMarket.sCode = Trim(S1301.Data)
	OBJ01.Send
	SCREEN.SetTimer 0.5, False

End Sub

Sub Send_Screen()
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
End Sub

Sub Send_OBJ()
	cxMarket.sCode = Trim(S1301.Data)
	OBJ01.Send
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major


'SYSTEM.Trace "2304 start"
Call SetTradList()
Send_OBJ()
SCREEN.SetTimer 0.5, False
'SYSTEM.Trace "onstart data="&TRAD.Data&" text="&TRAD.Text

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
'SYSTEM.Trace "ontimer data="&TRAD.Data&" text="&TRAD.Text&" domino="&tradcd.Data

If Trim(tradcd.Data) <> "" Then
	TRAD.Data = tradcd.Data

	'TR2014 회원사탭등에서 선택시
	'선택한 회원사로 포커스를 줌
	Dim trNm, ii, grTrNm
	trNm = Trim(TRAD.Text)

	For ii = 1 To GRID0.Rows
		grTrNm = Trim(GRID0.GetGridCell(ii, 1))

		If Trim(trNm) = Trim(grTrNm) Then
			GRID0.Index ii - 1
			Exit For
		End If
	Next
End If

cxMarket.sCode = Trim(S1301.Data)
SCREEN.Proc "obj.send_f", ""

If start_f = 0 Then
	start_f = 1
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(TRAD)
_AW_ONCHANGE_AW_
SCREEN.SetTimer 0.5, False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If
Send_OBJ()

cxMarket.sCode = Trim(S1301.Data)
SCREEN.Proc "obj.send_f", ""
GRID0.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB202201 /t/s/p5/d", "appendCODE" & _
			vbTab & S1301.Data & vbLf & "map" & vbTab & "1" & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
HNAM.data = SCREEN.GetName(100, S1301.data, 0)
S1301.Trigger "",True

Send_OBJ()

If start_f = 1 Then
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Proc "obj.send_f", ""
End If

GRID0.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctl_Category)
_AW_ONCLICK_AW_
Dim codx
codx = ctl_Category.GetPreCode(S1301.Data)

If Trim(codx) = "" Then
	Exit Sub
End If

S1301.Data = codx
S1301.Trigger "",True

Send_OBJ()

cxMarket.sCode = Trim(S1301.Data)
SCREEN.Proc "obj.send_f", ""
GRID0.SetFocus
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim codx
codx = ctl_Category.GetNextCode(S1301.Data)

If Trim(codx) = "" Then
	Exit Sub
End If

S1301.Data = codx
S1301.Trigger "",True

OBJ01.Send
SCREEN.Proc "obj.send_f", ""
GRID0.SetFocus
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
S1301.Data = ctl_Category.GetCurCode
S1301.Trigger "",True

OBJ01.Send
SCREEN.Proc "obj.send_f", ""
GRID0.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
cxMarket.sCode = Trim(S1301.Data)
SCREEN.Proc "obj.send_f", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	TRAD.Index = GRID0.Index + 1
	obj.Send
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

If UCase(TypeName( SCREEN.Object("cbSOrder") )) <> "NOTHING" Then
	If cxMarket.sMarket = "통합" Then
		cbSOrder.Data = "S"
	ElseIf cxMarket.sMarket = "KRX" Then
		cbSOrder.Data = "1"
	ElseIf cxMarket.sMarket = "NXT" Then
		cbSOrder.Data = "N"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


