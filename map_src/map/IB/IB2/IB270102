RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_Flag

g_Flag = True
'-------------------------------------------------------------
Sub SetFlag(Flag)
	If Flag = 1 Then
		g_Flag = True
	Else
		g_Flag = False
	End If
End Sub

Sub SetCOMBOALL()
	Data = ""

	For i = 1 To GRID0.Rows
		TmCd = GRID0.GetGridCell(i, 1)
		Desc = GRID0.GetGridCell(i, 2)
		Data = TmCd & Desc
		If Len(Trim(Data)) = 0 Then
			SCREEN.Proc "Main.SetComboData", "END"
			Exit For
		End If

		If i = 1 Then
			SCREEN.Proc "Main.SetComboData", "START" & "|" & Data
		Else
			SCREEN.Proc "Main.SetComboData", Data
		End If
	Next
End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If Not g_Flag Then
	SCREEN.OnSend = False
	Exit Sub
End If
GRID0.Clear
g_Flag = False

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Data = ""

For i = 1 To GRID0.Rows
	TmCd = GRID0.GetGridCell(i, 1)
	Desc = Trim(GRID0.GetGridCell(i, 2))
	Data = TmCd & Desc
	If Len(Trim(Data)) = 0 Then
		SCREEN.Proc "Main.SetComboData", "END"
		Exit For
	End If
	If i = 1 Then
		SCREEN.Proc "Main.SetComboData", "START" & "|" & Data
	Else
		SCREEN.Proc "Main.SetComboData", Data
	End If
Next

_AW_ONENDSUB_AW_
}



