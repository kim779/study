Sub check_box()
	Dim ii, chk_cnt
	chk_cnt = 0
	For ii = LBound(g_ArrData) To UBound(g_ArrData)
		If SCREEN.Object("CH" & g_ArrData(ii)(1)).Checked = True Then
			chk_cnt = chk_cnt + 1
			SCREEN.Object("tjcd" & chk_cnt).Data = g_ArrData(ii)(1)
		End If
	Next

	For ii = chk_cnt+1 To 4
		SCREEN.Object("tjcd" & ii).Data = "99"
	Next
	For ii = LBound(g_ArrData) To UBound(g_ArrData)
		If chk_cnt > 2 Then
			SCREEN.Object("CH" & g_ArrData(ii)(1)).Enable = SCREEN.Object("CH" & g_ArrData(ii)(1)).Checked
		Else
			SCREEN.Object("CH" & g_ArrData(ii)(1)).Enable = True
		End If
	Next
	SCREEN.Send 0
End Sub

