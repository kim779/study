_AW_ONDECLARE_AW_

Dim g_IsFirst
Dim g_StdCode
Dim g_BefVol
Dim g_BefAmt
Dim g_Today

g_IsFirst = True
g_StdCode = ""
g_BefVol = 0
g_BefAmt = 0
g_Today = GetToday()

Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function

Sub OnAlert()
	Flag = 0
	If S62310.Rows > 1 Then
		Flag = 1
	End If

'	SYSTEM.Trace "IB290099 @ OnAlert TJCD=["&Trim(S62304.Data)&"] MASU["&Trim(S62310.GetGridCell(1,2))&"] MADO["&Trim(S62310.GetGridCell(1,3))&"]"
	If Flag = 1 Then
		ArrData = Array("", "", "", "", "", "", "", "")
		ArrData(0) = Trim(S62302.Data)							'시장
		ArrData(1) = Trim(S62304.Data)							'투자자
		ArrData(2) = Trim(S62303.Data)
		ArrData(3) = Getval(Trim(S62310.GetGridCell(1,1)))		'1:시간 혹은 일자
		ArrData(4) = Getval(Trim(S62310.GetGridCell(1,2)))		'4:순매수량
		ArrData(5) = Getval(Trim(S62310.GetGridCell(1,3)))/100
		ArrData(5) = Round(ArrData(5), 0)
		ArrData(6) = Getval(Trim(S62310.GetGridCell(1,4)))
		ArrData(7) = Getval(Trim(S62310.GetGridCell(1,5)))/100
		ArrData(7) = Round(ArrData(7), 0)

		Data = Join(ArrData, "|")
	'	SYSTEM.Trace Data
		SCREEN.Proc "parent.ProcSetData", Data
	End If
End Sub

Function Getval(Data)
	Getval = Data
	If Len(Data) = 0 Then
		Getval = "0"
	End If
End Function

Sub send_f()
	SCREEN.Send 0
End Sub

