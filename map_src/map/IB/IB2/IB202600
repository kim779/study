	If GRID0.GetGridCell (i, 1) = "1" Then
		items = items & vbTab & GRID0.GetGridCell (i, 2) & Trim(GRID0.GetGridCell (i, 3))
		cnt = cnt +1
	ElseIf GRID0.GetGridCell (i, 1) = "3" Then
		items2 = items2 & vbTab & GRID0.GetGridCell (i, 2) & Trim(GRID0.GetGridCell (i, 3))
		cnt2 = cnt2 +1
	End If
Next
If cnt > 0 Then
	COMBO0.Visible = True
	COMBO0.SetItems(items)
	BUTTON3.Visible = True
Else
	BUTTON3.Enable = False
	COMBO0.Enable = False
End If

If cnt2 > 0 Then
	COMBO1.Visible = True
	COMBO1.SetItems(items2)
	BUTTON0.Visible = True
Else
	BUTTON0.Enable = False
