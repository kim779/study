_AW_SCRIPT_AW_(company)
_AW_ONCLICK_AW_
Dim i, str, buff
str = ""
For i = 1 To S200500.Rows
	buff = Trim(S200500.GetGridCell(i, 2))
	If buff <> "상장폐지" Then
		str = str & Trim(S200500.GetGridCell(i, 4))
		str = str & vbTab
		str = str & Trim(S200500.GetGridCell(i, 6))
		str = str & vbLf
	End If
Next
If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, S200500.Rows
End If

focus.Text = "2"
