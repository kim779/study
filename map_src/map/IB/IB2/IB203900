End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Select Case focus.Text
	Case "1"	r_all.SetFocus()
	Case "2"	r_new.SetFocus()
	Case "3"	r_end.SetFocus()
	Case "4"	r_nam.SetFocus()
	Case "5"	HNAM.SetFocus()
	Case "6"	BUTTON0.SetFocus()
	Case "6"	SJGB.SetFocus()
End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(200500)
_AW_ONDBLCLK_AW_

Dim code, gubn, xdat
If S200500.HitPos = 3 Then
	code = S200500.GetGridCell(S200500.row, 4)
	gubn = S200500.GetGridCell(S200500.row, 2)
	xdat = S200500.GetGridCell(S200500.row, 1)
	gubn = Trim(gubn)
	If Trim(code) <> "" And gubn <> "상장폐지" Then
		S1301.Data = code
		S1301.Trigger "", True
	End If

	If gubn = "상장폐지" Then
		SCREEN.CreateWindow 1, "IB203910 /S /p5/d", "1301"&vbTab&code&vbLf& "12901"&vbTab &xdat&vbLf
	End If

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


