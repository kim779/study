RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB2403T0"
Dim IsStart

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
	 	CHK.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "G_CHCK"))

	 	If CHK.Text = "" Then
	 		CHK.Text = "2"
	 	End If

	 	If CHK.text = "2" Then
			'CHK.text = "2"
			OBJECT0.SetObject "IB2403T1"
			GRAPH.Text = "차 트"
		Else
			'CHK.text = "1"
			OBJECT0.SetObject "IB2403T2"
			GRAPH.Text = "데이터"
		End If

		OBJECT0.Send
	End If
End Sub


Sub p_write_ini()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "G_CHCK", CHK.text
End If
End Sub

Sub MKTriggerFromMain(sdata)
	cxMarket.sMarket = sdata
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB999901

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
p_read_ini()
IsStart = 0
cxMarket.sMarket = LoadMKGubn
cxMarket.MNum = "IB100000"

S1301.SetFocus
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SetMKGubn777()
SYSTEM.Trace "[MKGUBN][IB2403T0][OnSend][poop] 1777 = " & S1777.Data
If S1301.Data = "000000" Or Trim(S1301.Data) = "" Or S1301.Data = "      " Then
	SCREEN.OnSend = False
Else
	OBJECT0.Send
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If IsStart = 0 Then
	S1301.SetFocus
	IsStart = 1
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Start.Data = "1" Then
	S1301.Trigger "", True
	cxMarket.sCode = S1301.Data
	S1301.SetFocus
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRAPH)
_AW_ONCLICK_AW_
If CHK.text = "1" Then
	CHK.text = "2"
	OBJECT0.SetObject "IB2403T1"
	GRAPH.Text = "차 트"
Else
	CHK.text = "1"
	OBJECT0.SetObject "IB2403T2"
	GRAPH.Text = "데이터"
End If

OBJECT0.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_date)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctl_Category)
_AW_ONCLICK_AW_
Dim codx
codx = ctl_Category.GetPreCode(S1301.Data)
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim codx
codx = ctl_Category.GetNextCode(S1301.Data)
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
S1301.Data = ctl_Category.GetCurCode
S1301.Trigger "",True

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB202201 /t/s/p5/d", "appendCODE" & _
			vbTab & S1301.Data & vbLf & "map" & vbTab & "1" & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If S1301.Data = "000000" Or Trim(S1301.Data) = "" Then
	S1301.Clear
	S1301.SetFocus
	Exit Sub
End If

If Start.Data = "1" Then
	S1301.Trigger "", True
	cxMarket.sCode = S1301.Data
	S1301.SetFocus
	SCREEN.Send 0
Else
	SCREEN.SetTimer 2, False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SaveMKGubn(cxMarket.sMarket)
SYSTEM.Trigger "edMarketTrigger_1000", cxMarket.sMarket, ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
cxMarket.sMarket = edMarketTrigger.Data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


