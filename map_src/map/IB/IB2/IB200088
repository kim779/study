_AW_SCRIPT_AW_(VIEWGRID)
_AW_ONCLICK_AW_
If VIEWGRID.HitPos <> 3 Then
	Exit Sub
End If

' 컬럼 영역에 따른 ACTION 정의
Select Case VIEWGRID.Column
Case 1 ' 체크박스
	Dim gcnt
	gcnt = 0

	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell(ii, 1)) = 1 Then
			gcnt = gcnt + 1
		End If
	Next

	If gcnt > 9 Then
		MsgBox "일괄 주문은 최대 9건 까지만 가능합니다"
		Call VIEWGRID.SetGridCell(VIEWGRID.Row, 1, "0")
	End If

	If chkcnt() = False Then
		BUTTON0.Enable = False
		BUTTON2.Enable = False
	Else
		BUTTON0.Enable = True
		BUTTON2.Enable = True
	End If

Case Else
	Dim codx
	codx = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 7))	  	'종목코드

	If SCREEN.GetCodeType(codx) = "7" Then
		MsgBox "[6801]신주인수권주문 화면을 이용해 주십시오.",, "IBK투자증권"
		Exit Sub
	End If

	If Len(Trim(codx)) <> 6 Then
		If SCREEN.GetCodeType(codx) <> 9 Then
			Exit Sub
		End If
	End If

	Dim jqty, jprc, ogno, otype, jmgb, mkgb, stov
	jqty = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 20)) 	'주문수량
	jprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 15)) 	'주문가격
	ogno = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 4)) 		'주문번호
	otype =  Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 11))	'주문구분
	jmgb = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 9)) 		'주문구분
	mkgb = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 6))
	stov = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 22))

	If codx = "" Then		'-- 코드, 수량, 주문번호 없으면 처리안함
		Exit Sub
	End If

	' 시장구분자 변경
	Call Spread_mkgb(codx, mkgb)



	If jprc = "" Then
		jprc = "0"
	End If

	SYSTEM.Push "S_ogno", ogno
	SYSTEM.Push "S_jprc", jprc
	SYSTEM.Push "S_code", codx
	SYSTEM.Push "S_click", "YES"

	SCREEN.SetTimerX 77, 5, False	' 종목코드 연동
End Select
