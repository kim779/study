_AW_ONDECLARE_AW_
'환경설정파일에 저장.
Sub c_write_ini()
	Dim view_kind

	If BUTTON4.Text = "차트" Then
		view_kind = "D"
	ElseIf BUTTON4.Text = "데이터" Then
		view_kind = "C"
	End If

	If SCREEN.CreateObject("INFO") Then
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "view_kind", view_kind
	End If

End Sub

'환경설정파일 읽음.
Sub c_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim view_kind
		view_kind = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "view_kind"))
	End If

	If view_kind = "D" Then
		OBJ.SetObject "IB241210"
		BUTTON4.Text = "차트"
	Else
		OBJ.SetObject "IB241220"
		BUTTON4.Text = "데이터"
	End If

	cxMarket.sCode = Trim(S1301.Data)
	If OBJ.GetObject = "IB241220" Then
		OBJ.Send
		OBJ.Proc "CallProc", ""
	Else
		OBJ.Send
	End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	'SCREEN.Send 0
	cxMarket.sCode = Trim(S1301.Data)
	If OBJ.GetObject = "IB241220" Then
		OBJ.Send
		OBJ.Proc "CallProc", ""
	Else
		OBJ.Send
	End If

End Sub

Sub Send_Obj()
	cxMarket.sCode = Trim(S1301.Data)
	If OBJ.GetObject = "IB241220" Then
		OBJ.Send
		OBJ.Proc "CallProc", ""
	Else
		OBJ.Send
