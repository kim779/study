_AW_ONDECLARE_AW_
Public start
start = 1

Const file = "newsinfo.ini"

Function ReadConf()
	If SCREEN.CreateObject("Info") Then
	 	ReadConf = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "ITEMS"))
	Else
		ReadConf = ""
	End If
End Function

Function ReadVersion()
	If SCREEN.CreateObject("Info") Then
	 	ReadVersion = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "VERSION"))
	Else
		ReadVersion = ""
	End If
End Function

Sub Onalert()
	Dim	v_gubn
	Dim	v_name
	Dim strKeys
	Dim v_subgubn
	Dim c_list , f, c_yn

	If Trim(GRID5.GetGridCell(1,4)) = "" Then
		GRID5.Clear()
		Exit Sub
	End If

	c_yn = "N"

	If Trim(GRID5.GetGridCell(1,12)) <> "" Then
		c_list = Split(Trim(GRID5.GetGridCell(1,12)) , "A", -1, 1)
		For Each f in c_list
			If Len(f) <> 0 And Trim(cod2.data) = f Then
				c_yn = "Y"
				Exit For
			End If
		Next
	End If

	If Trim(GRID5.GetGridCell(1,4)) <> Trim(cod2.data) And c_yn = "N" Then
		GRID5.Clear()
		Exit Sub
	End If

	If Trim(GRID5.GetGridCell(1,8)) = "" Then
		Exit Sub
	End If

	If IsNumeric(GRID5.GetGridCell(1,8)) = False Then
		Exit Sub
	End If

	v_gubn = CLng(GRID5.GetGridCell(1,8))

	If v_gubn < 1 Or v_gubn > 20 Then
		Exit Sub
	End If

	Select Case v_gubn
	Case 1
		If GUBN1.Checked = False Then
			Exit Sub
		End If
		v_name = "시황"
	Case 2
		If GUBN2.Checked = False Then
			Exit Sub
		End If
		v_name = "공시"

		v_subgubn = GRID5.GetGridCell(1,9)

		If v_subgubn = 99 Then
			v_name = "코스닥공시"
		ElseIf v_subgubn = 88 Then
			v_name = "프리보드공시"
		Else
			v_name = "거래소공시"
		End If
	Case 3
		If GUBN3.Checked = False Then
			Exit Sub
		End If
		v_name = "이투데이"
	Case 4
		If GUBN4.Checked = False Then
			Exit Sub
		End If
		v_name = "시황속보"
	Case 5
		If GUBN5.Checked = False Then
			Exit Sub
		End If
		v_name = "전자신문"
	Case 6
		If GUBN6.Checked = False Then
			Exit Sub
		End If
		v_name = "이데일리"
	Case 7
		If GUBN7.Checked = False Then
			Exit Sub
		End If
		v_name = "월드인덱스"
	Case 8
		If GUBN8.Checked = False Then
			Exit Sub
		End If
		v_name = "연합뉴스"
	Case 9
		If GUBN9.Checked = False Then
			Exit Sub
		End If
		v_name = "머니투데이"
	Case 10
		If GUBN10.Checked = False Then
			Exit Sub
		End If
		v_name = "한경뉴스"
	Case 11
		If GUBN11.Checked = False Then
			Exit Sub
		End If
		v_name = "매경뉴스"
	Case 12
		If GUBN12.Checked = False Then
			Exit Sub
		End If
		v_name = "아시아경제"
	Case 13
		If GUBN13.Checked = False Then
			Exit Sub
		End If
		v_name = "헤럴드경제"
	Case 14
		If GUBN14.Checked = False Then
			Exit Sub
		End If
		v_name = "촉n토크"
	Case 15
		If GUBN15.Checked = False Then
			Exit Sub
		End If
		v_name = "IR GO"
	Case 16
		If GUBN16.Checked = False Then
			Exit Sub
		End If
		v_name = "컨슈머타임스"
	Case 17
		If GUBN17.Checked = False Then
			Exit Sub
		End If
		v_name = "뉴스웨이"
	End Select

	strKeys = editFilter.Data

	If Trim(strKeys) <> "ALL" Then
		If InStr(strKeys,Trim(v_name)) < 1 Then
			Exit Sub
		End If
	End If

	For ii = 1 To GRID5.Rows
		If Trim(GRID5.GetGridCell(ii,4))<>"" Then
			c_yn = "N"
			If Trim(GRID5.GetGridCell(ii,12)) <> "" Then
				c_list = Split(Trim(GRID5.GetGridCell(ii,12)) , "A", -1, 1)
				For Each f in c_list
					If Len(f) <> 0 And Trim(cod2.data) = f Then
						c_yn = "Y"
						Exit For
					End If
				Next
			End If
			If Trim(GRID5.GetGridCell(ii,4)) = Trim(cod2.data) Or c_yn = "Y"Then
			SYSTEM.Trace "2001NewsSet"
				' add GRID row
				GRID0.InsertRow 0

				' set GRID data
				' TIME
				GRID0.SetGridCell 1, 2, GRID5.GetGridCell(ii,6)
				'
				GRID0.SetGridCell 1, 3, v_name
				' TITLE
				GRID0.SetGridCell 1, 4, GRID5.GetGridCell(ii,2)
				' RECN
				GRID0.SetGridCell 1, 5, GRID5.GetGridCell(ii,3)
				' flag
				GRID0.SetGridCell 1, 6, GRID5.GetGridCell(ii,10)
				' keyv
				GRID0.SetGridCell 1, 7, GRID5.GetGridCell(ii,11)
				GRID0.SetGridCell 1, 1, Mid(GRID5.GetGridCell(ii,11), 1, 8)

					'메인 뉴스 버튼 N->Y 변경 '메인에 제목 보내기
				SCREEN.Object("main.newsViewBtn").Visible = True
				SCREEN.Object("main.news_output").Visible = True
				SCREEN.Object("main.BTN_MD").Visible = False
				SCREEN.Object("main.BTN_MS").Visible = False
				SCREEN.Object("main.BTN_W").Visible = False
				SCREEN.Object("main.BTN_CT").Visible = False
				SCREEN.Object("main.BTN_SHA").Visible = False
				SCREEN.Object("main.BTN_NOTI").Visible = False

				SCREEN.Object("main.news_output").Blink True, 66
				SCREEN.Object("main.news_output").Data = " " + GRID5.GetGridCell(1,2)
				SCREEN.Object("main.keyv_temp").Data = GRID5.GetGridCell(1,11)
				SCREEN.Proc "main.change_bg", ""

			End If
		End If
	Next


	GRID5.Clear()
	GRID0.Index = 0
'	If GRID0.Index < 1000 Then
'		GRID0.Index = GRID0.Index + 1
'	End If
End Sub

Sub click_grid()
		Dim	key_value, key_text
		key_value = GRID0.GetGridCell(GRID0.Row, 7)
		If Trim(key_value) <= "" Then
			Exit Sub
		End If
		key_text = GRID0.GetGridCell(GRID0.Row, 4)
		If Trim(key_text) <= "" Then
			Exit Sub
		End If

		key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.
		SCREEN.CreateWindow 4, "IBNEWSXX /S/t/d/p1", "015"& vbTab & key_text & vbLf & _
			"016" & vbTab & key_value & vbLf & "1301" & vbTab & SCREEN.Object("main.1301").Data

'		keyv.text = key_value
'		SCREEN.Object("OBJ1.isrn").data = recn
'		OBJ1.send
End Sub

Dim save
save = ""
Sub Check_edit()
Dim scode
scode = Trim(SCREEN.Object("main.1301").data)
If Trim(scode) = "" Then
	Exit Sub
End If
If StrComp(save, scode, 1) <> 0 Then
	save = scode
	cod2.Data = SCREEN.object("parent.1301").Data
	isrn.Data = ""
End If
End Sub

Sub rd_click()
	Dim ii

	If r2_1.Checked Then	' 전체
		For ii=1 To 20
			If ii = 7 Then	' 월드 인덱스
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	ElseIf r2_2.Checked Then
		For ii=1 To 20		' 공시
			If ii = 2 Then	' 공시
				SCREEN.Object("GUBN"&ii).Checked = True
			Else
				SCREEN.Object("GUBN"&ii).Checked = False
			End If
		Next
	ElseIf r2_3.Checked Then	' 시황
		For ii=1 To 20
			If ii = 2 Or ii = 7 Then	' 공시 & 월드 인덱스 제외
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	Else

	End If
End Sub

