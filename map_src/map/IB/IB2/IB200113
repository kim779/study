		obj0.Visible = True
		GRID0.Visible = False
		obj0.SetRect 0, 22, 304, 218
		GRID0.SetRect 0, 245, 304, 441

		r2_1.Enable = False
		r2_2.Enable = False
		r2_3.Enable = False
	End If
Else
	r2_1.Checked = True
	r2_2.Checked = False
	r2_3.Checked = False
End If

