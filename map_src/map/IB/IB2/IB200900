Function GetToday()
	YY = Year(Date)
	MM = Month(Date)
	If Len(MM) = 1 Then
		MM = "0" & MM
	End If
	DD = Day(Date)
	If Len(DD) = 1 Then
		DD = "0" & DD
	End If
	GetToday = YY & MM & DD
End Function

