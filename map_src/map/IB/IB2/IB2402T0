		Case "888"
			UPCD.Data = r_upgb
			S200901.Data = r_upgb
		Case Else
		   S200901.Data = "001"
		   UPCD.Data = "001"
	End Select

	SCREEN.Send 2
	SCREEN.IgnoreChange False
End If
