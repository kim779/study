RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'ISA 계좌(57)은 입출금 불가 계좌
Function chk_ISA(stracc)
	If SCREEN.GetMapName(1) = "IB810100" Then
		stracc = Mid(stracc,4,2)
		If stracc = "57" Then
			chk_ISA = False
			Exit Function
		Else
			chk_ISA = True
		End If
	Else
		chk_ISA = True
	End If
End Function

Sub DoReceive()
	Dim ii, items, items2, accnCell, accnText, acnm, accnGubn, bchk_ISA
	items = ""
	items2 = ""
	For ii = 1 To GRID0.Rows
		accnCell = Trim(GRID0.GetGridCell(ii, 9))
		accnText = Trim(GRID0.GetGridText(ii, 9))
		acnm     = Trim(GRID0.GetGridCell(ii,10))
		accnGubn = ""

		If Trim(accnCell) = "" Then
			Exit For
		End If

		If (CLng(Left(accnCell, 3)) < 551 Or CLng(Left(accncell, 3)) > 558) And  CLng(Left(accncell, 3)) <> 561 Then	'551~555(은행예수금계좌) 제외 556추가	'160119 557계좌 추가 '190103 561계좌추가

			bchk_ISA = chk_ISA(Trim(GRID0.GetGridCell(ii, 9)))
			If 	bchk_ISA = True Then																											'201006 558계좌 추가(은행예수금계좌, IBK주거래생활금융통장)

				If CLng(Mid(accnCell, 4, 2)) = 55 Or CLng(Mid(accnCell, 4, 2)) = 15  Then '55 신연금계좌, 15 연금ETF

						If Trim(items) = "" Then
							items  = accnCell
						End If

						If Trim(GRID0.GetGridCell(ii, 11)) = "1" And Trim(GRID0.GetGridCell(ii, 12)) = "동일인" Then
							Select Case Mid(Trim(accnCell), 4, 2)
								'Case "10" : accnGubn = "위탁    "
								'Case "11" : accnGubn = "ELW전용 "
								'Case "12" : accnGubn = "코넥스  "
								Case "15" : accnGubn = "연금    "
								'Case "20" : accnGubn = "선물옵션"
								'Case "21" : accnGubn = "옵션전용"
								'Case "30" : accnGubn = "일반저축"
								'Case "51" : accnGubn = "CMA전용 "
								'Case "52" : accnGubn = "RP전용  "
								'Case "53" : accnGubn = "수익증권"
								Case "55" : accnGubn = "연금    "
								'Case "70" : accnGUbn = "신탁    "
								'Case "37" : accnGUbn = "ISA     "
								'Case Else : accnGubn = "        "
							End Select
'SYSTEM.Trace "!!!!!!!!!!!!!!!!!!!!!    " & Mid(Trim(accnCell), 4, 2) & "   " & accnGUbn
							If SCREEN.Object("main.UTAB0").ID = "3" Then '은행->증권탭은 은행계설계좌만 보여줌
								If Left(accnText, 1) = "5" Then
									If Left(accnText, 3) <> "571" And  Left(accnText, 3) <> "521" Then
										If Mid(accnText, 5, 2) <> "00" And Len(accnCell) = 11 And Mid(accnText, 5, 2) <> "12" Then '코넥스 제외
											items =  items  & vbTab & accnCell & accnText & "   " & accnGubn & "   " & acnm
											items2 = items2 & vbTab & acnm

			'								SYSTEM.Trace "55555 " & items
										End If
									End If
								End If
							Else
								If Left(accnText, 3) <> "571" Then
									If Mid(accnText, 5, 2) <> "00" And Len(accnCell) = 11 Then
										items  = items  & vbTab & accnCell & accnText & "   " & accnGubn & "   " & acnm
										items2 = items2 & vbTab & acnm

			'							SYSTEM.Trace "items " & items
									End If
								End If
							End If
						End If
				End If 'chk_isa
			End If
		End If
	Next



	SYSTEM.Push "IB810101_AccList", items
	SYSTEM.Push "IB810101_AccNameList", items2

	SCREEN.Object("main.OBJ1.CMB_ACCT").SetItems(items)
	SCREEN.Object("main.OBJ1.CMB_ACNM").SetItems(items2)
	'SCREEN.Object("main.OBJPOP.CMB_ACCT").SetItems(items) 팝업띄우기

	SCREEN.Proc "main.OBJ1.acct_set", ""  '--계좌번호, 계좌명 세팅
	'SCREEN.Proc "parent.OBJPOP.inputdata", "" 팝업띄우기

	If SCREEN.Object("main.UTAB0").ID <> "4" Then
		SCREEN.Object("main.OBJ1.zPwd").Setfocus
	End If
End Sub

_AW_ONSEND_AW_
LEDGER.Rcnt = "0025"
zElecfnUserId.Data = LEDGER.Usid

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(LEDGER.Next) = "Y" Then
	send_c()
Else
	GRID0.Sort 9, True, True
	Call DoReceive()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(Out)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



