RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn

	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major


UPGB.SetItems "0"&"0"&vbTab&"0" & " KOSPI" _
		 & vbTab &"1" & " KOSDAQ"
SCREEN.Send 0

Search_b.SetFocus

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Select Case focus.Text
	Case "1"	UPGB.SetFocus()
	Case "2"	IN_DATE.SetFocus()
	Case "3"	Search_b.SetFocus()
End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID)
_AW_ONCLICK_AW_
Select Case (GRID.HITPOS)
Case 2,6
	If (NEXT_GB2.Data <> "1") Then
		Exit Sub
	End If
	NEXT_GB1.Data = "1"
	GRID.SetDataPosition 2
	SCREEN.Send 0
Case 3
	S1301.Data = GRID.GetGridCell(GRID.Index +1, 2)

	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "1301", True
   SYSTEM.SetHistory "1301", S1301.DATA
End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UPGB)
_AW_ONCHANGE_AW_
focus.Text = "1"
NEXT_GB1.Data = "1"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(IN_DATE)
_AW_ONCHANGE_AW_
focus.Text = "2"
NEXT_GB1.Data = "1"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(Search_b)
_AW_ONCLICK_AW_
focus.Text = "3"
NEXT_GB1.Data = "1"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(NXTB)
_AW_ONCLICK_AW_
If (NEXT_GB2.Data = "1") Then
	NEXT_GB1.Data = "0"
	GRID.SetDataPosition 2
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



