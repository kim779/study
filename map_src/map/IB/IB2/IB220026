RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB220026"

Sub p_read_ini()
If SCREEN.CreateObject("Info") Then
 	CHK.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "G_CHCK"))

End If
End Sub


Sub p_write_ini()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "G_CHCK", CHK.text
End If
End Sub

_AW_ONSTART_AW_
Dim hhmm

p_read_ini()

If CHK.text = "1" Then
'	CHK.text = "2"
	b_chat.TEXT = "데이터"
	obj.SetObject("IB22002B")						'CHAT
Else
'	CHK.text = "1"
	b_chat.TEXT = "차 트"
	obj.SetObject("IB22002A")						'TEXT
End If

jgga.Data = "0"

obj.Send

hhmm = Hour(Now)*100 + Minute(Now)
If hhmm < 700 Or hhmm > 1501 Then
	Exit Sub
End If

SCREEN.SetTimer 100, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Dim hhmm

obj.Send

hhmm = Hour(Now)*100 + Minute(Now)
If hhmm < 900 Or hhmm > 1501 Then
	Exit Sub
End If

SCREEN.SetTimer 100, False

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(c_diff)
_AW_ONCLICK_AW_
If c_diff.Checked = True Then
	dfgb.Data = "1"
Else
	dfgb.Data = "0"
End If
'SCREEN.Object("obj.focus").text = "4"
obj.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_chat)
_AW_ONCLICK_AW_
SCREEN.Object("obj.focus").text = "2"
If CHK.text = "2" Then  '차트
	CHK.text = "1"
	'c_diff.Enable = False
	b_chat.TEXT = "데이터"
	If RADIO0.Checked = True Then
		obj.SetObject("IB22002B")
	Else
		obj.SetObject("IB22002T")
	End If
Else
	CHK.text = "2"
	'c_diff.Enable = True
	b_chat.TEXT = "차 트"

	If RADIO0.Checked = True Then
		obj.SetObject("IB22002A")
	Else
		obj.SetObject("IB22002S")
	End If
End If

c_diff.Enable = True

obj.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SBTN)
_AW_ONCLICK_AW_
SCREEN.Object("obj.focus").text = "3"
obj.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHECK0)
_AW_ONCLICK_AW_
If CHECK0.Checked = True Then
	jgga.Data = "1"
Else
	jgga.Data = "0"
End If

SCREEN.Object("obj.focus").text = "4"
obj.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(RADIO0)
_AW_ONCLICK_AW_
upgb.Data = "1"

If b_chat.TEXT = "데이터" Then
	obj.SetObject ("IB22002B")
Else
	obj.SetObject ("IB22002A")
End If
obj.send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(RADIO1)
_AW_ONCLICK_AW_
upgb.Data = "2"


If b_chat.TEXT = "데이터" Then
	obj.SetObject ("IB22002T")
Else
	obj.SetObject ("IB22002S")
End If
obj.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r3)
_AW_ONCLICK_AW_
vggb.Data = "1"
obj.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r4)
