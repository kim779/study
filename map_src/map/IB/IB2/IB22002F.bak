RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim tu_sum, tu_int, t_sum, val

Function Is_numeric(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		Is_numeric = 0
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Is_numeric = 0
		Exit Function
	End If

	Is_numeric = CDbl(num)
End Function

_AW_ONSEND_AW_
vagb.Data = 2

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
Else
	SYSTEM.Trace "IB22002F  No cxMarket"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(SCREEN.Object("parent.comb").Data) = "1" Then
	TABLE10.visible = True
	TABLE11.visible = True
	TABLE12.visible = True
	TABLE13.visible = True
	TABLE14.visible = True
	TABLE15.visible = True

	TABLE17.visible = False
	TABLE18.visible = False
	TABLE19.visible = False
	TABLE20.visible = False
	TABLE21.visible = False
	TABLE22.visible = False
Else
	TABLE10.visible = False
	TABLE11.visible = False
	TABLE12.visible = False
	TABLE13.visible = False
	TABLE14.visible = False
	TABLE15.visible = False

	TABLE17.visible = True
	TABLE18.visible = True
	TABLE19.visible = True
	TABLE20.visible = True
	TABLE21.visible = True
	TABLE22.visible = True
End If

_AW_ONENDSUB_AW_
}



