		INFO.pushData LOGIN.Name, myFILE, myMAP, "SepType", S17415.sDepthInfo
	End If
End Sub

Sub LoadDepthInfo()
	If SCREEN.CreateObject("Info") Then
		S17415.sDepthInfo =	Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "SepType"))
	End If
End Sub

