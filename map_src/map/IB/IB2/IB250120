Sub send_f()
	SCREEN.ClearAll 0, 2

	'부모창의 12901의 날짜데이터가 화면 실행시 늦게 뜨기 때문에
	'플래그를 주었음.
	If startFlag = 1 Then
		SCREEN.SetTimer 2, False
	Else
		SCREEN.Send 0
	End If
End Sub

