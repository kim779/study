{


_AW_ONSTART_AW_
Dim flag

If SCREEN.CreateObject("Info") Then
	flag= Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200053_RDO1"))
End If

Select Case flag
	Case "1"
		xflg.data = "1"
		RADIO1.Checked True
		RADIO0.Checked False
	Case "2"
		xflg.data = "D"
		RADIO1.Checked False
		RADIO0.Checked True
End Select

SCREEN.SetTimer 2, True

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.1301").Data
If Len(Trim(S1301.Data)) <> 6 Then
	SCREEN.OnSend False
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(xbtn2)
_AW_ONCLICK_AW_
