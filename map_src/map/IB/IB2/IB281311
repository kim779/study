RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub sendProc()
	If SCREEN.GetCodeType(Trim(S1301.Data)) = 9 Then
		E1301.Data = S1301.Data
		S1301.Trigger "S1301", True
	Else
		E1301.Clear
		S1301.Clear
	End If

	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load "IB888888"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim gicho

gicho = Trim(S1843.Data)
If gicho = "" Or Trim(S1301.Data) = "" Then
	SCREEN.Object("main.obj.obj1").Send
	Exit Sub
End If

If gicho = "KOSPI200" Then			'기초자산이 K200 일때는 최근월선물
	gicho = ""
ElseIf gicho = "KOSDAQ150" Then			'기초자산이 K200 일때는 최근월선물
	gicho = ""
Else										'기초자산 현물종목
	gicho = Mid(gicho, 4, 6)
	SCREEN.Object("parent.obj1.E1301").data = S1301.Data
End If

SCREEN.IgnoreChange True
SCREEN.Object("parent.obj1.1301").data = gicho
SCREEN.Object("parent.obj1").send

SCREEN.IgnoreChange False

SCREEN.SetTimer 3, False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
S1301.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode (120, "1301", "1022", 0)
If retn <> True Then
	Exit Sub
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
Call sendProc()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


