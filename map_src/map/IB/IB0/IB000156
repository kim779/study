RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)

Sub send_f()
	p_write_ini()
	OBJ.Send
End Sub

Sub p_write_ini()
	Dim msgb, vagb, cagb, ctgb

	If r1_1.Checked Then
		msgb = "1"
	ElseIf r1_2.Checked Then
	 	msgb = "2"
	Else
		msgb = "3"
	End If

	If r2_1.Checked Then
		vagb = "1"
	Else
		vagb = "2"
	End If

	If r3_1.Checked Then
		cagb = "1"
	Else
		cagb = "2"
	End If

	If BUTTON1.Text = "차트" Then
		ctgb = "1"
	Else
		ctgb = "2"
	End If

	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "msgb", msgb
		INFO.pushData LOGIN.Name, myFILE, myMAP, "vagb", vagb
		INFO.pushData LOGIN.Name, myFILE, myMAP, "cagb", cagb
		INFO.pushData LOGIN.Name, myFILE, myMAP, "ctgb", ctgb
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim msgb, vagb, cagb, ctgb, ii
		msgb = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "msgb"))
		vagb = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "vagb"))
		cagb = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "cagb"))
		ctgb = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "ctgb"))

		If msgb = "" Then
			msgb = "3"
		End If

		If vagb = "" Then
			vagb = "1"
		End If

		If cagb = "" Then
			cagb = "1"
		End If

		For ii=1 To 3
			If CLng(msgb) = ii Then
				SCREEN.Object("r1_"&ii).Checked = True
			Else
				SCREEN.Object("r1_"&ii).Checked = False
			End If
		Next

		For ii=1 To 2
			If CLng(vagb) = ii Then
				SCREEN.Object("r2_"&ii).Checked = True
			Else
				SCREEN.Object("r2_"&ii).Checked = False
			End If
		Next

		For ii=1 To 2
			If CLng(cagb) = ii Then
				SCREEN.Object("r3_"&ii).Checked = True
			Else
				SCREEN.Object("r3_"&ii).Checked = False
			End If
		Next

		If ctgb = "1" Then
			BUTTON1.Text = "차트"
			OBJ.SetObject("IB00015E")
		Else
			BUTTON1.Text = "데이터"
			OBJ.SetObject("IB00015F")
		End If
	End If
End Sub


Sub Change_MKGubn_OBJ(sMKGubn)
	cxMarket.sMarket = sMKGubn
	send_f()
End Sub

_AW_ONSTART_AW_
If UCase(TypeName( SCREEN.Object("Main.cxMarket") )) <> "NOTHING" Then
	cxMarket.sMarket = SCREEN.Object("Main.cxMarket").sMarket
End If

p_read_ini()
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim Day1, Day2, mm, dd
Day2 = CDate(edate.text)

Day1 = DateAdd("m", -1, Day2)

If Month(Day1) < 10 Then
	mm = "0" & Month(Day1)
Else
	mm = Month(Day1)
End If

If Day(Day1) < 10 Then
	dd = "0" & Day(Day1)
Else
	dd = Day(Day1)
End If

sdate.data = Year(Day1) & mm & dd
send_f()
SCREEN.OnSend False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(r2_2)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r2_1)
