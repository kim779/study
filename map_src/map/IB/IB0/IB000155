RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim xstr, xvalue, xistrue
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)

Dim g_dayx
g_dayx = Trim(SYSTEM.pop("val_2312"))
If g_dayx <> "" Then
	BEFORE.Data = g_dayx
End If

SYSTEM.Push "val_2312", ""

Sub send_f()
	S1301.Data = SCREEN.Object("main.1301").Data
	SCREEN.Object("OBJ02.CODE_1").data = S1301.Data
	SCREEN.Object("OBJ03.CODE_2").data = S1301.Data
	OBJ02.Send
	OBJ03.Send
End Sub

Sub radio_click()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "RD_CHK", BEFORE.Data
	End If

	If BEFORE.Data = "1" Then
		DATE1.Enable = True
		DATE2.Enable = True
	Else
		DATE1.Enable = False
		DATE2.Enable = False
	End If

	SCREEN.Object("OBJ02.BEFORE").data = BEFORE.Data
	SCREEN.Object("OBJ03.BEFORE").data = BEFORE.Data
	send_f()
End Sub

Sub p_read_ini()
	Dim rd_val
	If SCREEN.CreateObject("Info") Then
		rd_val = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "RD_CHK"))
		If rd_val = "" Then
			rd_val = "1"
		End If
		BEFORE.Data = rd_val
	End If
	Select Case BEFORE.Data
	Case "3"
		r1.Checked = True
	Case "4"
		r2.Checked = True
	Case "5"
		r3.Checked = True
	Case "6"
		r4.Checked = True
	Case "1"
		r5.Checked = True
	End Select
End Sub


Sub Change_MKGubn_OBJ(sMKGubn)
	cxMarket.sMarket = sMKGubn
	send_f()
End Sub

_AW_ONSTART_AW_
If UCase(TypeName( SCREEN.Object("Main.cxMarket") )) <> "NOTHING" Then
	cxMarket.sMarket = SCREEN.Object("Main.cxMarket").sMarket
End If

p_read_ini()

If BEFORE.Data = "1" Then
	DATE1.Enable = True
	DATE2.Enable = True
Else
	DATE1.Enable = False
	DATE2.Enable = False
End If
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.Object("OBJ02.DATE1").data = DATE1.Data
SCREEN.Object("OBJ03.DATE1").data = DATE1.Data
SCREEN.Object("OBJ02.DATE2").data = DATE2.Data
SCREEN.Object("OBJ03.DATE2").data = DATE2.Data

SCREEN.Object("OBJ02.BEFORE").data = BEFORE.Data
SCREEN.Object("OBJ03.BEFORE").data = BEFORE.Data

send_f()
SCREEN.OnSend False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SYMBOL2)
