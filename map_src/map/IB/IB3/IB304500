Sub Set_account()
	g_hnam.Data = HNAM.Data
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN20.Name
	h_acnm.Data = AN20.Name
	zpwd.Data = AN20.Password
	HNAM.Data = g_hnam.Data
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If

	call first_send()
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim msg, ret

	GUIDE.Text = ""
	Error_check = False
	S901.Clear
	VIEWGRID.Clear

	If Trim(AN20.Data) = "" Or Len(Trim(AN20.Data)) < 11 Then
		GUIDE.Text = "계좌번호를 확인하세요"
		Exit Function
	End If

	If Trim(zpwd.Data) = "" Or Len(Trim(zpwd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하세요"
		zpwd.SetFocus
		Exit Function
	End If

	ret = P_pswdConfirm(AN20.data, zpwd.data, msg)
	If ret <> True Then
		zpwd.SetFocus
		GUIDE.Text = msg
		Exit Function
	End If

	Error_check = True
End Function

'***************************************************************************
' DESC: 코드체이지
'************************
Sub code_change()
	Dim name, major, minor

	major = Left(focod.Data,1)
	minor = Mid(focod.Data, 2, 2)

	If Trim(major) = "" Then
		HNAM.Data = ""
		Exit Sub
	ElseIf major = "1" Or major = "4" Or major = "A" Or major = "D" Then
		name = SCREEN.GetName(101, focod.data, 0)'지수선물
	Else
		If minor < 10 Then
			name = SCREEN.GetName(102, focod.data, 0)'지수옵션
		Else
			name = SCREEN.GetName(108, focod.data, 0)'주식옵션
		End If
	End If

	If Trim(name) = "" Then
		HNAM.Data = ""
		focod.Data = ""
		Exit Sub
	End If
	HNAM.Data = name
'	SCREEN.IgnoreChange True
