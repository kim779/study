RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim ii, tmpAA, tmp, strEdits, divEdits
Dim tmpResult

Sub SetParam()
	strEidts = AA.Data + "|" + BB.Data + "|" + CC.Data
	divEdits = Split(strEidts, "|")

	tmpResult = "|" + "|" + "|"
	tmpResult = Split(tmpResult, "|")

	For ii=0 To 2
	 	If InStr(divEdits(ii), ".") = 0 Then		'정수만 입력됐다는 의미

	 		tmp = Split(divEdits(ii)," ")
	 		tmpAA = tmp(0) + ".00"		' 정수만 입력 됐음으로 소숫점 두자리 00으로 처리
	 		AA.Data = tmpAA		'입력 화면에 소숫점 처리해서 다시 보여 줌
	 		tmpResult(ii) = "+" & l_zeropad(AA) 		'앞부분에 0으로 채워 입력 자릿수 맞춤
	 	Else
	 		tmp = Split(divEdits(ii), ".")   '입력에 소숫점 자리수 값이 들어올 경우
	 		editint.Data = tmp(0)		'정수부
	 		editfloat.Data = tmp(1)		'소수부
	 		editint.Data = l_zeropad(editint)	'정수부 빈 자리를 0으로 채워 자릿수 맞춤

	 		If InStr(editfloat.Data, " ") = 2 Then   '입력받은 소숫점 자리수가 1자리 인 경우
	 			editfloattmp.Data = editfloat.Data	'한자리 소숫점 숫자를 한자리짜리 임시 edit에 넣음
	 			tmpResult(ii) = "+" + editint.Data + "." + editfloattmp.Data + "0"
	 		Else		'윗줄 =>"+" +  정수부 + 소숫점 + 입력받은 한자리 소숫점 숫자 + 0(자릿수 채우기)
	 			tmpResult(ii) = "+" + editint.Data + "." + editfloat.Data + "0"
	 		End If	'윗줄 => 입력받은 소숫점 숫자가 두자리 수 인경우
	 	End If
	Next

	dUpRiskRat.Data = tmpResult(0)
	dDownRiskRat.Data = tmpResult(1)
	dRiskRatDiff.Data = tmpResult(2)
End Sub

Sub send_f()
'	Call SetParam()

	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0017"

zBrnNo.Data = LOGIN.Brno
zMgempNo.Data = LOGIN.User

AA.Data = "0.00"
BB.Data = "0.00"
CC.Data = "0.00"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

Dim tmpArr

If Trim(AA.Data) <> "" Then
	If IsNumeric(Trim(AA.Data)) = True Then
		If CDbl(AA.Data) = 0 Then
			AA.Data = "0.00"
		Else
			If InStr(Trim(AA.Data), ".") = 0 Then '소수점이 없을경우
				AA.Data = AA.Data & ".00"
			Else
				tmpArr = Split(AA.Data, ".")

				If Len(Trim(tmpArr(1))) = 1 Then	'소수점 첫째자리까지 있을경우
					AA.Data = AA.Data & "0"
				ElseIf  Len(Trim(tmpArr(1))) > 2 Then
					MsgBox "소수점 둘째자리까지만 입력하세요.",,"IBK투자증권"
					AA.SetFocus
					Exit Sub
				ElseIf Len(Trim(tmpArr(1))) = 0 Then
					MsgBox "상승위험비율을 확인하세요.",,"IBK투자증권"
					AA.SetFocus
					Exit Sub
				End If
			End If
		End If
	End If
Else
