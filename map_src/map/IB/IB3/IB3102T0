'***************************************************************************
' DESC: 종목코드 변경시
'***************************************************************************
Sub code_change()
	Dim name, major, minor

	major = Left(focod.Data,1)
	minor = Mid(focod.Data, 2, 2)
	If Trim(major) = "" Then
		HNAM.Data = ""
		Exit Sub
	ElseIf major = "1" Or major = "4" Or major = "A" Or major = "D" Then
		name = SCREEN.GetName(101, focod.data, 0)'지수선물
	Else
		If minor < 10 Then
			name = SCREEN.GetName(102, focod.data, 0)'지수옵션
		Else
			name = SCREEN.GetName(108, focod.data, 0)'주식옵션
		End If
	End If

	If Trim(name) = "" Then
		HNAM.Data = ""
		focod.Data = ""
		Exit Sub
	End If
	HNAM.Data = name

	If Trim(AN20.Data) = "" Or Trim(zPwd.Data) = "" Then
		Exit Sub
	End If

	Call first_send()
End Sub

