	GUIDE.Text = ""
	ACNM.Data = AN20.name
	zPwd.Data = AN20.Password
	If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy <> "1" Then
		zPwd.Data = "9999"
	End If

	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) <> "" Then
		Call first_send()
	Else
		zPwd.SetFocus
		VIEWGRID.Clear
	End If
End Sub

