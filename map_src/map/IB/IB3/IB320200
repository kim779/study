RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sect
sect = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN20.Name
	h_acnm.Data = AN20.Name
	zpwd.Data = AN20.Password

	If Len(Trim(AN20.Data)) < 11 Then
		AN20.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zpwd.Data)) < 4 Then
			zpwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zpwd)

LEDGER.Rcnt = "0009"

Dim a, yyyymmdd

If Trim(LOGIN.Day0) <> "" And Trim(LOGIN.Day1) <> "" And Trim(LOGIN.Day2) <> "" Then
	yyyymmdd = DateSerial(Left(LOGIN.Day1, 4), Mid(LOGIN.Day1, 5, 2), Mid(LOGIN.Day1, 7, 2))

	a = Weekday(CDate(Trim(yyyymmdd)))

	'오늘이 토요일 이거나 일요일 이면 전영업일로 초기화
	If a = 7 Or a = 1 Then
		zOrdDt.Data = LOGIN.Day0
	End If
End If

If SCREEN.CreateObject("Info") Then
	Dim check, jan, pyungga

	check = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "CHECK"))
	If check <> "" Then
		CHECK1.Checked = check
	End If

	jan = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "zBalEvalTp"))
	zBalEvalTp.Data = jan

	pyungga = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "zFutsPrcEvalTp"))
	zFutsPrcEvalTp.Data = pyungga

End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zpwd.Data) = "" Then
   zpwd.Data = "9999"
End If

If CheckInput(AN20, zpwd) = True Then
	ANCM.Data = h_acnm.Data
	SCREEN.onsend = True

 	'Exit Sub
Else
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
	zpwd.SetFocus
End If
SYSTEM.Trace "3202"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable True
	next_btn.SetFocus
Else
	next_btn.Enable False
	GRID0.SetFocus
End If

If sect = 0 And LEDGER.Next <> "Y" Then
	zpwd.SetFocus
End If

Dim sign, data, amt

For i = 1 To GRID0.Rows

	If Trim(GRID0.GetGridCell (i, 3)) = "2" Then '-- 매수
		GRID0.SetTRgb i, 4, 94
	ElseIf Trim(GRID0.GetGridCell (i, 3)) = "1" Then '-- 매도
		GRID0.SetTRgb i, 4, 95
	Else
		GRID0.SetTRgb i, 4, 69
	End If
	GRID0.SetGridCell i, 4, Trim(GRID0.GetGridCell (i, 4))

	'-- 소수 둘째자리에서 반올림
	data = Trim(GRID0.GetGridCell (i, 10))
	If CDbl(data) > 0 Then
		GRID0.SetGridCell i, 11, "+" & (data + 0.005)
	ElseIf CDbl(Trim(data)) < 0 Then
		GRID0.SetGridCell i, 11, (data - 0.005)
	Else
		GRID0.SetGridCell i, 11, data
	End If

	amt = GRID0.GetGridCell (i, 6)
	GRID0.SetGridCell i, 6, FormatNumber(amt, 2, 0, 0, 0)

Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	ed_focod.DATA = GRID0.GetGridCell(GRID0.INDEX +1, 1)
	If Trim(ed_focod.DATA) = "" Then
	    Exit Sub
	End If

	Dim code
	code = Mid(Trim(ed_focod.Data), 2, 2)

	If Left(Trim(ed_focod.Data), 1) = "1" Or Left(Trim(ed_focod.Data), 1) = "4" Or _
	   Left(Trim(ed_focod.Data), 1) = "A" Or Left(Trim(ed_focod.Data), 1) = "D" Then
		If ("10" <= code And code <= "59")     Or     ("B0" <= code And code <= "ZZ") _ 
			Or ("0A" <= code And code <= "0Z") Or ("1A" <= code And code <= "1Z") _
			Or ("2A" <= code And code <= "2Z") Or ("3A" <= code And code <= "3Z") _
			Or ("4A" <= code And code <= "4Z") Or ("5A" <= code And code <= "5Z") _
			Or ("6A" <= code And code <= "6Z") Or ("7A" <= code And code <= "7Z") _
			Or ("8A" <= code And code <= "8Z") Or ("9A" <= code And code <= "9Z") Then
			ed_focod.Trigger "100301", True
			ed_focod.Trigger "ed_fcod", True
			SYSTEM.SetHistory "100301", ed_focod.Data
			SYSTEM.SetHistory "ed_fcod", ed_focod.Data
		Else
			ed_focod.Trigger "30301", True
			ed_focod.Trigger "ed_focod", True
			SYSTEM.SetHistory "30301", ed_focod.Data
			SYSTEM.SetHistory "ed_focod", ed_focod.Data
		End If
	Else
		ed_focod.Trigger "40301", True
		ed_focod.Trigger "ed_focod", True
		SYSTEM.SetHistory "40301", ed_focod.Data
		SYSTEM.SetHistory "ed_focod", ed_focod.Data
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN20)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zpwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	sect = 0
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


