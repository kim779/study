RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub SaveCfg
	Dim ii, str
	If SCREEN.CreateObject("Info") Then
		str = ""
		For ii=0 To 5
			If SCREEN.Object("CHECK"&CStr(ii)).Checked Then
				str = str&"1"
			Else
				str = str&"0"
			End If
		Next
		INFO.PushData LOGIN.Name, "userconf.ini", "IB315300", "config", str
	End If
End Sub

Sub LoadCfg
	Dim ii, str
	If SCREEN.CreateObject("Info") Then
		str = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB315300", "config"))
		For ii=0 To 5
			'MsgBox CStr(ii)&": "&Mid(Str,ii+1,1)
			If Mid(str, ii+1, 1) = "1" Then
				SCREEN.Object("CHECK"&CStr(ii)).Checked = True
			Else
				SCREEN.Object("CHECK"&CStr(ii)).Checked = False
			End If
		Next
		'INFO.PushData LOGIN.Name, "userconf.ini", "IB315300", "config", str
	End If
End Sub

_AW_ONSTART_AW_
Call LoadCfg()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(B_SEARCH)
_AW_ONCLICK_AW_
Call SaveCfg()
SYSTEM.Push "C3153_CONFIG", "OK"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SYSTEM.Push "C3153_CONFIG", "NO"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



