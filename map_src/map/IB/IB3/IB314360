RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999922) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "2"
jumunGb = "Stop"

'***************************************************************************
' DESC: 사용자 입력키 Action
'***************************************************************************
Sub OnAxUserKey(key)
'	If OrdCfg.EnterOrder = True Then
'		If key = 13 Then
'			SYSTEM.UserKey	= True
'			DoOrder()
'		End If
'	End If
End Sub

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg, prc, curPrice, tmpCode

	init_data()										'주문 기본세팅
	ed_odgb.Data = "00"
	ed_hogb.Data = "03"
	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	If Left(Trim(ed_cfocod.Data), 3) = "186" Then
		MsgBox "STOP주문은 시장가주문이므로 돈육선물은 지원불가합니다", , "IBK투자증권"
		Call QueryOption("after")
		Exit Sub
	Else
		Dim jmNm
		jmNm = SCREEN.GetName(127, Trim(ed_cfocod.Data), 0)

		If jmNm = "" Then
			If Left(Trim(ed_cfocod.Data), 1) = "1" Or Left(Trim(ed_cfocod.Data), 1) = "4" Or _
				Left(Trim(ed_cfocod.Data), 1) = "A" Or Left(Trim(ed_cfocod.Data), 1) = "D" Then
				curPrice =SCREEN.Object("main.OBJ_sise.31023").Text
			ElseIf Left(Trim(ed_cfocod.Data), 1) = "2" Or Left(Trim(ed_cfocod.Data), 1) = "3" Or _
				Left(Trim(ed_cfocod.Data), 1) = "B" Or Left(Trim(ed_cfocod.Data), 1) = "C" Then
				curPrice =SCREEN.Object("main.OBJ_sise.41023").Text
			End If
		Else
			curPrice = SCREEN.Object("main.OBJ_sise.101023").Text
		End If
	End If

	If IsNumeric(curPrice) = False Then
		curPrice = 0
	End If

	curPrice = CDbl(curPrice)

	tmpCode = Left(Trim(ed_cfocod.Data), 3)

	If tmpCode = "185" Or tmpCode = "186" Or tmpCode = "187" Or tmpCode = "485" Or tmpCode = "486" Or tmpCode = "487" Or _
		tmpCode = "A85" Or tmpCode = "A86" Or tmpCode = "A87" Or tmpCode = "D85" Or tmpCode = "D86" Or tmpCode = "D87" Then
		prc = ed_jprc.Data
	Else
		prc = FormatNumber((ed_jprc.Data)/100, 2, -1, 0)
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(c_hogb.Text, 4)		'매매구분
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
