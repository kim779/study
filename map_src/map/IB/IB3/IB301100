RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim chgB,IsDomino
chgB = 0
Sub send_sise_all(gubn)
	Dim code, fogb, rsymb
	dbx.Text = dbx.Text &gubn& ed_focod.data&"ALL:"

	code = Left(ed_focod.Data, 1)
	If code = "1" Or code = "4" Or code = "A" Or code = "D"  Then
		fogb = 101
		rsymb = "30301"
		OBJ_sise.Send
	Else
		fogb = 102
		rsymb = "40301"
		obj_sise2.send
	End If

	HNAM.Data = SCREEN.GetName (fogb, ed_focod.Data, 0)
	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = Trim(HNAM.Data)

	'CX_OptionEx에 바뀐 종목 세팅
	SCREEN.Object("OBJ_order.OBJ_odr.Control0").CurCode  = ed_focod.Data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_focod").data = ed_focod.data
		SCREEN.IgnoreChange False
	End If

'	SYSTEM.Trace "jqty = " & Trim(SCREEN.Object("OBJ_order.OBJ_odr.ed_jqty").Data)
'	SYSTEM.Trace "jprc = " & Trim(SCREEN.Object("OBJ_order.OBJ_odr.ed_jprc").Data)

	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 2, 2
		Exit Sub
	Else
		ed_focod.Trigger "ed_focod", True
		ed_focod.Trigger rsymb, True
		SYSTEM.SetHistory rsymb, ed_focod.Data
		SYSTEM.SetHistory "ed_focod", ed_focod.Data
	End If

	SCREEN.SetTimer 1, False
End Sub

'CX_OptionEx에서 사용
Sub SetOPCode( code, handle)
	Dim hKey

	hKey = SCREEN.Object("OBJ_order.OBJ_odr.Control0").MapHandle

'	SYSTEM.Trace "handle : " & handle & " hKey :" & hKey
	If Trim(handle) <> Trim(hKey) Then
		Exit Sub
	End If
	ed_focod.data = code
	Call send_sise_all("main")
End Sub

_AW_ONINDECLARE_AW_
'== 선물옵션주문obj를포함한 main의 공통함수
#LOAD IB999923

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'Call Set_mini_order(1)
SCREEN.SetTimer 3, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONSELECT_AW_
If chgB <> 0 Or SYSTEM.Pop("accountdata") <> "" Then
	If SYSTEM.Pop("selectdataB") <> "" Then
		data = SYSTEM.Pop("selectdataB")
	End If

	Select Case data
		Case "3011"	'매도
			SCREEN.Object("OBJ_order.tab_order").ID = 1
			SCREEN.SetCaption "IB301100" & "[3011] 매도"
		Case "3012"	'매수
			SCREEN.Object("OBJ_order.tab_order").ID = 2
			SCREEN.SetCaption "IB301100" & "[3012] 매수"
		Case "3013"	'정정
			SCREEN.Object("OBJ_order.tab_order").ID = 3
			SCREEN.SetCaption "IB301100" & "[3013] 정정"
		Case "3014"	'취소
			SCREEN.Object("OBJ_order.tab_order").ID = 4
			SCREEN.SetCaption "IB301100" & "[3014] 취소"
		Case Else
			Exit Sub
	End Select
	IsDomino = "D" & Right(data,1)
	OBJ_order.Proc "order_tab_change", ""
	SYSTEM.Push "selectdataB", ""
	chgB = 0
Else
	SYSTEM.Push "selectdataB", data
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Dim DominoArr
If Trim(catch_domino_data.Data) <> "" Then
	SYSTEM.Push "domino_data", Trim(catch_domino_data.Data)

	DominoArr = Split(Trim(catch_domino_data.Data), "|")

	ed_focod.Data = ""
	SCREEN.Object("obj_order.obj_odr.ed_focod").Data = DominoArr(0)
	SCREEN.Proc "obj_order.obj_odr.ChangeCode", ""

	ed_jprc.Data = DominoArr(2)
	ed_jqty.Data = DominoArr(3)

	SCREEN.Object("OBJ_order.OBJ_odr.ed_jqty").data = Trim(ed_jqty.Data)
	SCREEN.Object("OBJ_order.OBJ_odr.ed_jprc").data = Trim(ed_jprc.Data)

	If Trim(DominoArr(5)) <> "" Then
		SCREEN.Object("OBJ_order.OBJ_odr.c_hogb").Data = Trim(DominoArr(5))
		SCREEN.Proc "OBJ_order.OBJ_odr.Set_comb_hogb", ""
	End If

	catch_domino_data.Data = ""
	SYSTEM.Push "catch_domino_data", ""
ElseIf Trim(ed_jprc.Data) <> "" And Trim(ed_jprc.Data) <> "0" Then
	SCREEN.IgnoreChange  True
	SCREEN.Object("OBJ_order.OBJ_odr.ed_jprc").Data = ed_jprc.Data
	ed_jprc.Data = ""
	SCREEN.IgnoreChange  False
Else
	'주문성공후 커서 위치
	Call Set_mini_domino(Right(IsDomino,1))
	SCREEN.Proc "OBJ_order.OBJ_odr.Set_cursor", ""
End If

