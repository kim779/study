	Case 17
		If GUBN17.Checked = False Then
			Exit Sub
		End If
		v_name = "뉴스웨이"
	End Select

	For ii = 1 To GRID2.Rows
		If Trim(GRID2.GetGridCell(ii,11))<>"" Then
			GRID0.InsertRow 0
			GRID0.SetGridCell 1, 1, Mid(GRID2.GetGridCell(ii,11),1,8)
			GRID0.SetGridCell 1, 2, GRID2.GetGridCell(ii,6)
			GRID0.SetGridCell 1, 3, GRID2.GetGridCell(ii,2)
			GRID0.SetGridCell 1, 10, GRID2.GetGridCell(ii,11)
			GRID0.SetGridCell 1, 4, Trim(GRID2.GetGridCell(ii,7))
			GRID0.SetGridCell 1, 5, Trim(GRID2.GetGridCell(ii,12))
		End If
	Next


	GRID2.Clear()
End Sub


Sub click_grid()
	Dim	key_value, key_text
	key_value = GRID0.GetGridCell(GRID0.Row, 10) 'keyv
	If Trim(key_value) <= "" Then
		Exit Sub
	End If
	key_text = GRID0.GetGridCell(GRID0.Row, 3) '제목

	If Trim(key_text) <= "" Then
		Exit Sub
	End If

	key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.
		SCREEN.CreateWindow 4, "IBNEWSXX /S/d/p1", "015"& vbTab & key_text & vbLf & _
		"016" & vbTab & key_value & vbLf & "1301" & vbTab & GRID0.GetGridCell(GRID0.row, 6)
End Sub

Sub gubn_change(data)
	Dim ii, str, indx
	indx = CLng(Trim(data))
	Select Case indx
		Case 0	' 종합(전체)
			For ii = 1 To 20
				str = "parent.obj1.gubn" & ii
				If ii = 7 Then
					SCREEN.object(str).checked = False
				Else
					SCREEN.object(str).checked = True
				End If
			Next
		Case Else
			For ii = 1 To 20
				str = "parent.obj1.gubn" & ii
				If ii = CLng(indx) Then
					SCREEN.object(str).checked = True
				Else
					SCREEN.object(str).checked = False
				End If
			Next
	End Select
End Sub

