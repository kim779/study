_AW_ONDECLARE_AW_
Sub InitScreen()
	hnam.Data = ""
	ed_jqty.Data = "0"
	msdt.Data = ""
	gsgb.Data = ""
	jcod.Data = ""
	facno.Data = ""
	jacno.Data = ""
	ed_pswd.Data = ""
	zTaxTp.Data = ""
End Sub

Sub DoOrder()
	Dim dmsg

	facno.Data = SCREEN.Object("main.OBJ_ACNT.AN20").Data
	jacno.Data = SCREEN.Object("main.OBJ_ACNT.cmb_acnt").Data
	ed_pswd.Data = SCREEN.Object("main.OBJ_ACNT.ed_pswd").Data
	zBuyDate.Data = msdt.Data

	'주문전 Error Check
	If Error_check() = False Then
		SCREEN.OnSend = False
		Exit Sub
	End If

	dmsg =  "o_facno" & vbTab & facno.Data & vbLf &_
			"o_jacno" & vbTab & jacno.Data & vbLf &_
			"o_jcod" & vbTab & jcod.Data & vbLf &_
			"o_hnam" & vbTab & hnam.Data & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf

	SCREEN.CreateWindow 2, "IB30319A /p5 /d", dmsg

	If SYSTEM.Pop("dy_assign") <> "OK" Then
		Exit Sub
	End If
	SCREEN.Send 0
End Sub

Function Error_check()
	Error_check = False

	If Trim(SCREEN.Object("main.OBJ_ACNT.AN20").Data) = "" Then
		SCREEN.Object("main.OBJ_ACNT.AN20").SetFocus
		MsgBox "선물 계좌번호를 확인하십시오", , "IBK투자증권"
		'Call guide_msg("선물 계좌번호를 확인하십시오")
		Exit Function
	End If

	If Trim(SCREEN.Object("main.OBJ_ACNT.cmb_acnt").Data) = "" Then
		SCREEN.Object("main.OBJ_ACNT.cmb_acnt").SetFocus
		MsgBox "현물 계좌번호를 확인하십시오", , "IBK투자증권"
		'Call guide_msg("선물 계좌번호를 확인하십시오")
		Exit Function
	End If

	If Len(Trim(SCREEN.Object("main.OBJ_ACNT.ed_pswd").Data)) < 4 Then
		SCREEN.Object("main.OBJ_ACNT.ed_pswd").SetFocus
		MsgBox "비밀번호를 확인하십시오", , "IBK투자증권"
		'Call guide_msg("비밀번호를 확인하십시오")
		Exit Function
	End If

	If Trim(jcod.Data) = "" Then
		MsgBox "지정 종목을 지정하십시오", , "IBK투자증권"
		'Call guide_msg("지정 종목을 지정하십시오")
		Exit Function
	End If

	If CLng(Trim(ed_jqty.Data)) <= 0 Then
		ed_jqty.SetFocus
