_AW_ONCLICK_AW_
Select Case GRID1.HitPos
	Case 3
		Dim codb
		codb = Trim(GRID1.GetGridCell(GRID1.Row, 1))



		If Len(codb) >= 6 Then

			S100301.Data = codb
			S100301.Trigger "", True
			S100301.Trigger "", False
			S100301.Trigger "ed_fcod", True

			SYSTEM.SetHistory "100301", S100301.Data
			SYSTEM.SetHistory "ed_fcod", S100301.Data
		End If

End Select
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
'SCREEN.CreateWindow 1, "IB280200 /t /s /p5", ""

Dim code

If GRID1.HitPos = 3 Then
	code = GRID1.GetGridCell(GRID1.row, 1)
'	'SYSTEM.Trace S210500.GetGridCell(S210500.row, 3)
	If Trim(code) <> "" Then
		S100301.Data = code
		S100301.Trigger "", True
	End If
End If

'ONLY DOUBLE CLICK CODE 0805

If Len(Trim(code)) >= 6 Then
