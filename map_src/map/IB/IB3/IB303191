RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_account()
	ACNM.Data = AN20.name
	ed_pswd.Data = AN20.Password
	SCREEN.Object("main.OBJ3.facno").Data = AN20.Data
	SCREEN.Object("main.OBJ3").Send
End Sub

Sub acno_list_done()
	Dim grid, item, acnt, acnt20, txt
	item = ""
	Set grid = SCREEN.Object("main.OBJ3.GRID1")
	For ii=1 To grid.Rows
		acnt = Trim(grid.GetGridCell(ii, 1))
		acnt20 = grid.GetGridCell(ii, 1)
		If acnt = "" Then
			Exit For
		End If
		txt = Mid(acnt,1,3) & "-" & Mid(acnt, 4, 2) & "-" & Mid(acnt, 6)
		item = item & acnt20 & txt & vbTab
		If ii=1 Then
			item = acnt20 & vbTab & item
		End If
	Next

	SCREEN.Object("cmb_acnt").SetItems item

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(ed_pswd.Data)) >= 4 Then
			Call cmb_onchange()
		End If
	Else
		Call cmb_onchange()
	End If
End Sub

Sub cmb_onchange()
	Dim cmbacnt, temp
	cmbacnt = Trim(cmb_acnt.Data)
	temp = SCREEN.Object("main.OBJ2.ed_accn").Data
	If temp <> cmbacnt Then
		SCREEN.Proc "main.OBJ2.send_f", ""
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888888
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim errcd
errcd = LEDGER.Ecod

If CLng(errcd) < 1000 Then

	InitScreen()

	If SCREEN.Object("main.tab_bottom").ID = 1 Then
		SCREEN.Proc "main.OBJ2.send_f", ""
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN20)
_AW_ONCHANGE_AW_
Call Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cmb_acnt)
_AW_ONCHANGE_AW_
Call cmb_onchange()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



