'***************************************************************************
Sub first_send()
	LEDGER.Fkey = "C"
	VIEWGRID.Clear
	chk_first.Data = "1"
	SCREEN.Send 0
End Sub

'***************************************************************************
' DESC: 종목코드 변경시
'***************************************************************************
Sub code_change()
	Dim name, major, minor

	major = Left(focod.Data,1)
	minor = Mid(focod.Data, 2, 2)
	If Trim(major) = "" Then
		HNAM.Data = ""
		Exit Sub
	ElseIf major = "1" Or major = "4" Or major = "A" Or major = "D" Then
		name = SCREEN.GetName(101, focod.data, 0)'지수선물
	Else
		If minor < 10 Then
			name = SCREEN.GetName(102, focod.data, 0)'지수옵션
		Else
			name = SCREEN.GetName(108, focod.data, 0)'주식옵션
		End If
	End If

	If Trim(name) = "" Then
		HNAM.Data = ""
		focod.Data = ""
		Exit Sub
	End If
	HNAM.Data = name

'	If Trim(AN20.Data) = "" Or Trim(zPwd.Data) = "" Then
'		Exit Sub
'	End If

	Call first_send()
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	SCREEN.Object("parent.guide").text = ""
	ACNM.Data = AN20.name
	zPwd.Data = AN20.Password

	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) > 3 Then
			Call first_send()
		Else
			zPwd.SetFocus
			VIEWGRID.Clear
		End If
	End If
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim ret, msg
	GUIDE.Text = ""
	GUIDE.text = ""
	Error_check = False
	S901.Clear
	VIEWGRID.Clear

	If CheckInput(AN20, zPwd) = False Then
		Exit Function
	End If

	ret = P_pswdConfirm(AN20.data, zPwd.data, msg)
	If ret <> True Then
		zPwd.SetFocus
		GUIDE.Text = msg
		Exit Function
	End If

	Error_check = True
End Function

