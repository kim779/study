'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 6)) = "" Then
			Exit Sub
		End If
		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
End Sub

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 5)) = "" Then
			Exit Sub
		End If
		VIEWGRID.SetGridCell ii, 1, Flag
	Next
End Sub

'***************************************************************************
