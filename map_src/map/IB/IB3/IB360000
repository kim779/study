Sub InitToolTipText()
	cximg1.SetToolTipText("3600 NXT 프리/애프터마켓 주문 화면은"& vbLf &_
							"NXT 시세를 불러와요. NXT 정규장 시간엔" & vbLf &_
							"주문이 불가해요."& vbLf &_
							"NXT 미지원 종목은 KRX 시세로 표기되요.")

	If SCREEN.CreateObject("INFO") Then
		val = "NXT 프리/애프터마켓 주문 화면은 NXT 프리마켓("
		val = val & Trim(INFO.PopData("", "AXNXT.ini", "NXT_TIME", "free_start"))
		val = val & " ~ "
		val = val & Trim(INFO.PopData("", "AXNXT.ini", "NXT_TIME", "free_end"))
		val = val & "), NXT 애프터마켓("
		val = val & Trim(INFO.PopData("", "AXNXT.ini", "NXT_TIME", "after_start"))
		val = val & " ~ "
		val = val & Trim(INFO.PopData("", "AXNXT.ini", "NXT_TIME", "after_end"))
		val = val & ") 시간에만 이용가능합니다."
		lbNXTTime.Data = val
	Else
		lbNXTTime.Data = "NXT 프리/애프터마켓 주문 화면은 NXT 프리마켓(08:00 ~ 08:50), NXT 애프터마켓(15:30 ~ 20: 00) 시간에만 이용가능합니다."
	End If
End Sub

'모든 obj 1301에 종목정보 전송
Sub send_sise_all(xval)
	'SCREEN.IgnoreChange True
	If xval <> "jumun" And xval <> "account" Then
  		S1301.Trigger "", False
 	End If
	S1301.Trigger "1301", True

	OBJ_hnam.Send
	OBJECT0.Send
	obj_codeInfo.Visible = True
	obj_codeInfo.Send
	obj_currSise.Send

	SCREEN.Object("obj_currSise.newsViewBtn").Visible = False
	SCREEN.Object("obj_currSise.news_output").Visible = False

	If Trim(SCREEN.Object("OBJ_sise").GetObject) <> "" Then
		SCREEN.Object("OBJ_sise.1301").Data = S1301.Data
		OBJ_sise.Send
	End If

	If Trim(SCREEN.Object("obj_reduce2").GetObject) <> "" Then
		SCREEN.Object("obj_reduce2.1301").Data = S1301.Data
		obj_reduce2.Send
	End If

	If tab_tujaEx1.ID = 4 Then	'뉴스
		obj_reduce1.Send
	End If

	If tab_tujaEx2.ID = 6 Then	'테마
			obj_reduce2.Send
	End If

	If tab_account.ID = "7" Then
		SCREEN.Proc "obj_account.send_main", ""
	End If


	If xval <> "jumun" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.obj_odr.1301").Data = S1301.Data
		SCREEN.Proc "OBJ_order.obj_odr.ChangeCode", ""
		SCREEN.IgnoreChange False
	End If


	obj_obj_sise.Send

	If SCREEN.Object("OBJ_order.obj_odr.1301").Iskonex = True Then
		SCREEN.Object("OBJ_order.obj_odr.c_jqty").type = Asc("N")
	Else
		SCREEN.Object("OBJ_order.obj_odr.c_jqty").type = Asc("1")
	End If

	'SCREEN.IgnoreChange False
End Sub


