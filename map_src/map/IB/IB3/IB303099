{


_AW_ONDECLARE_AW_
Sub send_tr(acno, cod2)
	SCREEN.ClearAll 0, 2
	brnNo.Data = Left(acno, 3)
	facno.Data = acno
	code.Data = cod2

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
SCREEN.Proc "main.Set_guide", " "

If Trim(facno.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "선물계좌번호를 확인하세요"
	SCREEN.Object("parent.AN20").SetFocus
	Exit Sub
End If

If Trim(code.Data) = "" Then
	SCREEN.Proc "main.Set_guide", "종목코드를 확인하세요"
	SCREEN.Object("parent.1301").SetFocus
	Exit Sub
End If

If SCREEN.GetCodeType(code.Data) = 9 Then		' ELW
	Acode.Data = "J"
ElseIf SCREEN.GetCodeType(code.Data) = 27 Then		' Etn
	Acode.Data = "Q"
Else
	Acode.Data = "A"
End If
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim temp0, temp1, temp2, temp3
If Trim(lSubstMgn.Data) = "" Then
	temp1 = 0
Else
	temp1 = CLng(Trim(lSubstMgn.Data))
End If

If Trim(OrdQtyAmt.Data) = "" Then
	temp2 = 0
Else
	temp2 = CLng(Trim(OrdQtyAmt.Data))
End If
temp3 = temp1 - temp2
SCREEN.Proc "parent.set_avol", temp3

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



