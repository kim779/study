_AW_ONDECLARE_AW_
Dim flag '4601에서 넘길 계좌번호등을 셋팅하기위한 플래그

Sub send_sise_all(gubn)
	Dim code, fogb, rsymb, acnm
	code = Mid(Trim(ed_fcod.Data), 2, 2)

	If Trim(code) = "" Then
		ed_fcod.Clear
		OBJ_sise.Send
		OBJ_info.ClearAll 2
		Exit Sub
	End If

	If ("10" <= code And code <= "59")     Or     ("B0" <= code And code <= "ZZ") _
		Or     ("0A" <=  code And code <= "0Z") Or     ("1A" <=  code And code <= "1Z") _
		Or     ("2A" <=  code And code <= "2Z") Or     ("3A" <=  code And code <= "3Z") _
		Or     ("4A" <=  code And code <= "4Z") Or     ("5A" <=  code And code <= "5Z") _
		Or     ("6A" <=  code And code <= "6Z") Or     ("7A" <=  code And code <= "7Z") _
		Or     ("8A" <=  code And code <= "8Z") Or     ("9A" <=  code And code <= "9Z")Then
		ed_fcod.Clear
		'OBJ_sise.Send
		'OBJ_info.ClearAll 2
		Exit Sub
	End If

	code = Left(ed_fcod.Data, 1)
	If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
		fogb = 127
		rsymb = "101301"
		OBJ_sise.SetObject("IB314110")

	ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C" Then
		fogb = 102
		rsymb = "111301"
		OBJ_sise.SetObject("IB314115")
	End If

	HNAM.Data = SCREEN.GetName (fogb, ed_fcod.Data, 0)
	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = HNAM.data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_fcod").data = ed_fcod.data
		SCREEN.IgnoreChange False
	End If

	Call tab_info_change()

	acnm = Trim(SCREEN.Object("OBJ_order.acnm").data)
	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 2, 2
		SCREEN.Object("OBJ_order.acnm").data = acnm
		OBJ_sise.Send
		OBJ_info.Send
		Exit Sub
	Else
		ed_fcod.Trigger "ed_fcod", True
		ed_fcod.Trigger rsymb, True
		ed_fcod.Trigger rsymb, False
		SYSTEM.SetHistory rsymb, ed_fcod.Data
		SYSTEM.SetHistory "ed_fcod", ed_fcod.Data
	End If

	OBJ_sise.Send
	OBJ_info.Send

	SCREEN.Proc "OBJ_order.AddHistory", ed_fcod.Data
End Sub

Sub tab_info_change()
	Select Case tab_info.ID
	Case 1 : OBJ_info.SetObject "IB314121"
	Case 2 : OBJ_info.SetObject "IB314123"
	Case 3 : OBJ_info.SetObject "IB314125"
	Case 4 : OBJ_info.SetObject "IB314127"
	Case 5 : OBJ_info.SetObject "IB314129"
	Case Else : Exit Sub
	End Select

	OBJ_info.Send
End Sub

Sub OBJ_account_send()
	OBJ_account.send
End Sub

Sub clearWrongJmcd()
	ed_fcod.Clear
	OBJ_sise.Send
	OBJ_info.ClearAll 2
End Sub

