_AW_ONDECLARE_AW_
Option Explicit

Const myFILE = "userconf.ini"

Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		Dim jqty, y, x, tmp

		For y=1 To 4
			jqty = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB316100", "btn_inter"&y))
			Select Case y
				Case 1
				  ed_fcod1.Data = jqty
				  HNAM1.Data = SCREEN.GetName(127, jqty, 2)
				Case 2
				  ed_fcod2.Data = jqty
				  HNAM2.Data = SCREEN.GetName(127, jqty, 2)
				Case 3
				  ed_fcod3.Data = jqty
				  HNAM3.Data = SCREEN.GetName(127, jqty, 2)
				Case 4
				  ed_fcod4.Data = jqty
				  HNAM4.Data = SCREEN.GetName(127, jqty, 2)
			End Select
		Next
	End If
End Sub

Sub SaveConfig()
	If SCREEN.CreateObject("INFO") Then

		Dim y, sdata
		For y=1 To 4
			Select Case y
				Case 1
				  sdata = ed_fcod1.Data
				Case 2
				  sdata = ed_fcod2.Data
				Case 3
				  sdata = ed_fcod3.Data
				Case 4
				  sdata = ed_fcod4.Data
			End Select

			INFO.PushData LOGIN.Name, myFILE, "IB316100", "btn_inter"&y, sdata
		Next
	End If
End Sub

Sub InterChangeCode(val)
  Dim ed
  'Set ed = GetRef("ed_fcod"&CStr(val))
