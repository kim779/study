	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		SYSTEM.Push "OCO_modi_order", ""

		hogb = Mid(c_hogb.Text, 4)		'매매구분

		Dim prcCon, prc, prcLowCon, prcLow, tmpCode
		tmpCode = Left(Trim(ed_cfocod.Data), 3)

		If tmpCode = "185" Or tmpCode = "186" Or tmpCode = "187" Or _
			tmpCode = "A85" Or tmpCode = "A86" Or tmpCode = "A87" Then
			prcCon = ed_jprc_con.Data
			prc = ed_jprc.Data
			prcLowCon = ed_jprc_lowCon.Data
			prcLow = ed_jprc_low.Data
		Else
			prcCon = FormatNumber((ed_jprc_con.Data)/100, 2, -1, 0)
			prc = FormatNumber((ed_jprc.Data)/100, 2, -1, 0)
			prcLowCon = FormatNumber((ed_jprc_lowCon.Data)/100, 2, -1, 0)
			prcLow = FormatNumber((ed_jprc_low.Data)/100, 2, -1, 0)
		End If

		dmsg = "o_ogno" & vbTab & Trim(ed_ogno.Data) & vbLf &_
			   "o_acno" & vbTab & Trim(ed_acno.Data) & vbLf &_
			   "o_acnm" & vbTab & Trim(SCREEN.Object("parent.ACNM").Data) & vbLf &_
			   "o_hnam" & vbTab & Trim(HNAM.Data) 	 & vbLf &_
			   "o_hogb" & vbTab & Trim(hogb)		 & vbLf &_
			   "o_jqty" & vbTab & Trim(ed_jqty.Data) & vbLf &_
			   "o_jprc_con" 	& vbTab & prcCon    & vbLf &_
			   "o_jprc"         & vbTab & prc       & vbLf &_
			   "o_jprc_lowCon"  & vbTab & prcLowCon & vbLf &_
			   "o_jprc_low" 	& vbTab & prcLow    & vbLf

		SCREEN.CreateWindow 2, "IB31457A /p5 /d", dmsg

		If SYSTEM.Pop("OCO_modi_order") <> "OK" Then
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송
	Call QueryOption("after")
End Sub


