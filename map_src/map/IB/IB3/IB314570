Sub Set_oHogb()
	SCREEN.IgnoreChange True
	If Trim(ed_ohogb.Data) = "지정가" Then
		c_hogb.Data  = "00"
		'ed_hogb.Data = "00"
	ElseIf Trim(ed_ohogb.Data) = "시장가" Then
		c_hogb.Data  = "03"
		'ed_hogb.Data = "03"
		Call Set_comb_hogb()
	ElseIf Trim(ed_ohogb.Data) = "조건부" Then
		c_hogb.Data  = "05"
		'ed_hogb.Data = "05"
	ElseIf Trim(ed_ohogb.Data) = "최유리" Then
		c_hogb.Data  = "06"
		'ed_hogb.Data = "06"
	End If

	If Trim(ed_ojmgb.Data) = "일반" Then
		o_hogb.Data = "0"
		'ed_jmgb.Data = "0"
	ElseIf Trim(ed_ojmgb.Data) = "IOC" Then
		o_hogb.Data = "1"
		'ed_jmgb.Data = "1"
	ElseIf Trim(ed_ojmgb.Data) = "FOK" Then
		o_hogb.Data = "2"
		'ed_jmgb.Data = "2"
	End If
	SCREEN.IgnoreChange False

	Call Set_comb_hogb()
End Sub

