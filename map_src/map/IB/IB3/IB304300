RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_sise_all(gubn)
	Dim code, fogb, rsymb, acnm
	code = Left(ed_focod.Data, 1)
	If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
		fogb = 101
		rsymb = "30301"
		obj_sise.SetObject("IB304140")
		OBJ_info.SetObject("IB304320")
	ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C" Then
		fogb = 102
		rsymb = "40301"
		obj_sise.SetObject("IB304141")
		OBJ_info.SetObject("IB304321")
	End If

	HNAM.Data = SCREEN.GetName (fogb, ed_focod.Data, 0)
	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = HNAM.data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_focod").data = ed_focod.data
		SCREEN.IgnoreChange False
	End If

	'Call tab_info_change()

	acnm = Trim(SCREEN.Object("OBJ_order.acnm").data)
	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 2, 2
		SCREEN.Object("OBJ_order.acnm").data = acnm
		obj_sise.Send
		OBJ_info.Send
		Exit Sub
	Else
		ed_focod.Trigger "ed_focod", True
		ed_focod.Trigger rsymb, True
		ed_focod.Trigger rsymb, False
		SYSTEM.SetHistory rsymb, ed_focod.Data
		SYSTEM.SetHistory "ed_focod", ed_focod.Data
	End If

	obj_sise.Send
	SCREEN.Proc "OBJ_order.AddHistory", ed_focod.Data
	OBJ_info.Send

End Sub

_AW_ONINDECLARE_AW_
'== 선물옵션주문obj를포함한 main의 공통함수
#LOAD IB999923

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_focod)
_AW_ONCHANGE_AW_
Call send_sise_all("main")
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



