_AW_ONDECLARE_AW_
Dim Mydata

Function data_split()
	Mydata = Split(s_data.data, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)							' 한 레코드를 개체별로 자르는중..
		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(0))				' CUD
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))				' 주문유형
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))				' 시장구분
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))				' 매매구분
		GRID.SetGridCell NREC.Data - ii, 5,Trim(Mydata(ii)(4))				' 계좌번호
		GRID.SetGridCell NREC.Data - ii, 6,Trim(Mydata(ii)(5))				' 비밀번호
	Next
End Function

Sub cell_enable(flag)
	Dim ii

	For ii = 1 To GRID.Rows
		If Trim(GRID.getGridCell(ii, 1)) <> "1" Then		Exit For
		GRID.SetCellEnable ii, 11, flag
	Next

End Sub

Sub AllModify()
	Dim ii, tprc

	For ii = 1 To GRID.Rows
		If Trim(GRID.getGridCell(ii, 1)) <> "1" Then		Exit For

		If r1.Checked = True Then	'지정가
			tprc = Trim(GRID.GetGridCell(ii,11))
			If tprc = "" Then tprc = "0"

			If Mid(Trim(GRID.getGridCell(ii, 8)),2,1) = "0" Then
				GRID.SetGridCell ii, 12,tprc*100 		' 주문가격
			Else
				GRID.SetGridCell ii, 12,tprc			' 주문가격
			End If
			GRID.SetGridCell ii, 13, "00"		' 호가구분
		Else
			GRID.SetGridCell ii, 12,"0"			' 주문가격
			GRID.SetGridCell ii, 13, "03"		' 호가구분
		End If

		GRID.SetGridCell ii,6, pswd.Data  '2009.07

	Next
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
NREC.Pop("num")
L_CNT.Text = NREC.Data

data_split()
cell_enable(0)
'Call GRID.SetCellFocus(1, 11)

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
If SYSTEM.ConnectBy = 1 Then
	If LOGIN.Cani = 0 Then
		MsgBox "본사직원은 주문이 불가합니다.",,"IBK투자증권"
		SCREEN.OnSend = False
		Exit Sub
	End If
End If
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
MsgBox GUIDE.Text, ,"주문확인"
SCREEN.CloseWindow()

