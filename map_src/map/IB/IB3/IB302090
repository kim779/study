Sub order_tab_change()
	Select Case tab_order.ID
	Case "1" : OBJ_odr.SetObject("IB302050")
	Case "2" : OBJ_odr.SetObject("IB302060")
	Case "3" : OBJ_odr.SetObject("IB302080")
	Case "4" : OBJ_odr.SetObject("IB302070")
	End Select
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN20.name
	ed_pswd.Data = AN20.Password
	SCREEN.Proc "main.Set_account", "jumn"
	SCREEN.Object("obj_odr.o_jmno").Clear
	SCREEN.Object("main.guide").Text = ""
'	Call obj_svol.ClearAll(2)

	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus : Exit Sub
	Else
		Select Case SCREEN.GetMapName(1)
		Case "IB302000"
			SCREEN.Object("main.OBJ_account").send
		Case Else
		End Select
	End If

End Sub

