RESOURCE DIVISION
{


_AW_ONDECLARE_AW_

Dim isOrdering, OrderType

Sub DisablePriceTrace(obj)
	obj.Proc "DisablePriceTrace", ""
End Sub

Sub EndQueryJango()
	OBJ_Input.Proc "RequestSise", ""
End Sub

Sub OnCancelOrder()
	Call OnChangeOrder()
End Sub

Sub OnChangeOrder()
	Dim ii, jmno, emsg, refn, igrid
	Set igrid = SCREEN.Object("OBJ_Miche.90303")
	For ii=1 To I_GRID.Rows
		refn = Trim(I_GRID.GetGridCell(ii, 1))
		If Len(refn)>0 And Is_numeric(refn) Then
			refn = CLng(refn)
			jmno = Trim(O_GRID.GetGridCell(ii, 2))
			emsg = Trim(O_GRID.GetGridCell(ii, 4))
			If Len(jmno)>0 Then
				jmno = CLng(jmno)
				If jmno>0 Then
					igrid.SetGridCell refn, 12, " 완료    " & "주문번호[" & jmno & "], " & emsg
					igrid.SetTRgb refn, 12, 95
				Else
					igrid.SetGridCell refn, 12, " 실패   " & emsg
					igrid.SetTRgb refn, 12, 94
				End If
			Else
				igrid.SetGridCell refn, 12, " 실패   " & emsg
				igrid.SetTRgb refn, 12, 94
			End If
		End If
	Next
End Sub

Sub OnNewOrder()
	Dim ii, jmno, emsg, refn, igrid
	Set igrid = SCREEN.Object("OBJ_Input.90303")
	For ii=1 To I_GRID.Rows
		refn = Trim(I_GRID.GetGridCell(ii, 1))
		If Len(refn)>0 And Is_numeric(refn) Then
			refn = CLng(refn)
			jmno = Trim(O_GRID.GetGridCell(ii, 2))
			emsg = Trim(O_GRID.GetGridCell(ii, 4))
			If Len(jmno)>0 Then
				jmno = CLng(jmno)
				If jmno>0 Then
					igrid.SetGridCell refn, 9, " 주문완료    " & "주문번호[" & jmno & "], " & emsg
					igrid.SetTRgb refn, 9, 95
				Else
					igrid.SetGridCell refn, 9, " 주문실패   " & emsg
					igrid.SetTRgb refn, 9, 94
				End If
			Else
				igrid.SetGridCell refn, 9, " 주문실패   " & emsg
				igrid.SetTRgb refn, 9, 94
			End If
		End If
	Next
End Sub

Sub OnAfterOrder()
End Sub

Sub DoNewOrder()
	If IsOrdering Then
		MsgBox "주문실행중입니다. 잠시후 이용하시기 바랍니다.", vbOKOnly, "IBK투자증권"
	End If

