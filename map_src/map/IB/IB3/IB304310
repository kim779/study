	Case "1" : OBJ_odr.SetObject("IB883050")
	Case "2" : OBJ_odr.SetObject("IB883060")
	Case "3" : OBJ_odr.SetObject("IB883070")
	Case "4" : OBJ_odr.SetObject("IB883080")
	End Select
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN20.name
	ed_pswd.Data = AN20.Password
	SCREEN.Proc "main.Set_account", "jumn"
	SCREEN.Object("obj_odr.o_jmno").Clear
	SCREEN.Object("main.guide").Text = ""
'	Call obj_svol.ClearAll(2)

	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus : Exit Sub
	Else
		SCREEN.Proc "main.OBJ_account_send", ""
	End If

End Sub

'=== 가격자동 체크박스 체크값 기억/설정 ===
Sub Set_Auto(mmgb)
	Dim flag
	If (mmgb < "1") Or (mmgb > "3") Then Exit Sub
	flag = SYSTEM.Pop("auto_flag_f")		'-매도,매수,정정
	If Len(Trim(flag)) <> 3 Then flag = "000"	'-default:자동아님
	SCREEN.Object("obj_odr.chk_auto").Checked = (Mid(flag,mmgb,1) = "1")
	SCREEN.Object("obj_odr.cboPrice").Enable = (Mid(flag,mmgb,1) = "1")
End Sub
Sub Get_Auto(mmgb, c_auto)
	Dim flag, val
	If c_auto = "True" Then
		val = "1"
	Else
		val = "0"
	End If

	flag = SYSTEM.Pop("auto_flag_f")		'-매도,매수,정정
	Select Case mmgb
	Case "1" : flag = val & Mid(flag,2)
	Case "2" : flag = Left(flag,1) & val & Mid(flag,3)
	Case "3" : flag = Left(flag,2) & val
	Case Else : Exit Sub
	End Select
	If Len(Trim(flag)) <> 3 Then flag = "000"	'-default:자동아님
	SYSTEM.Push "auto_flag_f", flag
End Sub

Sub AddHistory(code)
	If BUTTON0.Text<>code And BUTTON1.Text<>code And BUTTON2.Text<>code And BUTTON3.Text<>code Then
		BUTTON3.Text = BUTTON2.Text
		BUTTON2.Text = BUTTON1.Text
		BUTTON1.Text = BUTTON0.Text
		BUTTON0.Text = code
	End If
End Sub

Sub BtnCodeChange(focod)
	If Trim(focod)<>"" Then
		SCREEN.Object("obj_odr.ed_focod").Data = focod
		SCREEN.Proc "obj_odr.ChangeCode", ""
	End If
End Sub

