_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999922) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "3"

'***************************************************************************
' DESC: 사용자 입력키 Action
'***************************************************************************
Sub OnAxUserKey(key)
'	If OrdCfg.EnterOrder = True Then
'		If key = 13 Then
'			SYSTEM.UserKey	= True
'			DoOrder()
'		End If
'	End If
End Sub

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, mdgb, dmsg

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		If r_mdgb1.Checked = True Then
			mdgb = "일부정정"
		Else
			mdgb = "전부정정"
		End If
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_hogb" & vbTab & Mid(c_hogb.Text, 4) & vbLf &_
			"o_mdgb" & vbTab & mdgb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & ed_jprc.Data & vbLf
		SCREEN.CreateWindow 2, "IB30017A /p5 /d", dmsg
		If SYSTEM.Pop("fo_modify_order") <> "OK" Then
			Exit Sub
		End If
	End If
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

End Sub

_AW_ONINDECLARE_AW_
#load IB888888

'선물옵션주문 공통
#load IB999922

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call SetConfig()				'TabStop 설정
Call init_option("parent.clearpush_buy")		'주문 환경설정 init
Call init_data()				'주문 init

'마지막 주문번호 Setting
Call Get_jmno()

'원주문 셋팅후 커서위치
Call ogno_focus()

ed_jqty.Enable = False
c_jqty.Enable = ed_jqty.Enable

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Trim(SCREEN.Object("parent.AN20").data) = "" Then
	SCREEN.Object("parent.AN20").Setfocus
ElseIf Trim(ed_pswd.data) = "" Then
	ed_pswd.Setfocus
Else
	ed_ogno.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_jprc)
_AW_ONCHANGE_AW_
If ed_jprc.Enable = False Then
	ed_jprc.Data = "0"
Else
	Dim gubn, symb

	gubn = Left(ed_focod.Data, 3)
	symb = "main.OBJ_sise."

	Select Case gubn
	Case "101", "A01"		'지수선물
		If CDbl(ed_jprc.Data) <> 5 Then	Exit Sub
		symb = symb & "31023"
	Case "103", "403", "A03", "D03"		'스타선물
		If CDbl(ed_jprc.Data) <> 50 Then	Exit Sub
		symb = symb & "31023"
	Case "201", "301", "B01", "C01"		'지수옵션
		If CDbl(ed_jprc.Data) <> 0 Then	Exit Sub
		symb = symb & "41023"
	Case Else
		Exit Sub
	End Select

	ed_jprc.Data = SCREEN.Object(symb).Data
End If

'환경설정용 단가에 저장할것
OrdCfg.Price = CStr(ed_jprc.Data / 100)
OrdCfg.Push
_AW_ONENDSUB_AW_
_AW_ONSETFOCUS_AW_
Dim symb

Select Case Left(ed_focod.data, 1)
	Case "1", "4", "A", "D"		'지수선물
		symb = "31023"
	Case "2", "3", "B", "C"		'스타선물
		symb = "41023"
	Case Else
		Exit Sub
End Select

If Left(ed_focod.Data, 3)<>"401" And Left(ed_focod.Data, 3)<>"D01" Then
	If CDbl(ed_jprc.Data) <= 0.00 Then
		ed_jprc.Data = SCREEN.Object("main.OBJ_sise."&symb).Data
	End If
Else
	' 스프레드의 경우 숫자가 아닐경우에만 현재가 세팅한다.
	If IsNumeric(ed_jprc.Data) <> True Then
		ed_jprc.Data = SCREEN.Object("main.OBJ_sise."&symb).Data
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_jqty)
_AW_ONCHANGE_AW_
OrdCfg.Qty = ed_jqty.Data
