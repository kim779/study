Dim code
Select Case VIEWGRID.HitPos
Case 3	'DATA부 click
	If VIEWGRID.HitPos <> 3 Then
	 Exit Sub
	End If

	code = Trim(VIEWGRID.GetGridCell(VIEWGRID.Index + 1, 1) & VIEWGRID.GetGridCell(VIEWGRID.Index + 1, 2))    '종목코드
	S1301.Data = Mid(code,4)
	S1301.Trigger "", False
	S1301.Trigger "", True
End Select
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim code
Select Case VIEWGRID.HitPos
Case 3	'DATA부 click
