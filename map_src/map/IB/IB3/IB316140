RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Const myFILE = "userconf.ini"

Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		Dim jqty, y, x

		For y=1 To 4
			jqty = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_"&y))
			'MsgBox "BTN_JQTY_" & y & ", " & jqty
			For x=1 To 2
				GRID0.SetGridCell y, x, jqty
			Next
		Next
	End If
End Sub

Sub SaveConfig()
	If SCREEN.CreateObject("INFO") Then
		Dim y
		For y=1 To 4
			INFO.PushData LOGIN.Name, myFILE, "IB316100", "BTN_JQTY_"&y, CLng(GRID0.GetGridCell(y,2))
		Next
	End If
End Sub

_AW_ONSTART_AW_
Call LoadConfig()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BTN_OK)
_AW_ONCLICK_AW_
Call SaveConfig()
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_CANC)
