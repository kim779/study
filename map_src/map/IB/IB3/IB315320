_AW_ONRECEIVE_AW_
Dim items, i

If Mid(LEDGER.Ecod,1,1) = "0" Then

	items = "03" & vbTab
	For i=1 To GRID0.Rows
		If Mid(GRID0.GetGridCell(i,1),1,1) = "F" Then
			items = items & Mid(GRID0.GetGridCell(i,1),1,4) & Trim(GRID0.GetGridCell(i,3)) & vbTab
		End If
	Next
	SCREEN.Object("main.OBJ_odr.cmb_fund").SetItems(items)
	'SCREEN.Object("main.OBJ_odr.OBJ_FUNDACC").Send
	SCREEN.Proc "main.OBJ_odr.OBJ_FUNDACC.send_f", ""
End If

