RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub sendobj()
	SYSTEM.Trace "sendobj START"
Dim item
	item = ""
	MGYM.SetItems(item)

	stgb.Data = "F"

	If SCREEN.Object("main.mgubn").Data = 0 Then
		mgubn.data = 0
	ElseIf SCREEN.Object("main.mgubn").Data = 1 Then
		mgubn.data = 1
	ElseIf SCREEN.Object("main.mgubn").Data = 2 Then
		mgubn.data = 2
	End If

	SCREEN.Send 0
End Sub

_AW_ONRECEIVE_AW_
Select Case Right(Trim(MGYM.Data), 2)
	Case "10" : month.data = "A"
	Case "11" : month.data = "B"
	Case "12" : month.data = "C"
	Case Else : month.data = Right(Trim(MGYM.Data), 1)
End Select

SCREEN.Object("main.zFstmmTp").data = month.data
SCREEN.Object("main.yymm").data = month.data
SCREEN.Proc "main.mainSend", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(MGYM)
_AW_ONCHANGE_AW_
Select Case Right(Trim(MGYM.Data), 2)
	Case "10" : month.data = "A"
	Case "11" : month.data = "B"
	Case "12" : month.data = "C"
	Case Else : month.data = Right(Trim(MGYM.Data), 1)
End Select

SYSTEM.Trace "daffa mgym data : " & MGYM.Data

If Trim(MGYM.Data) <> "" Then
	SCREEN.Object("main.zFstmmTp").data = month.data
	SCREEN.Object("main.bmgun").data = "S"
	SCREEN.Proc "main.mainSend", ""
	SCREEN.Object("main.send_btn").SetFocus
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



