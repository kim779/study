RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	GRID0.SetDataPosition 2
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
GUIDE.Text = ""

Dim accn, pass

LEDGER.Rcnt = "0010"
accn = Trim(ed_accn.Data)
pass = Trim(ed_pswd.Data)

If Trim(accn) = "" Then
	GUIDE.Text = "계좌번호를 확인하세요"
	SCREEN.OnSend = False
	Exit Sub
End If

If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(pass)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하세요"
		SCREEN.OnSend = False
		Exit Sub
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONDBLCLK_AW_
Dim code, jmno, yn

If GRID0.HitPos <> 3 Then
	Exit Sub
End If
yn = Trim(GRID0.GetGridCell(GRID0.row, 8))	  		'주문완료여부
code = Trim(GRID0.GetGridCell(GRID0.row, 16))	  	'종목코드
jmno = Trim(GRID0.GetGridCell(GRID0.row,11)) 		'예약주문번호

If yn <> "0" Then Exit Sub	'미처리상태만 가능

If code = "" Or jmno = "" Then
	Exit Sub
End If

SYSTEM.Push "F_ogno", jmno
SYSTEM.Push "F_code", code

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zRsvOrdDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_pswd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



