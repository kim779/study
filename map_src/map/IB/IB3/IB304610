_AW_ONDECLARE_AW_
Dim Mydata

Function data_split()
	Mydata = Split(s_data.data, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)							' 한 레코드를 개체별로 자르는중..

		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(0))				' CUD
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))				' 주문유형
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))				' 시장구분
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))				' 매매구분
		GRID.SetGridCell NREC.Data - ii, 5,Trim(Mydata(ii)(4))				' 계좌번호
		GRID.SetGridCell NREC.Data - ii, 6,Trim(Mydata(ii)(5))				' 비밀번호
		GRID.SetGridCell NREC.Data - ii, 7,Trim(Mydata(ii)(6))				' 주문번호
		GRID.SetGridCell NREC.Data - ii, 8,Trim(Mydata(ii)(7))				' 종목코드
		GRID.SetGridCell NREC.Data - ii, 9,Trim(Mydata(ii)(8))				' 종목명
		GRID.SetGridCell NREC.Data - ii, 11,Trim(Mydata(ii)(9))				' 주문수량
		GRID.SetGridCell NREC.Data - ii, 12,Trim(Mydata(ii)(10))			' 주문가격

		If Trim(Mydata(ii)(10)) = "" Then Mydata(ii)(10) = "0"

		If Mid(Trim(GRID.getGridCell(NREC.Data - ii, 8)),2,1) = "0" Then
			GRID.SetGridCell NREC.Data - ii, 13,Trim(Mydata(ii)(10))*100 		' 주문가격
		Else
			GRID.SetGridCell NREC.Data - ii, 13,Trim(Mydata(ii)(10))			' 주문가격
		End If

		Select Case Trim(Mydata(ii)(11)) 										' 호가구분
			Case "00"
				GRID.SetGridCell NREC.Data - ii, 10, "지정가(일반)"
			Case "03"
				GRID.SetGridCell NREC.Data - ii, 10, "시장가"
			Case "05"
				GRID.SetGridCell NREC.Data - ii, 10, "조건부지정가"
			Case "06"
				GRID.SetGridCell NREC.Data - ii, 10, "최유리지정가"
			Case "10"
				GRID.SetGridCell NREC.Data - ii, 10, "지정가(IOC)"
			Case "20"
				GRID.SetGridCell NREC.Data - ii, 10, "지정가(FOK)"
		End Select
		GRID.SetGridCell NREC.Data - ii, 14, Trim(Mydata(ii)(11))

		GRID.SetGridCell NREC.Data - ii, 15, Trim(Mydata(ii)(12))			' 주문조건
		GRID.SetGridCell NREC.Data - ii, 16, Trim(Mydata(ii)(13))			' 모두구분
		GRID.SetGridCell NREC.Data - ii, 17, Trim(Mydata(ii)(14))			' 처리구분
		GRID.SetGridCell NREC.Data - ii, 21, Trim(Mydata(ii)(15))			' 기타
	Next
End Function

Sub cell_enable(flag)
	Dim ii

	For ii = 1 To GRID.Rows
		If Trim(GRID.getGridCell(ii, 10)) = "시장가" Or Trim(GRID.getGridCell(ii, 10)) = "최유리지정가" Then
			GRID.SetPRgb ii, 12, 208
		End If
	Next

End Sub

