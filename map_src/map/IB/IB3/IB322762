_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.clearall 0, 2

ed_accn.Data = Trim(SCREEN.Object("parent.AN20").Data)		'계좌번호
zpwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)	'비밀번호

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = 1 Then
	If Error_check() = False Then				'주문전 Error Check
		SCREEN.OnSend = False
		LEDGER.Fkey = "C"
		Exit Sub
	End If
Else
	zpwd.Data = "9999"
End If

If l_CheckInput(ed_accn, zpwd) = True Then
	SCREEN.ClearAll 0, 2
	SCREEN.onsend = True
Else
	SCREEN.ClearAll 0, 2
	zpwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
