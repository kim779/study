_AW_SCRIPT_AW_(mkgb)
_AW_ONCHANGE_AW_
If mkgb.Data = "X" Then
	focod.Visible = True
	focod.Data = ""
	focod.SetFocus
Else
	focod.Visible = False
	focod.Data = ""
End If
Call first_send()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(focod)
_AW_ONCHANGE_AW_
Dim name, major, minor

major = Left(focod.Data,1)
minor = Mid(focod.Data, 2, 2)
If Trim(major) = "" Then
	Exit Sub
ElseIf major = "1" Or major = "4" Or major = "A" Or major = "D" Then
	name = SCREEN.GetName(101, focod.data, 0)'지수선물
Else
	If minor < 10 Then
		name = SCREEN.GetName(102, focod.data, 0)'지수옵션
	Else
		name = SCREEN.GetName(108, focod.data, 0)'주식옵션
	End If
End If

If Trim(name) = "" Then
	focod.Data = ""
	Exit Sub
End If
Call first_send()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


