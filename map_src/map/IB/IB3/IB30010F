'***************************************************************************
' DESC: 실시간 체결 데이타
'***************************************************************************
Const c_jmno = 5, c_ojno = 6, c_code = 7, c_hnam = 8, c_jmgb = 9, c_hogb = 10
Const c_jprc = 11, c_jqty = 12 ,c_dqty = 15, c_dprc = 14, c_wqty = 17, c_stat = 19
Const c_hqty = 18

'***************************************************************************
' DESC: first_send
'***************************************************************************
Sub first_send()
	VIEWGRID.Clear
	LEDGER.Fkey = "C"
	If Trim(ed_pswd.Data) <> "" Then
		SCREEN.Send 0
	Else
		VIEWGRID.Clear
	End If
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	GUIDE.text = ""
	If Trim(ed_pswd.Data) <> "" Then
		Call first_send()
	Else
		VIEWGRID.Clear
	End If
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim ret, msg
	GUIDE.Text = ""
	Error_check = False
	If Trim(ed_accn.Data) = "" Then
		GUIDE.Text = "계좌번호를 확인하세요"
		Exit Function
	End If
	If Trim(ed_pswd.Data) = "" Then
		GUIDE.Text ="비밀번호를 확인하세요"
		Exit Function
	End If

	Error_check = True
End Function

