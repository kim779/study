Sub SetGridDataAvg()
	data = SetAvgData.Data
	data = Replace(data, " ","")
	pos1 = InStr(data,"|")
	pos2 = InStr(pos1 + 1,data ,"|")
	pos3 = InStr(pos2 + 1,data ,"|")
	Amt1.SetTableCell 1, Mid(data,1, pos1 - 1)
	Amt2.SetTableCell 1, Mid(data,pos1 + 1, pos2 - pos1 - 1)

	profit = Mid(data,pos2 + 1, pos3 - pos2 - 1)
	If profit < 0 Then
		profit = "-" & profit
	Else
		profit = "+" & profit
	End If

	Rat = Mid(data,pos3 + 1)
	If Rat < 0 Then
		Rat = "-" & Rat
	Else
		Rat = "+" & Rat
	End If
	Rat = Rat & "%"
	Amt3.SetTableCell 1, profit
	Rate.SetTableCell 1, Rat
End Sub

