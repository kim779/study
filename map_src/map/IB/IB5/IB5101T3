Call QueryHoga()

'가격자동 설정값 저장
SCREEN.Proc "parent.Get_Auto", mmgb &","& CHK_auto.Checked
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cboPrice)
_AW_ONCHANGE_AW_
Select Case mmgb
Case "1" : OrdCfg.WriteCfg "SellPrcGB", cboPrice.Data
Case "2" : OrdCfg.WriteCfg "BuyPrcGB", cboPrice.Data
Case "3" : OrdCfg.WriteCfg "JJPrcGB", cboPrice.Data
Case Else : Exit Sub
End Select
OrdCfg.SaveCfg()
Call QueryHoga()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SYMBOL7)
_AW_ONCLICK_AW_
Dim ed_focod

ed_focod = SCREEN.GetCode (103, "ed_focod", "HNAM", 2)
