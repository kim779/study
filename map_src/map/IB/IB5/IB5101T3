RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999922) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "1"

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(c_hogb.Text, 4)		'매매구분
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & ed_jprc.Data & vbLf
		SCREEN.CreateWindow 2, "IB51015A /p5 /d", dmsg
		If SYSTEM.Pop("fo_mado_order") <> "OK" Then
			Exit Sub
		End If
	End If
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

End Sub




Sub MoveTabFocus(iNext)
	c_hogb.SetFocus
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

'선물옵션주문 공통
#load IB999922

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call SetConfig()				'TabStop 설정
Call init_option("parent.clearpush_buy")		'주문 환경설정 init
Call init_data()				'주문 init

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
get_avol() '주문가능수량

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_jprc)
_AW_ONCHANGE_AW_
If ed_jprc.Enable = False Then
	ed_jprc.Data = "0"
Else
	Dim gubn, symb

	gubn = Left(ed_focod.Data, 3)
	symb = "main.OBJ_sise."

	Select Case gubn
	Case "101", "401", "A01", "D01"		'지수선물
		If CDbl(ed_jprc.Data) <> 5 Then	Exit Sub
		symb = symb & "31023"
	Case "103", "403", "A03", "D03"		'스타선물
		If CDbl(ed_jprc.Data) <> 50 Then	Exit Sub
		symb = symb & "31023"
	Case "201", "301", "B01", "C01"		'지수옵션
		If CDbl(ed_jprc.Data) <> 1 Then	Exit Sub
		symb = symb & "41023"
	Case Else
		Exit Sub
	End Select

	ed_jprc.Data = SCREEN.Object(symb).Data
End If

'환경설정용 단가에 저장할것
OrdCfg.Price = CStr(ed_jprc.Data / 100)
OrdCfg.Push
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_jqty)
_AW_ONCHANGE_AW_
OrdCfg.Qty = ed_jqty.Data
OrdCfg.Push
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
'주문설정창을 띄운다
If OrdCfg.ShowDlg Then
	OrdCfg.LoadInfo
	Call SetConfig()
	Call QueryOption("common")
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(JUMUN_B)
_AW_ONCLICK_AW_
Call DoOrder()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_hogb)
_AW_ONCHANGE_AW_
'OrdCfg.MMGB = shogb.Data
'OrdCfg.Push

Call Set_comb_hogb()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
