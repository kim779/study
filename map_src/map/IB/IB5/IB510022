RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	GRID0.SetDataPosition 2
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Dim pass

SCREEN.Object("Main.GUIDE").Text = ""

pass = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)

Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.Object("Main.GUIDE").Text = ""

Dim accn, pass

accn = Trim(SCREEN.Object("main.OBJ_order.AN20").Data)
pass = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)

If Trim(accn) = "" Or Len(Trim(accn)) < 11 Then
	SCREEN.Object("Main.GUIDE").Text = "계좌번호를 확인하세요"
	SCREEN.Object("main.OBJ_order.AN20").SetFocus
	SCREEN.OnSend = False
	Exit Sub
End If

If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(pass)) < 4 Then
		SCREEN.Object("Main.GUIDE").text = "비밀번호를 확인하세요"
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		SCREEN.OnSend = False
		Exit Sub
	End If
End If

LEDGER.Rcnt = "0010"
zPwd.Data = pass
AN20.Data = accn

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("Main.GUIDE").Text = LEDGER.Emsg
If LEDGER.Next = "Y" Then
	BUTTON2.Enable = True
	Call send_c()
Else
	BUTTON2.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim code, jmno

If GRID0.HitPos <> 3 Then
	Exit Sub
End If

code = Trim(GRID0.GetGridCell(GRID0.row, 16))	  	'종목코드
jmno = Trim(GRID0.GetGridCell(GRID0.row,11)) 		'예약주문번호

If code = "" Or jmno = "" Then
	Exit Sub
End If

SCREEN.Object("Main.OBJ_order.tab_order").ID = "4"
SCREEN.Object("Main.OBJ_order.OBJ_odr").SetObject "IB302080"

SCREEN.Object("main.ed_focod").Data = code
SCREEN.Proc "main.send_sise_all", "main"


SCREEN.Object("main.OBJ_order.OBJ_odr.ed_ogno").Data = jmno
SCREEN.Object("main.OBJ_order.OBJ_odr.JUMUN_B").SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zRsvOrdDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


