		GRID0.SetGridCell ii, 2,  Trim(GRID0.GetGridText(ii,38))   '주문일 (주문일자)
		GRID0.SetGridCell ii, 3,  Trim(GRID0.GetGridText(ii,25))   '심볼 (종목코드)
		GRID0.SetGridCell ii, 4,  Trim(GRID0.GetGridText(ii,27))   '통화
		GRID0.SetGridCell ii, 5,  Trim(GRID0.GetGridText(ii,28))   '외화금액 (거래금액(외))
