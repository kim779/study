RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Public Today
Today = getCurrDay()

Dim g_flag
g_flag = 0

Sub InitIMAX
	If g_flag = 1 Then
		Exit Sub
	End If
	l_initimax("ctrl_code")
	g_flag = 1
End Sub



'== 계좌명, 비밀번호 설정
Sub Set_account()
	ACNM.Data = AN3A.name
	zPwd.Data = AN3A.Password

	If Trim(AN3A.Data) = "" Then
		AN3A.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Send 0
End Sub

'== 첫 조회
Sub send_f()
	GRID0.Clear
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub columnvisble(bVisible)
	For ii = 37 To GRID0.Columns
		GRID0.SetColumnVisible ii, bVisible
	Next
End Sub

_AW_ONINDECLARE_AW_
#load IB888888
#load IB999938

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SCREEN.IgnoreChange True
SrtDt.data = change_date("d",-7)
EndDt.Data = Today
SCREEN.IgnoreChange False

COMBO0.Data = 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

LEDGER.Rcnt = "0010"

'If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
If SYSTEM.ConnectBy = "0"  Then
	   zPwd.Data = "9999"
Else
	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If  Len(Trim(zPwd.Data)) >= 4 Then
			If  Trim(zPwd.Data) <> "HEAD" Then
				LEDGER.Hsiz = 44
				LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			End If
			zPwd.Data = "HEAD"
		End If

		If Trim(zPwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				GUIDE.Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요.."
				zPwd.Data = ""
				zPwd.SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If

ACCN = Trim(AN3A.Data)						'계좌번호
pass = Trim(zPwd.Data)					'비밀번호

If Len(Trim(ACCN)) <> 11 Then
	GUIDE.Text = "계좌번호를 확인하여 주십시오."
	AN3A.SetFocus
	Exit Sub
End If

If Len(Trim(pass)) < 4 Then
	GUIDE.Text = "비밀번호를 확인하여 주십시오."
	zPwd.SetFocus
	Exit Sub
End If

zAcntNo.Data = ACCN

If Trim(zAcntNo.Data) = "" Then
	GUIDE.Text = "계좌번호를 확인하여 주십시오."
	AN3A.SetFocus
	Exit Sub
End If

If ck_cancel.Checked = True Then
	edCanTp.Data = "1"
Else
	edCanTp.Data = " "
End If

If cx_code.Checked = True Then
	edCode.Data = IMAXISIN.Data
Else
	edCode.Data = ""
End If

edTrdNo.Data = "+999999999"


SCREEN.OnSend True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
Dim sdata
Dim ii, jj
ecod = Trim(LEDGER.Ecod)
next_btn.Enable = False
If Left(ecod, 1) = "0" Then

	For ii = 1 To GRID0.Rows
