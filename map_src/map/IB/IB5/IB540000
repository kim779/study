SCREEN.IgnoreChange True
	r_upgb = P_GetBigCd(S62303.Data)
	Select Case Left(r_upgb,1)
		Case "0"		'KOSPI
			S62302.DATA = "00"
			SYMBOL2.Enable = True
		Case "1"		'KOSPI200
			S62302.DATA = "10"
			SYMBOL2.Enable = False
		Case "2"		'KOSDAQ
			S62302.DATA = "90"
			SYMBOL2.Enable = True
		Case Else
			S62303.Data = "001"
			S62302.DATA = "00"
			SYMBOL2.Enable = True
	End Select
