Sub Set_account()

	ACNM.Data = AN3A.name
	pswd.Data = AN3A.Password

	If SYSTEM.ConnectBy = "0" And Trim(pswd.Data) = "" Then
		pswd.Data = "9999"
	End If

	If Len(Trim(pswd.data)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하십시오"
 		pswd.Setfocus
 		Exit Sub
	End If

	SCREEN.Proc "obj_search.send_f", ""
End Sub

