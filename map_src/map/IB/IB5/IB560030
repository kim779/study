			VIEWGRID1.SetGridCell ii, 5, (GRID1.GetGridCell (ii,  6))	' 매도가능수량
			VIEWGRID1.SetGridCell ii, 6, (GRID1.GetGridCell (ii,  7))	' 평균단가
			VIEWGRID1.SetGridCell ii, 7, (GRID1.GetGridCell (ii, 10))	' 현재가
			tmpb = GRID1.GetGridCell (ii, 12)							' 평가손익
			VIEWGRID1.SetGridCell ii, 8, tmpb
			If tmpb < 0 Then
				VIEWGRID1.SetGridCell ii, 8, "-" & Trim((VIEWGRID1.GetGridCell (ii, 8)))
			End If

			tmpb = GRID1.GetGridCell (ii, 13)							' 수익률
			VIEWGRID1.SetGridCell ii, 9, tmpb
			If tmpb < 0 Then
				VIEWGRID1.SetGridCell ii, 9, "-" & Trim((VIEWGRID1.GetGridCell (ii, 9)))
			End If
			VIEWGRID1.SetGridCell ii, 10, (GRID1.GetGridCell (ii, 11))	' 평가금액
			tmpb = GRID1.GetGridCell (ii, 17)							' 원화평가손익
			VIEWGRID1.SetGridCell ii, 11, tmpb
			If tmpb < 0 Then
				VIEWGRID1.SetGridCell ii, 11, "-" & Trim((VIEWGRID1.GetGridCell (ii, 11)))
			End If
			VIEWGRID1.SetGridCell ii, 12, (GRID1.GetGridCell (ii,  1))	' 통화코드
			VIEWGRID1.SetGridCell ii, 13, (GRID1.GetGridCell (ii, 14))	' 기준환율
		Next
	End If
