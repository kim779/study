RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim bNowPrice
Sub OnPortfolio(confirm)
	Dim groupNames, parseData, Items, codelist, row

	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If
	If UCase(confirm) <> "OK" And UCase(confirm) <> "START" Then
		Exit Sub
	End If

	Items = ""
	DX_INTEREST.SetUserName(LOGIN.Name)
	groupNames = DX_INTEREST.LoadGroupNames()
	Do While Len(groupNames) > 0
		parseData = Mid(groupNames, 1, InStr(groupNames, vbTab) -1)
		groupNames = Mid(groupNames, InStr(groupNames, vbTab) + 1)
		Items = parseData & vbTab & Items
	Loop
	If Items = "" Then
		intercombo.SetItems("")
	Else
		intercombo.SetItems(vbTab & Items)
	End If

	intercombo.Data = SYSTEM.Pop("cxPortfolioItem")
	SCREEN.Proc "OBJ1.OnGroup", intercombo.Data
End Sub

_AW_ONSTART_AW_
If SYSTEM.Pop("cxPortfolioType") = "2" Then
	RADIO1.Checked = True
	OBJ1.SetObject "IB20001Y"
Else
	RADIO0.Checked = True
End If
OnPortfolio("start")
bNowPrice = True

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB202201 /t/s/p5/d", "appendCODE" & _
			vbTab & "" & vbLf & "map" & vbTab & "1" & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
bNowPrice = Not bNowPrice
If bNowPrice = True Then
	SCREEN.Proc "OBJ1.OnPredict", "1"
Else
	SCREEN.Proc "OBJ1.OnPredict", "0"
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
bNowPrice = Not bNowPrice
If bNowPrice = True Then
	SCREEN.Proc "OBJ1.OnPredict", "1"
Else
	SCREEN.Proc "OBJ1.OnPredict", "0"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(intercombo)
_AW_ONCHANGE_AW_
If SCREEN.CreateObject("DX_INTEREST") = False Then
	Exit Sub
End If
