	If Len(Trim(VIEWGRID.GetGridCell(VIEWGRID.ROW, 2))) = 7 Then
		S1301.DATA = Right(Trim(VIEWGRID.GetGridCell(VIEWGRID.ROW, 2)),6)
		If Trim(S1301.DATA) = "" Then
		    Exit Sub
		End If

		S1301.Trigger "", False
		S1301.Trigger "", True
	   SYSTEM.SetHistory "1301", S1301.DATA
	End If

	If VIEWGRID.Column = 1 Then
		val = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 4))
		quan = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 6))

		If quan = "" Then
			MsgBox "주문가능 수량을 확인하세요."
			VIEWGRID.SetGridCell VIEWGRID.Row, 1, 0
			Exit Sub
		End If

		If val = "02" Or val = "03" Or val = "04" Then
			MsgBox "[3030] 대용종합 화면을 이용해 주십시오."
			VIEWGRID.SetGridCell VIEWGRID.Row, 1, 0
			Exit Sub
		End If

		If chkcnt() = False Then
			BUTTON0.Enable = False
		Else
			BUTTON0.Enable = True
		End If
	End If
Case Else
	Call SetDic()
	SCREEN.OnSend = False
	Exit Sub
End Select
