_AW_ONDECLARE_AW_
Sub Set_account()
	Dim ACCN, pass,tax,mmd, ctype

	pswd.Clear
	VIEWGRID.Clear

	' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "0" And Trim(pswd.Data) = "" Then
	   pswd.Data = "9999"
	End If

	ACCN = Trim(AN3A.Data)						'계좌번호
	pass = Trim(pswd.Data)						'비밀번호


	If Len(Trim(ACCN)) <> 11 Then
		GUIDE.Text = "계좌번호를 확인하여 주십시오."
		AN3A.SetFocus
		Exit Sub
	End If

	If Len(Trim(pass)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하여 주십시오."
		pswd.SetFocus
		Exit Sub
	End If

	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	VIEWGRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
Dim i, j
ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = "0" Then

	If LEDGER.Next = "Y" Then
		Call send_c()
	End If
Else
	If ecod = "3669" Or ecod = "1801" Then
		SCREEN.ClearAll 0, 2
		pswd.SetFocus
		Exit Sub
	End If
End If

If Trim(ecod) <> "0133" Then
	GUIDE.Text = Trim(LEDGER.Emsg)
End If

