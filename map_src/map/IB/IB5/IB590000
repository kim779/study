RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_account()
	SCREEN.ClearAll 0, 2
	pswd.Clear
	obj_exrate.ClearAll 0
	obj_acccur.ClearAll 0
	obj_exchange.ClearAll 0

	GUIDE.Text = ""

	ACNM.Data = AN3A.name
	pswd.Data = AN3A.Password
	If Trim(AN3A.Data) = "" Then
		AN3A.SetFocus
		Exit Sub
	End If

	If Trim(pswd.Data) = "" Then
		pswd.SetFocus
		Exit Sub
	End If

	send_f()
End Sub

Sub send_f()
	If Len(Trim(AN3A.Data)) <> 11 Then
		GUIDE.Text = "계좌번호를 확인하여 주십시오."
		AN3A.SetFocus()
		Exit Sub
	End If

	If Len(Trim(pswd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 확인하여 주십시오."
		pswd.SetFocus
		Exit Sub
	End If
	
	SCREEN.Proc "obj_acccur.send_f", ""
	SCREEN.Proc "obj_exrate.send_f", ""
	SCREEN.Proc "obj_list.send_f", ""


	' 계좌 클리어 시 재조회
	' 은행으로부터 해당 화폐의 매도/매수에 대한 고시 환율을 조회(SDPKT169)한 다음
	' 해당 고시환율에 대한 적용환율을 코스콤으로부터 조회(SDPDQ099)
	SCREEN.Proc "obj_exchange.Clear_Input", ""
	SCREEN.Object("obj_exchange.obj_srhreate").Send

End Sub

_AW_ONINDECLARE_AW_
#load IB888888
#load IB888833

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(pswd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 Then
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN3A)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SND)
_AW_ONCLICK_AW_
SCREEN.Proc "obj_exchange.send_f", "1"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



