Function IsSame(sData)
	IsSame = False

	Dim Ifind, sAcc, sPass
	ifind = InStr(sData, "-")
	sAcc = Trim( Left(sData, Ifind-1) )
	sPass = Trim( Mid(sData, Ifind+1, Len(sData)- Ifind) )

	If Trim(acct_temp.Data) = sAcc Then
		IsSame = True

		CONTROL0.SetAccount sAcc

		If intercombo.Index = 0 Then
			CONTROL0.SetPass sPass
			CONTROL0.ClearGrid

			CONTROL0.ChangeGroup intercombo.Data
		End If
	Else
		acct_temp.Data = sAcc
		ed_pswd.Data = sPass
		'AN1A.Data = sAcc

		CONTROL0.SetAccount sAcc

		If intercombo.Index = 0 Then
			CONTROL0.SetPass sPass
			CONTROL0.ClearGrid

			CONTROL0.ChangeGroup intercombo.Data
		End If
	End If
End Function

