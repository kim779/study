'==============================================================
Sub bank_chk()
	bchk.Text = ""

	If Left(CMB_ACCT.text, 1) = "5" Then	'은행개설계좌일 경우
		Dim manageNo, ii, grdAcct, acctGrd
		Set acctGrd = SCREEN.Object("main.obj_acct.GRID0")

		For ii = 1 To acctGrd.Rows
			grdAcct = Trim(acctGrd.GetGridCell(ii, 9))

			If grdAcct = Trim(CMB_ACCT.Data) Then
				manageNo = Trim(acctGrd.GetGridCell(ii, 7))
				Exit For
			End If
		Next

		If Left(manageNo, 1) = "5" Then
			bchk.Text = "1"
		End If
	End If

	If Trim(bchk.Text) = "" Then
		bchk.Text = "0"
	End If

	SYSTEM.Trace "IB594010 bank_chk  bchk = " & bchk.Text
End Sub

