		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Object("chk_passwd.IntaccNo").data = tmpAcct
	SCREEN.Object("chk_passwd.Pwd").data = tmpPwd

	chk_passwd.Send
	SCREEN.Proc "Main.OBJ2.send_f", ""
