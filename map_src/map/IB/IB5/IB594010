Function checkInptVal(inpt)
	checkInptVal = False

	Dim num
	num = Trim(inpt)

	If num = "" Then
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Exit Function
	End If

	If CDbl(num) <= 0 Then
		Exit Function
	End If

	Dim ii, char

	For ii = 1 To Len(num)
		char = Mid(num, ii, 1)

		If AscW(char) < 48 Or AscW(char) > 57 Then
			Exit Function
		End If
	Next

	checkInptVal = True
End Function

