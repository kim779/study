RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub request_url()
	EDIT0.Data = Trim(LOGIN.User)
	SCREEN.Send 0
End Sub

_AW_ONRECEIVE_AW_
Dim ret,aes256,url_aes256,base64,url_base64,t_base64, tmp

For ii = 1 To 5
	 ret = Trim(TABLE0.GetTableCell(ii))
	 If ret <> "" Then
	 	SYSTEM.Trace ret
	 End If

	Select Case ii
		Case 1	'aes256
			aes256 = ret
		Case 2 'url_aes256
			url_aes256 = ret
		Case 3	'base64
			base64 = ret
		Case 4	'url_base64
			url_base64 = ret
		Case 5	'time_base64
			t_base64 = ret
	End Select

Next

tmp = "https://ibksteam.chat.boolio.ai/ingress/ibksteam/hts?uuid=" & url_aes256 & "&Time=" & t_base64
'MsgBox tmp
SYSTEM.Trace tmp
BROWSER0.Navigate("https://ibksteam.chat.boolio.ai/ingress/ibksteam/hts?uuid="& url_aes256 &"&time="& t_base64)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BTN_MD)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BROWSER0)
