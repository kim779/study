RESOURCE DIVISION
{


_AW_ONDECLARE_AW_

Dim g_ArrInput

'시간 혹은 일자
g_ArrInput = Array("", "")
'TimeType, GridLastDate or GridLastTime
'-----------------------------------------------------------------------
Function SetPrcSign(Diff, Data)
	Giho = Mid(LTrim(Diff), 1, 1)
	If Giho = "1" Or Giho = "2" Then
		SetPrcSign = "+" & LTrim(Data)
	ElseIf Giho = "4" Or Giho = "5" Then
		SetPrcSign = "-" & LTrim(Data)
	Else
		SetPrcSign = Data
	End If
End Function
'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	If Data > 0 Then
		SetSign = "+" & Data
	End If
End Function
'-----------------------------------------------------------------------
Function SetTimeElement(Element)
	If Len(Element) = 1 Then
		Element = "0" & Element
	End If
	SetTimeElement = Element
End Function
'-----------------------------------------------------------------------
Function GetTime(SrcTime, MinGap)
	SrcTime = SrcTime - SrcTime Mod MinGap + MinGap
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = Mid(SrcTime, 1, 2)
	AMin = CLng(Mid(SrcTime, 3, 2))
'	AMin = AMin - AMin Mod MinGap

'	ADate = TimeSerial(AHour, AMin + MinGap, ASec)
	ADate = TimeSerial(AHour, AMin, ASec)

	AHour = SetTimeElement(Hour(ADate))
	AMin = SetTimeElement(Minute(ADate))
	ASec = SetTimeElement(Second(ADate))


	GetTime = AHour & AMin & ASec
End Function
'-----------------------------------------------------------------------
Sub ProcSendData(StdCode, TimeType, ADate)
	ed_StdCode.Data = StdCode
	ed_TimeType.Data = TimeType

	g_ArrInput(0) = TimeType
	DATE.Data = ADate

	If TimeType = "0000" Then
		GRID0.SetColumnVisible 1, False
		GRID0.SetColumnVisible 2, True
	Else
		GRID0.SetColumnVisible 1, True
		GRID0.SetColumnVisible 2, False
	End If
	GRID0.Clear
	SCREEN.Send 0
End Sub
'-----------------------------------------------------------------------
Sub ProcSetData(Data)
	ArrData = Split(Data, "|")

'	SYSTEM.Trace "[" & ArrData(0) & "]"

	TimeIndex = 1
	If g_ArrInput(0) = "0000" Then
		ADateTime = ArrData(0)
		TimeIndex = 2
	ElseIf g_ArrInput(0) = "3600" Then	'60분
		ADateTime = GetTime(ArrData(0), g_ArrInput(0) / 360 * 100)
		TimeIndex = 1
	Else	'1분, 5분, 10분
		ADateTime = GetTime(ArrData(0), g_ArrInput(0) / 60 * 100)
		TimeIndex = 1
	End If

'	SYSTEM.Trace "ADateTime[" & ADateTime & "]GetGridCell[" & Trim(GRID0.GetGridCell(1, TimeIndex)) & "]"

	If ADateTime <> Trim(GRID0.GetGridCell(1, TimeIndex)) Then
		'실시간 데이터이므로 ADateTime 값이 현재의 시간보다 작지 않음.
		'만약 작다면 현재값에 포함시킴
		If Trim(GRID0.GetGridCell(1, TimeIndex)) = "" Then
			GRID0.InsertRow 0
			GRID0.SetGridCell 1, TimeIndex, ADateTime
		ElseIf ADateTime - Trim(GRID0.GetGridCell(1, TimeIndex)) > 0 Then
			GRID0.InsertRow 0
			GRID0.SetGridCell 1, TimeIndex, ADateTime
		End If
	End If

	GRID0.SetGridCell 1, 3, ArrData(1)
	GRID0.SetGridCell 1, 4, ArrData(2)
	GRID0.SetGridCell 1, 5, ArrData(3)
	GRID0.SetGridCell 1, 6, ArrData(4)
	GRID0.SetGridCell 1, 13, ArrData(5)
	GRID0.SetGridCell 1, 14, ArrData(6)
	GRID0.SetGridCell 1, 15, ArrData(7)
	GRID0.SetGridCell 1, 16, ArrData(8) & " %"

	g_ArrInput(1) = ADateTime
End Sub
'-----------------------------------------------------------------------

_AW_ONRECEIVE_AW_
If GRID0.Rows > 0 Then
	If g_ArrInput(0) = "0000" Then
		TimeIndex = 2
	Else
		TimeIndex = 1
	End If

	g_ArrInput(1) = GRID0.GetGridCell(1, TimeIndex)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(DATE)
_AW_ENDSCRIPT_AW_


}



