	End If

	Dim msg1, msg2
	msg1 = "환매수수료 부과기간이오니 확인하시기 바랍니다."
	msg2 = "총 설정고가 10억 미만의 소액펀드이오니 투자에 참고하시기 바랍니다."

	Select Case Trim(zCmsnAmtLevyYn.Data)
		Case "1" : Call alert_msg(msg1)
		Case "2" : Call alert_msg(msg1 & vbLf & vbLf & msg2)
		Case "3" : Call alert_msg(msg2)
	End Select

	If dCmsnAmtRat.Data <> "      " Then
		sCmsnAmtRat.Data = FormatNumber(CStr(CDbl(dCmsnAmtRat.Data * 100)),2,-1,0,0) & "%"
	End If

End Sub

