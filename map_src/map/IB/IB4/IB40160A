RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim runMingam
Dim g_BefK200Time

g_BefK200Time = "0"
'-----------------------------------------------------------------------------
Function GetInt(StrData)
	Dim Data
	GetInt = 0

	If Len(StrData) > 6 Then
		Data = Mid(StrData, 1, 2) & Mid(StrData, 4, 2) & Mid(StrData, 7, 2)
	Else
		Data = StrData
	End If
	'LABEL2.Data = Data
	If IsNumeric(Data) Then
		GetInt = CLng(Data)
	Else
		Exit Function
	End If

End Function
'-----------------------------------------------------------------------------

If SCREEN.CreateObjectEx("DX_OPSENSCAL") = False Then
	runMingam = False
Else
	runMingam = True
	DX_OPSENSCAL.UserName 	= LOGIN.Name 								'ReadCfg작업을 위해 UserName 필요
	DX_OPSENSCAL.ReadCfg
End If

Sub OnAlert()
	Dim tmp, ii, sCode, curr
	Dim pos_c, pos_d, pos_t, pos_i

	If runMingam = False Or Trim(S40301.Data) = "" Or rts_yn.Text = "N" Then
		Exit Sub
	End If

	If g_BefK200Time = S20034.Data Then
		Exit Sub
	End If

	If Mid(S20034.Data, 1, 1) <> "장" Then
		If GetInt(Trim(S20034.Data)) - GetInt(g_BefK200Time) <= 1 And g_BefK200Time <> "0" Then
			'g_BefK200Time = S20034.Data
			Exit Sub
		End If
	End If
	g_BefK200Time = Trim(S20034.Data)

	pos_c = Trim(lab_curr.Text)

	If pos_c = "7" Then			'콜 전광판
		pos_d = "5"
		pos_t = "4"
		pos_i = "3"
	Else								'풋 전광판
		pos_d = "6"
		pos_t = "7"
		pos_i = "8"
	End If

	For ii = 1 To SCREEN.Object("parent.GRD").rows

		sCode = SCREEN.Object("parent.GRD").getgridcell(ii,	1)
		If Trim(sCode) = "" Then
			Exit For
		End If

		DX_OPSENSCAL.JCode      = sCode		'종목코드
		curr = SCREEN.Object("parent.GRD").getgridcell(ii,	pos_c)'현재가
		If IsNumeric(curr) = False  Then
			Exit For
		End If

		DX_OPSENSCAL.CurrValue  = Abs(curr)
		DX_OPSENSCAL.Strike     = SCREEN.Object("parent.HANG").getgridcell(ii, 2)	'행사가

		' IV, Delta, Gamma, Theta, Vegga, Rho 계산
		' 입력인자 : 현재가, K200, 선물최근월물, 장시간
		If IsNumeric(curr) = True Then
			DX_OPSENSCAL.CalcEx Abs(curr), S20023.Data, S31023.Data, S20034.Data
		Else
			DX_OPSENSCAL.CalcEx 0, S20023.Data, S31023.Data, S20034.Data
		End If

		SCREEN.Object("parent.GRD").setgridcell ii,	pos_d, DX_OPSENSCAL.Delta
		SCREEN.Object("parent.GRD").setgridcell ii,	pos_t, DX_OPSENSCAL.Theta
		SCREEN.Object("parent.GRD").setgridcell ii,	pos_i, DX_OPSENSCAL.IV
	Next

'	rts_yn.Text = "N"
End Sub

_AW_ONSEND_AW_
S20301.Data = "101"
S30303.Data = "1"
g_BefK200Time = "0"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If SCREEN.CreateobjectEx("DX_OPSENSCAL") Then
	DX_OPSENSCAL.CD         = TABLE3.GetTableCell(1)				'CD 금리
	If IsNumeric(Trim(TABLE3.GetTableCell(2))) = True Then
		DX_OPSENSCAL.BedangJisu = TABLE3.GetTableCell(2) / 1000000	'배당지수
	End If

	DX_OPSENSCAL.BzRemainDays = TABLE3.GetTableCell(4)			'영업일
	DX_OPSENSCAL.CalRemainDays = TABLE3.GetTableCell(3)			'달력일
	DX_OPSENSCAL.SetHv TABLE3.GetTableCell(5), TABLE3.GetTableCell(6), TABLE3.GetTableCell(7), TABLE3.GetTableCell(8) '역사적변동성
End If
OnAlert()

_AW_ONENDSUB_AW_
}



