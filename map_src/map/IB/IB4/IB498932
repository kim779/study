End Sub

'== 연속 조회
Sub send_c()
	zAcntNo.Data = SCREEN.Object("main.AN55").Data
'	zPwd.Data = SCREEN.Object("main.zPwd").Data
	Call Password_initFund(zPwd)
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub Set_Ptn()
	Dim Nxt, GR1
	For nxt = 1 To GRID0.Rows
		GR1 = GRID0.GetGridCell(nxt, 2)
		Select Case GR1
			Case "01"
				GRID0.SetGridCell nxt, 3, "주식형"
			Case "02"
				GRID0.SetGridCell nxt, 3, "주식혼합형"
			Case "03"
				GRID0.SetGridCell nxt, 3, "채권혼합형"
			Case "04"
				GRID0.SetGridCell nxt, 3, "채권형"
			Case "05"
				GRID0.SetGridCell nxt, 3, "혼합자산형"
			Case "06"
				GRID0.SetGridCell nxt, 3, "MMF"
			Case "07"
				GRID0.SetGridCell nxt, 3, "파생상품간접"
			Case "08"
				GRID0.SetGridCell nxt, 3, "부동산간접"
			Case "09"
				GRID0.SetGridCell nxt, 3, "실물간접"
			Case "10"
				GRID0.SetGridCell nxt, 3, "재간접"
			Case "11"
				GRID0.SetGridCell nxt, 3, "특별간접"
		End Select
	Next
End Sub


Sub newFundJoinSend()
'	SYSTEM.Trace "IB498932 newFundJoinSend"
	SCREEN.ClearAll 0, 2
	sendFlag = "continual"

	zAcntNo.Data = SCREEN.Object("main.AN55").Data
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub serachAccFundList()
	Dim accsub, ii
	accsub = Trim(SYSTEM.Pop("IB498932_SELECT_FUND"))
	SYSTEM.push "IB498932_SELECT_FUND",""
	If accsub <> "" Then
		accsub = Replace(Trim(accsub), "-", "")
		For ii = 1 To GRID0.Rows
			If Trim(GRID0.GetGridCell(ii, 4)) = accsub Then
				SelectFundList(ii)
			End If

		Next
	End If
End Sub


Sub SelectFundList(rownum)

Dim dmsg, codx, metaNm, gridrow

If rownum <> "" Then
	gridrow = rownum
Else
	gridrow = GRID0.Row
End If

codx = GRID0.GetGridCell(gridrow, 6)

If rownum = "" Then
	If GRID0.HitPos <> 3 Or Trim(codx) = "" Then
		Exit Sub
	End If
End If

If GRID0.HitPos = 3 Then
	SCREEN.Object("main.fundcode").Data = Trim(GRID0.GetGridCell(gridrow, 6))
	SCREEN.Object("main.FundName").Text = Trim(GRID0.GetGridCell(gridrow, 9))
	SCREEN.Proc "main.OBJ4.main_send", ""
End If

SCREEN.Object("parent.jumn_obj.zAcntNo").Data = Trim(GRID0.GetGridCell(gridrow, 4))
SCREEN.Object("parent.zAcntNo").Data = Trim(GRID0.GetGridCell(gridrow, 4))
SCREEN.Object("parent.zIvstfndCode").Data = codx
SCREEN.Object("parent.jumn_obj.zIvstfndCode").Data = codx
