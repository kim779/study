RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then

	If Trim(EDIT10.Data) = "01" Or Trim(EDIT10.Data) = "02" Or Trim(EDIT10.Data) = "03" Or Trim(EDIT10.Data) = "04" Or Trim(EDIT10.Data) = "10"  Or Trim(EDIT10.Data) = "07"Then
		A.Data = "1" '01주식형 02주식혼합협 03채권혼합형 04채권형 10재간접 07파생상품간접
	ElseIf Trim(EDIT10.Data) = "08" Then
		A.Data = "2"	'08부동산간접
	ElseIf Trim(EDIT10.Data) = "09" Or Trim(EDIT10.Data) = "11" Then
		A.Data = "3"	'09실물간접 11특별간접
	ElseIf Trim(EDIT10.Data) = "05" Then
		A.Data = "4" '05신탁형
	ElseIf Trim(EDIT10.Data) = "06" Then
		A.Data = "5" '06MMF
	End If

	If Trim(EDIT9.Data) = "01" Then'매우낮은위험
		B.Data = "6"
	ElseIf Trim(EDIT9.Data) = "02" Then'낮은위험
		B.Data = "5"
	ElseIf Trim(EDIT9.Data) = "03" Then'보통위험
		B.Data = "4"
	ElseIf Trim(EDIT9.Data) = "04" Then'다소높은위험
		B.Data = "3"
	ElseIf Trim(EDIT9.Data) = "05" Then'높은위험
		B.Data = "2"
	ElseIf Trim(EDIT9.Data) = "06" Then'매우높은위험
		B.Data = "1"
	End If

Else
	MsgBox LEDGER.Emsg
End If

_AW_ONENDSUB_AW_
}



