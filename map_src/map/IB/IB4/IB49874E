_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If Int(LmtRmndAmt.Data) > 0 Then
		SCREEN.Object("parent.hando").Data = LmtRmndAmt.Data
	Else
		SYSTEM.Push "IB49879A_TEXT", "분리과세하이일드 가입 가능한\n한도가 없습니다."
		SYSTEM.Push "IB49879A_OK" , "Y"

		SCREEN.CreateWindow 2, "IB49879A /p5 /d", ""

		tempYN = SYSTEM.pop ("IB49879A_OK")
		If Trim(tempYN) = "Y" Then '무조건 닫음
			SCREEN.Proc "parent.CloseWindow", ""
			SCREEN.CloseWindow
		End If
	End If


Else
	MsgBox Trim(LEDGER.emsg)
End If

