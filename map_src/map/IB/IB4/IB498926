RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
E3.Data = SCREEN.Object("parent.zIvstfndCode").Data
If SCREEN.GetMapName(1) = "IB498900" Or SCREEN.GetMapName(1) = "IB49892H" Then
	SYSTEM.Trace SCREEN.Object("parent.AN55").Data
	E2.Data = SCREEN.Object("parent.AN55").Data
Else
	E2.Data = SCREEN.Object("parent.AN50").Data
End If
GRID0.Clear

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, item, data

If LEDGER.Next = "Y" Then
	send_c()
Else

	item = "001"
	If GRID0.Row <> 0 Then
		For ii=1 To GRID0.Rows
			If CLng(GRID0.GetGridCell (ii, 2)) <> 0 Then
				data = Right(GRID0.GetGridCell (ii, 2), 3) & Right(GRID0.GetGridCell (ii, 2), 3)
				item = item & vbTab & data
			End If
		Next
		SCREEN.Object("parent.sub_account").Setitems(item)
	End If

	SCREEN.Proc "parent.Set_memsub", ""

	If SCREEN.GetMapName(1) = "IB498900" Then
		SCREEN.Proc "parent.parent.Init_Object", "1"
	End If

End If

_AW_ONENDSUB_AW_
}



