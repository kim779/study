RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB401800"

Function GetToday()
	YY = Year(Date)
	MM = Month(Date)
	If Len(MM) = 1 Then
		MM = "0" & MM
	End If
	DD = Day(Date)
	If Len(DD) = 1 Then
		DD = "0" & DD
	End If
	GetToday = YY & MM & DD
End Function

Sub send_sise_all(GUBN)
	Dim code, fogb, rsymb, acnm
	dbx.Text = dbx.Text & ed_focod.data&"ALL:"&GUBN
	code = Left(ed_focod.Data, 1)
	If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
		fogb = 101
		rsymb = "30301"
		OBJ_sise.SetObject("IB4018X1")
		OBJ_info.SetObject("IB4018X5")

	ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C" Then
		fogb = 102
		rsymb = "40301"
		OBJ_sise.SetObject("IB4018X2")
		OBJ_info.SetObject("IB4018X6")
	End If


	HNAM.Data = SCREEN.GetName (fogb, ed_focod.Data, 0)
	ed_focod.Trigger "ed_focod", True
	ed_focod.Trigger rsymb, True
	ed_focod.Trigger rsymb, False
	SYSTEM.SetHistory rsymb, ed_focod.Data
	SYSTEM.SetHistory "ed_focod", ed_focod.Data

	OBJ_sise.Send
	OBJ_info.Send
	OBJ_chart.Send
End Sub

Function BoolToStr(bVal)
	BoolToStr = "0"
	If bVal=True Then
		BoolToStr = "1"
	End If
End Function

Function StrToBool(sVal)
	StrToBool = True
	If sVal="0" Then
		StrToBool = False
	End If
End Function


Sub p_write_ini()
	If SCREEN.CreateObject("info") Then
		INFO.PushData LOGIN.Name, myFILE, myMAP, "rd_type1", BoolToStr(rd_type1.Checked)
		INFO.PushData LOGIN.Name, myFILE, myMAP, "rd_type2", BoolToStr(rd_type2.Checked)
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
		rd_type2.Checked = StrToBool(INFO.PopData(LOGIN.Name, myFILE, myMAP, "rd_type2"))
		rd_type1.Checked = StrToBool(INFO.PopData(LOGIN.Name, myFILE, myMAP, "rd_type1"))

		If rd_type1.Checked=False And rd_type2.Checked=False Then
			rd_type1.Checked = True
		End If

		If rd_type1.Checked Then
		OBJ_chart.SetObject "IB401801"
		ElseIf rd_type2.Checked Then
			OBJ_chart.SetObject "IB401802"
		End If
	End If
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB999923
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call p_read_ini()
OBJ_chart.Send

_AW_ONENDSUB_AW_
