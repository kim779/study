_AW_SCRIPT_AW_(BUTTON9)
_AW_ONCLICK_AW_
Dim c_dt, dt, t_dt, cYear, cMonth, cDay, tmp_dt, tmpDt2
dt = gettoday()
tmpDt2 = getDateSerial(o_date.Data)
c_dt = DateAdd("d", 1, tmpDt2)

cYear = Year(c_dt)
cMonth = Month(c_dt)

If Len(Trim(cMonth)) = 1 Then
	cMonth = "0" & cMonth
End If

cDay = Day(c_dt)

If Len(Trim(cDay)) = 1 Then
	cDay = "0" & cDay
End If

tmp_dt = cYear & cMonth & cDay

If CLng(tmp_dt) > CLng(dt) Then
	Exit Sub
End If

For ii = 1 To 6
	If Weekday(c_dt) = "1" Or Weekday(c_dt) = "7" Then
		c_dt = DateAdd("d", 1, CDate(c_dt))
	Else
		Exit For
	End If
Next

cYear = Year(c_dt)
cMonth = Month(c_dt)

If Len(Trim(cMonth)) = 1 Then
	cMonth = "0" & cMonth
End If

cDay = Day(c_dt)

If Len(Trim(cDay)) = 1 Then
	cDay = "0" & cDay
End If

o_date.Data = cYear & cMonth & cDay

OBJ_chart.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


