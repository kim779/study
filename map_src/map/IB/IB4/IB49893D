_AW_ONDECLARE_AW_
Sub showPopup()
	SYSTEM.Push "IB49893J_OK" , "N"
	SCREEN.CreateWindow 2, "IB49893J /t/s/p5", ""
	Dim tempYN
	tempYN = SYSTEM.pop ("IB49893J_OK")
	If  Trim(tempYN) = "Y" Then
		SCREEN.Proc "parent.Send_FJ_OBJ", ""
	End If
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Hsiz = 44
LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(Pwd.Data))
Pwd.Data = "HEAD"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	'MsgBox "펀드코드 : " & Trim(IvstfndCode.Data) & " 고난도 : " & CmplxPdtYn.Data & " 고령자 : "& AgedYn.Data & " 부적합 : "& SubCmptTrdTp.Data

	If Trim(screenflag.Data) = "4989" Then
		If CmplxPdtYn.Data = "N" And  AgedYn.Data = "N" And SubCmptTrdTp.Data = "N" Then
			SCREEN.Object("parent.b_send").Enable = True
		Else
			SYSTEM.Push "IB49893E_OK" , "N"
			SCREEN.CreateWindow 2, "IB49893E /t/s/p5", ""

			Dim tempYN
			tempYN = SYSTEM.pop ("IB49893E_OK")
			If  Trim(tempYN) = "Y" Then
				SCREEN.Object("parent.Fund_Reserve_prc_text").Visible = True
				SCREEN.Object("parent.Fund_Reserve_prc").Visible = True
				SCREEN.Object("parent.Fund_Reserve_prc_won").Visible = True
				SCREEN.Object("parent.b_send").Enable = True
			Else
				SCREEN.Object("parent.Fund_Reserve_prc_text").Visible = False
				SCREEN.Object("parent.Fund_Reserve_prc").Visible = False
				SCREEN.Object("parent.Fund_Reserve_prc_won").Visible = False
				SCREEN.Object("parent.b_send").Enable = False
			End If
		End If

	ElseIf Trim(screenflag.Data) = "4989A" Then '펀드매수 임의식
		If CmplxPdtYn.Data = "N" And AgedYn.Data = "N" And SubCmptTrdTp.Data = "N" Then
			SCREEN.Proc "parent.Send_f","" '기존 매수프로세스 진행
		Else
			showPopup()
			'MsgBox "임의식 숙려제도 팝업"'팝업
		End If

	ElseIf Trim(screenflag.Data) = "4989B" Then '펀드매수 적립식

		Dim tmpOpnDt,tmpIssDt

		tmpOpnDt = SCREEN.Object("parent.parent.list_obj.SOFFQ250_OBJ.OUTPUT3").Data
		tmpIssDt = SCREEN.Object("parent.parent.list_obj.SOFFQ250_OBJ.OUTPUT26").Data
		'MsgBox "tmpOpnDt: "& tmpOpnDt & "tmpIssDt : " & tmpIssDt
		If CmplxPdtYn.Data = "N" Then

			If AgedYn.Data = "N" And SubCmptTrdTp.Data = "N" Then '기존 매수프로세스 진행
				SCREEN.Proc "parent.Send_f",""

			Else '적정성원칙 고령자 부적합 경우 -> 2021.08.10 이후 개설여부

				If CLng(tmpOpnDt) >= 20210810 Then
					If Trim(tmpIssDt) <> "" Then '최초 매수내역 체크
						SCREEN.Proc "parent.Send_f",""
					Else
						showPopup()
						'MsgBox "부적합 적립식 숙려제도 팝업 "'팝업
					End If
				Else
					SCREEN.Proc "parent.Send_f",""
				End If
			End If

		Else '고난도 상품이면 2021.05.10 이후 개설여부
			If CLng(tmpOpnDt) >= 20210510 Then
				If Trim(tmpIssDt) <> "" Then '최초 매수내역 체크 없으면 00000000
					SCREEN.Proc "parent.Send_f",""
				Else
					showPopup()
					'MsgBox "고난도 적립식 숙려제도 팝업 "'팝업
				End If

			Else
				SCREEN.Proc "parent.Send_f",""
			End If
		End If

	End If

Else
	If Trim(LEDGER.Ecod) <> "3669" Then
		alert_msg(Trim(LEDGER.emsg))
	End If
End If

