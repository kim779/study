	Dim tmp1, tmp2, tmp3, tmp4
	S44310.Row = 1
	tmp1 =  S44310.GetGridCell(S44310.Row, 9)
	S44310.Row = 2

	If (Trim(tmp1) = "") Then
		tmp1 = 0
	End If

	tmp2 =  S44310.GetGridCell(S44310.Row, 9)
	If (Trim(tmp2) = "") Then
		tmp2 = 0
	End If
	tmp3 = tmp1 - tmp2

	If ( tmp3 > 0 ) Then
		tmp4 = "+" & tmp3
	Else
		tmp4 = tmp3
   	End If

	If tmp4 <> 0 Then
		S44310.SetGridCell 1, 10, tmp4
	End If

End Sub

