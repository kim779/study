Dim dmsg
Dim sCode
Dim tempYN,tempYN2

sCode = SYSTEM.Pop("4989_FUNDCODE")
SYSTEM.Push "4989_FUNDCODE", ""

If(Len(sCode) > 0) Then
	dmsg = "fundcd" & vbTab & sCode  & vbLf
	'SCREEN.CreateWindow 3, "IB49892N /s//t/d/p5", dmsg
	'SCREEN.CloseWindow
	SYSTEM.Push "IB49892N_JOIN", "" '가입버튼을 눌렀다면 ChangeCode에서 SOFFQ111에 정보를 받아
								'IB498970에서 get3month 응답을 받고
								'OBJ2에서 joinFund를 호출해 가입을 시작한다.
	SYSTEM.Push "IB49892N_OK" , "" '종목 더블클릭
	SCREEN.CreateWindow 2, "IB49892N /p5 /d", dmsg
	tempYN = SYSTEM.pop ("IB49892N_OK")
	tempYN2 = SYSTEM.pop ("IB49892N_JOIN")
	If Len(Trim(tempYN)) > 0 Or Len(Trim(tempYN2)) > 0 Then
			SCREEN.CreateWindow 1, "IB498700 /t/s/p5/", ""
			SCREEN.CloseWindow
		Exit Sub
	End If

End If
