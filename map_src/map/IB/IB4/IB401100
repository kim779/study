	End If
'	ctl0.RequestData 0,0
End Sub

_AW_ONSEND_AW_
Dim code, name

code = Left(S30301.Data, 1)

If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
	name = SCREEN.GetName (101, S30301.Data, 0)
	If Trim(name) =  "" Then
		S30301.Data = ""
	Else
		If StrComp(save, Trim(S30301.Data), 1) <> 0 Then
			S30301.Trigger "ed_focod", True
			S30301.Trigger "30301", True
			SYSTEM.SetHistory "ed_focod", S30301.Data
			Query_Chart()
			OBJECT0.Send
			save = Trim(S30301.Data)
		End If
	End If
Else
	SCREEN.ClearAll 2, 0
	SCREEN.OnSend = False
End If

