Sub ProcSetData(Data)
	ArrData = Split(Data, "|")

	If Trim(arrdata(5)) = "" Or Trim(arrdata(6)) = "" Then
		Exit Sub
	End If

	Select Case Fix(arrdata(0))
		Case 9
			S65500.SetGridCell 1, 2, Int(arrdata(5)/10000000)
			S65500.SetGridCell 1, 3, Int(arrdata(6)/10000000)
		Case 8
			S65500.SetGridCell 1, 4, Int(arrdata(5)/10000000)
			S65500.SetGridCell 1, 5, Int(arrdata(6)/10000000)
		Case 0
			S65500.SetGridCell 1, 6, Int(arrdata(5)/10000000)
			S65500.SetGridCell 1, 7, Int(arrdata(6)/10000000)
		Case 3
			S65500.SetGridCell 1, 8, Int(arrdata(5)/10000000)
			S65500.SetGridCell 1, 9, Int(arrdata(6)/10000000)
		Case 1
