Sub Set_Grid_State()
	Dim nIndex

	grid_state = SCREEN.Object("main.COMBO0").data

	If grid_state = "1" Then		'매도
		For nIndex= 2 To S63500.Columns Step 2
			S63500.SetColumnVisible nIndex, True
			S63500.SetColumnVisible nIndex + 1, False
'			SYSTEM.Trace "nIndex = " & nIndex
		Next

	ElseIf grid_state = "2" Then	'매수
		For nIndex= 3 To S63500.Columns Step 2
			S63500.SetColumnVisible nIndex -1, False
			S63500.SetColumnVisible nIndex, True
'			SYSTEM.Trace "nIndex = " & nIndex
		Next
	End If

End Sub


Sub Get_Grid_State()

	If S63500.IsColumnVisible(2) = True Then	'매도
		grid_state = "1"
	ElseIf S63500.IsColumnVisible(3) = True Then	'매수
		grid_state = "2"
	End If

End Sub


Sub Trace(strDes)
	SYSTEM.Trace "+++" & strDes & "+++grid_state===>" & grid_state
End Sub

