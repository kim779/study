_AW_ONDECLARE_AW_
Function check_sp( code )

Dim a, b

a = Left( code, 1 )
b = Right( code , 1 )

'If a <> "4" Or b <> "S" Then '3년 10년 국채 상품 스프레드 종목 코드는 끝자리가 0
If a <> "4" And a <> "D"  Then
	check_sp = Null
Else
	check_sp = code
End If

End Function

