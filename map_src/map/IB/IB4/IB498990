RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim read_f
'== 계좌명, 비밀번호 설정
Sub Set_account()
	ACNM.Data = AN50.Name
	zPwd.Data = AN50.Password
	If Trim(AN50.Data) = "" Then
		AN50.SetFocus
		Exit Sub
	End If
	If read_f = 1 Then
		If Trim(zIvstfndCode.Data) <> "" Then
			sub_account.SetItems("")
			memsub.Data = ""
			OBJECT0.Proc "send_f", ""
		End If
	Else
		read_f = 1
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If
	SCREEN.RSend 0
End Sub

Sub Set_memsub()
	If Trim(memsub.Data) <> "" Then
		sub_account.Data = memsub.Data
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
zStrDt.SetFormat "9999/99"
zEndDt.SetFormat "9999/99"
read_f = 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim dat, ii, zero, kk

LEDGER.Fkey = "5"
SCREEN.OnSend = False
dat = COM_day.Text
If Len(COM_day.text) = "1" Then
	dat = "0" & dat
End If

zAbkpDt.Data = dat

zMtrsfEndDt.Data = Left(zEndDt.data,6) & dat
zMtrsfSrtDt.Data = Left(zStrDt.data,6) & dat
lBnkAmtrAmt.DATA = "+" & l_zeropad(E_AMT)
account.Data = AN50.Data & sub_account.Data

If CheckInput(AN50, zPwd) = False Then
	Exit Sub
