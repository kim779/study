Function chkmidtype(strmid)
chkmidtype = False
Dim accList, a, b, g, idx, d
Dim accnInfo, accnNo, accnNm, accnNick, accnStatus, insertFlag

accList = CONTROL0.GetTypeData("4", "")
a = 1
idx = 1

Do While a < Len(accList)
	b = InStr(a, accList, vbLf, 0)

	If b = 0 Then
		Exit Do
	End If

	g = Mid(accList, a, b-a )

	a = b + 1
	d = Mid(g, 4, 2)

	accnInfo = Split(g, "|")

	accnNo = accnInfo(0)

	'계좌별명이 길 경우 본인여부가 없을수도 있음.
	If UBound(accnInfo) < 2 Then
		accnStatus = ""
	Else
		accnStatus = accnInfo(2)
	End If

	insertFlag = True

'	SYSTEM.Trace accnNo & " => "
	'고객용일때 본인계좌만 미등록계좌에 보이도록 수정
	'단, 투자자문사때는 전부 등록.
	'단, 랩계좌는 추가가 안되도록 수정
	If SYSTEM.ConnectBy = 0 Then '고객용
		If Trim(accnStatus) = "1" Or Trim(accnStatus) = "5" Then	'본인계좌or본인법인
			insertFlag = True
		Else
			insertFlag = False
		End If

		If LOGIN.Otpf = 1 Then
			insertFlag = True
		End If
	End If

	If chkNumericData(accnStatus) = True Then
		If CLng(accnStatus) = 0 Or CLng(accnStatus) = 1 Or CLng(accnStatus) = 5 Then '본인계좌or본인법인
			insertFlag = True
		Else
			insertFlag = False
		End If
	Else
		insertFlag = False
	End If

	If (d = strmid) And insertFlag = True Then
		chkmidtype = True
	End If
Loop


End Function


