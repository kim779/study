Function GetValue(Str)
	GetValue = 0
	If Len(Trim(Str)) = 0 Then
		Exit Function
	End If
	GetValue = CLng(Str)
'	SYSTEM.trace "GetValue str ==> " & str
'	SYSTEM.Trace "Getvalue ==> " & GetValue
End Function
'-----------------------------------------------------------------------
Sub ProcSetData(Data)
	min = CLng(SCREEN.Object("main.COMBO0").data)' * 60

	ArrData = Split(Data, "|")

'	SYSTEM.Trace "ArrData(0)[" & ArrData(0) & "]"

	'ADateTime = GetTime(ArrData(0), min / 60)
	If min = 60 Then
		ADateTime = GetTime(ArrData(0), min * 1000 / 6)
	Else
		ADateTime = GetTime(ArrData(0), min * 100)
	End If

'	SYSTEM.Trace "ADateTime[" & ADateTime & "]GetGridCell[" & Trim(GRID0.GetGridCell(1, 1)) & "]"

	IsFlag = False
	If ADateTime <> Trim(S103310.GetGridCell(1, 1)) Then
		'실시간 데이터이므로 ADateTime 값이 현재의 시간보다 작지 않음.
		'만약 작다면 현재값에 포함시킴
		If Trim(S103310.GetGridCell(1, 1)) = "" Then
			S103310.InsertRow 0
			IsFlag = True
		ElseIf ADateTime - Trim(S103310.GetGridCell(1, 1)) > 0 Then
			S103310.InsertRow 0
			IsFlag = True
		End If
	End If

	Close = ArrData(4)

	Diff = ArrData(5)
	CVol = GetValue(ArrData(6))
	GVol = GetValue(ArrData(7))
	OpenInt = ArrData(8)
	OpenIntDiff = ArrData(9)


'	SYSTEM.Trace "Clsoe " & Close

	If IsFlag Then

		If Left(Trim(CStr(Diff)),1) = "1" Or Left(Trim(CStr(Diff)),1) = "2"  Then
			If Left(Trim(CStr(Close)),1) <> "+" Then
				Close = "+" & Close
			End If
		ElseIf Left(Trim(CStr(Diff)),1) = "4" Or Left(Trim(CStr(Diff)),1) = "5"  Then
			If Left(Trim(CStr(Close)),1) <> "-" Then
				Close = "-" & Close
			End If
		End If

		S103310.SetGridCell 1, 1, ADateTime				'시간
		S103310.SetGridCell 1, 2, Close					'시가
		S103310.SetGridCell 1, 3, Close					'고가
		S103310.SetGridCell 1, 4, Close					'저가
		S103310.SetGridCell 1, 5, Close					'종가
		S103310.SetGridCell 1, 6, Diff					'전일대비
		S103310.SetGridCell 1, 7, CVol					'체결량
		S103310.SetGridCell 1, 8, GVol					'거래량
		S103310.SetGridCell 1, 9, OpenInt				'미결제

		If OpenIntDiff > 0 Then
			OpenIntDiff = "+" & OpenIntDiff
		End If

		S103310.SetGridCell 1, 10, OpenIntDiff			'미결제증감
		S103310.SetGridCell 1, 11, ArrData(10)
		S103310.SetGridCell 1, 12, ArrData(11)

	'	SYSTEM.Trace "현물가 ==> " & ArrData(11)
	Else
		High = S103310.GetGridCell(1, 3)

		FirData = ArrData(4)
'		SYSTEM.Trace "처음 data ==> " & Close
		Close = Abs(FirData)
		High = Abs(High)

'		SYSTEM.Trace "high close => " & Close
		If High < Close Then
			If Left(Trim(CStr(Diff)),1) = "1" Or Left(Trim(CStr(Diff)),1) = "2"  Then
				If Left(Trim(CStr(FirData)),1) <> "+" Then
					FirData = "+" & FirData
				End If
			ElseIf Left(Trim(CStr(Diff)),1) = "4" Or Left(Trim(CStr(Diff)),1) = "5"  Then
				If Left(Trim(CStr(FirData)),1) <> "-" Then
					FirData = "-" & FirData
				End If
			End If
			S103310.SetGridCell 1, 3, FirData
		End If

		Low = S103310.GetGridCell(1, 4)
		Close = Abs(FirData)
		Low = Abs(Low)

'		SYSTEM.Trace "저가 close => " & Close
		If Low > Close Then
			If Left(Trim(CStr(Diff)),1) = "1" Or Left(Trim(CStr(Diff)),1) = "2"  Then
				If Left(Trim(CStr(FirData)),1) <> "+" Then
					FirData = "+" & FirData
				End If
			ElseIf Left(Trim(CStr(Diff)),1) = "4" Or Left(Trim(CStr(Diff)),1) = "5"  Then
				If Left(Trim(CStr(FirData)),1) <> "-" Then
					FirData = "-" & FirData
				End If
			End If
			S103310.SetGridCell 1, 4, FirData
		End If

		If Left(Trim(CStr(Diff)),1) = "1" Or Left(Trim(CStr(Diff)),1) = "2"  Then
			If Left(Trim(CStr(FirData)),1) <> "+" Then
				FirData = "+" & FirData
			End If
		ElseIf Left(Trim(CStr(Diff)),1) = "4" Or Left(Trim(CStr(Diff)),1) = "5"  Then
			If Left(Trim(CStr(FirData)),1) <> "-" Then
				FirData = "-" & FirData
			End If
		End If
'		SYSTEM.Trace "종가 close => " & Close

		S103310.SetGridCell 1, 5, FirData
		S103310.SetGridCell 1, 6, Diff

		BefGVol = GetValue( S103310.GetGridCell(2, 8) )
		CVol = GVol - BefGVol

		S103310.SetGridCell 1, 7, CVol
		S103310.SetGridCell 1, 8, GVol
		S103310.SetGridCell 1, 9, OpenInt

		BefOpenInt = GetValue( S103310.GetGridCell(2, 9) )
		OpenIntDiff = OpenInt - BefOpenInt

		If OpenIntDiff > 0 Then
			OpenIntDiff = "+" & OpenIntDiff
		End If
		S103310.SetGridCell 1, 10, OpenIntDiff
		S103310.SetGridCell 1, 11, ArrData(10)
		S103310.SetGridCell 1, 12, ArrData(11)

'		SYSTEM.Trace "현물가 222==> " & ArrData(11)
	End If

	g_ArrInput(1) = ADateTime
End Sub
