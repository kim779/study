_AW_ONDECLARE_AW_
Function r_code( idx )

Dim mList(12)
Dim yList(15)
Dim code, name, ycode, yidx

Dim curDate
Dim curYear, curMonth

curDate = Date
curYear = Year(curDate)
curMonth = Month(curDate)

yList(1) = "K" '2015
yList(2) = "L" '2016
yList(3) = "M" '2017
yList(4) = "N" '2018
yList(5) = "P" '2019
yList(6) = "Q" '2020
yList(7) = "R" '2021
yList(8) = "S" '2022
yList(9) = "T" '2023
yList(10) = "V" '2024
yList(11) = "W" '2025
yList(12) = "6" '2026
yList(13) = "7" '2027
yList(14) = "8" '2028
yList(15) = "9" '2029

mList(1) = "1"
mList(2) = "2"
mList(3) = "3"
mList(4) = "4"
mList(5) = "5"
mList(6) = "6"
mList(7) = "7"
mList(8) = "8"
mList(9) = "9"
mList(10) = "A"
mList(11) = "B"
mList(12) = "C"

yidx = CLng(curYear)-"2015"
ycode = idx & yList(yidx+1)

For i = 1 To 12
	code = ycode & mList(i)
	code = code & "000"

	name = SCREEN.GetName( 127, code, 0 )
	If( Len(Trim(name)) <> 0 ) Then
		r_code	= code
		Exit For
	End If
Next

End Function

Sub Set_date()

SCREEN.Object("OBJECT0.103304").Data = date_a.Data
SCREEN.Object("OBJECT1.108305").Data = date_a.Data

End Sub

Sub req_data()

Dim myTime, myDate
myTime = Time
myDate = Date

Dim curDate
curDate = CStr(Year(myDate)) & CStr(Month(myDate)) & CStr(Day(myDate))

'MsgBox "curDate " & curDate
'MsgBox "date " & CLng(date_a.Data)
If CLng(curDate) <= CLng(date_a.Data) Then
	If Hour(myTime) < 9 Then
		OBJECT0.ClearAll 0
		OBJECT1.ClearAll 0
		OBJECT1.Send
		Exit Sub
	End If
End If

SCREEN.Object("OBJECT0.103304").Data = date_a.Data

OBJECT0.Send
OBJECT1.Send

End Sub

_AW_ONSTART_AW_
