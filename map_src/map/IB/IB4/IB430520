_AW_ONDECLARE_AW_
Private Sub loadUserConfig()
	If SCREEN.CreateObject("Info") Then
		str1  = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "DH322500", "GUBN"))
		If str1 = "" Then
		    	saveUserConfig()
		Else
			gubn.Data = str1
			Select Case gubn.Data
			Case "1"
				RADIO1.Checked = True
			Case "2"
				RADIO0.Checked = True
			Case Else
			End Select

			stype.data = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "DH322500", "STYPE"))
			If stype.Data = "1" Then
				danw.Text = "계약"
			Else
				danw.Text = "십만원"
			End If
		End If
	End If
End Sub

Private Sub saveUserConfig()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, "userconf.ini", "DH322500", "GUBN",  gubn.Data
		INFO.pushData LOGIN.Name, "userconf.ini", "DH322500", "STYPE",  stype.Data
	End If
End Sub

Private Sub Obj_Send()
    saveUserConfig()
    SCREEN.Send 0
End Sub


