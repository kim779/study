'*****************************************************************
'NAME : P_CALL_TRIGGER_JM_WINDOW
'DESC : 주문 필드 trigger 처리
'*****************************************************************
Private Sub P_CALL_TRIGGER_JM_WINDOW()
	Dim Is_temp

	JMDG.Data = S016301.GetGridCell(S016301.Row, 17)

	ls_temp = S016301.GetGridCell(S016301.Row , 1)
	If Trim(CODX.Data) <> Trim(ls_temp) Then
'		JMDG.Trigger "JMDG", True
		CODX.Data = Trim(ls_temp)
		CODX.Trigger "CODX", True
		CODX.Push("CODX")
	End If
End Sub

