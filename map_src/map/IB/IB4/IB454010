RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'-----------------------------------------------------------------------
Sub SetFutData()
	'0:FutCd, 1:FutExpiDate
	ArrData = Array("", "")
	For i = 1 To GRID0.Rows
		ArrData(0) = Trim(GRID0.GetGridCell(i, 1))
		If Len(ArrData(0)) = 0 Then
			Exit For
		End If
		If ArrData(0) = cb_FutCd.Data Then
			ArrData(1) = Trim(GRID0.GetGridCell(i, 4))
			Data = Join(ArrData, "|")
			SCREEN.Proc "main.SetFutData", Data
			Exit For
		End If
	Next
End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Data = ""
For i = 1 To GRID0.Rows
	FutCd = Trim(GRID0.GetGridCell(i, 1))
	FutNm = Trim(GRID0.GetGridCell(i, 2))
	If Len(FutCd) = 0 Then
		Exit For
	End If
	Data = Data & vbTab & FutCd & FutNm
Next

cb_FutCd.SetItems(Data)
cb_FutCd.Index = 0
cb_FutCd.Push("")

SetFutData

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(cb_FutCd)
_AW_ONCHANGE_AW_
SetFutData
SCREEN.Proc "main.SendData", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(DATE)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



