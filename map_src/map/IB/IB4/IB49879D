_AW_ONDECLARE_AW_
Function check()
	check = False
	Dim i
	For i = 1 To 5

		If SCREEN.Object("rd" & i & "2").Checked Then '아니오 대답할 경우
			SCREEN.CreateWindow 2, "IB4987Q" & i & " /p5 /d", ""
			Exit Function
		ElseIf SCREEN.Object("rd" & i & "1").Checked = False And SCREEN.Object("rd" & i & "2").Checked = False Then
			SCREEN.CreateWindow 2, "IB4987Q6 /p5 /d", ""
			Exit Function
		End If
	Next

	check = True
End Function

