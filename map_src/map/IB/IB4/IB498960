_AW_ONDECLARE_AW_
Public Today
Today = getCurrDay()

'== 계좌명, 비밀번호 설정
Sub Set_account()
	zPwd.Data = SCREEN.Object("main.AN55").Password
	If Trim(SCREEN.Object("main.AN55").Data) = "" Then
		SCREEN.Object("main.AN55").SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
