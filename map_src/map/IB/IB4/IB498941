_AW_ONDECLARE_AW_
Function Error_check()
	Error_check = False
	If Trim(SCREEN.Object("main.AN55").Data) = "" Then
		SCREEN.Object("main.GUIDE").text = "펀드계좌번호(ex.001-53-123456)를 확인하여 주십시오."
		SCREEN.Object("main.AN55").SetFocus
		Exit Function
	End If
	Error_check = True
End Function

Function Error_chk_jumn()

	Dim msg
	msg = ""
	If Trim(SCREEN.Object("main.AN55").Data) = "" Then
		msg = "펀드계좌번호(ex.001-53-123456)를 확인하여 주십시오."
		MsgBox msg
		SCREEN.Object("main.AN55").SetFocus
		Exit Function
	End If

	If Trim(zIvstfndCode.Data) = "" Then
		msg = "매도할 펀드를 선택하신 후 신청해 주세요."
		MsgBox msg
		Exit Function
	End If

	Select Case zRpPrslPtnTp.Data
		Case 1 : '금액
			If Is_numeric(lBuyOrdAmt.Data) = False Then
				msg = "매도금액을 입력해 주세요."
				MsgBox msg
				lBuyOrdAmt.SetFocus
				Exit Function
			End If
'			ElseIf Int(sellamt.Data) < Int(lBuyOrdAmt.Data) Then
'				msg = "가능금액 보다 신청금액이 큽니다. 가능금액이내로 입력해 주세요."
'				MsgBox msg
'				lBuyOrdAmt.SetFocus
'				Exit Function
'

		Case 2 : '좌수

			If Is_numeric(lBuyOrdAmt.Data) = False Then
				msg = "매도수량을 입력해 주세요."
				MsgBox msg
				lBuyOrdAmt.SetFocus
				Exit Function
			ElseIf Int(balQty.Data) < Int(lBuyOrdAmt.Data) Then
				msg = "가능수량 보다 신청수량이 큽니다. 가능수량이내로 입력해 주세요."
				MsgBox msg
				lBuyOrdAmt.SetFocus
				Exit Function
			End If

		Case 3 : lBuyOrdAmt.Enable = False : '전액

	End Select


	Error_chk_jumn = True
End Function

Sub Order_popup()

	'SCREEN.Object("parent.GUIDE").Clear
	'zPwd.Data = SCREEN.Object("main.zPwd").Data
	If Error_chk_jumn() = False Then
		Exit Sub
	End If

	Dim msg

	msg = "o_acno" & vbTab & Trim(zAcntNo.Data) & vbLf &_
		"o_jongmokCode" & vbTab & Trim(SCREEN.Object("main.fundcode").Data) & vbLf &_
		"o_hnam" & vbTab & Trim(FundName.data) & vbLf &_
		"o_gubn" & vbTab & Trim(zRpPrslPtnTp.Text) & vbLf &_
		"o_jprc" & vbTab & Trim(lBuyOrdAmt.Data) & vbLf

		SCREEN.CreateWindow 2, "IB49894A /p5 /d", msg

	If SYSTEM.Pop("fund_mado_order") <> "OK" Then
		Exit Sub
	Else
		SCREEN.Send 0
	End If

End Sub


Sub typechk()

	Select Case zRpPrslPtnTp.Data
		Case 1 : lBuyOrdAmt.Enable = True :
			OUTPUT5.Visible = False
			LABEL7.Text = "매도금액"
			LABEL27.Text = "원"
			lBuyOrdAmt.Data = ""
		Case 2 : lBuyOrdAmt.Enable = True :
			OUTPUT5.Visible = False
			LABEL7.Text = "매도수량"
			LABEL27.Text = "좌"
			lBuyOrdAmt.Data = ""
		Case 3 : lBuyOrdAmt.Enable = False :
			OUTPUT5.Data = "전액"
			OUTPUT5.Visible = True
			lBuyOrdAmt.Data = ""
			LABEL7.Text = "매도금액"
	End Select

End Sub

