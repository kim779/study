	If grid.Column = 14 Then
		ed_focod.data = Mid(grid.GetGridCell(grid.Row,1),2)
		ed_focod.Trigger "3006"&vbTab&"ed_focod",True
	ElseIf grid.Column = 20 Then
		ed_focod.data = Mid(grid.GetGridCell(grid.Row,19),2)
		ed_focod.Trigger "3006"&vbTab&"ed_focod",True
	Else
		Exit Sub
	End If
End If
