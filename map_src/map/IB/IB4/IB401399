Dim i
For i = 1 To grid.Rows
	grid.SetPRgb i, 17, 200
	If Trim(atmg.Data) = Trim(grid.GetGridCell(i,17)) Then
		grid.SetPRgb i, 17, 245

		grid.Index = i+4
		grid.SetFocus
		grid.Index = i-1
	End If
Next

