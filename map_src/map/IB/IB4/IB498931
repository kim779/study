_AW_ONDECLARE_AW_
Function Error_check()
	Error_check = False
	If Len(Trim(SCREEN.Object("main.AN55").Data)) <> 11 Then
		SCREEN.Object("main.GUIDE").text = "펀드계좌번호(ex.001-53-123456)를 확인하여 주십시오."
		SCREEN.Object("main.AN55").SetFocus
		Exit Function
	End If
	Error_check = True
End Function

Function Error_chk_jumn()
	Error_chk_jumn = False
	Dim msg
	If Trim(SCREEN.Object("main.AN55").Data) = "" Then
		msg = "펀드계좌번호(ex.001-53-123456)를 확인하여 주십시오."
		MsgBox msg
		SCREEN.Object("main.AN55").SetFocus
		Exit Function
	End If

	If Trim(zIvstfndCode.Data) = "" Then
		msg = "매수할 펀드를 선택하신 후 신청해 주세요."
		MsgBox msg
		Exit Function
	End If

	If Len(Trim(lOrdAbleAmt.text)) =  0 Then
		msg = "매수가능금액이 없습니다."
		MsgBox msg
		Exit Function
	End If

	If Is_numeric(lBuyOrdAmt.Data) = False Then
		msg = "매수신청금액을 입력해 주세요."
		MsgBox msg
		lBuyOrdAmt.SetFocus
		Exit Function
	End If

	If Int(lOrdAbleAmt.Data) <  Int(lBuyOrdAmt.Data) Then
		msg = "매수가능금액 보다 신청금액이 큽니다. 매수가능금액 이내로 입력해주세요."
		MsgBox msg
		Exit Function
	End If

	Error_chk_jumn = True
End Function

