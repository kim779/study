Sub clear_check(row)
	Dim ii
	For ii = 1 To GRID0.Rows
		If ii = row Then
			GRID0.SetGridCell ii, 1, "1"
		Else
			GRID0.SetGridCell ii, 1, "0"
		End If

	Next
