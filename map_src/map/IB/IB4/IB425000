_AW_ONDECLARE_AW_
Dim bChangeMap, bChangeUTab, bChangeUTab0
Dim per1,per2,udata,ddata,uTime,dtime
bChangeMap = False
bChangeUTab = False
bChangeUTab0 = False

Sub p_write_ini(key, val)
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB425000", key, val
	End If
End Sub

Function p_read_ini(key)
	If SCREEN.CreateObject("INFO") Then
		p_read_ini = INFO.PopData(LOGIN.Name, "userconf.ini","IB425000", key)
	End If
End Function

Sub Initialize()
	mapName = p_read_ini("LASTMAP")
	SYSTEM.Trace "mapName"&mapName
	If SCREEN.GetMapName(0)<>mapName And Len(mapName)=8 Then
		bChangeMap = True
	End If

	idx = p_read_ini("UTAB")
	If Len(idx)>0 Then
		Utab.Id = idx
		bChangeUTab = True
	Else
		obj.SetObject "IB425070"
	End If

	idx = p_read_ini("UTAB0")
	If Len(idx)>0 Then
		UTAB0.Id = idx
		bChangeUTab0 = True
	Else
		obj1.SetObject "IB425020"
	End If

	If bChangeMap Or bChangeUTab Or bChangeUTab0 Then
		SCREEN.SetTimer 1, True
	End If
End Sub

Sub UtabChange()
	Select  Case (Utab.Id)
		Case "0" : obj.SetObject "IB425010"	'-- 상세
		Case "1" : obj.SetObject "IB425020"	'-- 차트
		Case "2" : obj.SetObject "IB425030"	'-- 비교차트
		Case "3" : obj.SetObject "IB425040"	'-- 체결1
		Case "4" : obj.SetObject "IB425050"	'-- 체결2
		Case "5" : obj.SetObject "IB425060"	'-- 일간
		Case "6" : obj.SetObject "IB425070" '-- 기초
	End Select
	p_write_ini "UTAB", Utab.Id
	obj.Send
End Sub

Sub Utab0Change()
	Select  Case (UTAB0.Id)
		Case "0" : obj1.SetObject "IB425010"	'-- 상세
		Case "1" : obj1.SetObject "IB425020"	'-- 차트
		Case "2" : obj1.SetObject "IB425030"	'-- 비교차트
		Case "3" : obj1.SetObject "IB425040"	'-- 체결1
		Case "4" : obj1.SetObject "IB425050"	'-- 체결2
		Case "5" : obj1.SetObject "IB425060"	'-- 일간
		Case "6" : obj1.SetObject "IB425070" '-- 기초
	End Select
	p_write_ini "UTAB0", UTAB0.Id
	obj1.Send
End Sub



Sub Onalert()
	up.Data = S100381.Data&"단계 상한 적용"
	down.Data = S100382.Data&"단계 하한 적용"
	If Trim(S101273.data) <> "0" And Trim(S101273.data) <> "" Then
		If Trim(S101274.Data) = "U" Then
			up.Data = S101273.Data&"단계 상한 예고"
			uTime = " "&Mid(S101275.Data,1,2)&":"&Mid(S101275.Data,3,2)
		ElseIf Trim(S101274.Data) = "D" Then
			down.Data = S101273.Data&"단계 하한 예고"
			dTime = " "&Mid(S101275.Data,1,2)&":"&Mid(S101275.Data,3,2)
		End If
	End If

	If Left(up.data,1) = "1" Then
		per1 = "(10%)"
	ElseIf(Left(up.data,1)) = "2" Then
		per1 = "(20%)"
	ElseIf(Left(up.data,1)) = "3" Then
		per1 = "(30%)"
	End If

	If Left(down.data,1) = "1" Then
		per2 = "(10%)"
	ElseIf(Left(down.data,1)) = "2" Then
		per2 = "(20%)"
	ElseIf(Left(down.data,1)) = "3" Then
		per2 = "(30%)"
	End If

	udata = Mid(up.data, 1,3) & per1 & Mid(up.Data, 5,5)
	ddata = Mid(down.data, 1,3) & per2 & Mid(down.Data, 5,5)

	tip.Data = "[주식선물 가격제한폭"&" "&udata&Trim(uTime)&" / "&ddata&Trim(dtime)&"]"
End Sub

