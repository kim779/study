Sub LoadAccounts()
	CompanyFlag = "0"
	FinanceTaxFlag = "0"
	Dim accList, ii, accn, acno, zACNM, acid, actp, idx, myAcntFlag, value, ownAcnt
	accList = Split(CX_DTS.GetTypeData ("4","1" ), vbLf, -1, vbTextCompare)  ''accoutcc 로 전계좌 불러오기 0->1
	'SYSTEM.Trace "ACC["&ACC&"/]kk["&SCREEN.Object(ACC).Data&"]"
	ownAcnt =  SCREEN.Object(ACC).Data
	For ii=0 To UBound(accList)
		accn = Trim(accList(ii))
		'MsgBox ii&":"&acc
		If Len(accn)>11 Then
			accn = Split(accn, "|", -1, vbTextCompare)
			acno = Trim(Mid(accn(0), 1, 11))
			zACNM = Mid(accn(0), 12)
			zACNM = Replace(zACNM, vbTab, "")
			zACNM = Trim(zACNM)
			acid = Trim(accn(1))
			actp = Mid(acno, 4, 2)
			myAcntFlag = accn(2)
			'SYSTEM.Trace "["&acno&"]/["&kk&"]"
			If acno = Trim(ownAcnt) Then

				'VIP전용화면으로 고객용으로만 조회가능
				'계좌플래그 2 또는 3 이면 랩계좌      법인계좌 타입 = 4
				'랩계좌 제외
				If chkNumericData(myAcntFlag) = True Then
				'	If CLng(myAcntFlag) = 0 Or CLng(myAcntFlag) = 1 Then
					value = myAcntFlag And 4    '랩계좌 2 와 And 연산
				    If value = 4 Then
						CompanyFlag = "1"
					End If
				End If
			End If
		End If
	Next

End Sub

