_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj.ClearAll 2
	isPwdChkYn.Text = ""

	If Len(Trim(AN1A.Data)) = 11 Then
		ACNM.Data = Trim(AN1A.Name)
		zPwd.Data = Trim(AN1A.Password)

		If SYSTEM.ConnectBy = 0 Then
			SCREEN.Proc "obj.send_f", ""
		Else
			If Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If

			SCREEN.Proc "obj_chkPwd.send_f", ""
		End If
	Else
		AN1A.SetFocus
		Exit Sub
	End If
End Sub

Sub send_f()
	If SYSTEM.ConnectBy = 0 Then
		SCREEN.Proc "obj.send_f", ""
	Else
		If Len(Trim(zPwd.Data)) < 4 Then
			Call guide_msg("비밀번호를 확인하여 주십시오.")
			zPwd.SetFocus
			Exit Sub
		End If

		'SYSTEM.Trace "isPwdChkYn = " & isPwdChkYn.Text
		If Trim(isPwdChkYn.Text) = "Y" Then
			'SYSTEM.Trace "1"
			SCREEN.Proc "obj.send_f", ""
		Else
			'SYSTEM.Trace "2"
			SCREEN.Proc "obj_chkPwd.send_f", ""
		End If
	End If
End Sub

Sub Oksend()
	SCREEN.Proc "obj.send_f", ""
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONCHARCHANGE_AW_
