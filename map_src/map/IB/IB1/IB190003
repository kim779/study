RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim ts

Sub query_accn( row )
	Dim num, name
	num = Trim(SCREEN.Object("main.gr_gp_list").GetGridCell( row, 3 ))
	name = Trim(SCREEN.Object("main.gr_gp_list").GetGridCell( row, 2 ))


	If Len(num) = 0 Or Len(name) = 0 Then ' 끝
		Call writeOpen()

		ts.writeLine(Time & " IB190003 query_accn 그룹에 포함된 모든계좌 조회 row = " & row)

		Dim ii, grNo, grName, accn, accnNm

		For ii = 1 To GRID0.Rows
			grNo = Trim(GRID0.GetGridCell(ii, 1))
			grName = Trim(GRID0.GetGridCell(ii, 2))
			accn = Trim(GRID0.GetGridCell(ii, 3))
			accnNm = Trim(GRID0.GetGridCell(ii, 4))

			If Trim(grNo) = "" Then
				Exit For
			End If

			ts.writeLine("    " & ii & " " & grNo & " " & grName & " " & accn & " " & accnNm)
		Next

		ts.writeLine(Time & " IB190003 query_accn end")
		ts.close()
		SCREEN.Proc "main.gp_accn_done",""
		Exit Sub
	End If

	curRow.Data = row

	EDIT0.Data = "00001"
	EDIT1.Data = "2"
	EDIT2.Data = "10"
	ed_gp_num.Data = num
	ed_gp_name.Data = name

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub writeOpen()
	Dim fso, data, parseData, userID, index, directory
	Const ForWriting = 8
	Set fso = CreateObject("Scripting.FileSystemObject")
	directory = SYSTEM.Home & "\user\LIST_" & getCurrDay() &".ini"

	If (fso.FileExists(directory)) = False Then
		fso.CreateTextFile directory, True
	End If

	Set ts = fso.OpenTextFile(directory, ForWriting)
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
GRID0.SetDataPosition 1
LEDGER.Rcnt = "0040"

'SYSTEM.Trace("rrrrrrrrrrrrrrrrrrrrrrr")

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	LEDGER.Fkey = "7"
	'GRID0.SetDataPosition(2)
	SCREEN.Send 0
Else
	curRow.Data = curRow.Data + 1
	query_accn(curRow.Data)
End If

