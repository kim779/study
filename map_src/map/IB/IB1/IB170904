_AW_ONDECLARE_AW_
Sub param_split()
	GRID0.Clear

	If cnt.Data > 0 Then
		Dim record, column, ii
		record = Split(Trim(param.Data), "#", -1)

		For ii = 1 To cnt.Data
			column = Split(record(ii), "|", -1)

			GRID0.SetGridCell ii, 1, Trim(column(0))
			GRID0.SetGridCell ii, 3, Trim(column(1))
		Next
	End If
End Sub

Sub showMap()
	Dim acc, accnt
	acc = Mid(Trim(GRID0.GetGridCell(GRID0.Row, 1)), 4, 2)
	accnt = Left(Trim(GRID0.GetGridCell(GRID0.Row, 1)), 11)

	SYSTEM.Push "IB170904_move_tab", acc
	SYSTEM.Push "IB170904_move_acc", accnt
	SCREEN.CloseWindow

'	SCREEN.Proc "parent.tab_change", acc
End Sub

_AW_ONSTART_AW_
Call param_split()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONDBLCLK_AW_
'SYSTEM.Trace "start"

'If GRID0.Rows < 1 Or Trim(GRID0.GetGridCell(GRID0.Row, 1)) = "" Then
