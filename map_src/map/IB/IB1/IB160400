_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password

	If Len(Trim(AN1A.Data)) < 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 2,2
	ACNM.Data = AN1A.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

If CheckInput(AN1A, zPwd) = True Then
	SCREEN.onsend = True

	If Trim(SYSTEM.UserPass) <> Trim(zPwd.Data) Then
		If Len(Trim(zPwd.Data)) >= 4 And Trim(zPwd.Data) <> "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If
	End If
	
	If Trim(zPwd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			zPwd.Data = ""
			zPwd.SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If

Else
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.SetFocus
End If

