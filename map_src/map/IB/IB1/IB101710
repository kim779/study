_AW_ONDECLARE_AW_
Dim exgb
Dim bNowPrice
Sub OnPortfolio(confirm)
	Dim groupNames, parseData, Items, codelist, row, countGroup

	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If
	If UCase(confirm) <> "OK" And UCase(confirm) <> "START" Then
		Exit Sub
	End If

	Items = ""
	DX_INTEREST.SetUserName(LOGIN.Name)
	groupNames = DX_INTEREST.LoadGroupNames()

	countGroup = 0
	Do While Len(groupNames) > 0
		parseData = Mid(groupNames, 1, InStr(groupNames, vbTab) -1)
		groupNames = Mid(groupNames, InStr(groupNames, vbTab) + 1)
		Items = parseData & vbTab & Items
		countGroup = countGroup + 1
	Loop

	'계좌 보유종목 조회
	If countGroup < 100 Then
		Items = "00 보유종목" & vbTab & Items
	End If

	If Items = "" Then
		intercombo.SetItems("")
	Else
		intercombo.SetItems(vbTab & Items)
	End If



	Call p_read_com()
'	intercombo.Data = SYSTEM.Pop("cxPortfolioItem")
	SCREEN.Proc "OBJ1.OnGroup", intercombo.Data
End Sub

Sub p_read_com()
	If SCREEN.CreateObject("Info") Then
		SYSTEM.Trace "!!!!!!!reduce::read file : " & Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP"))
	 	Dim data
	 	data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP"))
		If data = "" Then
			intercombo.Data = "01"
		Else
			intercombo.Data = data
		End If
		SYSTEM.Trace "!!!!!!!reduce::read combo: " & intercombo.Data
	End If
End Sub
Sub p_write_com()
	If SCREEN.CreateObject("Info") Then
	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP", intercombo.Data
	End If
End Sub

Sub SetAcnt(data)
	AN1A.data = data
End Sub

Sub SetPswd(data)
	zPwd.Data = data
End Sub

