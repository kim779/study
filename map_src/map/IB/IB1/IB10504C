RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sect, gridPos
sect = 0
gridPos = 1

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0045"
Call Check_LoginType(zPwd)		'직원/고객에 따른 비밀번호 컨트롤 설정
SCREEN.SetTimer 1, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("main.GUIDE").Text = ""

'SYSTEM.Trace "OnSend Start"

AN18.Data = Trim(SCREEN.Object("main.OBJ_order.AN18").Data)
zPwd.Data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)

If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
	zPwd.Data = "9999"
Else
	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If Trim(zPwd.Data) <> "HEAD" And Len(Trim(zPwd.Data)) >= 4 Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If
	
		If Trim(zPwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
				SCREEN.Object("main.OBJ_order.ed_pswd").Data = ""
				SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If

If Len(AN18.Data) < 11 Then
	'MsgBox "계좌번호를 확인하십시오.", , "IBK투자증권"
		SCREEN.Object("main.Guide").text = "계좌번호를 확인하십시오."
		SCREEN.Object("main.OBJ_order.AN18").SetFocus
		Exit Sub
End If



If SYSTEM.ConnectBy = 1 Then
	If Len(zPwd.Data) < 4 Then
		'MsgBox "비밀번호를 확인하십시오.", , "IBK투자증권"
		SCREEN.Object("main.Guide").text = "비밀번호를 확인하십시오."
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Sub
	End If
End If



SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)

If LEDGER.Ecod = "1801" Then
	MsgBox Trim(LEDGER.Emsg), , "IBK투자증권"
	'SCREEN.ClearAll 2, 2
	zPwd.Clear
	'SCREEN.Object("main.OBJ_order.ed_pswd").Clear
	SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

If sect = 0 And LEDGER.Next <> "Y" Then
	zPwd.SetFocus
End If

Dim ii, jmcd

For ii = gridPos To GRID0.Rows
	jmcd = Trim(GRID0.GetGridCell(ii, 1))

	If Len(Trim(jmcd)) = 7 And Left(Trim(jmcd), 1) = "J" Then
		jmcd = Mid(Trim(jmcd), 2, 6)
		GRID0.SetGridCell ii, 1, Trim(jmcd)
	End If
Next

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Len(Trim(SCREEN.Object("main.OBJ_order.AN18").Data)) <> 11 Then
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 Then
	Call send_f()
Else
	If Len(Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)) > 3 Then
		Call send_f()
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	sect = 0
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
sect = 1
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
sect = 1
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



