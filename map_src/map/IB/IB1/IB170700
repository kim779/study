RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim acntArr, startFlag
acntArr = Array("AN1A", "AN50", "AN20", "AN2A")		'유가증권, 투자신탁, 선물옵션, CD/CD/RP
startFlag = 0

Sub SetAcntCtrl()
	'SYSTEM.Trace "SetAcntCtrl start"
	ACNM.Clear
	zPwd.Clear
	next_btn.Enable = False
	'obj.ClearAll 2

	Dim ii, arrAcnt, viewAcnt, bVis
	viewAcnt = Trim(acntArr(mainTab.ID))

	For ii = LBound(acntArr) To UBound(acntArr)
		arrAcnt = Trim(acntArr(ii))

		If arrAcnt = viewAcnt Then
			bVis = True
		Else
			bVis = False
		End If

		SCREEN.Object(arrAcnt).Visible bVis
	Next

	SCREEN.Proc "obj.setScreen", ""

	If startFlag = 1 Then
		Call Set_account(acntArr(mainTab.ID))
	End If
End Sub

Sub Set_account(acntCtrl)
	'SCREEN.ClearAll 0, 2

	Dim acnt
	Set acnt = SCREEN.Object(acntCtrl)

	If acnt.Visible = False Then
		Exit Sub
	End If

	startFlag = 1

	If Len(Trim(acnt.Data)) = 11 Then
		ACNM.Data = Trim(acnt.Name)
		zPwd.Data = Trim(acnt.Password)

		If SYSTEM.ConnectBy = 1 Then
			If Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If
		End If

		SCREEN.Proc "obj.send_f", ""
	Else
		acnt.SetFocus
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)
Call SetAcntCtrl()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account("AN1A")	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then
	If Len(Trim(zPwd.Data)) < 4 Then
		Exit Sub
	End If

	SCREEN.Proc "obj.send_f", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zBaseDt)
_AW_ONCHANGE_AW_
SCREEN.Proc "obj.send_f", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
