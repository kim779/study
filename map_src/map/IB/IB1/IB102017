_AW_ONDECLARE_AW_
Public Today
Today = getCurrDay()



'== 첫 조회
Sub send_f()
	OUTPUT0.Data = ""
	SCREEN.Object("main.guide").text = Trim(OUTPUT0.Data)
	obj_his.Clear
	SCREEN.Object("obj_his.GRID0").Clear
	GRID0.Clear
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_


SCREEN.IgnoreChange True

	CHECK0.Checked = False
	S1301.Clear
	SCREEN.Object("obj0.1301").data = S1301.Data
	obj0.Send
	S1301.Enable  False
	BUTTON0.enable = False


	zOrdStrDt.Data = change_date("d",-7)
	zOrdEndDt.Data = Today

SCREEN.IgnoreChange False



send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
	EDIT0.Data = Trim(SCREEN.Object("main.AN5A").Data)

	If CHECK0.Checked = True Then
		EDIT3.Data = "1"
		EDIT4.Data = S1301.Data
	Else
		EDIT3.Data = "0"
		EDIT4.Data = ""
	End If


	OUTPUT0.Data = ""

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
For i = 0 To GRID0.Rows
	For j = 1 To GRID0.Columns
		GRID0.SetGridCell i, j, Trim(GRID0.GetGridCell(i,j))
	Next

	szData = Trim(GRID0.GetGridCell(i,6))
	nPos = InStr(szData, "매수")
	If nPos > 0 Then
		GRID0.SetTRgb i, 6, 54
		GRID0.SetTRgb i, 11, 54
	Else
		GRID0.SetTRgb i, 6, 74
		GRID0.SetTRgb i, 11, 74
	End If

Next

'If GRID0.Rows > 0 Then

	SCREEN.Object("main.guide").text = Trim(OUTPUT0.Data)

'End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zOrdStrDt)
_AW_ONCHANGE_AW_

	Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zOrdEndDt)
_AW_ONCHANGE_AW_

	Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
      Exit Sub
End If

SCREEN.Object("obj0.1301").data = S1301.Data
obj0.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHECK0)
_AW_ONCLICK_AW_
If CHECK0.Checked = False Then
	S1301.Clear
	SCREEN.Object("obj0.1301").data = S1301.Data
	obj0.Send
	S1301.Enable  False
	BUTTON0.enable = False
Else
	S1301.Enable  True
	BUTTON0.enable = True
	S1301.SetFocus()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If Trim(S1301.Data) = "000000" Then
		Exit Sub
	End If

SCREEN.Object("obj0.1301").data = S1301.Data
obj0.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
