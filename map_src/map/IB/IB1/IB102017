send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> "3" Then
	Exit Sub
End If


If GRID0.Column = 1 Then
	'일련번호
	szSq = Trim(GRID0.GetGridCell(GRID0.Row, 4))
	'계좌번호
	szAcc = Trim(SCREEN.Object("main.AN5A").Data)
	'계좌명
	szAccnm = Trim(SCREEN.Object("main.AN5A").name)
	'유형
	szType = Trim(GRID0.GetGridCell(GRID0.Row, 6))
	dmsg  = "e_acnt_no"  & vbTab & Trim(szAcc)& vbLf & "e_sq"  & vbTab & Trim(szSq) & vbLf & "e_accnm"  & vbTab & Trim(szAccnm)& vbLf

	If szType = "자동매수" Then
		'매수
		SCREEN.CreateWindow 2, "IB102040 /p5 /d", dmsg
	ElseIf szType = "자동매도" Then
		'청산
		SCREEN.CreateWindow 2, "IB102041 /p5 /d", dmsg
	ElseIf szType = "신규잔고편입매도" Then
		'편입
		SCREEN.CreateWindow 2, "IB102042 /p5 /d", dmsg
	End If
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
If GRID0.HitPos <> "3" Then
	Exit Sub
End If

SCREEN.Object("obj_his.e_acnt_no").data = Trim(SCREEN.Object("main.AN5A").Data)
SCREEN.Object("obj_his.e_sq").data = Trim(GRID0.GetGridCell(GRID0.Row, 4))
obj_his.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


