Sub SetPassword(sData)
	Dim Ifind, sAcc, sPass
	ifind = InStr(sData, "-")
	sAcc = Trim( Left(sData, Ifind-1) )
	sPass = Trim( Mid(sData, Ifind+1, Len(sData)- Ifind) )


	If Trim(SCREEN.Object("OBJ_order.AN1A").data) = sAcc Then
		If sPass <> "" Then
			SCREEN.Object("OBJ_order.ed_pswd").data = sPass
		End If
	End If
