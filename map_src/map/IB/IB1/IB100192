RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim mapsize, xxxx_flag
mapsize = 1
xxxx_flag = 1
'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password			'passwd가 저장되어있다면 세팅

	SCREEN.Object("main.guide").Text = " "
	If xxxx_flag = 1 Then
		SCREEN.Proc "main.chk_xxxx", ""		'비밀번호 체크
		xxxx_flag = 0
	End If

	'OBJ_odr 의 계좌번호 비밀번호 세팅
	SCREEN.Object("OBJ_odr.zAcntNo").Data = AN1A.Data
	SCREEN.Object("OBJ_odr.zPwd").Data = ed_pswd.Data

	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus : Exit Sub
	End If
End Sub

_AW_ONSTART_AW_
If Left(SCREEN.GetMapName(1), 6) = "IB1030" Then
	BTN_expand.Visible = True
End If

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
'주식주문2(IB100200)에서 주문타입변경시 계좌비밀번호 유지
If SCREEN.GetMapName(1) = "IB100200" Then
	SCREEN.Object("main.xxxx").Text = ed_pswd.Data
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_pswd)
_AW_ONCHANGE_AW_
SCREEN.Object("OBJ_odr.zPwd").Data = ed_pswd.Data
SCREEN.Proc "main.all_account", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_order)
_AW_ONCLICK_AW_
Select Case tab_order.ID
	Case "1" :
		OBJ_odr.SetObject("IB103011")
	Case "3" :
		OBJ_odr.SetObject("IB103012")
End Select

If mapsize = 2 Then
	SCREEN.Object("OBJ_odr.GUIDE").Visible = True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN01)
_AW_ONCLICK_AW_
Dim dmsg
dmsg = "1301" & vbTab & SCREEN.Object("obj_odr.1301").data & vbLf
SCREEN.CreateWindow 1, "IB200100 /s/t/d", dmsg
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN02)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB110200 /s/t", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN03)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB120100 /s/t", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN04)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB120600 /s/t", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_expand)
_AW_ONCLICK_AW_
If mapsize = 1 Then
	mapsize = 2
	SCREEN.SetSize 303, 216
	SCREEN.Object("Main.OBJ_sise").Visible = False
	SCREEN.Object("Main.OBJ02").Visible = False
	SCREEN.Object("OBJ_odr.GUIDE").Visible = True
Else
	mapsize = 1
	SCREEN.SetSize 631,445
	SCREEN.Object("Main.OBJ_sise").Visible = True
	SCREEN.Object("Main.OBJ02").Visible = True
	SCREEN.Object("OBJ_odr.GUIDE").Visible = False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



