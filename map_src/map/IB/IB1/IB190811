Function getDate(data, afterday)
getDate = ""
	Dim cday, MyWeek

	cday = DateAdd("d", afterday, data)
	MyWeek = Weekday(cday)

	'SYSTEM.Trace "Date : " & afterday & " data : " & data & "cday : " & cday & " Weekday : " & MyWeek

	If MyWeek = 1 Then
		cday= DateAdd("d", 1 , cday)
	ElseIf MyWeek = 7 Then
		cday= DateAdd("d", 2 , cday)
	End If

	'SYSTEM.Trace "after cday : " & cday
	getDate = cday



End Function

Function changeformat(data)
changeformat = ""
	Dim yy, mm, dd, cday

	cday = data
	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)



	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = mm & "/" & dd

	changeformat =  cday
End Function

