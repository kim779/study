		mcgb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "mcgb"))
		bep = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "bep"))
		ctype = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "type"))
		chkJango = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "chk_jango"))

		If tax <> "" Then
			cbo_tax.Index = tax
		Else
			cbo_tax.Index = 0
		End If

		If cbo_tax.Data = 0 Then
			cbo_mmd.Enable = False
		Else
			cbo_mmd.Enable = True
		End If

		If mcgb <> "" Then
			cbo_mmd.Index = mcgb
		Else
			cbo_mmd.Index = 0
		End If

		If bep <> "" Then
			cbo_bep.Index = bep
		Else
			cbo_mmd.Index = 0
		End If

		If cbo_bep.Data = 0 Then
			VIEWGRID.SetColumnVisible 7, True
			VIEWGRID.SetColumnVisible 8, False
		Else
			VIEWGRID.SetColumnVisible 7, False
			VIEWGRID.SetColumnVisible 8, True
		End If

		If ctype<>"" Then
			cbo_type.Data = ctype
		Else
			cbo_type.Data = "0"
		End If

		If chkJango <> "" Then
			If chkJango = "1" Then
				chk_jango.Checked = True
			Else
				chk_jango.Checked = False
			End If
		Else
			chk_jango.Checked = True
		End If
	End If
End Sub

