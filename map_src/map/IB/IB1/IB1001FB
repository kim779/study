RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim first
Dim ii,i, TimerGubn
Dim list
Set list = CreateObject("Scripting.Dictionary")

Sub main_sended()
	Dim ret, msg

	SCREEN.OnSend = False

	SCREEN.Proc "main.set_guide", " "


	AN1A.Data = Trim(SCREEN.Object("main.OBJ_order.AN1A").Data)
	pswd.Data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)

	If Error_check() = False Then				'주문전 Error Check
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Sub
	End If

	If Trim(out_hts.data) = "" Then
		Call TaxRateSend()
	End If
End Sub
''*************************************************
''send ui data
''*************************************************
Sub f_vSendUiData()
	Dim accn, pass,tax,mmd,ctype

	SCREEN.OnSend False
	VIEWGRID.Clear

	If cbo_mmd.Index = 0 Then
		mmd = out_hts.data
	ElseIf cbo_mmd.Index = 1 Then
		mmd = out_call.data
	ElseIf cbo_mmd.Index = 2 Then
		mmd = out_ars.data
	End If

	accn = Trim(AN1A.Data)						'계좌번호
	pass = Trim(pswd.Data)						'비밀번호
	tax = cbo_tax.data

	If Len(accn) <> 11 Then
		accn = Trim(SCREEN.Object("main.OBJ_order.AN1A").Data)
		If Len(accn) <> 11 Then
			SCREEN.Object("main.guide").text = "계좌번호를 확인해 주십시오."
			Exit Sub
		End If
	End If

	If Len(pass) < 4 Then
		If SYSTEM.ConnectBy = "0" Then
			pass = "9999"
		Else
			pass = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)
		End If
		If Len(pass) < 4 Then
			SCREEN.Object("main.guide").text = "비밀번호를 확인해 주십시오."
			Exit Sub
		End If
	End If

	ctype = cbo_type.Data

	If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
		If cxMarket.sMarket = "KRX" Then
			Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, ctype, "1")
		ElseIf cxMarket.sMarket = "NXT" Then
			Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, ctype, "2")
		ElseIf cxMarket.sMarket = "통합" Then
			Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, ctype, "3")
		End If
	End If

	If UCase(TypeName( SCREEN.Object("Main.1301"))) <> "NOTHING" Then
		cxMarket.sCode = SCREEN.Object("Main.1301").Data
	End If

'	SCREEN.Wait = True
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Error_check = False
	If Trim(AN1A.Data) = "" Then
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus
		Call guide_msg("계좌번호를 확인하십시오")
		Exit Function
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(pswd.Data)) < 4 Then
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Call guide_msg("비밀번호를 확인하십시오")
			Exit Function
		End If
	End If
	Error_check = True
End Function
'***************************************************************************
' DESC: TaxRateSend
'***************************************************************************
Sub TaxRateSend()
	'SYSTEM.Trace "TaxRateSend() : " & AN1A.Data & vbTab & pswd.data
	SCREEN.Object("obj.account").data = AN1A.Data
	SCREEN.Object("obj.pswd").data = pswd.data
	obj.Send
End Sub

'***************************************************************************
' DESC: ClearData
'***************************************************************************
Function ClearData()
		SCREEN.ClearAll 0, 2
		SCREEN.Proc "objX.OnClear",""
End Function

'***************************************************************************
' DESC: clear_check
'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit Sub
		End If
		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
End Sub

'***************************************************************

Function chkcnt()
	Dim gcnt
	gcnt = 0

	chkcnt = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell(ii, 1)) = 1 Then
			gcnt = gcnt + 1
		End If
	Next

	If gcnt > 0 Then
		chkcnt = True
	Else
		allCheck.Checked = False
	End If
End Function


'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_chk(Flag)
Dim val,quan
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit Sub
		End If
		val = Trim(VIEWGRID.GetGridCell (ii, 4))
		quan = Trim(VIEWGRID.GetGridCell(ii, 6))

