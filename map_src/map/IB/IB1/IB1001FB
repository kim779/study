_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim cnt, jmgb, mkgb, mmgb, accn, pass, jmno, code, jmsu, jmga, hogb, jmjg, jcgb, xxgb, name, dcdt, val
Dim msg,ret,pswd2,mkgb2,sycd,jmna,miga,hjan,sygb,s_data

If Trim(pswd.Data) = "" Then
	MsgBox "비밀번호를 입력하십시오.", , "IBK투자증권"
	pswd.SetFocus
	Exit Sub
End If

ret = P_pswdConfirm(AN1A.data, pswd.data, msg)
If ret <> True Then
	pswd.Clear
	pswd.SetFocus
	MsgBox "비밀번호 오류입니다.", ,  "IBK투자증권"
	GUIDE.Text = msg
	Exit Sub
End If

en_accn.Data = Mid(AN1A.data, 1, 8)
en_pswd.Data = SCREEN.Object("main.OBJ_order.ed_pswd").Data
pswd2 = SYSTEM.Encrypt(en_pswd.Data, en_accn.Data)

cnt = 0
For ii = 1 To VIEWGRID.Rows
	If VIEWGRID.GetGridCell(ii ,1) = 1 Then
		cnt = cnt + 1
		ret = s_chk_elw_price(mkgb2, code, VIEWGRID, ii)
		If ret = True Then
			sycd = VIEWGRID.GetGridCell(ii, 4)			'신용구분
			jmgb = "1"									'주문유형(1:현물,2:선물옵션,3...)
			mkgb = ""									'시장구분(사용안함)
			mmgb = "1"									'매매구분(1:매도 2:매수 3:정정 4:취소)
			accn = AN1A.Data							'계좌번호
			pass = pswd2								'비밀번호
			jmno = ""									'원주문번호(정정취소시)
			If SCREEN.GetCodeType(VIEWGRID.GetGridCell(ii, 2)) = "9" Then
			     code = "J" & VIEWGRID.GetGridCell(ii, 2)   '종목코드
			ElseIf SCREEN.GetCodeType(VIEWGRID.GetGridCell(ii, 2)) = "27" Then
			     code = "Q" & VIEWGRID.GetGridCell(ii, 2)   '종목코드
			Else
			     code = VIEWGRID.GetGridCell(ii, 2)   '종목코드
			End If

			' 코드 연동용 시장 접두 제거
			code = Replace(code, "M.", "")
			code = Replace(code, "N.", "")

			jmna = VIEWGRID.GetGridCell(ii, 3)			'종목명
			miga = VIEWGRID.GetGridCell(ii, 7)			'매입단가(평균단가)
			jmsu = VIEWGRID.GetGridCell(ii, 6)			'주문수량
			hjan = ""									'호가잔량
			jmga = ""									'주문단가(선물옵션의경우 *100)
			hogb = "00"									'호가구분(00:지정가 03:시장가...)
			jmjg = "0"									'주문조건
			jcgb = ""									'정정취소(1:일부 2:전부)
			xxgb = "X"									'처리구분(이하의 값이 세팅되지않을경우 X)
			sygb = ""									'신용구분코드(103:자기융자상환 ...)
			val  = Trim(VIEWGRID.GetGridCell(ii, 17))   '신용분류코드
			If sycd = "01" Then
				xxgb = "B"
				sygb = "1" & val   '신용분류코드
			End If
			dcdt = VIEWGRID.GetGridCell(ii, 18)			'대출일자

			s_data = "^" & s_data
			s_data = dcdt & "|" & s_data				'대출일자
			s_data = sygb & "|" & s_data				'신용구분코드(103:자기융자상환코드 ...)
			s_data = xxgb & "|" & s_data				'처리구분
			s_data = jcgb & "|" & s_data				'정정취소
			s_data = jmjg & "|" & s_data				'주문조건
			s_data = hogb & "|" & s_data				'호가구분
			s_data = jmga & "|" & s_data				'주문가격
			s_data = hjan & "|" & s_data				'호가잔량
			s_data = jmsu & "|" & s_data				'주문수량
			s_data = miga & "|" & s_data				'매입단가(평균단가)
			s_data = jmna & "|" & s_data				'종목명
			s_data = code & "|" & s_data				'종목코드
			s_data = jmno & "|" & s_data				'원주문번호
			s_data = pass & "|" & s_data				'비밀번호
			s_data = accn & "|" & s_data				'계좌번호
			s_data = mmgb & "|" & s_data				'매매구분
			s_data = mkgb & "|" & s_data				'시장구분
			s_data = jmgb & "|" & s_data				'주문유형
			s_data = sycd & "|" & s_data				'신용구분(00:일반 01:신용 02~04:대용 05:기타)
			s_data = "1" & "|" & s_data					'chk
		End If
	End If
Next

num.data = cnt											'처리건수

If cnt > 0 Then
	num.Push ""
	SCREEN.CreateWindow 2, "IB120110 /p5 /d", "s_data" & vbTab & s_data & vbLf & "AN1A" & vbTab & AN1A.Data & vbLf & "pswd" & vbTab & SCREEN.Object("main.OBJ_order.ed_pswd").Data & vbLf & "MKCD" & vbTab & cxMarket.sMarket & vbLf

	clear_check()
End If

If chkcnt() = False Then
	BUTTON0.Enable = False
Else
	BUTTON0.Enable = True
End If
