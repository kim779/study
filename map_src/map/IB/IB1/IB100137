_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_jprc)
_AW_ONCHARCHANGE_AW_
Dim prc
prc = Trim(ed_jprc.Data)

'If is_numeric(prc) = False Then
'	Call guide_msg("매수가격을 확인하여 주십시오.")
