RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 2, 2
	next_btn.Enable = False
	ACNM.data = AN1A.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	GRID0.SetDataPosition(2)
	GRID1.SetDataPosition(2)
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

'직원/고객에 따른 비밀번호 컨트롤 설정
Call Check_LoginType(zPwd)

'SCREEN.SetTimer 5,False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

Dim Temp
Temp = Date
zBaseDt.Data = Replace(Temp, "-", "")

SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
Else
	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If Trim(zPwd.Data) <> "HEAD" And Len(Trim(zPwd.Data)) >= 4 Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If

		If Trim(zPwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				GUIDE.Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
				zPwd.Data = ""
				zPwd.SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If

If CheckInput(AN1A, zPwd) = True Then
	SCREEN.onsend = True
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2,2
	ACNM.Data = AN1A.Name
	zPwd.Clear
	zPwd.SetFocus
ElseIf Left(Trim(LEDGER.Ecod), 1) = "0" Then

	Dim val1, val2, ii
	Dim before_val1, before_val2, change_val1, change_val2

	'추정순자산증감
	val1 = Trim(IDpsastTotamt.GetTableCell(1))
	val2 = Trim(IDpsastTotamtD1.GetTableCell(1))

	If AN1A.Data <> "           " Then
		If IsNumeric(val1) = True Then
			If IsNumeric(val2) = True Then
				TABLE1.SetTableCell 1, val1 - val2
			Else
				TABLE1.SetTableCell 1, val1
			End If
		Else
			If IsNumeric(val2) = True Then
				TABLE1.SetTableCell 1, -(val2)
			Else
				TABLE1.SetTableCell 1, "0"
			End If
		End If
	End If

End If

Select Case sec.data
	Case "1"	zPwd.SetFocus
	Case "2"	send_btn.SetFocus
	Case "3"	next_btn.SetFocus
End Select

If LEDGER.Next = "Y" Then
	'next_btn.Enable = True
	GRID0.SetDataPosition(2)
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
Else
	'next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
sec.Data = "2"
send_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	sec.Data = "1"
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.DATA = Right(GRID0.GetGridCell(GRID0.Row, 1), 11)

	If Trim(S1301.DATA) = "" Then
		Exit Sub
	End If

	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
