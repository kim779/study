RESOURCE DIVISION
{


_AW_ONSEND_AW_
i_usid.Data = LOGIN.User

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim res, Today, Check

res = o_status.Data

If SCREEN.CreateObject("Info") Then
	Today = INFO.PopData("", "NOTICECOOKIE.ini", "1711", "TODAY")

	If Today = "0" Or (Today <> CDAT.Data) Then
		INFO.PushData "", "NOTICECOOKIE.INI", "1711", "TODAY", CDAT.Data
		INFO.PushData "", "NOTICECOOKIE.ini", "1711", "FIRST", "1"
	Else
	 	INFO.PushData "", "NOTICECOOKIE.INI", "1711", "TODAY", CDAT.Data
	End If

	Check = INFO.PopData("", "NOTICECOOKIE.ini", "1711", "FIRST")

	If InStr(res, "O") > 0 And Check = "1" Then
		SCREEN.CreateWindow 1, "IB171100 /p1", ""
	End If

End If

_AW_ONENDSUB_AW_
}



