RESOURCE DIVISION
{


_AW_ONSTART_AW_
SYSTEM.Push "stock_mado_order", "NO"

Dim myTime, myHour, myMinute, myGubn, pos

myTime = Time
myHour = Hour(myTime)
myMinute = Minute(myTime)
myGubn = Trim(o_hogb.Data)

pos = InStr(myGubn, "장개시전")

If pos > 0 And myHour = 7 Then
	If myMinute >= 20 And myMinute <= 30 Then
		beforeJang.Visible = True
	End If
End If

If Len(Trim(o_stopjprc.Data)) = 0 Then
	PANEL11.Visible = False
	o_stopjprc.Visible = False
	PANEL12.Visible = False
Else
	PANEL11.Visible = True
	o_stopjprc.Visible = True
	PANEL12.Visible = True
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(o_acno)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(B_OK)
_AW_ONCLICK_AW_
SYSTEM.Push "stock_mado_order", "OK"

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(B_CANCEL)
