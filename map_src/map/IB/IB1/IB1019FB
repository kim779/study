Function ClearData()
		SCREEN.ClearAll 0, 2
		SCREEN.Proc "objX.OnClear",""
End Function

'***************************************************************************
' DESC: clear_check
'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit Sub
		End If
		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
End Sub

'***************************************************************

Function chkcnt()
	Dim gcnt
	gcnt = 0

	chkcnt = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell(ii, 1)) = 1 Then
			gcnt = gcnt + 1
		End If
	Next

	If gcnt > 0 Then
		chkcnt = True
	Else
		allCheck.Checked = False
	End If
End Function


'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_chk(Flag)
Dim val,quan
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit Sub
		End If
		val = Trim(VIEWGRID.GetGridCell (ii, 4))
		quan = Trim(VIEWGRID.GetGridCell(ii, 6))

		If val = "00" Or val = "01" Then
			If quan <> "" Then
				VIEWGRID.SetGridCell ii, 1, Flag
			End If
		End If
	Next
End Sub

'***************************************************************************
' DESC: 0보다큰 숫자형식인지 검사. 유효숫자( > 0):true else false
'***************************************************************************
Function Is_numeric(data)
	Dim number
	number = Trim(data)

	If number = "" Then
		number = 0
	End If

	Is_numeric = False
	If IsNumeric(number) = False Then
		Exit Function
	End If
	If CDbl(number) <= 0 Then
		Exit Function
	End If

	Is_numeric = True
End Function

