		   If Trim(migm) = "" Then
		   migm =0
		   Else
			migm = CDbl(migm)
			End If
		End If
		tmigm = tmigm + migm

		pggm = VIEWGRID.GetGridCell(ii, 11)				'평가금액의 합
		If Is_numeric(pggm) = False Then
			If Trim(pggm) = "" Then
			pggm = 0
			Else
			pggm = CDbl(pggm)
			End If
		End If
		tpggm = tpggm + pggm

		samt = VIEWGRID.GetGridCell(ii, 16)				'신용금액의 합
		If Is_numeric(samt) = True Then
			tsamt = tsamt + samt
		End If
	Next

	o_migm.Data = tmigm									'매입금액의 합
	o_pggm.Data = tpggm									'평가금액의 합

	o_pgsi.Data = tpggm - tmigm							'평가손익
	If o_pgsi.Data > 0 Then
		o_pgsi.Data = "+" & o_pgsi.Data
	End If

	If tmigm =< 0 Then									'손익률
		srat = 0
	Else
		srat = CCur((tpggm - tmigm) / tmigm * 100)
	End If

	o_srat.Data = srat

	If srat > 0 Then
		o_srat.Data = "+" & FormatNumber(srat,2,,-2) '&"%"
	Else
		o_srat.Data = "-" & FormatNumber(srat,2,,-2) '&"%"
	End If
End Sub
