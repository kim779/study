Sub SetItems()
	Dim i, j, HeadData, PrcFlag, PrgFlag

	For i = 13 To 15
		HeadData = VIEWGRID.GetHead(i)

		For j = LBound(g_ArrData) To UBound(g_ArrData)
			If HeadData = g_ArrData(j)(0) Then
				g_ArrItems(i - 13).Data = g_ArrData(j)(3)
				Exit For
			End If
		Next
	Next
