Sub tab_sise_click()
	If tab_sise.ID  = 0 Then
		bt_Hoga.Visible = True
		OPEN_BTN1.Visible False
	ElseIf tab_sise.ID  = 4 Then
		bt_Hoga.Visible = False
		OPEN_BTN1.Visible False
	Else
		bt_Hoga.Visible = False
		OPEN_BTN1.Visible True
	End If
End Sub

Sub tab_accout_click()
	If tab_account.ID = 4 Then
		btn_send.Visible = True
	Else
		btn_send.Visible = False
	End If

	If tab_account.ID = 1 Then
		OPEN_BTN3.Visible = False
	Else
		OPEN_BTN3.Visible = True
	End If
End Sub

Sub SetHogaVisible()
	If  OBJ_sise.GetObject = "IB1001E0" Then
		Sindex = "0"
		If SCREEN.CreateObject("Info") Then
			Sindex = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB1001E0", "HOGA_INDEX"))
			If Len(Sindex) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB1001E0", "HOGA_INDEX", "0"
				Sindex = "0"
			End If
		End If
		If SIndex = "0" Then
			bt_Hoga.Text = "10호가"
		Else
			bt_Hoga.Text = "5호가"
		End If
		OBJ_sise.Proc "ProcSetVisible", Sindex
	End If
End Sub




'========================================
' 하위 OBJ에 시장구분자 세팅 후 조회 발생
'========================================
Sub Change_MKGubn_Main(sMKGubn)

	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "MKgubn", sMKGubn
	End If

	'=====================
	' 직전 시장구분자 저장
	'=====================
	Dim tMKGubn
	tMKGubn = cxMarket.sMarket

SYSTEM.Trace "[IB100100][Change_MKGubn_Main] sMKGubn = " & sMKGubn


	'================================================================
	' 소속 OBJ 내의 cxMarket 시장 구분을 Main 시장구분으로 세팅
	'================================================================
	' 여기서 시장구분자 보정 후 Change_MKGubn_Main_Limited 함수 호출되어서
	' 하위 오브젝트에 시장 자동으로 전파한다.
	'================================================================
	Call Spread_mkgb(S1301.Data, sMKGubn)


	'================================================================
	' 시장 변동이 없을 경우 조회 Send 발생 SKIP 처리
	'================================================================
	' Spread_mkgb() 함수 이후의 시장구분자는 보정되고 난 다음의 시장구분자이다.
	'================================================================
	If tMKGubn = cxMarket.sMarket Then
		Exit Sub
	End If


	'====================
	' 하단 원장 OBJ 조회
	'====================
	Call Change_MKGubn_Main_Send()
End Sub




'==========================================
' 하위 OBJ에 시장구분자 세팅 (조회 미발생)
'==========================================
Sub Change_MKGubn_Main_Limited(sMKGubn)
SYSTEM.Trace "[IB100100][Change_MKGubn_Limited] sMKGubn = " & sMKGubn
	' 직전 시장구분자 저장
	Dim tMKGubn
	tMKGubn = cxMarket.sMarket

	SCREEN.IgnoreChange True
	cxMarket.sCode = S1301.Data
	cxMarket.sMarket = sMKGubn

	SCREEN.Proc "Main.OBJ_sise.Change_MKGubn_OBJ"             , sMKGubn
	SCREEN.Proc "Main.OBJ_order.OBJ_odr.Change_MKGubn_OBJ"    , sMKGubn
	SCREEN.Proc "Main.OBJ_account.Change_MKGubn_OBJ"          , sMKGubn
	SCREEN.Proc "Main.OBJ_account.OBJ1.Change_MKGubn_OBJ"     , sMKGubn
	SCREEN.IgnoreChange False

	' 시장 변동 발생 시 조회 발생
	If tMKGubn <> cxMarket.sMarket Then
		Change_MKGubn_Main_Send()
		Exit Sub
	End If

End Sub



'=====================================
' 하위 OBJ 시장 변동에 따른 Send 발생
'=====================================
Sub Change_MKGubn_Main_Send()
		'================================================================
		' 하단 원장 OBJ 조회 :: 잔고구분자에 시장 변경 버튼이 존재
		'================================================================
		Select Case tab_account.ID
		Case 1 : ' 미체결|잔고
			' 미체결 내역은 변경하지 않도록 위해 다음 구문을 사용
			' => 서브 미체결|잔고 화면의 OnSend() 에서 DONOTSEND 일때는
			'    미체결 조회 하지 않도록 스크립트 미체결내역의 OnSend 스크립트 추가
			SCREEN.Object("OBJ_account.OBJ0.GOSTOP").Text = "DONOTSEND"
			SCREEN.Object("OBJ_account.OBJ1").Send

		Case 3 :  ' 실시간잔고
			SCREEN.Object("OBJ_account").Send

		Case 2 : ' 미체결	' DO NOTHING
		Case 4 : ' 예수금	' DO NOTHING
		Case 5 :  ' 매매일지' DO NOTHING
		Case 6 : ' 당일손익	' DO NOTHING
		Case 7 : ' 주문가능	' DO NOTHING
		Case 8 : ' 체결		' DO NOTHING
		End Select

		SCREEN.Object("obj_obj_sise").Send	' 주문 단가 세팅용 시세 OBJ 조회
		SCREEN.Object("OBJ_sise").Send		' 좌측 상단 시세 OBJ 조회
		SCREEN.Object("OBJECT0").Send		' 주문화면용 자동단가 설정용 OBJ 조회

		' 10 호가 선택 시
		If SIndex = "0" Then
			SCREEN.Object("OBJ_sise.obj_10Hoga").Send
		End If
End Sub

