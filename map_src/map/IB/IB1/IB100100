Sub send_sise_all(xval)
	SCREEN.IgnoreChange True

	If xval <> "jumun" And xval <> "account" Then
  		S1301.Trigger "", False
 	End If

	S1301.Trigger "", True
	If xval <> "jumun" Then
		' 주문화면에서 올라온 조회 요청이 아니라면
		' 주문화면에 종목코드 부여 후 화면 세팅
		Call Ord_ChangeCode(S1301.Data)
	End If

	SCREEN.Object("OBJ_sise.1301").data = Trim(S1301.Data)
	SCREEN.Object("OBJECT0.1301").Data = Trim(S1301.Data)
	OBJ_sise.Send
	OBJECT0.Send
	obj_obj_sise.Send

	If SCREEN.Object("OBJ_order.obj_odr.1301").Iskonex = True Then
		SCREEN.Object("OBJ_order.obj_odr.c_jqty").type = Asc("N")
	Else
		SCREEN.Object("OBJ_order.obj_odr.c_jqty").type = Asc("1")
	End If

	If tab_account.ID = "7" Then
		SCREEN.Proc "obj_account.send_main", ""
	End If

	SCREEN.IgnoreChange False
End Sub

Sub all_account()
	OBJ_account.Send
End Sub

