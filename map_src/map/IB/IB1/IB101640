RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MYFILE = "userconf.ini"
Const MYMAP = "IB101640"

Sub Onalert()
	Dim curr, koga, jega, diff, siga

	curr = Trim(S20023.Data)	'현재지수
	koga = Trim(S20030.Data)	'고가지수
	jega = Trim(S20031.Data)	'저가지수
	diff = Trim(S20033.Data)	'등락율
	siga = Trim(S20029.Data)	'시가지수

	If CDbl(curr) > CDbl(koga) Or Mid(koga, 1, 1) = "0" Then
		S20030.Data = S20023.Data
		If Mid(diff, 1, 1) = "-" Then
			S20030.TRgb = 95
		ElseIf Mid(diff, 1, 1) = "+" Then
			S20030.TRgb = 94
		End If
	End If

	If CDbl(curr) < CDbl(jega) Or Mid(siga, 1, 1) = "0" Then
		S20031.Data = S20023.Data
		If Mid(diff, 1, 1) = "-" Then
			S20031.TRgb = 95
		ElseIf Mid(diff, 1, 1) = "+" Then
			S20031.TRgb = 94
		End If
	End If

	If Mid(siga, 1, 1) = "0" Then
		S20029.Data = S20023.Data
		If Mid(diff, 1, 1) = "-" Then
			S20029.TRgb = 95
		ElseIf Mid(diff, 1, 1) = "+" Then
			S20029.TRgb = 94
		End If
	End If
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "upGubn", upgb.Data
		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "upjong", S20301.Data
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim upGubn, upjong
		upGubn = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "upGubn"))
		upjong = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "upjong"))

		SCREEN.IgnoreChange True
		If upGubn = "" Then
			upgb.Data = "001"
		Else
			upgb.Data = upGubn
		End If

		If upjong = "" Then
			S20301.Data = "001"
		Else
			S20301.Data = upjong
		End If
		SCREEN.IgnoreChange False
	End If
End Sub

Sub check_KOSPI200()
	If upgb.Data = "101" Then
		utab.SetTabVisible 1, True
		utab.SetTabVisible 2, True
	ElseIf upgb.Data = "701" Then
		utab.SetTabVisible 1, False
		utab.SetTabVisible 2, False

		If utab.ID = 1 Or utab.ID = 2 Then
			utab.ID = 3
		End If
	Else
		utab.SetTabVisible 1, False
		utab.SetTabVisible 2, True

		If utab.ID = 1 Then
			utab.ID = 2
		End If
	End If

End Sub

Sub SetMap()
	If utab.ID = 1 Then
		OBJ02.SetObject "IB101641"
	ElseIf utab.ID = 2 Then
		If upgb.Data = "101" Or upgb.Data = "303" Or upgb.Data = "999" Then
			OBJ02.SetObject "IB101642"
		Else
			OBJ02.SetObject "IB101641"
		End If
	ElseIf utab.ID = 3 Then
		If upgb.Data = "701" Then
			OBJ02.SetObject "IB101641"
		Else
			OBJ02.SetObject "IB101642"
		End If
	ElseIf utab.ID = 4 Then
		OBJ02.SetObject "IB101642"
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'KOSPI200, KOSTAR, KRX100지수는 2초마다,
'프리보드는 1분마다,
'나머지는 10초마다 지수데이터가 내려옴.

'KOSPI200일경우 2초지수를 보여줌.
'프리보드일 경우에는 1분지수와 10분지수만 보여줌.

'Call p_read_ini()
SCREEN.SetTimer 2, False

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
OBJ_chart.send

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call check_KOSPI200()
Call SetMap()

SCREEN.Send 0
OBJ02.Send

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
Call p_write_ini()

