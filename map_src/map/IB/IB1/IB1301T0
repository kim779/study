_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "WithFee"

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	SCREEN.Object("GUIDE.GUIDE").Text = ""

	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password

	If Len(Trim(AN1A.Data)) < 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	If Trim( SCREEN.Object("obj_Buf.edt_MapNo").Data) = "" Then
		Exit Sub
	End If

	SCREEN.Proc "obj.send_f", ""
End Sub

Sub send_f()
	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			obj.ClearAll 2
			next_btn.Enable = False
			SCREEN.Object("main.GUIDE.GUIDE").Text = "비밀번호를 입력하세요."
			Exit Sub
		End If
	End If

	If Trim(zOrdDt.Data) = Trim(tday.Data) Then
		obj.SetObject("IB1301T1")
	Else
		obj.SetObject("IB1301T2")
	End If
	
	SCREEN.Proc "obj.send_f", ""
End Sub

'''///////
Sub SetInitCustomer()
	Dim iCustomerType
	iCustomerType = SYSTEM.ConnectBy
	SCREEN.Object("obj_Buf.edt_Customer").Data = iCustomerType
	If iCustomerType <> "1" Then '고객
		zPwd.Enable = False
		If Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If
	End If

	SetInitVal()
End Sub


Sub SetInitVal()
'매매비용 포함여부
	Dim stock_fee
	If SCREEN.CreateObject("Info") Then
		stock_fee = INFO.PopData(LOGIN.Name, myFILE, myMAP, "Stock")
		If Trim(stock_fee) = "" Then
			stock_fee = False
		End If
		CHECK0.Checked = stock_fee
		If CHECK0.Checked = False Then
			zCmsnAmtAppTp.Data = 0
		Else
	  	  zCmsnAmtAppTp.Data = 1
		End If
	End If

	If SCREEN.Object("obj_Buf.edt_sndCnt").Data = 0 Then
		'Call send_f()
	End If

End Sub


Sub SetPassword(sData)
	Dim Ifind, sAcc, sPass
	ifind = InStr(sData, "-")
	sAcc = Trim( Left(sData, Ifind-1) )
	sPass = Trim( Mid(sData, Ifind+1, Len(sData)- Ifind) )
	If Trim(AN1A.Data) = sAcc Then
		zPwd.data = sPass
		If Trim( SCREEN.Object("obj_Buf.edt_sndCnt").Data) = "0" Then
			Call send_f()
		End If
	End If
End Sub

