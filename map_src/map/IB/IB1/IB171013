_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

Dim ret, msg, chk
chk = 0
an.Data = SCREEN.Object("main.AN99").data
pwd.Data = SCREEN.Object("main.zpwd").data
juno.Data = LOGIN.juno

If CheckInput(an, pwd) = True Then
	chk = "1"
Else
	If SYSTEM.ConnectBy = 0 Then
		chk = "1"
		pwd.Data = "9999"
	Else
		chk = "0"
	End If
End If

If chk = "1" Then
	ret = P_pswdConfirm(an.data, pwd.data, msg)
	If ret <> True Then
		SCREEN.Object("main.GUIDE").Text = msg
		SCREEN.OnSend False
		Exit Sub
	Else
		SCREEN.OnSend True
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii

If LEDGER.Ecod = "3669" Or LEDGER.Ecod = "1001"Then
	SCREEN.ClearAll 1,2
	If SCREEN.Object("main.sect").Data = "1" Then
		SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN99").name
	Else
		SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN98").name
	End If
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus
	Exit Sub
End If

