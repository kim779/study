Function Sethoga(val)
	If Trim(val) <> "" Then
		SCREEN.Object("Main.OBJ_odr.ed_jprc").Data = val
		SCREEN.Proc "Main.OBJ_accn.SetPrice", val
		SCREEN.Proc "Main.OBJ_odr.OBJ_JUNGSAN.CalcJungsan", ""
	Else
		Exit Function
	End If
End Function

Dim aryHoga, aryTempHoga, aryRate

aryHoga = Array(S14755, S14754, S14753, S14752, S14751, S14771, S14772, S14773, S14774, S14775)
aryTempHoga = Array(md5, md4, md3, md2, md1, ms1, ms2, ms3, ms4, ms5)
aryRate = Array(rate_md5, rate_md4, rate_md3, rate_md2, rate_md1, rate_ms1, rate_ms2, rate_ms3, rate_ms4, rate_ms5)

Sub OnAlert()

	Dim hoga, currentVal, tempHoga, rate

	currentVal = Trim(S2023.Data)


	If currentVal <> "" Then
		currentVal = CLng(currentVal)
	Else
		Exit Sub
	End If

'	SYSTEM.Trace "Onalert"

	For ii=0 To 9
		hoga = Trim(aryHoga(ii).Data)
		tempHoga = Trim(aryTempHoga(ii).Data)

		If hoga <> "" Then
			hoga = CLng(hoga)
		Else
		 	hoga = 0
		End If

		If tempHoga <> "" Then
			tempHoga = CLng(tempHoga)
		Else
			tempHoga = 0
		End If

	'	SYSTEM.Trace "tempHoga : " & tempHoga & " hoga : " & hoga
'		If hoga <> tempHoga Then
			aryTempHoga(ii).Data = hoga

			If hoga = 0 Then
				rate = 0
			Else
				rate = ((hoga - currentVal) / currentVal) * 100
'				rate = Fix(rate*100)/100
			End If

			rate = FormatNumber(rate, 2, -1, 0)

			If rate = 0 Then
				If hoga = 0 Then
					aryRate(ii).Data = ""
				Else
					aryRate(ii).Data = rate
				End If

			Else
				aryRate(ii).Data = rate
			End If

			If rate > 0 Then
'				SYSTEM.Trace "rate : " & rate
				aryRate(ii).TRgb 94
			End If
'		End If
	Next
End Sub

Sub ClearAllRate()
	For ii=0 To 9
		aryRate(ii).Clear
	Next
End Sub

