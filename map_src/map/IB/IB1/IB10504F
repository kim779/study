RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim sendCnt
sendCnt = 0

'================================================================================
' 메인에서 send_sise_all()시 호출됨. tab_account전환시 호출
' 화면이 처음뜰 때 obj_currentVal에서 매수가격(현재가)를 가져온 후 chkCondition()으로..
'================================================================================
Sub send_main()
	jmcd.Data = Trim(SCREEN.Object("main.1301").Data)
	obj_currentVal.Send
End Sub


'================================================================================
' 현금/신용 구분 및 매매구분으로 화면 세팅값 가져옴.
'================================================================================
Sub chkCondition()
	mmgb.Data = SCREEN.Object("main.OBJ_order.OBJ_odr.ed_mmgb").Data
	sygubn.Data = "0"
	com_sygubn.Data = sygubn.Data

	If Trim(mmgb.Data) = "1" Or Trim(mmgb.Data) = "2" Then
		com_mmgb.Data = mmgb.Data
	End If
End Sub

'===============================================================================
' 현금/신용구분, 매매구분으로 화면 세팅
'===============================================================================
Sub SetSrc()
	If Trim(mmgb.Data) <> "3" Then
		com_sygubn.Enable = False

		mmgbLabel.Visible = False
		com_mmgb.Visible = False
	Else
		com_sygubn.Enable = False

		mmgbLabel.Visible = True
		com_mmgb.Visible = True
	End If
End Sub


Sub send_f()
	sendCnt = sendCnt + 1

	If sendCnt > 1 Then
		sendCnt = 0
		Exit Sub
	End If

	Call chkCondition()
	Call SetSrc()

	If IsNumeric(ed_jprc.Data) = True Then
		If CDbl(ed_jprc.Data) = 0 Then
			ed_jprc.Data = SCREEN.Object("main.OBJ_sise.2023").Data
		End If

		SCREEN.Proc "obj0.send_f", ""
	Else
		Call guide_msg(Trim(com_mmgb.Text) & "가격을 확인하여 주십시오.")
		ed_jprc.SetFocus
	End If

	sendCnt = 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call send_main()
Call send_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB200100 /s/p5 /t", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_jprc)
_AW_ONCHARCHANGE_AW_
If Mid(Trim(ed_jprc.Data),1,1) = "+" Or Mid(Trim(ed_jprc.Data),1,1) = "-" Then
	ed_jprc.Clear
End If
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then
	If Trim(ed_jprc.Data) <> "" Then
		If IsNumeric(ed_jprc.Data) = True Then
			Call send_f()
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
'버튼클릭자료수집
Call btnClickCnt(b_send)

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(com_sygubn)
_AW_ONCHANGE_AW_
sygubn.Data = com_sygubn.Data
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(com_mmgb)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



