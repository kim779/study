RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim nCurrRow

nCurrRow = 1

'== 첫 조회
Sub send_f()
	nCurrRow = 1
	zCommdaCode.Data = "01"

	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
'== 주문obj를포함한 main의 공통함수
#LOAD IB999913

#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"
QryBaseDt.Data = getCurrDay()
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

Call guide_msg("")

AcntNo.Data = SCREEN.Object("main.an1a").Data
zPwd.Data = SCREEN.Object("main.pwd").Data

If Len(Trim(zPwd.Data)) >= 4  Then
	SCREEN.OnSend = True
Else
	SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요."
	SCREEN.Object("main.GUIDE").TRgb = 94
End If

If SYSTEM.UserPass <> Trim(zPwd.Data) Then
	If Trim(zPwd.Data) <> "HEAD" And Len(Trim(zPwd.Data)) >= 4 Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
		zPwd.Data = "HEAD"
	ElseIf Trim(zPwd.Data) = "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = Trim(SCREEN.Object("main.LEDGER").EPwd)
		zPwd.Data = "HEAD"
	End If

	If Trim(zPwd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			SCREEN.Object("main.Pwd").Data = ""
			SCREEN.Object("main.Pwd").SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim nTemp, ii, nAdd

nAdd = (GRID0.Rows - nCurrRow) + 1

For ii = nCurrRow To GRID0.Rows
	If GRID0.GetGridCell(ii, 11) = "0.0000" Then
		nTemp = 0
	Else
		nTemp = FormatNumber(GRID0.GetGridCell(ii, 11) * 100, 2)
	End If

	GRID0.SetGridCell ii, 11, nTemp & "%"

	GRID0.SetGridCell ii, 12, Mid(Trim(GRID0.GetGridCell(ii, 12)), 3)
Next

nCurrRow = nCurrRow + nAdd

'담보유지율
If Trim(LoanRat.Data) = "" Then
	nTemp = ""
ElseIf Trim(LoanRat.Data) = "0.0000" Then
	nTemp = "0"
Else
	nTemp = CDbl(Trim(LoanRat.Data)) * 100
End If

If nTemp <> "" Then
	LoanRat.Data = nTemp & "%"
End If

If LEDGER.Next = "Y" Then
	SCREEN.Object("main.next_btn").Enable = True
Else
	SCREEN.Object("main.next_btn").Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

