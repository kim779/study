_AW_ONDECLARE_AW_
Sub InitConfig()
	Dim sVal

	CFG.LoadDefaultCfg()
	SetCfg()

	If UTAB0.Index = 0 Then
		ChangeTab(0)
	Else
		ChangeTab(1)
	End If
End Sub

Sub SetCfg()
	BuyQtyGB.Data = CFG.ReadCfg("BuyQtyGB")
	BuyFixQty.Data = CFG.ReadCfg("BuyFixQty")
	BuyFixPrcQty.Data = CFG.ReadCfg("BuyFixPrcQty")
	BuyPrcGB.Data = CFG.ReadCfg("BuyPrcGB")
	SellQtyGB.Data = CFG.ReadCfg("SellQtyGB")
	SellFixQty.Data = CFG.ReadCfg("SellFixQty")
	SellFixPrcQty.Data = CFG.ReadCfg("SellFixPrcQty")
	SellPrcGB.Data = CFG.ReadCfg("SellPrcGB")
	JJPrcGB.Data = CFG.ReadCfg("JJPrcGB")
	CursorPos.Data = CFG.ReadCfg("CursorPos")
	JJCursorPos.Data = CFG.ReadCfg("JJCursorPos")
	ShortCutKey.Data = CFG.ReadCfg("ShortCutKey")
	NotMoveCode.Data = CFG.ReadCfg("NotMoveCode")
	msgPopup.Data = CFG.ReadCfg("msgPopup")
	KeepPrc.Data = CFG.ReadCfg("KeepPrc")
	KeepQty.Data = CFG.ReadCfg("KeepQty")

	If Trim(msgPopup.Data) = "" Then
		msgPopup.Data = "1"
	End If

'	If KeepPrc.Data = "1" Then
'		OBJ.Proc "SetOD_PRC", "0"
'	Else
'		OBJ.Proc "SetOD_PRC", "1"
'	End If
'	If KeepQty.Data = "1" Then
'		OBJ.Proc "SetOD_QTY", "0"
'	Else
'		OBJ.Proc "SetOD_QTY", "1"
'	End If
End Sub

Sub SaveCfg()
'	CFG.WriteCfg "VolType", sVal
	CFG.WriteCfg "BuyQtyGB", BuyQtyGB.Data
	CFG.WriteCfg "BuyFixQty", BuyFixQty.Data
	CFG.WriteCfg "BuyFixPrcQty", BuyFixPrcQty.Data
	CFG.WriteCfg "BuyPrcGB", BuyPrcGB.Data
	CFG.WriteCfg "SellQtyGB", SellQtyGB.Data
	CFG.WriteCfg "SellFixQty", SellFixQty.Data
	CFG.WriteCfg "SellFixPrcQty", SellFixPrcQty.Data
	CFG.WriteCfg "SellPrcGB", SellPrcGB.Data
	CFG.WriteCfg "JJPrcGB", JJPrcGB.Data
	CFG.WriteCfg "CursorPos", CursorPos.Data
	CFG.WriteCfg "JJCursorPos", JJCursorPos.Data
	CFG.WriteCfg "ShortCutKey", ShortCutKey.Data
	CFG.WriteCfg "NotMoveCode", NotMoveCode.Data
	CFG.WriteCfg "msgPopup", msgPopup.Data

	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "ordcfg.ini", "common", "KeepQty", KeepQty.Data
		INFO.PushData LOGIN.Name, "ordcfg.ini", "common", "KeepPrc", KeepPrc.Data
	End If

	CFG.SaveCfg()
End Sub

Sub ChangeTab(idx)
	UTAB0.Index = idx
	Select Case idx
	Case 0
			OBJ.SetObject "IB1001C1"
			BuyQtyGB.Trigger "", False
			BuyFixQty.Trigger "", False
			BuyFixPrcQty.Trigger "", False
			BuyPrcGB.Trigger "", False
			SellQtyGB.Trigger "", False
			SellFixQty.Trigger "", False
			SellFixPrcQty.Trigger "", False
			SellPrcGB.Trigger "", False
			JJPrcGB.Trigger "", False
			KeepPrc.Trigger "", False
			KeepQty.Trigger "", False
	Case 1
			OBJ.SetObject "IB1001C2"
			CursorPos.Trigger "", False
			JJCursorPos.Trigger "", False
			ShortCutKey.Trigger "", False
			NotMoveCode.Trigger "", False
			msgPopup.Trigger "", False
	End Select
	SCREEN.Proc "obj.SetCfg", ""
End Sub

_AW_ONSTART_AW_
SetCfg()
ChangeTab(0)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(UTAB0)
_AW_ONCLICK_AW_
ChangeTab(UTAB0.Index)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
InitConfig()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
If UTAB0.Index = 0 Then
	ChangeTab(1)
Else
	ChangeTab(0)
End If

SaveCfg()
SYSTEM.Push "ModalResult", "OK"
SCREEN.CloseWindow
