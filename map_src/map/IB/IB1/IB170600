	Dim g_combo
	g_combo = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "G_COMBO"))
	gubn.Data = g_combo
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

If SYSTEM.ConnectBy = 1 Then

	If CheckInput(AN19, zPwd) = True Then
		ANCM.Data = h_acnm.Data
		SCREEN.onsend = True
 		'Exit Sub
	End If
Else
	SCREEN.onsend = True
	zPwd.Data = "9999"
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim Odata,Lendata,Cdata,Ccolor
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable True
	next_btn.Setfocus
Else
	next_btn.Enable False
	GRID0.SetFocus
End If

For i = gridpos+1 To GRID0.Rows
 If GRID0.GetGridCell(i,5) <> "" Then
