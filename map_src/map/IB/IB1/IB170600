_AW_ONDECLARE_AW_
Dim sect,gridpos
sect = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN19.Name
	h_acnm.Data = AN19.Name
	zPwd.Data = AN19.Password
	If Trim(AN19.Data) = "" Then
		AN19.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	Else
		zPwd.Data = "9999"
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	gridpos = 0
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
