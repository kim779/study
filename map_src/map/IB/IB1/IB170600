 	 	GRID0.SetGridCell i,5,Cdata&"%"
 		GRID0.SetTRgb i,5,94
 	ElseIf Color = "-" Then
 		Cdata = CDbl(Mid(Odata,2,Lendata-1))*100
 		GRID0.SetGridCell i,5,"-"&Cdata&"%"
 		GRID0.SetTRgb i,5,95
 	End If
 End If
 gridpos = gridpos+1
Next


If sect = 0 And LEDGER.Next <> "Y" Then
	zPwd.SetFocus
End If

