RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim xxxx_flag
xxxx_flag = 1	'-비밀번호체크

Sub order_tab_change()
	Select Case tab_order.ID
	Case "1" : OBJ_odr.SetObject("IB104050")
	Case "2" : OBJ_odr.SetObject("IB104060")
	Case "3" : OBJ_odr.SetObject("IB104080")	'-예약취소
	Case "5" : OBJ_odr.SetObject("IB104050")	'-신용대출매도
	Case "6" : OBJ_odr.SetObject("IB104060")	'-신용매수
	End Select
	OBJ_odr.Proc "sygb_proc", ""
	OBJ_odr.Proc "SetGaBthCheck", ""
	SCREEN.Proc "main.Set_init", ""
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password

	SCREEN.Proc "obj_odr.OBJ_JUNGSAN.CalcJungsan", ""	'계좌변경시 정산금액 계산 2010.02.05

	SCREEN.Proc "main.Set_account", "jumn"
	SCREEN.Object("obj_odr.o_jmno").Clear
	SCREEN.Object("main.guide").Text = ""
'	Call obj_svol.ClearAll(2)

	If xxxx_flag = 1 Then
		SCREEN.Proc "main.chk_xxxx", ""		'비밀번호 체크
		xxxx_flag = 0
	End If
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus : Exit Sub
	End If
End Sub

_AW_ONCLOSE_AW_
'예약주문(IB104000)에서 주문타입변경시 계좌비밀번호 유지
If SCREEN.GetMapName(1) = "IB104000" Then
	SCREEN.Object("main.xxxx").Text = Trim(AN1A.data&"|"&ed_pswd.Data)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_pswd)
_AW_ONCHANGE_AW_
