_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 Then
	SCREEN.Proc "main.all_account", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_order)
_AW_ONCLICK_AW_
Call order_tab_change()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


