RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim bFirst

Sub Init()
	bFirst = True
	SCREEN.Proc "parent.GetAllAccounts", "main.OBJ_accn.CB_ACNO"
	Call MyChangeCode()
End Sub

Sub MyChangeCode()
	If Trim(Code.Data) = "000000" Or Trim(Code.Data) = "" Then
		OBJ_hnam.Reload
		Exit Sub
	End If
	Code.Data = SCREEN.Object("main.1301").Data
	SCREEN.Object("OBJ_hnam.1301").data = Code.Data
	Call send_f()
End Sub

Sub send_f()
	OGRID.Clear
	zGroupNo.Data = ""
	zAcno.Data = ""

	If Len(Trim(Code.Data))<>6 Then
		MsgBox "종목코드를 확인하십시오.", vbOKOnly, "IBK투자증권"
		Exit Sub
	End If

	If CHK_SP.Checked = True Then
		zQryTp.Data = "3"
		zAcno.Data = CB_ACNO.Data
	Else
		zQryTp.Data = "2"
		zGroupNo.Data = SCREEN.Object("main.CB_GROUP").Data
	End If

	zIsuNo.Data = "A" & Code.Data
	LEDGER.Fkey = "C"
	LEDGER.Rcnt = "0030"
	SCREEN.Send 0
	SCREEN.SetTimer 1, False
End Sub

Sub send_n()
	OGRID.SetDataPosition 2
	LEDGER.Fkey = "7"
	LEDGER.Rcnt = "0030"
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
Call Init()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

If LEDGER.Next = "Y" Then
	Call send_n()
Else
	' 8/10
	hnam = Trim(SCREEN.GetName(100, Trim(Code.Data), 99))

	For ii=0 To OGRID.Rows
		pamt = OGRID.GetGridCell(ii, 8)
		tamt = OGRID.GetGridCell(ii, 10)
		damt = OGRID.GetGridCell(ii, 11)
		curr = OGRID.GetGridCell(ii, 6)

		' 종목명 세팅
		OGRID.SetGridCell ii, 4, hnam

		' 현재가 0일경우
		If Trim(curr)<>"" Then
			If CLng(curr)=0 Then
				OGRID.SetGridCell ii, 6, ""
			End If
		End If

		' 비중 계
		If IsNumeric(pamt) And IsNumeric(tamt) And IsNumeric(damt) Then
			pamt = CCur(pamt)
			tamt = CCur(tamt)
			damt = CCur(damt)

			OGRID.SetGridCell ii, 13, tamt+damt
			If tamt<>0 Then
				rate = CCur(pamt)/(CCur(tamt)+CCur(damt))*100.0
				If rate<1.0 Then
					OGRID.SetGridCell ii, 9, "0" & FormatNumber(rate, 4, TristateTrue)
				Else
					OGRID.SetGridCell ii, 9, FormatNumber(rate, 4, TristateTrue)
				End If
			Else
				OGRID.SetGridCell ii, 9, "0.0000"
			End If

		End If
	Next
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_

OBJ_hnam.Send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON6)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "Code", "hnam", 0 )
If retn <> True Then
      Exit Sub
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_SEND)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_EXCEL)
_AW_ONCLICK_AW_
OGRID.Excel True, True, ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(OGRID)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHK_SP)
_AW_ONCLICK_AW_
If CHK_SP.Checked Then
	CB_ACNO.Enable = True
Else
	CB_ACNO.Enable = False
End If

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CB_ACNO)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(Code)
_AW_ONCHANGE_AW_
