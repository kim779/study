RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim MapName
MapName = "IB120200"


Dim jango, sangjang, feeGubn, maeche, feePro, checha, mesuFee, medoFee, medoTax, pdaycday, loan, credit

Sub InitOption()
	jango = "5"
	sangjang = "0"
	feeGubn = "0"
	maeche = "00"
	feePro = ""
	checha = "+000000000000000"
	mesuFee = "0"
	medoFee = "0"
	medoTax = "0"
	pdaycday = "0"
	loan = "0"
	credit = "0"
End Sub

Sub GetOption()
'0.전체(KRX)
'1.D2(KRX)
'2.전체(NXT)
'3.D2(NXT)
'4.전체(통합)
'5.D2(통합)

	If rd11.Checked Then	'전부조회
	  	If rdM1.Checked Then '통합
	  		jango = "4"
	  	ElseIf rdM2.Checked Then 'KRX
	  		jango = "0"
	  	ElseIf rdM3.Checked Then 'NXT
	  		jango = "2"
	  	End If
	Else 'D2잔고 0이상만 조회
	 	If rdM1.Checked Then '통합
	  		jango = "5"
	  	ElseIf rdM2.Checked Then 'KRX
	  		jango = "1"
	  	ElseIf rdM3.Checked Then 'NXT
	  		jango = "3"
	  	End If
	End If


	If rd21.Checked Then
		sangjang = "0"	'출력
	Else
		sangjang ="1"	'미출력
	End If

	If rd31.Checked Then
		feeGubn = "0"	'미적용
	ElseIf rd32.Checked Then
		feeGubn ="1"	'평가시수수료적용
	Else
		feeGubn ="2"	'평가시상세옵션적용
	End If

	maeche = Trim(cbMeche.Data)	'매체코드

	feePro = Trim(edFeePro.Text)	'수수료율

	If Trim(feePro) = "" Then
		feePro = ""
'	ElseIf Len(Trim(feePro)) = 10 Then
	ElseIf CDbl(feePro) = 0 Then
		feePro = ""
	Else
		feePro = feePro
	End If

	checha = Trim(edChecha.Data)	'체차금액

	If Trim(checha) = "" Or Len(Trim(Replace(checha, "0", ""))) = 0 Then
		checha = "000000000000000"
	ElseIf Len(Trim(checha)) = 15 Then
		checha = "+" & checha
	End If

	If rd41.Checked Then
		mesuFee = "0"	'미적용
	Else
		mesuFee ="1"	'적용
	End If

	If rd51.Checked Then
		medoFee = "0"	'미적용
	Else
		medoFee ="1"	'적용
	End If

	If rd61.Checked Then
		medoTax = "0"	'미적용
	Else
		medoTax ="1"	'적용
	End If

	If rd71.Checked Then
		pdaycday = "0"	'미적용
	Else
		pdaycday ="1"	'적용
	End If

	If rd81.Checked Then
		loan = "0"	'미적용
	ElseIf rd82.Checked Then
		loan ="1"	'매입금액 포함
	Else
		loan ="2"	'매입금액 미포함
	End If

	If rd91.Checked Then
		credit = "0"	'미적용
	Else
		credit ="1"	'적용
	End If
End Sub

Sub SetOption()

	If Trim(jango) = "" Then
		jango = "5"
	End If
	
	Select Case Trim(jango)

		Case 0 '0.전체(KRX)
			rd11.Checked = True	'전부조회
			rdM2.Checked = True 'KRX

		Case 1 '1.D2(KRX)
			rd12.Checked = True	'0이상만 조회
			rdM2.Checked = True 'KRX

		Case 2 '2.전체(NXT)
			rd11.Checked = True	'전부조회
			rdM3.Checked = True 'NXT

		Case 3 '3.D2(NXT)
			rd12.Checked = True	'0이상만 조회
			rdM3.Checked = True 'NXT

		Case 4 '4.전체(통합)
			rd11.Checked = True	'전부조회
			rdM1.Checked = True '통합

		Case 5 '5.D2(통합)
			rd12.Checked = True	'0이상만 조회
			rdM1.Checked = True '통합

		Case Else
			rd12.Checked = True	'0이상만 조회
			rdM1.Checked = True '통합

	End Select

	If Trim(sangjang) = "0" Or Trim(sangjang) = "" Then
		rd21.Checked = True	'출력
	Else
		rd22.Checked = True	'미출력
	End If

	If Trim(feeGubn) = "0" Then
		rd31.Checked = True	'미적용
	ElseIf Trim(feeGubn) = "1" Or Trim(feeGubn) = "" Then
		rd32.Checked = True	'평가시수수료적용
	Else
		rd33.Checked = True	'평가시상세옵션적용
	End If

	cbMeche.Data = Trim(maeche)	'매체코드

	edFeePro.Data = Trim(feePro)	'수수료율


	edChecha.Data = Trim(checha)	'체차금액

	If Trim(mesuFee) = "0" Or Trim(mesuFee) = ""  Then
		rd41.Checked = True	'미적용
	Else
		rd42.Checked = True	'적용
	End If

	If Trim(medoFee) = "0" Then
		rd51.Checked = True	'미적용
	ElseIf Trim(medoFee) = "" Or Trim(medoFee) = "1" Then
		rd52.Checked = True	'적용
	End If

	If Trim(medoTax) = "0" Then
		rd61.Checked = True	'미적용
	ElseIf Trim(medoTax) = "" Or Trim(medoTax) = "1" Then
		rd62.Checked = True	'적용
	End If

	If Trim(pdaycday) = "0" Or Trim(pdaycday) = ""  Then
		rd71.Checked = True	'미적용
	Else
		rd72.Checked = True	'적용
	End If

	If Trim(loan) = "0" Or Trim(loan) = ""  Then
		rd81.Checked = True	'미적용
	ElseIf Trim(loan) = "1" Then
		rd82.Checked = True	'매입금액 포함
	Else
		rd83.Checked = True	'매입금액 미포함
	End If

	If Trim(credit) = "0" Or Trim(credit) = ""  Then
		rd91.Checked = True	'미적용
	Else
		rd92.Checked = True	'적용
	End If
End Sub

Sub p_write_ini()
	Call GetOption()

	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "jango", jango
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "sangjang", sangjang
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "feeGubn", feeGubn
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "maeche", maeche
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "feePro", feePro
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "checha", checha
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "mesuFee", mesuFee
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "medoFee", medoFee
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "medoTax", medoTax
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "pdaycday", pdaycday
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "loan", loan
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "credit", credit
	End If
End Sub

Sub p_read_ini()
'	Call initOption()

	If SCREEN.CreateObject("INFO") Then
		jango = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "jango"))
		sangjang = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "sangjang"))
		feeGubn = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "feeGubn"))
		maeche = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "maeche"))
		feePro = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "feePro"))
		checha = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "checha"))
		mesuFee = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "mesuFee"))
		medoFee = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "medoFee"))
		medoTax = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "medoTax"))
		pdaycday = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "pdaycday"))
		loan = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "loan"))
		credit = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "credit"))
	End If

	Call SetOption()
End Sub

Sub SetControl()
	Dim bEnable1, bEnable2

	bEnable1 = False
	bEnable2 = False

	If rd31.Checked Then
		bEnable1 = False
		bEnable2 = False
		rd41.Checked = True
		rd51.Checked = True
		rd61.Checked = True

		cbMeche.Clear
		edFeePro.Data = ""
		edChecha.Data = "+000000000000000"

	ElseIf rd32.Checked Then
		bEnable1 = True
		bEnable2 = False
		rd41.Checked = True
		rd52.Checked = True
		rd62.Checked = True

		If maeche ="" Then
			If SYSTEM.ConnectBy = 0 Then '고객
				cbMeche.Data = "01"	'HTS
			Else	'직원
				cbMeche.Data = "00" '영업점
			End If
		End If

	Else
		bEnable1 = True
		bEnable2 = True
	End If

	cbMeche.Enable = bEnable1
	edFeePro.Enable = bEnable1
	edChecha.Enable = bEnable1
	rd41.Enable = bEnable2
	rd42.Enable = bEnable2
	rd51.Enable = bEnable2
	rd52.Enable = bEnable2
	rd61.Enable = bEnable2
	rd62.Enable = bEnable2

End Sub

_AW_ONSTART_AW_
Call p_read_ini()
Call SetControl()
SCREEN.SetSize 543, 413

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(rd31)
_AW_ONCLICK_AW_
Call SetControl()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(rd32)
_AW_ONCLICK_AW_
Call SetControl()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(rd33)
_AW_ONCLICK_AW_
Call SetControl()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edFeePro)
_AW_ONCHARCHANGE_AW_
If IsNumeric(edFeePro.Data) = False Then
	edFeePro.Clear
ElseIf CDbl(edFeePro.Data) > 100 Or CDbl(edFeePro.Data) < 0 Then
	edFeePro.Clear
ElseIf Mid(Trim(edFeePro.Data),1,1) = "+" Or Mid(Trim(edFeePro.Data),1,1) = "-" Then
	edFeePro.Clear
Else
	Exit Sub
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_

If Trim(BUTTON0.Text) = "도움말▶" Then
	BUTTON0.Text = "도움말◀"
	SCREEN.SetSize 970, 415
	PANEL0.SetRect 0, 0, 970, 415
	BOX0.SetRect 5, 35, 967, 36
	BOX1.SetRect 5, 40, 967, 41
	BOX2.SetRect 5, 87, 967, 88
	BOX3.SetRect 5, 92, 967, 93
	BOX4.SetRect 5, 242, 967, 243
	BOX5.SetRect 5, 247, 967, 248
ElseIf Trim(BUTTON0.Text) = "도움말◀" Then
	BUTTON0.Text = "도움말▶"
	SCREEN.SetSize 542, 415
	PANEL0.SetRect 0, 0, 542, 415
	BOX0.SetRect 5, 35, 537, 36
	BOX1.SetRect 5, 40, 537, 41
	BOX2.SetRect 5, 87, 537, 88
	BOX3.SetRect 5, 92, 537, 93
	BOX4.SetRect 5, 242, 537, 243
	BOX5.SetRect 5, 247, 537, 248
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
Call p_write_ini()
SYSTEM.Push "detail_option","OK"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



