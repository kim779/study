RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	viewGrid.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0020"

SCREEN.OnSend = False

zIn.Data = "00001"
zQryTp.Data = Trim(SCREEN.Object("parent.zQryTp").Data)
zSrtDate.Data = Trim(SCREEN.Object("parent.zSrtDate").Data)
zEndDate.Data = Trim(SCREEN.Object("parent.zEndDate").Data)
zSrtAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

If Len(Trim(zSrtAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

zLoanPtnCode.Data = Trim(SCREEN.Object("parent.zLoanPtnCode").Data)

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	SCREEN.Object("parent.next_btn").Enable True
Else
	SCREEN.Object("parent.next_btn").Enable False
End If

If Left(ecod, 1) = "0" Then
	Dim jmcd
	jmcd = Left(Trim(viewGrid.GetGridCell(gridPos, 6)),2)
	'MsgBox jmcd
	If jmcd = "KR" Then
		'gridPos = CLng(viewGrid.Rows) + 1
		SCREEN.Proc "obj_getJmcd.send_f", gridPos
		gridPos = CLng(viewGrid.Rows) + 1
	End If
Else
	If ecod = "2679" Then
		Call guide_msg(Trim(LEDGER.Emsg))
	Else
		Call alert_msg(Trim(LEDGER.Emsg))
	End If

	If ecod = "1801" Or ecod = "3669" Then
		SCREEN.ClearAll 0, 2
		SCREEN.Object("parent.zPwd").SetFocus
		Exit Sub
	End If
End If

Call guide_msg(Trim(LEDGER.Emsg))

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(viewGrid)
_AW_ONCLICK_AW_
If viewGrid.HitPos <> 3 Then
	Exit Sub
End If

Dim jmcd
jmcd = Trim(viewGrid.GetGridCell(viewGrid.Row, 6))

If Len(jmcd) = 6 Then
	S1301.Data = jmcd
	S1301.Trigger "", True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



