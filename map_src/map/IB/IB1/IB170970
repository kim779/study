RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sect
sect = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN19.Name
	h_acnm.Data = AN19.Name
	zPwd.Data = AN19.Password
	If Trim(AN19.Data) = "" Then
		AN19.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data))  < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub tab_mainChange()
	Select Case tab_mainHangmok.ID
		Case 0 :
				SCREEN.ChangeMap "IB170900"
		Case 2 :
				SCREEN.ChangeMap "IB170910"
		Case 3 :
				SCREEN.ChangeMap "IB170920"
		Case 4 :
				SCREEN.ChangeMap "IB170930"
		Case 5 :
				SCREEN.ChangeMap "IB170940"
		Case 6 :
				SCREEN.ChangeMap "IB170950"
		Case 7 :
				SCREEN.ChangeMap "IB170960"
		Case 8 :
				SCREEN.ChangeMap "IB170970"
		Case 9 :
				SCREEN.ChangeMap "IB170980"
		Case 10 :
				SCREEN.ChangeMap "IB170990"
	End Select
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt = "0019"
tab_mainHangmok.ID = 8

If SCREEN.CreateObject("Info") Then
	Dim g_combo
	g_combo = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "G_COMBO"))
	gubn.Data = g_combo
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

If Len(Trim(AN19.Data)) < 11 Then
	MsgBox "계좌번호를 확인하십시오.",,"IBK투자증권"
	AN19.SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하십시오.",,"IBK투자증권"
		zPwd.SetFocus
		Exit Sub
	End If
End If

ANCM.Data = h_acnm.Data

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
Else
	If Trim(SYSTEM.UserPass) <> Trim(zPwd.Data) Then
		If Len(Trim(zPwd.Data)) >= 4 And Trim(zPwd.Data) <> "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If
	End If

	If Trim(zPwd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			zPwd.Data = ""
			zPwd.SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If
End If

SCREEN.onsend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable True
	next_btn.Setfocus
Else
	next_btn.Enable False
	GRID0.SetFocus
End If

If sect = 0 And LEDGER.Next <> "Y" Then
	zPwd.SetFocus
End If

BUTTON1.Enable = True

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If SCREEN.Key = 13 Then
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN19)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	sect = 0
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
sect = 1
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
sect = 1
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(lDps)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
'SCREEN.Print
GRID0.Excel True, True, "IB120340"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.DATA = GRID0.GetGridCell(GRID0.INDEX +1, 1)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.Data

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(gubn)
_AW_ONCHANGE_AW_

SCREEN.CreateObject("Info")
INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "G_COMBO", gubn.data

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_mainHangmok)
_AW_ONCLICK_AW_
Call tab_mainChange()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


