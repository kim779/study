RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sect
sect = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN1A.Name
	h_acnm.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0014"

'직원/고객에 따른 비밀번호 컨트롤 설정
Call Check_LoginType(zPwd)
'SCREEN.SetTimer 5,False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False


' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
Else
	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If Trim(zPwd.Data) <> "HEAD" And Len(Trim(zPwd.Data)) >= 4 Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If
	
		If Trim(zPwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				GUIDE.Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
				zPwd.Data = ""
				zPwd.SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If

If CheckInput(AN1A, zPwd) = True Then
	ANCM.Data = h_acnm.Data
	SCREEN.onsend = True
 	'Exit Sub
Else
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, str

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable True
	next_btn.Setfocus
Else
	next_btn.Enable False
	GRID0.SetFocus
End If

If sect = 0 And LEDGER.Next = "N" Then
	zPwd.SetFocus
End If
'
For ii = 1 To GRID0.Rows
	str = Trim(GRID0.GetGridCell(ii, 1))

	If Trim(Mid(str, 1, 1)) = "A" Then
		str = Mid(str, 2, Len(str))
	End If

	GRID0.SetGridCell ii, 1, str
Next

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
sect = 1
Call send_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	sect = 0
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
sect = 1
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_

Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(lDps)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(lMgnMny)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.DATA = GRID0.GetGridCell(GRID0.INDEX +1, 1)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.Data

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



