_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'== 차트조회
Sub send_o()
	SCREEN.Object("obj0.accn").data = AN1A.Data
	SCREEN.Object("obj0.pswd").data = zPwd.Data
	SCREEN.Object("obj0.symd").data = zStrDt.Data
	SCREEN.Object("obj0.eymd").data = zEndDt.Data
	SCREEN.Object("obj0.ymdf").data = zQryTermTp.Data
	obj0.Send
End Sub

'== 단위넣기
Sub send_u(unit)
	SCREEN.Object("obj0.unit").data = unit
	obj0.Send
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
End If

If CheckInput(AN1A, zPwd) = True Then
	SCREEN.onsend = True
	send_o()
 	Exit Sub
Else
	SCREEN.ClearAll 2, 2
	SCREEN.Object("obj0.ctl").clear
	SCREEN.Object("main.ACNM").data = SCREEN.Object("main.AN1A").Name
	SCREEN.Object("main.zPwd").SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Select Case sec.data
	Case "1"	SCREEN.Object("main.zPwd").SetFocus
	Case "2"	SCREEN.Object("main.send_btn").SetFocus
	Case "3"	SCREEN.Object("main.next_btn").SetFocus
	Case "4"	SCREEN.Object("main.chart").SetFocus
	Case "5"	SCREEN.Object("main.COMBO0").SetFocus
End Select

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 1,2
	SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN1A").Data
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus
End If


If LEDGER.Next = "Y" Then
	SCREEN.Object("main.next_btn").Enable = True
Else
	SCREEN.Object("main.next_btn").Enable = False
End If

SCREEN.Proc "main.send_g", LEDGER.Emsg

