RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.Object("obj.Ledger").FKey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	SCREEN.Object("obj.Ledger.FKey") = "7"
	SCREEN.Object("obj.GRID0").SetDataPosition(2)
	obj.Send
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
AN1A.Data = SCREEN.Object("main.OBJ_order.AN1A").Data
zPwd.Data = SCREEN.Object("main.OBJ_order.ed_pswd").Data
If Trim(AN1A.Data) = "" Or Trim(zPwd.Data) = "" Then
	Exit Sub
End If
'오브젝트에 데이터 날리기
If CheckInput(AN1A, zPwd) = True Then
	SCREEN.Object("obj.account").data = AN1A.Data
	SCREEN.Object("obj.zInputPwd").data = zPwd.Data
	SCREEN.Object("obj.zQryTp").data = zQryTp.Data
	SCREEN.Object("obj.zCmsnAmtAppTp").data = zCmsnAmtAppTp.Data

	b_chk.Data = "0"
	next_btn.Enable = False
	obj.Send

 	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zQryTp)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHECK0)
_AW_ONCLICK_AW_
If CHECK0.Checked = False Then
	zCmsnAmtAppTp.Data = 0
Else
    zCmsnAmtAppTp.Data = 1
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zOrdDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(COMBO0)
_AW_ONCHANGE_AW_
If COMBO0.Data = 0 Then
	zOrdDt.Visible = False
	obj.SetObject("IB100281")
ElseIf COMBO0.Data = 1 Then
	zOrdDt.Visible = True
	obj.SetObject("IB100282")
End If

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB130131 /t/s/p5/", ""
