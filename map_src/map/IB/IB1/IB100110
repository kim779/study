_AW_ONDECLARE_AW_
Dim g_ArrHogaCtrl

g_ArrHogaCtrl = Array(S17412, obj_10Hoga, 0)
'0:5호가, 1:10호가, 2:최초 실행시 보여지는 화면 인덱스
'-----------------------------------------------------------------------
Sub ProcSetVisible(Index)
	If Index = "0" Then	' 호가 컨트롤
		g_ArrHogaCtrl(0).visible = True
		g_ArrHogaCtrl(1).Visible = False
		g_ArrHogaCtrl(1).SetObject("IB10BLNK")
	Else				' 10호가맵
		g_ArrHogaCtrl(0).visible = False
		g_ArrHogaCtrl(1).Visible = True
		g_ArrHogaCtrl(1).SetObject("IB10011H")
		g_ArrHogaCtrl(1).Proc "SetDangaObject", "Main.OBJ_order.OBJ_odr.ed_jprc"
	End If

	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB100110", "HOGA_INDEX", Index
	End If
End Sub

