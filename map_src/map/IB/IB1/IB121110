_AW_ONDECLARE_AW_
'그리드 클릭시 데이터 매도탭에 전달
'대출일이 있을경우 신용매도 / 없을 경우 매도
Sub click_grid()
		Dim	jongmok_code, code, capacity, credit_date, val

		'종목번호
		jongmok_code = Trim(GRID0.GetGridCell(GRID0.Row, 1))
		code = Right(jongmok_code, 6)
		'보유잔고
		capacity = GRID0.GetGridCell(GRID0.Row, 5)
		'대출일
		credit_date = GRID0.GetGridCell(GRID0.Row, 20)

		If Trim(credit_date) = "" Then
		    val = "Order"
			SCREEN.proc "Main.setOrder", val&","&code&","&capacity
		Else
		    val = "creditOrder"
			SCREEN.proc "Main.setOrder", val&","&code&","&capacity
		End If

End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
Else
	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If Trim(zPwd.Data) <> "HEAD" And Len(Trim(zPwd.Data)) >= 4 Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If
	
		If Trim(zPwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If

If CheckInput(zAcntNo, zPwd) = True Then
	SCREEN.onsend = True

 	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'데이터가 15개 이상 있을 경우 계속 Append
If LEDGER.Next = "Y" Then
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End If

'비밀번호 오류시
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2,2
	SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.temp_ACNM").Data
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus
End If

If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	SCREEN.Object("main.BUTTON0").Enable = False
End If

