_AW_ONDECLARE_AW_
Sub OnGroup(group)
	S90303.Clear()
	SCREEN.Object("OBJ1.90303").Clear
	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If

	If Trim(group) <> "" Then
		codelist = DX_INTEREST.LoadCodeList(group)
		row = 1

		Do While Len(codelist) > 0
			parseData = Mid(codelist, 1, InStr(codelist, vbTab) -1)
			codelist = Mid(codelist, InStr(codelist, vbTab) + 1)
			If row < 14 Then
				S90303.InsertRow(-1)
				S90303.SetGridCell S90303.rows, 2, parseData
			Else
				SCREEN.Object("OBJ1.90303").InsertRow(-1)
				SCREEN.Object("OBJ1.90303").SetGridCell SCREEN.Object("OBJ1.90303").rows, 2, parseData
'				SCREEN.Object("OBJ1.90303").SetGridCell row-32, 2, parseData
			End If
			row = row + 1
		Loop

		SCREEN.Send 0
		OBJ1.Send
	End If
End Sub

Sub OnPredict(bNowPrice)
	If bNowPrice = "0" Then
		predict = True
	Else
		predict = False
	End If
	S90303.SetColumnVisible 5, predict
	S90303.SetColumnVisible 7, predict
	S90303.SetColumnVisible 9, predict
	S90303.SetColumnVisible 11, predict
	SCREEN.Object("OBJ1.90303").SetColumnVisible 5, predict
	SCREEN.Object("OBJ1.90303").SetColumnVisible 7, predict
	SCREEN.Object("OBJ1.90303").SetColumnVisible 9, predict
	SCREEN.Object("OBJ1.90303").SetColumnVisible 11, predict

	S90303.SetColumnVisible 4, Not predict
	S90303.SetColumnVisible 6, Not predict
	S90303.SetColumnVisible 8, Not predict
	S90303.SetColumnVisible 10, Not predict
	SCREEN.Object("OBJ1.90303").SetColumnVisible 4, Not predict
	SCREEN.Object("OBJ1.90303").SetColumnVisible 6, Not predict
	SCREEN.Object("OBJ1.90303").SetColumnVisible 8, Not predict
	SCREEN.Object("OBJ1.90303").SetColumnVisible 10, Not predict
End Sub

Sub send2(code)
	S1301.Data = code
	If Trim(S1301.Data) = "" Then
	    Exit Sub
	End If
	SCREEN.Proc "main.send_sise", "top" & "," & S1301.Data

	'If S1301.Data > 500000 Then
	If SCREEN.GetCodeType(S1301.Data) = 9 Then
		SCREEN.Object("main.E1301").Data = S1301.Data
		E1301.Trigger "E1301", True
		SCREEN.proc "main.send_sise_all", "main"
	End If
End Sub

_AW_ONSEND_AW_
