'SACMT207 비밀번호검증TR

SYSTEM.Push "stock_masu_order", "NO"
NREC.Pop("num")
L_CNT.Text = NREC.Data

'SYSTEM.Trace "s_data = " & s_data.Data
data_split()
Call GRID.SetCellFocus(1, 11)

If SYSTEM.ConnectBy = 0 Then
	If Trim(pswd.Data) = "9999" Then
		pswd.Data = ""
		pswd.SetFocus
