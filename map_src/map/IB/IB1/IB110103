_AW_ONDECLARE_AW_
Dim Mydata, mkgb

Function data_split()
	Mydata = Split(s_data.data, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)							' 한 레코드를 개체별로 자르는중..

		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(0))	'CUD		0
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))	'주문구분	1
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))	'시장구분	2 odgb
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))	'매매구분	3
		GRID.SetGridCell NREC.Data - ii, 5,Trim(Mydata(ii)(4))	'계좌번호	4
		GRID.SetGridCell NREC.Data - ii, 6,"HEAD"
	'	GRID.SetGridCell NREC.Data - ii, 6,Trim(Mydata(ii)(5))  '비밀번호	5
		GRID.SetGridCell NREC.Data - ii, 7,Trim(Mydata(ii)(6))	'주문번호	6
		GRID.SetGridCell NREC.Data - ii, 8,Trim(Mydata(ii)(7))	'종목코드	7
		GRID.SetGridCell NREC.Data - ii, 9,Trim(Mydata(ii)(8))	'종목명		8
		GRID.SetGridCell NREC.Data - ii, 10,Trim(Mydata(ii)(9))	'주문수량(정정, 취소수량)	9
		GRID.SetGridCell NREC.Data - ii, 11,Trim(Mydata(ii)(10))'주문가격	10
		GRID.SetGridCell NREC.Data - ii, 13,Trim(Mydata(ii)(11))'호가구분	11
		GRID.SetGridCell NREC.Data - ii, 14,Trim(Mydata(ii)(12))'주문조건	12
		GRID.SetGridCell NREC.Data - ii, 15,Trim(Mydata(ii)(13))'모두구분	13
		GRID.SetGridCell NREC.Data - ii, 16,Trim(Mydata(ii)(14))'처리구분	14
		GRID.SetGridCell NREC.Data - ii, 20,Trim(Mydata(ii)(15))'ii			15
		mkgb = Trim(Mydata(ii)(1))'시장구분자	16
		If mkgb = "" Then
			mkgb = "1"	' KRX
		End If
		GRID.SetGridCell NREC.Data - ii, 21, mkgb
		GRID.SetPRgb NREC.Data - ii, 11, 78
	Next

	If NREC.Data - 1> 0 Then
	 	SCREEN.SetTimer 5, False
	End If
End Function

Sub AllModify()
	Dim ii

	For ii=1 To GRID.Rows
		GRID.SetGridCell ii, 6, Trim(pswd.Data)
	Next

	SCREEN.Send 0
End Sub

Sub Set_account()
	ACNM.Data = AN1A.name
	acct.Data = AN1A.data
'	pswd.Data = AN1A.Password
End Sub

