_AW_ONDECLARE_AW_
Sub QueryAccID()
	Dim row, idx

	idx = 0
	IOGRID.SetRows 1000

	ACTF.Data = "D"
	For row=1 To VGRID.Rows
		If Len(Trim(VGRID.GetGridCell(row, 1)))=0 Then
			Exit For
		End If

		idx = idx + 1
		IOGRID.SetGridCell idx, 1, VGRID.GetGridCell(row, 1)
	Next

	IOGRID.SetRows idx
	NREC.Data = idx

	SCREEN.Send 0
End Sub

Sub UpdateAccID()
	Dim row, idx

	idx = 0
	IOGRID.SetRows 1000

	ACTF.Data = "U"
	For row=1 To VGRID.Rows
		If Len(Trim(VGRID.GetGridCell(row, 1)))=0 Then
			Exit For
		End If

		If VGRID.GetGridCell(row,3)<>VGRID.GetGridCell(row,4) Then
			idx = idx + 1
			IOGRID.SetGridCell idx, 1, VGRID.GetGridCell(row, 1)
			IOGRID.SetGridCell idx, 2, VGRID.GetGridCell(row, 3)
		End If
	Next
	If idx<1 Then
		MsgBox "변경된 내용이 존재하지 않습니다.", vbOKOnly, "IBK투자증권"
		Exit Sub
	End If
	IOGRID.SetRows idx
	NREC.Data = idx

	SCREEN.Send 0
End Sub

Sub LoadAccounts()
	VGRID.Clear

	Dim accList, ii, acc, acno, acnm, acid, actp, idx, myAcntFlag, value
	accList = Split(CX_DTS.GetTypeData ("4","1" ), vbLf, -1, vbTextCompare)  ''accoutcc 로 전계좌 불러오기 0->1
	idx = 1

	For ii=0 To UBound(accList)
		acc = Trim(accList(ii))
		If Len(acc)>11 Then
			acc = Split(acc, "|", -1, vbTextCompare)
			acno = Trim(Mid(acc(0), 1, 11))
			acnm = Mid(acc(0), 12)
			acnm = Replace(acnm, vbTab, "")
			acnm = Trim(acnm)
			acid = Trim(acc(1))
			actp = Mid(acno, 4, 2)
			myAcntFlag = acc(2)

			'VIP전용화면으로 고객용으로만 조회가능
			'계좌플래그 2 또는 3 이면 랩계좌      법인계좌 타입 = 4
			'랩계좌 제외
			If chkNumericData(myAcntFlag) = True Then
			'	If CLng(myAcntFlag) = 0 Or CLng(myAcntFlag) = 1 Then
				value = myAcntFlag And 2    '랩계좌 2 와 And 연산
			    If value = 0 Then
					If actp="10" Or actp="51" Then
						VGRID.SetGridCell idx, 1, acno
						VGRID.SetGridCell idx, 2, acnm
						VGRID.SetGridCell idx, 3, acid
						VGRID.SetGridCell idx, 4, acid
						idx = idx + 1
					End If
				End If
			End If
		End If
	Next

	If idx>20 Then
		VGRID.SetRows idx
	Else
		VGRID.SetRows 21
	End If
End Sub

Sub GridCheck()
'	For i=1 To VGRID.Row
'		If VGRID.GetGridCell(i, 3)<>VGRID.GetGridCell(i,4) Then
'			VGRID.SetTRgb i, 3, 209
'		End If
'	Next
	Dim row
	row = VGRID.Row
	If Trim(VGRID.GetGridCell(row, 3))<>Trim(VGRID.GetGridCell(row,4)) Then
		VGRID.SetTRgb row, 3, 209
	Else
		VGRID.SetTRgb row, 3, 69
	End If
End Sub

Sub ApplyTo(target, t_acno_idx, t_acid_idx)
	Dim tgrid
	Set tgrid = SCREEN.Object(target)
	If IsNull(tgrid) Then
		Exit Sub
	End If
	'SYSTEM.Trace "Target Index : " & t_acid_idx
	For i=1 To tgrid.Rows
		For j=1 To VGRID.Rows
			If Trim(tgrid.GetGridCell(i, t_acno_idx))=Trim(VGRID.GetGridCell(j, 1)) Then
				'SYSTEM.Trace "Find |" & Trim(tgrid.GetGridCell(i, t_acno_idx)) & "|" & Trim(VGRID.GetGridCell(j, 1)) & "|"
				tgrid.SetGridCell i, t_acid_idx, VGRID.GetGridCell(j, 3)
				Exit For
			End If
		Next
	Next

	'20250327 1904는 혁신부 요청 코스콤 오름차순으로 그대로 조회 1903은 그대로 놔둠
	If SCREEN.GetMapName(0) = "IB190300" Then
		SCREEN.Object("parent.GRID0").Sort 5, True, True
	End If
End Sub

Sub Refresh()
	Call LoadAccounts()
	Call QueryAccID()
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call LoadAccounts()
Call QueryAccID()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

GUIDE.Text = EMSG.Data

If ACTF.Data = "D" Then
	For i=1 To IOGRID.Rows
		If IOGRID.GetGridCell(i, 1)=VGRID.GetGridCell(i,1) Then
			VGRID.SetGridCell i, 3, IOGRID.GetGridCell(i, 2)
			VGRID.SetGridCell i, 4, IOGRID.GetGridCell(i, 2)
		End If
	Next
End If

If ACTF.Data = "U" Then
	' 성공하면 기존ID컬럼을 갱신한다.
	If Mid(EMSG.Data, 1, 1)="0" Then
		For i=1 To VGRID.Rows
			VGRID.SetGridCell i, 4, VGRID.GetGridCell(i, 3)
			VGRID.SetTRgb i, 3, 69
		Next
	End If
End If

