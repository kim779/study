Option Explicit

Sub Set_account()
	SCREEN.ClearAll 0, 2
	zPwd.Clear

	obj0.ClearAll 2

	If SYSTEM.ConnectBy = "0" Then
		If Len(Trim(AN99.Data)) <> 11 Then
			Exit Sub
		End If
	Else
		If Len(Trim(AN00.Data)) = 11 Then
			ACNM.Data = Trim(AN00.Name)
			zPwd.Data = Trim(AN00.Password)

			If Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If
		Else
			AN00.SetFocus
			Exit Sub
		End If
	End If

	SCREEN.Proc "obj0.send_f", ""
End Sub


