_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB104099) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "4"
Function Null_check(Data)
    Null_check = Data
    If Trim(data) = "" Then
        Null_check = "NO"
        Exit Function
    End If
End Function
'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN16.name
	ed_pswd.Data = AN16.pswd
	SCREEN.Proc "main.Set_account", "jumn"
	o_jmno.Clear
	mesg.Text = ""
End Sub

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos
	Dim mdgb, dmsg
	Dim sHnam

	SYSTEM.Push "stock_cancel_order", ""
	Call init_data()									'주문 기본세팅

	If Error_check() = False Then				'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		If r_mdgb1.Checked = True Then
			mdgb = "일부취소"
		Else
			mdgb = "전부취소"
		End If

		sHnam = Replace(Mid(SCREEN.Object("OBJ_hnam.1022").Data,2), "/","／")
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & sHnam & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_mdgb" & vbTab & mdgb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf
		SCREEN.CreateWindow 2, "IB10018A /p5 /d", dmsg
		If SYSTEM.Pop("stock_cancel_order") <> "OK" Then
			Exit Sub
		End If
	End If
	'SCREEN.Object("parent.obj_snd").send		'주문전송
	jmbtclick.Data = 1
	obj_canc.Send

	Call QueryOption("after")

	cPos = OrdCfg.ReadCfg("CursorPos")
	Select Case cPos
		Case "0" : SCREEN.Object("parent.AN1A").SetFocus()
		Case "1" : SCREEN.Object("parent.ed_pswd").SetFocus()
		Case "2" : S1301.SetFocus()
		Case "3" : ed_jqty.SetFocus()
		Case "4" : ed_jprc.SetFocus()
	End Select
End Sub

