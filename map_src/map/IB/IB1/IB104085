Dim yn
If SCREEN.CreateObject("info") Then
	yn = Null_check(Trim(INFO.popdata(LOGIN.name, "userconf.ini", "S-ORD", "ORD_CONF")))
End If

If yn = "NO" Then
	chk_OrderConfirm.Checked = SCREEN.Object("parent.chk_OrderConfirm").Checked
