RESOURCE DIVISION
{


_AW_ONSEND_AW_
SCREEN.OnSend = False

Dim act
Dim fir, sec, third
e_acnt_no.Data = SCREEN.Object("parent.AN5A").data
e_usernm.Data = Trim(LOGIN.Name)

If Len(Trim(e_acnt_no.Data)) <> 11 Then
'	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.AN5A").SetFocus
	Exit Sub
End If

'0:조회 1:등록 2:변경 3:해지
If e_use_yn.Data = "1" Or e_use_yn.Data = "2" Then
	If SCREEN.Object("parent.CHECK0").Checked = True Then
		e_sms_rqst_cncl_f.Data = "1"
	Else
		e_sms_rqst_cncl_f.Data = "2"
	End If

	If SCREEN.Object("parent.CHECK1").Checked = True Then
		e_push_rqst_cncl_f.Data = "1"
	Else
		e_push_rqst_cncl_f.Data = "2"
	End If

	If SCREEN.Object("parent.CHECK2").Checked = True Then
		e_mts_push_rqst_cncl_f.Data = "1"
	Else
		e_mts_push_rqst_cncl_f.Data = "2"
	End If
Else
	e_sms_rqst_cncl_f.Data = ""
	e_push_rqst_cncl_f.Data = ""
	e_mts_push_rqst_cncl_f.Data = ""
End If






SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_


e_acnt_no.Data = ""

If Trim(o_rslt_clsf.Data) = "0000" Then
	'조회면 셋팅
	If e_use_yn.Data = "0" Then
		Dim szCheck
		If o_sms_rqst_cncl_f.Data = "1" Then
			SCREEN.Object("parent.CHECK0").Checked = True
			szCheck = "1"
		Else
			SCREEN.Object("parent.CHECK0").Checked = False
			szCheck = "0"
		End If

		If o_push_rqst_cncl_f.Data = "1" Then
			SCREEN.Object("parent.CHECK1").Checked = True
			szCheck = szCheck & "1"
		Else
			SCREEN.Object("parent.CHECK1").Checked = False
			szCheck = szCheck & "0"
		End If

		If o_mts_push_rqst_cncl_f.Data = "1" Then
			SCREEN.Object("parent.CHECK2").Checked = True
			szCheck = szCheck & "1"
		Else
			SCREEN.Object("parent.CHECK2").Checked = False
			szCheck = szCheck & "0"
		End If

		'수정체크용 데이터
		SCREEN.Object("parent.E_CHCHECK").Data = szCheck


		'0:조건없음 1:저장된 조건있음 2:감시중인 조건 있음
		SCREEN.Object("parent.e_tot_clsf").data = o_tot_clsf.Data
	ElseIf e_use_yn.Data = "2" Then
		'변경완료 메세지
		SCREEN.Proc "main.ShowMsg", "MODY"
	End If
ElseIf Trim(o_rslt_clsf.Data) = "0001" Then
	SCREEN.Object("main.guide").text = "[서버자동주문] " & Trim(o_errmsg.Data)
Else
	SCREEN.Object("main.guide").text = "[서버자동주문] " & Trim(o_errmsg.Data)
	MsgBox Trim(o_errmsg.Data)
End If

_AW_ONENDSUB_AW_
}



