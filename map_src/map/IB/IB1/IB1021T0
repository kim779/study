Sub SetPassword(sData)
	Dim Ifind, sAcc, sPass
	ifind = InStr(sData, "-")
	sAcc = Trim( Left(sData, Ifind-1) )
	sPass = Trim( Mid(sData, Ifind+1, Len(sData)- Ifind) )

	If Trim(SCREEN.Object("OBJ_order.AN1A").data) = sAcc Then
		If sPass <> "" Then
			SCREEN.Object("OBJ_order.ed_pswd").data = sPass
		End If
	End If

End Sub

Sub SetData()
	Dim arr
	arr = Split(Trim(domino.Data), "|")

	'arr(0) - 화면구분, arr(1) - 계좌, arr(2) - 계좌명, arr(3) - 신용구분, arr(4) - 신용코드, arr(5) - 잔고, arr(6) - 신용일자
	If Trim(SCREEN.Object("OBJ_order.AN1A").Data) <> Trim(arr(1)) Then
		SCREEN.Object("OBJ_order.AN1A").Data = Trim(arr(1))
		SCREEN.Proc "OBJ_order.Set_account", ""
		SCREEN.Object("OBJ_order.ACNM").Data = Trim(arr(2))
	End If

	If Trim(arr(0)) = "실시간" Then
		If Trim(arr(3)) = "01" And Trim(arr(4)) = "80" Then
			SCREEN.SetTimer 3, False
		Else
			GUIDE.Text = "주식주문탭을 선택하여 주십시오."
			Exit Sub
		End If
	Else
		GUIDE.Text = "주식주문탭을 선택하여 주십시오."
		Exit Sub
	End If
End Sub

Sub ChangeCode(codx)
	SCREEN.Object("OBJ_order.OBJ_odr.1301").Data = codx
	SCREEN.Proc "OBJ_order.OBJ_odr.ChangeCode", ""
End Sub

Sub Set_prc(data)
	If Trim(data) = "" Then
		Exit Sub
	End If

	If SCREEN.Object("OBJ_order.tab_order").id <> 3 Then
		If SCREEN.Object("OBJ_order.obj_odr.CHK_auto").checked = False Then
			SCREEN.Object("OBJ_order.obj_odr.ed_jprc").data = data
		End If
	End If
End Sub


Sub MKTriggerFromMain(sdata)
	cxMarket.sMarket = sdata
	SCREEN.Object("OBJ_order.obj_odr.cxMarket").sMarket = sdata
	SCREEN.Proc "OBJ_order.obj_odr.Set_1000_OrderMap",""
End Sub

