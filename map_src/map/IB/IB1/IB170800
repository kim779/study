	MsgBox "종합계좌번호를 확인하여 주십시오.", , "IBK투자증권"
	AN99.SetFocus
	Exit Sub
End If

If Mid(Trim(AN99.Data), 4, 2) <> "00" Then
	MsgBox "종합계좌번호(ex.001-00-123456)를 확인하여 주십시오.", , "IBK투자증권"
	AN99.SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 And Trim(zPwd.Data) = "" Then
    zPwd.Data = "9999"
Else
    If Len(Trim(zPwd.Data)) < 4 Then
        MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
        zPwd.SetFocus
        Exit Sub
    End If
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
	Call send_c()
	cnt = cnt + 1
Else
	send_btn.SetFocus
End If

If sect = 0 And LEDGER.Next <> "Y" Then
	zPwd.SetFocus
End If

BUTTON0.Enable = True
BUTTON1.Enable = True

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If SCREEN.Key = 13 Then
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN99)
