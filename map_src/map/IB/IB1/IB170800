_AW_ONDECLARE_AW_
Dim sect, cnt
sect = 0
cnt = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	ANCM.Data = AN99.Name
	h_acnm.Data = AN99.Name
	zPwd.Data = AN99.Password

	If Len(Trim(AN99.Data)) <> 11 Then
		AN99.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ANCM.Data = AN99.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt = "0010"
'help.Data = "False"

If SCREEN.CreateObject("Info") Then
	Dim g_combo
	g_combo = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "G_COMBO"))
	gubn.Data = g_combo
End If

gubn.Data = 1

If SYSTEM.ConnectBy = "1" Then
	BUTTON0.Enable = False
	BUTTON0.Visible = False
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
