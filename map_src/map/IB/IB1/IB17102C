End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Or LEDGER.Ecod = "1001"Then
	SCREEN.ClearAll 1,2
	If SCREEN.Object("main.sect").Data = "1" Then
		SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN99").name
	Else
		SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN98").name
	End If
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus
Else
	Select Case Trim(pay.data)
		Case "01"
			paymthd.Data = "임의식"
		Case "02"
			paymthd.Data = "거치식"
		Case "03"
			paymthd.Data = "월정액적립식"
		Case "04"
			paymthd.Data = "자유적립식"
		Case "91"
			paymthd.Data = "분할납입식"
		Case "92"
			paymthd.Data = "할부식"
	End Select

End If

