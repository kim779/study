_AW_ONSTART_AW_
juno.Data = LOGIN.juno
S1301.Data = ""

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii,jj
If LEDGER.Next = "Y" Then
	For ii=trcnt.Data*LEDGER.Rcnt+1 To (trcnt.Data+1)*LEDGER.Rcnt
		GRID0.SetGridCell ii, 5, Trim(GRID0.GetGridCell (ii,5))
		GRID0.SetGridCell ii, 6, Trim(GRID0.GetGridCell (ii,6))
	Next
	trcnt.Data = trcnt.Data + 1
	Call Send_c()
Else
	If trcnt.Data*LEDGER.Rcnt = 0 Then
		jj = 1
	Else
		jj = 0
	End If
	For ii=jj To GRID0.Rows
		GRID0.SetGridCell ii, 5, Trim(GRID0.GetGridCell (ii,5))
		GRID0.SetGridCell ii, 6, Trim(GRID0.GetGridCell (ii,6))
	Next
End If

