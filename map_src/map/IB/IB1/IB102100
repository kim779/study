Sub SetHogaVisible()
	If  OBJ_sise.GetObject = "IB102110" Then
		Sindex = "0"
		If SCREEN.CreateObject("Info") Then
			Sindex = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB102110", "HOGA_INDEX"))
			If Len(Sindex) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB102110", "HOGA_INDEX", "0"
				Sindex = "0"
			End If
		End If
		If SIndex = "0" Then
			bt_Hoga.Text = "10호가"
		Else
			bt_Hoga.Text = "5호가"
		End If
		OBJ_sise.Proc "ProcSetVisible", Sindex
	End If
End Sub


Sub change_tab1()
	Select Case TAB1.ID
		Case 0
			OBJ_account.SetObject ("IB102121")
			OBJ_account.Send
		Case 1
			OBJ_account.SetObject ("IB102124")
