Sub Set_prc(data)
	If Trim(data) = "" Then
		Exit Sub
	End If

	If SCREEN.Object("OBJ_order.tab_order").id <> 3 Then
		If SCREEN.Object("OBJ_order.obj_odr.CHK_auto").checked = False Then
			SCREEN.Object("OBJ_order.obj_odr.ed_jprc").data = data
		End If
	End If
End Sub





'========================================
' 하위 OBJ에 시장구분자 세팅 후 조회 발생
'========================================
Sub Change_MKGubn_Main(sMKGubn)

	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "MKgubn", sMKGubn
	End If

	'=====================
	' 직전 시장구분자 저장
	'=====================
	Dim tMKGubn
	tMKGubn = cxMarket.sMarket

	'================================================================
	' 소속 OBJ 내의 cxMarket 시장 구분을 Main 시장구분으로 세팅
	'================================================================
	' 여기서 시장구분자 보정 후 Change_MKGubn_Main_Limited 함수 호출되어서
	' 하위 오브젝트에 시장 자동으로 전파한다.
	'================================================================
	Call Spread_mkgb(S1301.Data, sMKGubn)


	'================================================================
	' 시장 변동이 없을 경우 조회 Send 발생 SKIP 처리
	'================================================================
	' Spread_mkgb() 함수 이후의 시장구분자는 보정되고 난 다음의 시장구분자이다.
	'================================================================
	If tMKGubn = cxMarket.sMarket Then
		Exit Sub
	End If


	'====================
	' 하단 원장 OBJ 조회
	'====================
	Call Change_MKGubn_Main_Send()
End Sub


'=========================================
' 하위 OBJ에 시장구분자 세팅 (조회 미발생)
'=========================================
Sub Change_MKGubn_Main_Limited(sMKGubn)

	' 직전 시장구분자 저장
	Dim tMKGubn
	tMKGubn = cxMarket.sMarket

	SCREEN.IgnoreChange True
	cxMarket.sCode = S1301.Data
	cxMarket.sMarket = sMKGubn

	SCREEN.Proc "Main.OBJ_sise.Change_MKGubn_OBJ"             , sMKGubn
	SCREEN.Proc "Main.OBJ_order.OBJ_odr.Change_MKGubn_OBJ"    , sMKGubn
	SCREEN.Proc "Main.OBJ_order.OBJ_account.Change_MKGubn_OBJ", sMKGubn
	SCREEN.Proc "Main.OBJ_account.Change_MKGubn_OBJ"          , sMKGubn

	SCREEN.IgnoreChange False

	' 시장 변동 발생 시 조회 발생
	If tMKGubn <> cxMarket.sMarket Then
		Change_MKGubn_Main_Send()
		Exit Sub
	End If

End Sub



'=====================================
' 하위 OBJ 시장 변동에 따른 Send 발생
