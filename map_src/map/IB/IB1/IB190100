'IB190130의 GD_ORDER의 컬럼을 수정 할 경우 메인의 GD_ORDER도 같이 맞춰줘야한다.
Sub SaveOrderGrid()
	Dim grid
	Set grid = SCREEN.Object("OBJ_accn.GD_ORDER")

	GD_ORDER.SetRows grid.Rows
	For ii=1 To grid.Rows
		For jj=1 To grid.Columns
			GD_ORDER.SetGridCell ii, jj, Trim(grid.GetGridCell(ii, jj))
			GD_ORDER.SetTRgb ii, jj, grid.GetTRgb(ii, jj)
		Next
	Next

	s_btn_masu = SCREEN.Object("OBJ_accn.BTN_MASU").Visible
	s_btn_mado = SCREEN.Object("OBJ_accn.BTN_MADO").Visible
	LBL_INFO.Data = SCREEN.Object("OBJ_accn.LBL_INFO").Data
End Sub

'IB190130의 GD_ORDER의 컬럼을 수정 할 경우 메인의 GD_ORDER도 같이 맞춰줘야한다.
Sub LoadOrderGrid()
	Dim grid
	Set grid = SCREEN.Object("OBJ_accn.GD_ORDER")

	grid.SetRows GD_ORDER.Rows
	For ii=1 To GD_ORDER.Rows
		For jj=1 To GD_ORDER.Columns
			If jj=12 Then
				tmp = Trim(GD_ORDER.GetGridCell(ii, jj))
				If tmp="매도" Then
					grid.SetGridCell ii, jj, "-" & tmp
				Else
					grid.SetGridCell ii, jj, "+" & tmp
				End If
			Else
				'SYSTEM.Trace "cell[" & ii & ", " & jj & "] text[" & Trim(GD_ORDER.GetGridCell(ii, jj)) & "]"
				grid.SetGridCell ii, jj, Trim(GD_ORDER.GetGridCell(ii, jj))
				grid.SetTRgb ii, jj, GD_ORDER.GetTRgb(ii, jj)
			End If
		Next
	Next

	SCREEN.Object("OBJ_accn.BTN_MASU").Visible = s_btn_masu
	SCREEN.Object("OBJ_accn.BTN_MADO").Visible = s_btn_mado
	SCREEN.Object("OBJ_accn.LBL_INFO").Data = LBL_INFO.Data
End Sub

Sub tab_accn_change(id)
	Dim map, pmap

	pmap = OBJ_accn.GetObject()

	If id=1 Then
		map = "IB190130"
	ElseIf id=2 Then
		map = "IB190170"
	ElseIf id=3 Then
		map = "IB190171"
	ElseIf id=4 Then
		map = "IB190131"
	End If

	If pmap="IB190130" And pmap<>map Then
		Call SaveOrderGrid()
	End If

	tab_accn.ID = id
	If map<>OBJ_accn.GetObject() Then
		OBJ_accn.SetObject map
	End If

	If pmap<>"IB190130" And map="IB190130" Then
		Call LoadOrderGrid()
	End If

	GUIDE.Text = ""
End Sub

