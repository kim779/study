_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim irank, irows
initflag = True

If S200300.Rows < 1 Then
	Exit Sub
End If

Select Case grdact
Case "up"
	S200300.Index S200300.Rows - 3
	S200300.Index S200300.Rows - 2
	S200300.Index S200300.Rows - 1
	'SYSTEM.Trace "onreceive up "& (S200300.Rows - 1)
Case "dn"
	'SYSTEM.Trace "onreceive dn"
End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(200300)
_AW_ONCLICK_AW_
Dim codx, irow
If S200300.HitPos = 3 Then
	codx = S200300.GetGridCell(S200300.Row, 3)
	SCREEN.Object("main.1301").Data = codx
	SCREEN.Proc "main.code_change", "main"
ElseIf initflag = True Then
	grdact = ""
	Select Case S200300.HitPos
	Case 1, 5
		grdact = "up"
	Case 2, 6
		grdact = "dn"
	End Select
End If
