_AW_ONDECLARE_AW_
Dim initflag, grdact
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)
initflag = False
grdact = ""
Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "upgb", upgb.Data
		INFO.pushData LOGIN.Name, myFILE, myMAP, "sort", S200902.Data
		'SYSTEM.Trace "write="&Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "upgb"))
	End If
End Sub

Sub p_read_ini()
	Dim supgb, ssort
	If SCREEN.CreateObject("Info") Then
		supgb = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "upgb"))
		ssort = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "sort"))

		If supgb <> "" Then
			upgb.Data = supgb
		End If
		If ssort <> "" Then
			S200902.Data = ssort
		End If
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
