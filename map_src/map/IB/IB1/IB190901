Sub ch_hoga(txt)
	If txt = "10호가" Then
		tab1.ID = 0
		tab1.SetTabVisible 1, False
		tab1.SetTabVisible 2, False
		tab2.Visible = False
		OBJ1.Visible = False
		OBJ1.Proc "fn_visible", "False"
		btn_Hoga.Text = "5호가"
		OBJ0.SetRect 0, 169, 394, 450
		OBJ0.SetObject("IB19090A")
	Else
		tab1.ID = 0
		tab1.SetTabVisible 1, True
		tab1.SetTabVisible 2, True
		tab2.Visible = True
		OBJ1.Visible = True
		OBJ1.Proc "fn_visible", "True"
		btn_Hoga.Text = "10호가"
		OBJ0.SetRect 0, 169, 394, 303
		OBJ0.SetObject("IB19090B")
	End If
End Sub

Sub Redraw()
	If tab1.ID <> 0 Then
		Exit Sub
	End If
	If btn_Hoga.Text = "5호가" Then
		OBJ0.SetRect 0, 169, 394, 450
		OBJ0.SetObject ""
		OBJ0.SetObject("IB19090A")
	Else
		OBJ0.SetRect 0, 169, 394, 303
		OBJ0.SetObject ""
		OBJ0.SetObject("IB19090B")
	End If
End Sub

