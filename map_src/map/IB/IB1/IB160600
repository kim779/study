RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim continue_Inx

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 2,2
	ACNM.Data = AN1A.Name
	LEDGER.Fkey = "C"
	continue_Inx = 1
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	continue_Inx = continue_Inx + 1
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

If SYSTEM.ConnectBy = 1 Then

	If CheckInput(AN1A, zPwd) = True Then
		SCREEN.onsend = True
	 	'Exit Sub
	End If

	If Trim(SYSTEM.UserPass) <> Trim(zPwd.Data) Then
		If Len(Trim(zPwd.Data)) >= 4 And Trim(zPwd.Data) <> "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If
	End If

	If Trim(zPwd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			zPwd.Data = ""
			zPwd.SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If

Else

	zPwd.Data = "9999"
	SCREEN.onsend = True
	'SCREEN.ClearAll 2, 2
	'ACNM.Data = AN1A.Name
	'zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
Else
	Select Case selection.Data
		Case "1"	zPwd.SetFocus()
		Case "2"	send_btn.SetFocus()
		Case "3"	next_btn.SetFocus()
	End Select
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

Dim ii, exTax, cmAmt, trTax, fsTax, inTax, ihTax, plRat
Dim startRow

If continue_Inx = "1" Then
	startRow = 1
Else
	startRow = LEDGER.Rcnt * (continue_Inx - 1) + 1
End If


For ii = startRow To GRID0.Rows

	cmAmt = GRID0.GetGridCell(ii, 18)	'--수수료
	trTax = GRID0.GetGridCell(ii, 19)	'--거래세
	fsTax = GRID0.GetGridCell(ii, 20)	'--농특세
	intax = GRID0.GetGridCell(ii, 21)	'--소득세
	ihTax = GRID0.GetGridCell(ii, 22)	'--주민세
	plRat = GRID0.GetGridCell(ii, 9)	'--담보비율

	exTax = 0

	If IsNumeric(cmAmt) = True Then
		exTax = exTax + cmAmt
	End If
	If IsNumeric(trTax) = True Then
		exTax = exTax + trTax
	End If
	If IsNumeric(fsTax) = True Then
		exTax = exTax + fsTax
	End If
	If IsNumeric(inTax) = True Then
		exTax = exTax + inTax
	End If
	If IsNumeric(ihTax) = True Then
		exTax = exTax + ihTax
	End If

	GRID0.SetGridCell ii, 35, exTax
	GRID0.SetGridCell ii, 9, plRat * 100

	If plRat > 0 Then
		GRID0.SetTRgb ii, 9, 94
	Else
		GRID0.SetTRgb ii, 9, 95
	End If

Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
selection.Data = 2
continue_Inx = 1
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
selection.Data = 3
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
	selection.Data = 1
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.DATA = GRID0.GetGridCell(GRID0.Row, 12)

	If Trim(S1301.DATA) = "" Then
		Exit Sub
	End If

	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



