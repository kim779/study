Public Function cp_lpad(as_string, ai_count, as_filler)
	Dim ls_str, li_cnt
    '대상 String이 NULL이면 Filler로 채운 문자열 Return
	If IsNull(as_string) Then
		cp_lpad = String(ai_count, as_filler)
	Else
		ls_str = Trim(as_string) ' 공백 Trimming
		SCREEN.CreateObject("DX_CSTRING")
		DX_CSTRING.Text = ls_str
		li_cnt = ai_count - DX_CSTRING.GetLength()
		If li_cnt >= 0 Then
			cp_lpad = String(li_cnt, as_filler) & ls_str
		Else
			cp_lpad = Right(ls_str, ai_count)
		End If
	End If
End Function

' 관심종목 oop 조회
Sub oop_call()
	Dim sdata, codes, ii

	codes = ""

	For ii = 1 To VIEWGRID.Rows
		codes = codes & Trim(VIEWGRID.GetGridCell(ii, 7))
		codes = codes & Chr(127)
	Next

	sdata = "$90303" & Chr(127) & cp_lpad(ii,2,"0") & cp_lpad(ii,4,"0") & _
					"020" & Space(16) & "00000" & Space(80) & _
					"1301" & Chr(127) & codes & Chr(10) & "2023" & Chr(10) & "1021" & Chr(10) &vbTab
	Call SCREEN.Service("poop0090", sdata, Len(sdata), &H02)
End Sub

