'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password


	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub


Sub ChangeGridData()
	Dim sRow15, sNum, codx

	For ii = m_nIndex To GRID0.Rows
		sRow15 = Trim(GRID0.GetGridCell(ii, 15))

		If chkNumData(sRow15) = True Then	'이자율
			sNum = FormatNumber(sRow15 * 100, 2) & "%"
		Else
			sNum = ""
		End If

		GRID0.SetGridCell ii, 15, sNum

		codx = Trim(GRID0.GetGridCell(ii, 4))
		GRID0.SetGridCell ii, 4, "A" & Mid(codx, 4, 6)
	Next

	m_nIndex = ii

End Sub


Function chkNumData(num)
	chkNumData = False

	If Trim(num) = "" Then
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Exit Function
	End If

	chkNumData = True
End Function

