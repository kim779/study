'***************************************************************************
Sub all_Check(Flag)
	Dim gcnt, mflag
	gcnt = 0
	mflag = 0

	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 4)) = "" Then
			Exit Sub
		End If
		VIEWGRID.SetGridCell ii, 1, Flag

		If Trim(VIEWGRID.GetGridCell (ii,  1)) = "1" Then
			gcnt = gcnt + 1
		End If

		If Flag = 1 And gcnt > 9 Then '일괄주문은 9건까지만 가능
			Call VIEWGRID.SetGridCell(ii, 1, "0")
			mflag = 1
