Sub click_grid()
		Dim	key_value, key_text
		key_value = GRID0.GetGridCell(GRID0.Row, 7)
		If Trim(key_value) <= "" Then
			Exit Sub
		End If
		key_text = GRID0.GetGridCell(GRID0.Row, 4)
		If Trim(key_text) <= "" Then
			Exit Sub
		End If

		key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.
		SCREEN.CreateWindow 4, "IBNEWSXX /S/d/p1", "015"& vbTab & key_text & vbLf & _
			"016" & vbTab & key_value & vbLf & "1301" & vbTab & SCREEN.Object("parent.1301").Data

'		keyv.text = key_value
'		SCREEN.Object("OBJ1.isrn").data = recn
'		OBJ1.send
End Sub

