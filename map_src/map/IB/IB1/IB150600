_AW_ONDECLARE_AW_
' 종목 대주 여부 조회
Sub read_djcode(data)
	i_flag.Text = "1"	' 대주 여부 조회용 Flag
	LEDGER.Rcnt = "0001"
	GRID0.Clear
	LEDGER.Fkey = "C"
	CHK.Checked = True
	startCod.Data = Trim(data)
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
If Trim(Query_Type.Data) <> "" Then
	i_flag.Text = "3"
End If

LEDGER.Rcnt = "0020"
S1301.Data = startCod.Data
obj0.Send
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
GUIDE.Text = ""

iIn.Data = "00001"

'시장구분 1:주식 2:채권 3:코스피 4:코스닥 0:전체
i_sjgb.Data = "0"
If grp1_00.Checked Then	'전체
	i_sjgb.Data = "0"
'	ElseIf grp1_01.Checked Then '주식
'		i_sjgb.Data = "1"
ElseIf grp1_02.Checked Then '코스피
	i_sjgb.Data = "3"
ElseIf grp1_03.Checked Then '코스닥
	i_sjgb.Data = "4"
'	ElseIf grp1_04.Checked Then '채권
'		i_sjgb.Data = "2"
End If

' 시작종목번호 입력
i_djcode.Clear()
If CHK.Checked = True Then
	i_djcode.Data = "A"&startCod.Data

	If SCREEN.GetCodeType(i_djcode.Data) = 9 Then
		i_djcode.Data = "J"&startCod.Data
	ElseIf SCREEN.GetCodeType(i_djcode.Data) = 27 Then
		i_djcode.Data = "Q"&startCod.Data
	Else
		i_djcode.Data = "A"&startCod.Data
	End If
End If



If Trim(LEDGER.Fkey) = "C" Then
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
End If

SCREEN.onsend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
End If

Dim tmpb
For ii = 1 To GRID0.Rows
	tmpb = Trim(GRID0.GetGridCell (ii, 5))
	GRID0.SetGridCell ii, 5, Replace(tmpb, ".00", "")
Next

' 대주 종목 여부 조회
If i_flag.Text = "1" Then
	Dim chk_djcode
	chk_djcode = Trim(GRID0.GetGridCell (1, 2))
	If Mid(Trim(i_djcode.Data), 2, 6) = Trim(chk_djcode) Then
		SCREEN.Proc "Main.set_djcode", "대주가능"
	Else
		SCREEN.Proc "Main.set_djcode", "대주불가"
	End If
End If

SCREEN.Object("GUIDE").Text = LEDGER.Emsg

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

