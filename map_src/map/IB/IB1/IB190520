_AW_ONDECLARE_AW_
'globalSum :: 그리드데이터가 여러페이지로 있을경우 페이지 넘길때마다 저장해 두기위한 자료
Dim sect, gCount, globalSum1, globalSum2, globalSum3, globalSum4

sect = 0
globalSum1 = 0
globalSum2 = 0
globalSum3 = 0
globalSum4 = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	'SCREEN.ClearAll 0, 2
	ClearOutput()
	GUIDE.Text = ""
	ANCM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	'Call ClearGlobaldata()
	ClearOutput()
	Call send_f()
End Sub

Sub ClearGlobaldata()
	gCount = 1
	globalSum1 = 0
	globalSum2 = 0
	globalSum3 = 0
	globalSum4 = 0
End Sub
'== 첫 조회
Sub send_f()

	next_btn.Enable = False
	'SCREEN.ClearAll 0, 2
	ClearOutput()
	GRID0.SetDataPosition(0)
	LEDGER.Fkey = "C"

	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'수수료 미적용시 계산
Sub SetNoCal()
	For i = 1 To GRID0.Rows
		num = Trim(GRID0.GetGridCell (i, 1))

		data = Trim(GRID0.GetGridCell (i, 15))
		If data <> "" Then
			evalue = FormatPercent(data) & "%"
		Else
			data = 0
			Evalue = "0.00%"
		End If

		'-- % 지우기
		Evalue = Mid(Evalue, 1, Len(Evalue)-1)

		GRID0.SetGridCell i, 16, evalue

		If  data > 0 Then
			GRID0.SetTRgb i, 16, 94
		ElseIf data < 0 Then
			GRID0.SetTRgb i, 16, 95
		Else
			GRID0.SetTRgb i, 16, 69
		End If
	Next

	OUTPUT99.Data = OUTPUT6.Data
	OUTPUT100.Data = OUTPUT7.Data
	OUTPUT101.Data = OUTPUT25.Data

End Sub

'수수료에 따른 계산
Sub SetCal()
	Dim presentCost, Remain, fee, rate, buyCost, resultCost, sum, sooikRate, pyunggaCost, maeipCost, hTax, saveFees
	Dim TotalMaeip, TotalPyungga, TotalMoney, TotalCredit
	Dim maeipRate, maeipfee, creditMoney
	Dim code, chcode

'적용   ; (현재가*수량-수수료-제세금)-(매입단가*수량-수수료)=평가손익
' 제세금 = 현재가 * 수량 * 0.003
' 수수료 = 현재가 * 수량 * 수수료율
' 매입평균가 = 매입평균가 - 수수료
'평가금액 계산시 수수료 = 10원단위미만 절삭(현재가 * 수량 * 수수료율)
'평가금액 계산시 제세금 = 원단위미만 반올림(현재가 * 잔고 * 0.003)
'평가금액 = 수수료미적용 평가금액 - (수수료 + 제세금 + 세이브수수료(있을경우))
'
'매입금액 계산시 수수료 = 10원단위미만 절삭(매입평균가 * 수량 * 수수료율)
'매입금액 계산시 제세금 = 원단위미만 반올림(매입평균가 * 잔고 * 0.003)
'매입금액 = 수수료미적용 매입금액 + (수수료 + 제세금 + 세이브수수료(있을경우))
	sum = 0
	TotalMaeip = 0
	TotalPyungga = 0
	TotalMoney = 0
	creditMoney = 0
	TotalCredit = 0
'	SYSTEM.Trace "gCount : " & gCount

'	For ii=gCount To GRID0.Rows
	For ii=1 To GRID0.Rows
		presentCost = Trim(GRID0.GetGridCell(ii, 17))					'현재가
		Remain = Trim(GRID0.GetGridCell(ii, 6))							'수량
		maeipCost =	Trim(GRID0.GetGridCell(ii, 43))						'매입금액
		pyunggaCost	= Trim(GRID0.GetGridCell(ii, 34))					'평가금액
		buyCost = Trim(GRID0.GetGridCell(ii, 26))						'매입평균가
		creditMoney = Trim(GRID0.GetGridCell(ii, 19))					'신용금액
		code = Trim(GRID0.GetGridCell(ii, 1))

		If presentCost = "" Then
			presentCost = 0
		End If
		If Remain = "" Then
			Remain = 0
		End If
		If maeipCost = "" Then
			maeipCost = 0
		End If
		If pyunggaCost = "" Then
			pyunggaCost = 0
		End If
		If buyCost = "" Then
			buyCost = 0
		End If
		If creditMoney = "" Then
			creditMoney = 0
		End If

		If Trim(howtax.Text) <> "" Then
			hTax = FormatNumber(Trim(howtax.Text), 8,-1, 0, 0 )			'수수료율

			If Trim(saveFee.text) <> "" Then
				saveFees = Trim(saveFee.text)							'세이브 수수료
			Else
				saveFees = 0
			End If
		End If


		If Remain <> 0 Then

			rate = (presentCost * Remain * hTax) 							'수수료(현재가 기준)
			rate = Fix(rate)
			rate = (Fix(rate / 10)) * 10

			fee = presentCost * Remain * 0.003								'제세금(현재가 기준)
			fee = CLng(fee)
		Else
			rate = 0
			fee = 0
		End If



		'주식/신주인수권일때는 매입평균가가 없어도 계산을 해준다
		If Len(code) = 7 Or Len(code) = 9 Then
		    maeipRate = (buyCost * Remain * hTax)   								'수수료 = 현재가 * 수량 * 수수료율
			maeipRate = Fix(maeipRate)
			maeipRate = (Fix(maeipRate / 10)) * 10
			maeipCost = maeipCost + maeipRate + saveFees							'매입금액(수수료 포함)
			GRID0.SetGridCell ii, 43, maeipCost
		Else
			If maeipCost <> 0 Then
			    maeipRate = (buyCost * Remain * hTax)   								'수수료 = 현재가 * 수량 * 수수료율
				maeipRate = Fix(maeipRate)
				maeipRate = (Fix(maeipRate / 10)) * 10
				maeipCost = maeipCost + maeipRate + saveFees							'매입금액(수수료 포함)
				GRID0.SetGridCell ii, 43, maeipCost
			End If
		End If

		'ELW와 ETF는 수수료만 계산
		If Len(code) = 7 Then
			If Mid(code, 1, 1) = "J" Or SCREEN.GetCodeType(Mid(Trim(code), 2, 6)) = 6 Or Mid(code, 1, 1) = "Q" Then
'			If Mid(code, 1, 1) = "J" Then
'				SYSTEM.trace "pyunggaCost " & pyunggaCost
'				SYSTEM.trace "rate " & rate
'				SYSTEM.trace "fee " & fee
'				SYSTEM.trace "pyunggaCost " & saveFees
				pyunggaCost = pyunggaCost - (rate + saveFees)						'평가금액
			Else
				pyunggaCost = pyunggaCost - (rate + fee + saveFees)
			End If
		Else
			pyunggaCost = pyunggaCost - (rate + fee + saveFees)						'평가금액
		End If

		'채권일 경우, 현재가가 없으면 손익 0
		If presentCost = 0 And Len(Trim(GRID0.GetGridCell(ii, 1))) = 12 Then
			resultCost = 0															'매도손익금액
		Else
			resultCost = pyunggaCost - maeipCost									'매도손익금액
		End If

		'채권일 경우, 현재가가 없으면 손익률 0
		If presentCost = 0 And Len(Trim(GRID0.GetGridCell(ii, 1))) = 12 Then
			sooikRate = 0.00
		Else

			If maeipCost = 0 And  creditMoney = 0 Then
				sooikRate = 0.00
			Else
				sooikRate = ((pyunggaCost - maeipCost) / (maeipCost - creditMoney )) * 100
			End If
		End If

		GRID0.SetGridCell ii, 34, pyunggaCost									'평가금액
		GRID0.SetGridCell ii, 16, FormatNumber(sooikRate, 2, -1, 0, 0) + "%"	'손익률

		If  sooikRate > 0 Then
			GRID0.SetTRgb ii, 16, 94
		ElseIf sooikRate < 0 Then
			GRID0.SetTRgb ii, 16, 95
		Else
			GRID0.SetTRgb ii, 16, 69
		End If

		GRID0.SetGridCell ii, 14, resultCost									'매도손익금액

		If  resultCost > 0 Then
			GRID0.SetTRgb ii, 14, 94
		ElseIf resultCost < 0 Then
			GRID0.SetTRgb ii, 14, 95
		Else
			GRID0.SetTRgb ii, 14, 69
		End If

		TotalMaeip = TotalMaeip + maeipCost
		TotalPyungga = TotalPyungga + pyunggaCost
		TotalCredit = TotalCredit + creditMoney
'		SYSTEM.Trace "maeipCost : " & maeipCost & vbTab & "totalMaeip : " & TotalMaeip
'		SYSTEM.Trace "pyunggaCost : " & pyunggaCost & vbTab & "TotalPyungga : " & TotalPyungga
'		SYSTEM.Trace "creditMoney : " & creditMoney & vbTab & "TotalCredit : " & TotalCredit
	Next

'	SYSTEM.Trace "TotalMaeip : " & TotalMaeip
'	SYSTEM.Trace "TotalPyungga : " & TotalPyungga
'	SYSTEM.Trace "TotalCredit : " & TotalCredit



	If Trim(OUTPUT7.Data) = "" Then
		OUTPUT7.Data = 0
	End If

	If Trim(OUTPUT6.Data) = "" Then
		OUTPUT6.Data = 0
	End If

	If Trim(OUTPUT25.Data) = "" Then
		OUTPUT25.Data = 0
	End If

	OUTPUT7.Data = TotalMaeip											'매입총액
	OUTPUT6.Data = TotalPyungga - TotalCredit							'유가증권평가

	If Trim(OUTPUT98.Data) = "" Then
		OUTPUT25.Data = TotalPyungga - TotalCredit
	Else
		OUTPUT25.Data = OUTPUT98.Data + (TotalPyungga - TotalCredit)  '예탁자산총액 d+2에수금 +(평가 - 신용)
	End If



	'SYSTEM.Trace "TotalPyungga : " & TotalPyungga
	'SYSTEM.Trace "TotalCredit : " & TotalCredit
	'SYSTEM.Trace "OUTPUT98 : " & OUTPUT98.Data
	'SYSTEM.Trace "OUTPUT25 : " & OUTPUT25.Data

	OUTPUT99.Data = OUTPUT6.Data
	OUTPUT100.Data = OUTPUT7.Data
	OUTPUT101.Data = OUTPUT25.Data
'	globalSum1 = globalSum1 + TotalMaeip
'	globalSum2 = globalSum2 + (TotalPyungga - TotalCredit)
'
'	OUTPUT7.Data =  globalSum1											'매입총액
'	OUTPUT6.Data = 	globalSum2											'유가증권평가
'
'	If Trim(OUTPUT98.Data) <> "" Then
'		If globalSum3 > 0 Then
'			tpdata = TotalPyungga - TotalCredit							'이미 한번 D+2더했기때문에 (평가 - 신용)
'		Else
'			tpdata = Trim(OUTPUT98.Data) + (TotalPyungga - TotalCredit)	'예탁자산총액 d+2에수금 +(평가 - 신용)
'		End If
'
'	Else
'		tpdata = TotalPyungga
'	End If
'	SYSTEM.Trace "tpdata : " & tpdata & vbTab & "globalSum3 : " & globalSum3
'
'	globalSum3 = globalSum3 + tpdata
'	OUTPUT25.Data = globalSum3
'
'	gCount = GRID0.rows+1
End Sub

