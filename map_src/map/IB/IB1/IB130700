'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

Dim gridPos

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

'== D-2 날짜 구하기
Sub getD_7()
	Dim yy, mm, dd, cday, MyWeek

	cday = DateAdd("d", -7, Date)
	MyWeek = Weekday(cday)

	If MyWeek = 1 Then
		cday= DateAdd("d", -2 , cday)
	ElseIf MyWeek = 7 Then
		cday= DateAdd("d", -1 , cday)
	End If

	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)

	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd
	zStrDt.Data = CDbl(cday)
End Sub

