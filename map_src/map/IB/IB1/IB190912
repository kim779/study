RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim initflag, grdact
initflag = False
grdact = ""

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Select Case updn.Data
	Case 1				'상한
		S200401.Checked = True
	Case 2				'상승
		S200402.Checked = True
	Case 3				'보합
		S200403.Checked = True
	Case 4				'하한
		S200404.Checked = True
	Case 5				'하락
		S200405.Checked = True
	Case Else
		S200401.Checked = False
		S200402.Checked = False
		S200403.Checked = False
		S200404.Checked = False
		S200405.Checked = False
End Select

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1777.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1777.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
initflag = True

If S206300.Rows < 1 Then
	Exit Sub
End If

Select Case grdact
Case "up"
	S206300.Index = S206300.Rows - 3
	S206300.Index = S206300.Rows - 2
	S206300.Index = S206300.Rows - 1
	'SYSTEM.Trace "onreceive up "& (S200300.Rows - 1)
Case "dn"
	'SYSTEM.Trace "onreceive dn"
End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(206300)
_AW_ONCLICK_AW_
Dim codx
If S206300.HitPos = 3 Then
	codx = S206300.GetGridCell(S206300.Row, 3)
	SCREEN.Object("main.1301").Data = codx
	SCREEN.Proc "main.code_change", "main"
ElseIf initflag = True Then
	grdact = ""
	Select Case S206300.HitPos
	Case 1, 5
		grdact = "up"
	Case 2, 6
		grdact = "dn"
	End Select
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UBUT)
_AW_ONCLICK_AW_
Dim retn
Select Case upgb.Data
	Case "001", "101", "401"		'KOSPI, KOSPI200, KOSPI100
		retn = SCREEN.GetCode(104, "200901", "20022", 0)
	Case "201", "301"							'KOSDAQ
		retn = SCREEN.GetCode(104, "200901", "20022", 9)
	Case "601"
		retn = SCREEN.GetCode(104, "200901", "20022", 200)
	Case "801"
		retn = SCREEN.GetCode(104, "200901", "20022", 801)
End Select

If (retn <> True) Then
	S200901.SetFocus
	Exit Sub
End If

S200901.SetFocus
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(200901)
_AW_ONCHANGE_AW_
If (Len(Trim(S200901.Data)) <> 3) Then
	S200901.SetFocus
	Exit Sub
End If
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(upgb)
_AW_ONCHANGE_AW_
S200901.Data = upgb.Data

If (Len(Trim(S200901.Data)) <> 3) Then
	S200901.SetFocus
	Exit Sub
End If
