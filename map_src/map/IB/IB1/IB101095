RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'***************************************************************************
' DESC : send Error Check
'***************************************************************************
Function Error_check()
	Error_check = False
	If Trim(AN1A.Data) = "" Then
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus
		Call guide_msg("계좌번호를 확인하십시오")
		Exit Function
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(pswd.Data)) < 4 Then
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Call guide_msg("비밀번호를 확인하십시오")
			Exit Function
		End If
	End If
	Error_check = True
End Function

_AW_ONINDECLARE_AW_
#load IB888833
#load IB888888
#load IB888889

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
OBJ0.ClearAll 2
OBJ1.ClearAll 2
SCREEN.Proc "main.set_guide", " "

AN1A.Data = Trim(SCREEN.Object("main.OBJ_order.AN1A").Data)
Call Password_initSetting(pswd)

If Error_check() = False Then				'보내기전 에러체크
	SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
	Exit Sub
End If

'잔고부터 호출(패스워드 체크TR 안타도록 한다)
OBJ1.Send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(pswd)
_AW_ONKEYCHANGE_AW_

If SCREEN.Key = 13 And Trim(pswd.Data) <> "" Then
	first_send()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


