_AW_ONDECLARE_AW_
Sub EndQueryGroup(Mode)
	If Mode = 1 Then
		SCREEN.Proc "OBJ_GRP.StrQueryGroupList", "COMBO0"
		SCREEN.Proc "OBJ_GRP.StrQueryAcntList", COMBO0.Data&",2,acgrid,cmb_acnt"
	Else
		'Call Send_f()
	End If
End Sub

Sub Send_f()
	If RADIO0.Checked Then
		gpno.Data = ""
	ElseIf RADIO1.Checked Then
		gpno.Data = COMBO0.Data
	ElseIf RADIO2.Checked Then
		gpno.Data = ""
		acno.Data = cmb_acnt.Data
	End If
	'SYSTEM.Trace "Send_f"
	'SCREEN.ClearAll 0, 2
	LEDGER.Rcnt = "0035"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub Send_c()
	GRID0.SetDataPosition 2
	LEDGER.Rcnt = "0035"
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub CheckInput()
	Dim ii, dd
	'MsgBox "CheckInput"
	dd = "" '임의의 값
	For ii=1 To GRID1.Rows
		dd = Trim(GRID1.GetGridCell(ii, 1))
		If dd <> "" Then
			Exit For
		End If
	Next
	'MsgBox "["&dd&"]"
	If dd = "" Then
		SCREEN.Object("Object0.zFnoOrdPtnCode").Data = "SS"
		SCREEN.Object("Object0.lFundOrdNo").data = "+000000000"
	Else
		SCREEN.Object("Object0.zFnoOrdPtnCode").Data = "00"
	End If
End Sub

Sub SetAcntList()
	If Not chk_special.Checked Then
		GRID0.SetRows acgrid.Rows
		For ii=1 To acgrid.Rows
			Call GRID0.SetGridCell(ii, 1, acgrid.GetGridCell(ii,1))
			Call GRID0.SetGridCell(ii, 2, acgrid.GetGridCell(ii,3))
		Next
	Else
		GRID0.SetRows 1
		Call GRID0.SetGridCell(1, 1, cmb_acnt.Data)
		Call GRID0.SetGridCell(1, 2, GetPwd(cmb_acnt.Data))

	End If
End Sub

Function CalcRow()
	Dim cnt, scnt
	cnt = Int((8000-(32+GRID0.Rows*28*2+5)-400)/278) '400은 PB헤더값(340)+60은 여분
	'MsgBox C(cnt,5)
	scnt = CStr(cnt)

	For ii = 1 To 5-Len(scnt)-1
		scnt="0"&scnt
	Next

	CalcRow = scnt
End Function

