RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB783120"



Sub write_set( a )

If SCREEN.CreateObject("INFO") Then
	INFO.PushData LOGIN.Name, myFILE, myMAP, "SAVE", a
	INFO.PushData LOGIN.Name, myFILE, myMAP, "SAVE2", LABEL0.Text

End If

End Sub

Sub read_set()

	SCREEN.CreateObject("INFO")

	Dim a, b
	a = INFO.PopData( LOGIN.Name, myFILE, myMAP, "SAVE" )
	b = INFO.PopData( LOGIN.Name, myFILE, myMAP, "SAVE2" )

	If IsNull(a) Then
		EDIT0.Data = ""
		LABEL0.Text = ""
	Else
		EDIT0.Data = a
		LABEL0.Text = b
	End If

	SCREEN.Send 0

End Sub

_AW_ONSTART_AW_
read_set()

