_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB783110"



Sub write_set( a )

If SCREEN.CreateObject("INFO") Then
	INFO.PushData LOGIN.Name, myFILE, myMAP, "SAVE", a

End If

If a = "0" Then
	GRID0.SetHead 10, "시간"
Else
   	GRID0.SetHead 10, "거래일"
End If

End Sub

Sub read_set()

	SCREEN.CreateObject("INFO")

	Dim a
	a = INFO.PopData( LOGIN.Name, myFILE, myMAP, "SAVE" )
	Select Case a
	Case "0" R_1.Checked = True
	Case "1" R_2.Checked = True
	Case "2" R_3.Checked = True
	Case "3" R_4.Checked = True
	Case "4" R_5.Checked = True
	Case "6" R_7.Checked = True
	Case "7" R_8.Checked = True
	Case Else
		R_1.Checked = True
		a = "0"
	End Select

	If a = "0" Then
	GRID0.SetHead 10, "시간"
Else
   	GRID0.SetHead 10, "거래일"
End If

	gubn.Data = a
	SCREEN.Send 0

End Sub

_AW_ONSTART_AW_
read_set()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
