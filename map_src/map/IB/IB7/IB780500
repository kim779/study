_AW_ONDECLARE_AW_
Sub Set_Ini()
	Dim Today, Check

	If SCREEN.CreateObject("Info") Then

	 	Today = INFO.PopData("", "NOTICECOOKIE.ini", "7805", "TODAY")

	 	If Today = "0" Then
	 		INFO.PushData "", "NOTICECOOKIE.INI", "7805", "TODAY", CDAT.Data
			INFO.PushData "", "NOTICECOOKIE.ini", "7805", "FIRST", "1"
	 	Else
	 		INFO.PushData "", "NOTICECOOKIE.INI", "7805", "TODAY", CDAT.Data
	 	End If

	 	Check = INFO.PopData("", "NOTICECOOKIE.ini", "7805", "FIRST")

	 	If Check = "0" Then
	 		CHECK0.Checked = True
			INFO.PushData "", "NOTICECOOKIE.ini", "7805", "FIRST", "0"
	 	Else
	 		CHECK0.Checked = False
			INFO.PushData "", "NOTICECOOKIE.ini", "7805", "FIRST", "1"
	 	End If
	End If

End Sub

