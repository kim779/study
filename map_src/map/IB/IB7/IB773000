_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim code	'종목코드(6자리)

'--------------------------------------------------------------------
' Grid Data부를 Click했을때만 종목리서치 내용조회를 처리한다.
'--------------------------------------------------------------------
If GRID0.HitPos = 3 Then

	If GRID0.Column = 7 Then
		'종목리서치 내용 조회를 위해 내용 오브젝트로 데이터 넘겨준다.
		SCREEN.Object("obj_memo.ed_date").Data = GRID0.GetGridCell(GRID0.Row,1)	'일자
		SCREEN.Object("obj_memo.ed_gubn").Data = GRID0.GetGridCell(GRID0.Row,2)	'구분
		SCREEN.Object("obj_memo.ed_jcod").Data = GRID0.GetGridCell(GRID0.Row,4)	'종목코드
		SCREEN.Object("obj_memo.ed_seqn").Data = GRID0.GetGridCell(GRID0.Row,6)	'일련번호
		OBJ_memo.Send
	ElseIf GRID0.Column = 5 Then
		'종목 트리거 처리 (trim을 해줘야만 작동이 되었음)
	'	code = Trim(GRID0.GetGridCell(GRID0.row, 4))
	'	If Trim(code) <> "" Then
	'		S1301.Data = code
	'		S1301.Trigger "", False
	'		S1301.Trigger "", True
	'		SYSTEM.SetHistory "1301", S1301.Data
	'	End If

		S1301.data = Trim(GRID0.GetGridCell(GRID0.row, 4))
		If Trim(S1301.data) <> "" Then
			S1301.Trigger "", False
			S1301.Trigger "", True
			SYSTEM.SetHistory "1301", S1301.Data
			SCREEN.object("OBJ_hnam.1301").data = S1301.data
		Else
			SCREEN.object("OBJ_hnam.1301").data = "000001"
		End If
		OBJ_hnam.Send
		SCREEN.Send 0
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(COMBO0)
_AW_ONCHANGE_AW_
