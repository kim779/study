_AW_ONRECEIVE_AW_
'화면 열었을때 첫번째 데이터의 내용을 조회할수 있도록 처리
If GRID0.GetGridCell(1,1) <> "" Then
	SCREEN.Object("obj_memo.ed_date").Data = GRID0.GetGridCell(1,1)	'일자
	SCREEN.Object("obj_memo.ed_gubn").Data = GRID0.GetGridCell(1,2)	'구분
	SCREEN.Object("obj_memo.ed_jcod").Data = GRID0.GetGridCell(1,4)	'종목코드
	SCREEN.Object("obj_memo.ed_seqn").Data = GRID0.GetGridCell(1,6)	'일련번호
	OBJ_memo.Send

End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If Trim(S1301.Data) = "000000" Then
	Exit Sub
End If

SCREEN.Object("OBJ_hnam.1301").data = S1301.Data
OBJ_hnam.Send
SCREEN.Send 0

