_AW_ONDECLARE_AW_
Dim G_Mode, changeFlag
G_Mode = 2
changeFlag = False

Sub ChangeMode(Mode)
	If Mode = "+" Then
		G_Mode = G_Mode + 1
		If G_Mode > 3 Then
			G_Mode = 1
		End If
	Else
		G_Mode = G_Mode - 1
		If G_Mode < 1 Then
			G_Mode = 3
		End If
	End If
	LoadMode(G_Mode)


End Sub

Sub LoadMode(Mode)
'	SYSTEM.Trace "LoadMode: "& CStr(Mode)
	Select Case Mode
	Case 1 :
