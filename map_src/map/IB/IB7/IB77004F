Sub SetParentGrid()
	j = 2
	fg = 0

	For i = 1 To GRID0.Rows
		gubn = GRID0.GetGridCell(i, 1)
		If gubn = "5" Then
			fg = i
		End If
	Next


	If fg > 0 Then				'매수건수 상위 종목이 있을경우
		Topgubn = "매수건수 TOP"
		If Len(Trim(GRID0.GetGridCell(fg, 2))) <> 0 Then
			SCREEN.Object("parent.GRID41").SetGridCell 1, 2, Topgubn	'구분
			SCREEN.Object("parent.GRID41").SetGridCell 1, 3, GRID0.GetGridCell(fg, 2)	'종목코드
			SCREEN.Object("parent.GRID41").SetGridCell 1, 4, GRID0.GetGridCell(fg, 3) '종목명
			SCREEN.Object("parent.GRID41").SetGridCell 1, 5, GRID0.GetGridCell(fg, 4) '현재가
			SCREEN.Object("parent.GRID41").SetGridCell 1, 6, "5" 	'구분
		End If

		For i = 1 To GRID0.Rows
'			If i = 5 Then
'				Exit Sub
'			End If

			gubn  = GRID0.GetGridCell(i, 1)
			SYSTEM.Trace "STEP1 : " & gubn & " i : " & i


			If gubn <> "5" And gubn <> "4" Then

				If gubn = "1" Then
					Topgubn = "상한가 TOP"
				ElseIf gubn = "2" Then
					Topgubn = "현재가 TOP"
				ElseIf gubn = "3" Then
					Topgubn = "관심종목 TOP"
				ElseIf gubn = "6" Then
					Topgubn = "동시순매수 TOP"
				End If


			SYSTEM.Trace "STEP2 : " & gubn & " : " & Topgubn

			'코드값이 없으면 넣지않는다. 빈값을 굳이 넣을필요가 없다.
	'		MsgBox "[" & Trim(S301300.GetGridCell(i, 14)) & "]"
				If Len(Trim(GRID0.GetGridCell(i, 2))) <> 0 Then

					SCREEN.Object("parent.GRID41").SetGridCell j, 2, Topgubn	'구분


					SCREEN.Object("parent.GRID41").SetGridCell j, 3, GRID0.GetGridCell(i, 2)	'종목코드
					SCREEN.Object("parent.GRID41").SetGridCell j, 4, GRID0.GetGridCell(i, 3) '종목명
					SCREEN.Object("parent.GRID41").SetGridCell j, 5, GRID0.GetGridCell(i, 4) '현재가
		'			SCREEN.Object("parent.GRID41").SetGridCell i+1, 5, S301300.GetGridCell(i, 10)	'수익률
		'			SCREEN.Object("parent.GRID41").SetGridCell i+1, 6, S301300.GetGridCell(i, 11)	'벤치마크
		'			SCREEN.Object("parent.GRID41").SetGridCell i+1, 7, S301300.GetGridCell(i, 2)	'추천일
					SCREEN.Object("parent.GRID41").SetGridCell j, 6, gubn 	'구분
				End If

				j = j+1
			End If
		Next
	Else						' 매수건수 상위 건수가 없을때
		j = 1

		For i = 1 To GRID0.Rows

		gubn  = GRID0.GetGridCell(i, 1)

		If gubn <> "5" And gubn <> "4" Then

			If gubn = "1" Then
				Topgubn = "상한가 TOP"
			ElseIf gubn = "2" Then
				Topgubn = "현재가 TOP"
			ElseIf gubn = "3" Then
				Topgubn = "관심종목 TOP"
			ElseIf gubn = "6" Then
				Topgubn = "동시순매수 TOP"
			End If


		'코드값이 없으면 넣지않는다. 빈값을 굳이 넣을필요가 없다.
'		MsgBox "[" & Trim(S301300.GetGridCell(i, 14)) & "]"
			If Len(Trim(GRID0.GetGridCell(i, 2))) <> 0 Then

				SCREEN.Object("parent.GRID41").SetGridCell j, 2, Topgubn	'구분


				SCREEN.Object("parent.GRID41").SetGridCell j, 3, GRID0.GetGridCell(i, 2)	'종목코드
				SCREEN.Object("parent.GRID41").SetGridCell j, 4, GRID0.GetGridCell(i, 3) '종목명
				SCREEN.Object("parent.GRID41").SetGridCell j, 5, GRID0.GetGridCell(i, 4) '현재가
	'			SCREEN.Object("parent.GRID41").SetGridCell i, 5, S301300.GetGridCell(i, 10)	'수익률
	'			SCREEN.Object("parent.GRID41").SetGridCell i, 6, S301300.GetGridCell(i, 11)	'벤치마크
	'			SCREEN.Object("parent.GRID41").SetGridCell i, 7, S301300.GetGridCell(i, 2)	'추천일
				SCREEN.Object("parent.GRID41").SetGridCell j, 6, gubn 	'구분
			End If

			j = j + 1
		End If

	Next
	End If
End Sub

