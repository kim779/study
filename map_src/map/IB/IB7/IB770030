_AW_ONSTART_AW_
'SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If Trim(Rmnno.data) = "" Then
	SCREEN.OnSend = False
	Exit Sub
End If

'직원인지 고개인지 구
If SYSTEM.ConnectBy = 1 Then
	SCREEN.OnSend = False
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, gb

For ii=1 To GRID.Rows
	gb = GRID.GetGridCell(ii, 2)
	Select Case gb
	Case "1"	' 미수
		SCREEN.Object("main.BT_MISU_ON").Visible = True
		SCREEN.Object("main.BT_MISU_OFF").Visible = False
	Case "5", "6", "7"	' 유상,반대의사, 매수청구
		SCREEN.Object("main.BT_GR_ON").Visible = True
		SCREEN.Object("main.BT_GR_OFF").Visible = False
	Case "4"	' 익일 반대
		SCREEN.Object("main.BT_BAN_ON").Visible = True
		SCREEN.Object("main.BT_BAN_OFF").Visible = False
	End Select
Next

