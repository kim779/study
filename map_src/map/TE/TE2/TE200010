_AW_ONDECLARE_AW_
Dim btnFlag

Function CheckRear(str)
	Length = 0
	If InStr(str, "(") > 0 Then
		Length = Length + Abs(CInt(Mid(str, InStr(str, "("), InStr(str, ")"))))
	Else	' ex) s9(9).99
		Length = Length + Len(str)
	End If

	CheckRear = Length
End Function

Function CheckFront(str)
	Length = 0

	If InStr(str, "(") > 0 Then
		Length = Length + Abs(CInt(Mid(str, InStr(str, "("), InStr(str, ")"))))
	End If

	CheckFront = Length
End Function

Function CheckSize(str)
	Dim Length, MyArray, tmp, bflag, cnt, btmpstr
	Length = 0
	cnt = 0
	bflag = False
	btmpstr = ""

	Length = Len(str)

	If Length > 0 Then
		For i = 1 To Length
		
		tmp = Mid(str,i,1)
		
			If IsNumeric(tmp) Then '숫자이면 뒤에 ()여부 체크후 cnt 증가 또는 데이터 저장
				If Mid(str,i+1,1)  = "(" Then
					bflag = True
				Else
					If bflag Then ' 괄호 안에 데이터 저장
						btmpstr = btmpstr & tmp
					Else ' 숫자일경우 +
						cnt = cnt + 1
					End If
				End If
			Else '숫자가 아니면 분기처리
				If tmp  = "(" Then
						bflag = True
				ElseIf tmp  = ")" Then
					cnt = cnt + CInt(btmpstr)
					btmpstr = ""
					bflag = False
				ElseIf tmp  = "." Or tmp = "S" Then
						cnt = cnt + 1
				End If
			End If
		Next
	Else
		cnt = 5
	End If

	CheckSize = CStr(cnt)
End Function

Sub utfSet()
	'바탕화면 경로
	
    desktop_path = CreateObject("WScript.Shell").SpecialFolders("c:\")

    file_name = desktop_path & "\" &I_SvcId.Text

    Call CreateFile(file_name)
End Sub


Sub CreateFile(strPathName)
   Dim fso, tf, size, name, cnt, check, i, rownum
   Dim continue, flag, Init
   cnt = 1
   check = 0
   rownum = 0

   Set objStream = CreateObject("ADODB.Stream")
   objStream.Charset = "UTF-8"
   objStream.Open
   objStream.WriteText "TR=PIBOPBXQ" & vbCrLf
   objStream.WriteText "DESCRIPTION=" & Trim(O_SvcHangNm.Text) & vbCrLf &vbCrLf
   objStream.WriteText "FORMAT=STRUCTURE" & vbCrLf
   objStream.WriteText "OPTION=ENC,LEDGER" & vbCrLf & vbCrLf

	Do
		rownum = rownum + 1
	Loop until Trim(GRID0.GetGridCell(rownum ,6)) = "2"


   For cnt = 1 To GRID0.Rows
		size = CheckSize(Trim(GRID0.GetGridCell(cnt, 11)))

		If Trim(GRID0.GetGridCell(cnt ,12)) <> "" Then
			name = Trim(GRID0.GetGridCell(cnt ,12))
		Else
			name = "갯수"
		End If
		continue = True

		If Trim(GRID0.GetGridCell(cnt, 8)) = "" Then ' 데이터형
			If Trim(GRID0.GetGridCell(cnt, 10)) <> "1" Then '처음 그리드 셋팅 (크기)
			   	objStream.WriteText "OUT=@" & Trim(GRID0.GetGridCell(cnt, 7)) & ":" & size & ":" & name
			   	flag = "grid"
			   	continue = False
			Else	'그리드 내부 내용 셋팅
				flag = "single"
			End If
		End If

		If continue Then
			If flag = "grid" Then ' GRID OUT
				objStream.WriteText ":" & Trim(GRID0.GetGridCell(cnt, 7)) & ":CHAR" & ":" & size & ":" & name
			Else 'SINGLE OUT
				If cnt < rownum And check = 0 Then '입력만 출력
					objStream.WriteText "IN=" & Trim(GRID0.GetGridCell(cnt, 7)) & ":CHAR:" & size & ":" & name & vbCrLf
				ElseIf cnt = rownum And check = 0 Then '처음부터 출력으로 다시 변환
					cnt = 0
					check = 1
					objStream.WriteText vbCrLf
				ElseIf check = 1 Then
					objStream.WriteText "OUT=" & Trim(GRID0.GetGridCell(cnt, 7)) & ":CHAR:" & size & ":" & name & vbCrLf
				End If
			End If
		End If
   Next

   Set BinaryStream = CreateObject("adodb.stream")
   BinaryStream.Type = 1
   BinaryStream.Mode = 3
   BinaryStream.Open
   objStream.Position = 3
   objStream.CopyTo BinaryStream
   objStream.Flush
   objStream.Close
   BinaryStream.SaveToFile strPathName, 2
   BinaryStream.Close
   Set objStream = Nothing
   Set BinaryStream = Nothing
End Sub

_AW_ONSTART_AW_
