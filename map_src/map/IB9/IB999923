Sub Order_mini_change()
	Dim xval

	xval = SCREEN.Object("OBJ_order.tab_order").ID
	Select Case xval
	Case "1" : SCREEN.SetCaption "IB301100" &vbTab& "[3011] 매도"
	Case "2" : SCREEN.SetCaption "IB301200" &vbTab& "[3012] 매수"
	Case "3" : SCREEN.SetCaption "IB301300" &vbTab& "[3013] 정정"
	Case "4" : SCREEN.SetCaption "IB301400" &vbTab& "[3014] 취소"
	End Select

	'-- CreatWindow로 미니주문 open시
	'   domino_data = "종목코드 | 주문번호 | 주문가격 | 주문수량 |"
	domino_data.data = SYSTEM.Pop("domino_data")
	If Trim(domino_data.Data) = "" Then
		Exit Sub
	End If

	SCREEN.SetTimer 2, True

End Sub

Sub Set_mini_domino(xval)
	Dim sdata
	domino_data.data = SYSTEM.Pop("domino_data")
	If Trim(domino_data.Data) = "" Then
		Exit Sub
	End If
	sdata = Split(domino_data.Data,"|")
SCREEN.IgnoreChange True

	SYSTEM.Push "F_ogno", sdata(1)
	SYSTEM.Push "F_jprc", sdata(2)
	SYSTEM.Push "F_jqty", sdata(3)
	SYSTEM.Push "F_code", sdata(0)

	SCREEN.Object("OBJ_order.obj_odr.ed_focod").Data = SYSTEM.Pop("F_code")
	SCREEN.Proc "OBJ_order.obj_odr.ChangeCode", ""
	SCREEN.Object("OBJ_order.obj_odr.ed_ogno").Data = SYSTEM.Pop("F_ogno")
	If xval = 3 Then	'-- 정정인 경우
		SCREEN.Object("OBJ_order.obj_odr.ed_jprc").Data = SYSTEM.Pop("F_jprc")
	End If

	If SCREEN.Object("OBJ_order.obj_odr.ed_jqty").Enable Then
		SCREEN.Object("OBJ_order.obj_odr.ed_jqty").Data = SYSTEM.Pop("F_jqty")
	End If

	SYSTEM.Push "F_ogno", ""
	SYSTEM.Push "F_jprc", ""
	SYSTEM.Push "F_jqty", ""
	SYSTEM.Push "F_code", ""

SCREEN.IgnoreChange False
	domino_data.Clear
	SYSTEM.Push "domino_data", ""

	SCREEN.Object("OBJ_order.obj_odr.ed_jqty").SetFocus
End Sub


