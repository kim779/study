Sub tab_info_change()
	Dim obj_name, fogb, mapid

	Select Case Left(SCREEN.Object("main.ed_focod").Data, 1)
	Case "1", "4", "A", "D" : fogb = 0	'-- 선물
	Case "2", "3", "B", "C" : fogb = 1	'-- 옵션
	Case Else : fogb = 0
	End Select

	mapid = Left(SCREEN.GetMapName(1), 6)
	Select Case mapid
	Case "IB2200"
		Select Case SCREEN.Object("main.tab_info").ID
		Case 1 : obj_name = "21"
		Case 2 : obj_name = 22 + fogb
		Case 3 : obj_name = 24 + fogb
		Case 4 : obj_name = "26"
		Case 5 : obj_name = "27"
		Case 6 : obj_name = "28"
		Case 7 : obj_name = 29 + fogb
		Case 8 : obj_name = "2H"  'CYH추가
		Case Else : Exit Sub
		End Select
	Case "IB3001"
		Select Case SCREEN.Object("main.tab_info").ID
		Case 1 : obj_name = 21 + fogb
		Case 2 : obj_name = "23"
		Case 3 : obj_name = 25 + fogb
		Case Else : Exit Sub
		End Select
	Case "IB3300"
		Select Case SCREEN.Object("main.tab_info").ID
		Case 1 : obj_name = 41 + fogb
		Case 2 : obj_name = 43 + fogb
		Case 3 : obj_name = "45"
		Case 4 : obj_name = "46"
		Case Else : Exit Sub
		End Select
	Case Else
		Exit Sub
	End Select

	obj_name = mapid & obj_name
	OBJ_info.SetObject(obj_name)
	If mapid = "IB2200" Then
		Select Case tab_info.id
		Case 2,3,7,8   'CYH추가 (CASE 8)
			OBJ_info.Send
		Case Else
		End Select
	Else
		OBJ_info.Send
	End If

	SCREEN.Proc "OBJ_order.OBJ_odr.hoga_unit", Trim(SCREEN.Object("main.ed_focod").Data)

End Sub

