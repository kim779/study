End Sub

Sub CountUser()
	Dim customer, employee, wts, unknown, msg, term, Total, msg2, Total2
	Dim ctime
	customer = 0
	employee = 0
	wts = 0
	unknown = 0
	iphone = 0
	android = 0
	ipad = 0
	apad = 0
	Total = 0
	Total2 = 0

	For i=1 To GRID01.Rows
		term = Trim(GRID01.GetGridText(i, 7))

		If Len(term)=0 Then
			Exit For
		End If

		term = Left(term, 1)
		ctime = Trim(GRID01.GetGridText(i, 5))

		GRID01.SetGridCell i, 4, Right(ctime, 6)

		If term="T" Then
			employee = employee + 1
			GRID01.SetGridCell i, 1, "HTS"
		ElseIf term="C" Then
			customer = customer + 1
			GRID01.SetGridCell i, 1, "HTS"
		ElseIf term="W" Then
			wts = wts + 1
			GRID01.SetGridCell i, 1, "WTS"
		ElseIf term="I" Then
			iphone = iphone + 1
			GRID01.SetGridCell i, 1, "MTS"
		ElseIf term="J" Then
			android = android + 1
			GRID01.SetGridCell i, 1, "MTS"
		ElseIf term="K" Then
			ipad = ipad + 1
			GRID01.SetGridCell i, 1, "MTS"
		ElseIf term="L" Then
			apad = apad + 1
			GRID01.SetGridCell i, 1, "MTS"
		Else
			unknown = unknown + 1
			GRID01.SetGridCell i, 1, "???"
		End If




	Next

	Total = customer + employee + wts + unknown
	Total2 = iphone + android + ipad + apad
	msg = "고객(" & customer & "),직원(" & employee & "),웹(" & wts & "),기타(" & unknown & ")"
	msg2 = "I(" & iphone & "),A(" & android & "),I.P(" & ipad & "),A.P(" & apad & ")"
	COUNTER.Data = "HTS(" & Total & "):" & msg
	COUNTER2.Data = "MTS(" & Total2 & "):" & msg2

	HTSCNT.Data = Total
	IPHONECNT.Data = iphone
	ANDROIDCNT.Data = Android
	IPADCNT.Data = ipad
	APADCNT.Data = apad
	WTSCNT.Data = wts


End Sub

