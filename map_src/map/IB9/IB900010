_AW_ONDECLARE_AW_
Option Explicit

Sub SendMainClass()
		Dim row, ii, code, rcnt
		row=1

		SYSTEM.Trace "SendMainClass================="
		rcnt = Trim(rcount.Data)

		If rcnt > 0 Then
			SCREEN.Object("parent.90303").Clear
			SCREEN.Object("parent.OBJ1.90303").Clear
		Else
			SCREEN.Object("parent.90303").Clear
		End If

		For ii=1 To VIEWGRID.Rows
			code = Trim(VIEWGRID.GetGridCell(ii, 2))

			If Len(code) = 7 Then
				code = Mid(code, 2)
			End If


			'rcnt = 분할 화면일 경우엔 row 개수가 넘어온다
			If rcnt > 0 Then
				If CLng(row) < CLng(rcnt) Then
					SCREEN.Object("parent.90303").InsertRow(-1)
					SCREEN.Object("parent.90303").SetGridCell SCREEN.Object("parent.90303").rows, 2, code
				Else
					SCREEN.Object("parent.OBJ1.90303").InsertRow(-1)
					SCREEN.Object("parent.OBJ1.90303").SetGridCell SCREEN.Object("parent.OBJ1.90303").rows, 2, code
				End If
			Else
				SCREEN.Object("parent.90303").InsertRow(-1)
				SCREEN.Object("parent.90303").SetGridCell SCREEN.Object("parent.90303").rows, 2, code
			End If

			row = row + 1

		Next

		If rcnt > 0 Then
			SCREEN.Proc "parent.startSend", "1"
		Else
			SCREEN.Proc "parent.startSend", "0"
		End If
End Sub


