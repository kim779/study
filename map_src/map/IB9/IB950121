Function SetGubn()
	SetGubn = "TOT"

	Dim term, ApiTs, id
	Dim staff

	term = Trim(GRID01.GetGridCell(GRID01.Row, 8))

	If Len(term)=0 And Trim(GRID01.GetGridCell(GRID01.Row, 1)) <> "" Then
		Exit Function
	End If

	term = Left(term, 1)
	ApiTs = Trim(GRID01.GetGridCell(GRID01.Row, 9))
	id = Trim(GRID01.GetGridText(GRID01.Row, 3))
	staff = IsNumeric(id)

		Select Case Trim(term)
		Case "T":	' 직원
			If ApiTs="Y" Then	'API 사용자
				SetGubn = "API"
			Else
				If Trim(id) = "##ibk9" Then	'##ibk9이면 (WTS)
					SetGubn = "WTS"
				Else
					SetGubn = "HTS"
				End If
			End If

		Case "C":	' 고객
			If ApiTs="Y" Then	'API 사용자
				SetGubn = "API"
			Else

				If Trim(id) = "##ibk9" Then	'##ibk9이면 (WTS)
					SetGubn = "WTS"
				Else
					SetGubn = "HTS"
				End If
			End If

		Case "O":	' 증권통
			SetGubn = "MST"

		Case "Q":	' 증권플러스
			SetGubn = "MSP"

		Case "S":	' 신 아이폰
			If staff = True Then
				If ApiTs="Y" Then	'API 사용자
					SetGubn = "API"
				Else
					SetGubn = "HTS"
				End If
			Else
				SetGubn = "SSS"
			End If

		Case "U":	' 신 안드로이드
			SetGubn = "UUU"

		Case "i"	' I-One Stock IPhone
			SetGubn = "iii"

		Case "a"	' I-One Stock Android
			SetGubn = "aaa"

		Case "W":	' WTS
			SetGubn = "WTS"

		Case "m":	' 모바일 WTS

			If Trim(id) = "##ibk9" Then	'##ibk9이면 서(W)
				SetGubn = "WTS"
			Else
				SetGubn = "ONE"
			End If

		Case Else	' 미정의
			SetGubn = "TOT"

		End Select

End Function

