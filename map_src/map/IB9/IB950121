{


_AW_ONDECLARE_AW_
Dim	sort
sort = True

Function Null_check(Data)
	If Trim(data) = "" Then
		Null_check = 0
		Exit Function
	End If
	Null_check  = CLng(Data)
End Function

Sub send_f()
	GRID01.Clear
	SCREEN.Send 0
End Sub

Sub CountUser()
	Dim term, id		' 터미널명, 사용자 ID
	Dim ctime, ApiTs 	' 접속시간, API여부
	Dim customer, employee, unknown	' HTS - 고객, 직원, 미상
	Dim wts, mwts		' WTS, Mobile WTS
	Dim eApi, cApi		' API
	Dim mst				' 증권통
	Dim msp				' 증권플러스
	Dim	staff			' 직원
	Dim iphone			' FARM 아이폰
	Dim android			' FARM 안드로이드
	Dim istk			' I-One Stock 아이폰     (신)
	Dim astk			' I-One Stock 안드로이드 (신)


	' 출력 메시지
	Dim msg, msg2, msg3, Total, Total2, Total3

	' 합계
	Total = 0
	Total2 = 0
	Total3 = 0

	' HTS
	customer = 0
	employee = 0
	unknown = 0

	' WTS
	wts = 0
	mwts = 0

	' API
	eApi = 0
	cApi = 0

	' 제휴매체 (증권통/증권플러스)
	msp = 0
	mst = 0

	' MTS
	iphone = 0		' FARM
	android = 0		' FARM
	istk = 0		' I-One
	astk = 0		' I-One


	Dim arrServer
	arrServer = Split(LABEL0.Text, " ", -1, 1)

	For i = 1 To GRID01.Rows
		term = Trim(GRID01.GetGridText(i, 8))	' 터미널 명
		id   = Trim(GRID01.GetGridText(i, 3))	' 접속자 ID

		If Len(term)=0 Then
			Exit For
		End If

		term  = Left(term, 1)					' 접속 터미널 구분 : C(고객) T(직원) S(아이폰) U(안드로이드) m(Mobile-WTS) i(IONE아이폰) a(IONE안드)
		ctime = Trim(GRID01.GetGridText(i, 6))	' 접속시간
		GRID01.SetGridCell i, 5, Right(ctime, 6)

		ApiTs = Trim(GRID01.GetGridText(i, 9))	' API 여부 구분자
		staff = IsNumeric(id)					' 숫자형 ID는 직원으로 간주

		If id = "##ibk9" Then					' ##ibk9 (WTS) ID도 직원으로 간주
			staff = True
		End If

		Select Case Trim(term)
		Case "T":	' 직원
			If ApiTs="Y" Then	'API 사용자
				eApi = eApi + 1
				SetRowColor i, 95
				GRID01.SetGridCell i, 10, "직원용 API"
				GRID01.SetGridCell i, 2, "직(A)"
			Else
				employee = employee + 1
				If Trim(id) = "##ibk9" Then	'##ibk9이면 (WTS)
					GRID01.SetGridCell i, 10, "직원용 HTS - 조회용"
					GRID01.SetGridCell i, 2, "직(H)"
				Else
					GRID01.SetGridCell i, 10, "직원용 HTS"
					GRID01.SetGridCell i, 2, "직(H)"
				End If
			End If

		Case "C":	' 고객
			If ApiTs="Y" Then	'API 사용자
				cApi = cApi + 1
				SetRowColor i, 95
				'GRID01.SetTRgb i, 2, 95
				GRID01.SetGridCell i, 10, "고객용 API"
				GRID01.SetGridCell i, 2, "고(A)"
			Else
				If Trim(id) = "##ibk9" Then	'##ibk9이면 (WTS)
					wts = wts + 1
					GRID01.SetGridCell i, 10, "고객용 WTS"
					GRID01.SetGridCell i, 2, "고(W)"
				Else
					customer = customer + 1
					GRID01.SetGridCell i, 10, "고객용 HTS"
					GRID01.SetGridCell i, 2, "고(H)"
				End If
			End If

		Case "O":	' 증권통
			mst = mst + 1
			GRID01.SetGridCell i, 2, "증(T)"
			GRID01.SetGridCell i, 10, "증권통"

		Case "Q":	' 증권플러스
			msp = msp + 1
			GRID01.SetGridCell i, 2, "증(P)"
			GRID01.SetGridCell i, 10, "증권플러스(카카오스톡)"

		Case "S":	' 구 아이폰
			If staff = True Then
				If ApiTs="Y" Then	'API 사용자
					eApi = eApi + 1
					SetRowColor i, 95
					GRID01.SetGridCell i, 10, "직원용 API"
					GRID01.SetGridCell i, 2, "직(A)"
				Else
					employee = employee + 1
					GRID01.SetGridCell i, 10, "직원용 HTS"
					GRID01.SetGridCell i, 2, "직(H)"
				End If
			Else
				iphone = iphone + 1
				GRID01.SetGridCell i, 2, "아(M)"
				GRID01.SetGridCell i, 10, "구 아이폰"
			End If

		Case "U":	' 구 안드로이드
			android = android + 1
			GRID01.SetGridCell i, 2, "안(M)"
			GRID01.SetGridCell i, 10, "구 안드로이드폰"

		Case "i":	' I-One 신 아이폰
			istk = istk + 1
			GRID01.SetGridCell i, 2, "아(i)"
			GRID01.SetGridCell i, 10, "I-One아이폰"

		Case "a":	' I-One 신 안드로이드
			astk = astk + 1
			GRID01.SetGridCell i, 2, "안(a)"
			GRID01.SetGridCell i, 10, "I-One안드로이드"

		Case "W":	' WTS
			wts = wts + 1
			If Trim(id) = "##ibk9" Then	'##ibk9이면 서(W)
				GRID01.SetGridCell i, 2, "서(W)"
				GRID01.SetGridCell i, 10, "서버용 WTS"
			Else
				GRID01.SetGridCell i, 2, "WTS"
				GRID01.SetGridCell i, 10, "웹 WTS"
			End If

		Case "m":	' 모바일 WTS
			mwts = mwts + 1
			If Trim(id) = "##ibk9" Then	'##ibk9이면 서(W)
				GRID01.SetGridCell i, 2, "서(m)"
				GRID01.SetGridCell i, 10, "서버용 Mobile WTS"
			Else
				GRID01.SetGridCell i, 2, "고(m)"
				GRID01.SetGridCell i, 10, "Mobile  WTS"
			End If

		Case Else	' 미정의
			unknown = unknown + 1
			GRID01.SetGridCell i, 2, "???"
			GRID01.SetGridCell i, 10, "미정의[" & term & "]"

		End Select

	Next

	Total  = customer + employee + cApi + eApi + unknown
	Total2 = iphone + android + mst + msp + istk + astk
	Total3 = wts + mwts
	msg  = "고(" & customer & ") 직(" & employee & ") API(" & cApi + eApi & ") ETC(" & unknown & ")"
	msg2 = "(구)아(" & iphone   & ") (구)안(" & android  & ") 플("  & msp     & ")"
	msg3 = "WTS("& wts & ") IONE(" & mwts & ")"
	msg4 = "(신)아(" & istk & ") (신)안(" & astk & ")"
'	COUNTER.Data  = "HTS(" & Total  & ")=" & msg
'	COUNTER2.Data = "MTS(" & Total2 & ")=" & msg2
'	COUNTER3.Data = "WTS(" & Total3 & ")=" & msg3
	COUNTER.Data  = "HTS(" & Total  & ")"
	COUNTER2.Data = "MTS(" & Total2 & ")=" & msg4	' I-One Stock 신규 매체 추가 (msg4)
	COUNTER3.Data = "WTS(" & Total3 & ")=" & msg3
	LABEL1.Data  = msg
	LABEL2.Data = msg2


	HTSCNT.Data      = customer + employee	' HTS     : 고객 + 직원
	IPHONECNT.Data   = iphone			    ' iPhone  : iPhone
	ANDROIDCNT.Data  = Android			    ' Android : And
	APICNT.Data      = cApi + eApi		    ' API
	WTSCNT.Data      = wts				    ' WTS
