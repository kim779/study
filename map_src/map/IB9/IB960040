_AW_ONDECLARE_AW_
Dim g_flag
Dim g_ArrCtrl
Dim dic, myFSO, WriteStuff, ReadStuff, line, lines


'dic = SYSTEM.Home & "/dev/" & "cfgtmp2.ini"
dic = SYSTEM.Home & "/tab/" & "IPOINFO.INI"
itmp.Data = dic
g_ArrCtrl = Array(sjil, ed_startdate, ed_enddate, cod2, hnam, desc, dftp,jmid, gmga, dsga, image, ed_downloadurl)
'-----------------------------------------------------------------------
Sub InitCtrl() 'Edit Box 초기화
	For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
		If i <> 0 Then
			g_ArrCtrl(i).Data = ""
		End If
	Next
End Sub
'-----------------------------------------------------------------------
Sub Grid2Edit(Row) '그리드 Row 클릭시, 하단 EditBox에 Road

	For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
		g_ArrCtrl(i).Data = GRID0.GetGridCell(Row, i + 1)
	Next
End Sub
'-----------------------------------------------------------------------
Sub Edit2Grid(Row) '그리드 저장 버튼 클릭시, 해당 row 그리드에 Save
	Dim tmp
	For i = LBound(g_ArrCtrl) To UBound(g_ArrCtrl)
		GRID0.SetGridCell Row, i + 1, g_ArrCtrl(i).Data
	Next
End Sub
'-----------------------------------------------------------------------
Sub FileWrite(str) 'INI FILE WRITE
	Set myFSO = CreateObject("Scripting.FileSystemObject")
	Set WriteStuff = myFSO.CreateTextFile(dic, True)

	WriteStuff.WriteLine(str)
	WriteStuff.Close

	Set myFSO = Nothing
	Set WriteStuff = Nothing
End Sub
'-----------------------------------------------------------------------
Sub Fileread()	'INI FILE ROAD
	Dim kk, tm
	lines = ""
	lines = ""
	Set myFSO = CreateObject("Scripting.FileSystemObject")
	If myFSO.FileExists(dic) = False Then
		MsgBox "설정파일이 없습니다. " & dic
		Exit Sub
	End If
	Set f = myFSO.GetFile(dic)
	Set readStuff = myFSO.OpenTextFile(dic, 1, True)

	kk = 0
	Do Until readStuff.AtEndOfStream
		line = readStuff.ReadLine
		If Len(Trim(line)) > 0 Then
			lines = lines & line & vbCrLf
			kk = kk + 1
		End If
	Loop

	data = Split(lines, vbCrLf, -1, 1)

	If Trim(lines) <> "" Then
		For ii = 0 To kk-1
			myline = Split(data(ii), "|", -1, 1)

			For jj = 0 To 11
				GRID0.SetGridCell ii+1, jj+1, Trim(myline(jj))
			Next
			GRID0.InsertRow(ii+1)
		Next
	End If

	readStuff.Close

	updatedate.Data = f.DateLastModified

	Set myFSO = Nothing
	Set readStuff = Nothing
End Sub
'-----------------------------------------------------------------------

