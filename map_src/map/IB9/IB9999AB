RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_init()
	zEmpNo.Data = SYSTEM.UserID
	zQrySrtDt.Data = Replace(Date,"-","")
	zQryEndDt.Data = Replace(DateAdd("d", 14, Date),"-","")
	zPrdTp.Data = "00"
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	Call Set_init()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim i,ii
	ii = 1
	GRID1.InsertRow -1
	For i=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,7)) <> "" Then
			GRID1.SetGridCell ii,1, Trim(GRID0.GetGridCell(i,7))
			GRID1.SetGridCell ii,2, Trim(GRID0.GetGridCell(i,5))
			ii = ii+1
		End If
	Next
End If

GRID1.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONDBLCLK_AW_
Dim i,ii
ii = 1
GRID1.InsertRow -1
For i=1 To GRID0.Rows
	If Trim(GRID0.GetGridCell(i,5)) = Trim(GRID1.GetGridCell(GRID2.Row,2)) Then
		GRID2.SetGridCell ii,1, Trim(GRID0.GetGridCell(i,1))
		GRID2.SetGridCell ii,3, Trim(GRID0.GetGridCell(i,3))
		GRID2.SetGridCell ii,4, Trim(GRID0.GetGridCell(i,4))
		GRID2.SetGridCell ii,5, Trim(GRID0.GetGridCell(i,5))
		GRID2.SetGridCell ii,7, Trim(GRID0.GetGridCell(i,7))
		GRID2.SetGridCell ii,8, Trim(GRID0.GetGridCell(i,8))
		GRID2.SetGridCell ii,9, Trim(GRID0.GetGridCell(i,9))
		GRID2.SetGridCell ii,10, Trim(GRID0.GetGridCell(i,10))
		ii = ii+1
	End If
Next
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


