_AW_ONSTART_AW_
yesYear.Text = Left(DateAdd("d", -1, Date), 4)
yesMonth.Text = Mid(DateAdd("d", -1, Date), 6, 2)
yesDay.Text = Right(DateAdd("d", -1, Date), 2)

zStrDt.Data = yesYear.Text & yesMonth.Text & yesDay.Text
zEndDt.Data = yesYear.Text & yesMonth.Text & yesDay.Text

'SCREEN.SEND 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii
Dim  hcsum, hjsum, htsum
GRID0.Sort 7,False,False

hcsum = 0
hjsum = 0
htsum = 0

For ii = 1 To GRID0.Rows

	If IsNumeric(GRID0.GetGridCell(ii, 5)) = True Then
		hcsum = hcsum + CDbl(GRID0.GetGridCell(ii, 5))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 6)) = True Then
		hjsum = hjsum + CDbl(GRID0.GetGridCell(ii, 6))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 7)) = True Then
		htsum = htsum + CDbl(GRID0.GetGridCell(ii, 7))
	End If
Next


	tcsum.Data = hcsum
	tjsum.Data = hjsum
	ttsum.Data = htsum

