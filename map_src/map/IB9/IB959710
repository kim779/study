RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send()
	GRID0.Clear
	
	If LOGIN.Brno = "937" Or LOGIN.Brno = "942" Then			'스마트 금융부만 조회되게 처리
		usid.Data = Trim(LOGIN.User)
		SCREEN.Send 0
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_


MsgBox emsg.Data, ,"IBK투자증권"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
If Trim(sday.Data) > Trim(eday.Data) Then
	MsgBox "조회기간을 확인바랍니다.", ,"IBK투자증권"
	Exit Sub
End If

Dim srtDt, srtDt2
srtDt = Trim(eday.Data)
srtDt = Left(srtDt, 4) & "-" & Mid(srtDt, 5, 2) & "-" & Right(srtDt, 2)

srtDt2 = change_indate("m", -1, srtDt)

If Trim(sday.Data) < Trim(srtDt2) Then
	MsgBox "최대 조회기간은 한달입니다. ", ,"IBK투자증권"
	Exit Sub
End If


Call send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Select Case GRID0.HitPos
Case 3	'DATA부 click
	If GRID0.HitPos <> 3 Then
		Exit Sub
	End If
	SCREEN.Object("main.in_date").Data = Trim(GRID0.GetGridCell(GRID0.row, 1))
	SCREEN.Object("main.in_time").Data = Trim(GRID0.GetGridCell(GRID0.row, 2))
	SCREEN.Object("main.seqn").Data = Trim(GRID0.GetGridCell(GRID0.row, 3))
	SCREEN.Object("main.titl").Data = Trim(GRID0.GetGridCell(GRID0.row, 4))

	SCREEN.Object("OBJ.usid").Data = Trim(LOGIN.User)
	SCREEN.Object("OBJ.in_date").Data = Trim(GRID0.GetGridCell(GRID0.row, 1))
	SCREEN.Object("OBJ.seqn").Data = Trim(GRID0.GetGridCell(GRID0.row, 3))

	If LOGIN.Brno = "937" Or LOGIN.Brno  = "942" Then			'스마트 금융부만 조회되게 처리
		OBJ.Send
	End If

Case Else
	SCREEN.OnSend = False
	Exit Sub
End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(sday)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(eday)
_AW_ENDSCRIPT_AW_


}



