_AW_ONDECLARE_AW_
Option Explicit

Dim mmgb, mapNm, acnt
mmgb = ""
mapNm = ""
acnt = ""

Function CheckHoga(para)
	Dim pre_para
  	pre_para = Mid(para, 2,1)

	If (pre_para = "3") Or (pre_para = "6") Or (pre_para = "7") Or (pre_para = "1") Then
		CheckHoga = True
	Else
	    CheckHoga = False
	End If

	If para = "01" Then   '스톱지정가인 경우
		CheckHoga = False
	End If

End Function

Sub CalcJungsan()
	mapNm = Trim(SCREEN.GetMapName(1))
	If mapNm = "IB105000" Then
		Exit Sub
	End If

	acnt = Trim(SCREEN.Object("parent.parent.AN1A").Data)

	If acnt = "" Then
		Call dataClear()
		Exit Sub
	End If

	jmcd.Data = Trim(SCREEN.Object("main.1301").Data)

	If Len(Trim(jmcd.Data)) <> 6 Then
		Call dataClear()
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "0" Then
		If Trim(account.Data) = acnt Then
			Call calc()
		Else
			account.Data = acnt
			OBJ_FEE.Send
		End If
	Else								'직원용일경우 수수료를 가져올 필요없이 영업점 수수료 계산
		Call calc()
	End If
End Sub

Sub calc()

'	SYSTEM.Trace "calc step1"
	If SYSTEM.ConnectBy = "0" Then
		If Trim(out_hts.Data) = "" Then
			Call dataClear()
			Exit Sub
		End If
	End If

'	SYSTEM.Trace "calc step2"

	Dim tamt, jqty, jprc, tprc, shogb
	jqty = Trim(SCREEN.Object("parent.ed_jqty").Data)

	If Is_numeric(jqty) = False Then
		Call dataClear()
		Exit Sub
	End If

	If mapNm = "IB103000" Then												'단주주문
		isDanju.Text = "단주"
		jprc = Trim(SCREEN.Object("main.OBJ_sise.2023").Data)
		shogb = "00"
	ElseIf mapNm = "IB100100" Or mapNm = "IB100200" Or mapNm = "IB800000" Or mapNm = "IB000100" Then
		If SCREEN.Object("main.tab_ordtyp").ID = "2" Then									'단주주문
			isDanju.Text = "단주"
			jprc = Trim(SCREEN.Object("main.OBJ_sise.2023").Data)
			shogb = "00"
		ElseIf SCREEN.Object("main.tab_ordtyp").ID = "0" Then								'현금/신용
			isDanju.Text = ""
			jprc = Trim(SCREEN.Object("parent.ed_jprc").Data)
			shogb = Trim(SCREEN.Object("parent.shogb").Data)
		End If
	Else
		isDanju.Text = ""
		jprc = Trim(SCREEN.Object("parent.ed_jprc").Data)
		shogb = Trim(SCREEN.Object("parent.shogb").Data)
	End If

	If Is_numeric(jprc) = False Then
		Call dataClear()
		Exit Sub
	End If

	If CheckHoga(shogb) = True Then
		tprc = Trim(SCREEN.Object("main.OBJ_SISE.2023").Data)

	    If is_numeric(tprc) = True Then
	  		jprc = tprc
	  	Else
	  		Call dataClear()
	  		Exit Sub
	    End If
	End If

	tamt = jqty * jprc
	If Is_numeric(tamt) = False Then
		Call dataClear()
		Exit Sub
	End If

	orderAmt.Data = tamt													'주문금액

	'**************************************************************************************
	' 수수료 계산
	' 수수료는 원단위이하 절삭
	'**************************************************************************************
	Dim jmcdtp, tmpFee
	'jmcdtp = SCREEN.GetCodeType(Trim(jmcd.Data))		'SCREEN.GetCodeType : 1 거래소, 2 코스닥, 3 프리보드, 6 ETF, 9 ELW
	jmcdtp = SCREEN.GetName(199, Trim(jmcd.Data), 0)
	If Trim(jmcdtp) = "" Then
		Exit Sub
	End If
	'SYSTEM.Trace "jmcdtp : " & jmcdtp
	If Trim(isDanju.Text) <> "단주" Then
		If SYSTEM.ConnectBy = "0" Then
			If Is_numeric(save_hts.Data) = False Then
				save_hts.Data = "0"
			End If

			If Trim(out_hts.Data) = "+0.00012500" And Trim(save_hts.Data) = "+000000000000500" Then		'save 수수료
				If tamt >= 1000 Then
					tmpFee = Fix(CDbl(tamt) * CDbl(out_hts.Data))					'소수점이하 버림.
					tmpFee = CDbl(Left(Trim(tmpFee), Len(tmpFee) - 1) & "0") 		'수수료는 원단위 이하 절삭
					feeAmt.Data = tmpFee + CDbl(save_hts.Data)
				Else																'save수수료이면서 주문금액이 1000원이하이면 수수료는 0.1%에 +500원 제외
					tmpFee = Fix(CDbl(tamt) * 0.001)								'수수료 0.1%, 소수점이하 버림.
					tmpFee = CDbl(Left(Trim(tmpFee), Len(tmpFee) - 1) & "0")
					feeAmt.Data = tmpFee 											'+500원 제외
				End If
			Else
				tmpFee = Fix(CDbl(tamt) * CDbl(out_hts.Data))						'소수점이하 버림.
				tmpFee = CDbl(Left(Trim(tmpFee), Len(tmpFee) - 1) & "0") 			'수수료는 원단위 이하 절삭
				feeAmt.Data = tmpFee + CDbl(save_hts.Data)
			End If
		Else																		'직원용
			If jmcdtp = 3 Then														'프리보드는 수수료 0.4%
				tmpFee = Fix(CDbl(tamt) * 0.004)
			Else
				tmpFee = Fix(CDbl(tamt) * 0.005)
			End If

			tmpFee = CDbl(Left(Trim(tmpFee), Len(tmpFee) - 1) & "0")

			feeAmt.Data = tmpFee
		End If
	Else
		tmpFee = Fix(CDbl(tamt) * 0.005)								'단주주문시 수수료는 0.5%, 소수점이하 버림.
		tmpFee = CDbl(Left(Trim(tmpFee), Len(tmpFee) - 1) & "0") 		'수수료는 원단위 이하 절삭

		feeAmt.Data = tmpFee
	End If

	If Is_numeric(feeAmt.Data) = False Then
		feeAmt.Data = 0
	End If


	'**************************************************************************************
	' 거래세 계산
	' 거래세는 사사오입
	'**************************************************************************************
	Dim tmpTax



	If mmgb = "1" Then												'매도
		If isDanju.Text <> "단주" Then
			If Trim(jmcdtp) = "" Then
				Exit Sub
			End If
			Select Case jmcdtp
				Case 1, 2, 3 : tmpTax = Round((CDbl(tamt) * 0.0015), 0)		'코스피, 코스닥, K-OTC: 거래세 0.15%, 거래세는 사사오입
																 			'단 코스피는 증권거래세 0.00% + 농특세 0.15% 총 0.15%
				Case 28 : tmpTax = Round((CDbl(tamt) * 0.001), 0)			'코넥스 : 거래세 0.1%, 거래세는 사사오입
				Case 6, 9 :	tmpTax = 0										'ETF, ELW는 거래세 없음.
			End Select
		Else
			tmpTax = Round((CDbl(tamt) * 0.005), 0)							'단주주문일경우 세금은 0.5%
		End If
	Else
		tmpTax = 0
	End If

	taxAmt.Data = tmpTax

	If Is_numeric(taxAmt.Data) = False Then
		taxAmt.Data = 0
	End If

'	SYSTEM.Trace "Caljungsan:: mmgb : " & mmgb & "  tamt : " &  tamt
'	SYSTEM.Trace "Caljungsan:: jmcdtp : " & jmcdtp & "  tmpTax : " &  tmpTax
	'**************************************************************************************
	' 정산금액
	'**************************************************************************************
	Dim tmpJungsanAmt

	If mmgb = "1" Then
		tmpJungsanAmt = CDbl(orderAmt.Data) - CDbl(feeAmt.Data) - CDbl(taxAmt.Data)
	Else
		tmpJungsanAmt = CDbl(orderAmt.Data) + CDbl(feeAmt.Data)
	End If

'	SYSTEM.Trace "Caljungsan:: tmpJungsanAmt : " &  tmpJungsanAmt

	out_total.Data = Trim(FormatNumber(tmpJungsanAmt,0)) & " 원"
End Sub


Sub dataClear()
	orderAmt.Data = 0
	feeAmt.Data = 0
	taxAmt.Data = 0
	out_total.Data = ""
End Sub

