RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	LISTGRID.Clear
	stgb.Data = "T"
	title.Clear
	SCREEN.Object("object0.memo").clear
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
stgb.Data = "T"
nkey.Data = ""
b_next.Enable = False
LISTGRID.Clear
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
'LISTGRID.Clear

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim i

' 확인여부에 따라 한글메세지를 세팅한다.
For i=1 To LISTGRID.Rows
	If LISTGRID.GetGridCell(i, 5)="Y" Then
		LISTGRID.SetGridCell i, 4, "확인"
	Else
		LISTGRID.SetGridCell i, 4, "미확인"
	End If
Next

' 조회후 첫번째 Row의 본문을 조회한다.
If LISTGRID.Rows > 0 And LISTGRID.ROW = 1 Then
	SCREEN.Object("OBJECT0.ckey").Data = LISTGRID.GetCell(1,"ckey")
	SCREEN.Object("Object1.ckey").Data = LISTGRID.GetGridCell( 1, 13 )
	LISTGRID.Row = 1
	SCREEN.Object("object1.cust_id").data = Trim(LISTGRID.getgridcell(1, 8))
	If Trim(LISTGRID.GetGridCell (1, 5)) = "Y" Then
		SCREEN.Object("OBJECT1.edit").enable = False
		SCREEN.Object("OBJECT1.delete").enable = False

	Else
		SCREEN.Object("OBJECT1.edit").enable = True
		SCREEN.Object("OBJECT1.delete").enable = True
	End If

	title.Text = Trim(LISTGRID.Getgridcell (1,3))
	OBJECT0.Send
End If

' 다음데이타가 존재하지 않으면 "다음"버튼을 비활성화 시킨다.
If stgb.Data="N" Then
	b_next.Enable = True
Else
	b_next.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(usid)
_AW_ONKEYCHANGE_AW_
stgb.Data = "T"
nkey.Data = ""
b_next.Enable = False
LISTGRID.Clear
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_next)
_AW_ONCLICK_AW_
LISTGRID.SetDataPosition 2
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(LISTGRID)
_AW_ONCLICK_AW_
' Row가 -1이면 조회할 필요 없음.
If  LISTGRID.Row <> -1 Then

	' 확인된 사항이면 수정 금지하도록 한다.
	If LISTGRID.GetCell( LISTGRID.Row, "chck" )="Y" Then
		'SCREEN.Object("Object0.memo").Enable = False
		'SCREEN.Object("Object1.cust_id").Enable = False
		SCREEN.Object("Object1.delete").Enable = False
		SCREEN.Object("object1.edit").enable = False
		'title.Enable = False
	Else
		'SCREEN.Object("Object0.memo").Enable = True
		SCREEN.Object("Object1.cust_id").Enable = True
		SCREEN.Object("object1.edit").enable = True
		SCREEN.Object("Object1.delete").Enable = True
		'title.Enable = True
	End If

	' 본문조회키를 세팅한다.
	SCREEN.Object("Object0.ckey").Data = LISTGRID.GetGridCell( LISTGRID.Row, 13 )
	SCREEN.Object("Object1.ckey").Data = LISTGRID.GetGridCell( LISTGRID.Row, 13 )
	title.text = Trim(LISTGRID.getgridcell(LISTGRID.Row, 3))
	SCREEN.Object("object1.cust_id").data = Trim(LISTGRID.getgridcell(LISTGRID.Row, 8))
	OBJECT0.Send
End If

If LISTGRID.HitPos = 2 And stgb.Data = "N" Then
	LISTGRID.Row = LISTGRID.Rows
	LISTGRID.SetDataPosition 2
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(sday)
_AW_ENDSCRIPT_AW_


}



