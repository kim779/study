'***************************************************************************
' DESC: 종목코드 변경시 Setting
'***************************************************************************
Sub ChangeCode()
	Dim cPos
SCREEN.IgnoreChange True
	If mmgb <> "4" Then
		Call Hoga_unit(ed_focod.Data)
	End If

	' 스프레드일 경우 Spin버튼에 의해 마이너스값도 입력되게끔 수정함 09.06.25 lkm
