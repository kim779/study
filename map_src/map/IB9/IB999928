		ed_focod.Setfocus
	End If

'	If start_f = 0 Then
'		SCREEN.Proc "parent.send_sise", "jumn" & "," & S1301.Data
'	Else
'		start_f = 0
'	End If
SCREEN.IgnoreChange False

