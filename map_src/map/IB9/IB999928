'****************************************************************************
' DESC: 주문옵션적용 when: common(주문전), after(주문후)
'****************************************************************************
Sub QueryOption(when)

	Dim qtyOpt, cfgGB, prc, ret

	ret = SYSTEM.Pop ("F_ogno")
	If ret <> "" Then
		Exit Sub
	End If

	If when = "after" Then
		If OrdCfg.KeepQty = False Then		'-- 수량유지안함
			ed_jqty.Data = "0"
		End If
		' 금감원 원칙으로 주문후 원주문번호 clear
		Select Case mmgb
		Case "3", "4"
			ed_ogno.Data = ""
		End Select

		If mmgb <> "4" And OrdCfg.KeepPrc = False Then		'-- 단가유지안함
			ed_jprc.Data = "0"
		End If
		Exit Sub
	End If

'	If when = "after" Then
'		Select Case mmgb
'		Case "3", "4"
'			ed_jqty.Data = "0"
'			ed_ogno.data = ""
'			If mmgb = "3" Then		ed_jprc.Data = "0"
'			Exit Sub
'		End Select
'	End If

	Select Case mmgb
		Case "1" : cfgGB = "SellQtyGB"
		Case "2" : cfgGB = "BuyQtyGB"
		Case "3"
			qtyOpt = OrdCfg.ReadCfg("JJPrcGB")
			Select Case qtyOpt
				Case "0"
					ed_jprc.Data = "0"
				Case "1" ': OrdCfg.QueryHoga				'기본단가설정 사용
					Call QueryHoga()	'OrdCfg.QueryHoga		'기본단가설정 사용
				Case "2"
					prc = SYSTEM.Pop("FO_jprc")
					If Trim(prc) = "" Then prc = "0"
					ed_jprc.data = prc
			End Select

			Exit Sub
		Case "4" : Exit Sub
	End Select

	'단가설정
	Select Case Right(c_hogb.Data,1)
	Case "0", "5"			'지정(00,10,20), 조건부지정
		If when = "common" Or OrdCfg.KeepPrc = False Then	'주문전 or 주문수량유지안함
			Call QueryHoga()	'OrdCfg.QueryHoga			'기본단가설정 사용
		End If
	Case Else
		ed_jprc.Data = "0"
	End Select

	'수량설정
	ret = SYSTEM.Pop ("F_jqty")
	If ret <> "" Then
		ed_jqty.data = ret
		SYSTEM.Push "F_jqty", ""
		Exit Sub
	End If

	If when = "common" Or OrdCfg.KeepQty = False Then		'주문전 or 주문단가유지안함
		qtyOpt = OrdCfg.ReadCfg(cfgGB)							'수량설정 index
		Select Case qtyOpt
			Case "0", "2"				'수량, 금액매수 Set
				OrdCfg.QueryQty
			Case "1"						'매도가능수량 Set				'
				SCREEN.SetTimer 3, False
			Case Else
		End Select
	End If

	SCREEN.Object("main.guide" & refsrc).Text = " "					'메세지
End Sub

Sub QueryHoga()
	Dim siseObj, prcOpt, cfgGB

	siseObj = "main.OBJ_sise" & refsrc & "."
	Select Case mmgb
		Case "1" : cfgGB = "SellPrcGB"
		Case "2" : cfgGB = "BuyPrcGB"
		Case "3"
'			OrdCfg.QueryHoga
			If OrdCfg.ReadCfg("JJPrcGb") <> "1" Then Exit Sub

			prcOpt = "023"
'			Exit Sub
		Case Else : Exit Sub
	End Select

	If Right(c_hogb.Data,1) = "3" Or Right(c_hogb.Data,1) = "6" Then
		ed_jprc.Data = "0"
		Exit Sub
	End If

	If mmgb < "3" Then	prcOpt = OrdCfg.ReadCfg(cfgGB)
	If Trim(prcOpt) = "" Then prcOpt = "023"
	Select Case Left(ed_focod.Data,1)
	Case "1", "4", "A", "D" :
					prcOpt = "31" & prcOpt
	Case "2", "3", "B", "C" :
					prcOpt = "41" & prcOpt
	Case Else : Exit Sub
	End Select
	If Len(Trim(prcOpt)) < 5 Then Exit Sub

	prcOpt = siseObj & prcOpt
	ed_jprc.Data = SCREEN.Object(prcOpt).Data

	OrdCfg.Price = CStr(ed_jprc.Data / 100)
	OrdCfg.Push
	If mmgb = "3" Then Exit Sub

	If chk_auto.Checked = False Then
		ed_jprc.Data = "0"
		Exit Sub
	End If

End Sub

'****************************************************************************
' DESC: 주문가능수량 설정
'****************************************************************************
Sub set_avol(data)
	If Trim(data) = "" Then data = "0"
	ed_jqty.Data = data
End Sub

'***************************************************************************
' 선물/옵션 주문 포커스 관리(정정/취소)
'***************************************************************************
Sub ogno_focus()
	Dim cPos, flag

	If Trim(ed_ogno.data) = "" Or Trim(ed_ogno.data) < "1" Then
		flag = False
	Else
		flag = True
	End If

	If flag = True Then
		If Trim(SCREEN.Object("main.AN20").data) = "" Or Trim(ed_pswd.data) = "" Then
			SCREEN.SetTimer 1, False
			Exit Sub
		End If

		If OrdCfg.OrderGB = "2" Then					'정정일때만 커서 셋팅
			cPos = OrdCfg.ReadCfg("JJCursorPos")	'수량,유형,가격
			Select Case cPos
				Case "0" : ed_jqty.Setfocus
				Case "1" : ed_hogb.Setfocus
				Case "2" : ed_jprc.Setfocus
			End Select
		ElseIf OrdCfg.OrderGB = "3" Then
			JUMUN_B.Setfocus
		End If
	Else
		cPos = OrdCfg.ReadCfg("NotMoveCode") '커서유지
		If cPos = "1"Then
			ed_focod.Setfocus
		Else
			SCREEN.SetTimer 2, False
		End If
	End If
End Sub

'***************************************************************************
' 선물/옵션 주문후 커서 설정
'***************************************************************************
Sub Set_cursor()
	Dim cPos

	cPos = OrdCfg.ReadCfg("CursorPos")
	Select Case cPos
		Case "0"
			SCREEN.Object("main.AN20").SetFocus
		Case "1"
			SCREEN.Object("main.ed_pswd").SetFocus
		Case "2"
			ed_focod.Setfocus()
		Case "3"
			ed_jqty.SetFocus()
		Case "4"
			ed_jprc.SetFocus()
	End Select
End Sub

'***************************************************************************
' 선물/옵션 주문가능수량 조회
'***************************************************************************
Sub get_avol()
	Dim	param, hogb, flag

	ed_acno.Data = SCREEN.Object("main.AN20").Data
	ed_pswd.Data = SCREEN.Object("main.ed_pswd").Data

	If Trim(ed_acno.data) = "" Or Trim(ed_pswd.Data) = "" Then
		Exit Sub
	End If

	'== obj:: send_tr(acno, pwd, gubn, mmgb, cod2, pric, ptnc, flag)
	'gubn : 1.일반 2.금액 3.비율
	'mmgb : 1.매도 2.매수
	'ptnc : 호가구분
	'flag : 가능수량종류 (1.주문가능수량 2.신규 3.청산)

	Select Case c_hogb.Data
	Case "03", "05", "06"
		hogb = c_hogb.Data
	Case Else
		hogb = "00"
	End Select

	If mmgb = "1" Then
		flag = "1"
	Else
		flag = "2"
	End If
	param = ed_acno.Data &","& ed_pswd.Data &","& "1," &_
			mmgb &","& ed_focod.Data &","& ed_jprc.Data &","&hogb&","&flag
	OBJ_avol.Proc "send_tr", param
End Sub

