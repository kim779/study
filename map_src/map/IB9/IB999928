'***************************************************************************
' 주식 정정/취소시 원주문번호,주문단가 셋팅
'***************************************************************************
Sub Get_jmno ()
	Dim ret, prc, num, cPos

	num = SYSTEM.Pop ("F_ogno")

	If num <> "" Then
		num = SYSTEM.Pop ("F_ogno")
		prc = SYSTEM.Pop ("F_jprc")
		SYSTEM.Push "F_ogno", ""
		SYSTEM.Push "F_jprc", ""
	Else
		o_jmno.data = ""
		num = SYSTEM.Pop ("FO_ogno")
		prc = SYSTEM.Pop ("FO_jprc")
	End If

	If Trim(num) <> "000000" Or Trim(num) <> ""Then
		ed_ogno.data = num
	End If

	Select Case SCREEN.Object("parent.tab_order").ID
	Case 3, 4
		If Trim(prc) <> "" Then
			If OrdCfg.ReadCfg("JJPrcGb") = "2" Then
				'정정주문의 주문단가 조회
				ed_jprc.data = prc
				'CONFIG.Price
			End If
		End If
	End Select

End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim mstr
	Error_check = False
	If Trim(ed_acno.Data) = "" Then
		SCREEN.Object("main.AN20").SetFocus
		MsgBox "계좌번호를 확인하십시오.", , "IBK투자증권"
		Exit Function
	End If
	If Len(Trim(ed_pswd.Data)) < 4 Then
		SCREEN.Object("main.ed_pswd").SetFocus
		MsgBox "비밀번호를 확인하십시오.", , "IBK투자증권"
		Exit Function
	End If
	Select Case mmgb
		Case "1" : mstr = "매도"
		Case "2" : mstr = "매수"
		Case "3" : mstr = "정정"
		Case "4" : mstr = "취소"
	End Select

	'주문수량 check
	If ed_jqty.Enable = True And Is_numeric(ed_jqty.Data) = False Then
		MsgBox mstr & "수량을 입력하십시오.", , "IBK투자증권"
		ed_jqty.SetFocus
		Exit Function
	End If

	'주문단가 check
	If mstr <> "취소" Then
		If ed_jprc.Enable = True Then
			If Left(ed_focod.Data,3)<>"401" And Left(ed_focod.Data,3)<>"D01" Then
				If Is_numeric(ed_jprc.Data) = False Then
					MsgBox mstr & "가격을 입력하십시오.", , "IBK투자증권"
					ed_jprc.SetFocus
					Exit Function
				End If
			Else
				' Spread종목의 경우 -가 올 수 있으므로 Is_numeric을 쓰지 않는다. lkm 09.06.04
				If IsNumeric(ed_jprc.Data) = False Then
					MsgBox mstr & "가격을 입력하십시오.", , "IBK투자증권"
					ed_jprc.SetFocus
					Exit Function
				End If
			End If
		End If
	End If

	If mstr = "정정" Or mstr = "취소" Then
		If Is_numeric(ed_ogno.Data) = False Then
			MsgBox "원주문번호를 확인하십시오.", , "IBK투자증권"
			ed_ogno.SetFocus
			Exit Function
		End If
	End If

	'주문착오방지를 위한 모범규준 check

	If chk_mistake_order_sp(ed_focod.Data, ed_jprc.data) = False Then
		Exit Function
	End If

	Error_check = True
End Function

