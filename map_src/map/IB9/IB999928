			If chk_date.checked = True Then
				If Trim(ed_fdate.data) = "" Then ed_fdate.data = LOGIN.Day0
				If Trim(ed_edate.data) = "" Then ed_edate.data = LOGIN.Day0
				ed_gmm.data = "2"&ed_fdate.data&ed_edate.data
			Else
				ed_gmm.data = "1"
			End If
