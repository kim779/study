		ed_odgb.Data = "2"			'주문유형
	End If

	ed_mmgb.Data = mmgb			'매매구분
	ed_focod.Data = SCREEN.Object("main.ed_focod" & refsrc).Data
	hnam.Data = SCREEN.Object("main.hnam" & refsrc).Data

	Select Case mmgb
		Case "3"
			ed_hogb.data = c_hogb.Data
'			ed_hogb.Data = "99"			'호가구분 - 원주문호가(99)
			ed_jmgb.Data = "00"			'주문조건
		Case "4"
			ed_jprc.Data = ""			'주문단가
			ed_hogb.Data = ""			'호가구분
			ed_jmgb.Data = "00"			'주문조건
		Case Else
			ed_ogno.Data = ""			'원주문번호
