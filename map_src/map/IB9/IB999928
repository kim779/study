'***************************************************************************
' DESC: 사용자 입력키 Action
'***************************************************************************
Sub OnAxUserKey(key)
	If OrdCfg.EnterOrder = True Then
		If key = 13 Then
			SYSTEM.UserKey	= True
			If OrdCfg.OrderGB = "3" Then '취소시 전부취소
				ed_mdgb.Data = "2"
				r_mdgb0.checked = True
			End If
			DoOrder()
		End If
	End If
End Sub
'***************************************************************************
' DESEC: 선물/옵션 호가단위 Setting
'***************************************************************************
Sub Hoga_unit(code)
	Dim retn

	If Len(Trim(code)) <> 8 Then Exit Sub

	ed_jprc.SetType(110)
	Select Case Left(code,3)
		Case "101", "401", "A01", "D01"
			ed_jprc.SetType(110)	'지수선물
			c_pric.type = Asc("F")
		Case "103", "403", "A03", "D03"
			ed_jprc.SetType(101)	'스타선물
			c_pric.type = Asc("F")
		Case "201", "209", "2AF", "B01", "B09", "BAF" '콜옵션
			ed_jprc.SetType(120)
			c_pric.type = Asc("O")
		Case "301", "309", "3AF", "C01", "C09", "CAF"  '풋옵션
			ed_jprc.SetType(130)
			c_pric.type = Asc("O")
		Case "105", "A05"			'미니지수선물
			ed_jprc.SetType(112)
			c_pric.type = Asc("F")
		Case "405", "D05"			'미니스프레드선물
			ed_jprc.SetType(113)
			c_pric.type = Asc("F")
		Case "205", "B05"			'미니 콜옵션
			ed_jprc.SetType(121)
			c_pric.type = Asc("O")
		Case "305", "C05"			'미니 풋옵션
			ed_jprc.SetType(131)
			c_pric.type = Asc("O")
		Case Else
			If Left(code,1) <> "A" And Left(code,1) <> "B" And Left(code,1) <> "C" And Left(code,1) <> "D" Then
				If Int(Mid(code,1,2)) > 10 Then
					ed_jprc.SetType 100
				End If
			End If
	End Select
	c_pric.jcode = code
End Sub

'***************************************************************************
' DESC: 호가조건 ComboBox 전환시 Setting
'			00:지정가 03:시장가 05:조건부지정가 06:최유리지정가
'			07:최우선지정가 09:자사주 10:자사주스톡옵션 12:자사주신탁
'			61:장개시전시간외 81:시간외종가 91:시간외단일가
'        호가구분에따라 단가를 enable/disable
'***************************************************************************
Sub Set_comb_hogb()
SCREEN.IgnoreChange True
	ed_hogb.Data = c_hogb.Data
	r_hogb0.Checked = True

	If c_hogb.Data = "03" Or c_hogb.Data = "13" Or c_hogb.Data = "23" Then
		c_hogb.trgb = "94"
	Else
		c_hogb.trgb = "130"
	End If

	Select Case c_hogb.Data
		Case "00", "10", "20"			'보통/지정가(' ', IOC, FOK)
			ed_jprc.Enable = True
		Case "03", "13", "23"			'시장가(' ', IOC, FOK)
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
			r_hogb1.Checked = True
		Case "05"						'조건부
			ed_jprc.Enable = True
		Case "06", "16", "26", "07"		'최유리(' ', IOC, FOK), 최우선
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
		Case "61", "81"				'장전시간외(61), 장마감시간외(81)
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
	End Select
	c_pric.Enable = ed_jprc.Enable

	'-- 주문조건 (0:없음, 1:IOC, 2:FOK)
	Select Case Left(c_hogb.Data,1)
	Case "1", "2"
		ed_jmgb.Data = Left(c_hogb.Data,1)
	Case Else
		ed_jmgb.Data = "0"
	End Select
	ed_jqty.SetFocus
SCREEN.IgnoreChange False
End Sub

'***************************************************************************
' DESC: 호가조건 radio button Click 시 Setting
'***************************************************************************
Sub Set_radio_hogb()
SCREEN.IgnoreChange True
	If r_hogb0.Checked = True Then		'지정가
		c_hogb.trgb = "130"
		c_hogb.Data = "00"
		ed_jprc.Enable = True
		Call QueryHoga()
	ElseIf r_hogb1.Checked = True Then	'시장가
		c_hogb.trgb = "94"
		c_hogb.Data = "03"
		ed_jprc.Data = "0"
		ed_jprc.Enable = False
	End If
	c_pric.Enable = ed_jprc.Enable
	ed_hogb.Data = c_hogb.Data

	'-- 주문조건 (0:없음, 1:IOC, 2:FOK)
	Select Case Left(c_hogb.Data,1)
	Case "1", "2"
		ed_jmgb.Data = Left(c_hogb.Data,1)
	Case Else
		ed_jmgb.Data = "0"
	End Select

	ed_jqty.SetFocus
SCREEN.IgnoreChange False
End Sub

'***************************************************************************
' DESC: 정정/취소조건 Setting 1:일부 2:전부
'***************************************************************************
Sub Set_mdgb()
	If r_mdgb0.Checked = True Then
		ed_mdgb.Data = "2"						'전부
		ed_jqty.Data = "00000000"
