' "F_" 시작하는 push/pop 데이터는 다른맵에서 주는 데이터
Function l_Null_check(Data)
    l_Null_check = Data
    If Trim(data) = "" Then
        l_Null_check = "NO"
        Exit Function
    End If
End Function

Dim mmgb, yn
'***************************************************************************
' DESC: 주문환결설정 Setting
' input: "parent.clearpush + (_buy, _sell, _jj, _cancel)"
'***************************************************************************
Sub init_option(clearpush)
	OrdCfg.PushPrefix = CStr(SCREEN.Major)
	OrdCfg.OrderGB = mmgb-1
	OrdCfg.LoadInfo
	If SCREEN.Object(clearpush).data = "1" Then
		SCREEN.Object(clearpush).data = "0"
		'첫번째 화면실행시에는 메모리정보 Clear
		OrdCfg.ClearPush
	Else
		OrdCfg.Pop
	End If
	OrdCfg.ItemCd = ed_focod.Data
	OrdCfg.SetDoQty(True)
	Call QueryOption("common")
	If SCREEN.CreateObject("info") Then
		yn = l_Null_check(Trim(INFO.popdata(LOGIN.name, "userconf.ini", "S-ORD", "ORD_CONF")))
	End If

	If yn = "NO" Then
		chk_OrderConfirm.Checked = SCREEN.Object("parent.chk_OrderConfirm").Checked
	Else
		chk_OrderConfirm.Checked = False
	End If
	'chk_OrderConfirm.Checked = SCREEN.Object("parent.chk_OrderConfirm").Checked
End Sub

