_AW_ONDECLARE_AW_
Sub send_tr(acno, pwd, mmgb, cod2, pric, flag, zdate)
	SCREEN.ClearAll 0, 2
	ed_acno.Data = acno
	zPwd.Data = pwd
	zBnsTp.Data = mmgb
	zIsuNo.Data = cod2
	dOrdPrc.Data = pric
	l_avol.Data = flag
	LoanDt.Data = zdate

	Dim hogb

	hogb = Trim(SCREEN.Object("parent.shogb").Data)

	If hogb = "81" Or hogb = "82" Or hogb = "61" Then
		EDIT0.Data = "81"
	Else
		EDIT0.Data = hogb
	End If


	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
SCREEN.Proc "main.Set_guide", " "

If SCREEN.GetMapName(1) = "IB105000" Then
	SCREEN.Object("parent.parent.AN18").SetFocus
	ed_acno.Data = SCREEN.Object("parent.parent.AN18").data
Else
	SCREEN.Object("parent.parent.AN1A").SetFocus
	ed_acno.Data = SCREEN.Object("parent.parent.AN1A").data
End If

If Trim(ed_acno.Data) = "" Or Len(Trim(ed_acno.Data)) < 11 Then
	MsgBox "계좌번호를 확인하세요", ,"IBK투자증권"
	Exit Sub
End If

'직원일 경우
If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(zPwd.data)) < 4 Then
		MsgBox "비밀번호를 확인하세요", ,"IBK투자증권"
		SCREEN.Object("parent.parent.ed_pswd").SetFocus
 		Exit Sub
	End If

	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If Trim(zPwd.Data) <> "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		Else
			LEDGER.Hsiz = 44
			LEDGER.EPwd = Trim(SCREEN.Object("parent.parent.LEDGER").EPwd)
			zPwd.Data = "HEAD"
		End If

		If Trim(zPwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
				SCREEN.Object("parent.parent.ed_pswd").Data = ""
				SCREEN.Object("parent.parent.ed_pswd").SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
	End If
End If
'If Trim(zPwd.Data) = "" Then
'	MsgBox "비밀번호를 확인하세요", ,"IBK투자증권"
'	SCREEN.Object("parent.parent.ed_pswd").SetFocus
'	Exit Sub
'End If

If Len(Trim(zIsuNo.Data)) <> 6 Then
	MsgBox "종목코드를 확인하세요", ,"IBK투자증권"
	SCREEN.Object("parent.1301").SetFocus
	Exit Sub
End If
If zBnsTp.Data = "2" Then	'-- 매수일 때 단가입력
	If Trim(dOrdPrc.Data) = "" Or CLng(dOrdPrc.Data) = 0 Then
		If SCREEN.Object("parent.shogb").Data <> "03" Then '시장가아닐때
			SCREEN.Object("main.guide").Text = "주문단가를 확인하세요"
			SCREEN.Object("parent.ed_jprc").SetFocus
			Exit Sub
		End If
	End If
End If

If SCREEN.GetCodeType(zIsuNo.Data) = 9 Then		' ELW
	zIsuNo_A.Data = "J"
ElseIf SCREEN.GetCodeType(zIsuNo.Data) = 27 Then		' ETN
	zIsuNo_A.Data = "Q"
Else
	zIsuNo_A.Data = "A"
End If
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

 SCREEN.Proc "parent.set_avol", Trim(OrdAbleQty.Data)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


