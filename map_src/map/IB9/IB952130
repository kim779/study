_AW_ONDECLARE_AW_
Sub send_pop
	Dim dmsg, memo, title
	title = Replace (g_titl.data, "/", "／")
	memo = Replace (g_memo.data, vbCrLf, "｜")
	memo = Replace (memo, "/", "／")
	dmsg = "ckey" & vbTab & ckey.Data & vbLf &_
			"title1" & vbTab & title & vbLf &_
			"g_memo" & vbTab & memo & vbLf

	SCREEN.CreateWindow 2, "IB942111 /p5 /d", dmsg
End Sub

Sub send_obj2
	obj2.Send
End Sub

_AW_ONSEND_AW_
If SYSTEM.ConnectBy = 1 Then   '직원
	SCREEN.OnSend = False
	SCREEN.Proc "parent.setabnormal", ""
	Exit Sub
Else
	usid.Data = LOGIN.User
	LISTGRID.Clear
	stgb.Data = "T"
	g_titl.Clear
	SCREEN.OnSend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

If LISTGRID.Rows > 0 Then
	g_titl.data = Trim(LISTGRID.getgridcell (1, 3))
	ckey.data = LISTGRID.getgridcell (1, 13)
	obj.send
Else
	SCREEN.Proc "parent.setabnormal", ""
End If

