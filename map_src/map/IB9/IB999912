'***************************************************************************
' DESC: 주문환결설정 Setting
' input: "parent.clearpush + (_buy, _sell, _jj, _cancel)"
'***************************************************************************
Sub init_option(clearpush)
	Dim yn

SCREEN.IgnoreChange True
	S1301.Data = SCREEN.Object("main.1301").Data
	Call Set_mkgb(S1301.Data)
SCREEN.IgnoreChange False

	SCREEN.Object("OBJ_hnam").Send

	OrdCfg.PushPrefix = CStr(SCREEN.Major)
	OrdCfg.OrderGB = mmgb-1
	OrdCfg.LoadInfo
	If SCREEN.Object(clearpush).data = "1" Then
		SCREEN.Object(clearpush).data = "0"
		'첫번째 화면실행시에는 메모리정보 Clear
		OrdCfg.ClearPush
	Else
		OrdCfg.Pop
	End If

	OrdCfg.ItemCd = S1301.Data

	Call QueryOption("common")

	If SCREEN.CreateObject("info") Then
		yn = Null_check(Trim(INFO.popdata(LOGIN.name, "userconf.ini", "S-ORD", "ORD_CONF")))
	End If

	If yn = "NO" Then
		chk_OrderConfirm.Checked = SCREEN.Object("parent.chk_OrderConfirm").Checked
	Else
		chk_OrderConfirm.Checked = False
	End If

' 2022.10.27 시장경제 축소에 따른 당사 유동성자본확보를 위하여
	' Default 신용구분을 자기융자(index:0)에서 유통융자(index:1)로 세팅
	' 자기융자 => 유통융자 기본으로 변경
	' 임지훈
	If mmgb < "3" Then 	'-- ELW는 시장가 없음
		If UCase(TypeName( SCREEN.Object("L_SYGB") )) <> "NOTHING" Then
			c_sygb.Index = 1
		End If
	End If

	If SCREEN.GetMapName(1) = "IB105000" Then
		If mmgb < "3" Then 	'-- ELW는 시장가 없음
			c_hogb.Visible = False
		End If
	End If


	'====================================
	' 주문화면단 현재 선택 시장 문구 표기
	'====================================
	If UCase(TypeName( SCREEN.Object("Main.cxMarket"))) <> "NOTHING" Then
		Dim tmp_mkgb
		tmp_mkgb = SCREEN.Object("Main.cxMarket").sMarket
		Call Change_market_text(tmp_mkgb)
	End If

End Sub




