' 주문가능 버튼 Visible TRUE/FALSE
Sub SetGaBthVisible(val)
	If val = "0" Then
		BUTTON0.visible True
		BUTTON1.visible True
		BUTTON4.visible False
	Else
		BUTTON0.visible False
		BUTTON1.visible False
		BUTTON4.visible True
	End If
