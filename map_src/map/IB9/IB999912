		SCREEN.IgnoreChange False

SYSTEM.Trace "      [999912] Get_jmno EXIT"
		Exit Sub
	End If

	' 정정/취소 화면에 주문단가 세팅
	If SCREEN.Object("parent.tab_order").index = 3 Then
		If Trim(prc) <> "" Then
