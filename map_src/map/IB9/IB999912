' "자동" 버튼의 종속 시세 선택 콤보박스 Visible True/False
Sub Check_cboPrice()
	If UCase(TypeName( SCREEN.Object("shogb"))) <> "NOTHING" Then
		If UCase(TypeName( SCREEN.Object("cboPrice"))) <> "NOTHING" Then
			If UCase(TypeName( SCREEN.Object("CHK_auto"))) <> "NOTHING" Then

				flag = SYSTEM.Pop("auto_flag_s")

				Select Case shogb.Data
						Case "00", "01", "05", "10", "20"  '지정가, 스톱지정가, 지정가IOC, 지정가FOK
							cboPrice.Enable = True
							CHK_auto.Enable = True
							CHK_auto.Checked = (Mid(flag,mmgb,1) = "1")

						Case "03", "02", "06", "07", "13", "12", "16", "23", "22", "26", "81", "61"
							cboPrice.Enable = False
							CHK_auto.Enable = False

						Case Else
							cboPrice.Enable = True
							CHK_auto.Enable = True
				End Select
			End If
		End If
	End If
End Sub

