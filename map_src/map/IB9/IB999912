'--처리구분값 설정(현금/신용)
Sub Set_prgb()
	ed_prgb.Data = "X"			'처리구분
	ed_gmo.Data = ""			'처리구분값1
	ed_gmm.Data = ""			'처리구분값2

SYSTEM.Trace "      [999912] Set_prgb  mmgb = " & mmgb & "    map(0) = " & SCREEN.GetMapName(0)

	Select Case mmgb
	Case "3", "4"	' 정정/취소
		Exit Sub

	Case "1", "2"	' 매도/매수
		If Not R_cash.Checked Then			'--신용주문
			If Left(SCREEN.GetMapName(1),6) = "IB3030" Then		'--선물대용주문

				ed_prgb.data = "C"	' 선물대용주문

				' 선물대용 KRX/NXT 구분 01:KRX 04:NXT
				If UCase(TypeName( SCREEN.Object("cxMarket") )) <> "NOTHING" Then
					Select Case cxMarket.sMarket
					Case "KRX"	' KRX
						ed_gmo.data = "01"&AN20.data

					Case "NXT"	' NXT
						ed_gmo.data = "04"&AN20.data

					Case Else
						ed_gmo.data = "01"&AN20.data
					End Select

				Else	' Default : KRX 선물대용
					ed_gmo.data = "01"&AN20.data
				End If

			Else												'--신용주문
				ed_prgb.Data = "B"			'처리구분
				ed_gmo.Data = c_sygb.Data & ed_date.Data		'처리구분값1
			End If
		End If

	End Select
End Sub





'***************************************************************************
'현금/신용 설정
'***************************************************************************
Sub Set_CashCredit(xval)
	Dim flag_date
	If mmgb <> 1 And mmgb <> 2 Then Exit Sub	'--매수,매도화면에서만 설정
	Select Case Left(SCREEN.GetMapName(1),6)
	Case "IB1050"			'-- [ELW주문] 현금주문만 가능
		R_credit.Visible = False : R_cash.TRGB = 103
		lb_date.Visible = False
		ed_date.Visible = False
		c_sygb.Visible = False
		L_SYGB.Visible = False
		Exit Sub
	End Select

	Dim mapName
	mapName = SCREEN.GetMapName(1)

	R_credit.Visible = True
	flag_date = False

	ed_jqty.Clear
	ed_jqty.SetFocus


	If xval = 1 Then				'신용 : xval=1

		' 유통 융자로 인해 추가 2021.06.07
		' 기존 화면 영향도를 위해 L_SYGB 컴포넌트 존재여부 확인 후 Visible Setting
		If UCase(TypeName( SCREEN.Object("L_SYGB") )) <> "NOTHING" Then
			c_sygb.Visible = True
			L_SYGB.Visible = True
		End If

		If mmgb = 1 Then			' 신용매도
			flag_date = True
			JUMUN_B.Text = "신용매도(F3)"
			'If (Left(SCREEN.GetMapName(1),6)="IB3030") Then
			'	BUTTON0.Visible = False		'가능수량조회버튼
			'End If
		Else						' 신용매수
			JUMUN_B.Text = "신용매수(F2)"
		End If
		R_cash.TRGB = 69 : R_credit.TRGB = 103
		R_credit.Checked = True

		'정산금액 표시 2010.02.19
		If mapName <> "IB105000" And mapName <> "IB610100" And mapName <> "IB680100" Then
			OBJ_JUNGSAN.VIsible = False
		End If
	Else							'현금 : xval=0
		c_sygb.Visible = False			' 유통 융자로 인해 추가 2021.06.07
		If UCase(TypeName( SCREEN.Object("L_SYGB") )) <> "NOTHING" Then	' L_SYGB 컴포넌트 존재여부 확인 후 Visible Setting
			L_SYGB.Visible = False
		End If
		If mmgb = 1 Then
			JUMUN_B.Text = "매도(F3)"
			BUTTON0.Visible = True		'가능수량조회버튼
		Else
			JUMUN_B.Text = "매수(F2)"
		End If
		R_cash.TRGB = 103 : R_credit.TRGB = 69
		R_cash.Checked = True

		'정산금액 표시 2010.02.19
		If mapName <> "IB105000" And mapName <> "IB610100" And mapName <> "IB680100" Then
			OBJ_JUNGSAN.VIsible = True
		End If
	End If

	' 일자 입력 Field Visible
	Select Case Trim(mapName)
	Case "IB101900"	' 유통대주 :: 일자 표기가 통상 매매화면과 반대
		R_cash.Visible = False
		R_credit.Visible = False
		If mmgb = 1 Then
			JUMUN_B.Text = "대주매도(F3)"
			flag_date = False
		Else
			JUMUN_B.Text = "대주상환(F2)"
			flag_date = True
		End If

	Case "IB103200"	' [1032] 스마트창구(신용)
		' 스마트창구(신용)의 신용 구분자도 저장하지 않음

	Case "IB102100"	' [1021] 대출매도상환
		' 대출매도상환의 신용 구분자도 저장하지 않음

	Case Else : ' 일반 공통화면
		' DESC: 화면 재오픈시에도 현금/신용구분 유지
		' [1019] 유통대주는 무조건 신용주문이라 현금/신용 구분 저장하지 않음

		' 신용 구분자 저장
		push_sinyong(xval)
	End Select

	lb_date.Visible = flag_date
	ed_date.Visible = flag_date



	' 화면별 하단 계정계 화면 조회 연동
	Select Case Trim(mapName)
	Case	"IB100100", "IB200000", "IB2000XX", "IB2000YY", "IB300000", "IB800000", "IB000100", "IB103100" :
		If SCREEN.Object("main.tab_account").ID = "7" Then	' 주문가능
			SCREEN.Proc "main.OBJ_account.send_f", ""
		End If

	Case 	"IB100200" :
		If SCREEN.Object("main.TAB1").ID = "7" Then	' 주문가능
			SCREEN.Proc "main.OBJ_account.send_f", ""
		End If

	Case	"IB500000"
		If SCREEN.Object("main.tab_account").ID = "4" Then
			SCREEN.Proc "main.OBJ_account.send_f", ""
		End If
	End Select

End Sub





' DESC: 화면 재오픈시에도 현금/신용구분 유지
' 일반 공통화면은 저장하고, [1019] 유통대주 화면에서는 저장하지 않음
Sub push_sinyong(xval)
	If SCREEN.CreateObject("Info") Then
		Dim mapName
		mapName = SCREEN.GetMapName(1)

		If mapName <> "IB103100" And mapName <> "IB103200" Then
			INFO.PushData LOGIN.name, "userconf.ini", "STOCK", "sinyong", xval
		End If
	End If
End Sub





Function pop_sinyong()
	If SCREEN.CreateObject("Info") Then
		Dim mapName
		mapName = SCREEN.GetMapName(1)

		If mapName <> "IB103100" And mapName <> "IB103200" Then
			pop_sinyong = INFO.PopData(LOGIN.name, "userconf.ini", "STOCK", "sinyong")
		End If
	End If

	If 	pop_sinyong <> "1" Then
		pop_sinyong = "0"	'-- 현금
	End If
End Function





'***************************************************************************
' DESEC: 시장구분 Setting
'			1:거래소 2:코스닥 3:프리보드 4:장외
'***************************************************************************
Function Set_mkgb(code)
	Dim retn
	Set_mkgb = True
	ed_jprc.SetType 0

	If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
		edStopPrc.SetType 0
	End If

	retn = SCREEN.GetCodeType(code)
	Select Case retn
		Case 1, 31
			ed_mkgb.Data = "1"	'거래소
			ed_jprc.SetType 100
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.SetType 100
			End If
		Case 2
			ed_mkgb.Data = "2"	'코스닥
			ed_jprc.SetType 200
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.SetType 200
			End If
		Case 3
			ed_mkgb.Data = "3"	'프리보드
		Case 4, 5, 7
			ed_mkgb.Data = "4"	'장외
		Case 6, 27
			ed_mkgb.Data = "1"	'ETF
			ed_jprc.SetType 240
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.SetType 240
			End If
		Case 9
			ed_mkgb.Data = "1"	'ELW
			ed_jprc.SetType 250
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.SetType 250
			End If
		Case Else
			ed_mkgb.Data = "0"
			Set_mkgb = False
	End Select
End Function





'***************************************************************************
' DESC: 호가조건 ComboBox 전환시 Setting
'			00:지정가 03:시장가 05:조건부지정가 06:최유리지정가
'			07:최우선지정가 09:자사주 10:자사주스톡옵션 12:자사주신탁
'			61:장개시전시간외 81:시간외종가 91:시간외단일가
'        호가구분에따라 단가를 enable/disable
'***************************************************************************
Sub Set_comb_hogb()

SYSTEM.Trace "      [999912]Set_comb_hogb shogb = " & shogb.Data

	Dim sto
SCREEN.IgnoreChange True

	If mmgb < 3 Then	c_hogb.Checked = False

	If SCREEN.GetMapName(1) = "IB105000" Then
		Select Case Right(shogb.Data,1)
		Case 1,2,3,6,7 	'-- ELW는 시간외,중간가, 시장가,최유리,최우선 없음
			shogb.Data = "00"
			'MsgBox "ELW는 해당 구분으로 주문이 불가능합니다.", ,"IBK투자증권"
		End Select
	End If

	' 시장가 선택시 색상 붉은색으로 강조
	If shogb.Data = "03" Or shogb.Data = "13" Or shogb.Data = "23" Then
		shogb.trgb = "94"
	Else
		shogb.trgb = "130"
	End If

	' 스톱지정가 EditBox Disable (Default)
	If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
		edStopPrc.Visible = False
		'edStopPrc.Data = "0"

		If UCase(TypeName( SCREEN.Object("labelStop") )) <> "NOTHING" Then
			labelStop.Visible = False
		End If

		If UCase(TypeName( SCREEN.Object("btnStopQS") )) <> "NOTHING" Then
			btnStopQS.Visible = False
		End If
	End If


	' 호가유형 선택에 따른 가격창 Enable/Disable
	Select Case shogb.Data
		Case "01"	' 스톱지정가 2025.03.04
			ed_hogb.Data = "01"
			ed_jprc.Enable = True
			If IsStopOrderMap() = True Then
				If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
					edStopPrc.Visible = True
					edStopPrc.Enable = True
					If UCase(TypeName( SCREEN.Object("labelStop") )) <> "NOTHING" Then
						labelStop.Visible = True
					End If

					If UCase(TypeName( SCREEN.Object("btnStopQS") )) <> "NOTHING" Then
						btnStopQS.Visible = True
					End If

					Select Case mmgb
					Case 1, 2	' 매수/매도
						If SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Enable = True And SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Visible = True Then
							Dim mapid, symb
							mapid = SCREEN.Object("main.OBJ_sise").getobject()

							Select Case Left(SCREEN.GetMapName(1),6)
							Case "IB5000"
								symb = "14723"
							Case Else
								symb = "2023"
							End Select

							If CDbl(edStopPrc.Data) =< 0 Then
								edStopPrc.Data = SCREEN.Object("main.OBJ_sise."&symb).Data
							End If
						End If
					Case 3	 ' 정정/취소
						sto = SYSTEM.Pop ("S_stov")
						If UCase(TypeName( SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc"))) <> "NOTHING" Then
							Select Case Trim(sto)
								Case "효력즉시발생"	' 스톱지정가 호가
									SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Enable = False
								Case "효력발생"	' 스톱지정가 호가
									SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Enable = False
								Case "효력미발생","접수완료"	' 스톱지정가 호가
									SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Enable = True
								Case Else	' 그 외 호가
									SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Enable = False
							End Select
						End If
					End Select

				End If

			End If

		Case "02", "12", "22"		' 중간가(' ', IOC, FOK) 2025.03.04
			ed_hogb.Data = "02"
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
			If IsStopOrderMap() = True Then
				If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
					edStopPrc.Data = "0"
				End If

				If UCase(TypeName( SCREEN.Object("btnStopQS") )) <> "NOTHING" Then
						btnStopQS.Visible = True
					End If
			End If

		Case "65"	                ' 경매매
			ed_hogb.Data = "65"
'			ed_jprc.Data = "0"
			ed_jprc.Enable = True
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If

		Case "00", "10", "20"		' 보통/지정가(' ', IOC, FOK)/경매매
			ed_hogb.Data = "00"
'			ed_jprc.Data = "0"
			ed_jprc.Enable = True
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If

		Case "03", "13", "23"		' 시장가(' ', IOC, FOK)
			ed_hogb.Data = "03"
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
			If mmgb < 3 Then
				c_hogb.Checked = True

				Select Case shogb.Data
				Case "03"	' 시장가(FAS)
					c_hogb.Caption = "시장가"
				Case "13"	' 시장가(IOC)
					c_hogb.Caption = "시장가(IOC)"
				Case "23"	' 시장가(FOK)
					c_hogb.Caption = "시장가(FOK)"
				End Select
			End If
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If

		Case "05"					' 조건부
			ed_hogb.Data = shogb.Data
			ed_jprc.Enable = True
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If

		Case "06", "16", "26"		'최유리(' ', IOC, FOK)
			ed_hogb.Data = "06"
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If

		Case "08","18","28"
			ed_hogb.Data = "76"
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If

		Case "82"
			ed_hogb.Data = "82"
			ed_jprc.Enable = True
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If

		Case Else '"61", "81", "07"		'장전시간외(61), 장마감시간외(81), 최우선
			ed_hogb.Data = shogb.Data
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If
	End Select

	c_pric.Enable = ed_jprc.Enable

	'-- 주문조건 (0:없음, 1:IOC, 2:FOK)
	Select Case Left(shogb.Data,1)
	Case "1", "2"
		ed_jmgb.Data = Left(shogb.Data,1)

		'주문가능화면 호가유형코드 설정(신용시에만)
		If mmgb < 3 Then
			If R_credit.Checked = True Then
				Call SetJumunGanun(shogb.Data)
			End If
		End If
	Case Else
		ed_jmgb.Data = "0"
	End Select

	ed_jqty.SetFocus

	' "자동" 버튼의 종속 시세 선택 콤보박스 Visible True/False
	Check_cboPrice()
SCREEN.IgnoreChange False

End Sub






Sub SetJumunGanun(comboType)
	Dim mapName
	mapName = SCREEN.GetMapName(1)

	If UCase(TypeName( SCREEN.Object("OBJ_trust_avol.EDIT0") )) = "NOTHING" Then
		Exit Sub
	End If

	Select Case comboType
		Case "81","82","61"
			SCREEN.Object("OBJ_trust_avol.EDIT0").data = "81"
			Select Case mapName
			Case "IB100100", "IB200000", "IB2000XX", "IB2000YY", "IB300000", "IB800000", "IB000100", "IB103100"
				If SCREEN.Object("main.tab_account").ID = "7" Then
					SCREEN.Proc "main.OBJ_account.setRadio", "1"
				End If

			Case "IB100200"
				If SCREEN.Object("main.TAB1").ID = "7" Then
					SCREEN.Proc "main.OBJ_account.setRadio", "1"
				End If

			Case "IB500000"
				If SCREEN.Object("main.tab_account").ID = "4" Then
					SCREEN.Proc "main.OBJ_account.setRadio", "1"
				End If

			End Select

		Case Else

			SCREEN.Object("OBJ_trust_avol.EDIT0").data = comboType
			Select Case mapName
			Case "IB100100", "IB200000", "IB2000XX", "IB2000YY", "IB300000", "IB800000", "IB000100", "IB103100"
				If SCREEN.Object("main.tab_account").ID = "7" Then
					SCREEN.Proc "main.OBJ_account.setRadio", "2"
				End If

			Case "IB100200"
				If SCREEN.Object("main.TAB1").ID = "7" Then
					SCREEN.Proc "main.OBJ_account.setRadio", "2"
				End If

			Case "IB500000"
				If SCREEN.Object("main.tab_account").ID = "4" Then
					SCREEN.Proc "main.OBJ_account.setRadio", "2"
				End If
			End Select

	End Select
End Sub







'***************************************************************************
' DESC: 호가조건 radio button Click 시 Setting
'***************************************************************************
Sub Set_radio_hogb()
SCREEN.IgnoreChange True
	' 스톱지정가 EditBox Disable (Default)
	If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
		edStopPrc.Visible = False
		edStopPrc.Data = 0
		If UCase(TypeName( SCREEN.Object("labelStop") )) <> "NOTHING" Then
			labelStop.Visible = False
		End If

		If UCase(TypeName( SCREEN.Object("btnStopQS") )) <> "NOTHING" Then
			btnStopQS.Visible = False
		End If
	End If

	If c_hogb.Checked = True Then	'시장가
		shogb.trgb = "94"

		' 시장별 시장가 세팅
		' KRX : 03시장가
		' NXT : 13시장가(IOC)
		' SOR : 13시장가(IOC)
		If UCase(TypeName( SCREEN.Object("cxMarket"))) <> "NOTHING" Then
			Select Case Trim(cxMarket.sMarket)
			Case "KRX"	' KRX
				shogb.Data = "03"

			Case "NXT"	' NXT
				shogb.Data = "13"

			Case "통합"	' SOR
				shogb.Data = "13"
			End Select
		Else
			shogb.Data = "03"
		End If

		ed_jprc.Data = "0"
		ed_jprc.Enable = False
		If UCase(TypeName( SCREEN.Object("CHK_auto") )) <> "NOTHING" Then
			CHK_auto.Enable = False
		End If
		If UCase(TypeName( SCREEN.Object("cboPrice"))) <> "NOTHING" Then
			cboPrice.Enable = False
		End If
	Else	' 지정가
		shogb.trgb = "130"
		shogb.Data = "00"
		ed_jprc.Enable = True
		If UCase(TypeName( SCREEN.Object("CHK_auto") )) <> "NOTHING" Then
			CHK_auto.Enable = True
		End If
		If UCase(TypeName( SCREEN.Object("cboPrice"))) <> "NOTHING" Then
				cboPrice.Enable = True
			End If
		Call QueryHoga()
	End If

	' 현금 체크 시 금액버튼 활성화
	If UCase(TypeName( SCREEN.Object("R_cash"))) <> "NOTHING" Then
		If R_cash.Checked = True Then	' 현금 체크시
			If UCase(TypeName( SCREEN.Object("BUTTON5"))) <> "NOTHING" Then
	 			BUTTON5.Visible = True	' 금액 버튼 활성화
 			End If
		End If
	End If

	c_pric.Enable = ed_jprc.Enable
'	ed_hogb.Data = shogb.Data
'	ed_jmgb.Data = "0" 'IOC FOK RESET
	Set_comb_hogb()
	ed_jqty.SetFocus



SYSTEM.Trace "      [999912] Set_radio_hogb"
SCREEN.IgnoreChange False
End Sub




