			'MsgBox UCase(TypeName( SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc")))
			If UCase(TypeName( SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc"))) <> "NOTHING" Then
