		MsgBox mstr & "수량을 입력하십시오.", , "IBK투자증권"
		ed_jqty.SetFocus
		Exit Function
	End If

	'주문단가 check
'	If mstr <> "취소" Then
	If 	ed_mmgb.Data <> "4" Then
		If ed_jprc.Enable = True And Is_numeric(ed_jprc.Data) = False Then
			MsgBox mstr & "가격을 입력하십시오.", , "IBK투자증권"
			ed_jprc.SetFocus
			Exit Function
		End If
	End If

	If mstr = "정정" Or mstr = "취소" Then
		If Is_numeric(ed_ogno.Data) = False Then
			MsgBox "원주문번호를 확인하십시오.", , "IBK투자증권"
			ed_ogno.SetFocus
			Exit Function
		End If

		' NXT 시장은 스톱지정가에 대한 정정을 지원하지 않는다
'		If UCase(TypeName( SCREEN.Object("cxMarket") )) <> "NOTHING" Then
'			If cxMarket.sMarket = "NXT" Then
'				If shogb.Data = "01" And ed_mmgb.Data = "3" Then	' 스톱지정가
'					MsgBox "NXT 스톱지정가 정정주문은" & vbLf & "스톱가격을 정정할 수 없어요.", , "IBK투자증권"
'					shogb.SetFocus()
'					Exit Function
'				End If
'			End If
'		End If
	End If

	' 신주인수권 화면은 다음을 적용
	If SCREEN.GetMapName(1) = "IB680100" Or SCREEN.GetMapName(1) = "IB610100" Then
		Error_check = True
		Exit Function
	End If

	'주문착오방지를 위한 모범규준 check
	If chk_mistake_order(S1301.Data) = False Then
		Exit Function
	End If

