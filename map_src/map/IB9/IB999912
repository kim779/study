					SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Enable = False
					SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Data = 0
					SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Visible = True
					SCREEN.Object("main.OBJ_order.OBJ_odr.labelStop").Visible = True

				Case "효력발생"	' 스톱지정가 호가
					SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Enable = False
					SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Data = 0
					SCREEN.Object("main.OBJ_order.OBJ_odr.edStopPrc").Visible = True
