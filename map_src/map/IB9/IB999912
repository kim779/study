'****************************************************************************
' DESC: 주문옵션적용 when: common(주문전), after(주문후)
'****************************************************************************
Sub QueryOption(when)
	Dim qtyOpt

	If when = "after" Then
		If OrdCfg.KeepQty = False Then		'-- 수량유지안함
			ed_jqty.Data = "0"
		End If
		' 금감원 원칙으로 주문후 원주문번호 clear
		Select Case mmgb
		Case "3", "4"
			ed_ogno.Data = ""
		End Select

		If mmgb <> "4" And OrdCfg.KeepPrc = False Then		'-- 단가유지안함
			ed_jprc.Data = "0"
			If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
				edStopPrc.Data = "0"
			End If
		End If
		Exit Sub
	End If

	Select Case mmgb
		Case "3"
			If Mid(SCREEN.GetMapName(1),1,5)="IB101" Then
				If Trim(SCREEN.Object("main.ed_jprc").Data) <> "" Then
					Exit Sub
				End If
			End If

			Call QueryHoga()
			Exit Sub

		Case "4"
			Call QueryHoga()
			Exit Sub
	End Select

	'단가설정
	If Right(shogb.Data,1) = 3 Or Right(shogb.Data,1) = 2  Then	'시장가 (03, 13) 중간가(02)
		ed_jprc.Data = "0"
	Else
		If when = "common" Then	'주문전

'			Call QueryHoga()	'OrdCfg.QueryHoga			'기본단가설정 사용
		End If
	End If

	'수량설정
	If when = "common" Then		'주문전
		QueryOption_qty()
	End If

	SCREEN.Object("main.guide").Text = " "					'메세지
	SCREEN.Proc "OBJ_JUNGSAN.CalcJungsan", ""

End Sub








Sub QueryOption_qty()
	'	100616 잔고에서 클릭하였는지 여부 확인
	Dim tQty, tClick
	tQty = Trim(SYSTEM.Pop("J_qty"))
	tClick = Trim(SYSTEM.Pop("J_click"))

	If tClick <> "" And mmgb = "1" Then
		ed_jqty.Data = tQty
'		SYSTEM.Push "J_qty", ""
		Exit Sub
	End If

	' 신주인수권 관련 화면은 SKIP 처리
	If SCREEN.GetMapName(1) = "IB680100" Or SCREEN.GetMapName(1) = "IB610100" Then
		Exit Sub
	End If

	OrdCfg.Price = ed_jprc.data
	OrdCfg.Push
	Dim qtyOpt, cfgGB, strPop, strPop2
	Select Case mmgb
		Case "1" : cfgGB = "SellQtyGB"
		Case "2" : cfgGB = "BuyQtyGB"
		Case Else : Exit Sub
	End Select
	qtyOpt = OrdCfg.ReadCfg(cfgGB)							'수량설정 index

	Select Case qtyOpt
		Case "0"					'수량
			OrdCfg.SetDoQty(True)
			OrdCfg.QueryQty

			If SCREEN.GetMapName(1) = "IB101100" Then
				l_avol.Text = "4"		'가능수량을 최소가능수량으로 return함
			Else
				l_avol.Text = "1"
			End If
		Case "2"                    ' 금액매수 Set
			If SCREEN.GetMapName(0) <> "IB1021T2" Then
				l_avol.Text = "금액"
				SCREEN.SetTimer 3, False
			End If

		Case "1", "3"				'매도가능수량 Set
			strPop = SYSTEM.Pop("ROTATEVIEW")
			strPop2 = SYSTEM.Pop("ROTATEVIEW_C")

			If (strPop <> "1") And (strPop2 <> "1") Then
				l_avol.Text = qtyOpt
				If Trim(SCREEN.Object(an_symb).data) <> "" And _
					Trim(SCREEN.Object(pw_symb).Data) <> "" Then
					SCREEN.SetTimer 3, False
				End If
			Else
				l_avol.Text = "0"
			End If

		Case Else
			l_avol.Text = "0"
	End Select
End Sub







Sub QueryHoga()
	Dim siseObj, prcOpt, cfgGB, mapid, mainmap, sdata

	siseObj = "parent.parent.obj_sise."

SYSTEM.Trace "      [999912] ---------------------------------------------------------"
SYSTEM.Trace "      [999912] QueryHoga  1301 = " & S1301.data

	If IsStopOrderMap = True Then

		itype = SCREEN.GetName(199, S1301.Data,0)	' KONEX 종목 여부 판단 (28이면 KONEX)

		If IsNumeric(itype) = True Then
			If (itype <> 28) Then
				itype = SCREEN.GetCodeType(S1301.Data)	' KONEX 종목이 아닌 경우 정상적으로 GetCodeType
			End If
		Else
			SCREEN.GetCodeType(S1301.Data)	' KONEX 종목이 아닌 경우 정상적으로 GetCodeType
		End If

	Else
		If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
			edStopPrc.Visible = False
		End If

		If UCase(TypeName( SCREEN.Object("labelStop") )) <> "NOTHING" Then
			labelStop.Visible = False
		End If
	End If

	prcOpt = siseObj & "1377"		'주문수량단위

	If UCase(TypeName( SCREEN.Object(prcOpt) )) <> "NOTHING" Then
		If Is_numeric(SCREEN.Object(prcOpt).Data) Then
			ed_jqty.SetDelta SCREEN.Object(prcOpt).Data
		End If
	End If

	' 정정/취소 화면 진입 시, 자동으로 마지막 주문번호 세팅하는 최종 로직 1
	If IsQueryHoga.Data = "0" Then	'-- 주문가격 설정안함 (ex.잔고클릭시)
		Call Get_Jmno()
		IsQueryHoga.Data = " "
		SCREEN.Proc "OBJ_JUNGSAN.CalcJungsan", ""
		Exit Sub
	End If

	Select Case mmgb
		Case "1" : cfgGB = "SellPrcGB"
		Case "2" : cfgGB = "BuyPrcGB"
		Case "3"
			If Right(shogb.Data,1) = "3" Or  Right(shogb.Data,1) = "2" Then
				ed_jprc.Data = "0" 'SSLDQ380
			Else
'				OrdCfg.QueryHoga
			End If
			SCREEN.Proc "OBJ_JUNGSAN.CalcJungsan", ""

			' 정정/취소 화면 진입 시, 자동으로 마지막 주문번호 세팅하는 최종 로직 2
			Call Get_Jmno()
			Exit Sub

		Case Else
			SCREEN.Proc "OBJ_JUNGSAN.CalcJungsan", ""
			Exit Sub
	End Select

	'시장가 (03, 13) 혹은 중간가(02)거나 시세자동 단가세팅이 해제되어 있는 경우
	If Right(shogb.Data,1) = "3" Or Right(shogb.Data,1) = "2" Or chk_auto.Checked = False Then
		If Mid(SCREEN.GetMapName(1),1,5)="IB101" Then				'미니주문??
			If Trim(SCREEN.Object("main.ed_jprc").Data) <> "" Then
				Exit Sub
			End If
		End If

		'10/06/16 잔고에서 클릭했는지 확인
		Dim tQty, tPrc, tClick

		tClick = Trim(SYSTEM.Pop("J_click"))
		tQty = Trim(SYSTEM.Pop("J_qty"))
		tPrc = Trim(SYSTEM.Pop("J_jprc"))

		If tClick = "YES" And mmgb = "1" Then
			ed_jprc.Data = tPrc
'			SYSTEM.Push "J_jprc", ""
		Else
			'2011/03/08 각 주문종합화면에서 obj_sise에서 탭이동시
			'단가가 삭제되는 현상이 있어 주석처리. 단가삭제는 ChangeCode로 이동
			'6801, 6901의 경우 종목변경시 이전 현재가가 입력되는 현상이 있어 단가를 0으로 초기화

			If SCREEN.GetMapName(1) = "IB680100" Or SCREEN.GetMapName(1) = "IB690100" Then
				ed_jprc.Data = 0
			End If
		End If

		SCREEN.Proc "OBJ_JUNGSAN.CalcJungsan", ""
		Exit Sub
	End If

	prcOpt = OrdCfg.ReadCfg(cfgGB)

	If SCREEN.GetMapName(1) = "IB105000" And Left(prcOpt, 2) ="23" Then
		ed_jprc.Data = 0
		Exit Sub
	End If

	mapid = SCREEN.Object("main.obj_sise").getObject

	Select Case mapid
	Case "IB500040","IB882011" '시간외단일가
		If Right(prcOpt, 2) = "03" Then
			prcOpt = "14303"
		ElseIf Right(prcOpt, 2) = "02" Then
			prcOpt = "14920"
		Else
			prcOpt = "147" & Right(prcOpt, 2)
		End If
	Case Else
	End Select

	If mapid = "IB303021" Then
		prcOpt = "14723"
	ElseIf mapid = "IB303020" Then
		prcOpt = "2023"
	ElseIf SCREEN.GetMapName(1) = "IB101900" Then
		prcOpt = "2023"
	End If

	prcOpt = siseObj & prcOpt
	If Trim(shogb.data) = "05" Or Trim(Right(shogb.data,1)) = "0" Or Trim(shogb.data) = "82" Then
		If Right(Trim(prcOpt),4) <> "2303" Or mapid = "IB882010" Or mapid = "IB1032ZZ" Then
			If UCase(TypeName(SCREEN.Object(prcOpt))) <> "NOTHING" Then
		 		ed_jprc.Data = SCREEN.Object(prcOpt).Data
		 	End If
		Else
			ed_jprc.Data = SCREEN.Object("main.obj_obj_sise.2303").Data
		End If
	Else
		ed_jprc.Data = 0
		If UCase(TypeName( SCREEN.Object("edStopPrc") )) <> "NOTHING" Then
			edStopPrc.Data = 0
		End If
	End If

	SCREEN.Proc "OBJ_JUNGSAN.CalcJungsan", ""
End Sub






