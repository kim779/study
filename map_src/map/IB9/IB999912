	'			Case "시장가" :				SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "03"
	'			Case "조건부지정가" :		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "05"
	'			Case "최유리지정가" :		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "06"
	'			Case "최우선지정가" :		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "07"
