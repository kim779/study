		tmp_mkgb = SCREEN.Object("Main.cxMarket").sMarket
		Call Spread_mkgb(S1301.Data,tmp_mkgb)


		'====================================
		' 주문화면단 현재 선택 시장 문구 표기
		'====================================
		Call Change_market_text(tmp_mkgb)
	End If

	'=================================================
	' 주문옵션적용 when: common(주문전), after(주문후)
	'=================================================
	Call QueryOption("common")


	' 화면별 특성 적용2
	Select Case Trim(SCREEN.GetMapName(1))
	Case "IB680100"	' 신주인수권 관련 화면
