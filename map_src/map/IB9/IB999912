		MsgBox "비밀번호를 입력하십시오.", , "IBK투자증권"
		Exit Function
	End If

	Select Case mmgb
		Case "1" : mstr = "매도"
		Case "2" : mstr = "매수"
		Case "3" : mstr = "정정"
		Case "4" : mstr = "취소"
