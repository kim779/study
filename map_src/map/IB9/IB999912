			shogb.Refresh
SYSTEM.Trace "      [999912]ChangeCode -> Set_comb_hogb b4 : " & S1301.Data
			Call Set_comb_hogb()
SYSTEM.Trace "      [999912]ChangeCode -> Set_comb_hogb af : " & S1301.Data
		End If
	End If

SCREEN.IgnoreChange False


	'====================================
	' 종목에 따른 시장 구분자 보정
	'====================================
	If UCase(TypeName( SCREEN.Object("Main.cxMarket"))) <> "NOTHING" Then
