' Data NULL Check
Function Null_check(Data)
    Null_check = Data
    If Trim(data) = "" Then
        Null_check = "NO"
        Exit Function
    End If
End Function



'***************************************************************************
' DESC: 종목코드 변경시 Setting
'***************************************************************************
Sub ChangeCode()
SYSTEM.Trace "      [999912]ChangeCode Start : " & S1301.Data

	'=================
	' 화면별 특성 적용
	'=================
	Select Case Trim(SCREEN.GetMapName(1))
	Case "IB105000" : '-- ELW주문화면
		c_pric.visible False
		If Trim(S1301.data) = "" Then
SYSTEM.Trace "      [999912]ChangeCode EXIT 1"
	  		Exit Sub
	  	End If

		If SCREEN.GetCodeType(S1301.Data) <> 9 Then
			'MsgBox "ELW종목코드를 입력하십시오.", ,"IBK투자증권"
			SCREEN.Object("main.GUIDE").Text = "ELW종목코드를 입력하십시오."
