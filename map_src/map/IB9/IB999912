	'			Case "시장가(IOC)" : 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "13"
	'			Case "최유리지정가(IOC)" : 	SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "16"
	'			Case "지정가(FOK)" : 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "20"
	'			Case "시장가(FOK)" : 		SC REEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "23"
	'			Case "최유리지정가(FOK)" : 	SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "26"
	'			Case "경매매" : 			SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "65"
				Case "스톱지정가" : 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "01"
											Set_comb_hogb()
				Case "중간가"     : 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "02"
											Set_comb_hogb()
	'			Case "중간가(IOC)": 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "12"
	'			Case "중간가(FOK)": 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "22"
	'			Case "장후시간외" : 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "81"
	'			Case "장전시간외" : 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "61"
				Case "시간외단일가" : 		SCREEN.Object("main.OBJ_order.OBJ_odr.shogb").Data = "82"
