			End Select

			SCREEN.IgnoreChange False
		End If
	End If

	' 원주문 번호 세팅
	If Trim(num) <> "000000" And Trim(num) <> "" Then
		ed_ogno.data = num
	End If
SYSTEM.Trace "      [999912]ChangeCode End"
End Sub






