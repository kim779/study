'***************************************************************************
Sub change_option(gubn)
	OrdCfg.ItemCd = S1301.Data
	If (mmgb = "1" Or mmgb = "2") And gubn = "account" Then
		'단가설정
		If shogb.Data = "00" Or shogb.Data = "05" Then			'지정, 조건부지정
			If OrdCfg.KeepPrc = False Then						'주문전 or 주문수량유지안함
				OrdCfg.QueryHoga								'기본단가설정 사용
			End If
		Else
			ed_jprc.Data = ""
		End If
	Else
		Call QueryOption("common")
	End If
	Call Set_mkgb(S1301.Data)
End Sub









