_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"

Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		RADIO0.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO0"))="True")
		RADIO1.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO1"))="True")
		RADIO2.Checked = CBool(Trim(INFO.PopData(LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO2"))="True")
		If Not RADIO0.Checked And Not RADIO1.Checked And Not RADIO2.Checked Then
			RADIO0.Checked = True
		End If
	End If
End Sub

Sub SaveConfig()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO0", ""&RADIO0.Checked
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO1", ""&RADIO1.Checked
		INFO.PushData LOGIN.Name, myFILE, SCREEN.GetMapName(0), "RADIO2", ""&RADIO2.Checked
	End If
End Sub

Sub Navigate()
	If Trim(S1301.Data) <> "" Then
		If RADIO0.Checked Then
			BROWSER0.Navigate("http://board4.moneta.co.kr/cgi-bin/paxBulletin/bulList.cgi?code=" + Trim(S1301.Data) + "&boardid="  + Trim(S1301.Data) + "&frame=analysis")
		ElseIf RADIO1.Checked Then
			BROWSER0.Navigate("http://stock.naver.com/item/board.nhn?code=" + Trim(S1301.Data))
		ElseIf RADIO2.Checked Then
			BROWSER0.Navigate("http://dis4.x1.co.kr/bbs/real_stockMainList.do?boardId=" + Trim(S1301.Data))
		End If
	End If
End Sub

_AW_ONSTART_AW_
Call LoadConfig()
Call Navigate()

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
BROWSER0.Navigate("javascript:history.back();")

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
Call SaveConfig()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
