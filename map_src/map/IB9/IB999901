Sub Change_market_text(sMKGubn)
	Dim tMKGubn

	If UCase(TypeName( SCREEN.Object("pMarket"))) = "NOTHING" Then
		Exit Sub
	End If

	' 주문화면 내 시장 표기
	Select Case Trim(sMKGubn)
	Case "KRX"	' KRX
		tMKGubn = "KRX"

	Case "NXT"	' NXT
		tMKGubn = "NXT"

	Case "통합"	' SOR
		If cxMarket.IsNXTAble(S1301.Data) = 1 Then	' NXT ABLE
			tMKGubn = "SOR"
		Else
			tMKGubn = "KRX"
		End If

	Case Else
		tMKGubn = "KRX"
	End Select

	' 화면 노출 시장문구 변경
	pMarket.Text = Trim(tMKGubn)

	' 시장별 주문 호가 접수 유형 세팅
	Call Set_shogb()

	' 시장식별자에 현재 종목의 NXT 주문 가능 여부를 알려줌
	cxMarket.MNum = SCREEN.GetMapName(1)
End Sub






