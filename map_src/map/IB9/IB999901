'=============================================================================
' 미체결내역 클릭 시, 종목에 따른 NXT 지원 여부에 따라 Main 시장을 변경하거나
' 현재 선택한 시장과 Main의 시장이 다른경우 선택한 시장을 전파
' ------------------------------ 주의 ----------------------------
' 현재 함수 수정 시, IB999901과 IB999913 공통 동시에 수정이 필요함
' ----------------------------------------------------------------
'=============================================================================
Sub Spread_mkgb(codx, mkgb)
	Dim sMKGubn, tMKGubn, t_mkgb, iret

	'==============================================
	' 현재 입력받은 시장구분자
	'==============================================
	' 미체결에서 호출 시 : 1   2   S
	' 일반화면   호출 시 : KRX NXT 통합 (cxMarket)
	'==============================================
	Select Case mkgb
	Case "KRX"
		t_mkgb = "1"
	Case "NXT"
		t_mkgb = "2"
	Case "통합"
		t_mkgb = "S"
	Case "SOR"
		t_mkgb = "S"
	Case Else
		t_mkgb = mkgb
	End Select



	If UCase(TypeName( SCREEN.Object("Main.cxMarket") ) ) <> "NOTHING" Then

		SCREEN.IgnoreChange True

		'===============================
		' Main의 직전 시장정보 임시 저장
		'===============================
		tMKGubn = SCREEN.Object("Main.cxMarket").sMarket

		'=========================
		' 현재 입력받은 시장구분자
		'=========================
		Select Case Trim(t_mkgb)
		Case "1"	' KRX
			sMKGubn = "KRX"

		Case "2"	' NXT
			sMKGubn = "NXT"

		Case "S"	' SOR
			sMKGubn = "통합"

		Case Else
			sMKGubn = "KRX"
		End Select

SYSTEM.Trace "      [999901]Spread_mkgb() B4 : " & SCREEN.Object("Main.cxMarket").sMarket
		'============================================
		' 현재 종목에 맞는 Main 시장 변경 (차후 원복)
		'============================================
		If Trim(codx) <> "" Then
			SCREEN.Object("Main.cxMarket").sCode = codx
		End If



		'==================================
		' 화면 권한에 따른 "통합" 처리 분기
		'==================================
		iret = SCREEN.Object("Main.cxMarket").GetMapPermission(SCREEN.GetMapName(1))	' 대표화면번호로 화면 권한 획득
SYSTEM.Trace "      [999901]Spread_mkgb() AF : " & SCREEN.Object("Main.cxMarket").sMarket & vbTab & iret

		Select Case iret
		Case 1	' KRX
			sMKGubn = "KRX"	' KRX 강제 변환
			tMKGubn = "통합"

		Case 2	' NXT
			sMKGubn = "NXT"	' NXT 강제 변환
			tMKGubn = "통합"

		Case 3	' KRX|NXT (SOR 미지원)
			'=================================================
			' NXT 불가종목인데 시장선택이 NXT로 되어 있을 경우
			' 시장구분을 통합으로 변경
			'=================================================
			If SCREEN.Object("Main.cxMarket").IsNXTAble(S1301.Data) <> 1 Then	' NXT 불가종목
				If sMKGubn = "NXT" Then
					sMKGubn = "KRX"
					tMKGubn = "통합"
				End If
			End If

			' KRX|NXT 화면에서는 통합이 노출되면 안된다
			' 화면 권한이 SOR 미지원 화면인경우, SOR인 경우에 직전 시장구분자 유지
			If sMKGubn = "통합" Then
				sMKGubn = tMKGubn	' 직전 시장을 유지
				tMKGubn = "통합"
			End If

			' 그래도 통합이 남아 있으면 강제로 KRX로 변경
			If sMKGubn = "통합" Then
				sMKGubn = "KRX"
				tMKGubn = "통합"
			End If


		Case 7	' KRX|NXT|SOR
			'=================================================
			' NXT 불가종목인데 시장선택이 NXT로 되어 있을 경우
			' 시장구분을 통합으로 변경
			' 아직 Main의 1301이 변경되지 않은 시점이라 codx 사용
			'=================================================
			If Trim(codx) <> "" And SCREEN.Object("Main.cxMarket").IsNXTAble(codx) <> 1 Then	' NXT 불가종목
				If sMKGubn = "NXT" Then
					sMKGubn = "통합"
					tMKGubn = "KRX"
				End If
			End If
		End Select



		'====================================
		' 현재 클릭한 화면에 변경 시장 선적용
		'====================================
		If UCase(TypeName( SCREEN.Object("cxMarket") ) ) <> "NOTHING" Then
			cxMarket.MNum = SCREEN.GetMapName(1)
			cxMarket.sCode = SCREEN.Object("Main.cxMarket").sCode
			'cxMarket.sMarket = sMKGubn
		End If

		'================================
		' 현재 선택된(보정된) 시장 전파
		'================================
		SCREEN.Object("Main.cxMarket").sMarket = tMKGubn	' Main 화면 시장 원복
SYSTEM.Trace "      [999901]Spread_mkgb() FINAL : " & SCREEN.Object("Main.cxMarket").sMarket & vbTab & sMKGubn
		SCREEN.Proc "Main.Change_MKGubn_Main_Limited", sMKGubn

'		' 시장별 주문 호가 접수 유형 세팅
		If UCase(TypeName( SCREEN.Object("shogb") ) ) <> "NOTHING" Then
			Call Set_shogb()
		End If

		SCREEN.IgnoreChange False
	End If
End Sub

