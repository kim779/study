Function GetMkCode(scode)
	GetMkCode = scode

	If UCase(TypeName( SCREEN.Object("1777") )) <> "NOTHING" Then
	'화면내부에 거래소 선택컨트롤 시장변경
		If SCREEN.Object("1777").Data = "2" Then
			GetMkCode = "N." & scode
		ElseIf SCREEN.Object("1777").Data = "3" Then
			GetMkCode = "M." & scode
		End If
	End If

	If UCase(TypeName( SCREEN.Object("main.cxMarket") )) <> "NOTHING" Then
	'화면내부에 거래소 선택컨트롤 시장변경
		If SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
			GetMkCode = "N." & scode
		ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
			GetMkCode = "M." & scode
		End If
	End If

End Function





