RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim today
today = LOGIN.Day0

Sub qry_list()
	QryGubn.Data = "Q"
	SCREEN.Send 0
End Sub


Sub change_tab(id)
	UTAB0.ID = id
	Select Case id
		Case 1 :
			PANEL2.Visible = True
			PANEL5.visible = False
			BTN_DEL.Visible = False
			BTN_DEL.Enable = False
			QryGubn.Data = "I"
			sdate.Data = ""
			zIsuNo.Data = ""
			jgga.Data = ""
			jusik_nm.Data =""
			seq.Data = ""
			sdate.Data = today
		Case 2 :
			If QryGubn.Data = "I" Then
				sdate.Data = ""
				zIsuNo.Data = ""
				jgga.Data = ""
				jusik_nm.Data =""
				sdate.Data = today
				seq.Data = ""
			End If

			QryGubn.Data = "U"
			PANEL2.Visible = False
			PANEL5.visible = True
			BTN_DEL.Visible = True
			BTN_DEL.Enable = True
	End Select


End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
QryGubn.Data = "Q"
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'If LEDGER.Ecod = "3669" Then
'
'If QryGubn.Data <> "Q" Then
'	Call qry_list()
'End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call qry_list
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UTAB0)
_AW_ONCLICK_AW_
Call change_tab(UTAB0.ID)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim code
If GRID0.HitPos = 3 Then
	seq.Data = Trim(GRID0.GetGridCell(GRID0.Row, 1))
	sdate.Data = Trim(GRID0.GetGridCell(GRID0.Row, 2))
	zIsuNo.Data = Trim(GRID0.GetGridCell(GRID0.Row, 3))
	jgga.Data = Trim(GRID0.GetGridCell(GRID0.Row, 5))
	jusik_nm.Data = SCREEN.GetName(100, zIsuNo.data, 0)
	Call change_tab("2")
ElseIf GRID0.HitPos = 1 Or GRID0.HitPos = 2 Then
	QryGubn.Data = "Q"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_DEL)
_AW_ONCLICK_AW_
QryGubn.Data = "D"
If Len(Trim(seq.Data)) = 0 Then
	Dim msgx
 	msgx = "삭제할 종목을 선택하세요."
 	MsgBox msgx, , "IBK투자증권"
Else
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_SAVE)
_AW_ONCLICK_AW_
Dim flg

If QryGubn.Data = "Q" Then
	QryGubn.Data = "I"
End If


flg = "Y"

If Trim(sdate.data) = "" Or Len(Trim(sdate.data)) <> 8 Then
		Call alert_msg("SMS발송일을 확인하십시오.")
		flg = "N"
ElseIf Trim(zIsuNo.data) = ""  Then
		Call alert_msg("종목을 확인하십시오.")
		flg = "N"
ElseIf Trim(jgga.data) = "" Or Len(Trim(jgga.data)) < 0 Then
		Call alert_msg("발송전일종가를 확인하십시오.")
		flg = "N"
End If

If flg = "Y" Then
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zIsuNo)
_AW_ONCHANGE_AW_
jusik_nm.Data = SCREEN.GetName(100, zIsuNo.data, 0)
SYSTEM.SetHistory "zIsuNo", zIsuNo.Data
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 Then
	jusik_nm.Data = SCREEN.GetName(100, zIsuNo.data, 0)
	SYSTEM.SetHistory "zIsuNo", zIsuNo.Data
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(sym_jusik)
_AW_ONCLICK_AW_
 Dim retn
retn = SCREEN.GetCode(100, "zIsuNo", "jusik_nm",0)
If retn <> True Then
       Exit Sub
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



