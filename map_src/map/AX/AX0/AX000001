GLOBAL DIVISION
{

MAPNAME(AX000001)
MAPSIZE(90, 226)
VERSION(000)
MAPKIND(NORMAL)
MAPGROUP(1)
MAPDESC("인증비밀번호확인창")
MAPPUBLIC(";")
FONT("굴림", 9, NORMAL)
TITLE("AXIS ADMIN")
TOPATH(AXIS)
METHOD(MENU)
TRXCODE("axisadm")
MAPTYPE(FIXED)
HEADER(NOP)
}



FORM DIVISION
{

PANEL  mesg(2, 57, 225, 84)  TP_SUNKEN      COLOR(208, 232)  CUR(0)    AL_CENTER    ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
PANEL  PANEL1(2, 17, 88, 44)  '비밀번호'  TP_SUNKEN      COLOR(208, 232)  CUR(0)    AL_CENTER    ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
EDIT  pass(90, 17, 171, 44)  LEN(8)  IO_ALPHA|EDIT_INPUT|FA_PASSWD|FA_WRAP|FA_UPPER    COLOR(28, 232)  CUR(0)  TP_SUNKEN          TABORDER(1)  IOORDER(1)  ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
BUTTON  BUTTON0(175, 18, 221, 45)  '확인'  TP_PUSH      AL_CENTER    COLOR(15, 232)  CUR(0)      TABORDER(2)  ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
}



RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub check_pass()
	If (pass.data = "AXISPASS") Then
		SYSTEM.Push "AXISPASS", "YES"
		SCREEN.CloseWindow
		Exit Sub
	End If
	pass.Data = ""
	pass.SetFocus ()
	mesg.Text = "비밀번호가 틀렸습니다."
End Sub

_AW_ONSTART_AW_
SYSTEM.Push "AXISPASS", "NO"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(pass)
_AW_ONCHANGE_AW_
check_pass()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
check_pass()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



