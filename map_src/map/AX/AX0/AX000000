	Exit Sub
End If
SVNO.Push("SVNO")
Select Case WHAT.Text
Case "1"	'000 & Server Number
	If SVNO.Data = "999" Then
		MsgBox "대상서버번호를 선택하세요", 0, "확인"
		Exit Sub
	End If
	If SVNO.Data = "000" Then
         SCREEN.Object("OBJ01.SVNO").data = SVNO.Data
		OBJ01.Send
