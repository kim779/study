GLOBAL DIVISION
{

MAPNAME(AM000000)
MAPSIZE(87, 148)
VERSION(001)
MAPKIND(NORMAL)
MAPGROUP(1)
MAPDESC("Admin")
MAPPUBLIC(";")
FONT("굴림", 9, NORMAL)
OPTIONS(CR2TAB|INTER)
TITLE("MAC Admin")
TOPATH(AXIS)
METHOD(MENU)
MAPTYPE(FIXED)
HEADER(NOP)
}



FORM DIVISION
{

PANEL  PANEL0(-6, -5, 373, 128)  LINECOLOR(67)      COLOR(66, 67)  CUR(0)    AL_CENTER    ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
BUTTON  btn2(75, 9, 143, 29)  'WGLB'  TP_PUSH|IMAGETEXT|AL_CENTER        FOCUS  COLOR(240, 69)  CUR(0)    "5BTN.BMP"    TABORDER(3)  ENABLE  &
  VISIBLE  IMAGETEXT  HINTTYPE(IH_NONE)
BUTTON  btn3(4, 38, 144, 58)  '휴장일등록'  TP_PUSH|IMAGETEXT|AL_CENTER        FOCUS  COLOR(240, 209)  CUR(0)    "11BTN.BMP"    TABORDER(4)  ENABLE  &
  VISIBLE  IMAGETEXT  HINTTYPE(IH_NONE)
BUTTON  btn1(4, 9, 72, 29)  'AXIS'  TP_PUSH|IMAGETEXT|AL_CENTER        FOCUS  COLOR(240, 69)  CUR(0)    "5BTN.BMP"    TABORDER(2)  ENABLE  &
  VISIBLE  IMAGETEXT  HINTTYPE(IH_NONE)
LABEL  LABEL12(5, 65, 68, 80)  '관리자 인증'  AL_CENTER  CUR(0)      COLOR(66, 69)  ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
EDIT  pswd(75, 62, 143, 82)  LEN(8)  IO_ALPHA|EDIT_INPUT|FA_PASSWD    COLOR(192, 69)  CUR(0)  TP_SUNKEN          TABORDER(1)  IOORDER(1)  ENABLE  &
  VISIBLE  HINTTYPE(IH_NONE)
}



RESOURCE DIVISION
{


_AW_ONSTART_AW_
btn1.Enable = False
btn2.Enable = False
btn3.Enable = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(btn2)
_AW_ONCLICK_AW_
	SCREEN.CreateWindow 1, "AM010000  /t /S /p?", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn3)
_AW_ONCLICK_AW_
	SCREEN.CreateWindow 1, "AM001500  /t /S /p?", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn1)
_AW_ONCLICK_AW_
	SCREEN.CreateWindow 1, "AX000000  /t /S /p?", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(pswd)
_AW_ONKEYCHANGE_AW_
If Trim(pswd.Data) = "관리자" Then
	btn1.Enable = True
	btn2.Enable = True
	btn3.Enable = True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



