RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	GRID.Clear
	zNotiCnt.Clear
	GRID.SetDataPosition(0)
	LEDGER.Fkey = "C"
	LEDGER.Rcnt = "0010"

	zIn.data = "00001"
	zElecfnUserId.data = LOGIN.User

	SCREEN.Send 0
End Sub

Sub send_c()
	GRID.SetDataPosition(2)
	LEDGER.Fkey = "7"

	SCREEN.Send 0
End Sub

Sub send_OK()
	LEDGER.Fkey = "5"
	LEDGER.Rcnt = "0010"

	zIn.data = "00001"
	zElecfnUserId.data = LOGIN.User

	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim s_data

GUIDE.data = LEDGER.Emsg

If LEDGER.Next = "Y" Then
	Call send_c()
Else
'	SYSTEM.Trace "Receive[" & g_OK & "]"

	If Trim(data.data) = "1" Then
'		SYSTEM.Trace "parent.ReceiveOK[" & Trim(GRID.GetGridCell(1,1)) & "]"
		SCREEN.Proc "parent.ReceiveOK", ""
	End If
End If

For ii = 1 To GRID.Rows
	If Trim(GRID.GetGridCell(ii, 5)) <> "" Then
		s_data = GRID.GetGridCell(ii, 5)			'DATA
		s_data = Replace(s_data, "\n\r", " ")
		GRID.SetGridCell ii, 5, s_data
	End If
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID)
_AW_ONCLICK_AW_
Dim oldText
zNotiCnt.Text = ""

If GRID.HitPos <> 3 Then
	Exit Sub
End If

oldText = GRID.GetGridCell(GRID.Row, 5)

'zNotiCnt.Text = Replace(oldText, "\n\r", vbCrLf)
oldText = Replace(oldText, vbCrLf, vbCrLf & vbCrLf)
oldText = Replace(oldText, "※", vbCrLf & vbCrLf & "※")
zNotiCnt.Text = Replace(oldText, "□", vbCrLf & vbCrLf & "□")
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call send_OK()
OBJECT0.Send
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


