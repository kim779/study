RESOURCE DIVISION
{


_AW_ONSTART_AW_
Dim W,H,LH,linkN,TotalH

Dim nomoreType

If SCREEN.CreateObject("Info") Then
 	W = Trim(INFO.PopData("", "noticeconf.ini", "B2", "WIDTH"))
 	H = Trim(INFO.PopData("", "noticeconf.ini", "B2", "HEIGHT"))
 	LH = Trim(INFO.PopData("", "noticeconf.ini", "B2", "LINKHEIGHT"))

	linkN = Trim(INFO.PopData("", "noticeconf.ini", "B2", "linkN"))

	If linkN = 1 Then
		TotalH = CInt(H) + CInt(LH)

		SCREEN.SetSize W-1,TotalH + 25
	Else
		TotalH = H

 		SCREEN.SetSize W-1,TotalH + 25
 	End If

 	nomoreType = INFO.PopData("", "noticeconf.ini", "B2", "READTYPE")

 	If nomoreType = "0" Then
 		nomore.Text = "일주일간 보지않음"
 	Else
 		nomore.Text = "더 이상 보지않음"
 	End If

 	link = Trim(INFO.PopData("", "noticeconf.ini", "B2", "url"))

 	If Trim(link) = "" Then
 		btnLink.Visible = False
 	End If
End If

imgPanel.Left = 0
imgPanel.Top = 0
imgPanel.Right = W
imgPanel.Bottom = H

If linkN = 1 Then
	imgBottom.SetRect 0,H,W,TotalH

	btnLink.Visible = False
End If

PANEL1.SetRect 0,TotalH,W,TotalH + 25

'btnLink.Top = TotalH + 3
'btnLink.Left = W - 35 - 6 - 60
'btnLink.Bottom = TotalH + 23
'btnLink.Right = btnLink.Left + 60
btnLink.SetRect W - 35 - 6 - 60,TotalH + 3,W - 35 - 6,TotalH + 23

'btnClose.Top = TotalH + 3
'btnClose.Left = W - 35 - 3
'btnClose.Bottom = TotalH + 23
'btnClose.Right = btnClose.Left + 35
btnClose.SetRect W-35-3,TotalH + 3,W-3,TotalH + 23

'nomore.Top = CInt(TotalH) + 3
'nomore.Left = 10
'nomore.Right = nomore.Left + 120
'nomore.Bottom = CInt(TotalH) + 23
nomore.SetRect 10,TotalH + 3,130,TotalH + 23

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(imgPanel)
_AW_ONCLICK_AW_
If SCREEN.CreateObject("Info") Then
 	Dim link

 	link = Trim(INFO.PopData("", "noticeconf.ini", "B2", "url"))

	If Trim(link) <> "" Then
		If InStr(link,"HTS:") > 0 Then
			link = Mid(link,5,8)
			SCREEN.CreateWindow 1, link & " /t/d/p5/S", ""
		Else
	 		SYSTEM.Navigate link & vbTab & "1000" & vbTab & "800"
	 	End If
 	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(nomore)
_AW_ONCLICK_AW_
Dim nomoreType

If SCREEN.CreateObject("Info") Then
 	Dim dtYesterday : dtYesterday = DateAdd( "d", 6, Date() )
	Dim sYYYYMMDD
	sYYYYMMDD =   Right( "0" & Year( dtYesterday ), 4 ) _
	& Right( "0" & Month( dtYesterday ), 2 ) _
	& Right( "0" & Day(   dtYesterday ), 2 )

 	INFO.PushData "", "NOTICECOOKIE.ini", "B2", "NOMORE", nomore.Checked

 	nomoreType = INFO.PopData("", "noticeconf.ini", "B2", "READTYPE")

 	If nomoreType = "0" And nomore.Checked = True Then
 		INFO.PushData "", "NOTICECOOKIE.INI", "B2", "TO",sYYYYMMDD
 	End If
End If

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btnClose)
_AW_ONCLICK_AW_
