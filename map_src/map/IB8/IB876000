RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	gubn.Data = "Q"
	sdis.Data = "875100"
	GRID0.Clear
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If gubn.Data = "I" Then
	If Len(Trim(seqn.Data)) = 0 Then
		GUIDE.Text = "순서는 0보다 커야 합니다."
		SCREEN.OnSend False
		Exit Sub
	End If
	If CLng(seqn.Data) <= 0 Then
		GUIDE.Text = "순서는 0보다 커야 합니다."
		SCREEN.OnSend False
		Exit Sub
	End If
End If

GUIDE.Text = ""

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
GUIDE.Text = Trim(o_msg.Data)
If reqyn.Data = "Y" Then
	OBJECT0.Proc "send_f", ""
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cdtp)
_AW_ONCHANGE_AW_
Select Case cdtp.Data
	Case 0		'국내주식
		jscod.Visible = True
		hscod.Visible = False
	Case 1		'국내지수
		jscod.Visible = False
		hscod.Visible = True
End Select
jscod.Data = ""
hscod.Data = ""
hnam.Data = ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(new_btn)
_AW_ONCLICK_AW_
gubn.Data = "I"
sdis.Data = "875100"
If cdtp.Data = "0" Then
	code.Data = jscod.Data
Else
	code.Data = hscod.Data
End If
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON7)
_AW_ONCLICK_AW_
Dim kind, iupgb, retn
If cdtp.Data = "0" Then
	kind = 100
	target = "jscod"
ElseIf cdtp.Data = "1" Then
	kind = 104
	target = "hscod"
End If

retn = SCREEN.GetCode(kind, target, "hnam", 99 )
If retn <> True Then
       Exit Sub
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(hscod)
_AW_ONCHANGE_AW_
Dim kind, iupgb, retn
If cdtp.Data = "0" Then
	kind = 100
	target = "jscod"
ElseIf cdtp.Data = "1" Then
	kind = 104
	target = "hscod"
Else
	kind = 117
	target = "hscod"
End If
hnam.Data = Trim(SCREEN.GetName(kind, hscod.Data, 0))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(jscod)
_AW_ONCHANGE_AW_
If jscod.Data = "000000" Or Trim(jscod.Data) = "" Then
	jscod.Clear
	jscod.SetFocus
	Exit Sub
End If
hnam.Data = Trim(SCREEN.GetName(100, jscod.Data, 0))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



