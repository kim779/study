RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sendCnt
sendCnt = 0

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
zOtpVrfVal.SetFocus
gubndata.Data = "8102"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

If Trim(lOnesfCnfTrxSeqno.Data) = "" Then
	If Trim(responseMsg.Text) <> "" Then
		Call alert_msg(Trim(responseMsg.Text))
	End If

	Exit Sub
End If

If Trim(zOtpVrfVal.Data) = "" Then
	alert_msg("OTP생성번호를 확인하여 주십시오.")
	zOtpVrfVal.SetFocus
	Exit Sub
Else
	If IsNumeric(zOtpVrfVal.Data) = False Then
		alert_msg("OTP생성번호를 확인하여 주십시오.")
		zOtpVrfVal.SetFocus
		Exit Sub
	End If
End If

sendCnt = sendCnt + 1

If sendCnt > 1 Then
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod),1) = "0" Then
	If Trim(zErrMsgCode.Data) = "0000" Then
		zOtpVrfVal.Clear
		SCREEN.ClearAll 0, 2
		SCREEN.SetTimer 4, False
	Else
		sendCnt = 0

		Dim msg
		msg = Trim(zErrMsgCnts.Data)

		If Trim(zErrMsgCnts.Data) <> "" Then
			If Trim(zErrMsgCode.Data) = "3517" Then
				msg = msg & vbLf & vbLf & "재시도 가능횟수는 "& Trim(lRetryAbleCnt.Data) & "회 남았습니다."
			End If

			alert_msg(msg)
		End If
		SCREEN.Proc "obj_gen.send_f", ""
	End If
Else
	SCREEN.Object("main.GUIDE").TRgb = 94
	Call guide_msg(msg)
	sendCnt = 0
	SCREEN.Proc "obj_gen.send_f", ""
	alert_msg(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
sendCnt = 0

zOtpVrfVal.Clear
SCREEN.ClearAll 0, 2
SCREEN.Proc "parent.obj_snd.send_o", ""

SCREEN.Object("parent.obj_showCerti").Visible = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(lRetryAbleCnt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zOtpVrfVal)
_AW_ONKEYCHANGE_AW_
'== 보안카드번호 입력 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Len(Trim(zOtpVrfVal.Data)) <> 0 Then
		Call send_f()
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
zOtpVrfVal.Clear
SCREEN.Object("parent.obj_showCerti").Visible = False
SCREEN.Object("parent.sendBtn").SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCode)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zErrMsgCnts)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 2, "IB810190 /t /s /p5 /d", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(opindata)
_AW_ONKEYCHANGE_AW_
'== 보안카드번호 입력 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	SCREEN.Proc "parent.Confirm_Send", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
If Trim(zMdaSeqno.data) = "" Then
	MsgBox "매체일련번호를 입력하세요",0,"IBK투자증권"
Else
	If SCREEN.Object("obj_gen.zOnesfCnfPtnTp").data = "S" Then
		If CHECK0.Checked = False Then
			SCREEN.Object("obj_gen.obj_ox").send
		Else
			SCREEN.Object("obj_gen.obj_op").send
		End If
	Else
		Call send_f()
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
If SCREEN.Object("obj_gen.zOnesfCnfPtnTp").data = "S" And CHECK0.Checked = False Then
	obj_oz.send
Else
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHECK0)
_AW_ONCLICK_AW_
If CHECK0.Checked = True Then
	LABEL7.Visible = True
	opindata.Visible = True
Else
	LABEL7.Visible = False
	opindata.Visible = False
End If

SCREEN.Proc "obj_gen.send_f", ""
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
If CHECK0.Checked = True Then
	LABEL7.Visible = True
	opindata.Visible = True
Else
	LABEL7.Visible = False
	opindata.Visible = False
End If

SCREEN.Proc "obj_gen.send_f", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



