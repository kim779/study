	SYSTEM.Push "recent", "OK"
	SYSTEM.Push "bank_code", bnkCode
	SYSTEM.Push "bank_name", Trim(GRID0.GetGridCell(GRID0.row, 3))
	SYSTEM.Push "bank_acctNum", bnkAcntNo
