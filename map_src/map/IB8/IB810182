		SCREEN.Object("obj_TransDel.zOppIttCode").Data = bnkCode
		SCREEN.Object("obj_TransDel.zOppAcntNo").Data = bnkAcntNo
		'SCREEN.Object("obj_favoriteReg.zBnkAcntNick").Data = bnkAcntNick

		SCREEN.Proc "obj_TransDel.send_o", ""
	Else
		Exit Sub
	End If



