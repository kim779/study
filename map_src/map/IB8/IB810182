	SCREEN.Object("obj_favoriteReg.zBnkName").Data = bnkName
	SCREEN.Object("obj_favoriteReg.zBnkAcntNo").Data = bnkAcntNo
	SCREEN.Object("obj_favoriteReg.zBnkAcntNick").Data = bnkAcntNm
	SCREEN.Object("obj_favoriteReg.zBnkAcntNm").Data = bnkAcntNm

	If QryTp.data = "2" Then '타->당 조회시
		SCREEN.Object("obj_favoriteReg.zTp").Data = "1"
		SCREEN.Object("obj_favoriteReg.zBnkCode").Data = bnkCode
	ElseIf QryTp.data = "3" Then '당->당 조회시
		SCREEN.Object("obj_favoriteReg.zTp").Data = "2"
		SCREEN.Object("obj_favoriteReg.zBnkCode").Data = "068"
		SCREEN.Object("obj_favoriteReg.zBnkAcntNm").Data = bnkAcntNm

	End If
	SCREEN.Proc "obj_favoriteReg.confirm", ""

ElseIf GRID0.Column = "8" Then '최근입금계좌 삭제


	msgAns = MsgBox ("선택하신 최근 입금 계좌를 삭제하시겠습니까?",1,"최근입금계좌 삭제 확인")

	If msgAns = 1 Then '확인
