_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_tr(str)
	ClntNo.Data = Trim(str)
	send_f()
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub addCompany()
	Dim ii
	For ii = 1 To GRID0.Rows
		If Trim(QryTp.Data) = "3" Then '대체
			'GRID0.SetGridCell ii, 2, "068"
			GRID0.SetGridCell ii, 3, "IBK투자증권"
			GRID0.SetFormat ii, 4, "999-99-999999"
		Else
			GRID0.SetFormat ii, 4, "99999999999999999999"
		End If
	Next
End Sub

'gubn은 자주쓰는계좌관리등록버튼을 보여주는지 안보여줄지를
'판단하는 플래그. 당사->타금융기관탭에서는 보여주고
'자주쓰는계좌관리에서는 보여주지 않음.
'TP는 이체와 대체 구분. 1 : 이체, 2 : 대체
Sub SetScreen()
	If Trim(gubn.Data) = "Y" Then
		GRID0.SetColumnVisible 6, True
		SCREEN.SetSize 514, 196
		bgPanel.SetRect 0, 0, 517, 173
		GRID0.SetRect 8, 31, 508, 165
		guideAround.SetRect 0, 172, 517, 198
		GUIDE.SetRect 25, 175, 509, 195
	Else
		GRID0.SetColumnVisible 6, False
		SCREEN.SetSize 514 - 120, 196
		bgPanel.SetRect 0, 0, 517 - 120, 173
		GRID0.SetRect 8, 31, 508 - 120, 165
		guideAround.SetRect 0, 172, 517 - 120, 198
		GUIDE.SetRect 25, 175, 509 - 120, 195
	End If
End Sub

