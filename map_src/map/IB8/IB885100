Sub send_sise_all(xval)
SCREEN.IgnoreChange True
	S1301.Trigger "", True

	If xval <> "jumun" Then
		Call Ord_ChangeCode(S1301.Data)
	End If

	If Trim(S1301.Data) <> Trim(SCREEN.Object("OBJ_sise.1301").data) Then
		'If tab_sise.ID = 0 Then
			SCREEN.Object("OBJ_sise.1301").data = Trim(S1301.Data)
	'	End If
		OBJ_sise.Send
	End If

	OBJ_info.Send

SCREEN.IgnoreChange False
End Sub

Sub all_account()
	OBJ_account.Send
End Sub

'모든 obj 1301에 종목정보 전송
Sub Send_sise_all2(code)
	S1301.Trigger "1301", True

	If xval <> "jumun" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.obj_odr.1301").Data = code
		SCREEN.IgnoreChange False
		SCREEN.Proc "OBJ_order.obj_odr.ChangeCode", ""
	End If

	OBJ_info.Send
End Sub
