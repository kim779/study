Dim flag, click_flag
click_multi_flag = "N"

Sub click(num)

	object1 = "PANEL"&num
	object2 = "CHECK"&num

	If click_multi_flag = "N" Then
		For i =1 To 24
		object_tmp1 = "PANEL"&i
		object_tmp2 = "CHECK"&i

		SCREEN.Object(object_tmp2).Checked = False
		SCREEN.Object(object_tmp1).PRgb = "192"
		SCREEN.Object(object_tmp1).TRgb = "232"
		Next

	End If

	If SCREEN.Object(object2).Checked Then
		SCREEN.Object(object2).Checked = False
		SCREEN.Object(object1).PRgb = "192"
		SCREEN.Object(object1).TRgb = "232"
	Else
		SCREEN.Object(object2).Checked = True
		SCREEN.Object(object1).PRgb = "39853824"
		SCREEN.Object(object1).TRgb = "192"
	End If
	type_search()
End Sub

Sub click2(num)

	object1 = "P"&num
	object2 = "C"&num
	Cflag = "N"

	If SCREEN.Object(object2).Checked Then
		SCREEN.Object(object2).Checked = False
		SCREEN.Object(object1).PRgb = "192"
		SCREEN.Object(object1).TRgb = "232"

		If SCREEN.Object("C1").Checked = False And SCREEN.Object("C2").Checked = False  Then
			SCREEN.Object(object2).Checked = True
			SCREEN.Object(object1).PRgb = "39853824"
			SCREEN.Object(object1).TRgb = "192"
		End If
	Else
		SCREEN.Object(object2).Checked = True
		SCREEN.Object(object1).PRgb = "39853824"
		SCREEN.Object(object1).TRgb = "192"
	End If
	flag = "Y" '국내외 선택여부
End Sub


Sub clear()

	For i =1 To 24
		object1 = "PANEL"&i
		object2 = "CHECK"&i

		SCREEN.Object(object2).Checked = False
		SCREEN.Object(object1).PRgb = "192"
		SCREEN.Object(object1).TRgb = "232"
	Next
	VIEWGRID.Clear
End Sub

Sub type_search()
	VIEWGRID.Clear
	text1 = ""
	For i =1 To 24
		object1 = "PANEL"&i
		object2 = "CHECK"&i


		If SCREEN.Object(object2).Checked Then

			If Trim(text1) = "" Then
				text1 = Trim(SCREEN.Object(object1).text)

			Else
				text1 = text1 & "," & Trim(SCREEN.Object(object1).text)
			End If

		End If

	Next

	EDIT2.Data = text1
	flag = "N"
	SCREEN.Send 0
End Sub

Sub click_all()

	For i =1 To 24
		object1 = "PANEL"&i
		object2 = "CHECK"&i

		SCREEN.Object(object2).Checked = True
		SCREEN.Object(object1).PRgb = "39853824"
		SCREEN.Object(object1).TRgb = "192"
	Next

	type_search()
End Sub

Sub FMNum(row,col,pindex)
	'pindex = pindex+9
