RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub search()
	Dim grid, ii, cods, ctype, jname
	Set grid = SCREEN.Object("parent.GRID0")
	For ii = 1 To grid.Rows
		ctype = Trim(grid.GetGridCell(ii, 2))
		cods = Trim(grid.GetGridCell(ii, 3))
		jname = Trim(grid.GetGridCell(ii, 4))
		If ctype = "해외지수" And jname = "" Then
			didx.Data = "0"
			cods.Data = cods
			SCREEN.Send 0
			Exit For
		End If
	Next
End Sub

}



