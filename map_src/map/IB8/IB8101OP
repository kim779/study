If SCREEN.Object("parent.opgubn").Data = "8101" Then
	If Left(Trim(LEDGER.Ecod), 1) = "0" Then
		SCREEN.Object("parent.parent.OBJ_otp2.opindata").data = PinRetVal.Data
		SCREEN.Object("parent.parent.OBJ_otp2.BUTTON0").Visible = True
		SCREEN.Object("parent.parent.OBJ_otp2.BUTTON1").Visible = False
	Else
		SCREEN.Object("parent.parent.OBJ_otp2.lOnesfCnfTrxSeqno").data = ""
		SCREEN.Object("parent.parent.OBJ_otp2.searchMsg").Text = Trim(LEDGER.Emsg)
		MsgBox Trim(LEDGER.Emsg), , "IBK투자증권"
	End If
ElseIf SCREEN.Object("parent.opgubn").Data = "8102" Then
	If Left(Trim(LEDGER.Ecod), 1) = "0" Then
		SCREEN.Object("parent.parent.opindata").data = PinRetVal.Data
		SCREEN.Object("parent.parent.BUTTON0").Visible = True
		SCREEN.Object("parent.parent.BUTTON1").Visible = False
	Else
		SCREEN.Object("parent.parent.lOnesfCnfTrxSeqno").data = ""
		SCREEN.Object("parent.parent.responseMsg").Text = Trim(LEDGER.Emsg)
		MsgBox Trim(LEDGER.Emsg), , "IBK투자증권"
	End If
