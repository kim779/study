RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
'== 첫 조회
Sub send_f()
'	next_btn.Enable = False
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0100"
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	If Trim(GRID0.GetGridCell(1, 1)) = "000" Then
		GRID0.RemoveRow 0
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.Focus Then
	zBrnNm.Data = GRID0.GetGridCell(GRID0.row, 2)
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
If Trim(GRID0.GetGridCell(GRID0.Row, 1)) <> "" Then
	SYSTEM.Push "branchNo8703", GRID0.GetGridCell(GRID0.row, 1)
	SYSTEM.Push "branchNm8703", GRID0.GetGridCell(GRID0.row, 2)

	SCREEN.CloseWindow
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zBrnNm)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SYSTEM.Push "branchNo8703", GRID0.GetGridCell(GRID0.row, 1)
SYSTEM.Push "branchNm8703", GRID0.GetGridCell(GRID0.row, 2)

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
