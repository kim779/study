Dim Arrdata, data, amt

If GRID0.HitPos = 3 Then

	Arrdata = Array("","","","","","","","","","")
	'0: 계좌번호 1: 비밀번호 2: 펀드운용계좌번호 3: 투신펀드코드
	'4: 한글투신펀드명 5: 주문일 6: 체결일 7: 결제일 8: 매도대금담보대출금액 9: 주문번호

	amt = Trim(GRID0.GetGridCell(GRID0.row, 8))
	If amt = "" Then
		amt = 0
	End If

	If CLng(amt) <= 0 Then
		MsgBox "대출가능금액이 없는 계좌는 해당되지 않습니다.", 0, "IBK 투자증권"
		Exit Sub
	End If

	opt.Data = "1"
	Arrdata(0) = AN50.data
	Arrdata(1) = zPwd.data
	Arrdata(2) = Trim(GRID0.GetGridCell(GRID0.row, 1))
	Arrdata(3) = Trim(GRID0.GetGridCell(GRID0.row, 4))
	Arrdata(4) = Trim(GRID0.GetGridCell(GRID0.row, 5))
	Arrdata(5) = Trim(GRID0.GetGridCell(GRID0.row, 15))
	Arrdata(6) = Trim(GRID0.GetGridCell(GRID0.row, 16))
	Arrdata(7) = Trim(GRID0.GetGridCell(GRID0.row, 17))
	Arrdata(8) = Trim(GRID0.GetGridCell(GRID0.row, 8))
	Arrdata(9) = Trim(GRID0.GetGridCell(GRID0.row, 26))

	data = Join(Arrdata, "|")
	obj1.Proc "ProcSetdata", data
End If
