_AW_ONDECLARE_AW_
'== 전송
Sub send_f2()
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.ClearAll 0, 2
	ACNM.Data = SCREEN.object("parent.acnm").data
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub Set_account()
	SCREEN.ClearAll 0, 2
	ACNM.Data = AN50.Name
	SCREEN.object("parent.acnm").data =	ACNM.Data

	If Trim(AN50.Data) = "" Then
		AN50.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'Call Check_LoginType(zPwd)
LEDGER.Rcnt = "0010"
opt.Data = "0"
zPwd.Data = SCREEN.Object("main.zpwd").data

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
'If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
'   zPwd.Data = "9999"
'End If

If CheckInput(AN50, zPwd) = True Then
	SCREEN.onsend = True
	SCREEN.Object("parent.ACNM").Data = ACNM.Data
Else
	SCREEN.ClearAll 2, 2
	ACNM.Data = SCREEN.Object("parent.ACNM").Data
	zPwd.SetFocus
End If

If Len(zPwd.data) < 0 Then
	SCREEN.onsend = False
	MsgBox "비밀번호를 확인하십시오", 0, "IBK 투자증권"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ACNM.Data = SCREEN.object("parent.acnm").Data
End If

If LEDGER.Next = "Y" And LEDGER.Ecod <> "0136" Then
	Call send_c()
Else
	GRID0.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	SCREEN.Object("main.zPwd").Data = Trim(zPwd.Data)
	Call send_f()
End If
