RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 0
	SCREEN.Object("parent.responseMsg").Text = ""
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"
zUserId.Data = Trim(SYSTEM.UserID)
zReqstSvcId.Data = ""
opgubn.Data = "8102"

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("parent.responseMsg").Text = ""
SCREEN.Object("parent.opindata").data = ""
SCREEN.Object("parent.zMdaSeqno").data = ""

If Trim(zOnesfCnfPtnTp.data) = "S" Then
	SCREEN.Object("parent.LABEL3").text = "공동앱에 스마트OTP카드를"
	SCREEN.Object("parent.LABEL4").text = "태그하여 생성되는 OTP생성번호"
	SCREEN.Object("parent.LABEL5").text = "를 입력하여 주십시오"
	SCREEN.Object("parent.CHECK0").visible = True
Else
	SCREEN.Object("parent.LABEL3").text = "OTP생성기에 표시되는"
	SCREEN.Object("parent.LABEL4").text = "OTP생성번호를 입력하여"
	SCREEN.Object("parent.LABEL5").text = "주십시오"
	SCREEN.Object("parent.CHECK0").visible = False
End If

If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	SCREEN.Object("parent.lOnesfCnfTrxSeqno").Data = Trim(lOnesfCnfTrxSeqno.Data)
	SCREEN.Object("parent.zOtpVrfVal").SetFocus

	If zMdaSeqnoReqstYn.data = "Y" Then
		SCREEN.Object("parent.zMdaSeqno").Enable = True
		SCREEN.Object("parent.zMdaSeqno").SetFocus
		If Trim(zOnesfCnfPtnTp.data) = "S" Then
			MsgBox "매체일련번호 입력 후 전송 버튼을 클릭하세요",0,"IBK투자증권"
			SCREEN.Object("parent.BUTTON0").Visible = False
			SCREEN.Object("parent.BUTTON1").Visible = True
		End If
	Else
		SCREEN.Object("parent.zMdaSeqno").Enable = False
		If Trim(zOnesfCnfPtnTp.data) = "S" Then
			If SCREEN.Object("parent.CHECK0").Checked = True Then
				obj_op.Send
			Else
				obj_ox.Send
			End If
		End If
	End If
Else
	SCREEN.Object("parent.responseMsg").Text = Trim(LEDGER.Emsg)
	Call alert_msg(Trim(LEDGER.Emsg))
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
