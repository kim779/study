RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
zInptPwd.SetFocus

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"

Dim acnt
acnt = Trim(SCREEN.Object("parent.CMB_ACCT").Data)
zAcntNo.Data = Left(Trim(acnt), 3) & "00" & Right(Trim(acnt), 6)

If Trim(zInptPwd.Data) = "" Then
	Call guide_msg("보안비밀번호를 확인하여 주십시오.")
	zInptPwd.SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If Trim(zAvalYn.Data) = "1" Then
		'timer를 건 이유는 공인인증서 비밀번호가 틀렸을 경우
		'응답을 받기 위함임.
		SCREEN.SetTimer 4, False
	Else
		Dim msg, ErrCnt
		msg = ""
		ErrCnt = CLng(zErrCnt.Data) + 1

		If ErrCnt <= 2 Then
			msg = "보안비밀번호 오류입니다. (5회중 " & 5 - ErrCnt & "회 남았습니다.)"
		ElseIf ErrCnt <= 4 Then
			msg = "보안비밀번호를 " & ErrCnt & "회 잘못입력하셨습니다. 5회이상 오류시 사용정지 됩니다."
		Else
			msg = "보안비밀번호 연속오류허용 횟수를 초과하였습니다. 고객만족팀(1588-0030)로 본인확인하여 주십시오."
		End If

		Call alert_msg(msg)
		Call guide_msg(msg)
	End If
Else
	Call alert_msg(Trim(LEDGER.Emsg))
	Call guide_msg(msg)
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
	zInptPwd.Clear
	SCREEN.Object("parent.obj_showCerti").VIsible = False

	SCREEN.Proc "parent.obj_snd.send_o", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zInptPwd)
_AW_ONKEYCHANGE_AW_
'== 보안카드번호 입력 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Trim(zInptPwd.Data) = "" Then
		Exit Sub
	End If

	Call send_f()
End If
