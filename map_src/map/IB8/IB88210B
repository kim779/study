RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_ArrData
Dim g_ArrCtrls
Dim g_Flag


'Index :
'	0 - 종목코드
'	1 - 옵션매도호가
'	2 - 옵션매도호가 수량
'	3 - 옵션매수호가
'	4 - 옵션매수호가 수량
'	5 - 행사가격
'	6 - 거래단위 : 거래승수가 10만원이면 5이고, 50만원이면 1이다.
g_ArrData = Array("", 0, 0, 0, 0, 0, 0)

'Index :
'	0 - 옵션매도호가
'	1 - 옵션매도호가 수량
'	2 - 옵션매수호가
'	3 - 옵션매수호가 수량
'	4 - 옵션 거래승수
g_ArrCtrls = Array(S42051, S42041, S42071, S42061, S40380)
g_Flag = False
'-------------------------------------------------------------------------------------
Sub SendOptData(ItemCd)
	g_ArrData(0) = ItemCd
	S40301.Data = ItemCd
	g_Flag = True

	ExerPrc = Mid(g_ArrData(0), 6, 3)
	Gubn = Mid(ExerPrc, 3, 1)
	If Gubn = "2" Or Gubn = "7" Then
		g_ArrData(5) = ExerPrc & ".5"
	Else
		g_ArrData(5) = ExerPrc
	End If

	SCREEN.Send 0
End Sub
'-------------------------------------------------------------------------------------
Sub OnAlert()
	CalcOptData()
	'SCREEN.SetTimer 1, False
End Sub
'-------------------------------------------------------------------------------------
Function GetData(StrData, DataType)
	GetData = 0

	Data = Trim(StrData)
	If Len(Data) = 0 Then
		Exit Function
	Else
		If DataType = 1 Then			'CDBL
			GetData = CDbl(Data)
		Else							'CLNG
			GetData = CLng(Data)
		End If
	End If
End Function
'-------------------------------------------------------------------------------------
Sub CalcOptData()
	Dim OptDrnDiv

	OptDrn = GetData(g_ArrCtrls(4).Data, 2) \ 100000

	If OptDrn = 1 Then
		OptDrnDiv = 5
	Else
		OptDrnDiv = 1
	End If

	AskPrc = GetData(g_ArrCtrls(0).Data, 1)
	BidPrc = GetData(g_ArrCtrls(2).Data, 1)
	AskVol = GetData(g_ArrCtrls(1).Data, 2) \ OptDrnDiv
	BidVol = GetData(g_ArrCtrls(3).Data, 2) \ OptDrnDiv


'	AskPrc = Trim(g_ArrCtrls(0).Data)
'	BidPrc = Trim(g_ArrCtrls(2).Data)
'
'	AskVol = CLng(Trim(g_ArrCtrls(1).Data)) \ 5
'	BidVol = CLng(Trim(g_ArrCtrls(3).Data)) \ 5

	ArrData = Array(AskPrc, AskVol, BidPrc, BidVol, g_ArrData(5), OptDrnDiv)

	Flag = False
	For i = LBound(ArrData) To UBound(ArrData)
		Value = CDbl(ArrData(i))
		If CDbl(g_ArrData(i + 1)) <> Value Then
			Flag = True
		End If
		g_ArrData(i + 1) = Value
	Next

	If Flag Then
		Data = Join(g_ArrData, "|")
		SCREEN.Proc "Parent.SetData", Data
	End If

End Sub

_AW_ONSEND_AW_
If Not g_Flag Then
	SCREEN.OnSend = False
	S40301.Data = ""
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
g_Flag = False
CalcOptData

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
CalcOptData

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(40301)
_AW_ONCHANGE_AW_
S40301.Trigger "", True
S40301.Trigger "ed_focod", True
S40301.Trigger "zFnoIsuNo", True
SYSTEM.SetHistory "ed_focod", S40301.Data
SYSTEM.SetHistory "zFnoIsuNo", S40301.Data
SCREEN.Send 0
'obj.send
'obj_chart.Send
'obj2.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



