_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2

	If Trim(zAppyAcntNo.Data) = "" Then
		zAppyAcntNo.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
'한달 전으로 조회
Dim yy, mm, dd, cday, MyWeek

cday = DateAdd("d", -31, Date)
MyWeek = Weekday(cday)
If MyWeek = 1 Then
	cday= DateAdd("d", -2 , cday)
ElseIf MyWeek = 7 Then
	cday= DateAdd("d", -1 , cday)
End If

yy = Year(cday)
mm = Month(cday)
If Len(mm) = 1 Then mm = "0"&mm

dd = Day(cday)
If Len(dd) = 1 Then dd = "0"&dd

cday = yy&mm&dd
zQrySrtDt.Data = CDbl(cday)

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim i, jongmok, Trim_a

If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	For i = 1 To GRID0.Rows
		jongmok = Trim(GRID0.GetGridCell(i, 5))

		If Len(jongmok) = 7 Then
			Trim_a = Right(jongmok, 6)
			GRID0.SetGridCell i, 5, Trim_a
		End If
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONDBLCLK_AW_
Dim str, dt, amt

If SCREEN.Object("main.UTAB0").Index = 1 Then
	str = Trim(GRID0.GetGridcell(GRID0.row, 5))

	SCREEN.Object("main.obj1.zAppyIsuNo").Data = str

	If Len(str) <> 6  Then
		SCREEN.Object("main.obj1.chae").checked = True
		SCREEN.Object("main.obj1.zIsuNo_chae").data = str
		SCREEN.Object("main.obj1.chae_nm").data = Trim(GRID0.GetGridcell(GRID0.row, 4))
		SCREEN.Proc "main.OBJ1.set_chae", ""
	Else
		SCREEN.Object("main.OBJ1.jusik").checked = True
		SCREEN.Object("main.obj1.zIsuNo").data = str
		SCREEN.Proc "main.OBJ1.set_jusik", ""
		SCREEN.Object("main.obj1.obj").send
	End If


	str = Trim(GRID0.GetGridcell(GRID0.row, 3))
	SCREEN.Object("main.obj1.lAppyNo").data = str
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


