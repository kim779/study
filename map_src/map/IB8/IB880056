RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim Select_no  '기존선택되어있던 그룹번호

Sub send_f()
	If GRID0.Row > 0 Then
		Select_no = GRID0.GetGridCell(GRID0.Row,1)
	End If
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Function Find_Row(acc_no, mtp,code)
	For row = 1 To GRID0.Rows
		If Trim(acc_no) = Trim(GRID0.GetGridCell (row, 2)) _
				And Trim(mtp) = Trim(GRID0.GetGridCell (row, 4)) _
				And Trim(code) = Trim(GRID0.GetGridCell (row, 6)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

_AW_ONSTART_AW_
send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0040"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, Ordqty, chgqty

If LEDGER.Next = "Y" Then
	Send_c()

Else
	For ii = 1 To GRID0.Rows
		If Select_no = GRID0.GetGridCell(ii , 1) Then
			GRID0.Row = ii
			GRID0.Index = ii-1
		End If
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_

send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim Row,ii, sgrp_no, sgrp_name
If GRID0.Focus Then
	Row = GRID0.Row
	If Row > 0 Then
		sgrp_no = GRID0.GetCell(Row, "col2")
		sgrp_name = GRID0.GetCell(Row, "col3")
		SCREEN.Object("Object0.grp_no").data = sgrp_no
		SCREEN.Object("Object0.grp_name").data = sgrp_name
		SCREEN.Object("Object0.obj_query.grp_no").data = sgrp_no
		SCREEN.Object("Object0.obj_query.grp_name").data = sgrp_name
		SCREEN.Object("Object0.obj_query").Send
	End If
End If
