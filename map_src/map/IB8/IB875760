Sub Calinput
Dim  S1data, S2data,i, ii, iii, data0, data1
Select Case Len(data)
Case 17
	If Trim(data) <> "" And InStr(1,data, "+" ,1) = 0 Then
		If InStr(1,data, "." ,1) <> 0 Then
			data = Split(data, ".",-1,1)
			S1data = Trim(data(0))
			S2data = Trim(data(1))
		Else
			S1data = Trim(CDbl(data))
			S2data = Trim("")
		End If
			i = Len(S1data)
			ii =  Len(S2data)

		For iii = 1 To 5-i
			data0 = data0 + "0"
		Next

		For iii = 1 To 10-ii
			data1 = data1 + "0"
		Next

		data3 = Trim("+"&data0&S1data&"."&S2data&data1)
	Else

	    data3 = "+00000.0000000000"
	End If
Case 16
	If Trim(data) <> "" And InStr(1,data, "+" ,1) = 0 Then
		If InStr(1,data, "." ,1) <> 0 Then
		data = Replace(data, ".", "")
		End If
		S1data = Trim(CDbl(data))
		i = Len(S1data)
		For iii = 1 To 15-i
			data0 = data0 + "0"
		Next
		data3 =Trim("+"&data0&S1data)

	Else
		data3 = "+000000000000000"
		End If
Case 6
	If Trim(data) <> "" And InStr(1,data, "+" ,1) = 0 Then
		S1data = Trim(CDbl(data))
		i = Len(S1data)
		For iii = 1 To 5-i
			data0 = data0 + "0"
		Next

		data3 = Trim("+"&data0&S1data)
	Else

	    data3 = "+00000"
	End If

Case Else
 	Exit Sub
End Select
End Sub


