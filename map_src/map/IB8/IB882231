'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = ACNO.Name
	h_acnm.Data = ACNO.Name
	zPwd.Data = ACNO.Password
	If Trim(ACNO.Data) = "" Then
		ACNO.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False

	If Trim(ACNO.Data) = "" Or Len(Trim(ACNO.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If
	If Trim(zPwd.Data) = "" Or Len(Trim(zPwd.Data)) < 4 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Function
	End If

'	ret = P_pswdConfirm(ed_accn.data, ed_pswd.data, msg)
'	If ret <> True Then
'		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
'		SCREEN.Object("main.GUIDE").Text = msg
'		Exit Function
'	End If

	Error_check = True
End Function

