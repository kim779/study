{


_AW_ONDECLARE_AW_

'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
'	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.Object("main.guide").text = ""

SCREEN.OnSend = False
If CheckInput_1(zEmpNo, zEmpPwd) = True Then
	SCREEN.OnSend = True
 	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	SCREEN.object("parent.who").text = "0"
	SCREEN.object("parent.next_btn").enable = True
	SCREEN.object("parent.next_btn").Setfocus
Else
	SCREEN.object("parent.next_btn").enable = False
End If

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
SCREEN.OBJect("main.zEmpNo").data = zEmpNo.Data
SCREEN.OBJect("main.zEmpPwd").data = zEmpPwd.Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zEmpPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
    Exit Sub
End If

Dim accn_buf
accn_buf = Mid(Trim(GRID0.GetGridCell(GRID0.row, 1)), 1, 11)

If accn_buf <> "" Then
SCREEN.Object("parent.robj.accn").data = accn_buf
SCREEN.Object("parent.robj.zAccnPwd").data = "0423"
SCREEN.Object("parent.robj").send
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


