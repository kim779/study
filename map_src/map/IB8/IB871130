RESOURCE DIVISION
{


_AW_ONDECLARE_AW_

'== 첫 조회
Sub send_f()
	O_GRID.Clear
	LEDGER.Fkey = "C"

	SCREEN.Send 0
End Sub




'== 조회된 데이타를  OBJ 에  Setting
Sub P_GetGrid()
	Dim cbox_buf, code_buf, hnam_buf

	For ii = 1 To 20
	  	cbox_buf = "obj" & ii & ".CHECK"
  		code_buf = "obj" & ii & ".1301"
		hnam_buf = "obj" & ii & ".hnam"
		SCREEN.Object(cbox_buf).checked = False
  		SCREEN.Object(code_buf).data = O_GRID.GetgridCell(ii, 2)
  		SCREEN.Object(hnam_buf).text = O_GRID.GetgridCell(ii, 3)
	Next

End Sub


'== 입력한 데이타를  GRID 에  Setting
Sub P_SetGrid()
	Dim code_buf, hnam_buf, cod_b, cnt
	I_GRID.Clear()

	cnt = 0
	For ii = 1 To 20
  		cbox_buf = "obj" & ii & ".CHECK"
  		code_buf = "obj" & ii & ".1301"
  		hnam_buf = "obj" & ii & ".hnam"

  		If  SCREEN.Object(cbox_buf).checked = True Then
	 		I_GRID.setgridCell  ii, 1, "1"
	 		If RADIO1.Checked = True Then
	 			cod_b = "A" & SCREEN.Object(code_buf).data
	 		Else
	 			cod_b = "J" & SCREEN.Object(code_buf).data
	 		End If
 	 		I_GRID.setgridCell  ii, 2, cod_b
 	 		I_GRID.setgridCell  ii, 3, SCREEN.Object(hnam_buf).text
 	 		cnt = cnt + 1
  		End If
 	Next
 	i_cnt.Data = cnt

End Sub

'== 화면 Clear
Sub P_Clear()
	Dim cbox_buf, code_buf, hnam_buf

	For ii = 1 To 20
  		cbox_buf = "obj" & ii & ".CHECK"
  		code_buf = "obj" & ii & ".1301"
		hnam_buf = "obj" & ii & ".hnam"
  		SCREEN.Object(cbox_buf).checked = False
  		SCREEN.Object(code_buf).data = ""
  		SCREEN.Object(hnam_buf).text = ""
	Next

End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
SCREEN.Object("main.guide").text = ""
If CheckInput_1(zEmpNo, zEmpPwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Mid(LEDGER.Ecod, 1, 1) = "0" Then
	P_GetGrid()
End If

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
SCREEN.OBJect("main.zEmpNo").data = zEmpNo.Data
SCREEN.OBJect("main.zEmpPwd").data = zEmpPwd.Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zEmpPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
