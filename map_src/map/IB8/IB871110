RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MYFILE = "userconf.ini"
Const MYMAP = "IB871110"

Dim MidCnt, branchCnt
MidCnt = 0
branchCnt = 0

'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	gridPos.Data = 1
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub sortMidAccn()
	Dim MidAccnList, ii, jj, kk, tmpMidAccn, lastAccn
	MidAccnList = Array("11", "20", "21", "30", "51", "52", "53", "54")

	lastAccn = ""

	For ii = 0 To 7
		For jj = 1 To GRID0.Rows
			If lastAccn = Trim(GRID0.GetGridText(jj, 1)) Then
				Exit For
			End If

			tmpMidAccn = Mid(Trim(GRID0.GetGridCell(jj, 1)), 5, 2)

			If tmpMidAccn = MidAccnList(ii) Then
				GRID0.InsertRow(-1)

				For kk = 1 To GRID0.Rows
					GRID0.Row = jj

					If GRID0.IsColumnVisible(kk) = True Or kk = 23 Then
						GRID0.SetGridCell GRID0.Rows, kk, Trim(GRID0.GetGridCell(jj, kk))
					End If
				Next

'				SYSTEM.Trace "lstAccn = " & lastAccn
				If lastAccn = "" Then
					lastAccn = Trim(GRID0.GetGridCell(GRID0.Rows, 1))
				End If

				GRID0.RemoveRow(jj - 1)
				jj = jj - 1
			End If
		Next
	Next
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("info") Then
		Dim chkNm

	  	If branchNo.Checked = True Then
	  		chkNm = "branch"
	  	Else
	  		chkNm = "midAccn"
	  	End If

	  	INFO.PushData LOGIN.Name, MYFILE, MYMAP, "check", chkNm
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
		Dim chked

		chked = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "check"))

		If chked = "" Then
			branchNo.Checked = True
		Else
			If chked = "branch" Then
				branchNo.Checked = True
			Else
				midAccnNo.Checked = True
			End If
		End If
	End If
End Sub

Sub afterFunc()
'	branchNo.Enable = True
'	midAccnNo.Enable = True

	SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)

	Dim ii
	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(ii, 11)) = "-    -" Then
			GRID0.SetGridCell ii, 11, ""
		End If

		If Trim(GRID0.GetGridCell(ii, 12)) = "-    -" Then
			GRID0.SetGridCell ii, 12, ""
		End If

		If Trim(GRID0.GetGridCell(ii, 13)) = "-    -" Then
			GRID0.SetGridCell ii, 13, ""
		End If

		GRID0.SetGridCell ii, 23, Left(Trim(GRID0.GetGridCell(ii, 1)), 13)
	Next

	If midAccnNo.Checked = True Then
		MidCnt = MidCnt + 1
		branchCnt = 0
		Call sortMidAccn()
	Else
		MidCnt = 0
		branchCnt = branchCnt + 1
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0014"

Call p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
SCREEN.Object("main.guide").text = ""
If CheckInput_1(zEmpNo, zEmpPwd) = True Then
'	branchNo.Enable = False
'	midAccnNo.Enable = False
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
	next_btn.SetFocus
Else
	next_btn.Enable = False
End If

For i = gridPos.Data To GRID0.Rows
	GRID0.SetGridCell i, 10, Trim(GRID0.GetGridCell(i,24))
Next
gridPos.Data = GRID0.Rows + 1

SCREEN.Object("main.GUIDE").Text = GUIDE.text

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
SCREEN.OBJect("main.zEmpNo").data = zEmpNo.Data
SCREEN.OBJect("main.zEmpPwd").data = zEmpPwd.Data

Call p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zEmpPwd)
