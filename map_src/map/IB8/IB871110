'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(sortMidChk)
_AW_ONCLICK_AW_
If sortMidChk.Checked = True Then
	Call sortMidAccn()
Else
	GRID0.Sort 23, True, False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(midAccnNo)
_AW_ONCLICK_AW_
MidCnt = MidCnt + 1
branchCnt = 0

If MidCnt < 2 Then
	Call sortMidAccn()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(branchNo)
_AW_ONCLICK_AW_
MidCnt = 0
branchCnt = branchCnt + 1

If branchCnt < 2 Then
	GRID0.Sort 23, True, False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


