RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.Onsend False

an.Data = Trim(SCREEN.Object("parent.parent.AN99").Data)
pwd.Data = Trim(SCREEN.Object("parent.parent.zpwd").Data)

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(pwd.Data) = "" Then
   pwd.Data = "9999"
End If

If CheckInput(an, pwd) = True Then
	SCREEN.OnSend True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Or LEDGER.Ecod = "1001"Then
	SCREEN.ClearAll 1,2
	If SCREEN.Object("main.sect").Data = "1" Then
		SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN99").name
	Else
		SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN98").name
	End If
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus
Else
	SCREEN.Object("parent.AcntStatNm").data = Trim(AcntStatNm.Data)
	SCREEN.Object("parent.RmnTpNm").data = Trim(RmnTpNm.Data)
	SCREEN.Object("parent.LedgSdinfAddrPtnNm").data = Trim(LedgSdinfAddrPtnNm.Data)

	If Trim(PwdContErrCnt.Data) = "" Then
		PwdContErrCnt.Data = "0"
	End If

	Select Case CLng(Trim(PwdContErrCnt.Data))
	Case 0
		SCREEN.Object("parent.PwdContErrCnt").data = "없음 (0회)"
	Case Else
        SCREEN.Object("parent.PwdContErrCnt").data = CLng(Trim(PwdContErrCnt.Data)) & " 회"
	End Select
	SCREEN.Proc "parent.send_f", ""
End If

_AW_ONENDSUB_AW_
}



