RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'==========================================================
'CX_DATATRANS에서 계좌목록 조회
'==========================================================
Sub send_f()
	Dim accnGrp, accnList, accnInfo, acntacnm
	Dim ii, tmpAcnt, acnt, acnm, nick, myFlag
	accnGrp = CONTROL0.GetTypeData("4", "")

	GRID0.Clear

	If Trim(accnGrp) = "" Then
		Exit Sub
	End If

	accnList = Split(accnGrp, vbLf)

	For ii = LBound(accnList) To UBound(accnList) - 1
		accnInfo = Split(accnList(ii), "|")
		tmpAcnt = Trim(accnInfo(0))

		If tmpAcnt <> "" Then
			acntacnm = Split(tmpAcnt,vbTab)
			acnt = Trim(acntacnm(0))
			acnm = Trim(acntacnm(2))
			nick = Trim(accnInfo(1))
			myFlag = Trim(accnInfo(2))


			If nick <> "" Then
				acnm = nick
			End If

			GRID0.InsertRow -1
			GRID0.SetGridCell GRID0.Rows, 1, acnt
			GRID0.SetGridCell GRID0.Rows, 2, acnm
			GRID0.SetGridCell GRID0.Rows, 3, nick
			GRID0.SetGridCell GRID0.Rows, 4, myFlag
		End If
	Next

	Call findAcnt()
End Sub

'==========================================================
'본인계좌이면서 은행예수금방식계좌만 찾아 계좌컨트롤에 세팅
'==========================================================
Sub findAcnt()
	Dim ii, acnt, acnm, nick, myFlag, acntTp, acntItems, acnmItems, acntView
	acntItems = ""
	acnmItems = ""

	For ii = 1 To GRID0.Rows
		acnt = Trim(GRID0.GetGridCell(ii, 1))

		If Len(acnt) = 11 Then
			acntTp = Left(acnt, 3)

			If (CLng(acntTp) >= 551 And CLng(acntTp) <= 555) And Mid(acnt, 4, 2) = "10" Then
				If acntItems = "" Then
					acntItems = acnt
				End If

				acntView = Left(acnt, 3) & "-" & Mid(acnt, 4, 2) & "-" & Right(acnt, 6)
				acnm = Trim(GRID0.GetGridCell(ii, 2))

				acntItems = acntItems & vbTab & acnt & acntView & " 위탁 " & acnm
			End If
		End If
	Next

	If acntItems <> "" Then
		SCREEN.Object("parent.CMB_ACCT").SetItems acntItems
		SCREEN.Proc "parent.acct_set", ""
	Else
		SCREEN.Object("parent.CMB_ACCT").SetFocus
	End If
End Sub

}



