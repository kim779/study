Dim ii, jj, flag, pos
flag = False
pos = CLng(Trim(nextGridPos.Data))

For ii = 1 To CLng(Trim(outGrid.Rows))
	Dim tmpBday, tmpMday
	tmpBday = Trim(outGrid.GetGridCell(ii, 6))
	tmpMday = Trim(outGrid.GetGridCell(ii, 7))

	If tmpBday = "00" Then
		tmpBday = ""
	End If

	If tmpMday = "00" Then
		tmpMday = ""
	End If

	For jj = pos To SCREEN.Object("parent.GRID0").Rows
		Dim psdn
		psdn = Trim(outGrid.GetGridCell(ii, 3))

		If psdn = "" Then
			Exit For
		End If

		If  psdn <> "" And psdn = Trim(SCREEN.Object("parent.GRID0").GetGridCell(jj, psdnLoc)) Then
			SCREEN.Object("parent.GRID0").SetGridCell jj, bdayLoc, tmpBday
			SCREEN.Object("parent.GRID0").SetGridCell jj, mdayLoc, tmpMday
			SCREEN.Object("parent.GRID0").SetGridCell jj, mailLoc, Trim(outGrid.GetGridCell(ii, 5))
			SCREEN.Object("parent.GRID0").SetGridCell jj, usidLoc, Trim(outGrid.GetGridCell(ii, 1))
			SCREEN.Object("parent.GRID0").SetGridCell jj, ucodLoc, Trim(outGrid.GetGridCell(ii, 2))
			flag = True
		ElseIf psdn <> Trim(SCREEN.Object("parent.GRID0").GetGridCell(jj, psdnLoc)) And flag = True Then
			flag = False
			pos = jj
			Exit For
		End If
	Next
Next

If SCREEN.Object("parent.nextYN").Data = "Y" Then
	SCREEN.Proc "parent.send_c", ""
Else
	SCREEN.Proc "parent.afterFunc", ""
