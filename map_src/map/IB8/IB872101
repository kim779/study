RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim SetPos

Sub getInfo(pos)
	inGrid.Clear
	SCREEN.ClearAll 0, 2

	SetPos = pos
'	SYSTEM.Trace "pos = " & pos
	Dim ii, jj
	jj = 1

	For ii = pos To SCREEN.Object("parent.GRID0").Rows
		If jj = 1 Then
			inGrid.SetGridCell jj, 3, Trim(SCREEN.Object("parent.GRID0").GetGridCell(ii, 22))
			jj = jj + 1
		Else
			If Trim(inGrid.GetGridCell(jj - 1, 3)) <> Trim(inGrid.GetGridCell(ii, 3)) Then
				inGrid.SetGridCell jj, 3, Trim(SCREEN.Object("parent.GRID0").GetGridCell(ii, 22))
				jj = jj + 1
			End If
		End If
	Next

	in_nrec.Data = jj - 1
	inGrid.SetRows in_nrec.Data
	SCREEN.Send 0
End Sub

Sub SetEmail()
	Dim tmpParentUser, currentUser

	For ii = 1 To outGrid.Rows
		For jj = SetPos To SCREEN.Object("parent.GRID0").Rows
			currentUser = Trim(outGrid.GetGridCell(ii, 3))
			tmpParentUser = Trim(SCREEN.Object("parent.GRID0").GetGridCell(jj, 22))

			If currentUser = tmpParentUser Then
				SCREEN.Object("parent.GRID0").SetGridCell jj, 13, Trim(outGrid.GetGridCell(ii, 5))
			End If
		Next
	Next
End Sub

_AW_ONRECEIVE_AW_
Call SetEmail()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



