Sub DoAlarmMethod()
	Dim gridNm
	gridNm = "obj_howInformation.GRID0"

	SCREEN.Object(gridNm).Clear

	Dim ii, jj, sms, vst, wrlin, etc, chk_sms, chk_vst, chk_wrlin, chk_etc, PrdtTp, OrdDt, OrdMktCode, MgmtBrnNo, lOrdNo, lCtrctNo, lExecNo, AcntNo, UserId

	For ii = 1 To GRID0.Rows
		sms   = Trim(GRID0.GetGridCell(ii, 20))
		vst   = Trim(GRID0.GetGridCell(ii, 21))
		wrlin = Trim(GRID0.GetGridCell(ii, 22))
		etc   = Trim(GRID0.GetGridCell(ii, 23))

		If Trim(sms) <> "1" Then
			sms = "0"
		End If

		If Trim(vst) <> "1" Then
			vst = "0"
		End If

		If Trim(wrlin) <> "1" Then
			wrlin = "0"
		End If

		If Trim(etc) <> "1" Then
			etc = "0"
		End If

		chk_sms   = Trim(GRID0.GetGridCell(ii, 25))
		chk_vst   = Trim(GRID0.GetGridCell(ii, 26))
		chk_wrlin = Trim(GRID0.GetGridCell(ii, 27))
		chk_etc   = Trim(GRID0.GetGridCell(ii, 28))

		If Trim(chk_sms) <> "1" Then
			chk_sms = "0"
		End If

		If Trim(chk_vst) <> "1" Then
			chk_vst = "0"
		End If

		If Trim(chk_wrlin) <> "1" Then
			chk_wrlin = "0"
		End If

		If Trim(chk_etc) <> "1" Then
			chk_etc = "0"
		End If

		If Trim(sms) <> Trim(chk_sms) Or Trim(vst) <> Trim(chk_vst) Or _
			Trim(wrlin) <> Trim(chk_wrlin) Or Trim(etc) <> Trim(chk_etc) Then

			OrdDt = Trim(GRID0.GetGridCell(GRID0.Row, 1))			'주문일

			If Trim(OrdDt) = "" Then
				Exit Sub
			End If

			OrdMktCode = Trim(GRID0.GetGridCell(ii, 2))		'주문시장코드
			MgmtBrnNo  = Trim(GRID0.GetGridCell(ii, 4))		'관리지점번호
			lOrdNo     = "+" & String(9 - Len(Trim(GRID0.GetGridCell(ii, 5))), "0") & Trim(GRID0.GetGridCell(ii, 5))			'주문번호
			lCtrctNo   = Trim(GRID0.GetGridCell(ii, 6))		'약정번호
