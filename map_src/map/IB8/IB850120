_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB850100"

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
	 	ac_data.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "AC_DATA"))
	 	ac_name.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "AC_NAME"))
	End If
End Sub


Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
	  INFO.PushData LOGIN.Name, myFILE, myMAP, "AC_DATA", ac_data.text
	  INFO.PushData LOGIN.Name, myFILE, myMAP, "AC_NAME", ac_name.text
	End If
End Sub

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password

	If Len(Trim(AN1A.Data)) < 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

