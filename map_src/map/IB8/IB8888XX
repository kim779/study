RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub certsend()
	Dim srcB,srcL,desB,desL
	srcB = SYSTEM.UserID
	srcL = Len(SYSTEM.UserID)
	desB = ""
	desL = 0

	desL = SYSTEM.certifyfull(srcB, srcL, desB)

	If (desL = -3) Then
		Exit Sub
	End If

	If (desL > 0) Then
		stringdata.Data = desB
		SCREEN.ClearAll 0,2
		LEDGER.Fkey = "C"
		SCREEN.Send 0
	Else
		SCREEN.ClearAll 0,2
		OBJECT0.Proc "errorcount","E"
	End If
End Sub

' -1        : 공인인증모듈 상태 에러
' -2        : 패스워드 검증 시 알 수 없는 에러
' -3        : 패스워드 검증 시 취소 버튼 누름
' -4        : 패스워드 입력 후 패스워드 검증 에러

_AW_ONRECEIVE_AW_
If LEDGER.Ecod > 1000 Then
	MsgBox Mid(Trim(LEDGER.Emsg),16,Len(Trim(LEDGER.Emsg))-16),0,"IBK투자증권"
Else
	Select Case Trim(strResultGubn.Data)
		Case "0"
			SCREEN.Proc "parent.fullpass_send",""
			OBJECT0.Proc "errorcount","S"
		Case "1"
			MsgBox "선택하신 인증서는 이미 폐기된 인증서입니다.",0,"IBK투자증권"
		Case "2"
			MsgBox "선택하신 인증서는 이미 정지된 인증서입니다.",0,"IBK투자증권"
		Case "3"
			MsgBox "선택하신 인증서는 이미 만료된 인증서입니다.",0,"IBK투자증권"
		Case Else
			MsgBox "선택하신 인증서 검증시 오류가 발생하였습니다.",0,"IBK투자증권"
	End Select
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call certsend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



