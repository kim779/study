RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)
End Sub

'== D-2 날짜 구하기
Sub getD_7()
	Dim yy, mm, dd, cday, MyWeek

	cday = DateAdd("d", -7, Date)
	MyWeek = Weekday(cday)

	If MyWeek = 1 Then
		cday= DateAdd("d", -2 , cday)
	ElseIf MyWeek = 7 Then
		cday= DateAdd("d", -1 , cday)
	End If

	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)

	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd
	zStrDt.Data = CDbl(cday)
End Sub

Sub SettingAdmin(data)
	Dim dataArray, gubn
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	gubn = dataArray(0)

	If gubn = "0030" Or gubn = "0040" Then
		EDIT2.Data = "1"
	ElseIf gubn = "0030" Then
		EDIT2.Data = "0"
	ElseIf gubn = "0470" Then
		EDIT2.Data = "2"
	End If

	SYSTEM.Trace "data : " & data
	EDIT3.Data = dataArray(1)
	EDIT4.Data = dataArray(2)



End Sub

_AW_ONSTART_AW_
Call getD_7()
SCREEN.SetTimer 10, False

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call Send_f()

