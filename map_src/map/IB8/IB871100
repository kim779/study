Sub Set_btn(gubn)
	Dim ii, btn, objn, desc

	btn = "BUTTON"
	Select Case gubn
	Case 1
		For ii = 0 To 17
			objn = btn&ii
			If Left(desc1(ii),1) = "-" Then
				desc = Mid(desc1(ii),2)
			Else
				desc = desc1(ii)
			End If
			SCREEN.Object(objn).text = desc
			If Trim(desc) <> "" And Left(desc1(ii),1) <> "-" Then
				SCREEN.Object(objn).enable = True
			Else
				SCREEN.Object(objn).enable = False
			End If
		Next
		UP.Enable = False
		DOWN.Enable = True
	Case 2
		For ii = 0 To 17
			objn = btn&ii
			If Left(desc2(ii),1) = "-" Then
				desc = Mid(desc2(ii),2)
			Else
				desc = desc2(ii)
			End If

			SCREEN.Object(objn).text = desc
			If Trim(desc) <> "" And Left(desc2(ii),1) <> "-" Then
				SCREEN.Object(objn).enable = True
			Else
				SCREEN.Object(objn).enable = False
			End If
		Next
		UP.Enable = True
		DOWN.Enable = False
	End Select
	BUTTON0.SetFocus
End Sub

Sub Set_obj(desc)
	Dim Objn, btn, objnx

	GUIDE.Text = ""
	Select Case desc
	Case "기본정보" : OBJn = "IB871110"
	Case "예수금"   : OBJn = "IB871120"
	Case "추천종목" : OBJn = "IB871130"
	Case "주식잔고" : OBJn = "IB871140"
	Case "금상잔고" : OBJn = "IB871150"
	Case "당일반대" : OBJn = "IB871160"
	Case "익일반대" : OBJn = "IB871170"
	Case "주식체결" : OBJn = "IB871180"
	Case "예탁자산" : OBJn = "IB871190"
	Case "배당권리" : OBJn = "IB8711A0"
	Case "유상권리" : OBJn = "IB8711B0"
	Case "대출만기" : OBJn = "IB8711C0"
	Case "고객찾기" : OBJn = "IB8711D0"
	Case "입출금고" : OBJn = "IB8711E0"
	Case "기념일자" : OBJn = "IB8711F0"
	Case "미수발생" : OBJn = "IB8711G0"
'	Case "상품만기" : OBJn = "IB8711H0" '다운 버튼 클릭시 화면에 나오지 않게 하기위해 일시 변경

	Case "상품만기" : OBJn = "IB8711S0" '파생예탁 화면을 삽입. 상품만기화면을 사용할 시에 위의 주석을
										'삭제하고 사용할 것.
	Case "상담일지" : OBJn = "IB8711I0"
	Case "매매상위" : OBJn = "IB8711J0"
	Case "사원영업" : OBJn = "IB8711K0"
	Case "예약주문" : OBJn = "IB8711L0"
	Case "이자수익" : OBJn = "IB8711M0"
	Case "영업계좌" : OBJn = "IB8711N0"
	Case "파생위험" : OBJn = "IB8711O0"
	Case "파생추증" : OBJn = "IB8711P0"
	Case "파생장추" : OBJn = "IB8711T0"
	Case "파생약정" : OBJn = "IB8711Q0"
	Case "파생결제" : OBJn = "IB8711R0"
	Case "파생예탁" : OBJn = "IB8711S0"
	Case Else
		Exit Sub
	End Select

	btn = "BUTTON"
	For ii = 0 To 17
		objnx = btn&ii
		If SCREEN.Object(objnx).text = desc Then
			SCREEN.Object(objnx).text = "4BTN_DN.BMP"
		Else
			SCREEN.Object(objnx).text = "4BTN.BMP"
		End If
	Next
	OBJ.SetObject OBJn
	zEmpNo.Data = SYSTEM.UserID
	SCREEN.OBJect("obj.zEmpNo").data = zEmpNo.Data
	SCREEN.OBJect("obj.zEmpPwd").data = zEmpPwd.Data
	If Trim(SCREEN.OBJect("obj.zEmpNo").data) = "" Then
		SCREEN.OBJect("obj.zEmpNo").Setfocus
	Else
		SCREEN.OBJect("obj.zEmpPwd").Setfocus
	End If
	If Trim(zEmpNo.data) <> "" And Trim(zEmpPwd.data) <> "" Then
		OBJ.Proc "send_f", ""
	End If
End Sub

