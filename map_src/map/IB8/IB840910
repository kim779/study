'== 조회
Sub send_f()
	If Trim(lAppyQty.Data) <= 0 Or Trim(lAppyQty.Data) = "" Then
		alert_msg("청약수량을 입력하세요")
		lAppyQty.SetFocus
		Exit Sub
	End If

	If 	Trim(lAplLoanAmt.Data) <= 0 Or Trim(lAplLoanAmt.Data) = "" Then
		alert_msg("청약대출금을 입력하세요")
		Exit Sub
	End If

	If cash.Checked = True Then
		If Trim(lInAmt.Data) <= 0 Or Trim(lInAmt.Data) = "" Then
			alert_msg("입금액을 입력하세요")
			lInAmt.SetFocus
			Exit Sub
		End If

		If Trim(lChckMnyinAmt.Data) <= 0 Or Trim(lChckMnyinAmt.Data) = "" Then
			alert_msg("수표입금액을 입력하세요")
			lChckMnyinAmt.SetFocus
			Exit Sub
		End If

		If Len(Trim(zCDDRmnno_1.Data)) < 6 Then
			alert_msg("주민번호를 올바르게 입력하세요")
			zCDDRmnno_1.SetFocus
			Exit Sub
		End If

		If Len(Trim(zCDDRmnno_2.Data)) < 7 Then
			alert_msg("주민번호를 올바르게 입력하세요")
			zCDDRmnno_2.SetFocus
			Exit Sub
		End If
	End If

	Dim hnam
	If jusik.Checked = True Then
		hnam = Mid(SCREEN.Object("obj.1022").Data, 2)
	Else
		hnam = chae_nm.Data
	End If

	dmsg = "code" & vbTab & zAppyGrpCode.Text & vbLf &_
		   "acno" & vbTab & AN1A.Data & vbLf &_
		   "acnm" & vbTab & AN1A.Name & vbLf &_
		   "hnam" & vbTab & hnam & vbLf &_
		   "capa" & vbTab & lAppyQty.Data & vbLf &_
	       "loan_money" & vbTab & lAplLoanAmt.Data & vbLf &_
		   "deposit" & vbTab & lInAmt.Data & vbLf &_
		   "check_deposit" & vbTab & lChckMnyinAmt.Data & vbLf &_
		   "total_deposit" & vbTab & total_money.Data & vbLf &_
		   "id" & vbTab & zCDDRmnno_1.Data & zCDDRmnno_2.Data & vbLf


			SCREEN.CreateWindow 2, "IB84091A /p5 /d", dmsg

			If SYSTEM.Pop("confirm") <> "OK" Then
				Exit Sub
			Else
				LEDGER.Fkey = "C"
				SCREEN.Send 0
			End If
End Sub

