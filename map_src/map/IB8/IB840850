'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2

	ANCM.Data = AN1A.Name
	h_acnm.Data = AN1A.Name
	'zpwd.Clear
	zpwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If

	'Call send_f()
	SCREEN.Object("main.obj3").send
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
'	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub Order()

	If jusik.Checked = True Then
		nm = Mid(SCREEN.Object("OBJ.1022").Data,2)
	ElseIf chae.Checked = True Then
		nm = chae_nm.Data
	End If

	dmsg = "o_acno" & vbTab & AN1A.Data & vbLf &_
	   "o_acnm" & vbTab & ANCM.Data & vbLf &_
	   "o_hnam" & vbTab & nm & vbLf &_
	   "o_num" & vbTab & lAppyNo.Data & vbLf

		SCREEN.CreateWindow 2, "IB84085A /p5 /d", dmsg

	If SYSTEM.Pop("resv_cncl_order") <> "OK" Then
		Exit Sub
	Else
		SCREEN.OnSend = True
	End If
End Sub

