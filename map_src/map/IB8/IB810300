RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	Call acct_set()
	nextgbn.Data = 0
	LEDGER.Fkey = "C"
	GRID0.SetDataPosition 0
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	nextgbn.Data = nextgbn.Data + 1
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

'--계좌번호, 계좌명 세팅
Sub acct_set()
	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
OBJ_acct.Send

LEDGER.Rcnt = "0008"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

zIn.Data = "00001"
zAcntNo.Data = Trim(CMB_ACCT.Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	CMB_ACCT.SetFocus
	Exit Sub
End If

If Len(Trim(zPwd.Data)) < 4 Then
	Call alert_msg("비밀번호를 확인하여 주십시오.")
	zPwd.SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zStrDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zEndDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 Then
	If Len(Trim(zPwd.Data)) > 3 Then
		Call send_f()
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim data
data = "a" & vbTab & zAcntNo.Data & vbTab  & _
	   "b" & vbTab & zPwd.Data & vbTab & _
	   "c" & vbTab & zStrDt.Data & vbTab & _
	   "d" & vbTab & zEndDt.Data & vbTab & _
	   "e" & vbTab & ACNM.Data & vbTab & _
	   "p" & vbTab & nextgbn.Data

SCREEN.CreateWindow 3, "IB0000A3 /t/d/p5/S", _
		"WxReport06" & vbTab & data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CMB_ACCT)
_AW_ONCHANGE_AW_
Call acct_set()
GRID0.Clear
zPwd.Clear
zPwd.Setfocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



