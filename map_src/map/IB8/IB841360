RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0009"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("main.GUIDE").Text = ""

If CheckInput(SCREEN.Object("parent.AN1A"), SCREEN.Object("parent.zPwd")) = True Then
	zAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)
	zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)
	zRgptnCode.Data = "24"
	zOrdStrDt.Data = Trim(SCREEN.Object("parent.zOrdStrDt").Data)
	zOrdEndDt.Data = Trim(SCREEN.Object("parent.zOrdEndDt").Data)
	SCREEN.OnSend = True
Else
	SCREEN.ClearAll 0, 2
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim ii, tmpCode

	For ii = 1 To GRID0.Rows
		tmpCode = Trim(GRID0.GetGridCell(ii, 1))

		If tmpCode = "" Then
			Exit Sub
		End If

		If Len(tmpCode) = 7 And (Left(tmpCode, 1) = "A" Or Left(tmpCode, 1) = "J" Or Left(tmpCode, 1) = "Q") Then
			tmpCode = Mid(tmpCode, 2, 6)

			GRID0.SetGridCell ii, 1, tmpCode
		End If
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.Data = Trim(GRID0.GetGridCell(GRID0.Row, 1))

	If Len(Trim(S1301.DATA)) <> 6 Then
	    Exit Sub
	End If

	S1301.Trigger "1301", True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zOrdStrDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zOrdEndDt)
_AW_ENDSCRIPT_AW_


}



