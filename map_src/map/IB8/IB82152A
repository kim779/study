RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	'SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub


Sub hide()
	PANEL4.Visible   = False
	PANEL8.Visible   = False
	PANEL9.Visible   = False
	OUTPUT7.Visible  = False
	BscMny.Visible   = False
	InvstrTp.Visible = False
End Sub

Sub show()
	PANEL4.Visible   = True
	PANEL8.Visible   = True
	PANEL9.Visible   = True
	OUTPUT7.Visible  = True
	BscMny.Visible   = True
	InvstrTp.Visible = True
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

an.Data = Trim(SCREEN.Object("parent.AN98").Data)
pwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

'MsgBox "Mid(an.Data, 4, 2):" & Mid(an.Data, 4, 2)

If Mid(an.Data, 4, 2) = "15" Then
	hide()
Else
	show()
End If


If CheckInput(an, pwd) = True Then
	SCREEN.OnSend True
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Or LEDGER.Ecod = "1001"Then
	SCREEN.ClearAll 1,2
	If SCREEN.Object("main.sect").Data = "1" Then
		SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN99").name
	Else
		SCREEN.Object("main.ACNM").Data = SCREEN.Object("main.AN98").name
	End If
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus
End If

Select Case Trim(OUTPUT2.data)
	Case "XX"
		OUTPUT7.Data = "HOT Plus (HTS/WTS 이용시 0.1%)"
	Case "BB"
		OUTPUT7.Data = "HOT save (HTS/WTS 이용시 0.0125% + 500원)"
	Case "FA"
		OUTPUT7.Data = "패밀리 수수료 A (HTS/WTS 이용시 0.05%)"
	Case "FB"
		OUTPUT7.Data = "패밀리 수수료 B (HTS/WTS 이용시 0.0125%)"
	Case Else
		OUTPUT7.Data = OUTPUT2.data
End Select

_AW_ONENDSUB_AW_
