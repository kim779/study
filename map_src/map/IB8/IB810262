		Call alert_msg(Trim(LEDGER.Emsg))
	End If

	Exit Sub
End If

If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Dim ii, tel1, tel2, tel3, comTel1, comTel2, comTel3

	For ii = 1 To GRID0.Rows
		tel1 = Trim(GRID0.GetGridCell(ii, 31))
		tel2 = Trim(GRID0.GetGridCell(ii, 32))
		tel3 = Trim(GRID0.GetGridCell(ii, 33))
		comTel1 = Trim(GRID0.GetGridCell(ii, 34))
		comTel2 = Trim(GRID0.GetGridCell(ii, 35))
		comTel3 = Trim(GRID0.GetGridCell(ii, 36))

		GRID0.SetGridCell ii, 37, tel1 & "-" & tel2 & "-" & tel3
		GRID0.SetGridCell ii, 38, comTel1 & "-" & comTel2 & "-" & comTel3

	Next

	Call guide_msg(Trim(LEDGER.Emsg))
End If

