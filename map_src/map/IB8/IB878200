RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim startFlag
startFlag = 1

'== 계좌명, 비밀번호 설정
Sub Set_account(acntCtrl)
	If acntCtrl.Visible = True Then
		SCREEN.ClearAll 0, 2
		obj.ClearAll 2
		GUIDE.Text = ""
		zPwd.Clear

		startFlag = 2

		If Len(Trim(acntCtrl.Data)) = 11 Then
			ACNM.Data = acntCtrl.Name
			zPwd.Data = acntCtrl.Password

			If SYSTEM.ConnectBy = 0 Then
				If Trim(zPwd.Data) = "" Then
					zPwd.Data = "9999"
				End If
			End If

			'Call selSubTab()
		Else
			acntCtrl.SetFocus
			Exit Sub
		End If
	End If
End Sub


Sub send_f()
	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	SCREEN.Proc "OBJECT0.send_f", "" '해당계좌 관리자와 로그인한 사번이 일치 여부

End Sub

Function P_pswdConfirm(accn, pswd, msg)
	Dim ret, sdata

	P_pswdConfirm = False

	SYSTEM.Trace "P_pswdConfirm = False"
	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(accn)) <> 11 Then Exit Function
		If Len(Trim(pswd)) > 8 Then Exit Function
		SYSTEM.Trace "P_pswdConfirm = 1 "
		msg = ""
		sdata = accn&pswd
		ret = SCREEN.ServiceEx("pibopswd", accn&pswd, Len(sdata), 0, 600000)
		If Left(ret,1) <> "1" Then
			msg = Mid(ret,2,99)
			If Trim(msg) = "" Then
				msg = "대기 시간 초과입니다. 결과를 꼭 확인 바랍니다."
			End If
			If InStr(msg, "3669") > 0 Then
				SCREEN.Object("main.GUIDE").text = "비밀번호 오류입니다."
			End If
			Exit Function
		End If
	End If
	SYSTEM.Trace "P_pswdConfirm = True "
	P_pswdConfirm = True
End Function

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'직원/고객에 따른 비밀번호 컨트롤 설정
Call Check_LoginType(zPwd)
AN98.Setfocus

'Call selMainTab()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	SCREEN.Object("obj.Grid0").Clear
	Dim ret, msg
		If Trim(AN98.Data) = "" Or Len(Trim(AN98.Data)) < 11 Then
			SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
			Exit Sub
		End If
		If Trim(zPwd.Data) = "" Or Len(Trim(zPwd.Data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
			SCREEN.Object("main.zPwd").SetFocus
			Exit Sub
		End If
	
	ret = P_pswdConfirm(AN98.Data, zPwd.Data, msg)
	If ret <> True Then
		Exit Sub
	Else
		send_f()
	End If

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Dim ret, msg
	SCREEN.Object("obj.Grid0").Clear
	If Trim(AN98.Data) = "" Or Len(Trim(AN98.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Or Len(Trim(zPwd.Data)) < 4 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
		SCREEN.Object("main.zPwd").SetFocus
		Exit Sub
	End If

	ret = P_pswdConfirm(AN98.Data, zPwd.Data, msg)
	If ret <> True Then
		Exit Sub
	Else
		send_f()
	End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN98)
_AW_ONCHANGE_AW_
Call Set_account(AN98)
_AW_ONENDSUB_AW_
