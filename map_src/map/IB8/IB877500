_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)
End Sub

_AW_ONSTART_AW_
S11301.Data = ""
Call send_f()

