RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gubn

Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub chkTransPwd()
	gubn = "chkTrans"
	Call send_f()
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

Dim inptAccn

zIn.Data = "00001"
inptAccn = Trim(SCREEN.Object("parent.CMB_ACCT").Data)
zAcntNo.Data = Left(inptAccn, 3) & "00" & Right(inptAccn, 6)
zInptPwd.Data = Trim(SCREEN.Object("parent.sPwd").Data)

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If Trim(zAvalYn.Data) = "1" Then
		'timer를 건 이유는 공인인증서 비밀번호가 틀렸을 경우
		'응답을 받기 위함임.

'		If SCREEN.Object("main.UTAB0").ID = 1 Then
'			SCREEN.Object("parent.sPwd").Data = Trim(zInptPwd.Data)
'		End If

		SCREEN.SetTimer 4, False
	Else
		Dim msg, ErrCnt
		msg = ""
		ErrCnt = 5 - CLng(zErrCnt.Data) - 1

		If ErrCnt >= 3 Then
			msg = "보안비밀번호 오류입니다. (5회중 " & ErrCnt & "회 남았습니다.)"
		ElseIf ErrCnt >=1 Then		'보안비밀번호 3회 이상 오류시 메세지. 3회 이상이므로 if 조건이 3보다 크거나 같아야 함.
			msg = "보안비밀번호를 " & CLng(zErrCnt.Data) + 1 & "회 잘못입력하셨습니다. 5회이상 오류시 사용정지 됩니다."
		Else
			msg = "보안비밀번호 연속오류허용 횟수를 초과하였습니다. 고객만족팀(1588-0030)로 본인확인하여 주십시오."
		End If

		Call alert_msg(msg)
		Call guide_msg(msg)
		SCREEN.Object("parent.sPwd").SetFocus
	End If
Else
	Call alert_msg(Trim(LEDGER.Emsg))
	Call guide_msg(Trim(LEDGER.Emsg))
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
zInptPwd.Clear

SCREEN.Object("parent.sPwd").Data = Trim(zInptPwd.Data)
zInptPwd.Clear
SCREEN.Proc "parent.send", ""
SCREEN.Proc "parent.OTP_hide", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zInptPwd)
_AW_ONKEYCHANGE_AW_
'== 보안카드번호 입력 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Len(Trim(zInptPwd.Data)) < 4 Then
		zInptPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
	'SCREEN.Proc "parent.Confirm_Send", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zAcntNm)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zAvalYn)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPdptnCode)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPrdtDtlCode)
