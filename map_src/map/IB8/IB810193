_AW_ONDECLARE_AW_
Sub Send_F()
	Call startinit()
	LEDGER.Fkey = "C"
	'SCREEN.Send 0
	GUIDE.Text = LEDGER.Emsg
End Sub

Sub startinit
	S1.Data = "00001"
	S2.Data = Trim(SCREEN.Object("parent.chkN").data)
	S3.Data = Trim(SCREEN.Object("parent.Otpauth").data)
End Sub

_AW_ONSEND_AW_
Call Send_F()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(S7.Data) <> "0000" Then
	MsgBox LEDGER.Emsg,0,"IBK투자증권"
Else
	If SCREEN.Object("parent.NauthY").data = "1" Then
		SCREEN.Proc "parent.NYChange_1",""
	Else
		If Trim(SCREEN.Object("Main.mapname").Data) = "IB283200" Then	' 연금저축계좌 대체용 ONLY
			SYSTEM.Trigger "SetAuth", "03", "IB283200"
		Else
			If SYSTEM.pop("bond_IB6610A4") = "OK" Then
				SYSTEM.Trigger "SetAuth", "", "IB6610A4"
				SYSTEM.Trigger "SetAuth", "", "IB620209"
			Else
				SYSTEM.Trigger "SetAuth", "03", "IB810100"
			End If
		End If

		SCREEN.CloseWindow
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call Send_F()
