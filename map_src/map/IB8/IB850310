Sub Set_account()
	SCREEN.ClearAll 0, 2
	GRID0.Clear

	If SCREEN.Object("main.UTAB1").ID <> 7 Then
		SCREEN.Object("main.obj1").ClearAll 2
	End If

	If Len(Trim(AN19.Data)) = 11 Then
		ACNM.Data = Trim(AN19.Name)
		zPwd.Data = Trim(AN19.Password)
	Else
		AN19.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
