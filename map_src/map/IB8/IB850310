Sub applLoan()
    '여신거래 안심차단 로직추가
    SYSTEM.Trace "applLoan_zObjYn:"&zObjYn.Data
    If zObjYn.Data = "Y" Then
       Call popup()
       Exit Sub
    End If

    SYSTEM.Trace "appLoanconfirm start"

	SYSTEM.Push "applyLoanConfirm8503", ""

    acntno.Data = Trim(AN19.Data) + "  " + Trim(ACNM.Data)

	If chkLoanCnt < 1 Then
		Call alert_msg("대출실행금액을 확인하여 주십시오.")
		loan_btn.SetFocus
		Exit Sub
	End If

	If chkLoanCnt > 8 Then
		Call alert_msg("한 번에 8개의 종목만 대출 실행 가능합니다.")
		loan_btn.SetFocus
		Exit Sub
	End If

	zLoanPrsl.Data = chkLoanCnt
	GRID1.SetRows zLoanPrsl.Data

	If chkLoanAmt = "OK" Then
		Dim dmsg, ii, jmNm, loanAbleAmt, loanAmt, record, matrix
		dmsg = ""
		record = ""
		matrix = ""

		For ii = 1 To GRID1.Rows
			jmNm = Trim(GRID1.GetGridCell(ii, 9))
			loanAbleAmt = Trim(GRID1.GetGridCell(ii, 10))
			loanAmt = Trim(GRID1.GetGridCell(ii, 5))

			record = jmNm & "|" & loanAbleAmt & "|" & loanAmt
			matrix = matrix & "#" & record
		Next

		dmsg = "s_data" & vbTab & matrix & vbLf

        'PUSH
        SYSTEM.Trace "acntno.Data:"&acntno.Data
        SYSTEM.Push "applyLoanConfirm8503_acntno", Mid(Trim(AN19.Data),1,3) & "-"& Mid(Trim(AN19.Data),4,2) & "-" & Mid(Trim(AN19.Data),6,6) & "  " & Trim(ACNM.Data)
		SCREEN.CreateWindow 2, "IB85031A /t /p5 /d", dmsg

		If Trim(SYSTEM.Pop("applyLoanConfirm8503")) = "OK" Then
			Call send_o()
		End If

		SYSTEM.Push "applyLoanConfirm8503", ""
	ElseIf chkLoanAmt = "NotNumeric" Then
		Call alert_msg("대출실행금액은 정수만 입력하여 주십시오.")
		loan_btn.SetFocus
		Exit Sub
	ElseIf chkLoanAmt = "OverAmt" Then
		Call alert_msg("대출실행금액이 대출가능금액을 초과합니다.")
		loan_btn.SetFocus
		Exit Sub
	ElseIf chkLoanAmt = "NotZero" Then
		Call alert_msg("대출실행금액은 1만원 단위로 입력하여 주십시오.")
		loan_btn.SetFocus
		Exit Sub
	End If
End Sub

Function chkLoanCnt()
	Dim loanAmt, ii, cnt
	chkLoanCnt = 0

	For ii = 1 To GRID0.Rows
		loanAmt = Trim(GRID0.GetGridCell(ii, 15))

		If loanAmt <> "" Then
			If Is_numeric(loanAmt) = True Then
				cnt = cnt + 1
			End If
		End If
	Next

	chkLoanCnt = cnt
End Function

Function chkLoanAmt()
	chkLoanAmt = ""
	GRID1.Clear

	Dim ii, grd1Pos, loanAmt, firstChar, jmcd, jmNm, bondBuyDt, bondTaxGubn, newLoanAmt, loanGrade, loanDueDt, loanAbleAmt, FcurrMktCode

	grd1Pos = 1

	For ii = 1 To GRID0.Rows
		loanAmt = Trim(GRID0.GetGridCell(ii, 15))

		If loanAmt <> "" Then
			If is_numeric(loanAmt) = True Then
				firstChar = Left(loanAmt, 1)

				If AscW(firstChar) < 48 Or AscW(firstChar) > 57 Then
					chkLoanAmt = "NotNumeric"
					Exit Function
				End If

				loanAbleAmt = Trim(GRID0.GetGridCell(ii, 10))

				If Trim(loanAbleAmt) = "" Then
					loanAbleAmt = 0
				End If

'				MsgBox "loanAbleAmt & loanAmt = " & loanAbleAmt & "   ^^^   " & loanAmt
				If CDbl(loanAbleAmt) < CDbl(loanAmt) Then
					chkLoanAmt = "OverAmt"
					Exit Function
				End If

				If (loanAmt Mod 10000) <> 0 Then
					chkLoanAmt = "NotZero"
					Exit Function
				End If

				newLoanAmt = String(15 - Len(Trim(loanAmt)), "0") & loanAmt

				jmcd = Trim(GRID0.GetGridCell(ii, 1))
				jmNm = Trim(GRID0.GetGridCell(ii, 3))
				bondBuyDt = Trim(GRID0.GetGridCell(ii, 4))
				bondTaxGubn = Trim(GRID0.GetGridCell(ii, 5))
				loanGrade = Trim(GRID0.GetGridCell(ii, 17))
				loanDueDt = Trim(GRID0.GetGridCell(ii, 18))
				FcurrMktCode = Trim(GRID0.GetGridCell(ii,20))

				GRID1.SetGridCell grd1Pos, 1, jmcd
				GRID1.SetGridCell grd1Pos, 2, bondBuyDt
				GRID1.SetGridCell grd1Pos, 3, bondTaxGubn
				GRID1.SetGridCell grd1Pos, 4, "+"
				GRID1.SetGridCell grd1Pos, 5, newLoanAmt
				GRID1.SetGridCell grd1Pos, 6, "+0000000000000000"
				GRID1.SetGridCell grd1Pos, 7, loanGrade
				GRID1.SetGridCell grd1Pos, 8, loanDueDt
				GRID1.SetGridCell grd1Pos, 9, jmNm
				GRID1.SetGridCell grd1Pos, 10, loanAbleAmt
				GRID1.SetGridCell grd1Pos, 11, FcurrMktCode

				grd1Pos = grd1Pos + 1
			End If
		End If
	Next

	chkLoanAmt = "OK"
End Function
