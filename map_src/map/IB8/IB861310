_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.CMB_ACCT").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.CMB_ACCT").SetFocus
	Exit Sub
End If

zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

If Len(Trim(zAcntNo.Data)) < 4 Then
	Call alert_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If ecod = "3669" Then
	SCREEN.ClearAll 0, 2
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
ElseIf ecod = "3130" Then
	'Call alert_msg(Trim(LEDGER.Emsg))
	MsgBox(Trim(BnkRspnsCode.Data) & " " & Trim(BnkMsgCnts.Data)), , "은행메세지"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	send_btn.SetFocus
	Call send_f()
End If
