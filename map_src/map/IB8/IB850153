Dim start
start = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2

	If Trim(accn.Data) = Trim(AN1A.Data) Then
		ACNM.Data = AN1A.Name
		zPwd.Data = AN1A.Password
	Else
		If start = 0 Then
			AN1A.Data = accn.Data
			ACNM.Data = accnNm.Data
		Else
			ACNM.Data = AN1A.Name
			zPwd.Data = AN1A.Password

			If SYSTEM.ConnectBy = 1 Then
				zPwd.Clear
			End If

			S1301.Clear
			obj0.Send
			zLoanDt.Data = getCurrDay()
			RADIO1.Checked = True
			lLoanQty.Clear
		End If
	End If

	If start > 0 Then
			S1301.Clear
			obj0.Send
			zLoanDt.Data = getCurrDay()
			RADIO1.Checked = True
			lLoanQty.Clear
	End If

	start = start + 1

	LABEL6.Visible = True
	lLoanQty.Visible = True
	LABEL2.Visible = False
	lAbleAmt.Visible = False
	PANEL3.Visible = False
	lRfundAbleQty.Visible = False
	lAbleAmt.Clear

	lAbleAmt.Clear
	selection.Data = 3


	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	S1301.SetFocus
'	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

