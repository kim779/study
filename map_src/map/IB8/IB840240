_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2

	If SCREEN.GetMapName(1) = "IB872500" Then
		ACNM.Data = Trim(AN1A.Name)
	End If

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'D-2 날짜 구하기
Sub setDate()
	Dim yy, mm, dd, cday, MyWeek
	cday = DateAdd("d", -2, Date)
	MyWeek = Weekday(cday)

	If MyWeek = 1 Then
		cday = DateAdd("d", -2 , cday)
	ElseIf MyWeek = 7 Then
		cday= DateAdd("d", -1 , cday)
	End If

	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)

	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd

	zAppySrtDt.Data = cday
End Sub


Sub SetScreen()
	Dim IsBool

	If SCREEN.GetMapName(1) = "IB840200" Then
		IsBool = False
		label_AppySrtDt.SetRect 3, 3, 63, 23
		zAppySrtDt.SetRect 69, 3, 154, 23
	Else
		IsBool = True
		label_AppySrtDt.SetRect 407, 3, 467, 23
		zAppySrtDt.SetRect 470, 3, 556, 23
	End If

	LABEL3.Visible IsBool
	AN1A.Visible IsBool
	ACNM.Visible IsBool
	LABEL2.Visible IsBool
	zpwd.Visible IsBool
End Sub


Sub Set_account()
	If SCREEN.GetMapName(1) = "IB872500" Then
		SCREEN.ClearAll 0, 2

		If Len(Trim(AN1A.Data)) = 11 Then
			ACNM.Data = Trim(AN1A.Name)
			zpwd.Data = Trim(AN1A.Password)

			If Len(Trim(zpwd.Data)) < 4 Then
				zpwd.SetFocus
				Exit Sub
			End If

			Call send_f()
		Else
			AN1A.SetFocus
			Exit Sub
		End If
	End If
End Sub

Sub view_highlight()
	' Highlight
	SCREEN.SetTimerX 1, 3, False
End Sub

