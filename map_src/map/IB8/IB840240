		Call send_c()
	Else
		Dim i, str, jmNm, ii
	End If

	If SCREEN.GetMapName(1) = "IB840200" Then
			' 청약번호 검증용 Data Clear 공모주청약취소 MAP
			If SCREEN.Object("Main.UTAB1").Index = 1 Then
				SCREEN.Object("Main.obj1.GRID0").Clear
			End If
	End If

		For i = GRID0.Rows To 1 Step -1

			' 종목명
			jmNm = Trim(GRID0.GetGridCell(i, 5))

			' ELS 제외
			If InStr(jmNm, "ELS") > 0 Then
				GRID0.RemoveRow i - 1
			Else
				str = GRID0.GetGridCell(i, 4)	'종목번호

				If Left(str, 1) = "A" Then		' Short Code로 변환 :: A005930 -> 005930
					GRID0.SetGridCell i, 4, Mid(str, 2, Len(str))
				End If

				' 청약번호 :: 0 제거
				cNo = Trim(GRID0.GetGridCell(i, 3))
				If Trim(cNo) <> "" Then
					If (IsNumeric(Trim(cNo))) = True Then
						GRID0.SetGridCell i, 3, CLng(cNo)
					End If
				End If

				' 청약상태 :: 공백제거
				GRID0.SetGridCell i, 20, Trim(GRID0.GetGridCell(i, 20))
			End If
		Next

	If SCREEN.GetMapName(1) = "IB840200" Then
		' 청약번호 검증용 Data Insert to 공모주청약취소 MAP
		If SCREEN.Object("Main.UTAB1").Index = 1 Then

			For ii = 1 To GRID0.Rows
				' 열을 만들자
				SCREEN.Object("Main.obj1.GRID0").InsertRow ii

				' 종목번호
				SCREEN.Object("Main.obj1.GRID0").SetGridCell ii, 1, Trim(GRID0.GetGridCell(ii, 4))

				' 청약번호
				SCREEN.Object("Main.obj1.GRID0").SetGridCell ii, 2, Trim(GRID0.GetGridCell(ii, 3))
			Next
		End If

		SCREEN.Proc "main.obj1.Set_focus", ""
	End If
Else

End If

