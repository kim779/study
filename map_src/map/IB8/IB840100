'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN1A.Name
	If SYSTEM.ConnectBy = 1 Then
		zPwd.Data = AN1A.Password
	End If
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

Sub send_f()
	If RADIO0.Checked = True Then
		SCREEN.ClearAll 0, 2
		ANCM.Data = AN1A.Name
		gridPos = 1

		LEDGER.Fkey = "C"
		SCREEN.Send 0
	Else
		SCREEN.Proc "obj_content.send_f", ""
	End If
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

