_AW_ONDECLARE_AW_
Sub send_sise_all(gubn)

	Dim code, fogb, rsymb, accnNm
	code = Left(ed_cfocod.Data, 1)
	If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
		'fogb = 101
		If Mid(ed_cfocod.Data, 2, 1) = "0" Then
			rsymb = "30301"
			OBJ_sise.SetObject("IB883010")
		Else
			rsymb = "100301"
			OBJ_sise.SetObject("IB883011")
		End If

	ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C" Then
		'fogb = 102
		If Mid(ed_cfocod.Data, 2, 1) = "0" Or Mid(ed_cfocod.Data, 2, 1) = "A" Then
			rsymb = "40301"
			OBJ_sise.SetObject("IB883015")
		Else
			rsymb = "101301"
			OBJ_sise.SetObject("IB883012")
		End If

	End If

	HNAM.Data = SCREEN.GetName (115, ed_cfocod.Data, 0)
	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = HNAM.data

	'CX_OptionEx에 바뀐 종목 세팅
	SCREEN.Object("OBJ_order.OBJ_odr.Control0").CurCode  = ed_cfocod.Data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_cfocod").data = ed_cfocod.data
		SCREEN.IgnoreChange False
	End If

	Call tab_info_change()

	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 2, 2
		ACNM.Data = Trim(SCREEN.Object("OBJ_order.AN20").Name)
		OBJ_sise.Send
		'OBJ_info.Send
		Exit Sub
	Else
		ed_cfocod.Trigger "ed_cfocod", True
		ed_cfocod.Trigger rsymb, True
		ed_cfocod.Trigger rsymb, False
		SYSTEM.SetHistory rsymb, ed_cfocod.Data
		SYSTEM.SetHistory "ed_cfocod", ed_cfocod.Data
	End If

	OBJ_sise.Send
	SCREEN.Proc "OBJ_order.AddHistory", ed_cfocod.Data
	'OBJ_info.Send

End Sub

Sub OBJ_account_send()
'	MsgBox "Account Send"
End Sub

'CX_OptionEx에서 사용
Sub SetOPCode( code, handle)
	Dim hKey

	hKey = SCREEN.Object("OBJ_order.OBJ_odr.Control0").MapHandle

'	SYSTEM.Trace "handle : " & handle & " hKey :" & hKey
	If Trim(handle) <> Trim(hKey) Then
		Exit Sub
	End If
	ed_cfocod.data = code
	Call send_sise_all("main")
End Sub

