	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		If chk.Data = 1 Then
			chk.Data = 0
			Call find_YJAcct()
		ElseIf chk.Data = 2 Then
			chk.Data = 0
			Call Setting_acct()
		End If
	End If
	SYSTEM.Trace "810121 : No Error Code"
Else
	SYSTEM.Trace "Mapmame : " & SCREEN.GetMapName(0)
	SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)
	If Trim(LEDGER.Ecod) = "3024" Then
	Else
		Call alert_msg(Trim(LEDGER.Emsg))
	End If
End If



