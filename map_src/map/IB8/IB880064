_AW_ONDECLARE_AW_
Function LengthFormat(data, Length)
	Dim ii

	For ii=1 To Length-Len(data)
		data = "0"& data
	Next
	LengthFormat = data
End Function

Sub Change_query()
	Dim grp_no, grp_name
	grp_no = SCREEN.Object("Object0.Grid0").GetGridCell(COMBO0.Index, 1)
	grp_name = SCREEN.Object("Object0.Grid0").GetGridCell(COMBO0.Index, 2)
	SCREEN.Object("obj_query.grp_no").data = grp_no
	SCREEN.Object("obj_query.grp_name").data = grp_name
	SCREEN.Object("obj_query.UserID").data = edit_id.Data
	obj_query.Send
End Sub

_AW_ONSTART_AW_
  edit_id.Data = LOGIN.User

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Dim grp_no, grp_name, ii, jj
grp_no = SCREEN.Object("Object0.Grid0").GetGridCell(COMBO0.Index, 1)
grp_name = SCREEN.Object("Object0.Grid0").GetGridCell(COMBO0.Index, 2)
SCREEN.Object("obj_reg.grp_no").data = grp_no
SCREEN.Object("obj_reg.grp_name").data = grp_name
SCREEN.Object("obj_reg.UserID").data = edit_id.Data
SCREEN.Object("obj_reg.Grid0").clear
For ii = 1 To GRID0.Rows
	For jj = 1 To 4
		irow = SCREEN.Object("obj_reg.Grid0").rows
		icol = (jj-1)*3+2
		'SYSTEM.Trace CStr(irow+1) & "] " & GRID0.GetGridCell(ii, icol)
		If Trim(GRID0.GetGridCell(ii, icol+1))="" Then
'			SYSTEM.Trace "irow: " & FormatNumber(SCREEN.Object("obj_reg.Grid0").rows)
			SCREEN.Object("obj_reg.ed_row").data = LengthFormat(irow,5)
			obj_reg.Send
			Exit Sub
		End If
		Call SCREEN.Object("obj_reg.Grid0").InsertRow(irow)
		Call SCREEN.Object("obj_reg.Grid0").SetGridCell(irow+1, 2, GRID0.GetGridCell(ii, icol+1))
		Call SCREEN.Object("obj_reg.Grid0").SetGridCell(irow+1, 3, GRID0.GetGridCell(ii, icol))
		Call SCREEN.Object("obj_reg.Grid0").SetGridCell(irow+1, 1, GRID0.GetGridCell(ii, icol-1))
	Next
Next
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(COMBO0)
_AW_ONCHANGE_AW_
Change_query()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


