	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
LEDGER.Rcnt = "0025"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(LEDGER.Next) = "Y" Then
	send_c()
Else
	Dim i
	For i=1 To GRID1.Rows
		If Trim(GRID1.GetGridCell(i,5)) = "09" Then
			SCREEN.CreateWindow 3, "IB831820 /t/s/p5",""
			Exit For
		End If
	Next
End If

