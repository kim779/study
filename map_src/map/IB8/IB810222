RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0146"

SCREEN.OnSend = False

zIn.Data = "00001"
IttCode.Data = Trim(SCREEN.Object("parent.KNUM").Text)
IttCode.Data = l_zeropad(IttCode)

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim brNo, brNm
brNo = Trim(GRID0.GetGridCell(1, 1))
brNm = Trim(GRID0.GetGridCell(1, 2))

If LEDGER.Next = "Y" Then
	If Trim(brNo) = "0" And Trim(brNm) = "" Then
		GRID0.RemoveRow 0
'		SCREEN.Object("main.GRID1").RemoveRow 0
	End If

	Call send_c()
Else
	If Trim(brNo) = "0" And Trim(brNm) = "" Then
		GRID0.RemoveRow 0
'		SCREEN.Object("main.GRID1").RemoveRow 0
	End If
End If



For ii=1 To GRID0.Rows

	SCREEN.Object("main.GRID1").InsertRow -1

	SCREEN.Object("main.GRID1").SetGridCell ii-1, 1, GRID0.GetGridCell(ii,1)
	SCREEN.Object("main.GRID1").SetGridCell ii-1, 2, GRID0.GetGridCell(ii,2)
	SCREEN.Object("main.GRID1").SetGridCell ii-1, 3, GRID0.GetGridCell(ii,3)
	SCREEN.Object("main.GRID1").SetGridCell ii-1, 4, GRID0.GetGridCell(ii,4)
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
SCREEN.Object("parent.JNUM").Text = Trim(GRID0.GetGridCell(GRID0.row, 1))
SCREEN.Object("parent.JNAME").Text = Trim(GRID0.GetGridCell(GRID0.row, 2))

'--
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



