Sub confirmOrder()
	Dim dmsg

	SYSTEM.Push "cashRdemtnCancel", ""

	If (zLoanDtlClssCode.Data = "80" And Trim(S1301.Data) = "") Or (zLoanDtlClssCode.Data = "83" And Trim(zfrgncod2.Data) = "")  Then
		Call alert_msg("종목번호를 확인하여 주십시오.")
		S1301.SetFocus

	ElseIf CheckInput(AN19, zPwd) = False Then
		MsgBox "계좌비밀번호를 확인하세요.", vbInformation, "IBK투자증권"
		zPwd.SetFocus

	ElseIf Is_numeric(lCancQty.Data) = False Then
		Call alert_msg("취소수량을 확인하여 주십시오.")
		lCancQty.SetFocus
	ElseIf Trim(zLoanDt.Data) = "" Then
		Call alert_msg("대출일자를 확인하여 주십시오.")
		zLoanDt.SetFocus
	ElseIf Is_numeric(lTrxNo.Data) = False Then
		Call alert_msg("원처리번호를 확인하여 주십시오.")
		lTrxNo.SetFocus
	Else

		If zLoanDtlClssCode.Data = "80" Then
			dmsg = "o_acno" & vbTab & AN19.Data & vbLf &_
					"o_acnm" & vbTab & ACNM.Data & vbLf &_
					"o_hnam" & vbTab & Mid(SCREEN.Object("obj0.1022").Data,2) & vbLf &_
					"o_cqty" & vbTab & lCancQty.Data & vbLf &_
					"o_loan" & vbTab & zLoanDt.Data & vbLf &_
					"o_trno" & vbTab & lTrxNo.Data & vbLf
		Else
			dmsg = "o_acno" & vbTab & AN19.Data & vbLf &_
					"o_acnm" & vbTab & ACNM.Data & vbLf &_
					"o_hnam" & vbTab & IMAXCODENAME.Data & vbLf &_
					"o_cqty" & vbTab & lCancQty.Data & vbLf &_
					"o_loan" & vbTab & zLoanDt.Data & vbLf &_
					"o_trno" & vbTab & lTrxNo.Data & vbLf
		End If



		SCREEN.CreateWindow 2, "IB850345 /p5 /d", dmsg

		If SYSTEM.Pop("cashRdemtnCancel") = "OK" Then
			Call send_o()
		End If

		SYSTEM.Push "cashRdemtnCancel", ""
		selection.Data = 1
	End If
