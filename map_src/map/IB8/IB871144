_AW_ONDECLARE_AW_

'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.Object("main.guide").text = ""

zEmpNo.Data = SCREEN.Object("parent.zEmpNo").data
zEmpPwd.Data = SCREEN.Object("parent.zEmpPwd").data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	SCREEN.object("parent.who").text = "1"
	SCREEN.object("parent.next_btn").Enable = True
	SCREEN.Object("parent.next_btn").SetFocus
Else
	SCREEN.object("parent.next_btn").Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONDBLCLK_AW_
If GRID0.HitPos = 4 Then
   If GRID0.Column = 3 Then
   		GRID0.SetColumnVisible 1, True
   		GRID0.SetColumnVisible 3, False
   	End If
   If GRID0.Column = 1 Then
      	GRID0.SetColumnVisible 3, True
      	GRID0.SetColumnVisible 1, False
   End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zEmpPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


