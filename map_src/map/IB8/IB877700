RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Set_pwd(data)
'	get_passwd.Clear

	get_passwd.Data = data
End Sub

Sub Set_msg(data)
	msg.Clear
	msg.Data = data
End Sub

_AW_ONSTART_AW_
natingpad.Load

BUTTON0.Enable = False

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If SCREEN.Key = "13" Then
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim bIPC, bKillprocess

If SCREEN.CreateObject("info") Then
	bIPC = INFO.PopData("", "AXIS.INI", "PHONEPAD", "IPC")
End If

'bIPC = 1  입력 받은 비번만 메인에 직접 전송 모듈삭제는 기존방식
'bIPC = 2  입력 받은 비번 메인에 직접 전송 모듈삭제 KillProcess


If bIPC = "1" Then
	If Trim(Len(get_passwd.Data)) > 0 Then
		natingpad.SendMSgToMain(get_passwd.Data)
	End If

	If natingpad.GetStatus = 5 Then
		msg.Data = "입력 요청중입니다.완료 된 후 다시 눌러주세요."
	Else
		natingpad.ExitPhonePad
		SCREEN.CloseWindow
	End If

ElseIf bIPC = "2" Then
	If Trim(Len(get_passwd.Data)) > 0 Then
		natingpad.SendMSgToMain(get_passwd.Data)
	End If
	natingpad.KillProcess("PhonePad.exe")
	SCREEN.CloseWindow
Else
	get_passwd.Trigger "$PHONEPAD", False
	get_passwd.Trigger "$PHONEPAD", True

	If natingpad.GetStatus = 5 Then
		msg.Data = "입력 요청중입니다.완료 된 후 다시 눌러주세요."
	Else
		natingpad.ExitPhonePad
		SCREEN.CloseWindow
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
get_passwd.Clear
msg.Clear

get_passwd.Data = natingpad.Request

BUTTON0.Enable = True
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
Dim bIPC, bKillprocess

If SCREEN.CreateObject("info") Then
	bIPC = INFO.PopData("", "AXIS.INI", "PHONEPAD", "IPC")
End If

'bIPC = 1  입력 받은 비번만 메인에 직접 전송 모듈삭제는 기존방식
'bIPC = 2  입력 받은 비번 메인에 직접 전송 모듈삭제 KillProcess

If bIPC = "2" Then
	natingpad.KillProcess("PhonePad.exe")
	SCREEN.CloseWindow
Else
	msg.Data = "폰패드 종료 준비중입니다..."
	BUTTON2.Enable = False

	If natingpad.GetStatus = 5 Then
		msg.Data = "폰패드가 동작중입니다.입력중지를 먼저 실행해 주세요."
		BUTTON2.Enable = True
	Else
		msg.Data = "잠시만 기다려주세요.폰패드를 종료중입니다...."
		natingpad.ExitPhonePad

		SCREEN.CloseWindow
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
natingpad.StopRequest
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



