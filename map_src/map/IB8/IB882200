_AW_ONDECLARE_AW_
Dim flag '4601에서 넘길 계좌번호등을 셋팅하기위한 플래그

Sub send_sise_all(gubn)
	Dim code, fogb, rsymb, ACNM

	code = Mid(Trim(ed_fcod.Data), 2, 2)

	If Trim(code) = "" Then
		ed_fcod.Clear
		OBJ_sise.Send
		Exit Sub
	End If

	If (code < "10" Or  "59" < code)    And      (code < "B0" Or "ZZ" <= code)  _ 
				And   (code <  "0A" Or  "0Z" < code) And   (code <  "1A" Or  "1Z" < code) _
				And   (code <  "2A" Or  "2Z" < code) And   (code <  "3A" Or  "3Z" < code) _
				And   (code <  "4A" Or  "4Z" < code) And   (code <  "5A" Or  "5Z" < code) _
				And   (code <  "6A" Or  "6Z" < code) And   (code <  "7A" Or  "7Z" < code) _
				And   (code <  "8A" Or  "8Z" < code) And   (code <  "9A" Or  "9Z" < code) Then
		ed_fcod.Clear
		OBJ_sise.Send
		Exit Sub
	End If

	code = Left(ed_fcod.Data, 1)
	S100301.Data = ed_fcod.Data

	fogb = 130 		'GetCode : 122 GetName : 130
	rsymb = "100301"
	OBJ_sise.SetObject("IB882210")

	HNAM.Data = SCREEN.GetName (fogb, ed_fcod.Data, 0)
'	SYSTEM.Trace "send_sise_all HNAM : " & HNAM.Data

	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = HNAM.data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_fcod").data = ed_fcod.data
		SCREEN.IgnoreChange False
	End If

	ACNM = Trim(SCREEN.Object("OBJ_order.acnm").data)

	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 2, 2
		SCREEN.Object("OBJ_order.acnm").data = ACNM
		OBJ_sise.Send

		Exit Sub
	Else
		ed_fcod.Trigger "ed_fcod", True
		ed_fcod.Trigger rsymb, True
		ed_fcod.Trigger rsymb, False
		SYSTEM.SetHistory rsymb, ed_fcod.Data
		SYSTEM.SetHistory "ed_fcod", ed_fcod.Data
	End If

	OBJ_sise.Send



	SCREEN.Proc "OBJ_order.AddHistory", ed_fcod.Data
End Sub



Sub OBJ_account_send()
	OBJ_account.send
End Sub

Sub clearWrongJmcd()
	ed_fcod.Clear
	OBJ_sise.Send
End Sub

