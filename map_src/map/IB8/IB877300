_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)
End Sub

Sub SettingAdmin(data)
	Dim dataArray, gubn
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	gubn = dataArray(0)

	If gubn = "0030" Or gubn = "0040" Then
		EDIT2.Data = "1"
	ElseIf gubn = "0030" Then
		EDIT2.Data = "0"
	ElseIf gubn = "0470" Then
		EDIT2.Data = "2"
	End If

	SYSTEM.Trace "data : " & data
	'EDIT2.Data = dataArray(0)
	EDIT3.Data = dataArray(1)
	EDIT4.Data = dataArray(2)



End Sub

