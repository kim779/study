_AW_ONDECLARE_AW_
Option Explicit

Dim gubn

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub getRisk()
	gubn = "getRisk"

	Call send_f()
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
If SCREEN.GetMapName(1) <> "IB840200" Then
	Call send_f()
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

zIn.Data = "00001"

If gubn = "getRisk" Then
	zAppyIsuNo.Data = Trim(SCREEN.Object("main.jmcd").Data)
	zAppySrtDt_in.Data = Trim(SCREEN.Object("main.strtDt").Data)
End If

If Trim(zAppyIsuNo.Data) = "" Then
	Call alert_msg("청약종목을 확인하여 주십시오.")
	Exit Sub
End If

If Trim(zAppySrtDt_in.Data) = "" Then
	Call alert_msg("청약개시일을 확인하여 주십시오.")
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	Dim grade

	If Trim(OUTPUT29.Data) <> "" Then
		Select Case Trim(OUTPUT29.Data)					'투자성향 구분
			Case "1" : grade = "무위험"
			Case "2" : grade = "저위험(원금보장형)"
			Case "3" : grade = "중위험(부분보장형)"
			Case "4" : grade = "고위험(미보장형)"
			Case "5" : grade = "초고위험(미보장형)"
			Case Else : grade = ""
		End Select
	Else
		grade = ""
	End If

	If gubn = "getRisk" Then
		SCREEN.Object("main.obj1.riskStatus").Text = grade
		gubn = ""
	Else
		Dim dt
		dt = Trim(OUTPUT25.Data)

		If dt <> "" Then
			If IsNumeric(dt) = True Then
				dt = CDbl(dt) * 100
				dt = FormatNumber(dt, 0, 0, 0)
			Else
				dt = 0
			End If
		Else
			dt = 0
		End If

		OUTPUT25.Data = dt							'3그룹청약증거금율
		OUTPUT30.Data = grade

		If Trim(OUTPUT10.Data) = "0" Then			'주간사여부
			OUTPUT31.Data = "공동간사"
		ElseIf Trim(OUTPUT10.Data) = "1" Then
			OUTPUT31.Data = "주간사"
		ElseIf Trim(OUTPUT10.Data) = "2" Then
			OUTPUT31.Data = "인수사"
		ElseIf Trim(OUTPUT10.Data) = "3" Then
			OUTPUT31.Data = "청약대행사"
		End If
	End If
Else
	Call guide_msg(Trim(LEDGER.Emsg))
End If

