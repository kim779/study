RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999922) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
'mmgb = "3"	 '개편 수정(주문/취소 )
mmgb = 3
'***************************************************************************
' DESC: 사용자 입력키 Action
'***************************************************************************
Sub OnAxUserKey(key)
'	If OrdCfg.EnterOrder = True Then
'		If key = 13 Then
'			SYSTEM.UserKey	= True
'			DoOrder()
'		End If
'	End If
End Sub

'***************************************************************************
' DESC: 정정 주문전송
'***************************************************************************
Sub DoOrder()
	mmgb = "3"		'개편 수정(주문/취소 )
	Dim hogb, cPos, mdgb, dmsg, tmpCode, prc

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	tmpCode = Left(Trim(ed_cfocod.Data), 3)

	If tmpCode = "185" Or tmpCode = "186" Or tmpCode = "187" Or tmpCode = "485" Or tmpCode = "486" Or tmpCode = "487" Or _
	   tmpCode = "A85" Or tmpCode = "A86" Or tmpCode = "A87" Or tmpCode = "D85" Or tmpCode = "D86" Or tmpCode = "D87" Then
		prc = ed_jprc.Data
	Else
		prc = FormatNumber((ed_jprc.Data)/100, 2, -1, 0)
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		If r_mdgb1.Checked = True Then
			mdgb = "일부정정"
		Else
			mdgb = "전부정정"
		End If
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("Main.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_hogb" & vbTab & Mid(c_hogb.Text, 4) & vbLf &_
			"o_mdgb" & vbTab & mdgb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & prc & vbLf
		SCREEN.CreateWindow 2, "IB31417A /p5 /d", dmsg
		If SYSTEM.Pop("fo_modify_order") <> "OK" Then
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")
	Call ClearLastStat()

End Sub

'개편 수정(주문/취소 )
'***************************************************************************
' DESC: 취소 주문전송
'***************************************************************************
Sub DoOrder_Cancel()
	mmgb = "4"				''개편 수정(주문/취소 )

	Dim hogb, cPos, mdgb, dmsg

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		If r_mdgb1.Checked = True Then
			mdgb = "일부취소"
		Else
			mdgb = "전부취소"
		End If
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("Main.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_mdgb" & vbTab & mdgb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf
		SCREEN.CreateWindow 2, "IB30018A /p5 /d", dmsg
		If SYSTEM.Pop("fo_cancel_order") <> "OK" Then
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

End Sub

Sub SettHoga()
	If Left(Trim(ed_cfocod.Data), 3) = "186" Or Left(Trim(ed_cfocod.Data), 3) = "486" Or _
	   Left(Trim(ed_cfocod.Data), 3) = "A86" Or Left(Trim(ed_cfocod.Data), 3) = "D86" Then
		r_hogb0.Checked = True
		r_hogb1.Enable = False
		c_hogb.Data = "00"
		c_hogb.Enable = False
	Else
		r_hogb1.Enable = True
		c_hogb.Enable = True

		' 스프레드 종목은 탭 변경 직후 주문이 나갈 수 없게, 주문단가를 Clear
		If Left(Trim(ed_cfocod.Data), 1) = "4" Or Left(Trim(ed_cfocod.Data), 1) = "D" Then
			ed_jprc.Clear
		End If
	End If
End Sub

Sub SaveLastStat()
	SYSTEM.Push "IB8830_JPRC", "0"
