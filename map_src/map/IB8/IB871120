RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MYFILE = "userconf.ini"
Const MYMAP = "IB871120"

Dim gridPos, MidCnt, branchCnt
gridPos = 1
MidCnt = 0
branchCnt = 0

'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub sortMidAccn()
	Dim MidAccnList, ii, jj, kk, tmpMidAccn, lastAccn
	MidAccnList = Array("11", "20", "21", "30", "51", "52", "53")

	lastAccn = ""

	For ii = 0 To 6
		For jj = 1 To GRID0.Rows
			If lastAccn = Trim(GRID0.GetGridCell(jj, 1)) Then
				Exit For
			End If

			tmpMidAccn = Mid(Trim(GRID0.GetGridCell(jj, 1)), 4, 2)

			If tmpMidAccn = MidAccnList(ii) Then
				GRID0.InsertRow(GRID0.Rows - 1)

				For kk = 1 To GRID0.Rows
					GRID0.Row = jj

					If GRID0.IsColumnVisible(kk) = True Then
						GRID0.SetGridCell (GRID0.Rows - 1), kk, Trim(GRID0.GetGridCell(jj, kk))
					End If
				Next

				If lastAccn = "" Then
					lastAccn = Trim(GRID0.GetGridCell(GRID0.Rows - 1, 1))
				End If

				GRID0.RemoveRow(jj - 1)
				jj = jj - 1
			End If
		Next
	Next
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("info") Then
		Dim chkNm

	  	If branchNo.Checked = True Then
	  		chkNm = "branch"
	  	Else
	  		chkNm = "midAccn"
	  	End If

	  	INFO.PushData LOGIN.Name, MYFILE, MYMAP, "check", chkNm
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
		Dim chked

		chked = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "check"))

		If chked = "" Then
			branchNo.Checked = True
		Else
			If chked = "branch" Then
				branchNo.Checked = True
			Else
				midAccnNo.Checked = True
			End If
		End If
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0026"

Call p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
SCREEN.Object("main.GUIDE").Text = ""

zIn.Data = "00001"

If CheckInput_1(zEmpNo, zEmpPwd) = False Then
	Exit Sub
End If

zCnsltTp.Data = "0"
zPsTp.Data = "0"
zEvalSectTp.Data = "0"

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)

	'그리드 마지막 행의 첫번째 셀은 '- -' 표시를 제거하기 위해 사용
	GRID0.SetFormat GRID0.Rows, 1, "99999999999999999999"

	Dim b
	For b = 1 To GRID0.Rows
		Dim tmpTel
		tmpTel = Trim(GRID0.GetGridCell(b, 11))

		If tmpTel = "--" Then
			GRID0.SetGridCell b, 11, ""
		End If
	Next

	If midAccnNo.Checked = True Then
		MidCnt = MidCnt + 1
		branchCnt = 0
		Call sortMidAccn()
	Else
		MidCnt = 0
		branchCnt = branchCnt + 1
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
SCREEN.OBJect("main.zEmpNo").data = zEmpNo.Data
SCREEN.OBJect("main.zEmpPwd").data = zEmpPwd.Data

Call p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zEmpPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
'send_c()
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
'MsgBox Trim(GRID0.GetGridCell(1,1))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zAcmgtCode)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(midAccnNo)
_AW_ONCLICK_AW_
MidCnt = MidCnt + 1
branchCnt = 0

If MidCnt < 2 Then
	Call sortMidAccn()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(branchNo)
_AW_ONCLICK_AW_
MidCnt = 0
branchCnt = branchCnt + 1

If branchCnt < 2 Then
	GRID0.Sort 1, True, False

	If Trim(GRID0.GetGridCell(1, 1)) = "총 계" Or Trim(GRID0.GetGridCell(1, 1)) = "총 -계-" Then
		GRID0.InsertRow(-1)

		Dim a

		For a = 1 To GRID0.Columns
			GRID0.Row = 1

			If GRID0.IsColumnVisible(a) = True Then
				GRID0.SetGridCell GRID0.Rows, a, Trim(GRID0.GetGridCell(1, a))
			End If
		Next

		GRID0.RemoveRow(0)

		'그리드 마지막 행의 첫번째 셀은 '- -' 표시를 제거하기 위해 사용
		GRID0.SetFormat GRID0.Rows, 1, "99999999999999999999"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



