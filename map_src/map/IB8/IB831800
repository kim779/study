RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	InA.Data = "00001"
	ElecfnUserId.data = SYSTEM.UserID
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub close()
	OBJECT0.ClearAll 0
	OBJECT0.Visible = False
End Sub

Sub clear()
	ms_btn.Enable = False
	Call close()
	Call send_f()
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0025"
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(LEDGER.Next) = "Y" Then
	send_c()
Else
	Dim i, ii
		ii = 0
	For i=1 To GRID1.Rows
		If Trim(GRID1.GetGridCell(i,5)) = "09" Then
			GRID0.InsertRow(-1)
			ii = ii+1
			GRID0.SetGridCell ii, 2 ,Trim(GRID1.GetGridCell(i,6))
			GRID0.SetGridCell ii, 3 ,Trim(GRID1.GetGridCell(i,9))
			GRID0.SetGridCell ii, 4 ,Trim(GRID1.GetGridCell(i,10))
		End If
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID1)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	For i=1 To GRID0.Rows
		If i <> GRID0.Row Then
			GRID0.SetGridCell i, 1 ,"0"
		End If
	Next

	For ii=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(ii,1)) = "1" Then
			ms_btn.Enable = True
			Exit For
		Else
			ms_btn.Enable = False
		End If
	Next
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ms_btn)
_AW_ONCLICK_AW_
Dim acnt
For i=0 To GRID0.Rows
	If Trim(GRID0.GetGridCell(i,1)) = "1" Then
		acnt = Mid(Trim(GRID0.GetGridCell(i,3)),1,3)&"-"&Mid(Trim(GRID0.GetGridCell(i,3)),4,2)&"-"&Mid(Trim(GRID0.GetGridCell(i,3)),6,6)
		SCREEN.Object("OBJECT0.LABEL0").Text = acnt
		SCREEN.Object("OBJECT0.AcntNo").data = Trim(GRID0.GetGridCell(i,3))
	End If
Next
SCREEN.Object("OBJECT0.Pwd1").Setfocus
OBJECT0.Visible = True
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



