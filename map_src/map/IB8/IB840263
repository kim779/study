_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub Setting()
	Dim ii, citem, items, items2, str, name, code
'	items = "" & vbTab & "" & "" & vbTab
	items = ""
'	items2 = "" & vbTab & ""
	items2 = ""
	citem = "" & vbTab & "" & ""

	For ii=1 To GRID0.Rows

'		str = Trim(GRID0.GetGridtext(ii, 3))
		str = GRID0.GetGridtext(ii, 3)
		name = Trim(GRID0.GetGridtext(ii,2))
		code = Trim(GRID0.GetGridtext(ii,1))

		If str <> "" And name <> "" And code <> "" Then
		   items = items & str & str & vbTab
		   items2 = items2 & name & vbTab
		   citem = citem & vbTab & code
		End If
	Next

	'환불입고계좌 데이터가 있는 체크
	If SCREEN.Object("main.OBJ1.chk_ipgo").Text = "1" Then
		'환불입고계좌가 있을경우 앞에 붙이기
		'ipgo_data = SCREEN.Object("main.OBJ1.zRebatAcntNo").data & "         "
		'ipgo_name = SCREEN.Object("main.OBJ1.ANCM1").data

		ipgo_data = ""
		ipgo_name = ""

		items = ipgo_data & ipgo_data & vbTab & items
		items2 = vbTab & ipgo_name & vbTab & items2

		'콤보박스 디폴트 선택 데이터
		items = ipgo_data & vbTab & items
	Else
		'콤보박스 디폴트 선택 데이터(공백)
		items = vbTab & vbTab & items
		items2 =  vbTab & vbTab & items2
	End If

	SCREEN.Object("main.OBJ1.code").SetItems(citem)
	SCREEN.Object("main.OBJ1.zRebatAmtMtrsfBnkAcntNo").SetItems(items)'
	SCREEN.Object("main.OBJ1.zRebatAmtMtrsfBnkAcntNo_nm").SetItems(items2)
	SCREEN.Proc "main.OBJ1.transacct_set", ""  '--계좌번호, 계좌명 세팅
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
'zAcntNo.Data = SCREEN.Object("main.obj1.AN1A").data

'환불입고계좌에 대한 환불이체계좌 조회
SCREEN.OnSend = False

zAcntNo.Data = SCREEN.Object("main.obj1.zRebatAcntNo").Data
zPwd.Data = SCREEN.Object("main.obj1.zpwd").data

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	Call Setting()

	If SCREEN.Object("parent.IsClickButton").Text = 0 Then
		Call alert_msg("환불이체계좌를 확인하시기 바랍니다. 청약 신청을 원하시면 전송버튼을 클릭해 주세요")
		SCREEN.Object("parent.IsClickButton").Text  = 1
		SCREEN.Object("parent.BUTTON1").SetFocus
		Exit Sub
	End If
'	SCREEN.Proc "main.OBJ1.send_f", ""	'--자동 전송

	If SCREEN.Object("parent.jusik").Checked = True Then
		SCREEN.Object("parent.zIsuNo").SetFocus
	Else
		SCREEN.Object("parent.zIsuNo_chae").SetFocus
	End If

	SCREEN.Object("parent.obj_accDiff").Send

End If

