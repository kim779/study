RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub init()
	SCREEN.ClearAll 0, 0
	ed_icnt.Data = "0001"
	ed_odgb.Data = "2"
	ed_mkgb.Data = "1"
	ed_acno.Data = SCREEN.Object("main.AN20").Data
	ed_pswd.Data = SCREEN.Object("main.ed_pswd").Data

End Sub

Sub send_odr(param)
	init()

	ArrData = Split(param, "~")
	ed_code.Data = Trim(ArrData(0))
	If ArrData(1) = "3" Then
		ed_mmgb.Data = "2"
	Else
		ed_mmgb.Data = Trim(ArrData(1))
	End If
	'ed_mmgb.Data = Trim(ArrData(1))
'	SYSTEM.Trace "code["&ed_code.Data&"] jprc["&ArrData(2)&"]"
	ed_jprc.Data = FormatNumber(CDbl(ArrData(2)), 2, 0, 0, 0) * 100
	ed_jqty.Data = ArrData(3)

	ed_hogb.Data = "00" '지정가
	ed_jmgb.Data = "0"	'디폴트
	ed_prgb.Data = "Y"

	'SYSTEM.Trace "recv : ["&param&"] "&UBound(ArrData)
	SCREEN.Send 0
End Sub

_AW_ONTIMER_AW_
'주문번호 깜빡임정지
'SCREEN.Object(objnm & ".o_jmno").blink False, -1

_AW_ONENDSUB_AW_
}



