RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim start
start = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2

	If SYSTEM.ConnectBy = 1 Then
		zPwd.Clear
	End If


'	zLoanDt.Data = getCurrDay()
	RADIO1.Checked = True
	lAbleAmt.Clear
	lLoanQty.Clear

	ACNM.Data = AN19.Name
	zPwd.Data = AN19.Password

	If Len(Trim(AN19.Data)) < 11 Then
		AN19.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	SCREEN.SetTimer 5, False
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ACNM.Data = AN19.Name

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub locFocus()
	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
		End If
	End If

	If Len(Trim(S1301.Data)) < 6 Then
		obj0.Send
		S1301.SetFocus
		Exit Sub
	End If

	If Len(Trim(zLoanDt.Data)) < 8 Then
		zLoanDt.SetFocus
		Exit Sub
	End If

	If RADIO0.Checked = True Then
		If Trim(lAbleAmt.Data) = "" Or Len(Trim(lAbleAmt.Data)) < 1 Or CDbl(Trim(lAbleAmt.Data)) = "0" Then
			lAbleAmt.SetFocus
			Exit Sub
		End If
	End If

	If RADIO1.Checked = True Then
		If Trim(lLoanQty.Data) = "" Or Len(Trim(lLoanQty.Data)) < 1 Or CDbl(Trim(lLoanQty.Data)) = "0" Then
			lLoanQty.SetFocus
			Exit Sub
		End If
	End If
End Sub

Sub InitIMAX
	If g_flag = 1 Then
		Exit Sub
	End If
	l_initimax("ctrl_code")
	g_flag = 1
End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#Load IB888888

#load IB999938

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)
SYSTEM.Trace IMAXCODE.Data
SYSTEM.Trace IMAXEXID.Data
'MsgBox IMAXCODE.Data

'MsgBox .Data
If Len(Trim(IMAXCODE.Data)) > 0 And Len(Trim(IMAXEXID.Data)) Then

	S1301_1.Visible = False
	BUTTON0.Visible = False
	obj0.Visible = False
	obj0.Enable  = False
	InitIMAX
	l_initimax("ctrl_code")
	ctrl_code.SetVisible(True)

	ctrl_code.SetIMAXData GetIMAXMk(GetMkCode(IMAXEXID.Data)), GetIMaxMkcode(GetMkCode(IMAXEXID.Data)) & vbTab & IMAXCODE.Data
	RADIO3.Checked = True
	RADIO2.Checked = False
	'ctrl_code.SetIMAXData IMAXCODE.Data, IMAXCODE.Data & vbTab & IMAXEXID.Data
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
GUIDE.Text = ""

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
End If


If RADIO2.Checked = True  Then
	scode.Skip True
	EDIT1.Skip False
	EDIT6.Skip False
	S1301.Skip False
	S1301.Data = S1301_1.Data
	zFcurrMktCode.Data = ""
	zLoanDtlClssCode.Data = "80"

	If SCREEN.GetCodeType(Trim(S1301.Data)) <> 27 Then
		EDIT6.Data = "A"
	Else
		EDIT6.Data = "Q"
	End If
Else
	scode.Skip False
	scode.Data = IMAXISIN.Data
	zLoanDtlClssCode.Data = "83"
	zFcurrMktCode.Data = GetMkCode(IMAXEXID.Data)

	EDIT1.Skip True
	EDIT6.Skip True
	S1301.Skip True
End If

If CheckInput(AN19, zPwd) = True Then
	If RADIO2.Checked And Len(Trim(S1301.Data)) < 6 Then
		obj0.Send
		MsgBox "종목번호를 확인하십시오.", , "IBK투자증권"
		S1301.SetFocus
		Exit Sub
	End If

	If RADIO3.Checked And Len(Trim(scode.Data)) < 12 Then
		obj0.Send
		MsgBox "종목번호를 확인하십시오.", , "IBK투자증권"
		S1301.SetFocus
		Exit Sub
	End If

	If Len(Trim(zLoanDt.Data)) < 8 Then
			MsgBox "대출일자를 확인하십시오.", , "IBK투자증권"
			zLoanDt.SetFocus
			Exit Sub
	End If

	If RADIO0.Checked = True Then
		If Trim(lAbleAmt.Data) = "" Or Len(Trim(lAbleAmt.Data)) < 1 Or CDbl(Trim(lAbleAmt.Data)) = "0" Then
			MsgBox "금액을 확인하십시오.", , "IBK투자증권"
			lAbleAmt.SetFocus
			Exit Sub
		End If
	End If

	If RADIO1.Checked = True Then
		If Trim(lLoanQty.Data) = "" Or Len(Trim(lLoanQty.Data)) < 1 Or CDbl(Trim(lLoanQty.Data)) = "0" Then
