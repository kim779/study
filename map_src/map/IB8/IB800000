_AW_ONDECLARE_AW_
Const MYFILE = "userconf.ini"
Const MYMAP = "IB800000"

Sub setcolopt(opt)
	Dim ii
	If opt = "1" Then
		R0.Checked = True
		R1.Checked = False
		R2.Checked = False
		For ii=1 To 12
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 5, True
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 6, False
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 7, False
		Next
	ElseIf opt = "2" Then
		R0.Checked = False
		R1.Checked = True
		R2.Checked = False
		For ii=1 To 12
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 5, False
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 6, True
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 7, False
		Next
	ElseIf opt = "3" Then
		R0.Checked = False
		R1.Checked = False
		R2.Checked = True
		For ii=1 To 12
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 5, False
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 6, False
			SCREEN.Object("OBJ0.DGRID"&ii).SetColumnVisible 7, True
		Next
	End If
End Sub

Sub scrchange(param)
	Dim scrtype
	scrtype = param Mod 4
	If scrtype = 0 Then
		SCREEN.SetSize 1235, 402
		If viewgb.Data <> "12C" Then
			viewgb.Data = "12C"
		End If
	ElseIf scrtype = 1 Then
		SCREEN.SetSize 623, 682
		If viewgb.Data <> "06C" Then
			PANEL1.SetRect 315, 402, 625, 660
			PANEL10.SetRect -4, 26, 627, 405
			PANEL4.Visible = False
			tab_ordtyp.SetRect 323, 411, 618, 437
			OBJ3.Visible = False
			OBJ_order.SetRect 323, 437, 618, 651
			OBJ0.SetRect 6, 36, 1232, 395
			viewgb.Data = "06C"
			PANEL35.Right = 625
			'GUIDE.
		End If
		OBJ0.Proc "setscreen", "2"
	ElseIf scrtype = 2 Then
		SCREEN.SetSize 623, 402
		If viewgb.Data <> "06C" Then
			PANEL1.SetRect 315, 402, 625, 660
			PANEL10.SetRect -4, 26, 627, 405
			PANEL4.Visible = False
			tab_ordtyp.SetRect 323, 411, 618, 437
			OBJ3.Visible = False
			OBJ_order.SetRect 323, 437, 618, 651
			OBJ0.SetRect 6, 36, 1232, 395
			viewgb.Data = "06C"
			PANEL35.Right = 625
			'GUIDE.
		End If
		OBJ0.Proc "setscreen", "2"
	ElseIf scrtype = 3 Then
		SCREEN.SetSize 1235, 682
		OBJ0.Proc "setscreen", "1"
		If viewgb.Data <> "12C" Then
			PANEL1.SetRect 315, 402, 618, 660
			PANEL10.SetRect -4, 26, 1239, 405
			PANEL4.Visible = True
			tab_ordtyp.SetRect 323, 411, 610, 437
			OBJ3.Visible = True
			OBJ_order.SetRect 323, 437, 610, 651
			OBJ0.SetRect 6, 36, 1232, 395
			viewgb.Data = "12C"
			PANEL35.Right = 1237
		End If
	End If
	scrgb.Data = scrtype
	Call p_write_ini(3, scrtype)
End Sub

Sub p_write_ini(opt, value)
	If SCREEN.CreateObject("INFO") Then
		If opt = "1" Then
				INFO.PushData LOGIN.Name, MYFILE, MYMAP, "THEMEOPT", value
		ElseIf opt = "2" Then
				INFO.PushData LOGIN.Name, MYFILE, MYMAP, "COLOPT", value
		ElseIf opt = "3" Then
				INFO.PushData LOGIN.Name, MYFILE, MYMAP, "SCRSIZE", value
		End If
	End If
End Sub

Sub p_read_ini()
	Dim themeopt, colopt, scrtype
	If SCREEN.CreateObject("INFO") Then
		themeopt = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "THEMEOPT"))
		colopt = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "COLOPT"))
		scrtype = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "SCRSIZE"))
		SCREEN.IgnoreChange True
		If themeopt <> "" Then
			C_GUBN.Data = themeopt
		End If
		If colopt <> "" Then
			setcolopt(colopt)
		End If
		If scrtype <> "" Then
			scrgb.Data = scrtype
			scrchange(scrgb.Data)
		End If
		SCREEN.IgnoreChange False
	End If
End Sub



