_AW_ONDECLARE_AW_
Dim sect
sect = 0

'----------------- 공모주청약
Sub Set_jusik()
	SCREEN.ClearAll 0, 2
	zIsuNo_chae.Visible = False
	chae_nm.Visible = False
	no.Visible = True
	obj.Visible = True
	SCREEN.object("obj.17413").visible = True
	obj.Send
End Sub

Sub Set_chae()
	SCREEN.ClearAll 0, 2
	zIsuNo_chae.Visible = True
	chae_nm.Visible = True
	no.Visible = False
	obj.Visible = False
	SCREEN.object("obj.17413").visible = False
	'chae_nm.Data = SCREEN.GetName(105, zIsuNo_chae.Data, 0)
End Sub


'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
Dim cy_date, cy_d2date

'== D-2 날짜 구하기
Dim yy, mm, dd, cday, MyWeek

cday = DateAdd("d", -2, Date)
MyWeek = Weekday(cday)
If MyWeek = 1 Then
	cday= DateAdd("d", -2 , cday)
ElseIf MyWeek = 7 Then
	cday= DateAdd("d", -1 , cday)
End If

yy = Year(cday)
mm = Month(cday)
If Len(mm) = 1 Then mm = "0"&mm

dd = Day(cday)
If Len(dd) = 1 Then dd = "0"&dd

cday = yy&mm&dd
cy_d2date = CDbl(cday)

'날짜 컨트롤
If SCREEN.CreateObject("Info") Then
	cy_date = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "CB_IB840820"))
End If

'SYSTEM.Trace "data in File : " & cy_date
'SYSTEM.Trace "D-2 data : " & cy_d2date
'SYSTEM.Trace "Combo Data " & zAppySrtDt.Data

If Trim(cy_date) = "" Then
	zAppySrtDt.Data = cy_d2date
Else
	zAppySrtDt.Data = cy_date
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.ClearAll 0, 2

If jusik.Checked = True Then
	If Trim(no.data) <> "" Then
		zAppyIsuNo.Data = "A" & no.data
		SCREEN.OnSend = True
	Else
		SCREEN.OnSend = False
		Call alert_msg("종목코드를 확인하십시오")
	End If
Else
	If Trim(zIsuNo_chae.data) <> "" Then
		zAppyIsuNo.Data = zIsuNo_chae.data
		SCREEN.OnSend = True
	Else
		SCREEN.OnSend = False
		Call alert_msg("종목코드를 확인하십시오")
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next <> "Y" Then
	next_btn.Enable = False
	If sect = 0 Then
		no.SetFocus
	ElseIf sect = 1 Then
		send_btn.SetFocus
	End If
Else
	next_btn.SetFocus
	next_btn.Enable = True
End If

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If SCREEN.Key = 13 Then
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(no)
_AW_ONCHANGE_AW_
next_btn.Enable = False
SYSTEM.SetHistory "no", no.Data
SCREEN.Object("obj.1301").data = no.Data
obj.Send
'Call send_f()
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
'==
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	sect = 0
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zIsuNo_chae)
_AW_ONCHANGE_AW_
next_btn.Enable = False

'chae_nm.Data = SCREEN.GetName(105, zIsuNo_chae.Data, 0)
'SYSTEM.SetHistory "zIsuNo_chae", zIsuNo_chae.Data
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 Then
	'SCREEN.object("obj.1301").data = zIsuNo.Data
	sect = 1
	SCREEN.Proc "main.obj1_to_obj3", ""
	obj.Send
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zAppySrtDt)
_AW_ONCHANGE_AW_
SCREEN.CreateObject("Info")
INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "CB_IB840820", zAppySrtDt.Data
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
If SCREEN.key = 13 Then
	Call send_f()
End If
