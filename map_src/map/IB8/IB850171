RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt="0025"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
SCREEN.Object("parent.GUIDE").Text = ""

account.Data = Trim(SCREEN.Object("parent.AN1A").Data)
zPwd.Data = Trim(SCREEN.Object("parent.zpwd").Data)

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
	SCREEN.Object("parent.zpwd").Data = "9999"
End If

If CheckInput(account, zPwd) = True Then
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod, ii, tmpCode, var
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
	SCREEN.Object("parent.zPwd").Clear
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	Call send_c()
Else
	yday_new.Data = lUnsttNewMloan.Data + lUnsttNewSloan.Data
	yday_refund.Data = lUnsttMloanRfund.Data + lUnsttSloanRfund.Data
End If

For ii = gridPos To GRID0.Rows
	tmpCode = Trim(GRID0.GetGridCell(ii, 1))

	If Len(tmpCode) = 0 Then
		Exit Sub
	End If

	If Len(tmpCode) = 7 And Left(tmpCode, 1) = "A" Then
		tmpCode = Mid(tmpCode, 2)
	End If

	GRID0.SetGridCell ii, 2, tmpCode
Next

If LEDGER.Next <> "Y" Then
	SCREEN.Object("main.1301").data = Left(GRID0.GetGridCell(1, 2), 6)
	var = Trim(GRID0.GetGridCell(1, 5))

	If var = "유통융자" Then
		SCREEN.Object("main.zLoanPtnCode").Data = "01"
	ElseIf var = "자기융자" Then
		SCREEN.Object("main.zLoanPtnCode").Data = "03"
	ElseIf var = "유통대주" Then
		SCREEN.Object("main.zLoanPtnCode").Data = "05"
	ElseIf var = "자기대주" Then
		SCREEN.Object("main.zLoanPtnCode").Data = "07"
	ElseIf var = "예탁담보주식대출" Then
		SCREEN.Object("main.zLoanPtnCode").Data = "80"
