RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_Dict
Dim g_ArrCombo

Set g_Dict = CreateObject("Scripting.Dictionary")

g_ArrCombo = Array(Daebun, Jungbun, Sobun, Sebun)

First = False

'=================================================================
Function GetArrItem(Desc)
	Set Dict = CreateObject("Scripting.Dictionary")
	GetArrItem = Array(Desc, Dict)
End Function

'=================================================================
Function GetStar(Num)
	GetStar = ""
	If Num <= 0 Then
		Exit Function
	End If

	For i = 1 To Num
		GetStar = GetStar & "*"
	Next
End Function

'=================================================================
Sub SetCtrl(Index)
	GRID0.Clear
	KeyArr = Array("", "", "", "")
	For i = LBound(g_ArrCombo) To UBound(g_ArrCombo)
		If i >= Index Then
			g_ArrCombo(i).SetItems("")
		Else
			KeyArr(i) = g_ArrCombo(i).Data
		End If
	Next

	For i = LBound(KeyArr) To UBound(KeyArr)
		If Mid(KeyArr(i), 1, 1) = "*" Then
			Exit Sub
		End If
	Next

	If Index = 0 Then
		Set Dict = g_Dict
	ElseIf Index = 1 Then
		Set Dict = g_Dict.Item(KeyArr(0))(1)
	ElseIf Index = 2 Then
		Set Dict = g_Dict.Item(KeyArr(0))(1).Item(KeyArr(1))(1)
	ElseIf Index = 3 Then
		Set Dict = g_Dict.Item(KeyArr(0))(1).Item(KeyArr(1))(1).Item(KeyArr(2))(1)
	ElseIf Index = 4 Then
		Set Dict = g_Dict.Item(KeyArr(0))(1).Item(KeyArr(1))(1).Item(KeyArr(2))(1).Item(KeyArr(3))(1)
	Else
		Exit Sub
	End If

	Keys = Dict.Keys
	If Index = 4 Then
		GRID0.Clear
		For i = 0 To Dict.Count - 1
			Key = Keys(i)
			Desc = Dict.Item(Keys(i))(0)
			GRID0.InsertRow -1
			GRID0.SetGridCell i + 1, 1, Key
			GRID0.SetGridCell i + 1, 2, Desc
		Next
	Else
		Star = GetStar(Index + 1)
		Data = Star & vbTab & Star & "선택하세요" & vbTab
		For i = LBound(Keys) To UBound(Keys)
			Data = Data & Keys(i) & Dict.Item(Keys(i))(0) & vbTab
		Next
		g_ArrCombo(Index).SetItems(Data)
	End If
End Sub


'==파일 읽기
Sub Read_f()
	If First = True Then
		Exit Sub
	End If
	First = True

	Dim FSO, F, ii, ReadLine, Arry, t_dae, bLv2, arrLv2()
	Set FSO = CreateObject("Scripting.FileSystemObject")
	Set F = FSO.OpenTextFile(SYSTEM.Home & "\tab\KRSTCODE.dat", 1)

	KeyArr = Array("", "", "", "", "")
	Do While F.AtEndOfLine <> True
		ReadLine = F.ReadLine
		Arry = Split(ReadLine, vbTab, -1 ,1)
		Key = Arry(0)
		Desc = Arry(1)
		LenKey = Len(Key)
		ArrItem = GetArrItem(Desc)

		If Len(Trim(Arry(0))) = 1 Then
			g_Dict.Add Key, ArrItem
		ElseIf Len(Trim(Arry(0))) = 2 Then
			g_Dict.Item(KeyArr(0))(1).Add Key, ArrItem
		ElseIf Len(Trim(Arry(0))) = 3 Then
			g_Dict.Item(KeyArr(0))(1).Item(KeyArr(1))(1).Add Key, ArrItem
		ElseIf Len(Trim(Arry(0))) = 4 Then
			g_Dict.Item(KeyArr(0))(1).Item(KeyArr(1))(1).Item(KeyArr(2))(1).Add Key, ArrItem
		ElseIf Len(Trim(Arry(0))) = 5 Then
			g_Dict.Item(KeyArr(0))(1).Item(KeyArr(1))(1).Item(KeyArr(2))(1).Item(KeyArr(3))(1).Add Key, ArrItem
		End If

		KeyArr(LenKey - 1) = Key
	Loop
	SetCtrl(0)
End Sub

_AW_ONSTART_AW_
Call Read_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(Daebun)
_AW_ONCHANGE_AW_
SetCtrl(1)
