RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim gubn

Sub inquery_memo()
	SCREEN.ClearAll 0, 2
	gubn = "memo"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub insert_memo()
	SCREEN.ClearAll 0, 2
	gubn = "memo"
	If Len(SCREEN.Object("obj_memo.MEMO").Text) > 100 Then
		MsgBox "100자 이내로 입력하여 주십시오."
		SCREEN.Object("obj_memo.MEMO").SetFocus
		Exit Sub
	End If

	zMemo.Data = Trim(SCREEN.Object("obj_memo.MEMO").Text)

	zAfirTp.Data = "2"
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub insert_infoMethod()
	gubn = "info"
	zAfirTp.Data = "1"

	zIn.Data 		   = "00001"
	zPrdtTp.Data 	   = Trim(SCREEN.Object("parent.zPrdtTp").Data)
	zOrdDt.Data 	   = Trim(GRID0.GetGridCell(1, 1))
	zOrdMktCode.Data   = Trim(GRID0.GetGridCell(1, 2))
	zMgmtBrnNo.Data    = Trim(GRID0.GetGridCell(1, 3))
	zlOrdNo.Data 	   = Trim(GRID0.GetGridCell(1, 4))
	zlCtrctNo.Data 	   = Trim(GRID0.GetGridCell(1, 5))
	zlExecNo.Data 	   = Trim(GRID0.GetGridCell(1, 6))
	zAcntNo.Data 	   = Trim(GRID0.GetGridCell(1, 7))
	zSdinfSmsYn.Data   = Trim(GRID0.GetGridCell(1, 8))
	zSdinfVstYn.Data   = Trim(GRID0.GetGridCell(1, 9))
	zSdinfWrlinYn.Data = Trim(GRID0.GetGridCell(1, 10))
	zSdinfEtcYn.Data   = Trim(GRID0.GetGridCell(1, 11))
	zMemo.Data		   = ""
	zUserId.Data       = Trim(GRID0.GetGridCell(1, 12))

	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
If Trim(zAfirTp.Data) = "3" Then
	Call inquery_memo()
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If gubn = "memo" Then
	SCREEN.Object("obj_memo.MEMO").Text = Trim(out_zMemo.Data)
ElseIf gubn = "info" Then
	If Left(Trim(LEDGER.Ecod), 1) = "0" Then
		GRID0.removeRow 0

		If GRID0.Rows > 0 Then
			Call insert_infoMethod()
		Else
			MsgBox "등록이 완료되었습니다.", , "IBK투자증권"
			SCREEN.Proc "parent.send_f", ""
		End If
	Else

	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(confirm_btn)
_AW_ONCLICK_AW_
Call insert_memo()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


