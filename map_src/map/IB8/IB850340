Sub SetmktVisible(gubn)

	If gubn = "00" Then
		S1301_1.Visible = True
		BUTTON0.Visible = True
		obj0.Visible = True
		obj0.Enable = True
		ctrl_code.SetVisible(False)
		zFcurrMktCode.Data = gubn
	Else
