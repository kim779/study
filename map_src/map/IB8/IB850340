Sub Set_account()
	SCREEN.ClearAll 0, 2
	S1301.Clear
	obj0.Send
	lRfundQty.Clear
	zLoanDt.Data = getCurrDay()
	obj1.ClearAll 2

	If SCREEN.Object("parent.UTAB1").ID <> "7" Then
		SCREEN.Object("parent.obj1").ClearAll 2
	End If

	If Len(Trim(AN19.Data)) < 11 Then
		AN19.SetFocus
		Exit Sub
	Else
		ACNM.Data = Trim(AN19.Name)
		zPwd.Data = Trim(AN19.Password)

		If SYSTEM.ConnectBy = 1 Then
			If Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If
		End If
	End If

	SCREEN.Proc "obj1.send_f", ""
	zPwd.SetFocus
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
