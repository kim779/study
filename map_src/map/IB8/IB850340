	SCREEN.Send 0
End Sub


Sub send_o()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub confirmOrder()
	Dim dmsg

	SYSTEM.Push "cashRdemtnApplication", ""

	If (zLoanDtlClssCode.Data = "80" And Trim(S1301.Data) = "") Or (zLoanDtlClssCode.Data = "83" And Trim(zfrgncod2.Data) = "")  Then
		Call alert_msg("종목번호를 입력하세요.")
		S1301.SetFocus

	ElseIf CheckInput(AN19, zPwd) = False Then
		MsgBox "계좌비밀번호를 확인하세요.", vbInformation, "IBK투자증권"
		zPwd.SetFocus

	ElseIf Is_numeric(lRfundQty.Data) = False Then
		Call alert_msg("상환수량을 확인하여 주십시오.")
		lRfundQty.SetFocus
	ElseIf Trim(zLoanDt.Data) = "" Then
		Call alert_msg("대출일자를 확인하여 주십시오.")
		zLoanDt.SetFocus
	Else

	If zLoanDtlClssCode.Data = "80" Then
		dmsg = "o_acno" & vbTab & AN19.Data & vbLf &_
				"o_acnm" & vbTab & ACNM.Data & vbLf &_
				"o_hnam" & vbTab & Mid(SCREEN.Object("obj0.1022").Data,2) & vbLf &_
				"o_rqty" & vbTab & Trim(lRfundQty.Data) & vbLf &_
				"o_loan" & vbTab & zLoanDt.Data & vbLf
	Else
		dmsg = "o_acno" & vbTab & AN19.Data & vbLf &_
				"o_acnm" & vbTab & ACNM.Data & vbLf &_
				"o_hnam" & vbTab & IMAXCODENAME.Data & vbLf &_
				"o_rqty" & vbTab & Trim(lRfundQty.Data) & vbLf &_
				"o_loan" & vbTab & zLoanDt.Data & vbLf
	End If


		SCREEN.CreateWindow 2, "IB85034A /p5 /d", dmsg

		If SYSTEM.Pop("cashRdemtnApplication")  = "OK" Then
			If IsBnkAccnType(AN19) = True Then
				SCREEN.Proc "obj_inqueryMoney.send_f", ""
			Else
				Call send_o()
			End If
		End If

		SYSTEM.Push "cashRdemtnApplication", ""
		selection.Data = 2
	End If
End Sub

