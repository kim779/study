'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	SCREEN.proc "Main.OBjSend", ""
    S1301.Clear
    SCREEN.Object("OBJECT0.1301").Clear
    OBJECT0.Send
	zBaseDt.Data = getCurrDay()
	IAntiSdinfQty.Clear

	ACNM.Data = AN1A.Name

	If Trim(AN1A.Password) <> "" Then
		zpwd.Data = Trim(AN1A.Password)
	Else
		zpwd.Data = Trim(SCREEN.Object("main.zPwd").Data)
	End If


	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If

End Sub

'== 첫 조회
Sub send_f()
	SCREEN.proc "Main.setAccnt", Trim(AN1A.Data) &","& Trim(zpwd.Data) & "," & Trim(zBaseDt.Data)
'	LEDGER.Fkey = "C"
'	SCREEN.Send 0
End Sub

Sub viewName()
	SCREEN.Object("OBJECT0.1301").data = S1301.Data
	OBJECT0.Send
End Sub

'--유상청약예약
Sub Raserve()
	If CheckInput(AN1A, zpwd) = False Then
		Exit Sub
	End If

	If Trim(S1301.Data) = "" Then
		alert_msg("종목번호를 입력하세요")
		S1301.SetFocus
		Exit Sub
	End If

	If Trim(zBaseDt.Data) = "" Then
		alert_msg("기준일자를 입력하세요")
		zBaseDt.SetFocus
		Exit Sub
	End If

	If Trim(IAntiSdinfQty.Data) = "" Or Trim(IAntiSdinfQty.Data) =< 0 Then
		alert_msg("반대통보수량을 입력하세요")
		IAntiSdinfQty.SetFocus
		Exit Sub
	End If

	dmsg = "acno" & vbTab & AN1A.Data & vbLf &_
		   "acnm" & vbTab & AN1A.Name & vbLf &_
		   "hnam" & vbTab & Mid(SCREEN.Object("OBJECT0.1022").Data, 2) & vbLf &_
		   "basedate" & vbTab & zBaseDt.Data & vbLf &_
	       "capa" & vbTab & IAntiSdinfQty.Data & vbLf

			SCREEN.CreateWindow 2, "IB84051A /p5 /d", dmsg

			If SYSTEM.Pop("stock_buy") <> "OK" Then
				Exit Sub
			Else
				'SCREEN.proc "Main.setAccnt", AN1A.Data &","& zpwd.Data
				Call cancel()
			End If
End Sub

Sub cancel()
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub Set_focus()
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
	ElseIf Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
	ElseIf Trim(S1301.Data) = "" Then
		S1301.SetFocus
	ElseIf Trim(zBaseDt.Data) = "" Then
		zBaseDt.SetFocus
	ElseIf Trim(IAntiSdinfQty.Data) = "" Then
		IAntiSdinfQty.SetFocus
	End If
End Sub

