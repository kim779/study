	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

IntaccNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

If Len(Trim(IntaccNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

Pwd.Data = Trim(SCREEN.Object("parent.zpwd").Data)

If Len(Trim(Pwd.Data)) < 4 Then
	Call guide_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zpwd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(zAvalYn.Data) = "Y" Then
	SCREEN.Object("parent.isPwdChkYn").Text = "Y"
	SCREEN.Proc "parent.chkJmcd", ""
Else
	SCREEN.Object("parent.isPwdChkYn").Text = "N"
End If

