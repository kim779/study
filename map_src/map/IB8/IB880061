RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim Select_no  '기존선택되어있던 그룹번호

Sub send_f()
	If GRID0.Row > 0 Then
		Select_no = GRID0.GetGridCell(GRID0.Row,1)
	End If
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0040"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, Ordqty, chgqty, items

If LEDGER.Next = "Y" Then
	Send_c()

Else
	If SCREEN.GetMapName(1) = "IB880000" Then
		items = "01" &vbTab '& "0전체"&vbTab
	Else
		items = "01" &vbTab '& "0 "&vbTab
	End If
	For ii = 1 To GRID0.Rows
		items = items &"1"&GRID0.GetGridCell(ii,2)&vbTab
	Next
	Call SCREEN.Object("main.combo0").SetItems(items)

	SCREEN.Object("main.combo0").Index = 0
	SCREEN.Object("main.send_btn").Enable = True
	SCREEN.Proc "main.GroupComboChange", ""
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_

send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



