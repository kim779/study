RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB850100"

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
	 	ac_data.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "AC_DATA"))
	 	ac_name.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "AC_NAME"))
	End If
End Sub


Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
	  INFO.PushData LOGIN.Name, myFILE, myMAP, "AC_DATA", ac_data.text
	  INFO.PushData LOGIN.Name, myFILE, myMAP, "AC_NAME", ac_name.text
	End If
End Sub

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Len(Trim(AN1A.Data)) < 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

LEDGER.Rcnt="0028"

timer.Data = 1
'계좌 가져오기
p_read_ini()

'SCREEN.SetTimer 8, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
GUIDE.Text = ""

If SYSTEM.ConnectBy = 0 Then
		zPwd.Data = "9999"
End If

If CheckInput(AN1A, zPwd) = True Then
	If SYSTEM.ConnectBy = 0 Then
		zPwd.Data = "9999"
	End If

	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 1,2
	ACNM.Data = AN1A.Name
	zPwd.Clear
	zPwd.SetFocus
End If

If sec.Data = "1" Then
	zPwd.SetFocus
ElseIf sec.Data = "2" Then
	send_btn.SetFocus
ElseIf sec.Data = "3" Then
	zLoanDtlClssCode.SetFocus
ElseIf sec.Data = "4" Then
	zIsuMktTp.SetFocus
ElseIf sec.Data = "5" Then
	next_btn.SetFocus
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(zPwd.Data)) < 4 Then
		Exit Sub
	End If
End If

Call send_f()

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
If timer.Data = 1 Then
	Set_account()
	ac_data.Text = AN1A.Data
	ac_name.Text = ACNM.Data
Else
	AN1A.Data  = ac_data.Text
	ACNM.Data = ac_name.Text
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
	sec.Data = "1"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
sec.Data = "2"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
sec.Data = "5"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zLoanDtlClssCode)
_AW_ONCHANGE_AW_
send_f()
sec.Data = "3"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zIsuMktTp)
_AW_ONCHANGE_AW_
send_f()
sec.Data = "4"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	'트리거 날리기
	S1301.DATA = Trim(Right(GRID0.GetGridCell(GRID0.Row, 3), 11))

	If S1301.DATA = "" Then
		Exit Sub
	End If


	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(Main_Tab)
_AW_ONCLICK_AW_
Select Case Main_Tab.Index
	Case "1"		'잔고평가
		SCREEN.ChangeMap "IB850100"
	Case "2"		'신용가능종목조회
		SCREEN.ChangeMap "IB850110"
	Case "3"		'담보이율현황
		SCREEN.ChangeMap "IB850120"
	Case "4"		'신용잔고
		SCREEN.ChangeMap "IB850130"
	Case "5"		'만기연장
		SCREEN.ChangeMap "IB850140"
	Case "6"		'현금상환
		SCREEN.ChangeMap "IB850150"
	Case "7"		'현금상환취소
		SCREEN.ChangeMap "IB850160"
	Case "8"		'신용이자가계산내역조회
		SCREEN.ChangeMap "IB850170"
	Case Else
		Exit Sub
End Select
