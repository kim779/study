RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	next_btn.Enable False
	SCREEN.ClearAll 0, 2
	OBJECT0.proc "send_f", ""
End Sub

Sub send_c()
	OBJECT0.proc "send_c", ""
End Sub

_AW_ONSTART_AW_
SCREEN.OnSend = False
'If Trim(LOGIN.Brno) <> "" Then
'	If Trim(LOGIN.Brno) = 903  Or Trim(LOGIN.Brno) = 913 Then
'		tab.SetTabVisible 8, True
'	End If
'End If

zEmpNo.Data = SYSTEM.UserID

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zEmpPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Trim(zEmpPwd.Data)= "" Then
		MsgBox "비밀번호를 입력하십시오.",0,"IBK투자증권"
	Else
		Call send_f()
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zStrDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zEndDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(chkDate)
_AW_ONCLICK_AW_
If chkDate.Checked = True Then
	zStrDt.Enable = False
	zEndDt.Enable = False
Else
	zStrDt.Enable = True
	zEndDt.Enable = True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
If Trim(zEmpPwd.Data) = "" Then
	MsgBox "비밀번호를 입력하십시오.",0,"IBK투자증권"
Else
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab)
_AW_ONCLICK_AW_
GUIDE.Text = ""
chkDate.Visible = True
Select Case tab.ID
	Case 1 :
			OBJECT0.Setobject "IB872710"
	Case 2 :
			OBJECT0.Setobject "IB872720"
	Case 3 :
			OBJECT0.Setobject "IB872730"
	Case 4 :
			OBJECT0.Setobject "IB872740"
	Case 5 :
			MsgBox "준비중입니다"
'			OBJECT0.Setobject "IB872750"
	Case 6 :
			OBJECT0.Setobject "IB872720"
	Case 7 :
			OBJECT0.Setobject "IB872720"
	Case 8 :
			OBJECT0.Setobject "IB875499"
			chkDate.Visible = False
			zStrDt.Enable = True
			zEndDt.Enable = True
End Select

If Len(Trim(zEmpPwd.Data)) > 5 Then

Call send_f()

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


