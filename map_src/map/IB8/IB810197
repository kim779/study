_AW_ONDECLARE_AW_
Sub Send_F()
	Call startinit()
	LEDGER.Fkey = "C"
'	SCREEN.Send 0
	GUIDE.Text = LEDGER.Emsg
End Sub

Sub startinit
	TrxTp.Data = "4"
	RegTp.Data = "1"
	AcntNo.Data = SYSTEM.UserID
	INA.Data = "00001"
End Sub

Sub CHK_IN()
	Select Case TpText2.Data
	Case "2"
	'	MsgBox "추가인증 신청자입니다.",0,"IBK투자증권"
		OBJECT0.Send
	Case "3"
	'	MsgBox "단말기지정+추가인증 신청자입니다.",0,"IBK투자증권"
		OBJECT0.Send
	Case "4"
	   ' MsgBox "SMS이체 결과 전송 신청자입니다.",0,"IBK투자증권"
	    SCREEN.Object("parent.SMSdata").data = "C"
		SCREEN.Proc "parent.BNK_SEND2", " "
	End Select
End Sub


Sub jumingb(data)
	SYSTEM.Trace "jumingb ::: "&data
	If data = "01" Then
		If Trim(CodeNm01.Data) = "등록" Then
		'	MsgBox "전자금융피싱예방 서비스 등록 대상자 입니다. .",0,"IBK투자증권"
			If Trim(TpText2.Data) = "1" Then
			'	MsgBox "단말기 지정방법 신청자입니다.",0,"IBK투자증권"
				OBJECT0.Send
			Else
				OBJECT1.Send
			End If
		Else
		'	MsgBox "전자금융피싱예방 서비스 미등록 대상자 입니다.",0,"IBK투자증권"
			SCREEN.Proc "parent.BNK_SEND", ""
		End If
	Else
		'	MsgBox "전자금융피싱예방 서비스 미등록 대상자 입니다.",0,"IBK투자증권"
			SCREEN.Proc "parent.BNK_SEND", ""
	End If
End Sub

_AW_ONSEND_AW_
Call Send_F()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
OBJECT2.send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
