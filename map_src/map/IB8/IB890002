	If Len(Trim(OUTPUT0.Data)) <> 8 Then
		Call alert_msg("정확한 거래경험 확인을 위해 생년월일을 입력하여 주십시오")
		SCREEN.CreateWindow 1, "IB821200 /t/s/p5", ""
		Exit Sub
	Else
		If Is_numeric(OUTPUT0.Data) = False Then
			Call alert_msg("정확한 거래경험 확인을 위해 생년월일을 입력하여 주십시오")
			SCREEN.CreateWindow 1, "IB821200 /t/s/p5", ""
			Exit Sub
		End If
	End If

	Dim age
	age = CLng(Year(Now)) - CLng(Left(OUTPUT0.Data, 4)) + 1

	'거래경험 : 65세 미만 1년이상, 65세 이상 3년 이상.
	If age < 65 Then
		If CLng(OUTPUT24.Data) < 12 Then
			Call SetAlert("lessExpi")
			Exit Sub
		End If
	Else
		If CLng(OUTPUT24.Data) < 36 Then
			Call SetAlert("lessExpi")
			Exit Sub
		End If
	End If

	SCREEN.Object("parent.CHECK").Enable = True
	SCREEN.Object("parent.send_btn").Enable = True
ElseIf Trim(LEDGER.Ecod) = "3167" Then
	Call SetAlert("lessRisk") '미제공
ElseIf Trim(LEDGER.Ecod) = "3956" Then
	Call SetAlert("lessRisk") '미등록"
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
