_AW_ONDECLARE_AW_
Dim g_Ctrls

g_Ctrls = Array(EDIT0, EDIT1, EDIT2, EDIT3, EDIT4, EDIT5, EDIT6,_
	EDIT7, EDIT8, EDIT9, EDIT10, EDIT11, EDIT12, EDIT13, EDIT14, EDIT15,_
	EDIT16, EDIT17, EDIT18, EDIT19)
'----------------------------------------------------------------
Sub SetInit()
	For i = LBound(g_Ctrls) To UBound(g_Ctrls)
		g_Ctrls(i).Data = "                    "
	Next
End Sub
'----------------------------------------------------------------
Sub SetData(Data)
	ArrData = Split(Data, "|")
	For i = LBound(ArrData) To UBound(ArrData)
		g_Ctrls(i).Data = ArrData(i)
	Next
	ed_Type.Data = "I"
	SCREEN.Send 0
End Sub
'----------------------------------------------------------------
Sub OnPortfolio(confirm)
	SCREEN.SetTimerx 1, 1, False
End Sub

Sub OnPort(confirm)
	Dim groupNames, parseData, Items, codelist, row
	If UCase(confirm) <> "OK" And UCase(confirm) <> "START" Then
		Exit Sub
	End If

	Items = ""
	DX_INTEREST.SetUserName(LOGIN.Name)
	groupNames = DX_INTEREST.LoadGroupNames()

	Do While Len(groupNames) > 0
		parseData = Mid(groupNames, 1, InStr(groupNames, vbTab) -1)
		groupNames = Mid(groupNames, InStr(groupNames, vbTab) + 1)
		Items = parseData & vbTab & Items
	Loop
	If Items = "" Then
		intercombo.SetItems("")
	Else
		intercombo.SetItems(vbTab & Items)
	End If

	Call p_read_com()

	If Trim(intercombo.Data) <> "" Then
		SCREEN.Proc "OBJ1.OnGroup", intercombo.Data
	End If
End Sub

Sub p_read_com()
	If SCREEN.CreateObject("Info") Then
	 	intercombo.Data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP"))
	End If

'	SYSTEM.Trace "intercombo.Data : " & intercombo.Data
End Sub

Sub p_write_com()
	If SCREEN.CreateObject("Info") Then
	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP", intercombo.Data
	End If
End Sub

_AW_ONSTART_AW_
SCREEN.SetTimer 1, False

_AW_ONENDSUB_AW_
