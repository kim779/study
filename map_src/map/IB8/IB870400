RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim send
send = 1

Sub Set_combo()
	Dim strNow, nYear, nMonth, nday, ii, strTemp
	Dim combo, combo_data

	strNow  = Date
	nYear  = Year(strNow)
	nMonth  = Month(strNow)
	nday  = Day(strNow)

	combo = ""
	For ii = 0 To 3
		If nMonth > 3 And nMonth < 10 Then

			strTemp = nYear & "/04 ~ " & nYear & "/09"
			nMonth = 2
		Else
			strTemp = (nYear - 1) & "/10 ~ " & nYear & "/03"
			nMonth = 4
			nYear = nYear - 1
		End If

	 	combo_data = Left(strTemp, 7)
	 	combo_data = Replace(combo_data, "/", "")
	 	If ii = 0 Then
			combo = combo_data
		End If
		combo = combo & vbTab & combo_data & strTemp

	Next

	zBaseYymm.SetItems combo
	Set_tableyymm(Left(combo,6))
End Sub

Sub Set_tableyymm(i_date)
	Dim yy, ii, mm

	yy = Left(i_date,4)
	mm = Right(i_date,2)
	GRID1.SetGridCell 1, 1, yy&mm
	For ii = 1 To 6
		mm = mm + 1
		If mm > 12 Then
			mm = 1
			yy = yy + 1
		End If
		mm = cp_lpad(mm,2,"0")
		GRID1.SetGridCell ii+1, 1, yy&mm
	Next
End Sub

