_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SYSTEM.Trace "send_f ()"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)
End Sub

Sub SettingAdmin(data)
	Dim dataArray, gubn
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	gubn = dataArray(0)

	If gubn = "0030" Or gubn = "0040" Then
		EDIT1.Data = "1"
	ElseIf gubn = "0030" Then
		EDIT1.Data = "0"
	ElseIf gubn = "0470" Then
		EDIT1.Data = "2"
	End If

	SYSTEM.Trace "set admin data : " & data
	'EDIT2.Data = dataArray(0)

	EDIT2.Data = dataArray(1)
	EDIT3.Data = dataArray(2)



End Sub

_AW_ONSTART_AW_
SCREEN.SetTimer 10, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
EDIT0.Data = "00001"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call send_f()

