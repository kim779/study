_AW_ONDECLARE_AW_
Option Explicit

Function getCurrTime()
	Dim currHour, currMin, currSec
	currHour = Hour(Now)
	currMin = Minute(Now)
	currSec = Second(Now)

	If Len(currHour) = 1 Then
		currHour = "0" & currHour
	End If

	If Len(currMin) = 1 Then
		currMin = "0" & currMin
	End If

	If Len(currSec) = 1 Then
		currSec = "0" & currSec
	End If

	getCurrTime = currHour & currMin & currSec
End Function

