_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, Ordqty, chgqty

If LEDGER.Next = "Y" Then
	'Send_c()
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If
	For ii = 1 To GRID0.Rows
		If Select_no = GRID0.GetGridCell(ii , 1) Then
			GRID0.Row = ii
			GRID0.Index = ii-1
		End If
	Next

