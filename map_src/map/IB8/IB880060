_AW_ONDECLARE_AW_
Dim Select_no  '기존선택되어있던 그룹번호

Sub send_f()
	If GRID0.Row > 0 Then
		Select_no = GRID0.GetGridCell(GRID0.Row,1)
	End If
	SCREEN.ClearAll 0, 2
	LEDGER.Rcnt = "0100"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Rcnt = "0100"
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
'send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
