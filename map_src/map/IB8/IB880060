		sAcc_no = GRID0.GetGridCell(Row, 1)
		sAcc_name = GRID0.GetGridCell(Row, 2)
		row_cnt = SCREEN.Object("main.Object0.Grid0").Rows
		SCREEN.Object("main.Object0.Grid0").insertRow row_cnt
		row_cnt = row_cnt + 1
		Call SCREEN.Object("main.Object0.Grid0").SetGridCell(row_cnt, 3, sAcc_no)
		Call SCREEN.Object("main.Object0.Grid0").SetGridCell(row_cnt, 4, sAcc_name)
		Call SCREEN.Object("main.Object0.Grid0").SetGridCell(row_cnt, 6, "+")
		Call SCREEN.Object("main.Object0.Grid0").SetGridCell(row_cnt, 7, "0")
		Call SCREEN.Object("main.Object0.Grid0").SetGridCell(row_cnt, 8, ".0000000000+")
		Call SCREEN.Object("main.Object0.Grid0").SetGridCell(row_cnt, 9, "0")
		Call SCREEN.Object("main.Object0.Grid0").SetGridCell(row_cnt, 10, ".0000000000")
