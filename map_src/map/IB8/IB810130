_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	print.Enable = False
	LEDGER.Fkey = "C"
	count.Data = 0
	GRID0.SetDataPosition 0
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	print.Enable = False
	LEDGER.Fkey = "7"
	count.Data = count.Data  + 1
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0005"  ' tab/WxReport07 //설정파일 SVCCOUNT=10 ledger.rcnt 연동
print.Enable = False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

zAcntNo.data = Trim(SCREEN.Object("main.OBJ1.CMB_ACCT").Data)

If SCREEN.Object("main.UTAB0").ID <> "4" Then
	zPwd.Data = SCREEN.Object("main.OBJ1.zPwd").data

	If SYSTEM.ConnectBy = "0" Then
		If Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If
	End If
End If

lQryCnt.Data = "+000000020"

If CheckInput(zAcntNo, zPwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
Else
	SCREEN.ClearAll 0, 2
	If SCREEN.Object("main.UTAB0").ID <> "4" Then
		SCREEN.Object("main.OBJ1.zPwd").SetFocus
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
	print.Enable = True
End If

For i = 1 To GRID0.Rows
 	GRID0.SetGridCell i, 6, Trim(GRID0.GetGridCell(i,6))
 	GRID0.SetGridCell i, 11, Trim(GRID0.GetGridCell(i,11))
Next

