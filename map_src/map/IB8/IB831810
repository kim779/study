_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	InA.Data = "00001"
	Pwd.Data = Pwd1.Data
	TrxTp.Data = "1"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod),1) = "0" Then
	MsgBox Trim(LEDGER.Emsg),0,"IBK투자증권"
	SCREEN.Proc "main.clear",""
Else
	Pwd1.Clear
	Pwd1.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
If Len(Trim(Pwd1.Data)) < 4 Then
	MsgBox "계좌비밀번호를 확인하십시오",0,"IBK투자증권"
	Pwd1.SetFocus
Else
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Proc "main.close",""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


