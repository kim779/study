'==================================================
' 출고계좌명 세팅, 화면 클리어
'==================================================
Sub acct_set()
	ACNM.Text = ""
	zPwd.Clear
	isPwdConfirm.Text = ""
	isContSendChk.Text = "N"
	tmp_zIsuNo.Clear
	zIsuNo.Clear
	jmNm.Clear
	zTrxQty.Clear
	CMB_ACCT2.SetItems ""
	zBkeepAcntNo1.Clear
	zBkeepAcntNo2.Clear
	zBkeepAcntNo3.Clear
	ACNM2.Text = ""
	obj_jngo.ClearAll 2
	SCREEN.Object("parent.obj2").ClearAll 2
	obj_showCerti.Visible = False
	obj_showCerti.SetObject ""
	yangdo_set() '양도구분 초기화

	Dim accnArr
	accnArr = Split(Trim(CMB_ACCT.Text), "  ")

	If Trim(CMB_ACCT.Text) = "" Then
		Exit Sub
	End If

	ACNM.Text = Trim(accnArr(UBound(accnArr)))

	zPwd.SetFocus
End Sub

'==================================================
' 비밀번호를 맞게 입력했을 때
'==================================================
Sub RightPwd(param)
	isPwdConfirm.Text = "Y"

	If Trim(param) = "up" Then
		SCREEN.Proc "obj_jngo.send_f", ""
		SCREEN.Proc "parent.obj2.send_f", ""

		If r_yack.Checked = True Then
			Call SetYackJungAcnt()
		Else
			Call SetMiYackJungAcnt()
		End If
	ElseIf Trim(param) = "bottom" Then
		SCREEN.Proc "parent.obj2.send_f", ""
	End If
End Sub

'==================================================
' 비밀번호를 잘못 입력했을 때
'==================================================
Sub wrongPwd()
	isPwdConfirm.Text = "N"
	zPwd.SetFocus
End Sub

