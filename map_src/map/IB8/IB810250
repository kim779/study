			"o_amt" & vbTab & Trim(zTrxQty.Data) & vbLf &_
			"o_acn2" & vbTab & tmpIacnt & vbLf &_
			"i_acname" & vbTab & Trim(ACNM2.Text) & vbLf

	'20230309 국세청 요청
	If r_yangdo.Enable And r_yangdo.Checked Then
		SCREEN.CreateWindow 2, "IB810214 /p5 /d", dmsg
	ElseIf r_miyangdo.Enable And r_miyangdo.Checked And c_rcod.Visible And c_rcod.data = "02" Then
		SCREEN.CreateWindow 2, "IB81021B /p5 /d", dmsg
	Else
		SCREEN.CreateWindow 2, "IB81021C /p5 /d", dmsg
	End If

	If Trim(SYSTEM.Pop("jusik_trans")) <> "OK" Then
		Exit Sub
	End If

	Call transfer()
End Sub

