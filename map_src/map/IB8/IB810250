'==================================================
' 미약정계좌세팅
'==================================================
Sub SetMiYackJungAcnt()
	Dim myCerti, msg1, msg2, msg3
	myCerti = Trim(SCREEN.Object("main.obj_cert.zOnesfCnfTp").Data)
	msg1 = "OTP 또는 보안카드가 필요한 업무입니다."
	msg2 = "모바일 OTP를 발급 받거나, 타기관 OTP 등록 또는 당사 영업점에"
	msg3 = "방문하셔서 보안카드를 발급 받은 후 이용하여 주시기 바랍니다."

	If myCerti <> "1" And myCerti <> "3" Then
		Call alert_msg(msg1 & vbLf & vbLf & msg2 & vbLf & vbLf & msg3)
		Call guide_msg(msg1 & msg2 & msg3)
		r_yack.Checked = True
		Call SetYackJungAcnt()
		Exit Sub
	End If

	ACNM2.Text = ""
	zBkeepAcntNo1.Clear
	zBkeepAcntNo2.Data = "10"
	zBkeepAcntNo3.Clear

	CMB_ACCT2.Visible = False
	zBkeepAcntNo1.Visible = True
	zBkeepAcntNo2.Visible = True
	zBkeepAcntNo3.Visible = True
	l_zBkeepAcntNo1.Visible = True
	l_zBkeepAcntNo2.Visible = True
	acnmConfirmBtn.Enable = True
	yangdo_set() '양도구분 초기화

	zBkeepAcntNo1.SetFocus

End Sub


'==================================================
' 약정계좌 입고계좌명세팅.
'==================================================
Sub acct2_set()
	isContSendChk.Text = "Y"

	'계좌명세팅
	Call ACNM2_set()
End Sub

Sub ACNM2_set()
	If Trim(CMB_ACCT2.Data) <> "" Then
		Dim accnArr
		accnArr = Split(Trim(CMB_ACCT2.Text), "  ")

		If Trim(CMB_ACCT2.Text) = "" Then
			Exit Sub
		End If

		ACNM2.Text = Trim(accnArr(UBound(accnArr)))
	End If
End Sub

'==================================================
' 미약정계좌 입고계좌명 가져오기.
'==================================================
Function getMiYackAccnNm()
	getMiYackAccnNm = False

	If r_miyack.Checked = True Then
		If Len(Trim(zBkeepAcntNo1.Data)) < 3 Then
			Call guide_msg("입고계좌번호를 확인하여 주십시오.")
			zBkeepAcntNo1.SetFocus
			Exit Function
		End If

		If Len(Trim(zBkeepAcntNo2.Data)) < 2 Then
			Call guide_msg("입고계좌번호를 확인하여 주십시오.")
			zBkeepAcntNo2.SetFocus
			Exit Function
		End If

		If Trim(zBkeepAcntNo2.Data) = "00" Then
			Dim tmpMsg
			tmpMsg = "종합계좌번호(ex.001-00-123456)는 대체가 불가합니다." & vbLf & vbLf &_
		    		 "개별계좌번호(ex.001-10-123456)를 입력하여 주십시오."

			Call alert_msg(tmpMsg)

			zBkeepAcntNo2.SetFocus
			Exit Function
		End If

		If Len(Trim(zBkeepAcntNo3.Data)) < 6 Then
			Call guide_msg("입고계좌번호를 확인하여 주십시오.")
			zBkeepAcntNo3.SetFocus
			Exit Function
		End If

		getMiYackAccnNm = True
	End If
End Function

'==================================================
' 입력값 확인
'==================================================
Function Input_Check()
	Input_Check = False

	If Len(Trim(CMB_ACCT.Data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하여 주십시오.")
		CMB_ACCT.SetFocus
		Exit Function
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		Call alert_msg("비밀번호를 확인하여 주십시오.")
		zPwd.SetFocus
		Exit Function
	End If

	If Trim(tmp_zIsuNo.Data) = "" Or Trim(zIsuNo.Data) = "" Or Trim(jmNm.Data) = "" Then
		Call alert_msg("대체할 종목을 유가증권목록에서 선택하여 주십시오.")
		Exit Function
	End If

	If r_miyangdo.Enable = True And r_miyangdo.Checked = True And Trim(c_rcod.Data) = "00" Then
