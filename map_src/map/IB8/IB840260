Sub Set_account()
	SCREEN.ClearAll 0, 2
	hnam.Text = ""
	Call guide_msg("")
	SCREEN.Object("main.isTJSMDown").Clear
	SCREEN.Object("main.jmcd").Clear
	regYn.Clear

	cusStatusLabel.Visible = False
	cus_status.Text = ""
	cus_status.Visible = False
	cus_gradeLabel.Visible = False
	cus_grade.Text = ""
	cus_grade.Visible = False

	' 투자설명서 교부 PAGE 초기화
	obj0.SetObject ""
	obj0.SetObject "IB840277"

	lAppyQty.Clear							'청약수량
	zRebatAcntNo.SetItems("")				'환불입고계좌
	zRebatAmtMtrsfBnkAcntNo.SetItems("")	'환불이체계좌
	zRebatAcntNo_nm.SetItems("")			'환불입고계좌명
	zRebatAmtMtrsfBnkAcntNo_nm.SetItems("") '환불이체계좌명

	obj_entacc.ClearAll 2					'환불입고계좌 세팅 obj
	obj_transacc.ClearAll 2					'환불이체계좌 세팅 obj

	lAppyQty.Enable = False
	zRebatAcntNo.Enable = False
	zRebatAmtMtrsfBnkAcntNo.Enable = False
	AppyQtyBtn.Enable = False				'청약가능수량조회 버튼
	BUTTON1.Enable = False					'청약신청 버튼

	h_acnm.Clear
	h_acnm1.Clear
	h_acnm2.Clear
	hnam.Text = ""
	ABLE.Text = ""

	If Len(Trim(AN1A.Data)) = 11 Then
		ANCM.Data = AN1A.Name
		h_acnm.Data = AN1A.Name
		zpwd.Data = AN1A.Password

		If SCREEN.Object("main.UTAB0").ID = 1 Then
			Dim tmpAccn
			tmpAccn = Trim(SCREEN.Object("main.obj3.zAppyAcntNo").Data)

			If tmpAccn = "" Then
				SCREEN.Proc "main.obj3.send_f", ""
			Else
				If tmpAccn <> Trim(AN1A.Data) Then
					SCREEN.Proc "main.obj3.send_f", ""
				End If
			End If
		End If

		SCREEN.Object("parent.obj0.OBJECT0").Send

		If Len(Trim(zpwd.Data)) < 4 Then
			zpwd.SetFocus
			Exit Sub
		End If
	Else
		AN1A.SetFocus
		Exit Sub
	End If
End Sub

