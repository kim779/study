'==============================================================
Sub enterPwd()
	If Trim(SCREEN.Object("main.isProc").Data) = "진행중" Then
		Dim IsTJSM

		' 투자설명서 교부 여부
		IsTjsm = Trim(SCREEN.Object("main.isTJSMDown").Data)

		If IsTjsm = "" Then
			IsTjsm = "N"
		End If

		' 투자설명서를 교부 받은 상황
		If IsTjsm = "Y" Then
			IsClickButton.Text = 1
			r_account.Data = AN1A.Data
			obj_yesu.Send
			SCREEN.Proc "obj_udae.send_f", ""
			Call setTJSMReg()
		Else
			Call guide_msg("투자설명서를 다운받아 주십시오.")

			' Highlight
			SCREEN.SetTimerX 1, 3, False

			Call scrDisAble()
		End If
	Else
		If Trim(SCREEN.Object("main.jmcd").Data) = "" Then
			Call guide_msg("청약종목 목록에서 청약하실 종목을 더블클릭하여 주십시오.")
		Else
			Call guide_msg("청약기간이 아니거나 청약이 마감된 종목입니다.")
		End If
	End If

	Call Set_focus()
End Sub

