Option Explicit


Sub send_f()
	' 계좌 비밀번호 검증
	Dim emsg
	If l_pswdConfirm(AN1A.Data, zpwd.Data, emsg) = False Then
		SCREEN.Object("Main.GUIDE").Text = Trim(emsg)
		zpwd.SetFocus()
		Exit Sub
	End If

	' 고객 투자자성향 조회 및 예수금, 우대고객 여부 조회
	'    => 2023.12.14 고객 투자자성향은 조회하지 않음
	If CheckInput(AN1A, zpwd) = True Then
		If Trim(SCREEN.Object("main.jmcd").Data) = "" Then
			Call alert_msg("청약목록에서 청약하실 종목을 더블클릭하여 주십시오.")
		Else
			isOrder.Data = "0"
			Call chkTJSMDownYn()
		End If
	End If
End Sub


' ====================================================================================
'  주문 :: obj_cusstatus OBJ에서 고객 투자정보 확인서 및 동의 사항 상태 조회 후 주문
' ====================================================================================
Sub Order()
	Dim dmsg, qty, nm

	' 주문 상태 해제
	isOrder.Data = "0"

	If Len(Trim(AN1A.Data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하여 주십시오.")
		AN1A.SetFocus
		Exit Sub
	End If

	If Len(Trim(zpwd.Data)) < 4 Then
		Call alert_msg("비밀번호를 확인하여 주십시오.")
		zpwd.SetFocus
		Exit Sub
	End If

	If Trim(zIsuNo_chae.Data) = "" And Trim(zIsuNo.Data) = "" Then
		Call alert_msg("왼쪽 상단의 청약내역에서 종목을 더블클릭하여 주십시오.")
		BUTTON1.SetFocus
		Exit Sub
	End If

	If is_numeric(lAppyQty.Data) = False Then
		Call alert_msg("청약수량을 확인하여 주십시오.")
		lAppyQty.SetFocus
		Exit Sub
	End If

	If (lAppyQty.Data Mod 10) <> 0 Then
		Call alert_msg("입력된 수량이 청약가능수량이 아닙니다. 청약단위를 확인해 주세요.")
		lAppyQty.SetFocus
		Exit Sub
	End If


	If Trim(SCREEN.Object("main.isTJSMDown").Data) <> "Y" Then
		Call alert_msg("설명서 및 동의내용을 확인해 주세요.")
		' Highlight
		SCREEN.SetTimerX 1, 3, False
		Exit Sub
	End If

	If SCREEN.Object("obj0.tjsmChk").Enable = True And SCREEN.Object("obj0.tjsmChk").Checked = False Then
		Call alert_msg("설명서 및 동의내용을 확인해 주세요.")
		' Highlight
		SCREEN.Object("obj0.tjsmChk").SetFocus()
		obj0.Proc "view_highlight", ""
		Exit Sub
	End If

	If SCREEN.Object("obj0.tjsmChk2").Enable = True And SCREEN.Object("obj0.tjsmChk2").Checked = False Then
		Call alert_msg("설명서 및 동의내용을 확인해 주세요.")
		SCREEN.Object("obj0.tjsmChk2").SetFocus()
		' Highlight
		obj0.Proc "view_highlight", ""
		Exit Sub
	End If

	If SCREEN.Object("obj0.tjsmChk3").Enable = True And SCREEN.Object("obj0.tjsmChk3").Checked = False Then
		Call alert_msg("설명서 및 동의내용을 확인해 주세요.")
		SCREEN.Object("obj0.tjsmChk3").SetFocus()
		' Highlight
		obj0.Proc "view_highlight", ""
		Exit Sub
	End If

	If SCREEN.Object("obj0.tjsmChk4").Visible = True And SCREEN.Object("obj0.tjsmChk4").Enable = True And SCREEN.Object("obj0.tjsmChk4").Checked = False Then
		Call alert_msg("설명서 및 동의내용을 확인해 주세요.")
		SCREEN.Object("obj0.tjsmChk4").SetFocus()
		' Highlight
		obj0.Proc "view_highlight", ""
		Exit Sub
	End If

	If jusik.Checked = True Then
		' 주식코드
		nm = Trim(jusik_nm.Text) & " (" & Trim(zIsuNo.Text) & ")"
	ElseIf chae.Checked = True Then
		' 채권코드
		nm = Trim(chae_nm.text) & " (" & Trim(zIsuNo_chae.Text) & ")"
	End If

	dmsg = "o_acno" & vbTab & AN1A.Data & vbLf &_
	   "o_acnm" & vbTab & ANCM.Data & vbLf &_
	   "o_hnam" & vbTab & nm & vbLf &_
	   "o_jqty" & vbTab & lAppyQty.data & vbLf &_
	   "o_yuqty" & vbTab & zRebatAcntNo.Text & vbLf &_
	   "o_yuamt" & vbTab & zRebatAmtMtrsfBnkAcntNo.Text & vbLf

	SCREEN.CreateWindow 2, "IB84026A /p5 /d", dmsg

	If SYSTEM.Pop("kongmo_masu_order") <> "OK" Then
		Exit Sub
	Else
		' 은행 예수금 계좌인 경우 obj_getMoney에서 은행 예수금 출금 후 청약
		If IsBnkAccnType(AN1A) = True Then
			If lAppyQty.Enable = False Then
				SCREEN.Proc "obj_getMoney.contributionBnk", Trim(lAppyAmt.Data)
			Else
				Dim percent, danga, money
				percent = Trim(SCREEN.Object("main.obj0.d3GrpAppyMgnrt").Data)
				danga = Trim(SCREEN.Object("main.obj0.dFltnPrc").Data)
				money = lAppyQty.Data * percent * danga
				SCREEN.Proc "obj_getMoney.contributionBnk", money
			End If
		Else
			Call send_o()
		End If
	End If
End Sub

