Sub stockReplaceProc()
	LEDGER.Svcd = "SDPET005"
	zIn1.Data = "00001"
	zCardFirmNo.Data = ""
	zCardAcntNo.Data = ""
	zCardPtnCode.Data = ""
	zCardIssCnt.Data = "+000000000"
	zMgrCardFirmNo.Data = ""
	zMgrCardAcntNo.Data = ""
	zMgrCardPtnCode.Data = ""
	zMgrCardIssCnt.Data = "+000000000"
	zClntCardMsdata.Data = ""
	zMgrCardMsdata.Data = ""
	zSecoutAcntNo.Data = Trim(SCREEN.Object("parent.CMB_ACCT").Data)
	zPwd1.Data = Trim(SCREEN.Object("parent.zPwd").Data)
	LEDGER.Hsiz = 44
	LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd1.Data))
	zPwd1.Data = "HEAD"

	zIsuNo1.Data = Trim(SCREEN.Object("parent.zIsuNo").Data)
	zBkeepQty_giho.Data = "+"
	zBkeepQty.Data = l_zeropad(SCREEN.Object("parent.zTrxQty"))

	If SCREEN.Object("parent.r_jusik").Checked = True Then
		zSecoutBuyDate.Data = ""
		zTxontTp1.Data = ""
	Else
		zSecoutBuyDate.Data = Trim(SCREEN.Object("parent.zBuyDate").Data)
		zTxontTp1.Data = Trim(SCREEN.Object("parent.zTxontTp").Data)
	End If

	If SCREEN.Object("parent.r_yack").Checked = True Then
		zSecinAcntNo.Data = Trim(SCREEN.Object("parent.CMB_ACCT2").Data)
	Else
		zSecinAcntNo.Data = Trim(SCREEN.Object("parent.zBkeepAcntNo1").Data) & Trim(SCREEN.Object("parent.zBkeepAcntNo2").Data) &_
							Trim(SCREEN.Object("parent.zBkeepAcntNo3").Data)
	End If

	Dim rcod
	' "미약정 & 양도구분:양도" 인 경우만 1:양도
	If SCREEN.Object("parent.r_miyack").Checked = True And _
		SCREEN.Object("parent.r_yangdo").Checked = True Then

		If SCREEN.Object("parent.r_yangdo").Enable = True Then
			zTrsfTp.Data = "1"	'1.양도거래
		Else
			zTrsfTp.Data = ""
		End If
		rcod = ""

	Else
		If SCREEN.Object("parent.r_miyangdo").Enable = True Then
			zTrsfTp.Data = "2"	'2.미양도 (양도외거래)
		Else
			zTrsfTp.Data = ""
		End If

		'사유코드
		If Trim(SCREEN.Object("parent.c_rcod").Data) = "00" Then
			rcod = ""
		Else
			rcod = Trim(SCREEN.Object("parent.c_rcod").Data)
		End If
	End If

	zTrsfExcpRsn.Data = "" '양도제외사유
	zRsnCode.Data = rcod '사유코드 : 01.본인 02.수증 03.상속 04.대차 05.기타

	zSecinUprc.Data = "+000000000000"
	zFcstckTrdUprc.Data = "+000000000.0000"
