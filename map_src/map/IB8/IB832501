RESOURCE DIVISION
{


_AW_ONSEND_AW_
juno.Data = LOGIN.juno

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim rcnt, ii, acnt, acnm, txt, item
txt = ""
item = ""
rcnt = CLng(Trim(o_rec.Data))
If rcnt > 0 Then
	For ii=1 To rcnt
		acnt = Trim(GRID0.GetGridCell(ii, 1))
		AN1C.Data = acnt
		acnm = AN1C.NAME
		GRID0.SetGridCell ii, 2, acnm

		txt = Mid(acnt,1,3) & "-" & Mid(acnt, 4, 2) & "-" & Mid(acnt, 6)
		acnt = acnt & "|" & ii
		item = item & acnt & txt & vbTab
		If ii=1 Then
			item = Mid(item, 1, 13) & vbTab & item
		End If
	Next
	SCREEN.Object("parent.cmb_acnt").Enable = True
	SCREEN.Object("parent.cmb_acnt").SetItems item
	SCREEN.Object("parent.ACNM").Data = Trim(GRID0.GetGridCell(1, 2))
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
