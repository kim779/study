RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	inA.Data = "00001"
	QryTp.Data = QryTp_1.Data
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
MgempNo.Data = SYSTEM.UserID

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0015"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod),1) = "0" Then
	If LEDGER.Next = "Y" Then
		send_c()
	End If
Else
	SCREEN.ClearAll 0, 2
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONDBLCLK_AW_
If Trim(GRID0.GetGridCell(GRID0.Row, 1)) <> "" Then
	SCREEN.CreateWindow 1, "IB622300 /t/d/p5/S", _
	"ACCN" & vbTab & Trim(GRID0.GetGridCell(GRID0.Row, 1)) & vbLf
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(QryTp_1)
_AW_ONCHANGE_AW_
If QryTp_1.data = 2 Then
	MgempNo.Data = SYSTEM.UserID
	CnvsEmpNo.Data = ""
	L4.Visible = True
	L5.Visible = False
	CnvsEmpNo.Visible = False
	MgempNo.Visible = True
Else
	MgempNo.Data = ""
	CnvsEmpNo.Data = SYSTEM.UserID
	L4.Visible = False
	L5.Visible = True
	CnvsEmpNo.Visible = True
	MgempNo.Visible = False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


