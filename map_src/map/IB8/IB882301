_AW_ONDECLARE_AW_
Dim g_ArrItem
Dim g_ArrData
Dim g_ArrCtrls

'Index :
'	0 - 종목코드
'	1 - 매도호가
'	2 - 매도수량
'	3 - 매수호가
'	4 - 매수수량
'	5 - 행사가격
'	6 - 거래단위 : 거래승수가 10만원이면 5이고, 50만원이면 1이다.
g_ArrItem = Array("", 0, 0, 0, 0, 0, 0)

'Index :
'	0 - 콜옵션
'	1 - 풋옵션
g_ArrData = Array(g_ArrItem, g_ArrItem)

g_ArrCtrls = Array(Array(ot_Con, ot_ConVol, ot_Rev, ot_RevVol),_
	Array(rb_Con, rb_Rev))
'------------------------------------------------------
Sub InitData()
	chk_auto.Checked = False
	ck_Order.Checked = False
	ed_Prc.Data = "0"
	ed_Vol.Data = "0"
End Sub
'------------------------------------------------------
Sub SendData(OptItemCd)
	Call InitData()
	COPT_OBJ.Proc "SendOptData", "2" & Mid(OptItemCd, 2, 7)
	POPT_OBJ.Proc "SendOptData", "3" & Mid(OptItemCd, 2, 7)
End Sub
'------------------------------------------------------
Sub SetData(Data)
	ArrData = Split(Data, "|")
'MsgBox "SetData = " & Data
	Index = -1

	If Mid(ArrData(0), 1, 1) = "2" Or Mid(ArrData(0), 1, 1) = "B" Then		'콜옵션
		Index = 0
	ElseIf Mid(ArrData(0), 1, 1) = "3" Or Mid(ArrData(0), 1, 1) = "C" Then		'풋옵션
		Index = 1
	Else
		Exit Sub
	End If

	For i = LBound(g_ArrData(Index)) To UBound(g_ArrData(Index))
		'MsgBox i & "|" & ArrData(i)
		If i > 0 Then
			g_ArrData(Index)(i) = Abs(CDbl(ArrData(i)))
		Else
			g_ArrData(Index)(i) = ArrData(i)
		End If
	Next
	CalcData
End Sub
'------------------------------------------------------
Function GetMinVol(ArrVolData)
	GetMinVol = ArrVolData(0)

	For i = 1 To UBound(ArrVolData)
		If GetMinVol > ArrVolData(i) Then
			GetMinVol = ArrVolData(i)
		End If
	Next
End Function

'------------------------------------------------------
Sub CalcData()
	If Len(g_ArrData(0)(0)) = 0 Or Len(g_ArrData(1)(0)) = 0 Then
		Exit Sub
	End If
'MsgBox "CalcData = " & g_ArrData(0)(1)
	ExerPrc = g_ArrData(0)(5) '콜옵션 행사가격
'MsgBox "콜옵션 행사가격 = " & ExerPrc
	ArrVolData = Array(0, 0)
	'합성매도 계산
	CBidPrc = g_ArrData(0)(3)	'콜옵션 매수호가
	PAskPrc = g_ArrData(1)(1)	'풋옵션 매도호가

	If CBidPrc = 0 Or PAskPrc = 0 Then
		Exit Sub
	End If

	Con = (ExerPrc + CBidPrc) - PAskPrc
	ArrVolData(0) = g_ArrData(0)(4)	'콜옵션 매수수량
	ArrVolData(1) = g_ArrData(1)(2)	'풋옵션 매도수량

	Vol = GetMinVol(ArrVolData)
	If Con > 0 Then
		g_ArrCtrls(0)(0).Data = "+" & FormatNumber(Con, 2, -2, -2, 0)
	Else
		g_ArrCtrls(0)(0).Data = FormatNumber(Con, 2, -2, -2, 0)
	End If
	g_ArrCtrls(0)(1).Data = Vol

	'합성매수 계산
	CAskPrc = g_ArrData(0)(1)
	PBidPrc = g_ArrData(1)(3)

	If  CAskPrc = 0 Or PBidPrc = 0 Then
		Exit Sub
	End If

	Rev = (ExerPrc + CAskPrc) - PBidPrc
	ArrVolData(0) = CLng(g_ArrData(0)(2))
	ArrVolData(1) = CLng(g_ArrData(1)(4))
	Vol = GetMinVol(ArrVolData)

	If Rev > 0 Then
		g_ArrCtrls(0)(2).Data = "+" & FormatNumber(Rev, 2, -2, -2, 0)
	Else
		g_ArrCtrls(0)(2).Data = FormatNumber(Rev, 2, -2, -2, 0)
	End If
	g_ArrCtrls(0)(3).Data = Vol

	ExecOrder

End Sub
'-------------------------------------------------------------------------------------
Function GetData(StrData, DataType)
	GetData = 0

	Data = Trim(StrData)
	If Len(Data) = 0 Then
		Exit Function
	Else
		If DataType = 1 Then			'CDBL
			GetData = CDbl(Data)
		Else							'CLNG
			GetData = CLng(Data)
		End If
	End If
End Function
'------------------------------------------------------
Sub ExecOrder()
'MsgBox "ExecOrder"
	If Not ck_Order.Checked Then
		Exit Sub
	End If

	SetValue = GetData(ed_Prc.Data, 2)/100		'설정가격
	SetVol = GetData(ed_Vol.Data, 1)			'설정수량

	If SetVol = 0 Then
		Exit Sub
	End If

	OrdValue = 0
	OrdVol = 0

	OptDrn = g_ArrData(1)(6)	'거래단위 : 거래승수가 10만원이면 5이고, 50만원이면 1이다.

	'0:종목코드, 1:매도(1), 매수(3), 2:가격, 3:수량
	'FutArrItem = Array("", 0, 0, 0)
	COptArrItem = Array("", 0, 0, 0)
	POptArrItem = Array("", 0, 0, 0)
	If rb_Con.Checked Then				'합성매도
		OrdValue = GetData(ot_Con.Data, 1)
		OrdVol = GetData(ot_ConVol.Data, 2)

		If OrdVol = 0 Then
			Exit Sub
		End If

		If SetVol > OrdVol Then
			Exit Sub
		End If

		If SetValue > OrdValue Then
			Exit Sub
		End If

		If OrdVol > SetVol Then
			OrdVol = SetVol
		End If

		SetItem 0, 1, OrdVol*OptDrn, COptArrItem
		SetItem 1, 3, OrdVol*OptDrn, POptArrItem

	Else								'합성매수
		OrdValue = GetData(ot_Rev.Data, 1)
		OrdVol = GetData(ot_RevVol.Data, 2)

		If OrdVol = 0 Then
			Exit Sub
		End If

		'조건1 OrdVol >= SetVol
		If SetVol > OrdVol Then
			Exit Sub
		End If

		'조건2 OrdValue <= SetValue
		If OrdValue > SetValue   Then
			Exit Sub
		End If

		If OrdVol > SetVol Then
			OrdVol = SetVol
		End If

		SetItem 0, 3, OrdVol*OptDrn, COptArrItem
		SetItem 1, 1, OrdVol*OptDrn, POptArrItem
	End If

	CData = Join(COptArrItem, "~")
	PData = Join(POptArrItem, "~")

	Data = CData & "|" & PData

	'데이타를 넘겨주는곳
	LABEL0.Data = Data
	ck_Order.Checked = False
	chk_auto.Checked = False
	SCREEN.Proc "main.call_jumun", Data
End Sub
'------------------------------------------------------
Sub SetItem(ItemIdx, AskBidType, Vol, ArrData)
	ArrData(0) = g_ArrData(ItemIdx)(0)
	ArrData(1) = AskBidType
	If ASkBidType = 1 Then
		ArrData(2) = g_ArrData(ItemIdx)(3)
	ElseIf ASkBidType = 3 Then
		ArrData(2) = g_ArrData(ItemIdx)(1)
	End If
	ArrData(3) = Vol
End Sub
'------------------------------------------------------
Sub AllSell()
	ck_Order.Checked = True
	chk_auto.Checked = True
End Sub

