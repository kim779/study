RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN1A.name
	pswd.Data = AN1A.Password

	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If

	If Trim(pswd.Data) = "" Then
		pswd.SetFocus
		Exit Sub
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(pswd)

GUIDE.Text = ""

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim accn, pass

accn = AN1A.Data
pass = pswd.Data

If Trim(accn) = "" Then
	AN1A.SetFocus
	SCREEN.OnSend = False
	Exit Sub
End If

If Len(Trim(pass)) < 4 Then
	pswd.SetFocus
	SCREEN.OnSend = False
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(b_ok)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(pswd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 And Trim(pswd.Data) <> "" Then
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



