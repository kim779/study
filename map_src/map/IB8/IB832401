RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
LEDGER.Rcnt = "0025"
zElecfnUserId.Data = LEDGER.Usid

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, items, items2, str, name, ArrData

ArrData = Array()

If Trim(LEDGER.Next) = "Y" Then
	send_c()
Else
	GRID0.Sort 9, True, True

	ReDim ArrData(GRID0.Rows + 1)
	For ii=1 To GRID0.Rows
		str = Trim(GRID0.GetGridtext(ii, 9))
		name = Trim(GRID0.GetGridtext(ii,10))
		ArrData(ii - 1) = Mid(str, 1, 3) & Mid(str, 5, 2) & Mid(str, 9, 6)
		If Mid(str,5,2) <> "00" And Len(Trim(GRID0.GetGridCell(ii,9))) = 11 Then
			items = items & vbTab & str
			items2 = items2 & vbTab & name
		End If
	Next
	Data = Join(ArrData, "|")
	SCREEN.Proc "main.SetGridData", Data
	SCREEN.Proc"main.SendQ_TR", ""

'	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(Out)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
