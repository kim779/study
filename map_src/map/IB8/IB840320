_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	ANCM.Data = AN1A.Name
	h_acnm.Data = AN1A.Name
	zpwd.Data = AN1A.Password

	If Len(Trim(AN1A.Data)) <> 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	SCREEN.Object("main.obj2").Send

	If Len(Trim(zpwd.Data)) < 4 Then
		zpwd.SetFocus
		Exit Sub
	End If
End Sub

'== 첫 조회
Sub send_o()
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

Sub confirmOrder()
	SYSTEM.Push "yusang_cancel_order", ""

	If Len(Trim(AN1A.Data)) <> 11 Then
		MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"
		AN1A.SetFocus
		Exit Sub
	End If

	If Len(Trim(zpwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zpwd.SetFocus
		Exit Sub
	End If

	If Trim(zIsuNo.Data) = "" Then
		MsgBox "종목을 확인하여 주십시오.", , "IBK투자증권"
		zIsuNo.SetFocus
		Exit Sub
	End If

	Dim dmsg
	dmsg = "o_acno" & vbTab & AN1A.Data & vbLf &_
		   "o_acnm" & vbTab & ANCM.Data & vbLf &_
	   	   "o_hnam" & vbTab & jmNm.Data & vbLf

	SCREEN.CreateWindow 2, "IB84032A /p5 /d", dmsg

	If SYSTEM.Pop("yusang_cancel_order") <> "OK" Then
		Exit Sub
	End If

	Call send_o()
End Sub

