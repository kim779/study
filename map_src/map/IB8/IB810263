RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

Sub send_f()
	SCREEN.ClearAll 0, 0
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0015"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
zAcntNo.Data = SCREEN.Object("parent.CMB_ACCT").Data

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call guide_msg("출고계좌를 확인하여 주십시오.")
	SCREEN.Object("main.obj1.CMB_ACCT").SetFocus
	Exit Sub
End If

zPwd.Data = SCREEN.Object("parent.zPwd").Data

If Len(Trim(zPwd.Data)) < 4 Then
	Call guide_msg("출고계좌비밀번호를 확인하여 주십시오.")
	SCREEN.Object("main.obj1.zPwd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	If LEDGER.Next = "Y" Then
		SCREEN.Object("parent.next_btn").Enable = True
	Else
		SCREEN.Object("parent.next_btn").Enable = False
	End If

	Dim ii, tmpJmcd, tel1, tel2, tel3, comTel1, comTel2, comTel3

	For ii = gridPos To GRID0.Rows
		'종목코드
		tmpJmcd = Trim(GRID0.GetGridCell(ii, 8))

		If Trim(tmpJmcd) = "" Then
			Exit Sub
		End If

		If Len(Trim(tmpJmcd)) = 7 And (Left(Trim(tmpJmcd), 1) = "A" Or Left(Trim(tmpJmcd), 1) = "J" Or Left(tmpJmcd, 1) = "Q") Then
			tmpJmcd = Mid(Trim(tmpJmcd), 2)
		End If

		GRID0.SetGridCell ii, 9, tmpJmcd

		tel1 = Trim(GRID0.GetGridCell(ii, 31))
		tel2 = Trim(GRID0.GetGridCell(ii, 32))
		tel3 = Trim(GRID0.GetGridCell(ii, 33))
		comTel1 = Trim(GRID0.GetGridCell(ii, 34))
		comTel2 = Trim(GRID0.GetGridCell(ii, 35))
		comTel3 = Trim(GRID0.GetGridCell(ii, 36))

		GRID0.SetGridCell ii, 37, tel1 & "-" & tel2 & "-" & tel3
		GRID0.SetGridCell ii, 38, comTel1 & "-" & comTel2 & "-" & comTel3
	Next

	gridPos = GRID0.Rows + 1
Else
	If Trim(LEDGER.Ecod) <> "2679" Then	'조회내역이 없습니다.
		Call alert_msg(Trim(LEDGER.Emsg))
	End If

	SCREEN.Object("parent.next_btn").Enable = False
End If

Call guide_msg(Trim(LEDGER.Emsg))

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim trxDt, trxSeq, jmcd, fullJmcd, jmQty, jongmokNm, buyDt, taxGb, compCd, compBrCd, compAcnt, tel1, tel2, tel3, comTel1, comTel2, comTel3
fullJmcd = Trim(GRID0.GetGridCell(GRID0.Row, 8))

If fullJmcd = "" Then
	Exit Sub
End If

trxDt = Trim(GRID0.GetGridCell(GRID0.Row, 2))
trxSeq = Mid(Trim(GRID0.GetGridCell(GRID0.Row, 4)), 2)
jmcd = Trim(GRID0.GetGridCell(GRID0.Row, 9))
fullJmcd = Trim(GRID0.GetGridCell(GRID0.Row, 8))
jongmokNm = Trim(GRID0.GetGridCell(GRID0.Row, 10))
jmQty = Trim(GRID0.GetGridCell(GRID0.Row, 11))
buyDt = Trim(GRID0.GetGridCell(GRID0.Row, 12))
taxGb = Trim(GRID0.GetGridCell(GRID0.Row, 13))
compCd = Trim(GRID0.GetGridCell(GRID0.Row, 15))
compBrCd = Trim(GRID0.GetGridCell(GRID0.Row, 16))
compAcnt = Trim(GRID0.GetGridCell(GRID0.Row, 17))
tel1 = Trim(GRID0.GetGridCell(GRID0.Row, 31))
tel2 = Trim(GRID0.GetGridCell(GRID0.Row, 32))
tel3 = Trim(GRID0.GetGridCell(GRID0.Row, 33))
comTel1 = Trim(GRID0.GetGridCell(GRID0.Row, 34))
comTel2 = Trim(GRID0.GetGridCell(GRID0.Row, 35))
comTel3 = Trim(GRID0.GetGridCell(GRID0.Row, 36))

SCREEN.Object("parent.zTrxDate").Data = trxDt
SCREEN.Object("parent.zSeqNo").Data = trxSeq
SCREEN.Object("parent.tmp_zIsuNo").Data = Trim(jmcd)
SCREEN.Object("parent.zIsuNo").Data = Trim(fullJmcd)
SCREEN.Object("parent.jmNm").Data = Trim(jongmokNm)
SCREEN.Object("parent.zTrxQty").Data = Trim(jmQty)
SCREEN.Object("parent.zBuyDate").Data = Trim(buyDt)
SCREEN.Object("parent.zTxontTp").Data = Trim(taxGb)
SCREEN.Object("parent.zOtcoNo").Data = compCd
SCREEN.Object("parent.zOtcoBrnNo").Data = compBrCd
SCREEN.Object("parent.zBkeepAcntNo").Data = compAcnt

SCREEN.Object("parent.zTelRgno").Data = tel1
SCREEN.Object("parent.zTelExno").Data = tel2
SCREEN.Object("parent.zTelSeqno").Data = tel3
SCREEN.Object("parent.zSecinSecompTelRgno").Data = comTel1
SCREEN.Object("parent.zSecinSecompTelExno").Data = comTel2
SCREEN.Object("parent.zSecinSecompTelSeqno").Data = comTel3

If Len(Trim(jmcd)) = 6 Then
	SCREEN.Object("parent.l_zTrxQtyUnit").Text = "(주)"
	SCREEN.Object("parent.l_zBuyDt").Visible = False
	SCREEN.Object("parent.zBuyDate").Visible = False
	SCREEN.Object("parent.zTxontTp").Visible = False
