'***************************************************************************
'	Func : Find_Row
'***************************************************************************
Function Find_Row(sKey)
	Dim sCode, sGubn, sDate, jGubn

	jGubn = Mid(skey, 1, 2)		'잔고구분
	sCode = Mid(sKey, 3, 12)	'코드
	sDate = Mid(sKey, 15, 8)	'대출일
	sGubn = Mid(sKey, 23, 2)	'신용구분

	For row = 1 To VIEWGRID.Rows
		If Trim(sCode) = Trim(VIEWGRID.GetGridCell (row, 2)) _
				And Trim(sGubn) = Trim(VIEWGRID.GetGridCell (row, 13)) _
				And Trim(sDate) = Trim(VIEWGRID.GetGridCell (row, 14)) _
				And Trim(jGubn) = Trim(VIEWGRID.GetGridCell (row, 4)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

