'***************************************************************************
'	Func : All check
'***************************************************************************
Sub all_check()
	Dim cnt
	cnt = 0
	If Trim(VIEWGRID.GetGridCell(1,1)) <> "" Then
		If C_all.Checked = True Then
			For i = 1 To VIEWGRID.Rows
				If Trim(VIEWGRID.GetGridCell(i, 2)) <> "" Then
					VIEWGRID.SetGridCell i , 1, 1
					cnt = cnt + 1
				End If
			Next
			If cnt > 0 Then
				SCREEN.Object("parent.B_xodr").Enable = True
			End If
		ElseIf C_all.Checked = False Then
			For i = 1 To VIEWGRID.Rows
				VIEWGRID.SetGridCell i ,1, 0
			Next
			SCREEN.object("parent.B_xodr").Enable = False
		End If
	End If
End Sub

