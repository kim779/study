RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0015"

Call Check_LoginType(zPwd)

'SCREEN.SetTimer 8, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("parent.GUIDE").Text = ""

zAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)
zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

If Len(Trim(zAcntNo.Data)) < 11 Then
	MsgBox "계좌번호를 확인하십시오.",,"IBK투자증권"
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = "0" And Trim(SCREEN.Object("parent.zPwd").Data) = "" Then
	zPwd.Data = "9999"
Else
	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 확인하십시오.",,"IBK투자증권"
		SCREEN.Object("parent.zPwd").SetFocus
		Exit Sub
	End If
End If

If SCREEN.GetCodeType(Trim(S1301.Data)) <> 27 Then
	zIsuNo_A.Data = "A"
Else
	zIsuNo_A.Data = "Q"
End If


SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If SCREEN.Object("main.sec").Data = "1" Then
	 SCREEN.Object("main.zPwd").SetFocus
ElseIf SCREEN.Object("main.sec").Data = "2" Then
	 SCREEN.Object("main.send_btn").SetFocus
ElseIf SCREEN.Object("main.sec").Data = "3" Then
	 SCREEN.Object("main.next_btn").SetFocus
ElseIf SCREEN.Object("main.sec").Data = "4" Then
	 SCREEN.Object("main.BUTTON1").SetFocus
ElseIf SCREEN.Object("main.sec").Data = "5" Then
	 SCREEN.Object("main.extend_btn").SetFocus
End If

If LEDGER.Next = "Y" Then
	SCREEN.Object("main.next_btn").Enable = True
Else
	SCREEN.Object("main.next_btn").Enable = False
End If

SCREEN.Object("parent.zPwd").SetFocus

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If SYSTEM.ConnectBy = "1" Then
	If Len(Trim(SCREEN.Object("parent.zPwd").Data)) < 4 Then
		SCREEN.Object("parent.zPwd").SetFocus
		Exit Sub
	End If
End If

Call send_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
'	Call send_f()
	SCREEN.Send 0
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_

If GRID0.HitPos = 3 Then

'	SYSTEM.Trace "IB850151 grid14 = " & Trim(GRID0.GetGridCell(GRID0.Row, 14))
'	SYSTEM.Trace "IB850151 grid15 = " & Trim(GRID0.GetGridCell(GRID0.Row, 15))

	If Trim(GRID0.GetGridCell(GRID0.Index +1, 13)) <> "" Then
		SCREEN.Object("main.zLoanDt").data = GRID0.GetGridCell(GRID0.Index +1, 1)		'--대출일
		SCREEN.Object("main.1301").data = Left(GRID0.GetGridCell(GRID0.Index +1, 4), 6)	'--종목번호
		SCREEN.Object("main.lRfundQty").data = GRID0.GetGridCell(GRID0.Index +1, 13)	'--대출가능수량
		SCREEN.Object("main.zLoanDtlClssCode").data = GRID0.GetGridCell(GRID0.Index +1, 6)     '==분류코드

		If GRID0.GetGridCell(GRID0.Index +1, 13) > 0 Then
			SCREEN.Object("main.extend_btn").Enable = True
		Else
			SCREEN.Object("main.extend_btn").Enable = False
		End If

		SCREEN.Proc "main.oper_obj", Left(GRID0.GetGridCell(GRID0.Index +1, 4), 6)		'--종목번호

		'트리거 날리기
		S1301.DATA = Trim(GRID0.GetGridCell(GRID0.Row, 4))

		If S1301.DATA = "" Then
			Exit Sub
		End If

		S1301.Trigger "1301", False
		S1301.Trigger "1301", True
		SYSTEM.SetHistory "1301", S1301.DATA
	ElseIf Trim(GRID0.GetGridCell(GRID0.row, 13)) = "" And Trim(GRID0.GetGridCell(GRID0.row, 14)) = "" Then
		SCREEN.Object("main.1301").Clear
		SCREEN.Object("main.OBJECT0").ClearAll 0
		'SCREEN.Object("main.OBJECT0").Send
		SCREEN.Object("main.lRfundQty").Clear
		SCREEN.Object("main.zLoanDt").Data = getCurrDay()

		SCREEN.Object("main.1301").SetFocus
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


