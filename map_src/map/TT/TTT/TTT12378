_AW_ONDECLARE_AW_
'대분류 조회
Sub Dae_s()
	Dim FSO, F, ReadData, Code, Value, Arry, item
	Set FSO = CreateObject("Scripting.FileSystemObject")
	Set F = FSO.OpenTextFile(SYSTEM.Home & "\tab\KRSTCODE.dat", 1)
	item = "01" & vbTab & "*선택하세요" & vbTab
	Do While F.AtEndOfLine <> True
		ReadData = F.ReadLine
		Arry = Split(ReadData, vbTab, -1 ,1)
		Code = Arry(0)
		Value = Arry(1)
		If Len(Trim(Code)) = 1 Then
   			item = item & Trim(Code) & Trim(Value) & vbTab
   		End If
   	Loop
   	Daebun.SetItems(item)
   	Daebun.Index  = 00
End Sub

'중분류 조회
Sub Jung_s()
	Dim item
	If Trim(Daebun.Data) = "*" Then
		Jungbun.Setitems(item)
		Sobun.SetItems(item)
		Sebun.SetItems(item)
		Exit Sub
	Else
		GRID0.Clear
		Dim FSO, F, ReadData, Code, Value, Arry, Daef
		Set FSO = CreateObject("Scripting.FileSystemObject")
		Set F = FSO.OpenTextFile(SYSTEM.Home & "\tab\KRSTCODE.dat", 1)
		Sobun.SetItems(item)
		Sebun.SetItems(item)
		Daef = False
		item = "02" & vbTab & "**선택하세요" & vbTab
		Do While F.AtEndOfLine <> True
			ReadData = F.ReadLine
			Arry = Split(ReadData, vbTab, -1 ,1)
			Code = Arry(0)
			Value = Arry(1)
			If Len(Trim(Code)) = 1 And Trim(Daebun.Data) = Trim(Code) Then
				Daef = True
			ElseIf Len(Trim(Code)) = 1 And Trim(Daebun.Data) <> Trim(Code) Then
	   			Daef = False
	   		End If
	   		If Len(Trim(Code)) = 2 And Daef = True Then
	   			item = item & Trim(Code) & Trim(Value) & vbTab
	   		End If
	   	Loop
	   	Jungbun.SetItems(item)
	   	Jungbun.Index  = 00
	End If
End Sub

