			Sof = True
		ElseIf Len(Trim(Code)) = 3 And Trim(Sobun.Data) <> Trim(Code) Then
   			Sof = False
   		End If
		If Len(Trim(Code)) = 4 And Trim(Sebun.Data) = Trim(Code) Then
			sef = True
		ElseIf Len(Trim(Code)) = 4 And Trim(Sebun.Data) <> Trim(Code) Then
   			sef = False
   		End If
		If Len(Trim(Code)) = 5 And InStr(1, Code, Trim(Sebun.Data), 1)  > 0 And Daef = True And Jungf = True And Sof = True And Sef = True Then
   			grows = grows + 1
			GRID0.InsertRow(-1)
			GRID0.SetGridCell grows, 1, Code
			GRID0.SetGridCell grows, 2, Value
   		End If
   	Loop
End Sub

