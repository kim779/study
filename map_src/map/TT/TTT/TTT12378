		item = "03" & vbTab & "***선택하세요" & vbTab
		Do While F.AtEndOfLine <> True
			ReadData = F.ReadLine
			Arry = Split(ReadData, vbTab, -1 ,1)
			Code = Arry(0)
			Value = Arry(1)
			If Len(Trim(Code)) = 1 And Trim(Daebun.Data) = Trim(Code) Then
				Daef = True
			ElseIf Len(Trim(Code)) = 1 And Trim(Daebun.Data) <> Trim(Code) Then
	   			Daef = False
	   		End If
			If Len(Trim(Code)) = 2 And Trim(Jungbun.Data) = Trim(Code) Then
				Jungf = True
			ElseIf Len(Trim(Code)) = 2 And Trim(Jungbun.Data) <> Trim(Code) Then
	   			Jungf = False
	   		End If
