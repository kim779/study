_AW_ONDECLARE_AW_
Dim dic, dic_new
Set dic = CreateObject("Scripting.Dictionary")
Set dic_new = CreateObject("Scripting.Dictionary")
Sub Set_dic()
	' Clear Dic
	dic.RemoveAll
	dic_new.RemoveAll

	' Set Dic
	For ii = 1 To S_GRID.Rows
		key = Trim(S_GRID.GetGridCell(ii, 1))&Trim(S_GRID.GetGridCell(ii, 3))

		If dic.Exists(key) Then	' Dup Dic
			SYSTEM.Trace "SetDIC list key exist"
		Else
			dic.Add key, S_GRID.GetGridCell(ii, 4) '키:파일명, 값:소스변경일
			dic_new.Add key, S_GRID.GetGridCell(ii, 1) '키:파일명, 값:서버
			'MsgBox key & " : "& dic.Item(key)
		End If
	Next

End Sub


Sub proc_excel() '엑셀올리기 버튼

	EXCEL_LABEL.Visible = True
	SCREEN.SetTimer 3, False
	' 1. Create obj
	Dim obj1
	Set obj1 = CreateObject("Excel.Application")
	obj1.visible = False

	' 2. Add Workbook
	Dim obj2
	'Set obj2 = obj1.WorkBooks.Open("\\172.16.213.33\정보전략팀\Public\37_IT개발팀\98. 프로젝트\2023_KRX_차세대\Documents\HTS_MAP_TR_LIST.xlsx")
	Set obj2 = obj1.WorkBooks.Open("\\172.16.213.33\정보전략팀\Public\90_프로젝트진행\2022_채널고도화_프로젝트\SERVER\Documents\HTS_SERVER_BINARY.xlsx")

	' 3. Select Sheet
	Dim obj3
	Set obj3 = obj2.WorkSheets(1) '첫번째 시트 인덱스
	'MsgBox "[" & obj3.Cells(2,3)& "]"

	' 그리드 총개수
	E_GRID.Setrows 0
	rnum = 1
	For ii = 3 To 20000'E_GRID.Rows '0이 아닌 1부터 시작함
		If Trim(obj3.Cells(ii,4)) = "" Then '4열에 값이 없으면 Exit
			Exit For
		End If

		E_GRID.InsertRow(-1)
		rnum = rnum + 1
	Next

	E_GRID.Setrows 20000		'엑셀그리드 총개수 세팅

	Dim names, serv
	names = ""
	serv = ""
	jj = 1
	For ii = 3 To rnum + 3 'E_GRID.Rows + 3 '0이 아닌 1부터 시작함

		If Trim(obj3.Cells(ii,4)) = "" Then '4열에 값이 없으면 exit
			Exit For
		End If

		'엑셀그리드에 엑셀내용 입력
		If Trim(obj3.Cells(ii, 1)) <> "" Then
			serv = Trim(obj3.Cells(ii, 1))
		End If
		E_GRID.SetGridCell ii-2, 1, serv '서버(BP/MP)

		For kk = 4 To 7

			If Trim(obj3.Cells(ii, kk)) <> "" Then
				'신규여부 가려냄
				If kk = 4 Then		'TR명
					fnam = Trim(obj3.Cells(ii, kk))
					If dic_new.Exists(fnam) Then
						dic_new.Remove(fnam)
					End If
				End If

				'TR명(4), 작업일자(5), 작업자(6), 소스변경일(7)  E_GRID에 입력
				E_GRID.SetGridCell ii-2, kk-2, Trim(obj3.Cells(ii, kk))
			End If
		Next

		If Trim(E_GRID.GetGridCell(ii-2, 2)) <> "" Then '엑셀그리드에 작업일자가 세팅되면
			'fnam = Trim(E_GRID.GetGridCell(ii-2, 1))	'TR명 -> 위에서 구함
			mdat = dic.item(fnam)						'소스변경일
			obj3.Cells(ii, 7) = mdat					'엑셀에 변경일자 입력
			E_GRID.SetGridCell ii-2, 4, mdat			'엑셀그리드에 변경일자 입력

			' 수정된 내역이 작업일자 < 소스변경일 이면 수정 입력
			If Trim(E_GRID.GetGridCell(ii-2, 2)) <> "신규" Then
				If Trim(E_GRID.GetGridCell(ii-2, 2)) < Trim(E_GRID.GetGridCell(ii-2, 4)) Then
					E_GRID.SetGridCell ii-2, 5, "수정"

					'메일 전송할 작업자입력
					If InStr(names, Trim(E_GRID.GetGridCell(ii-2, 3))) = 0 Then
						names = names & Trim(E_GRID.GetGridCell(ii-2, 3)) & "|"
					End If
				End If
			End If
		End If

		jj = jj + 1
		EXCEL_LABEL.Data = "엑셀올리기 진행중... (" & jj & "/" & rnum & ")"
	Next

	Dim new_i
	ii = rnum

	For Each new_i In dic_new
		E_GRID.InsertRow(ii)
		E_GRID.SetGridCell ii, 1, dic_new.Item(new_i) '서버
		E_GRID.SetGridCell ii, 2, Mid(new_i, 3, Len(new_i))  'TR명
		E_GRID.SetGridCell ii, 5, "신규"
		obj3.Cells(ii+2, 1) = dic_new.Item(new_i)
		obj3.Cells(ii+2, 4) = Mid(new_i, 3, Len(new_i))
		obj3.Cells(ii+2, 5) = "신규"
		ii = ii + 1
	Next

	E_GRID.Setrows ii-1		'엑셀그리드 총개수 세팅


	NAMS.Data = names
	obj3.SaveAs("\\172.16.213.33\정보전략팀\Public\90_프로젝트진행\2022_채널고도화_프로젝트\SERVER\Documents\HTS_SERVER_BINARY_20220615_test.xlsx")
	obj1.Quit
	Set obj3 = Nothing
	Set obj2 = Nothing
	Set obj1 = Nothing

	EXCEL_LABEL.Visible = False

	'자동실행이면 담당자메일전송 실행
	If Trim(AUTO.Data) = "Y" Then
		AUTO.Data = "N"
		Call proc_mail()
	Else
		MsgBox "엑셀올리기 완료"
	End If

End Sub

Sub proc_mail() '담당자 메일전송 버튼

	If E_GRID.Rows = 0 Then
		MsgBox "발송할 내역이 없습니다."
		Exit Sub
	End If

	If Trim(NAMS.Data) = "" Then
		MsgBox "담당자명이나 수정내역이 없습니다."
		Exit Sub
	End If

	GUBN.Data = "M"
	AUTO.Data = "N"
	SCREEN.Send 0
End Sub

_AW_ONRECEIVE_AW_
If Trim(EMSG.Data) <> "" And Trim(AUTO.Data) = "N" And Trim(RCOD.Data) <> "2" Then
	MsgBox Trim(EMSG.Data)
End If

If Trim(RCOD.Data) = "2" Then
	NGUB.Data = "Y"
	S_GRID.SetDataPosition(2)
	GUBN.Data = "S"
	SCREEN.Send 0
Else
	If Trim(GUBN.Data) = "S" Then
		Call Set_dic()
	End If
