RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim thisMonth, thisYear

thisYear = Left(Date, 4)
thisMonth = Mid(Date, 6, 2)

_AW_ONRECEIVE_AW_
SCREEN.Object("main.obj_gmsg.gmsg").data = Trim(GUIDE.Data)
GRID0.Sort 7,False,False
Dim ii
Dim hesum, hcsum, hjsum, htsum

hesum = 0
hcsum = 0
hjsum = 0
htsum = 0

For ii = 1 To GRID0.Rows
	If IsNumeric(GRID0.GetGridCell(ii, 4)) = True Then
		hesum = hesum + CDbl(GRID0.GetGridCell(ii, 4))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 5)) = True Then
		hcsum = hcsum + CDbl(GRID0.GetGridCell(ii, 5))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 6)) = True Then
		hjsum = hjsum + CDbl(GRID0.GetGridCell(ii, 6))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 7)) = True Then
		htsum = htsum + CDbl(GRID0.GetGridCell(ii, 7))
	End If
Next

	tesum.Data = hesum
	tcsum.Data = hcsum
	tjsum.Data = hjsum
	ttsum.Data = htsum

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim tr, map

tr = Left(GRID0.GetGridCell(GRID0.Row, 2), 4)

If GRID0.HitPos = "3" Then
	If SCREEN.Object("main.checkbox").checked = True Then
		SCREEN.CreateWindow 1, "IB" & tr & "00 /t/d/p5/s",""
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



