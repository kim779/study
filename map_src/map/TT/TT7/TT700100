RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim thisMonth, thisYear

thisYear = Left(Date, 4)
thisMonth = Mid(Date, 6, 2)

_AW_ONSTART_AW_
yesYear.Text = Left(DateAdd("d", -1, Date), 4)
yesMonth.Text = Mid(DateAdd("d", -1, Date), 6, 2)
yesDay.Text = Right(DateAdd("d", -1, Date), 2)

zStrDt.Data = yesYear.Text & "0101"
zEndDt.Data = yesYear.Text & "1231"

If Hour(Now) < 15 Then
	Exit Sub
End If

SCREEN.Send 0

If Trim(yesMonth.Text) <> "" Then
	obj0.Proc "startDay", yesYear.Text & "," & yesMonth.Text
End If

SCREEN.SetTimer 5, True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("obj_gmsg.gmsg").data = Trim(GUIDE.Data)

Dim ii
Dim fesum, fcsum, fjsum, ftsum

fesum = 0
fcsum = 0
fjsum = 0
ftsum = 0

For ii = 1 To GRID0.Rows

	If IsNumeric(GRID0.GetGridCell(ii, 4)) = True Then
		fesum = fesum + CDbl(GRID0.GetGridCell(ii, 4))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 5)) = True Then
		fcsum = fcsum + CDbl(GRID0.GetGridCell(ii, 5))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 6)) = True Then
		fjsum = fjsum + CDbl(GRID0.GetGridCell(ii, 6))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 7)) = True Then
		ftsum = ftsum + CDbl(GRID0.GetGridCell(ii, 7))
	End If
Next

	mesum.Data = fesum
	mcsum.Data = fcsum
	mjsum.Data = fjsum
	mtsum.Data = ftsum

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If Trim(yesDay.Text) <> "" Then
	obj0.Proc "startTr", yesYear.Text & "," & yesMonth.Text & "," &  yesDay.Text
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then

mon.Data = Left(GRID0.GetGridCell(GRID0.row, 1), 2)

If Trim(mon.Data) <> "" Then
	SCREEN.Object("obj0.zStrDt").Data = year.Data & mon.Data & "01"
	SCREEN.Object("obj0.zEndDt").Data = year.Data & mon.Data & "31"
	obj0.Send
End If

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
obj0.ClearAll 0
SCREEN.Object("obj0.obj0").clearAll 0

If Hour(Now) < 15 Then
	Exit Sub
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
Select Case excelSelect.Index
	Case 0 : GRID0.Excel True,True,""
	Case 1 : SCREEN.Object("obj0.GRID0").Excel True,True,""
	Case 2 : SCREEN.Object("obj0.obj0.GRID0").Excel True,True,""
End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(year)
_AW_ONCHANGE_AW_
zStrDt.Data = year.Data & "0101"
zEndDt.Data = year.Data & "1231"

obj0.ClearAll 0
SCREEN.Object("obj0.obj0").clearAll 0

If Hour(Now) < 15 Then
	Exit Sub
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



