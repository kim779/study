RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim thisMonth, thisYear

thisYear = Left(Date, 4)
thisMonth = Mid(Date, 6, 2)

_AW_ONSTART_AW_
zStrDt.Data = sdat.Data
zEndDt.Data = edat.Data

If Hour(Now) < 15 Then
	Exit Sub
End If

SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("obj_gmsg.gmsg").data = Trim(GUIDE.Data)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(RADIO1)
_AW_ONCLICK_AW_
sdat.Visible = True
edat.Visible = True
year.Visible = False
month.Visible = False
LABEL3.Visible = True

zStrDt.Data = sdat.Data
zEndDt.Data = edat.Data

TDM.Data = "1"

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(RADIO0)
_AW_ONCLICK_AW_
sdat.Visible = False
edat.Visible = False
year.Visible = True
month.Visible = True
LABEL3.Visible = False

TDM.Data = "2"

year.Index = thisYear
month.Index = CInt(thisMonth) - 1

zStrDt.Data = year.Data & month.Data & "01"
zEndDt.Data = year.Data & month.Data & "31"

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(RADIO2)
_AW_ONCLICK_AW_
sdat.Visible = False
edat.Visible = False
year.Visible = True
month.Visible = False
LABEL3.Visible = False

TDM.Data = "3"

year.Index = thisYear

zStrDt.Data = year.Data & "0101"
zEndDt.Data = year.Data & "1231"


SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
GRID0.Excel True,True,""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(year)
_AW_ONCHANGE_AW_
If RADIO0.Checked = True Then
	zStrDt.Data = year.Data & month.Data & "01"
	zEndDt.Data = year.Data & month.Data & "31"
ElseIf	RADIO2.Checked = True Then
	zStrDt.Data = year.Data & "0101"
	zEndDt.Data = year.Data & "1231"
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(month)
_AW_ONCHANGE_AW_
zStrDt.Data = year.Data & month.Data & "01"
zEndDt.Data = year.Data & month.Data & "31"

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(sdat)
_AW_ONCHANGE_AW_
zStrDt.Data = sdat.Data

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edat)
_AW_ONCHANGE_AW_
zEndDt.Data = edat.Data

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



