RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_IsStart

g_IsStart = False
'-------------------------------------------------------
Sub SetData(Data)
	ot_K200.Data = Data

	CalcData
End Sub
'-------------------------------------------------------
Sub OnAlert()
	CalcData
End Sub
'-------------------------------------------------------
Sub CalcData()
	RK200 = Trim(S20037.Data)
	If Len(RK200) = 0 Then
		Exit Sub
	End If

	K200 = Trim(ot_K200.Data)
	If Len(K200) = 0 Then
		Exit Sub
	End If

	Data = RK200 - K200
	If Data > 0 Then
		ot_Gap.Data = "+" & FormatNumber(RK200 - K200, 2, -2, -2, 0)
	Else
		ot_Gap.Data = FormatNumber(RK200 - K200, 2, -2, -2, 0)
	End If
End Sub

_AW_ONSTART_AW_
OBJECT0.Proc "SendData", "101"
S20301.Data = "101"
g_IsStart = True
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If Not g_IsStart Then
	SCREEN.OnSend = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(20037)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ot_K200)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ot_Gap)
_AW_ENDSCRIPT_AW_


}



