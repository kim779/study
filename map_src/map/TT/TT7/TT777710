RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub initialize()
	sr.enable False
	er.enable False
	cr.enable False
	rr.enable False
	bcr.enable False
End Sub

Function m_date(data)
	m_date = data
	Dim yy, mm, dd
	yy = Mid(data, 1, 4)
	mm = Mid(data, 5, 2)
	dd = Mid(data, 7, 2)
	
	m_date = yy &"/"& mm &"/"& dd
End Function

Sub table_clear()
	st.Clear
	sr.Visible False
	elw.Clear
	er.Visible False
	cma.Clear
	cr.Visible False
	rp.Clear
	rr.Visible False
	bc.Clear
	bcr.Visible False
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	Call ready()
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub ready()
	accn.Data = SCREEN.Object("parent.an99").data

	sr.Visible True
	er.visible True
	
	If Left(accn.data, 1) = "5" Then
		cr.Visible False
	Else
		cr.Visible True
	End If
	
	rr.Visible True
	bcr.Visible True
	
	st.SetTableCell 2, "개설가능"
	elw.SetTableCell 2, "개설가능"
	
	If Left(accn.data, 1) = "5" Then
		cma.SetTableCell 2, "개설불가"
	Else
		cma.SetTableCell 2, "개설가능"
	End If
	
	rp.SetTableCell 2, "개설가능"
	bc.SetTableCell 2, "개설가능"
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0006"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
accn.Data = SCREEN.Object("parent.an99").data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, accn_no, dt, gubn

For ii =1 To GRID0.Rows
	accn_no = Trim(GRID0.GetGridCell(ii, 1))
	gubn = Trim(GRID0.GetGridCell(ii, 4))
	dt = Trim(GRID0.GetGridCell(ii, 8))
	
	Select Case gubn
		Case "01"
			st.SetTableCell 1, accn_no
			st.SetTableCell 2, m_date(dt)
			sr.visible False
		Case "17"
			elw.SetTableCell 1, accn_no
			elw.SetTableCell 2, m_date(dt)
			er.Visible False
		Case "19"
			cma.SetTableCell 1, accn_no
			cma.SetTableCell 2, m_date(dt)
			cr.Visible False
		Case "05"
			rp.SetTableCell 1, accn_no
			rp.SetTableCell 2, m_date(dt)
			rr.Visible False
		Case "61"
			bc.SetTableCell 1, accn_no
			bc.SetTableCell 2, m_date(dt)
			bcr.Visible False
	End Select
	
Next
			
If LEDGER.Next = "Y" Then
	Call Send_c()
End If
	
	

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



