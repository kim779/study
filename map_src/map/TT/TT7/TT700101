RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub startDay(y, m)
	zStrDt.Data = y & m & "01"
	zEndDt.Data = y & m & "31"
	SCREEN.Send 0
End Sub

Dim dai
Sub startTr(y, m)
	dai = Left(GRID0.GetGridCell(GRID0.rows, 1), 2)
SYSTEM.Trace  y & m & dai
	SCREEN.Object("obj0.zStrDt").Data = y & m & dai
	SCREEN.Object("obj0.zEndDt").Data = y & m & dai
	obj0.Send
End Sub

_AW_ONRECEIVE_AW_
SCREEN.Object("main.obj_gmsg.gmsg").data = Trim(GUIDE.Data)

Dim ii
Dim sesum, scsum, sjsum, stsum

sesum = 0
scsum = 0
sjsum = 0
stsum = 0

For ii = 1 To GRID0.Rows
	If IsNumeric(GRID0.GetGridCell(ii, 4)) = True Then
		sesum = sesum + CDbl(GRID0.GetGridCell(ii, 4))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 5)) = True Then
		scsum = scsum + CDbl(GRID0.GetGridCell(ii, 5))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 6)) = True Then
		sjsum = sjsum + CDbl(GRID0.GetGridCell(ii, 6))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 7)) = True Then
		stsum = stsum + CDbl(GRID0.GetGridCell(ii, 7))
	End If
Next

	desum.Data = sesum
	dcsum.Data = scsum
	djsum.Data = sjsum
	dtsum.Data = stsum
	
dai.Text = Left(GRID0.GetGridCell(GRID0.rows, 1), 2)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then

Dim mon, dai

dai = Left(GRID0.GetGridCell(GRID0.row, 1), 2)

If Trim(dai) <> "" Then
	SCREEN.Object("obj0.zStrDt").Data = SCREEN.Object("main.yesYear").Text & SCREEN.Object("main.yesMonth").Text & dai
	SCREEN.Object("obj0.zEndDt").Data = SCREEN.Object("main.yesYear").Text & SCREEN.Object("main.yesMonth").Text & dai
	obj0.Send
End If

End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



