	GRID2.Clear()
End Sub


Sub click_grid()
	Dim	key_value, key_text
	key_value = GRID1.GetGridCell(GRID1.Row, 10) 'keyv
	If Trim(key_value) <= "" Then
		Exit Sub
	End If
	key_text = GRID1.GetGridCell(GRID1.Row, 3) '제목

	If Trim(key_text) <= "" Then
		Exit Sub
	End If

	key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.
		SCREEN.CreateWindow 4, "IBNEWSXX /S/d/p1", "015"& vbTab & key_text & vbLf & _
		"016" & vbTab & key_value & vbLf & "1301" & vbTab & GRID1.GetGridCell(GRID1.row, 6)
End Sub

