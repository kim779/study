Sub Onalert()
	p_read_ini()

	SYSTEM.Trace "realtime"

	Dim	v_gubn
	Dim	v_name

	If Trim(GRID2.GetGridCell(1, 8)) = "" Then
		Exit Sub
	End If
	
	If SCREEN.Object("main.check0").checked = True Then
		If Trim(GRID2.GetGridCell(1, 4)) <> "" Then
			S1301.Data = GRID2.GetGridCell(1, 4)
			S1301.Trigger "",True
			S1301.Trigger "",False	
			SYSTEM.Trace "1301: " & S1301.Data
		End If
	End If
				
	v_gubn = Trim(GRID2.GetGridCell(1, 8))

	Select Case v_gubn
	Case 1
		If GUBN1.Checked = False Then
			Exit Sub
		End If
		v_name = "시황"
	Case 2
		If GUBN2.Checked = False Then
			Exit Sub
		End If
		v_name = "공시"
	Case 3
		If GUBN3.Checked = False Then
			Exit Sub
		End If
		v_name = "이투데이"
	Case 4
