_AW_ONDECLARE_AW_
'***************************************************************************
' DESC : 계좌 setting
'***************************************************************************
Sub Set_account()
	SCREEN.ClearAll 0, 2
	b_send.Enable = True
	ACNM.Data = AN99.name
	pswd.Data = AN99.Password
	If Trim(AN99.Data) = "" Then
		AN99.SetFocus
		Exit Sub
	End If
	If Trim(pswd.Data) = "" Then
		pswd.SetFocus
	End If
	obj0.proc "table_clear", ""
End Sub

_AW_SCRIPT_AW_(pswd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 Then
	obj0.proc "send_f", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN99)
_AW_ONCHANGE_AW_
