Function getdata(num)
	Dim str, cod
	cod = ""
	str = ""

	str = "obj" & num & ".gubn"

	Select Case SCREEN.Object(str).data
		Case "s"
			str = "obj" & num & ".scod"
		Case "u"
			str = "obj" & num & ".ucod"
		Case "f", "o"
			str = "obj" & num & ".fcod"
	End Select

	cod = SCREEN.Object(str).data
	getdata = cod
End Function

