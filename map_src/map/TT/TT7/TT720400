_AW_ONDECLARE_AW_
Sub all_account()
	OBJ_account.Send
	If tab_ordtyp.ID = 1 Then
		If SCREEN.Object("obj_order.tab_order").id = "7" Then
			SCREEN.Object("obj_order.obj_odr").send
		End If
	End If
End Sub

Sub tab_ordtyp_change()
	Select Case tab_ordtyp.ID
	Case 0, 3
		OBJ_order.SetObject("IB100190")
	Case 1
		OBJ_order.SetObject("IB303090")
	Case 2
		OBJ_order.SetObject("IB103010")
	Case 4
		OBJ_order.SetObject("IB1002A0")
	End Select

	If TAB1.ID = 7 Then
		SCREEN.Proc "OBJ_account.send_main", ""
	End If
End Sub

Sub send_sise_all(xval)
SCREEN.IgnoreChange True
	S1301.Trigger "", True

	If xval <> "jumun" Then
		Call Ord_ChangeCode(S1301.Data)
	End If
	SCREEN.Object("OBJ_sise.1301").Data = S1301.Data
	OBJ_sise.Send
	'OBJ_info.Send

	If TAB1.ID = 7 Then
		SCREEN.Proc "OBJ_account.send_main", ""
	End If
SCREEN.IgnoreChange False
End Sub

