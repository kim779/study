_AW_ONDECLARE_AW_
Dim grid, menu

Sub chkpwd()
	If Len(Trim(ed_pswd.Data)) < 4 Then
		GUIDE.Text = "비밀번호를 입력하시기 바랍니다."
		Exit Sub
	End If
	If chkpwdyn.Data = "N" Then
		SCREEN.Object("obj_chkPW.IntaccNo").data = Trim(cmb_acnt.Data)
		SCREEN.Object("obj_chkPW.Pwd").data = Trim(ed_pswd.Data)
		SCREEN.Object("obj_chkPW.chk").data = "1"
		obj_chkPW.Send
	Else
		Call send_f()
	End If
End Sub

Sub AllSell()
	chkpwdyn.Data = "Y"
	Call send_f()
End Sub

Sub Set_account()
	chkpwdyn.Data = "N"
	Set grid = SCREEN.Object("obauth.grid0")
	acno.Data = Split(cmb_acnt.Data, "|")(0)
	ACNM.Data = grid.getgridcell(CLng(Split(cmb_acnt.Data, "|")(1)), 2)
	ed_pswd.Data = ""
	GUIDE.Text = ""
End Sub

Sub send_f()
	gubn.Data = "Q"
	Call gridcls()
	SCREEN.Send 0
End Sub

Sub save_f()
	Dim ii, cansaveyn
	cansaveyn = "N"
	SYSTEM.Trace chkpwdyn.Data
	gubn.Data = "I"
	If chkpwdyn.Data = "N" Then
		GUIDE.Text = "조회후 등록/변경 하세요"
		Exit Sub
	End If
	For ii = 1 To 5
		If Len(RGRID.GetGridCell(ii, 3)) > 0 Then
			cansaveyn = "Y"
		End If
	Next
	If cansaveyn <> "Y" Then
		GUIDE.Text = "선택한 메뉴가 없습니다."
		Exit Sub
	End If
	SCREEN.Send 0
End Sub

Sub del_f()
	gubn.Data = "D"
	If chkpwdyn.Data = "N" Then
		GUIDE.Text = "조회후 해지 하세요"
		Exit Sub
	End If
	If r1.Enable = False And r2.Enable = False Then
		GUIDE.Text = "해지가능한 전화번호가 없습니다."
		Exit Sub
	End If
	If r1.Checked = False And r2.Checked = False Then
		GUIDE.Text = "해지할 전화번호를 선택하세요."
		Exit Sub
	End If
	SCREEN.Send 0
End Sub

Sub move_right()
	Dim srow, mcod1, mcod2, ii, menuname
	srow = LGRID.Row
	For ii = 1 To RGRID.Rows
		If RGRID.GetGridCell(ii, 3) = LGRID.GetGridCell(srow, 3) Then
			GUIDE.Text = "이미 추가되어있습니다."
			Exit Sub
		End If
	Next
	mcod1 = CLng(Left(LGRID.GetGridCell(srow, 3), 1))
	mcod2 = CLng(Right(LGRID.GetGridCell(srow, 3), 1))

	menuname = Split(menu(mcod1-1)(0), "|")(1) & " > " & Split(menu(mcod1-1)(mcod2), "|")(1)
	RGRID.SetGridCell RGRID.Row, 3, mcod1&mcod2
	RGRID.SetGridCell RGRID.Row, 5, menuname

End Sub

Sub move_left()
	Dim ii
	For ii = 1 To 5
		If RGRID.GetGridCell(ii, 1) = 1 Then
			RGRID.SetGridCell ii, 1, 0
			RGRID.SetGridCell ii, 3, ""
			RGRID.SetGridCell ii, 5, ""
		End If
	Next
End Sub

Sub gridcls()
	Dim ii
	For ii = 1 To 5
		RGRID.SetGridCell ii, 3, ""
		RGRID.SetGridCell ii, 5, ""
	Next
End Sub

