'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN15.Name
	h_acnm.Data = AN15.Name
	zPwd.Data = AN15.Password

	If Trim(accn.Data) = "" Then
		accn.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	'Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SrtNo.Data = l_zeropad(SrtNo)
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 첫 조회
Sub send_click()
	'SCREEN.ClearAll 0, 2
