	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'==계좌번호, 비밀번호 체크
Function L_CheckInput(accn, zPwd)
 	L_CheckInput = False
	If Trim(accn.data) = "" Or Len(Trim(accn.data)) < 14 Then
		Call alert_msg("계좌번호를 확인하십시오.")
 		accn.Setfocus
 		Exit Function
	End If

	If Len(Trim(zPwd.data)) = 0 Then
		Call alert_msg("비밀번호를 확인하십시오.")
 		zPwd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zPwd.data)) < 4 Then
			Call alert_msg("비밀번호를 확인하십시오.")
	 		zPwd.Setfocus
	 		Exit Function
		End If
	End If
	L_CheckInput = True
End Function

