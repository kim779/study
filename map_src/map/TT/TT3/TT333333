{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0012"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.AN51").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.AN51").SetFocus
	Exit Sub
End If

zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)

If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
	zPwd.Data = "9999"
End If

If Len(Trim(zPwd.Data)) < 4 Then
	Call alert_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

zBuyDt.Data = Trim(SCREEN.Object("parent.zOrdDt").Data)

If Is_numeric(SCREEN.Object("parent.i_lRpDays").Data) = False Then
	Call alert_msg("RP일수를 확인하여 주십시오.")
	SCREEN.Object("parent.i_lRpDays").SetFocus
	Exit Sub
End If

zRpDays.Data = "+" & l_zeropad(SCREEN.Object("parent.i_lRpDays"))

If Is_numeric(SCREEN.Object("parent.price").Data) = False Then
	Call alert_msg("매매금액을 확인하여 주십시오.")
	SCREEN.Object("parent.price").SetFocus
	Exit Sub
End If

zOutAmt.Data = "+" & l_zeropad(SCREEN.Object("parent.price"))

Dim rpGubn
If SCREEN.Object("parent.RADIO0").Checked = True Then
	rpGubn = 2
ElseIf SCREEN.Object("parent.RADIO1").Checked = True Then
	rpGubn = 1
Else
	rpGubn = 7
End If

zRpBnsTp.Data = rpGubn

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	SCREEN.Object("parent.next_btn").Enable = True
Else
	SCREEN.Object("parent.next_btn").Enable = False
End If

Dim ecod
ecod = Trim(LEDGER.Ecod)

If ecod = "" Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
	Dim HldDays, IctaxRat
	HldDays = Trim(GRID0.GetGridCell(1, 5))
	IctaxRat = Trim(GRID0.GetGridCell(1, 8))

	If is_numeric(HldDays) = True Then
		GRID0.SetGridCell 1, 6, CLng(HldDays) & "일"
	End If

	If Is_numeric(IctaxRat) = True Then
		GRID0.SetGridCell 1, 9, FormatNumber(IctaxRat * 100, 2) & "%"
	End If

	Dim ii, RpIntrat

	For ii = 1 To GRID1.Rows
		HldDays  = Trim(GRID1.GetGridCell(ii, 4))
		RpIntrat = Trim(GRID1.GetGridCell(ii, 6))

		If Is_numeric(HldDays) = True Then
			GRID1.SetGridCell ii, 5, CLng(HldDays) & "일"
		End If

		If Is_numeric(RpIntrat) = True Then
			GRID1.SetGridCell ii, 7, FormatNumber(RpIntrat * 100, 2) & "%"
		End If
	Next
Else

End If

