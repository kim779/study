Dim msg
Dim getdata


SYSTEM.Push "fundmsg", ""
SCREEN.CreateWindow 2, "IB498981  /t /s /p?", ""

msg = SYSTEM.Pop("fundmsg")
If msg = "NO" Then
	Exit Sub
End If

getdata = Split(msg, "|", -1, 1)
fundcode.Data = getdata(0)
FundName.Text = Trim(getdata(1))

If fundcode.Data <> "" Then
	send_f()
	SCREEN.Object("main.fundcode").Data = fundcode.Data
	SCREEN.Object("main.FundName").Text = FundName.Text

	 ed_name.Data = FundName.Text
End If
