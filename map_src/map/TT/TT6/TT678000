_AW_ONDECLARE_AW_
Sub SetData()
	Dim ii, strTemp

	For ii = 1 To SCREEN.Object("parent.GRID0").Rows
		'SYSTEM.Trace "parent row[" & ii & "] accn[" & SCREEN.Object("parent.GRID0").GetGridCell(ii,3) & "] pswd[" & SCREEN.Object("parent.GRID0").GetGridCell(ii,5) & "]"
		GRID0.InsertRow(-1)
		GRID0.SetGridCell ii,1,SCREEN.Object("parent.GRID0").GetGridCell(ii,3)	'accn
		GRID0.SetGridCell ii,2,SCREEN.Object("parent.GRID0").GetGridCell(ii,5)	'pswd
	Next

'	GRID0.SetGridCell GetGridRows,1,acct
'	GRID0.SetGridCell GetGridRows,2,pswd
End Sub

'데이터가 있는 그리드 Row 리턴
Function GetGridRows()
	Dim ii, strTemp
	For ii = 1 To GRID0.Rows
		strTemp = GRID0.GetGridCell(ii, 1)

		'SYSTEM.Trace "object row[" & ii & "] accn[" & GRID0.GetGridCell(ii,1) & "] pswd[" & GRID0.GetGridCell(ii,2) & "]"

		If Trim(strTemp) = "" Then
			Exit For
		End If
	Next

	GetGridRows = ii
End Function

