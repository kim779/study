'***************************************************************************
' DESC: 주문확인
'***************************************************************************
Sub BnOrder()
	Dim msg_domino, mdgb

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If
	If r_mdgb0.Checked = True Then
		mdgb = "전부"
	Else
		mdgb = "일부"
	End If
	SYSTEM.Push "bond_modify_order", ""
	msg_domino = 	"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
					"o_acno" & vbTab & SCREEN.Object("main.AN1A").Data & vbLf &_
					"o_acnm" & vbTab & SCREEN.Object("main.ACNM").Data & vbLf &_
					"o_hnam" & vbTab & cgname.Data & vbLf &_
					"o_mdgb" & vbTab & mdgb & vbLf &_
					"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
					"o_jprc" & vbTab & ed_jprc.Data & vbLf
	SCREEN.CreateWindow 2, "IB63013A /p99 /d", msg_domino

	If SYSTEM.Pop("bond_modify_order") <> "OK" Then
		Exit Sub
	End If
	SCREEN.Object("parent.obj_snd").send		'주문전송
	QueryOption("after")
End Sub

'***************************************************************************
' DESC: 에러체크
'***************************************************************************
Function Error_check()

	Const scr_name = "소매채권 매수"
	SCREEN.Object("main.guide").text = ""
	ed_pswd.Data = SCREEN.Object("main.ed_pswd").Data

	Error_check = False
	If Trim(SCREEN.Object("main.AN1A").Data) = "" Then
		MsgBox "계좌번호를 입력하세요", , scr_name
		SCREEN.Object("main.AN1A").SetFocus
		Exit Function
	End If
	If Trim(SCREEN.Object("main.ed_pswd").Data) = "" Then
		MsgBox "비밀번호를 입력하세요", , scr_name
		SCREEN.Object("main.ed_pswd").SetFocus
		Exit Function
	End If
	If Trim(smcd.Data) = "" Then
		MsgBox "종목을 입력하세요", , scr_name
		smcd.SetFocus
		Exit Function
	End If
	If ed_jqty.Enable = True Then
		If CDbl(ed_jqty.Data) = 0 Then
			MsgBox "수량을 입력하세요", , scr_name
			ed_jqty.SetFocus
			Exit Function
		End If
	End If
	If CDbl(ed_jprc.Data) = 0 Then
		MsgBox "단가를 입력하세요", , scr_name
		ed_jprc.SetFocus
		Exit Function
	End If

	Error_check = True
End Function

Sub ChangeCode()
	ed_jprc.Data = ""
	cgname.Data = SCREEN.GetName(118, smcd.Data, 0)
	ed_code.Data = smcd.Data
	If SCREEN.Object("main.smcd").Data <> smcd.Data Then
		SCREEN.Object("main.smcd").Data = smcd.Data
		smcd.Trigger "smcd", True
	End If
	SCREEN.Proc "main.send_sise", ""
End Sub

Sub Set_mdgb()
	If r_mdgb0.Checked = True Then
		ed_mdgb.Data = "2"						'전부
		ed_jqty.Data = ""
		ed_jqty.Enable = False
		ed_ogno.SetFocus
	ElseIf r_mdgb1.Checked = True Then
		ed_mdgb.Data = "1"						'일부
		ed_jqty.Enable = True
		ed_jqty.SetFocus
	End If
End Sub

'***************************************************************************
' DESC: 주문후 수량 단가 유지
'***************************************************************************
Sub QueryOption(when)

	If when = "after" Then
		If OrdCfg.KeepQty = False Then		'-- 수량유지안함
			ed_jqty.Data = "0"
		End If
		' 금감원 원칙으로 주문후 원주문번호 clear
		Select Case mmgb
		Case "3", "4"
			ed_ogno.Data = ""
		End Select

		If OrdCfg.KeepPrc = False Then		'-- 단가유지안함
			ed_jprc.Data = "0"
		End If
		Exit Sub
	End If
End Sub

