'***************************************************************
'NAME: l_format
'DESC: 특정문자로 자리수 맞추어 표시
'EX)   l_format("99", "0", 5)   			return	"00099"
'		 l_format("11111", "#", 10)		return	"#####11111"
'***************************************************************
Function l_format(str, char, sln)
	If Trim(str) = "" Then
		l_format = ""
		Exit Function
	End If
	l_format = String(sln - Len(str), char) & str
End Function


Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

