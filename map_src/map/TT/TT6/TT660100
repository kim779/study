RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'***************************************************************************
' DESC: 계좌설
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password
	SCREEN.Object("obj_jumn.ed_accn").Data = Trim(AN1A.Data)
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus
		Exit Sub
	End If
	SCREEN.Object("obj_jumn.ed_accn").Data = AN1A.data
	GUIDE.text = ""
End Sub

Sub order_tab_change()
	Select Case tab_order.ID
		Case "1" : obj_jumn.SetObject("IB660130")
		Case "2" : obj_jumn.SetObject("IB660140")
		Case "3" : obj_jumn.SetObject("IB660150")
		Case "4" : obj_jumn.SetObject("IB660160")
		Case "5" : obj_jumn.SetObject("IB660170")
	End Select
	SCREEN.Object("obj_jumn.smcd").SetFocus
End Sub

Sub sise_tab_change()
	Select Case tab_sise.ID
		Case "1" : obj_hoga.SetObject("IB660110")
		Case "2" : obj_hoga.SetObject("IB660120")
		Case "3" : obj_hoga.SetObject("IB660111")
		Case "4" : obj_hoga.SetObject("IB660112")
	End Select
	obj_hoga.Send
End Sub

Sub send_sise()
	obj_hoga.ClearAll 0
	obj_hoga.Send
End Sub

'***************************************************************************
' DESC: 호가가격 Setting
'***************************************************************************
Sub Set_Odrjprc(jprc)
	If  tab_order.ID <> 4 And SCREEN.Object("obj_jumn.ed_jprc").Enable = True Then
		SCREEN.Object("obj_jumn.ed_jprc").Data = jprc
	End If
End Sub

Sub resend()
	If tab_account.ID = 1 Or tab_account.ID = 2 Then
		obj_account.Proc "send_f", ""
	End If
End Sub

_AW_ONSTART_AW_
tab_sise.Index = 1
tab_order.Index = 1
tab_account.Index = 1
Set_account()
send_sise()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(tab_order)
_AW_ONCLICK_AW_
Call order_tab_change()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_pswd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 And Len(Trim(ed_pswd.Data)) = "4" Then
	obj_account.Send
	SCREEN.Object("obj_jumn.smcd").SetFocus
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN1A)
_AW_ONCHANGE_AW_
obj_account.ClearAll 2
Set_account()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(smcd)
_AW_ONCHANGE_AW_
smcd.Trigger "smcd", False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_sise)
_AW_ONCLICK_AW_
Call sise_tab_change()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(jm_gubn)
_AW_ONCHANGE_AW_
tab_order.ID = jm_gubn.Data
order_tab_change()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_next)
_AW_ONCLICK_AW_
SCREEN.Proc "obj_account.send_c", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_account)
_AW_ONCLICK_AW_
Select Case tab_account.ID
Case 1 :
	obj_account.SetObject("IB660180")
	b_quri.SetRect 571, 232, 603, 252
	b_excl.Visible = True
	b_next.Visible = True
	cggb.Visible = False
	LABEL.Visible = False
	dyLabel.Visible = False
	dyCombo.Visible = False
	b_quri.SetRect 571, 281, 603, 301
Case 2 :
	obj_account.SetObject("IB660190")
	b_quri.SetRect 571, 232, 603, 252
	b_excl.Visible = True
	b_next.Visible = True
	cggb.Visible = True
	LABEL.Visible = True
	dyLabel.Visible = True
	dyCombo.Visible = True
	dyCombo.Index = dyEdit.Data
	cggb.Index = cggbEdit.Data
	b_quri.SetRect 571, 281, 603, 301
Case 3 :
	obj_account.SetObject("IB650183")
	b_quri.SetRect 604, 232, 636, 252
	b_excl.Visible = False
	b_next.Visible = False
	cggb.Visible = False
	LABEL.Visible = False
	dyLabel.Visible = False
	dyCombo.Visible = False
	b_quri.SetRect 604, 281, 636, 301
End Select

If Trim(ed_pswd.Data) <> "" Then
	obj_account.Send
End If

If tab_account.ID = 2 Then
	dtxt.Visible = True
Else
	dtxt.Visible = False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_excl)
_AW_ONCLICK_AW_
SCREEN.Object("obj_account.GRID").Excel True,True,""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cggb)
_AW_ONCHANGE_AW_
If tab_account.ID = 2 Then
	GUIDE.Text = ""
	cggbEdit.Data = cggb.Index
	SCREEN.Object("obj_account.cggb").data = cggb.Data
	obj_account.Send
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(dyCombo)
_AW_ONCHANGE_AW_
If tab_account.ID = 2 Then
	GUIDE.Text = ""
	dyEdit.Data = dyCombo.Index
	SCREEN.Object("obj_account.dyGubn").Data = Trim(dyCombo.Data)
	obj_account.Send
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_quri)
_AW_ONCLICK_AW_
SCREEN.Proc "obj_account.send_f", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


