_AW_ONDECLARE_AW_
Sub query()
	Dim data, cod, ii
'전체조회때는 인풋없이
'data = CONTROL0.Get813Account("")
'특정그룹 조회
	If Trim(SCREEN.Object("main.obj0.grp_combo").data) = "" Then
		GRID0.Clear
		Exit Sub
	End If
	cod = l_format(Trim(SCREEN.Object("main.obj0.grp_combo").data), "0", 4)
	data = CONTROL0.Get813Account(cod)
	GRID0.Clear
	GRID0.InsertRows 0, data, True

	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(ii, 2)) <> "" Then
			If Trim(GRID0.GetGridCell(ii, 4)) = "" Then
				GRID0.SetPRgb ii, 2, 94
			End If
		Else
			Exit For
		End If
	Next
End Sub

Sub attach(accn, acnm, pwd)
	Dim ii, idx
	idx = 0
	For ii = 1 To GRID0.Rows
		If accn = Trim(GRID0.GetGridCell(ii, 2)) Then
			idx = 1
		End If
	Next

	If idx <> 1 Then
		For ii =1 To GRID0.Rows
			If Trim(GRID0.GetGridCell(ii, 2)) = "" Then
				GRID0.InsertRow(ii)
				GRID0.SetGridCell ii, 2, accn
				GRID0.SetGridCell ii, 3, acnm
				GRID0.SetGridCell ii, 4, pwd
				Exit For
			End If
		Next
	End If
End Sub

Sub del()
	Dim ii
	'MsgBox GRID0.rows, 0, ""
	For ii = GRID0.Rows To 1 Step -1
		If Trim(GRID0.GetGridCell(ii, 1)) = 1 Then
			GRID0.RemoveRow(ii-1)
		End If
	Next
	SCREEN.Send 0
End Sub

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)
	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell (ii, 2)) = "" Then
			Exit For
		End If
		If Len(Trim(GRID0.GetGridCell (ii, 2))) > 10 Then
			GRID0.SetGridCell ii, 1, Flag
		End If

	Next
End Sub

