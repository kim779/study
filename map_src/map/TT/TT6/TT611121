RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'==계좌번호, 비밀번호 체크
Function L_CheckInput(zPwd)
 	L_CheckInput = False
 	If Trim(CMB_ACCT.text) = "" Or Len(Trim(CMB_ACCT.text)) < 13 Then
		Call alert_msg("계좌번호를 확인하십시오.")
 		CMB_ACCT.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zPwd.data)) < 4 Then
			Call alert_msg("비밀번호를 확인하십시오.")
	 		zPwd.Setfocus
	 		Exit Function
		End If
	End If
	L_CheckInput = True
End Function

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

'직원/고객에 따른 비밀번호 컨트롤 설정

Dim Day1, Day2, mm, dd

Day2 = CDate(QryEndDt.text)

Day1 = DateAdd("d", -14, Day2)

If Month(Day1) < 10 Then
	mm = "0" & Month(Day1)
Else
	mm = Month(Day1)
End If

If Day(Day1) < 10 Then
	dd = "0" & Day(Day1)
Else
	dd = Day(Day1)
End If

QrySrtDt.data = Year(Day1) & mm & dd

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

actno.Data = Trim(SCREEN.Object("parent.an50").data) & Trim(SCREEN.Object("parent.fundcode").data)

If Len(Trim(actno.data)) < 14 Then
	MsgBox "계좌번호나 펀드코드를 확인해 주십시오.", 0, "IBK 투자증권"
	Exit Sub
Else
	SCREEN.OnSend True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
End If

If LEDGER.Next = "Y" And LEDGER.Ecod <> "0136" Then
	Call send_c()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID1)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(QrySrtDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(QryEndDt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_


Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



