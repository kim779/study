cnt = 0

Sub Setting()
	Dim ii, items, items2, id, name, str

	grp_combo.Clear

	items = "01"

	For ii = 1 To grp_list.Rows

		id = Trim(grp_list.GetGridCell (ii, 1))
		name = Trim(grp_list.GetGridCell (ii, 2))

		items = items & vbTab & id & name
		cnt = cnt + 1
	Next

	grp_combo.SetItems(items )
End Sub

Sub query_gp()

	Dim data

	data = CONTROL0.Get813Group("")
	grp_list.Clear
	grp_list.InsertRows 0, data, True

	Call Setting()

	SCREEN.proc "main.obj1.query", ""
End Sub

