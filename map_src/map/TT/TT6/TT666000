RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim ii

Sub addition()
	For ii =1 To accn_list.rows
		If Trim(accn_list.GetGridCell(ii, 1)) = 1 Then
			SCREEN.Proc "main.obj1.attach", accn_list.GetGridCell(ii, 2) &","& accn_list.GetGridCell(ii, 3) &","& accn_list.GetGridCell(ii, 4)
		End If
	Next
	'SCREEN.Object ("main.obj1.act").data = "U"
	SCREEN.Object ("main.obj1").send
End Sub

Sub delete()
	SCREEN.proc "main.obj1.del", ""
End Sub

Sub search()
	Dim pos
	pos = 0

	If IsNumeric(Trim(s_input.data)) = True Then
		For ii = accn_list.rows To 1 Step -1
			pos = InStr(Trim(accn_list.GetGridCell(ii, 2)), Trim(s_input.data))

			If pos = 0 Then
				accn_list.RemoveRow ii-1
			End If
		Next
	Else
			For ii = accn_list.rows To 1 Step -1
			pos = InStr(Trim(accn_list.GetGridCell(ii, 3)), Trim(s_input.data))

			If pos = 0 Then
				accn_list.RemoveRow ii-1
			End If
		Next
	End If
End Sub

Sub Total_query()
	Dim data
	'전체조회때는 인풋없이
	data = CONTROL0.Get813Account("")
	'특정그룹 조회
	'data = CONTROL0.Get813Account("0001")
	accn_list.Clear
	accn_list.InsertRows 0, data, True
End Sub

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)
	For ii = 1 To accn_list.Rows
		If Trim(accn_list.GetGridCell (ii, 2)) = "" Then
			Exit For
		End If
		If Len(Trim(accn_list.GetGridCell (ii, 2))) > 10 Then
			accn_list.SetGridCell ii, 1, Flag
		End If

	Next
End Sub

_AW_ONSTART_AW_
'accn_list.setColumnVisible 4, False
Call Total_query()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
