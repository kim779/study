	Dim cnt
	cnt = 0
	If Trim(VIEWGRID.GetGridCell(1,1)) <> "" Then
		If C_all.Checked = True Then
			For i = 1 To VIEWGRID.Rows
				If Trim(VIEWGRID.GetGridCell(i, 2)) <> "" Then
					VIEWGRID.SetGridCell i , 1, 1
					cnt = cnt + 1
				End If
