Sub run_xorder

Dim s_data, accn, pswd
num.Data = 0

accn = SCREEN.Object("parent.OBJ1.AN16").data
pswd = Trim(SCREEN.Object("parent.OBJ1.pswd").data)
For ii = 1 To VIEWGRID.Rows
	If VIEWGRID.GetGridCell(ii ,1) = 1 Then
		If CDbl(num.Data) = MAX_ROWS Then Exit For
		If Trim(pswd) = "" Then Exit For

		s_data = "#" &s_data
		s_data = VIEWGRID.GetCell(ii , "c_msgb") & "|" & s_data		' 7 주문구분
		s_data = VIEWGRID.GetCell(ii , "c_curr") & "|" & s_data		' 6 주문가
		s_data = VIEWGRID.GetCell(ii , "c_xqty") & "|" & s_data		' 5 주문가능수량
		s_data = VIEWGRID.GetCell(ii , "c_hnam") & "|" & s_data		' 4 종목명
		s_data = VIEWGRID.GetCell(ii , "c_code") & "|" & s_data		' 3 종목코드
		s_data = pswd & "|" & s_data									' 2 비밀번호
		s_data = accn & "|" & s_data									' 1 계좌번호

		num.Data = num.Data + 1
	End If
Next

If num.Data > 0 Then
	num.Push ""
	SCREEN.CreateWindow 2, "IB700302 /t/s/p?/d", "s_data" & vbTab & s_data
	cls_check
End If

