Sub SetCal()
	Dim presentCost, Remain, fee, rate, buyCost, resultCost, sum, sooikRate, pyunggaCost, maeipCost, hTax, saveFees
	Dim TotalMaeip, TotalPyungga, TotalMoney, TotalCredit
	Dim maeipRate, maeipfee, creditMoney
	Dim code, chcode

'적용   ; (현재가*수량-수수료-제세금)-(매입단가*수량-수수료)=평가손익
' 제세금 = 현재가 * 수량 * 0.003
' 수수료 = 현재가 * 수량 * 수수료율
' 매입평균가 = 매입평균가 - 수수료
'평가금액 계산시 수수료 = 10원단위미만 절삭(현재가 * 수량 * 수수료율)
'평가금액 계산시 제세금 = 원단위미만 반올림(현재가 * 잔고 * 0.003)
'평가금액 = 수수료미적용 평가금액 - (수수료 + 제세금 + 세이브수수료(있을경우))
'
'매입금액 계산시 수수료 = 10원단위미만 절삭(매입평균가 * 수량 * 수수료율)
'매입금액 계산시 제세금 = 원단위미만 반올림(매입평균가 * 잔고 * 0.003)
'매입금액 = 수수료미적용 매입금액 + (수수료 + 제세금 + 세이브수수료(있을경우))
	sum = 0
	TotalMaeip = 0
	TotalPyungga = 0
	TotalMoney = 0
	creditMoney = 0
	TotalCredit = 0

	For ii=1 To SCREEN.Object("parent.viewGRID").Rows
		presentCost = Trim(SCREEN.Object("parent.viewGRID").GetGridCell(ii, 9))	  '현재가
		Remain = Trim(SCREEN.Object("parent.viewGRID").GetGridCell(ii, 5))		  '수량
		maeipCost =	Trim(SCREEN.Object("parent.viewGRID").GetGridCell(ii, 10))    '매입금액
		pyunggaCost	= Trim(SCREEN.Object("parent.viewGRID").GetGridCell(ii, 11))  '평가금액
'		buyCost = Trim(GRID0.GetGridCell(ii, 26))						'매입평균가
'		creditMoney = Trim(GRID0.GetGridCell(ii, 19))					'신용금액
		code = Trim(SCREEN.Object("parent.viewGRID").GetGridCell(ii, 2))

		If presentCost = "" Then
			presentCost = 0
		End If
		If Remain = "" Then
			Remain = 0
		End If
		If maeipCost = "" Then
			maeipCost = 0
		End If
		If pyunggaCost = "" Then
			pyunggaCost = 0
		End If
'		If buyCost = "" Then
'			buyCost = 0
'		End If
'		If creditMoney = "" Then
'			creditMoney = 0
'		End If

		If Trim(howtax.Text) <> "" Then
			hTax = FormatNumber(Trim(howtax.Text), 8,-1, 0, 0 )			'수수료율

			If Trim(saveFee.text) <> "" Then
				saveFees = Trim(saveFee.text)							'세이브 수수료
			Else
				saveFees = 0
			End If
		End If


		If Remain <> 0 Then

			rate = (presentCost * Remain * hTax) 							'수수료(현재가 기준)
			rate = Fix(rate)
			rate = (Fix(rate / 10)) * 10

			fee = presentCost * Remain * 0.003								'제세금(현재가 기준)
			fee = CLng(fee)
		Else
			rate = 0
			fee = 0
		End If

		'주식/신주인수권일때는 매입평균가가 없어도 계산을 해준다
		If Len(code) = 7 Or Len(code) = 9 Then
		    maeipRate = (buyCost * Remain * hTax)   								'수수료 = 현재가 * 수량 * 수수료율
			maeipRate = Fix(maeipRate)
			maeipRate = (Fix(maeipRate / 10)) * 10
			maeipCost = maeipCost + maeipRate + saveFees							'매입금액(수수료 포함)
		Else
			If maeipCost <> 0 Then
			    maeipRate = (buyCost * Remain * hTax)   								'수수료 = 현재가 * 수량 * 수수료율
				maeipRate = Fix(maeipRate)
				maeipRate = (Fix(maeipRate / 10)) * 10
				maeipCost = maeipCost + maeipRate + saveFees							'매입금액(수수료 포함)
			End If
		End If

		'ELW와 ETF는 수수료만 계산
		If Len(code) = 7 Then
			If Mid(code, 1, 1) = "J" Or SCREEN.GetCodeType(Mid(Trim(code), 2, 6)) = 6 Then
				pyunggaCost = pyunggaCost - (rate + saveFees)						'평가금액
			Else
				pyunggaCost = pyunggaCost - (rate + fee + saveFees)
			End If
		Else
			pyunggaCost = pyunggaCost - (rate + fee + saveFees)						'평가금액
		End If

		'채권일 경우, 현재가가 없으면 손익 0
		If presentCost = 0 And Len(Trim(SCREEN.Object("parent.viewGRID").GetGridCell(ii, 2))) = 12 Then
			resultCost = 0															'매도손익금액
		Else
			resultCost = pyunggaCost - maeipCost									'매도손익금액
		End If

'		'채권일 경우, 현재가가 없으면 손익률 0
'		If presentCost = 0 And Len(Trim(SCREEN.Object("parent.viewGRID").GetGridCell(ii, 2))) = 12 Then
'			sooikRate = 0.00
'		Else
'
'			If maeipCost = 0 And  creditMoney = 0 Then
'				sooikRate = 0.00
'			Else
'				sooikRate = ((pyunggaCost - maeipCost) / (maeipCost - creditMoney )) * 100
'			End If
'		End If

		TotalMaeip = TotalMaeip + maeipCost
		TotalPyungga = TotalPyungga + pyunggaCost
	Next

	If Trim(out_cred.data) = "" Then
		cred = 0
	Else
		cred = out_cred.Data
	End If

	If Trim(out_d2.Data) = "" Then
		out_ass.Data = TotalPyungga - cred
	Else
		out_ass.Data = out_d2.Data + (TotalPyungga - cred)  '예탁자산총액 = d+2에수금 +(평가 - 신용)
	End If

End Sub

