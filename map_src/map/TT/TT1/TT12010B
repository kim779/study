Sub InitTaxSave()
	Dim items,whatTax,strTax,taxArr,taxUse

	taxUse = SCREEN.Object("parent.cbo_tax").DATA
	whatTax = SCREEN.Object("parent.cbo_mmd").DATA

	If whatTax = 0 Then
		strTax = SCREEN.Object("parent.out_hts").DATA
	ElseIf whatTax = 1 Then
		strTax = SCREEN.Object("parent.out_call").DATA
	Else
		strTax = SCREEN.Object("parent.out_ars").DATA
	End If

	howtax.SetItems("")
	saveFee.SetItems("")

	If taxUse = 1 Then
		If Trim(strTax) <> "" Then
			taxArr = Split(strTax,vbTab,-1,1)

			items = "1" & vbTab & "1" & Trim(taxArr(0))
			howtax.SetItems(items)

			items = "1" & vbTab & "1" & Trim(taxArr(1))
			saveFee.SetItems(items)
		End If
	End If

	sect = 1
	Call ClearGlobaldata()
	Call send_f()

End Sub

