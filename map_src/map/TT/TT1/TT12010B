Sub calc_jasan()
	If Trim(out_cred.data) = "" Then
		cred = 0
	Else
		cred = Trim(out_cred.data)
	End If

	If Trim(out_d2.data) = "" Then
		d2 = 0
	Else
		d2 = Trim(out_d2.data)
	End If

	If Trim(SCREEN.Object("parent.o_pggm").data) <> "" Then
		out_ass.Data = CLng(d2) + (CLng(Trim(SCREEN.Object("parent.o_pggm").data)) - CLng(cred))
	Else
		out_ass.Data = CLng(d2) - CLng(cred)
	End If

End Sub

Sub OnClear()
	out_can.Data = ""
	out_d2.Data = ""
	out_ass.Data = ""
	out_cred.Data = ""
End Sub

