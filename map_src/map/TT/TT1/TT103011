'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim dmsg
	If SCREEN.GetCodeType(S1301.Data) = 9 Then
		MsgBox "ELW종목은 주문불가 종목입니다.", ,"IBK투자증권"
		Exit Sub
	End If
	Set_data()											'주문 기본세팅

	If Error_chk() = False Then						'주문전 Error Check
		Exit Sub
	End If

	'주문확인창 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		dmsg =  "o_acno" & vbTab & zAcntNo.Data & vbLf &_
				"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
				"o_hnam" & vbTab & Mid(SCREEN.Object("OBJ_hnam.1022").Data,2) & vbLf &_
				"o_jqty" & vbTab & lOrdQty.Data & vbLf

		SCREEN.CreateWindow 2, "IB103030 /p? /d", dmsg

		If SYSTEM.Pop("stock_mado_order") <> "OK" Then
			Exit Sub
		End If
	End If

	SCREEN.Send 0										'주문전송

	'Call QueryOption("after")

	cPos = OrdCfg.ReadCfg("CursorPos")
	Select Case cPos
		Case "0" : SCREEN.Object("parent.AN1A").SetFocus()
		Case "1" : SCREEN.Object("parent.ed_pswd").SetFocus()
		Case "2" : S1301.SetFocus()
		Case "3" : ed_jqty.SetFocus()
	End Select
End Sub

Sub Set_data()
	zBnsTp.Data = "1"									'매매구분
	zAcntNo.Data = SCREEN.Object("parent.AN1A").Data	'계좌번호
	zPwd.Data = SCREEN.Object("parent.ed_pswd").Data	'비밀번호
	zIsuNo.Data = S1301.Data							'종목코드
	lOrdQty.Data = String(7, "0") & ed_jqty.Data				'주문수량
	If (SYSTEM.ConnectBy) Then
		zCommdaCode.Data = "00"
	Else
		zCommdaCode.Data = "01"
	End If
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_chk()

	Dim mstr
	Dim name

	Error_chk = False
	If Trim(zAcntNo.Data) = "" Then
		SCREEN.Object("parent.AN1A").SetFocus
		MsgBox "계좌번호를 확인하세요", , "주문에러"
		Exit Function
	End If

	If Trim(zPwd.Data) = "" Then
		SCREEN.Object("parent.ed_pswd").SetFocus
		MsgBox "비밀번호를 확인하세요", , "주문에러"
		Exit Function
	End If

	Select Case mmgb
		Case "1" : mstr = "매도"
		Case "2" : mstr = "매수"
		Case "3" : mstr = "정정"
		Case "4" : mstr = "취소"
	End Select

	name = SCREEN.GetName(100, zIsuNo.Data, 0)
	If	zIsuNo.Data = "" Or name = "" Then
		MsgBox "종목코드를 확인하세요", , "주문에러"
		S1301.SetFocus
		Exit Function
	End If

	'주문수량 check
	If ed_jqty.Enable = True And Is_numeric(ed_jqty.Data) = False Then
		MsgBox mstr & "수량을 입력하세요", , "주문에러"
		ed_jqty.SetFocus
		Exit Function
	End If

	Error_chk = True
End Function

Sub	ChangeCode()
	Dim name
	name = SCREEN.GetName(100, S1301.Data, 0)
	If name = "" Then
	     Exit Sub
	End If

	SCREEN.Object("OBJ_hnam.1301").Data = S1301.Data
	OBJ_hnam.Send
End Sub

