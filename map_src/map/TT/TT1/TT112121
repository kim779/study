End Sub

'*************************************************************
'주문 가능수량
'*************************************************************
Sub Jumun_vol(gubn)
	SCREEN.Object("obj1.ed_acno").data = Left(AN20.data, 8)
	SCREEN.Object("obj1.ed_pswd").data = ed_pswd.Data
	SCREEN.Object("obj1.ed_code").data = SCREEN.object("main.ed_focod").Data
	SCREEN.Object("obj1.ed_gubn").data = gubn
	SCREEN.Object("obj1.ed_mmgb").data = CInt(mmgb.Text)+1
	SCREEN.Object("obj1.ed_basp").data = Right(ed_jprc.data, 9)
	SCREEN.Object("obj1.ed_hogb").data = change_hogb(ed_hogb.Data)

	SCREEN.IgnoreChange True
	If Jumun_Chk(1,Null) = True Then
		SCREEN.Object("obj1.send").data = "Y"
		obj1.Send
		ed_jqty.SetFocus
	End If
	SCREEN.IgnoreChange False

End Sub

'*************************************************************
'주문 send
'*************************************************************
Sub Jumun_click(jmgb)
	SCREEN.Object("main.guide").text = ""
	SCREEN.Object("obj0.ed_acno").data = AN20.data
	SCREEN.Object("obj0.ed_pswd").data = ed_pswd.data
	SCREEN.Object("obj0.ed_code").data = SCREEN.object("main.ed_focod").Data
	SCREEN.Object("obj0.ed_jqty").data = ed_jqty.data
	SCREEN.Object("obj0.ed_jprc").data = ed_jprc.data
	SCREEN.Object("obj0.ed_hogb").data = ed_hogb.data
	SCREEN.Object("obj0.ed_jmgb").data = jmgb
	SCREEN.Object("obj0.ed_mmgb").data = "1"
	SCREEN.Object("obj0.lab_jmno").text = "Y"

	SCREEN.IgnoreChange True
	If Jumun_Chk(0, Null) = True Then
		SCREEN.Object("obj0.send").data = "Y"
		obj0.Send
	End If
	SCREEN.IgnoreChange False
End Sub

' 호가 OBJ에서 가격 클릭시
Sub click_prc(prc)
	If ed_jprc.Enable = False Then Exit Sub
	If CDbl(prc) = 0.0 Then Exit Sub
	ed_jprc.Data = prc
	ed_jqty.SetFocus()
End Sub

