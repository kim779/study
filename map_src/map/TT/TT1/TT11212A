_AW_ONDECLARE_AW_
Sub Jumun_click(xval)
	guide.Text = ""
	ed_mmgb.Data = xval
	
	If xval = "3" Or xval = "4" Then
		If Trim(ed_ogno.Data) = "" Then
			ed_ogno.SetFocus
			Exit Sub
		End If
		If r_mdgb0.Checked Then
			ed_mdgb.Data = "2"		'전부
			ed_jqty.Data = "0"
		Else
			ed_mdgb.Data = "1"
			If Trim(ed_jqty.Data) = "" Or Trim(ed_jqty.Data) = "0" Then
				MsgBox "정정수량을 입력하세요"
				ed_jqty.SetFocus
				Exit Sub
			End If
		End If
	End If
		
	SCREEN.send 0
End Sub

