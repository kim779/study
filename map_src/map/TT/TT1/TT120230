RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
End Sub

Function chkNumData(data)
	chkNumData = False

	If Trim(data) = "" Then
		Exit Function
	End If

	If IsNumeric(data) = False Then
		Exit Function
	End If

	chkNumData = True

End Function

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("parent.GUIDE").Text = ""

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	SCREEN.Object("parent.GUIDE").Text = "계좌번호를 확인하여 주십시오."
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(SCREEN.Object("parent.zPwd").Data) = "" Then
   zPwd.Data = "9999"
Else
	zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)
End If

If Len(Trim(zPwd.Data)) < 4 Then
	SCREEN.Object("parent.GUIDE").Text = "비밀번호를 확인하여 주십시오."
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

zQryTp.Data = "2"

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim machaeGb, fee, fee_save
machaeGb = Trim(SCREEN.Object("parent.machaeTp").Data)

Select Case machaeGb
	Case 1	'HTS / 홈페이지
			fee = Trim(o_hts.Data)
			fee_save = Trim(o_save_hts.Data)

			If chkNumData(fee) = False Then
				fee = "0.00100000"
				fee_save = "0000000000000000"
			End If
	Case 2	'영업점 / 콜센터
			fee = Trim(o_call.Data)
			fee_save = Trim(o_save_call.Data)

			If chkNumData(fee) = False Then
				fee = "0.00500000"
				fee_save = "0000000000000000"
			End If
	Case 3	'ars
			fee = Trim(o_ars.Data)
			fee_save = Trim(o_save_ars.Data)

			If chkNumData(fee) = False Then
				fee = "0.00250000"
				fee_save = "0000000000000000"
			End If
End Select

SCREEN.Object("parent.obj.fee").Data = fee
SCREEN.Object("parent.obj.fee_save").Data = fee_save

SCREEN.Proc "parent.obj.send_f", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(o_call)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(o_hts)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(o_ars)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(o_save_call)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(o_save_hts)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(o_save_ars)
_AW_ENDSCRIPT_AW_


}



