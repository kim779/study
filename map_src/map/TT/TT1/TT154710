RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'PowerBase TR1547(SONBQ036)과 비슷한 화면.
'SONBQ006은 PowerBase TR이 없음.

LEDGER.Rcnt = "0013"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.AN20").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오")
	SCREEN.Object("parent.AN20").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 And Trim(SCREEN.Object("parent.zPwd").Data) = "" Then
	SCREEN.Object("parent.zPwd").Data = "9999"
	zPwd.Data = "9999"
Else
	zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)
End If

If Len(Trim(zPwd.Data)) < 4 Then
	Call alert_msg("비밀번호를 확인하여 주십시오")
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

zQrySrtDt.Data = Trim(SCREEN.Object("parent.zQrySrtDt").Data)
zQryEndDt.Data = Trim(SCREEN.Object("parent.zQryEndDt").Data)
zFnoClssCode.Data = Trim(SCREEN.Object("parent.zFnoClssCode").Data)		'선물옵션분류코드
zPdGrpCode.Data = Trim(SCREEN.Object("parent.zPdGrpCode").Data)			'상품군코드
zExecTp.Data = Trim(SCREEN.Object("parent.zExecTp").Data)				'체결구분
zStnlnSeqTp.Data = Trim(SCREEN.Object("parent.zStnlnSeqTp").Data)		'정렬순서
zCommdaCode.Data = "99"													'통신매체코드

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = 0 Then
	If LEDGER.Next = "Y" Then
		SCREEN.Object("parent.next_btn").Enable = True
	Else
		SCREEN.Object("parent.next_btn").Enable = False
	End If
Else
	SCREEN.Object("parent.next_btn").Enable = False
End If

