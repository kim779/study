_AW_ONDECLARE_AW_
'--출금펀드번호 입력창 세팅
Sub fund(gb)
	Dim valx
	If chk.Text = CStr(gb) Then
		Exit Sub
	End If

	If gb = 0 Then
		valx = -22
		chk.Text = "0"
	ElseIf gb = 1 Then
		valx = 22
		chk.Text = "1"
	Else
		Exit Sub
	End If

	Call move(PAN_pwd, valx)
	Call move(zPwd, valx)
	Call move(PAN_price, valx)
	Call move(lMnyrclOdpntRepayAmt, valx)
	Call move(PAN_type, valx)
	Call move(zMnyoutPtnTp, valx)
	Call move(PAN_before, valx)
	Call move(lMnyoutDpsBfbalAmt, valx)
	Call move(PAN_after, valx)
	Call move(lMnyoutDpsCrbalAmt, valx)
End Sub

Sub move(valx, valy)
	valx.Top = valx.Top + valy
	valx.Bottom = valx.Top + 23
End Sub

'--계좌번호, 계좌명 세팅
Sub acct_set()
	Dim account
	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text

	account = Replace(CMB_ACCT.Text, "-", "")
	zAcntNo.Data = account
End Sub

'--펀드계좌 여부 체크
Sub fund_chk()
	If Mid(CMB_ACCT.text, 5,2) = "53" Then
		CMB_ACCT2.Visible = False
		EDIT_ACCT.Visible = True
		PAN_fund.Visible = True
		zBncertSellIsuNo.Visible = True
		zBncertSellIsuSeqno.Visible = True
		fundbtn.Visible = True
		Call fund(1)
	Else
		EDIT_ACCT.Visible = False
		CMB_ACCT2.Visible = True
		PAN_fund.Visible = False
		zBncertSellIsuNo.Visible = False
		zBncertSellIsuSeqno.Visible = False
		fundbtn.Visible = False
		Call fund(0)
	End If
End Sub

'--은행개설계좌 여부 체크
Sub bank_chk()
	If Left(CMB_ACCT.text, 1) = "7" Then
		F2.Enable = False
		EDIT_ACCT.Visible = False
		CMB_ACCT2.Visible = True
	End If
End Sub

'--출금가능금액조회
Sub AMT_send()
	Dim acct1, acct2
	acct1 = Mid(zAcntNo.data,1,3)
	acct2 = Mid(zAcntNo.data, 6, 6)

	SCREEN.Object("OBJ1.zIntaccNo").DATA = acct1 & "00" & acct2
	SCREEN.Object("OBJ1.zPwd").DATA = zPwd.Data
	SCREEN.Object("OBJ1.EDIT_act").DATA = zAcntNo.Data

	OBJ1.Send
End Sub


Sub F1_chk()
	CMB_ACCT2.Visible = True
	EDIT_ACCT.Visible = False
	OBJ_yact.Send

	If gubn.text = "1" Then
		OBJ_sec2.Visible = True
	ElseIf gubn.text = "3" Then
		OBJ_otp2.Visible = True
	Else
		OBJ_bank.Visible = True
	End If

	'OBJ1.Send
End Sub

Sub F2_chk()
	CMB_ACCT2.Visible = False
	EDIT_ACCT.Visible = True
	OBJ_bank.Visible = False

	If gubn.text  = "1" Then
		OBJ_sec2.Visible = True
	ElseIf gubn.text = "3" Then
	 	OBJ_otp1.Send
	 	OBJ_otp2.Visible = True
	End If

	EDIT_ACCT.Setfocus
End Sub

Sub OBJ_SEND()
	If gubn.Text = "1" Then
		OBJ_sec2.Send
	ElseIf gubn.Text = "3" Then
	 	OBJ_otp2.Send
	ElseIf F1.Checked = True And gubn.Text <> "1" And gubn.Text <> "3" Then
		OBJ_bank.Send
	End If
End Sub

