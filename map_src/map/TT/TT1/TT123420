_AW_ONDECLARE_AW_
Sub Set_account()
	SCREEN.ClearAll 0, 2
	ACNM.Data = AN1A.Name
'	zPwd.Data = AN1A.Password

	If Len(Trim(AN1A.Data)) <> 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

'	If SYSTEM.ConnectBy = "0" Then
'		zPwd.Data = "9999"
'	End If

'	If Len(Trim(zPwd.Data)) < 4 Then
'		zPwd.SetFocus
'		Exit Sub
'	End If
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub SettingCB(data)
	Dim dataArray, ii, f, cbdata
	ReDim dataArray(100)
	dataArray = Split(data, "|", -1 ,1)

	For Each f in dataArray
		If Len(f) <> 0 Then
			f =  vbTab & f
			ii = ii & f
		End If
	Next

	cbdata = "03" & ii

	ProductCB.SetItems(cbdata)
End Sub

_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

