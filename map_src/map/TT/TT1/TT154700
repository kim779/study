_AW_ONDECLARE_AW_
Option Explicit

Dim Today
Today = getCurrDay()

Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj.Clear
	GUIDE.Text = ""

	If Len(Trim(AN20.Data)) = 11 Then
		ACNM.Data = Trim(AN20.Name)
		zPwd.Data = Trim(AN20.Password)

		If SYSTEM.ConnectBy = 1 And Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If

		SCREEN.Proc "obj.send_f", ""
	Else
		AN20.SetFocus
		Exit Sub
	End If
End Sub

