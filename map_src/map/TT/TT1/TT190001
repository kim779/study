_AW_ONDECLARE_AW_
Sub do_delete( code, name )

EDIT1.Data = "D"
EDIT2.Data = "11"
EDIT3.Data = code
EDIT4.Data = name
EDIT5.Data = "00000"

GRID0.SetRows(0)

SCREEN.Send 0

End Sub

Sub do_insert(mode, name, num)
SYSTEM.Trace("do_insert")

EDIT1.Data = mode
EDIT2.Data = "11"
If mode = "U" Then
	EDIT3.Data = num
End If
EDIT4.Data = name

Dim count, idx, accn
count = 0

For i = 1 To SCREEN.Object("main.gr_gp_accn").Rows ' 입력 갯수 체크
	If Len(Trim(SCREEN.Object("main.gr_gp_accn").GetGridCell( i, 3 ))) = 0 Then
		Exit For
	End If
	count = count + 1
Next

'MsgBox count

If count = 0 Then
	Dim ret
	ret = MsgBox("'" & name & "' 그룹에 계좌가 없습니다. 삭제 하시겠습니까?", 4, "그룹삭제")
	If ret = vbYes Then
		do_delete num , name
	End If
	Exit Sub
End If

GRID0.SetRows( count )
EDIT5.Data = count
idx = 1

For j = 1 To GRID0.Rows
	If Len(Trim(SCREEN.Object("main.gr_gp_accn").GetGridCell(j,3))) <> 0 Then
		accn = Trim(SCREEN.Object("main.gr_gp_accn").GetGridCell(j,3)) ' 그룹계좌번호
		GRID0.SetGridCell idx, 1, accn

		a = Trim(SCREEN.Object("main.gr_gp_accn").GetGridCell(j,5)) ' 비밀번호
		If check_data( a, accn, "비밀번호" ) = False  Then
			Exit Sub
		End If
		GRID0.SetGridCell idx, 2, a

		a = Trim(SCREEN.Object("main.gr_gp_accn").GetGridCell(j,4)) ' 계좌명
		GRID0.SetGridCell idx, 3, a

		a = Trim(SCREEN.Object("main.gr_gp_accn").GetGridCell(j,6)) ' 빈도
		If check_data( a, accn, "비율" ) = False Then
			Exit Sub
		End If
		GRID0.SetGridCell idx, 4, make_n(a,5,10)

		a = Trim(SCREEN.Object("main.gr_gp_accn").GetGridCell(j,7)) ' 승수비율
		If check_data( a, accn, "배수" ) = False Then
			Exit Sub
		End If
		GRID0.SetGridCell idx, 5, make_n(a,5,10)

		idx = idx + 1
	End If
Next

SCREEN.Send 0

End Sub

Function check_data( a, accn, msg )

accn = Mid(accn,1,3) & "-" & Mid(accn, 4, 2) & "-" & Mid(accn, 6, 6)

If Len(a) = 0 Then
	MsgBox "계좌번호 [" & accn & "]" & "의 " & msg & "(" & a & ") 가 입력되지 않았습니다."
	check_data = False
Else
	check_data = True
End If

End Function


Function make_n( a, b, c )

Dim i, j, k, m

SYSTEM.Trace( "make_n " & a )

If Len(a) = 0 Then
	make_n = "+00000.0000000000"
Else

	If InStr(a,".") = 0 Then
		i = Len( a )
		k = String( b-Len( a ), "0" ) & a

		make_n = "+" & k & "." & "0000000000"
	Else
		i = Left( a, InStr(a,".")-1 )
		SYSTEM.Trace( i )
		j = Right( a, Len(a)-InStr(a,".") )
		SYSTEM.Trace( j )
		k = String( b-Len( i ), "0" ) & i
		SYSTEM.Trace( k )
		m = j & String( c-Len( j ), "0" )
		SYSTEM.Trace( m )

		make_n = "+" & k & "." & m
	End If
End If

SYSTEM.Trace( make_n )

End Function

