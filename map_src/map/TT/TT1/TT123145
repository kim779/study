	SCREEN.ClearAll 2, 2
	ACNM.Data = AN10.Name
	zPwd.Data = AN10.Password
	If Trim(AN10.Data) = "" Then
		AN10.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

