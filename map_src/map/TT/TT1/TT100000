_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN10.Name
	'h_acnm.Data = AN10.Name
	zPwd.Data = AN10.Password
	If Trim(AN10.Data) = "" Then
		AN10.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
'	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

