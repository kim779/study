' 선물/옵션 주문수량 숫자여부
'***************************************************************************
Function Is_numeric(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		num = 0
	End If

'	If CDbl(num) <= 0 Then
'		Is_numeric = False
'		Exit Function
'	End If

	If IsNumeric(num) = False Then
		Is_numeric = False
		Exit Function
	End If
	Is_numeric = True
End Function

