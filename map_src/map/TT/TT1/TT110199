'***************************************************************************
' 선물/옵션 정정/취소시 원주문번호,주문단가 셋팅
'***************************************************************************
Sub Get_jmno ()
	Dim ret, prc, num, cPos, indata, code_sym

	out_jmno.data = ""
	num = SYSTEM.Pop ("FO_jmno")
	prc = SYSTEM.Pop ("FO_jprc")
	If Trim(num) <> "000000" Or Trim(num) <> ""Then
		ed_ogno.data = num
	End If
	If SCREEN.Object("main.TAB1").index = 3 Or SCREEN.Object("main.TAB1").index = 5 Then
		If Trim(prc) <> "" Then
			Select Case CONFIG.ReadCfg("JJPrcGb")
			Case "2"	: ed_jprc.data = prc			'정정주문의 주문단가 조회
			Case "1"
				Call l_fuop_gb(ed_focod.Data, code_sym)
				indata = code_sym & Chr(127) & ed_focod.Data & vbTab & Left(code_sym,1)&"1023" & vbTab
				ed_jprc.data = Abs(SCREEN.ServiceEx("pooppoop", indata, Len(indata), &H02, 2000))
			End Select
		End If
	End If
End Sub
'==============================================
' name : l_fuop_gb
' desc : 종목코드로 (선물/주식선물/옵션)구분자 리턴
' IN   : (종목코드, ByRef code_symbol)
'DH888899 에 정의됨. 주식선물 잡업시 유의
Function l_fuop_gb(code, focod)
	Select Case Left(code, 1)
		Case "1", "4"		'선물, 주식선물
			If Mid(code, 2, 1) = "0" Then			'선물
				If IsNull(focod) = False Then focod = "30301"
'				l_fuop_gb = lv_kind_fu
			Else											'주식선물
				If IsNull(focod) = False Then focod = "50301"
'				l_fuop_gb = lv_kind_sf
			End If
		Case "2", "3"								'옵션
			If IsNull(focod) = False Then focod = "40301"
'			l_fuop_gb = lv_kind_op
		Case Else
			focod = ""
'			l_fuop_gb = -1
	End Select
End Function

'***************************************************************************
' 선물/옵션 호가단위 셋팅
'			- 인자 : 종목코드 8자리
'***************************************************************************
Sub Hoga_unit(fogb)
	Dim code
	If Trim(fogb) = "" Then Exit Sub
	code = Left(Trim(fogb), 3)
	Select Case code
		Case "101","401" : ed_jprc.SetType(110)		'지수선물
		Case "103","403" : ed_jprc.SetType(101)		'스타선물
		Case "201","301" : ed_jprc.SetType(130)		'옵션
		Case Else
			If Int(Mid(code, 1, 2)) > 10 Then
				ed_jprc.SetType(100)
			End If
	End Select
End Sub

'***************************************************************************
' 선물/옵션 코드변경시
' 리턴값 : 커서유지 여부
'***************************************************************************
Function ChangeCode()
	Dim cPos

	ChangeCode = False
	ed_jprc.data = 0

	CONFIG.ItemCd = ed_focod.Data
	QueryOption()

	cPos = CONFIG.ReadCfg("NotMoveCode")
	If cPos = "1" Then	'커서유지
		ed_focod.Setfocus
		ChangeCode = True
	End If

End Function

'***************************************************************************
' 선물/옵션 price컨트롤 셋팅
'			- 인자 : 종목코드 8자리
'***************************************************************************
Sub Set_price(fogb)
	Dim code
	code = Left(Trim(fogb), 1)
	Select Case code
		Case "1", "4"		'지수선물
			HOGA.type = Asc("F")
			HOGA.jcode = fogb
		Case "2","3"		'옵션
			HOGA.type = Asc("O")
			HOGA.jcode = fogb
		Case Else
			Exit Sub
	End Select
End Sub

'***************************************************************************
' 선물/옵션 주문 포커스 관리(정정/취소)
' 인자 : code => 포커스 셋팅할 종목코드
'		   flag => 원주문 셋팅 여부
'***************************************************************************
Sub Jumun_focus(code, flag)
	Dim cPos

	If flag = "True" Then
		flag = True
	Else
		flag = False
	End If

	If flag = True Then
		If Trim(AN20.data) = "" Or Trim(ed_pswd.data) = "" Then
			SCREEN.SetTimer 1, False
			Exit Sub
		End If

		If CONFIG.OrderGB = "2" Then					'정정일때만 커서 셋팅
			cPos = CONFIG.ReadCfg("JJCursorPos")	'수량,유형,가격
			Select Case cPos
				Case "0" : ed_jqty.Setfocus
				Case "1" : ed_hogb.Setfocus
				Case "2" : ed_jprc.Setfocus
			End Select
		ElseIf CONFIG.OrderGB = "3" Then
			JUMUN_B.Setfocus
		End If
	Else
		cPos = CONFIG.ReadCfg("NotMoveCode") '커서유지
		If cPos = "1"Then
			SCREEN.Object(code).Setfocus
		Else
			If SYSTEM.pop ("1101_click") <> "click" Then
				SCREEN.SetTimer 2, False
			End If
		End If
	End If
	SYSTEM.Push "1101_click", ""
End Sub

}



