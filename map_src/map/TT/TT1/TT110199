	CONFIG.OrderGB = CStr(Trim(mmgb.text)) 'OrderGB Map화면 주문구분(0:매도, 1:매수, 2:정정)
	CONFIG.LoadInfo

	Select Case CONFIG.OrderGB
		Case "0" 			'매도
			clean_nm = "parent.clearpush_sell"
		Case "1"				'매수
			clean_nm = "parent.clearpush_buy"
		Case "2"				'정정
			clean_nm = "parent.clearpush_jj"
		Case "3"				'취소
			clean_nm = "parent.clearpush_cancel"
	End Select

	If SCREEN.Object(clean_nm).data = "1" Then
		SCREEN.Object(clean_nm).data = "0"
		'첫번째 화면실행시에는 메모리정보 Clear
		CONFIG.ClearPush
	Else
		CONFIG.Pop
	End If
'	CONFIG.ItemCd = ed_focod.data
'	QueryOption()
End Sub

'***************************************************************************
' 선물/옵션 send시 주문창 여부
'***************************************************************************
Function Jumun_send()
	Dim mmgb			'매도/매수/정정/취소 구분
	Dim accm, hnam, retn, hogb, mdgb, jqty, jmgb
	Dim qtyOpt, gubn, cfg_name

	'주문후 단가/수량 저장을 위한
	SCREEN.Object("parent.CONFIG").Price = ed_jprc.Data
	SCREEN.Object("parent.CONFIG").Qty = ed_jqty.data
	SCREEN.Object("parent.CONFIG").Push

	'주문창 여부
	If SCREEN.Object("parent.CONFIG").OrderConfirm <> True Then
		Jumun_send = True
		Exit Function
	End If

	accm = Trim(SCREEN.Object("parent.out_accm").data)
	hnam = Trim(SCREEN.Object("parent.hnam").data)
	hogb = Get_hogb(ed_hogb.data)
	jqty = ed_jqty.data

	jmgb=""
	If ed_jmgb.data = "01" Then
		jmgb = " (IOC)"
	ElseIf ed_jmgb.data = "02" Then
		jmgb = " (FOK)"
	End If

	If Trim(ed_mdgb.data) = "2" Then
		mdgb = "전부"
		jqty = ""
	Else
		mdgb = "일부"
	End If
	Select Case Trim(ed_mmgb.data)
		Case "1"	'매도
			SCREEN.CreateWindow 2, "DH11019A /d/p5","ed_acno"&vbTab&ed_acno.data&vbLf _
 					&"out_accm"&vbTab&accm&vbLf&"hnam"&vbTab&hnam&vbLf _
					&"ed_hogb"&vbTab&hogb&jmgb&vbLf&"ed_jqty"&vbTab&jqty&vbLf _
					&"ed_jprc"&vbTab&ed_jprc.data&vbLf
		Case "2"	'매수
			SCREEN.CreateWindow 2, "DH11019B /d/p5","ed_acno"&vbTab&ed_acno.data&vbLf _
 					&"out_accm"&vbTab&accm&vbLf&"hnam"&vbTab&hnam&vbLf _
					&"ed_hogb"&vbTab&hogb&jmgb&vbLf&"ed_jqty"&vbTab&jqty&vbLf _
					&"ed_jprc"&vbTab&ed_jprc.data&vbLf
		Case "3"			'정정
			SCREEN.CreateWindow 2, "DH11019C /d/p5","ed_acno"&vbTab&ed_acno.data&vbLf _
 					&"out_accm"&vbTab&accm&vbLf&"hnam"&vbTab&hnam&vbLf _
					&"ed_ogno"&vbTab&ed_ogno.data&vbLf&"ed_jqty"&vbTab&jqty&vbLf _
					&"ed_jprc"&vbTab&ed_jprc.data&vbLf&"mmgb"&vbTab&ed_mmgb.data &vbLf _
					&"ed_mdgb"&vbTab&mdgb&vbLf&"ed_hogb"&vbTab&hogb&vbLf
		Case "4"			'취소
			SCREEN.CreateWindow 2, "DH11019D /d/p5","ed_acno"&vbTab&ed_acno.data&vbLf _
 					&"out_accm"&vbTab&accm&vbLf&"hnam"&vbTab&hnam&vbLf _
					&"ed_ogno"&vbTab&ed_ogno.data&vbLf&"ed_jqty"&vbTab&jqty&vbLf _
					&"mmgb"&vbTab&ed_mmgb.data &vbLf &"ed_mdgb"&vbTab&mdgb&vbLf
	End Select

	retn = SYSTEM.Pop("OKOK")
	If retn <> "Y" Then
		Jumun_send = False
		Exit Function
	End If

	SYSTEM.Push "OKOK", "N"
	Jumun_send = True

	SCREEN.Object("parent.CONFIG").LoadInfo()
	Select Case SCREEN.Object("parent.CONFIG").OrderGB
		Case "0"
			cfg_name = "SellQtyGB"
		Case "1"
			cfg_name = "BuyQtyGB"
	End Select

	If SCREEN.Object("parent.CONFIG").KeepQty = True Then '수량유지
		SCREEN.Object("parent.ed_jqty").data = SCREEN.Object("parent.CONFIG").Qty
	Else
		qtyOpt = SCREEN.Object("parent.CONFIG").ReadCfg(cfg_name)
		If qtyOpt <> "1"Then
			SCREEN.Object("parent.CONFIG").QueryQty
		Else
			SCREEN.Proc "parent.Jumun_vol", ""
		End If
	End If

	If SCREEN.Object("parent.CONFIG").KeepPrc = True  Then '가격유지
		SCREEN.Object("parent.ed_jprc").data = SCREEN.Object("parent.CONFIG").Price
	Else
		SCREEN.Object("parent.ed_hogb").Data = "00"
		SCREEN.Object("parent.ed_jprc").enable = True
		SCREEN.Object("parent.CONFIG").QueryHoga
	End If

End Function
'***************************************************************************
' 선물/옵션 주문후 커서 설정
' 인자 : who - 0: 계좌 , 1: 코드
'        pos - main? parent?
'			code - 코드명
'***************************************************************************
Sub Set_cursor(who, pos, code)
	Dim cPos

	cPos = CONFIG.ReadCfg("CursorPos")
	Select Case cPos
		Case "0"
			If who = "0" Then
				SCREEN.Object(pos&".AN20").SetFocus()
			Else
				AN21.SetFocus()
			End If
		Case "1"
			If who = "0" Then
				SCREEN.Object(pos&".ed_pswd").SetFocus()
			Else
				ed_pswd.SetFocus()
			End If
		Case "2"
			If who = "1" Then
				SCREEN.Object(pos&"."&code).SetFocus()
			Else
				SCREEN.Object(code).SetFocus()
			End If
		Case "3"
			ed_jqty.SetFocus()
		Case "4"
			ed_jprc.SetFocus()
	End Select
End Sub
