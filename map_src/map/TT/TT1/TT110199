			Jumun_Chk = False
			Exit Function
'		Else
'			If SCREEN.Object(set_acnt&".AN21").ConfirmPswd(SCREEN.Object(set_acnt&".ed_pswd").data) = False Then
'				MsgBox "비밀번호오류입니다.", , "주문에러"
'				SCREEN.Object(set_acnt&".ed_pswd").data = ""
'				SCREEN.Object(set_acnt&".ed_pswd").Setfocus
'				Jumun_Chk = False
'				Exit Function
'			End If
		End If
	End If

   '종목코드 check
	flag = Left(ed_focod.Data, 1)
	If flag = "1" Or flag = "4" Then
		hanm = SCREEN.GetName (101, ed_focod.Data, 0)
		If Trim(hanm) = "" Then
			MsgBox "종목코드를 확인하세요", , "주문에러"
