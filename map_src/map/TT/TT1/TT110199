'***************************************************************************
' 선물/옵션 주문수량설정 컨트롤 초기화
'***************************************************************************
Sub QueryOption()
	Dim qtyOpt, gubn, cfg_name, jqty

	'주문구분 - 0:매도, 1:매수, 2:정정
	Select Case CONFIG.OrderGB
		Case "0", "1", "2"
			CONFIG.QueryHoga
		Case Else
			Exit Sub
	End Select

	'주문구분 - 0:매도, 1:매수, 2:정정
	Select Case CONFIG.OrderGB
		Case "0"
			cfg_name = "SellQtyGB"
		Case "1"
			cfg_name = "BuyQtyGB"
		Case "2"
			If CONFIG.ReadCfg("JJPrcGb") = "2" Then
				'정정주문의 주문단가 조회
				'CONFIG.Price
			End If
			Exit Sub
	End Select


	jqty = SYSTEM.Pop ("1101_jqty")
	If Trim(jqty) = "" Then
		qtyOpt = CONFIG.ReadCfg(cfg_name)
		If qtyOpt = "1" Then				'주문가능수량
			If Trim(AN20.data) <> "" And Trim(ed_pswd.data) <> "" Then
'				If Is_numeric(ed_jprc.Data) <> True Then
'					ed_jprc.data = CONFIG.price
'				End If

				If Is_numeric(ed_jprc.Data) = True Then
					Jumun_vol(0)
				Else
					ed_jqty.data = 0
				End If
			End If
		Else
			CONFIG.QueryQty
		End If
	Else
		ed_jqty.data = jqty
	End If

End Sub

