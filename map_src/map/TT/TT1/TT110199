'***************************************************************
'주문유형 (char->string)
'***************************************************************
Function Get_hogb(hogb)
	Select Case hogb
		Case "L", "00"
			Get_hogb = "지정가"
		Case "M", "03"
			Get_hogb = "시장가"
		Case "C", "05"
			Get_hogb = "조건부지정가"
		Case "B", "06"
			Get_hogb = "최유리지정가"
	End Select
End Function

'***************************************************************************
' 선물/옵션 주문유형 (2자리 -> 1자리)
'***************************************************************************
Function change_hogb (hogb)
	Dim retn
	Select Case hogb
		Case "00" : retn = "1"			'지정가
		Case "03" : retn = "3"			'시장가
		Case "05" : retn = "2"			'조건부지정가
		Case "06" : retn = "4"			'최유리지정가
	End Select
	change_hogb = retn
End Function

