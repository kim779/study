RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim ii,i
''*************************************************
''send ui data
''*************************************************
Sub f_vSendUiData()
	Dim accn, pass,tax,mmd

	SCREEN.OnSend False
	VIEWGRID.Clear

	If cbo_mmd.Index = 0 Then
		mmd = out_hts.data
	ElseIf cbo_mmd.Index = 1 Then
		mmd = out_call.data
	ElseIf cbo_mmd.Index = 2 Then
		mmd = out_ars.data
	End If

	' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "0" And Trim(pswd.Data) = "" Then
	   pswd.Data = "9999"
	End If

		accn = Trim(AN1A.Data)						'계좌번호
		pass = Trim(pswd.Data)						'비밀번호
		tax = cbo_tax.data

		Call CONTROL0.Send(accn , pass, tax ,mmd )

	SCREEN.Wait = True
End Sub

'***************************************************************************
' DESC: SendOBJX
'***************************************************************************
Sub SendOBJX()
	SCREEN.Object("objX.LEDGER").FKEY = "C"
	SCREEN.Object("objX.zAcntNo").data = AN1A.Data
	SCREEN.Object("objX.zPwd").data = pswd.data
	objX.Send
End Sub

'***************************************************************************
' DESC: TaxRateSend
'***************************************************************************
Sub TaxRateSend()
	If SYSTEM.ConnectBy = 1 Then
	If Len(Trim(pswd.data)) < 1 Then
		pswd.SetFocus
		MsgBox "비밀번호를 확인하십시오", , "IBK투자증권"
		Call guide_msg("비밀번호를 확인하십시오")
 		Exit Sub
	End If
	End If
	SCREEN.Object("obj.account").data = AN1A.Data
	SCREEN.Object("obj.pswd").data = pswd.data
	obj.Send
End Sub

'***************************************************************************
' DESC: ClearData
'***************************************************************************
Function ClearData()
		SCREEN.ClearAll 0, 2
		SCREEN.Proc "objX.OnClear",""
		b_send.Enable = True
		ACNM.Data = AN1A.name
End Function

'***************************************************************************
' DESC: clear_check
'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit Sub
		End If
		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
End Sub

'***************************************************************

Function chkcnt()
	Dim gcnt
	gcnt = 0

	chkcnt = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell(ii, 1)) = 1 Then
			gcnt = gcnt + 1
		End If
