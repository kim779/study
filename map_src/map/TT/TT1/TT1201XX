	allCheck.Checked = False
''	SCREEN.Object("Main.GUIDE").Text = GUIDE.Text
	b_send.Enable = False
	Call SendOBJX()

Else
	If DataLen < gubn_code_len Then
		SCREEN.Object("Main.GUIDE").Text = GUIDE.Text
		tmp = GUIDE.Text
		If (Mid(tmp,1,4) = "3669") Then
		  MsgBox(Trim(GUIDE.Text))
		End If

		Exit Sub
	End If

	row = Find_Row(Left(dataList, gubn_code_len))

	Select Case CONTROL0.Flag
		Case "I"						'insert
				VIEWGRID.InsertRow row
				VIEWGRID.Update row, Right(dataList, dataLen - gubn_code_len)
		Case "D"						'delete
				If row < 1 Then
					Exit Sub
				End If

				VIEWGRID.RemoveRow row-1
		Case "U"						'update
				If row < 1 Then
					Exit Sub
				End If

				VIEWGRID.Update row-1, Right(dataList, dataLen - gubn_code_len)
		Case Else
				SCREEN.Object("Main.GUIDE").Text = GUIDE.Text

				tmp = GUIDE.Text

				If (Mid(tmp,1,4) = "3669") Then
				  Call ClearData()
				  MsgBox(Trim(GUIDE.Text))
				End If
				Exit Sub				'CONTROL0.Flag = "E"(error flag)
	End Select
End If

