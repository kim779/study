_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 2, 2
	next_btn.Enable = False
	ACNM.data = AN1A.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	GRID0.SetDataPosition(2)
	GRID1.SetDataPosition(2)
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

If CheckInput(AN1A, zPwd) = True Then
	SCREEN.onsend = True
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2,2
	ACNM.Data = AN1A.Name
	zPwd.Clear
	zPwd.SetFocus
ElseIf Left(Trim(LEDGER.Ecod), 1) = "0" Then

	Dim val1, val2, ii
	Dim before_val1, before_val2, change_val1, change_val2

	'추정순자산증감
	val1 = IDpsastTotamt.GetTableCell(1)
	val2 = IDpsastTotamtD1.GetTableCell(1)

	If AN1A.Data = "           " Or Trim(val1) = "" Then
	'	Call alert_msg("계좌가 없음")
	Else
		TABLE1.SetTableCell 1, val1 - val2
	End If

End If

Select Case sec.data
	Case "1"	zPwd.SetFocus
	Case "2"	send_btn.SetFocus
	Case "3"	next_btn.SetFocus
End Select

If LEDGER.Next = "Y" Then
	'next_btn.Enable = True
	GRID0.SetDataPosition(2)
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
Else
	'next_btn.Enable = False
End If

