Dim Lnm, LoanDtlClssNm

LoanDt.Data = GRID0.GetGridCell(GRID0.row, 6)
IsuNo.Data = GRID0.GetGridCell(GRID0.row, 1)

LoanDtlClssNm ="00"
Lnm = Trim(GRID0.GetGridCell(GRID0.row, 4))

If Lnm = "유통융자" Then
	LoanDtlClssNm  = "01"
ElseIf Lnm = "자기융자" Then
	LoanDtlClssNm  = "03"
ElseIf Lnm = "유통대주" Then
	LoanDtlClssNm  = "05"
ElseIf Lnm = "자기대주" Then
	LoanDtlClssNm  = "07"
ElseIf Lnm = "예탁주식담보융자" Then
	LoanDtlClssNm  = "80"
ElseIf Lnm = "예탁채권담보융자" Then
	LoanDtlClssNm  = "82"
End If

LoanPtnCode.Data = LoanDtlClssNm
SYSTEM.Trace("LoanPtnCode : " & LoanPtnCode.Data)
