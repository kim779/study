RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim last_row

Sub send_f()
	last_row = 0
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_n()
	last_row = GRID0.Rows
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_

LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

SCREEN.Object("parent.btn_next").Enable = (LEDGER.Next = "Y")

Dim Indx, Prec, val

' 발행가(7), 단수주가(12), 배정기준가(17), 권리행사(40), 주식배정률(6), 과세율(11)
' 현금배정률(16), 자기대주권리금비율(27), 유통대주권리금비율(28), 채권액면당주식비율(41)
Int_item = Array( 7, 12, 17, 40 )
trim_item = Array( 4, 5 )
delplus_item = Array( 6, 11, 16, 27, 28, 41 )

For i=(last_row+1) To GRID0.Rows
	' 정수 Formatting
	For n=LBound(Int_item) To UBound(Int_item)
		val = GRID0.GetGridCell(i, Int_item(n))
		If Len(Trim(val))>0 Then
			GRID0.SetGridCell i, Int_item(n), "" & CLng(val)
		End If
	Next

	' 비율 Formatting
	For n=LBound(delplus_item) To UBound(delplus_item)
		val = GRID0.GetGridCell(i, delplus_item(n))
		If Len(Trim(val))>0 Then
			GRID0.SetGridCell i, delplus_item(n), Trim(Replace(val, "+", ""))
		End If
	Next

	' 종목번호, 종목명 Trim
	For n=LBound(trim_item) To UBound(trim_item)
		val = GRID0.GetGridCell(i, Int_item(n))
		If Len(Trim(val))>0 Then
			GRID0.SetGridCell i, trim_item(n), Trim(GRID0.GetGridCell(i, trim_item(n)))
		End If
	Next
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


}



