_AW_ONDECLARE_AW_
Sub send_f()
	next_btn.Enable False
	SCREEN.ClearAll 0, 2
	OBJECT0.proc "send_f", ""
End Sub

Sub send_c()
	OBJECT0.proc "send_c", ""
End Sub

_AW_ONSTART_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(EmpPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Trim(zEmpPwd.Data) <> "" Then
		Dim check
		check = SYSTEM.CheckPasswd(Trim(zEmpPwd.Data))
		If check = True Then
			Call send_f()
		Else
			MsgBox "비밀번호를 확인하십시오.",0,"IBK투자증권"
			Exit Sub
		End If
	Else
		MsgBox "비밀번호를 입력하십시오.",0,"IBK투자증권"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


