_AW_ONDECLARE_AW_
Sub Set_account()
	ACNM.Data = AN10.name
End Sub
Dim Mydata

Function data_split()
	Mydata = Split(s_data.data, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)							' 한 레코드를 개체별로 자르는중..

		GRID.SetGridCell NREC.Data - ii, 13,Trim(Mydata(ii)(0))				' 주문유형
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))				' 시장구분
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))				' 매매구분
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))				' 계좌번호
		GRID.SetGridCell NREC.Data - ii, 5,Trim(Mydata(ii)(4))				' 비밀번호
		GRID.SetGridCell NREC.Data - ii, 6,Trim(Mydata(ii)(5))				' 원주문번호
		GRID.SetGridCell NREC.Data - ii, 7,Trim(Mydata(ii)(6))				' 종목코드
		GRID.SetGridCell NREC.Data - ii, 8,Trim(Mydata(ii)(7))				' 종목명
		GRID.SetGridCell NREC.Data - ii, 9,Trim(Mydata(ii)(8))				' 매입단가
		GRID.SetGridCell NREC.Data - ii, 10,Trim(Mydata(ii)(9))				' 주문수량
		GRID.SetGridCell NREC.Data - ii, 11,Trim(Mydata(ii)(10))			' 호가잔량
		GRID.SetGridCell NREC.Data - ii, 12,Trim(Mydata(ii)(11))			' 주문단가
		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(12))				' 호가구분
		GRID.SetGridCell NREC.Data - ii, 14,Trim(Mydata(ii)(13))			' 주문조건
		GRID.SetGridCell NREC.Data - ii, 15,Trim(Mydata(ii)(14))			' 정정취소
		GRID.SetGridCell NREC.Data - ii, 16,Trim(Mydata(ii)(15))			' 호가구분
		GRID.SetGridCell NREC.Data - ii, 17,Trim(Mydata(ii)(16))			' 처리구분
		GRID.SetGridCell NREC.Data - ii, 18,Trim(Mydata(ii)(17))			' 신용구분코드
		GRID.SetGridCell NREC.Data - ii, 19,Trim(Mydata(ii)(18))			' 대출일자
	Next
End Function

