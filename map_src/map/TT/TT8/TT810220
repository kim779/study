	If ErrorChk() = False Then
		Exit Sub
	End If

	If chk_causion.checked = False Then
		alert_msg("유의사항을 먼저 읽으시기 바랍니다")
		causion.SetFocus
		Exit Sub
	End If

	If F1.Checked = True Then
		gbn = "주식"
		zSecoutBuyDate.data = "        "

		If S1301.Visible = True Then
			zIsuNo.Data = SCREEN.Object("parent.1301f").data & S1301.Data
		Else
			zIsuNo.Data = scode.Data
		End If
	Else
		gbn = "채권"
		zSecoutBuyDate.data = zBuyDate.data
		zIsuNo.Data = zIsuNo_chae.Data
	End If

	If F1.Checked = True Then
