			nm = Mid(SCREEN.Object("OBJ.1022").Data,2)
		Else
			nm = SCREEN.Object("s_name.1022").Data
		End If
	Else
		nm = chae_nm.Data
	End If

	nm = chae_nm.Data

	qty_copy.Data = Trim(Right(qty.Data, 15))
	lSecoutQty.Data = "+" & l_zeropad(qty_copy)
	zOtcoBrnNo.Data = l_zeropad(zOtcoBrnNo)

	dmsg =  "o_acn1" & vbTab & Left(Trim(CMB_ACCT.Text), 13) & vbLf &_
			"o_acname" & vbTab & ACNM.Text & vbLf &_
			"o_gubn" & vbTab & gbn & vbLf &_
			"jm_name" & vbTab & nm & vbLf &_
			"o_cnt" & vbTab & qty.data & vbLf &_
			"s_name" & vbTab & stc_name.Text & vbLf &_
			"o_acn2" & vbTab & zBkeepAcntNo.Data

'	num1 = Trim(SCREEN.Object("OBJ_sec2.zSecurCardInpt1").data)
'	num2 = Trim(SCREEN.Object("OBJ_sec2.zSecurCardInpt2").data)

	SCREEN.CreateWindow 2, "IB810223 /p5 /d", dmsg

	If SYSTEM.Pop("order") <> "OK" Then
		Exit Sub
	End If

	Call OBJ_SEND()
End Sub

