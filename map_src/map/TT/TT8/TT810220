_AW_ONDECLARE_AW_
Dim account

'--계좌번호, 계좌명 세팅
Sub acct_set()
	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text
	NAME.Data = CMB_ACNM.Text

	account = Trim(CMB_ACCT.Data)
	zAcntNo.Data = account
	AN1A.data = zAcntNo.Data
End Sub

Sub OTP_setting()		'--OTP 체크
		If gubn.text = "1" Then
			OBJ_sec2.Visible = True
			OBJ_otp2.Visible = False
			OBJ_bank.Visible = False
			SCREEN.object("OBJ_sec2.OBJ_sec1").Send
		ElseIf gubn.text = "3" Then
			OBJ_sec2.Visible = False
			OBJ_bank.Visible = False
			OBJ_otp2.Visible = True
			OBJ_otp1.Send
		Else
			OBJ_sec2.Visible = False
			OBJ_otp2.Visible = False
			OBJ_bank.Visible = True
		End If
End Sub

Sub OTP_Clear()
	SCREEN.Object("OBJ_sec2.zSecurCardInpt1").clear
	SCREEN.Object("OBJ_sec2.zSecurCardInpt2").clear
	SCREEN.Object("OBJ_sec2.zSecurCardInptNo1").clear
	SCREEN.Object("OBJ_sec2.zSecurCardInptNo2").clear
	SCREEN.Object("OBJ_otp2.zOtpVrfVal").Clear
	SCREEN.Object("OBJ_bank.zInptPwd").Clear
End Sub

Sub OBJ_SEND()
	If gubn.Text = "1" Then
		OBJ_sec2.Send
