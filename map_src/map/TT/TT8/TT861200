_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ANCM.Data = h_acnm.Data
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'==계좌번호, 비밀번호 체크
Function L_CheckInput(zPwd)
 	L_CheckInput = False
 	If Trim(CMB_ACCT.text) = "" Or Len(Trim(CMB_ACCT.text)) < 13 Then
		Call alert_msg("계좌번호를 확인하십시오.")
 		CMB_ACCT.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zPwd.data)) < 4 Then
			Call alert_msg("비밀번호를 확인하십시오.")
	 		zPwd.Setfocus
	 		Exit Function
		End If
	End If
	L_CheckInput = True
End Function


'--계좌번호, 계좌명 세팅
Sub acct_set()
	Dim account, acct1, acct2
	Call Check_LoginType(zPwd)
	CMB_ACNM.Index = CMB_ACCT.Index
	ANCM.Data = CMB_ACNM.Text
	h_acnm.Data = ANCM.Data
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

'직원/고객에 따른 비밀번호 컨트롤 설정
Call Check_LoginType(zPwd)

Dim Day1, Day2, mm, dd

Day2 = CDate(QryEndDt.text)

Day1 = DateAdd("d", -14, Day2)

If Month(Day1) < 10 Then
	mm = "0" & Month(Day1)
Else
	mm = Month(Day1)
End If

If Day(Day1) < 10 Then
	dd = "0" & Day(Day1)
Else
	dd = Day(Day1)
End If

QrySrtDt.data = Year(Day1) & mm & dd

OBJ1.Send

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
End If

If L_CheckInput(zPwd) = True Then
	SCREEN.onsend = True
	ANCM.Data = h_acnm.Data
Else
	SCREEN.ClearAll 0, 2
	ANCM.Data = h_acnm.Data
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" And LEDGER.Ecod <> "0136" Then
	Call send_c()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_


Call send_f()
