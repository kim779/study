Sub chk_loan()		'==신청내역 확인창에 정보 넘겨주기
	s_data = ""

	Dim aprc

	If Len(Trim(AN19.Data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하여 주십시오.")
		AN19.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		Call alert_msg("비밀번호를 확인하여 주십시오.")
		zPwd.SetFocus
		Exit Sub
	End If

	If InputCount = 0 Then
		Call alert_msg("대출신청금액란에 금액을 입력하세요.")
		GRID0.SetSkip "amt", True
		Exit Sub
	End If

	Dim ii, tmpInputAmt

	For ii = 1 To GRID0.Rows
		tmpInputAmt = Trim(GRID0.GetGridCell(ii, 16))

		If Trim(tmpInputAmt) <> "" Then
			If IsNumeric(tmpInputAmt) = True Then
				If CCur(tmpInputAmt) >= 0 Then
					If tmpInputAmt Mod 100000 <> 0 Then
						Call alert_msg("대출신청금액은 10만원 단위로 입력하여 주십시오.")
						GRID0.SetCellFocus ii, 16
						Exit Sub
					End If
				Else
					Call alert_msg("대출신청금액을 확인하여 주십시오.")
					GRID0.SetCellFocus ii, 16
					Exit Sub
				End If
			Else
				Call alert_msg("대출신청금액을 확인하여 주십시오.")
				GRID0.SetCellFocus ii, 16
				Exit Sub
			End If
		End If
	Next

	en_accn.Data = Mid(AN19.data, 1, 8)
	en_pswd.Data = zPwd.Data
	pswd2 = SYSTEM.Encrypt(en_pswd.Data, en_accn.Data)

	accn = AN19.data									'계좌번호


	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(ii, 16)) > 0  Then

			jnam = GRID0.GetGridCell(ii, 3)				'종목명
			aprc = GRID0.GetGridCell(ii, 10)			'대출가능금액
			lprc = GRID0.GetGridCell(ii, 16)			'대출신청금액

			s_data = "#" & s_data
			s_data = lprc & "|" & s_data				'대출신청금액
			s_data = aprc & "|" & s_data				'대출가능금액
			s_data = jnam & "|" & s_data				'종목명

		End If
	Next

	num.Data = InputCount

	If InputCount > 0 Then
		num.Push ""

		SCREEN.CreateWindow 2, "IB85031A /p5 /d", "s_data" & vbTab & s_data

		If SYSTEM.Pop("stock_mado_order")  = "OK" Then
			send_i()
		End If
	End If
End Sub

