_AW_ONDECLARE_AW_
'-----------------------------------------------------------------------
Sub SetDictHintLabel(RefLabel, DataLabel)
	RefLabel.Text = ""
	Dim FSO, F
	Set FSO = CreateObject("Scripting.FileSystemObject")
	If Not FSO.FileExists(SYSTEM.Home & "\tab\dict.txt") Then
		Exit Sub
	End If
	Set F = FSO.OpenTextFile(SYSTEM.Home & "\tab\dict.txt", 1)
	ReadLine = ""
	Do While Not F.AtEndOfLine
		ReadLine = F.ReadLine
		If Len(ReadLine) = 0 Then
			Exit Do
		End If
		DL = Split(ReadLine, "|")
		If UBound(DL) >= 1 Then
			If DL(0) = DataLabel.Text Then
				RefLabel.Text = DL(1)
			End If
		End If
	Loop
	F.Close
End Sub

_AW_ONSTART_AW_
SetDictHintLabel lb_Ref, lb_Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
lb_Data.Text = "테스트1"
