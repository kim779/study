_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0035"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False
SCREEN.Object("main.guide").text = ""

If Trim(zBrnNo.Data) <> "" And Len(Trim(zBrnNo.Data)) = 3 Then
	SCREEN.onsend = True
Else
	MsgBox "지점번호를 확인하십시오.", ,"IBK투자증권"
	zBrnNo.SetFocus
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GUIDE").Text = Trim(LEDGER.Emsg)


SYSTEM.Trace LEDGER.Next
SYSTEM.Trace LEDGER.Ecod

If Left(LEDGER.Ecod, 1) <> "0" Then
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
	next_btn.SetFocus
'	Call send_c()
End If

