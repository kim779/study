		IsuMdclssCode.Data = "01"
	ElseIf IsuSmclssCode.Data >= 510 And IsuSmclssCode.Data <= 547 Then
		IsuMdclssCode.Data = "02"
	ElseIf IsuSmclssCode.Data >= 561 And IsuSmclssCode.Data <= 564 Then
		IsuMdclssCode.Data = "03"
	ElseIf IsuSmclssCode.Data >= 575 And IsuSmclssCode.Data <= 577 Then
		IsuMdclssCode.Data = "04"
	ElseIf IsuSmclssCode.Data >= 585 And IsuSmclssCode.Data <= 586 Then
		IsuMdclssCode.Data = "05"
	ElseIf IsuSmclssCode.Data = 560 Then
		IsuMdclssCode.Data = "06"
	ElseIf IsuSmclssCode.Data = 575 Then
		IsuMdclssCode.Data = "10"
	End If
	SCREEN.IgnoreChange False
