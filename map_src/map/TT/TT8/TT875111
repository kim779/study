	SCREEN.Proc "main.SetGuide", "2"
Else
	SCREEN.Proc "main.SetGuide", Data
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_year)
_AW_ONCHANGE_AW_
Data = ed_year.Data
If Len(Trim(Data)) = 0 Then
	Exit Sub
End If

If Data < "0" Or Data > "9" Then
	Exit Sub
End If

If Data = "0" Then
	ed_year.Data = "1"
End If

If Data > 3 Then
	ed_year.Data = "3"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tryn)
_AW_ONCHANGE_AW_
Data = Trim(tryn.Data)

If Len(Data) = 0 Then
	tryn.Data = 1000
	Exit Sub
End If

Data =CLng(Data)

If Data < 0 Then
	tryn.Data = 1000
End If

If Data > 10000 Then
	tryn.Data = 10000
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(o_date)
_AW_ONCHANGE_AW_
AYear = Year(Date)
AMon = Month(Date)
If Len(AMon) = 1 Then
	AMon = "0" & AMon
End If
ADay = Day(Date)
If Len(AMon) = 1 Then
	ADay = "0" & ADay
End If

Today = AYear & AMon & ADay
If Len(Trim(o_date.Data)) = 0 Then
	o_date.Data = Today
	Exit Sub
End If

If CLng(Today) > CLng(o_date.Data) Then
	ot_date.Data = "과거"
ElseIf CLng(Today) = CLng(o_date.Data) Then
	ot_date.Data = "당일"
Else
	SYSTEM.Trace Today & "|" & o_date.Data
	o_date.Data = Today
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



