RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	GRID0.Clear
	SCREEN.Send 0
End Sub

Sub comboset()
	Dim ii, txt, item, list
	list = ""
	For ii = 5 To GRID0.Columns
		txt = GRID0.GetHead(ii)
		If ii < 10 Then
			ii = "0" & ii
		End If
		item = ii & txt
		If Len(list) = 0 Then
			list = ii & vbTab & item
		Else
			list = list & vbTab & item
		End If

	Next
	SCOMB.SetItems list
End Sub

_AW_ONSTART_AW_
Call comboset()
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
GRID0.SetFocus
ed_upcd.Data = Trim(GRID0.GetGridCell(1, 2))
SCREEN.Proc "OBJ0.send_f", ""
SCREEN.Proc "OBJ1.send_f", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(UTAB1)
_AW_ONCLICK_AW_
Dim mapname
Select Case UTAB1.Index
	Case "1":	mapname = "TT810111"
	Case "2":	mapname = "TT810112"
	Case "3":	mapname = "TT810113"
	Case "4":	mapname = "TT810114"
	Case "5":	mapname = "TT810115"
	Case "6":	mapname = "IB850361"
	Case "7":	mapname = "IB850370"
End Select

If OBJ1.GetObject <> mapname Then
	OBJ1.SetObject(mapname)
	OBJ1.Proc "send_f", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SCOMB)
_AW_ONCHANGE_AW_
Dim ii
For ii=5 To GRID0.Columns
	If CLng(SCOMB.Data) = ii Then
		GRID0.SetColumnVisible ii, True
	Else
		GRID0.SetColumnVisible ii, False
	End If
Next
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r3)
_AW_ONCLICK_AW_
upgb.Data = "2"
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r2)
_AW_ONCLICK_AW_
upgb.Data = "1"
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r1)
_AW_ONCLICK_AW_
upgb.Data = "0"
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	ed_upcd.Data = Trim(GRID0.GetGridCell(GRID0.Row, 2))
	SCREEN.Proc "OBJ0.send_f", ""
	SCREEN.Proc "OBJ1.send_f", ""
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



