RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
LEDGER.Rcnt = "0025"
zElecfnUserId.Data = LEDGER.Usid

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(LEDGER.Next) = "Y" Then
	Call send_c()
Else
	Dim ii, items, itemsIn, items2, acnm, accnCell, accnText, accnGubn

	For ii=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(ii, 11)) = "1" And Trim(GRID0.GetGridCell(ii, 12)) = "동일인" Then
			accnCell = Trim(GRID0.GetGridCell(ii, 9))
			accnText = Trim(GRID0.GetGridText(ii, 9))
			accnGubn = ""
			acnm 	 = Trim(GRID0.GetGridCell(ii,10))

			If Len(accnCell) = 11 Then
				If Mid(accnCell, 4, 2) = "10" Or Mid(accnCell, 4, 2) = "11" Or Mid(accnCell, 4, 2) = "30" Then
					If ii = 1 Then
						items = accnCell
					End If

					Select Case Mid(Trim(accnCell), 4, 2)
						Case "10" : accnGubn = "위탁"
						Case "11" : accnGubn = "ELW "
						Case "30" : accnGubn = "저축"
					End Select

					items = items & vbTab & Trim(accnCell) & Trim(accnText) & "   " & accnGubn & "   " & Trim(acnm)
					items2 = items2 & vbTab & acnm
				End If
			End If
		End If
	Next

	SCREEN.Object("main.OBJ1.CMB_ACCT").SetItems(items)
	SCREEN.Object("main.OBJ1.CMB_ACNM").SetItems(items2)
	SCREEN.Proc "main.OBJ1.acct_set", ""  '--계좌번호, 계좌명 세팅


	'SCREEN.Proc "main.OBJ1.F1_chk", ""
	'SCREEN.Proc "main.OBJ1.bank_chk", ""  '--은행개설계좌 여부 체크
	'SCREEN.Proc "main.OBJ1.fund_chk", ""  '--펀드계좌 여부 체크
	'
	'SCREEN.Proc "main.OBJ1.acct_set", ""  '--입고계좌 세팅
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(Out)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
