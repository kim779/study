Sub contract()		'입고계좌 셋팅, 본인계좌 + 약정계좌
Dim ii, itemsIn, str
	For ii=1 To SCREEN.Object("OBJ_acct.GRID0").Rows
		str = Trim(SCREEN.Object("OBJ_acct.GRID0").GetGridText(ii, 9))
		If Mid(str,5,2) = "10" Or Mid(str,5,2) = "11" Then
			itemsIn = itemsIn & vbTab & str
		End If
	Next

	For ii = 1 To SCREEN.Object("OBJ_cont.GRID0").rows
		str = Trim(SCREEN.Object("OBJ_cont.grid0").getGridText(ii, 3))
		If Mid(str,5,2) = "10" Or Mid(str,5,2) = "11" Then
			itemsIn = itemsIn & vbTab & str
		End If
	Next
	SCREEN.Object("OBJ1.CMB_ACCT2").SetItems(itemsIn)
End Sub

Sub chk_echCont(accnt)
Dim str
	For ii = 1 To SCREEN.Object("OBJ_cont.GRID0").rows
		str = Trim(SCREEN.Object("OBJ_cont.grid0").getGridText(ii, 3))
		If str = accnt Then
			SCREEN.Object("OBJ1.cont").text = "true"
			Exit Sub
		End If
	Next
End Sub

