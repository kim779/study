RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_ArrCtrl

g_ArrCtrl = Array(Array(RADIO0, RADIO1, RADIO2), ed_cvol, ed_time)
'----------------------------------------------------
Function GetSjgb()
	GetSjgb = "0"
	If RADIO0.Checked Then
		GetSjgb = "0"
	ElseIf RADIO1.Checked Then
		GetSjgb = "1"
	ElseIf RADIO2.Checked Then
		GetSjgb = "2"
	Else
		GetSjgb = "0"
	End If
End Function
'----------------------------------------------------
Sub SendData()
	Index = ""
	For i = LBound(g_ArrCtrl(0)) To UBound(g_ArrCtrl(0))
		If g_ArrCtrl(0)(i).Checked = True Then
			Index = CStr(i)
		End If
	Next
	
	CVol = ed_cvol.Data
	ATime = ed_time.Data
	Data = Index & "|" & CVol & "|" & ATime
	
	OBJECT0.Proc "SendData", Data
End Sub
'----------------------------------------------------
Sub SetGridData(Data)
	ArrData = Split(Data, "|")
	For i = UBound(ArrData) + 2 To GRID0.Rows
		For j = 1 To GRID0.Columns
			CellData = Trim(GRID0.GetGridCell(i, j))
			If j = 1 Then
				If Len(CellData) = 0 Then
					Exit For
				End If
			End If 
			If Len(CellData) <> 0 Then
				GRID0.SetGridCell i, j, ""
			End If
		Next
	Next
	

	
	
	For i = 1 To UBound(ArrData) + 1
		ArrCellData = Split(ArrData(i - 1), "@")
		For j = 1 To UBound(ArrCellData) + 1
			If Len(ArrCellData(j - 1)) <> 0 Then
				Data1 = GRID0.GetGridCell(i, j)
				Data2 = Trim(ArrCellData(j - 1))
				If Data1 <> Data2 Then
					GRID0.SetGridCell i, j, ArrCellData(j - 1)
				End If
			End If
		Next
	Next
	
End Sub

_AW_ONSTART_AW_
SendData
SCREEN.SetTimer CLng(ed_time.Data) * 10, True

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.SetTimer CLng(ed_time.Data) * 10, True
SendData

_AW_ONENDSUB_AW_
