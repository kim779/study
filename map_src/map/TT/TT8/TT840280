	   "o_hnam" & vbTab & nm & vbLf &_
	   "o_jqty" & vbTab & lAppyNo.Data & vbLf &_
	   "o_jprc" & vbTab & lAddPayAmt.Data & vbLf


		SCREEN.CreateWindow 2, "TT84028A /p5 /d", dmsg

	If SYSTEM.Pop("kongmo_add_order") <> "OK" Then
