_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

Sub Setting()
	Dim ii, items, items2, str, name, count, str2, cnt
	count = 0
	cnt = 0
	items = "" & vbTab & "" & ""
	items2 = "" & vbTab & ""
	str2 = Trim(SCREEN.Object("parent.AN1A").Data)

	For ii=1 To GRID0.Rows
		If 	Trim(GRID0.GetGridCell(ii, 1)) = "1103" Then
			str = Trim(GRID0.GetGridCell(ii, 3))

			If str <> "" And Replace(str, "-", "") <> str2 Then
				items = items & vbTab & Replace(str, "-", "") & str
				name = Trim(GRID0.GetGridCell(ii,4))
				items2 = items2 & vbTab & name
				count = count + 1
				cnt = cnt +1
			End If
		End If
	Next

	If cnt < 1 Then
		view = Mid(str2, 1, 3) & "-" & Mid(str2, 4, 2) & "-" & Mid(str2, 6, 6)
		items = items & vbTab & str2 & view
		name = SCREEN.Object("parent.ANCM").data
		items2 = items2 & vbTab & name
		count = count + 1
	Else
		SCREEN.Object("main.OBJ1.chk_ipgo").Text = "1"
	End If

	SCREEN.Object("main.obj1.cb_count").data = count
	SCREEN.Object("main.OBJ1.zRebatAcntNo").SetItems(items)
	SCREEN.Object("main.OBJ1.zRebatAcntNo_nm").SetItems(items2)
	SCREEN.Proc "main.OBJ1.acct_set", ""  '--계좌번호, 계좌명 세팅
	SCREEN.Proc "main.OBJ1.chg_acct_set", ""
End Sub






