_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0030"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
'MsgBox chk.Data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'MsgBox "ECod" & LEDGER.Ecod & "Check" & chk.Data
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
	Call alert_msg(Trim(LEDGER.Emsg))
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	Call send_c()
Else
	If Left(Trim(LEDGER.Ecod), 1) = "0" Then
		Dim result, ii, act

		For ii = 1 To GRID0.Rows
			act = GRID0.GetGridcell(ii, 1)
			result = StrComp(Trim(act), Trim(EDIT_act.Data))

			If result = 0 Then
				SCREEN.Object("parent.lMnyrclOdpntRepayAmt").DATA = GRID0.GetGridCell(ii,4)
				Exit For
			End If
		Next

		'메인의 내역조회 실시
		If chk.Data = 1 Then
			SCREEN.Object("main.OBJ2").Send
		End If

		If SCREEN.Object("main.UTAB0").ID = 1 Then
			SCREEN.Object("parent.SELECTBANK").SetFocus
		End If
	Else
		Call alert_msg(Trim(LEDGER.Emsg))
	End If
End If

