RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim objset
objset = Array(o_yymm1, o_yymm2, o_yymm3, o_yymm4)

Sub make_mgym()
	Dim item
	item = ""
	For ii=LBound(objset) To UBound(objset)

		item = item & objset(ii).Data & objset(ii).Data
		If ii <> UBound(objset) Then
			item = item & vbTab
		End If
		If ii = LBound(objset) Then
			item = objset(ii).Data & vbTab & item
		End If
		'SYSTEM.trace "["&ii&"] ["&item&"]"
		objset(ii).Skip True
	Next

	SCREEN.Object("MGYM").SetItems item
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If gubn.Data = "F" Then
	make_mgym()
	gubn.Data = "X"
End If

_AW_ONENDSUB_AW_
_AW_ONKEY_AW_
If SCREEN.Key = 13 Then
	SCREEN.OnSend = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(MGYM)
