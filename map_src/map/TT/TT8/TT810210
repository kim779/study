_AW_ONDECLARE_AW_
'--계좌번호, 계좌명 세팅
	Dim account, ACCNT1, ACCNT2
Sub acct_set()
	CMB_ACNM.Index = CMB_ACCT.Index
	ACNM.Data = CMB_ACNM.Text

	account = Trim(CMB_ACCT.Data)
	zAcntNo.Data = account

	ACCNT1 = Mid(zAcntNo.data,1,3)
	ACCNT2 = Mid(zAcntNo.data, 6, 6)

	totacnt.Data  = ACCNT1 & "00" & ACCNT2
	AN1A.data = zAcntNo.Data
End Sub

Sub ClearJango()
	lSecBfbalQty.Clear
	lSecCrbalQty.Clear
	lSecBfbalQty2.Clear
	lSecCrbalQty2.Clear
End Sub

'--은행개설계좌 여부 체크
Sub bank_chk()
	If Left(Trim(CMB_ACCT.Text), 1) = "5" Then
		Call OTP_setting_ifBankAcct()
	End If
End Sub

Sub OBJ_SEND()
	If gubn.Text = "1" Then
		OBJ_sec2.Send
	ElseIf gubn.Text = "3" Then
		OBJ_otp2.Send
	ElseIf gubn.Text <> "1" And gubn.Text <> "3" Then
		SCREEN.Object("OBJ_bank.zAcntNo").data = Left(account, 3) & "00" & Right(account, 6)
		OBJ_bank.Send
	End If
End Sub

'--입고계좌 셋팅
Sub yacct_set()
	OBJ_yact.send
End Sub

Sub OTP_Clear()
	SCREEN.Object("OBJ_sec2.zSecurCardInpt1").clear
	SCREEN.Object("OBJ_sec2.zSecurCardInpt2").clear
	SCREEN.Object("OBJ_sec2.zSecurCardInptNo1").clear
	SCREEN.Object("OBJ_sec2.zSecurCardInptNo2").clear
	SCREEN.Object("OBJ_otp2.zOtpVrfVal").clear
	SCREEN.Object("OBJ_otp2.zMdaSeqno").clear
End Sub

Sub OTP_hide()
	OBJ_sec2.Visible = False
	OBJ_otp2.Visible = False
	OBJ_bank.Visible = False
End Sub

Function OTP_visible()
	OTP_visible = False

	If OBJ_sec2.Visible = True Then
		OTP_visible = True
	ElseIf 	OBJ_otp2.Visible = True Then
		OTP_visible = True
	ElseIf	OBJ_bank.Visible = True Then
		OTP_visible = True
	End If

End Function

Sub OTP_setting()		'
	If gubn.text = "1" Then
		OBJ_sec2.Visible = True
		OBJ_otp2.Visible = False
		OBJ_bank.Visible = False
		SCREEN.object("OBJ_sec2.OBJ_sec1").Send
	ElseIf gubn.text = "3" Then
		OBJ_sec2.Visible = False
		OBJ_bank.Visible = False
		OBJ_otp2.Visible = True
		OBJ_otp1.Send
	Else
		OBJ_sec2.Visible = False
		OBJ_otp2.Visible = False
		OBJ_bank.Visible = True
	End If

End Sub

Sub OTP_setting_ifBankAcct()		'--OTP 체크 은행계설계좌
	If F2.Checked = True Then
		If gubn.text = "1" Then
			OBJ_sec2.Visible = True
			OBJ_otp2.Visible = False
			OBJ_bank.Visible = False
			SCREEN.object("OBJ_sec2.OBJ_sec1").Send
		ElseIf gubn.text = "3" Then
			OBJ_sec2.Visible = False
			OBJ_bank.Visible = False
			OBJ_otp2.Visible = True
			OBJ_otp1.Send
		Else
			OBJ_sec2.Visible = False
			OBJ_otp2.Visible = False
			OBJ_bank.Visible = False
			alert_msg("대체가 불가능합니다. 영업점에 방문하셔서 OTP나 보안카드를 발급하시기 바랍니다.")
			F1.checked = True
			Call F1_Setting()
			Exit Sub
		End If
	End If
End Sub

Sub F1_Setting()
	CMB_ACCT2.Visible = True
	ACCT1.Visible = False
	ACCT2.Visible = False
	ACCT3.Visible = False
	lbl1.Visible = False
	lbl2.Visible = False
	NAME.enable = False
	NAME.Clear
	Btn_name.enable = False
End Sub

Sub F2_Setting()
	CMB_ACCT2.Visible = False
	ACCT1.Visible = True
	ACCT2.Visible = True
	ACCT3.Visible = True
	lbl1.Visible = True
	lbl2.Visible = True
	NAME.enable = False
	Btn_name.enable = True
End Sub

