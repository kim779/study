Sub checkPassword()
	Dim tmpAcct, tmpPwd
	tmpAcct = Trim(CMB_ACCT.Data)
	tmpPwd = Trim(zPwd.Data)

	If Len(tmpAcct) <> 11 Then
		MsgBox "출금계좌번호를 확인하여 주십시오.", , "IBK투자증권"
		CMB_ACCT.SetFocus
		Exit Sub
	End If

	If Len(tmpPwd) < 4 Then
		MsgBox "출금계좌비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Object("chk_passwd.IntaccNo").data = tmpAcct
	SCREEN.Object("chk_passwd.Pwd").data = tmpPwd

	chk_passwd.Send
End Sub

