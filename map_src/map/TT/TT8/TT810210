	ant1 = Left(Trim(CMB_ACCT2.Text), 3)
	ant2 = Right(Trim(CMB_ACCT2.text), 6)
	If ACCNT1 = ANT1 And ACCNT2 = ANT2 Then
'		send()
	ElseIf Trim(CMB_ACCT2.Text) = "" Then
		Exit Sub
	Else
		SCREEN.Proc "main.chk_echCont", CMB_ACCT2.Text
