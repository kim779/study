Function checkTotalAccn()
	checkTotalAccn = False

	Dim tmpAccn, tmpMidAccn

	If F1.Checked = True Then
		tmpAccn = Trim(CMB_ACCT2.Text)

		If Trim(tmpAccn) = "" Then
			alert_msg("이체계좌번호를 확인하여 주십시오.")
			CMB_ACCT2.SetFocus
			Exit Function
		End If

		tmpMidAccn = Mid(Trim(tmpAccn), 5, 2)
	ElseIf F2.Checked = True Then
		tmpAccn = Trim(ACCT1.Data) & Trim(ACCT2.Data) & Trim(ACCT3.Data)

		If Len(Trim(tmpAccn)) <> 11 Then
			alert_msg("이체계좌번호를 확인하여 주십시오.")
			ACCT1.SetFocus
			Exit Function
		End If

		tmpMidAccn = Mid(Trim(tmpAccn), 4, 2)
	End If

	If Trim(tmpMidAccn) = "00" Then
		Dim tmpMsg
		tmpMsg = "종합계좌번호(ex.001-00-123456)는 대체가 불가합니다." & vbLf & vbLf &_
		         "개별계좌번호(ex.001-10-123456)를 입력하여 주십시오."

		alert_msg(tmpMsg)

		If F1.Checked = True Then
			CMB_ACCT2.SetFocus
		ElseIf F2.Checked = True Then
			ACCT2.SetFocus
		End If

		Exit Function
	End If

	checkTotalAccn = True
End Function


