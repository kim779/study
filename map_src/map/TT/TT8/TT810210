			Exit Function
		End If
	End If

	If OBJ_otp2.Visible = True Then
		If Trim(SCREEN.Object("OBJ_otp2.zOtpVrfVal").data) = "" Then
			alert_msg("OTP 인증번호를 입력하세요")
			SCREEN.Object("OBJ_otp2.zOtpVrfVal").SetFocus
			Exit Function
		End If
	End If

	If OBJ_sec2.Visible = True Then
		If Trim(SCREEN.Object("OBJ_sec2.zSecurCardInptNo1").data) = "" Then
			alert_msg("보안번호를 요청하세요")
			SCREEN.Object("OBJ_sec2.BUTTON1").SetFocus
