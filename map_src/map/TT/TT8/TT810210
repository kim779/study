	If Trim(CMB_ACCT.Text) = "" Then
		alert_msg("출고계좌를 확인하여 주십시오.")
		CMB_ACCT.SetFocus
		Exit Function
	End If

	If Trim(zPwd.Data) = "" Then
		alert_msg("비밀번호를 입력하세요")
		zPwd.SetFocus
		Exit Function
	End If

	If R_1.Checked = True Then
		If S1301.Visible = True Then
			If Trim(S1301.Data) = "" Then
				alert_msg("종목번호를 입력하세요")
