Sub DoOrder()
	Dim dmsg, acnt, num1, num2, nm, i_nm

	If Empty_Chk() = False Then
		Exit Sub
	End If

	If F1.Checked = True Then
		acnt = Left(Trim(CMB_ACCT2.Text), 13)
		i_nm = Trim(ACNM.Text)
	Else
		acnt = Trim(ACCT1.Data) & "-" & Trim(ACCT2.Data) & "-" & Trim(ACCT3.Data)
		i_nm = Trim(NAME.Text)
	End If

	If R_1.Checked = True Then
		If S1301.Visible = True Then
			nm = Mid(SCREEN.Object("OBJ.1022").Data,2)
		Else
			nm = SCREEN.Object("s_name.1022").Data
		End If
		zSecoutBuyDate.data = "        "
	Else
		nm = chae_nm.Data
		zSecoutBuyDate.data = zBuyDate.data
	End If

	dmsg =  "o_acn1" & vbTab & Left(Trim(CMB_ACCT.Text), 13) & vbLf &_
			"o_acname" & vbTab & ACNM.text & vbLf &_
			"o_gubn_nm" & vbTab & nm & vbLf &_
			"o_amt" & vbTab & edit_qty.Data & vbLf &_
			"o_acn2" & vbTab & acnt & vbLf &_
			"i_acname" & vbTab & i_nm & vbLf

	num1 = Trim(SCREEN.Object("OBJ_sec2.zSecurCardInpt1").data)
	num2 = Trim(SCREEN.Object("OBJ_sec2.zSecurCardInpt2").data)

	SCREEN.CreateWindow 2, "IB810214 /p5 /d", dmsg

	If SYSTEM.Pop("order") <> "OK" Then
		Exit Sub
	End If

	If OTP_visible() = True Then
		Call OBJ_send()
	Else
		Call send()
	End If
End Sub

