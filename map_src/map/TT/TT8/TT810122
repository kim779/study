_AW_ONDECLARE_AW_
Dim g_ArrData

'투자코드,투자자명,ColNumber
g_ArrData = Array(Array("외국인", "9", "5"), Array("개인", "8", "6"),_
	Array("기관계", "0", "7"), Array("투신", "3", "8"),_
	Array("증권", "1", "9"), Array("보험", "2", "10"),_
	Array("은행", "4", "11"), Array("종금/신금", "5", "12"),_
	Array("기금/연금", "6", "13"), Array("사모펀드", "12", "14"),_
	Array("국가", "13", "15"), Array("기타", "7", "16"))

Sub send_f()
	S63500.Clear
	S63303.Data = SCREEN.Object("main.ed_upcd").Data
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim r_upgb

r_upgb = P_GetBigCd(S63303.Data)
Select Case r_upgb
	Case "001"		'KOSPI
		S63302.DATA = "00"
	Case "101"		'KOSPI200
		S63302.DATA = "10"
	Case "201"		'KOSDAQ
		S63302.DATA = "90"
	Case Else
		S63302.DATA = "0"
		S63303.Data = "0"
End Select

If SCREEN.Object("parent.r1_1").Checked Then
	S63308.Data = "2"
ElseIf SCREEN.Object("parent.r1_2").Checked Then
	S63308.Data = "1"
Else
	S63308.Data = "3"
End If

If Not SCREEN.Object("parent.r2_1").Checked Then
	S63307.Data = "1"
Else
	S63307.Data = "0"
End If

If SCREEN.Object("parent.r3_1").Checked Then
	S63312.Data = "1"
Else
	S63312.Data = "0"
End If

S63310.Data = "0"
S63311.Data = SCREEN.Object("parent.sdate").Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(63500)
_AW_ONCLICK_AW_
Dim target, i

If S63500.HitPos = 4 Then
	target = S63500.GetHeadCell(S63500.Column)

	If S63500.Column < 10 Or Len(target) <= 0 Then
		Exit Sub
	End If

	For i = LBound(g_ArrData) To UBound(g_ArrData)
		If Trim(target) = g_ArrData(i)(2) Then
			S63500.SetColumnVisible target, True
		ElseIf g_ArrData(i)(2) >= 10 Then
			S63500.SetColumnVisible g_ArrData(i)(2), False
		End If
	Next
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



