RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim ii

Sub getAmt(ii)

	If Trim(GRID0.GetGridCell(ii, 8)) <> "" Then
		SCREEN.Object("OBJ.zIsuNo").data = GRID0.GetGridCell(ii, 8)
		SCREEN.Object("OBJ.rows").text = ii
		OBJ.Send
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0015"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
SCREEN.Object("main.GUIDE").Text = ""

zAcntNo.Data = SCREEN.Object("main.obj1.zAcntNo").data
zPwd.Data = SCREEN.Object("main.obj1.zPwd").data

If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
	zPwd.Data = "9999"
End If

If Len(Trim(zAcntNo.Data)) <> 11 Then
	MsgBox "출고계좌를 확인하여 주십시오.", , "IBK투자증권"
	SCREEN.Object("main.obj1.CMB_ACCT").SetFocus
	Exit Sub
End If

If Len(Trim(zPwd.Data)) < 4 Then
	MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
	SCREEN.Object("main.obj1.zPwd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GUIDE").text = LEDGER.Emsg

If LEDGER.Next = "Y" Then
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End If

For ii = GRID0.rows To 1 Step -1
	If Left(Trim(GRID0.GetGridCell(ii, 8)), 1) <> "A" And Left(Trim(GRID0.GetGridCell(ii, 8)), 1) <> "J" Then
		GRID0.RemoveRow ii-1
	End If
Next

SCREEN.SetTimer 2, False

SCREEN.Object("OBJ.zAcntNo").data = Trim(zAcntNo.Data)
SCREEN.Object("OBJ.zPwd").data = Trim(zPwd.Data)

rows.Text = GRID0.rows
Call getAmt(1)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim code_length
If GRID0.HitPos = 3 Then
	If Trim(GRID0.GetGridCell(GRID0.Row, 8)) <> "" Then
'		'가능수량
		SCREEN.Object("main.canbuy").data = Trim(GRID0.GetGridCell(GRID0.Row, 20))
		SCREEN.Proc "main.Setting_canbuy", ""
'
'		'주식셋팅
		If Len(Trim(GRID0.GetGridCell(GRID0.Row, 8))) = 9 Then
			SCREEN.Object("main.1301").data = Trim(GRID0.GetGridCell(GRID0.Row, 8))
			SCREEN.Object("main.1301f").data = Left(Trim(GRID0.GetGridCell(GRID0.Row, 8)), 1)
		Else
			SCREEN.Object("main.1301").data = Mid(Trim(GRID0.GetGridCell(GRID0.Row, 8)), 2)
			SCREEN.Object("main.1301f").data = Left(Trim(GRID0.GetGridCell(GRID0.Row, 8)), 1)
		End If

		SCREEN.Object("main.chae_nm").data = Trim(GRID0.GetGridCell(GRID0.Row, 1))
		SCREEN.Proc "main.Setting_jusik", ""
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



