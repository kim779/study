RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'회사 검색
Sub Find_company()
	Dim ii, pos
	pos = 0
	For ii=1 To GRID0.Rows
		pos = InStr(Trim(GRID0.GetGridCell(ii, 3)), Trim(Search_com.data))

		If pos > 0 Then
			GRID0.Index = ii - 1
			GRID0.Setfocus

			KNUM.Text = Trim(GRID0.GetGridCell(ii, 1))
			KNAME.Text = Trim(GRID0.GetGridCell(ii, 3))
			Exit Sub
		End If
	Next

	alert_msg("찾으시는 회사가 없습니다")
End Sub

'지점 검색
Sub Find_branch()
	Dim ii, pos
	pos = 0
	For ii=1 To SCREEN.Object("OBJ1.GRID0").Rows
		pos = InStr(Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii, 2)), Trim(search_bran.data))

		If pos > 0 Then
			SCREEN.Object("OBJ1.GRID0").Index = ii - 1
			SCREEN.Object("OBJ1.GRID0").Setfocus

			JNUM.Text = Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii, 1))
			JNAME.Text = Trim(SCREEN.Object("OBJ1.GRID0").GetGridCell(ii, 2))
			Exit Sub
		End If
	Next

	alert_msg("찾으시는 지점이 없습니다")
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SYSTEM.Push "KNUM", "NO"
SYSTEM.Push "JNUM", "NO"

LEDGER.Rcnt = "0150"

SCREEN.Send 0

'--

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	Call send_c()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.hitpos = "3" Then
	KNUM.text = Trim(GRID0.GetGridCell(GRID0.row, 1))
	KNAME.text = Trim(GRID0.GetGridCell(GRID0.row, 3))
	SYSTEM.Push "KNAME", KNAME.text

	If Trim(KNUM.text) <> "" Then
		OBJ1.Send
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
SYSTEM.Push "KNUM", "NO"
SYSTEM.Push "JNUM", "NO"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
SYSTEM.Push "KNUM", KNUM.text
SYSTEM.Push "JNUM", JNUM.Text
SYSTEM.Push "KNAME", KNAME.Text
SYSTEM.Push "JNAME", JNAME.Text

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(Search_com)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call Find_company()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call Find_company()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(search_bran)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call Find_branch()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
Call Find_branch()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


