_AW_ONDECLARE_AW_
'--은행개설계좌 여부 체크
Sub bank_chk()
	If Left(CMB_ACCT.text, 1) = "5" Then	'은행개설계좌일 경우
		bchk.Text = "1"

		'비밀번호 창 보이기
		sPwd.Visible = True
		sPwd_label.Visible = True
		CAUTION.Visible = True
'		Call OTP_chk()
	Else
		bchk.Text = "0"					'영업점개설계좌인 경우

		sPwd.Visible = False
		sPwd_label.Visible = False
		CAUTION.Visible = False
	End If

'	Call OTP_chk()
End Sub

'비밀번호 검증
Sub checkPassword()
	SCREEN.Object("chk_passwd.IntaccNo").data = Trim(Replace(CMB_ACCT.Text, "-", ""))
	SCREEN.Object("chk_passwd.Pwd").data = Trim(zPwd.Data)
	chk_passwd.Send
End Sub

'비밀번호 검증 성공시
Sub passPW()
	Call AMT_send()
End Sub

Sub clearInput()
	zPwd.Clear
	sPwd.Clear
	lMnyrclOdpntRepayAmt.Clear
	EDIT_ACCT.Clear
	AMT.Clear
