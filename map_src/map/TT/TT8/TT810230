'		End If
	SCREEN.onsend = True
 	Exit Sub
Else
	SCREEN.Object("main.OBJ1.zPwd").SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GUIDE").text = LEDGER.Emsg

If LEDGER.Next = "Y" Then
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	If Trim(GRID0.GetGridCell(GRID0.Row, 1)) <> "" Then
		'가능수량
		SCREEN.Object("main.canbuy").data = Trim(GRID0.GetGridCell(GRID0.Row, 7))
		SCREEN.Proc "main.Setting_canbuy", ""
		SCREEN.Object("main.chae_nm").data = Trim(GRID0.GetGridCell(GRID0.Row, 3))
		'채권인지 주식인지 구별
		If Trim(Left(GRID0.GetGridCell(GRID0.Row, 1), 1)) = "A" Then
			SCREEN.Object("main.1301").data = Mid(Trim(GRID0.GetGridCell(GRID0.Row, 1)),2,6)
			SCREEN.Proc "main.Setting_jusik", ""


		Else
			SCREEN.Object("main.zIsuNo_chae").data = Trim(GRID0.GetGridCell(GRID0.Row, 1))
			SCREEN.Proc "main.Setting_chae", ""

		End If
	End If
End If

