_AW_ONDECLARE_AW_
Sub comb_list_done()
	Dim grid, item, txt
	Dim jnam, jcod, jgub
	item = ""
	Set grid = SCREEN.Object("main.OBJ.GRID0")
	For ii=1 To grid.Rows
		jcod = grid.GetGridCell(ii, 1)
		jnam = grid.GetGridCell(ii, 2)
		jgub = grid.GetGridCell(ii, 3)
		If jcod = "" Then
			Exit For
		End If
		txt = jgub & jcod

		item = item & txt & jnam & vbTab
		If ii=1 Then
			item = txt & vbTab & item
		End If
	Next
	SCREEN.Object("jcom1").SetItems item
	SCREEN.Object("jcom2").SetItems item
End Sub

_AW_ONSTART_AW_
didx.Data = "3"
diid.Data = "872000"

