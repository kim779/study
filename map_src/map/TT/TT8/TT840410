RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'----------------------------------------------------
Function GetSjgb()
	GetSjgb = "0"
	If RADIO0.Checked Then
		GetSjgb = "0"
	ElseIf RADIO1.Checked Then
		GetSjgb = "1"
	ElseIf RADIO2.Checked Then
		GetSjgb = "2"
	Else
		GetSjgb = "0"
	End If
End Function
'----------------------------------------------------
Sub SendData(Data)
	ArrData = Split(Data, "|")
	RADIO0.Checked = False
	RADIO1.Checked = False
	RADIO2.Checked = False
	If ArrData(0) = "0" Then
		RADIO0.Checked = True
	ElseIf ArrData(0) = "1" Then
		RADIO1.Checked = True
	ElseIf ArrData(0) = "2" Then
		RADIO2.Checked = True
	Else
		Exit Sub
	End If
	ed_cvol.Data = ArrData(1)
	ed_time.Data = ArrData(2)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
ed_sjgb.Data = GetSjgb
'SCREEN.SetTimer CLng(ed_time.Data)*10, True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If GRID0.Rows <= 0 Then
	Exit Sub
End If

Data = ""
For i = 1 To GRID0.Rows
	ArrCellData = Array("", "", "", "", "", "", "", "")
	bFlag = True
	For j = 1 To UBound(ArrCellData) + 1
		ArrCellData(j - 1) = GRID0.GetGridCell(i, j)
		If j = 1 Then
			If Len(Trim(ArrCellData(j - 1))) = 0 Then
				bFlag = False
				Exit For
			End If
		End If
	Next
	If bFlag Then
		CellData = Join(ArrCellData, "@")
		If Len(Trim(CellData)) <> 0 Then
			If i = 1 Then
				Data = CellData
			Else
				Data = Data & "|" & CellData
			End If
		End If
	End If
Next

If Len(Data) <> 0 Then
	SCREEN.Proc "Main.SetGridData", Data
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_

code = GRID0.GetGridCell(GRID0.row, 1)
If Trim(code) <> "" Then
	S1301.Data = code
	S1301.Trigger "", True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


