_AW_ONDECLARE_AW_
Dim ii
flag.Text = 1

Sub getAmt(ii)
	If Trim(GRID0.GetGridCell(ii, 1)) <> "" Then
		SCREEN.Object("OBJ.zIsuNo").data = GRID0.GetGridCell(ii, 1)
		SCREEN.Object("OBJ.BuyDt").data = GRID0.GetGridCell(ii, 3)
		SCREEN.Object("OBJ.rows").text = ii
		OBJ.Send
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
zAcntNo.Data = SCREEN.Object("main.obj1.zAcntNo").data
zPwd.Data = SCREEN.Object("main.obj1.zPwd").data


' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False

If CheckInput(zAcntNo, zPwd) = True Then
	SCREEN.onsend = True
 	Exit Sub
Else
	SCREEN.Object("main.OBJ1.zPwd").SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GUIDE").text = LEDGER.Emsg

If LEDGER.Next = "Y" Then
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End If

SCREEN.SetTimer 2, False

SCREEN.Object("OBJ.zAcntNo").data = Trim(zAcntNo.Data)
SCREEN.Object("OBJ.zPwd").data = Trim(zPwd.Data)

rows.Text = GRID0.rows
'MsgBox flag.Text
If flag.Text = "1" Then
	Call getAmt(1)
	flag.Text = "0"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	If Trim(GRID0.GetGridCell(GRID0.Row, 1)) <> "" Then
'		'가능수량
		SCREEN.Object("main.canbuy").data = Trim(GRID0.GetGridCell(GRID0.Row, 20))
		SCREEN.Proc "main.Setting_canbuy", ""

'		'채권셋팅
		SCREEN.Object("main.zIsuNo_chae").data = Trim(GRID0.GetGridCell(GRID0.Row, 1))
		SCREEN.Object("main.chae_nm").data = Trim(GRID0.GetGridCell(GRID0.Row, 2))
		SCREEN.Object("main.zBuyDate").data = Trim(GRID0.GetGridCell(GRID0.row, 3))
		SCREEN.Object("main.zTxontTp").data = Trim(GRID0.GetGridCell(GRID0.row, 4))
		SCREEN.Proc "main.Setting_chae", ""
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
