RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub DoReceive()
	Dim ii, items, items2, accnCell, accnText, acnm, accnGubn
	items = ""
	items2 = ""

	For ii = 1 To GRID0.Rows
		accnCell = Trim(GRID0.GetGridCell(ii, 9))
		accnText = Trim(GRID0.GetGridText(ii, 9))
		acnm     = Trim(GRID0.GetGridCell(ii,10))
		accnGubn = ""

		If Trim(accnCell) = "" Then
			Exit For
		End If

		If CLng(Left(accnCell, 3)) < 551 Or CLng(Left(accncell, 3)) > 555 Then	'551~555(은행예수금계좌) 제외
			If Trim(items) = "" Then
				items  = accnCell
			End If

			If Trim(GRID0.GetGridCell(ii, 11)) = "1" And Trim(GRID0.GetGridCell(ii, 12)) = "동일인" Then
				Select Case Mid(Trim(accnCell), 4, 2)
					Case "10" : accnGubn = "위탁    "
					Case "11" : accnGubn = "ELW전용 "
					Case "20" : accnGubn = "선물옵션"
					Case "21" : accnGubn = "옵션전용"
					Case "30" : accnGubn = "일반저축"
					Case "51" : accnGubn = "CMA전용 "
					Case "52" : accnGubn = "RP전용  "
					Case "53" : accnGubn = "수익증권"
					Case "70" : accnGUbn = "신탁    "
					Case Else : accnGubn = "        "
				End Select

				If SCREEN.Object("main.UTAB0").ID = "3" Then '은행->증권탭은 은행계설계좌만 보여줌
					If Left(accnText, 1) = "5" Then
						If Mid(accnText, 5, 2) <> "00" And Len(accnCell) = 11 Then
							items =  items  & vbTab & accnCell & accnText & "   " & accnGubn & "   " & acnm
							items2 = items2 & vbTab & acnm
						End If
					End If
				Else
					If Mid(accnText, 5, 2) <> "00" And Len(accnCell) = 11 Then
						items  = items  & vbTab & accnCell & accnText & "   " & accnGubn & "   " & acnm
						items2 = items2 & vbTab & acnm
					End If
				End If
			End If
		End If
	Next

	SCREEN.Object("main.OBJ1.CMB_ACCT").SetItems(items)
	SCREEN.Object("main.OBJ1.CMB_ACNM").SetItems(items2)

	SCREEN.Proc "main.OBJ1.acct_set", ""  '--계좌번호, 계좌명 세팅

	If SCREEN.Object("main.UTAB0").ID <> "4" Then
		SCREEN.Object("main.OBJ1.zPwd").Setfocus
	End If
End Sub

_AW_ONSEND_AW_
LEDGER.Rcnt = "0025"
