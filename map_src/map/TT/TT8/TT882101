_AW_ONDECLARE_AW_
Dim objset
Dim hval, cval, pval, fval, itmp
objset = Array(S10301, S10302, S10303, S10304)

Sub make_mgym()
	Dim item
	item = ""
	For ii=LBound(objset) To UBound(objset)

		item = item & objset(ii).Data & objset(ii).Data
		If ii <> UBound(objset) Then
			item = item & vbTab
		End If
		If ii = LBound(objset) Then
			item = objset(ii).Data & vbTab & item
		End If
		'SYSTEM.trace "["&ii&"] ["&item&"]"
		objset(ii).Skip True
	Next

	SCREEN.Object("10902").SetItems item
End Sub

Sub OnAlert()
	Exit Sub
	For ii=1 To S40500.Rows
		'If S40500.GetGridCell(ii, 1) = "201F4280" Then

			hval = CDbl(Trim(S40500.GetGridCell(ii, 13)))
			cval = CDbl(Trim(S40500.GetGridCell(ii, 3)))
			pval = CDbl(Trim(S40500.GetGridCell(ii, 7)))
			fval = CDbl(Trim(FTBL.GetTableCell(2)))
			'SYSTEM.Trace "hval=["&hval&"] cval=["&cval&"] pval["&pval&"] fval=["&fval&"] rslt["&(((hval+cval-pval)-fval))&"]"

			S40500.SetGridCell ii, 11, FormatNumber((hval+cval-pval)-fval, 2, 0, 0,0)

			hval = CDbl(Trim(S40500.GetGridCell(ii, 13)))
			cval = CDbl(Trim(S40500.GetGridCell(ii, 2)))
			pval = CDbl(Trim(S40500.GetGridCell(ii, 8)))
			fval = CDbl(Trim(FTBL.GetTableCell(3)))
			S40500.SetGridCell ii, 14, FormatNumber(fval-(hval+cval-pval), 2, 0, 0,0)

			fval = CDbl(Trim(FTBL.GetTableCell(4)))
			cval = Fix(CDbl(Trim(S40500.GetGridCell(ii, 5))) / 5)
			pval = Fix(CDbl(Trim(S40500.GetGridCell(ii, 9))) / 5)

			itmp = fval
			If fval < itmp Then
				itmp = fval
			End If
			If cval < itmp Then
				itmp = cval
			End If
			If pval < itmp Then
				itmp = pval
			End If
			S40500.SetGridCell ii, 12, itmp

			fval = CDbl(Trim(FTBL.GetTableCell(5)))
			cval = Fix(CDbl(Trim(S40500.GetGridCell(ii, 4))) / 5)
			pval = Fix(CDbl(Trim(S40500.GetGridCell(ii, 10))) / 5)

			itmp = fval
			If fval < itmp Then
				itmp = fval
			End If
			If cval < itmp Then
				itmp = cval
			End If
			If pval < itmp Then
				itmp = pval
			End If
			S40500.SetGridCell ii, 15, itmp
			'SYSTEM.Trace "cva=["&cval&"]cval=["&Fix(cval)&"] one=["&CDbl(Trim(S40500.GetGridCell(ii, 5)))&"] after["&(CDbl(Trim(S40500.GetGridCell(ii, 5))) / 5)&"]"
		'End If
	Next
End Sub

