End Sub


'시간 혹은 일자
g_ArrInput = Array("", "")
'-----------------------------------------------------------------------
Function Null_check(Data)
	If Trim(data) = "" Then
		Null_check = 0
		Exit Function
	End If
	Null_check  = CLng(Data)
End Function
'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	Data = re.Replace(Data,"")
	If Len(Data) > 0 Then
		If r1_3.Checked And Int(Data) > 0 Then
			SetSign = "+" & Data
		Else
			SetSign = Data
		End If
	End If
End Function
'-----------------------------------------------------------------------
Function ForceSign(Data, Rate)
	ForceSign = Data
	Data = re.Replace(Data,"")
	Rate = re.Replace(Rate,"")
	If Len(Rate) > 0 Then
		If CDbl(Rate) > 0 Then
			ForceSign = "+" & Data
		ElseIf CDbl(Rate) < 0 Then
			ForceSign = "-" & Data
		End If
	End If
End Function
'-----------------------------------------------------------------------
Function SetTimeElement(hh, mm, ss)
	If Len(hh) = 1 Then
		hh = "0" & hh
	End If
	If Len(mm) = 1 Then
		mm = "0" & mm
	End If
	If Len(ss) = 1 Then
		ss = "0" & ss
	End If
	SetTimeElement = hh & ":" & mm & ":" & ss
End Function
'-----------------------------------------------------------------------
Function GetTime(SrcTime, Interval)
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = CLng(Mid(SrcTime, 1, 2))
	AMin = CLng(Mid(SrcTime, 3, 2))
	ASec = CLng(Mid(SrcTime, 5, 2))
	If Interval = 0 Then '30초간격
		ASec = Fix(CLng(Mid(SrcTime, 5, 2)) / 30) * 30
	Else
		ASec = 0
		AMin = (Fix(CLng(Mid(SrcTime, 3, 2)) / Interval) * Interval) + Interval
	End If

	ADate = TimeSerial(AHour, AMin, ASec)

	GetTime = SetTimeElement(Hour(ADate), Minute(ADate), Second(ADate))
End Function
'-----------------------------------------------------------------------
Function GetTimeJisu(SrcTime, Interval)
	Dim remain
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = CLng(Mid(SrcTime, 1, 2))
	AMin = CLng(Mid(SrcTime, 3, 2))
	ASec = CLng(Mid(SrcTime, 5, 2))

	If Interval = 0 Then '30초간격
		If ASec > 0 Then
			If ASec < 40 Then
				ASec = 30
			Else
				ASec = 0
				AMin = AMin + 1
			End If
		End If
	Else
		If (AMin Mod Interval) > 0 Then
			ASec = 0
			AMin = (AMin / Interval) + Interval
		End If

		If ASec > 0 Then
			ASec = 0
			AMin = AMin + Interval
		End If
	End If

	ADate = TimeSerial(AHour, AMin, ASec)

	GetTimeJisu = SetTimeElement(Hour(ADate), Minute(ADate), Second(ADate))
End Function
'-----------------------------------------------------------------------
Sub ProcSetData(Data)

	ArrData = Split(Data, "|")

	ADateTime = GetTime(ArrData(1), min)
	CurTime = S62311.GetGridCell(1, 1)
	'SYSTEM.Trace "ADateTime=["&ADateTime&"], CurTime=["&CurTime&"]"
	ctime = CLng(re.Replace(CurTime,""))
	ntime = CLng(re.Replace(ADateTime,""))

	If ctime < ntime Then
		S62311.InsertRow 0
		S62311.SetGridCell 1, 1, ADateTime
		rate = SCREEN.Object("main.OBJ0.20033").Data
		S62311.SetGridCell 1, 2, ForceSign(SCREEN.Object("main.OBJ0.20023").Data, rate)
		S62311.SetGridCell 1, 3, ForceSign(SCREEN.Object("main.OBJ0.20024").Data, rate)
		S62311.SetGridCell 1, 4, ForceSign(SCREEN.Object("main.OBJ0.20033").Data, rate)
	End If

	For i = LBound(g_ArrData) To UBound(g_ArrData)
		If g_ArrData(i)(1) = Trim(ArrData(0)) Then
			Select Case S62307.Data
			Case "01"	'매수거래량
				S62311.SetGridCell 1, g_ArrData(i)(2), SetSign(ArrData(2))
			Case "03"	'매도거래량
				S62311.SetGridCell 1, g_ArrData(i)(2), SetSign(ArrData(3))
			Case "05"	'순매수량
				S62311.SetGridCell 1, g_ArrData(i)(2), SetSign(ArrData(4))
			Case "02"	'매수거래대금
				S62311.SetGridCell 1, g_ArrData(i)(2), SetSign(ArrData(5))
			Case "04"	'매도거래대금
				S62311.SetGridCell 1, g_ArrData(i)(2), SetSign(ArrData(6))
			Case "06"	'순매수거래대금
				S62311.SetGridCell 1, g_ArrData(i)(2), SetSign(ArrData(7))
			End Select
		ElseIf ADateTime <> CurTime Then
			S62311.SetGridCell 1, g_ArrData(i)(2), SetSign(S62311.GetGridCell(2, g_ArrData(i)(2)))
		End If
	Next
End Sub
'-----------------------------------------------------------------------

Sub updatejisu(param)
	ArrData = Split(param, "|")
	ADateTime = GetTimeJisu(ArrData(0), min)
	CurTime = S62311.GetGridCell(1, 1)
	ctime = CLng(re.Replace(CurTime,""))
	ntime = CLng(re.Replace(ADateTime,""))
	If ctime = ntime Then
		S62311.SetGridCell 1, 2, ForceSign(ArrData(1), ArrData(3))
		S62311.SetGridCell 1, 3, ForceSign(ArrData(2), ArrData(3))
		S62311.SetGridCell 1, 4, ForceSign(ArrData(3), ArrData(3))
	ElseIf ctime < ntime Then
		S62311.InsertRow 0
		S62311.SetGridCell 1, 1, ADateTime
		S62311.SetGridCell 1, 2, ForceSign(ArrData(1), ArrData(3))
		S62311.SetGridCell 1, 3, ForceSign(ArrData(2), ArrData(3))
		S62311.SetGridCell 1, 4, ForceSign(ArrData(3), ArrData(3))
		For i = LBound(g_ArrData) To UBound(g_ArrData)
			S62311.SetGridCell 1, g_ArrData(i)(2), SetSign(S62311.GetGridCell(2, g_ArrData(i)(2)))
		Next
	End If
End Sub

