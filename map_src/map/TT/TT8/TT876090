RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim ArrData

ArrData = Array()
ReDim ArrData( GRID0.Rows - 1)
'----------------------------------------------------------------------
Sub GetHNamList()
	ArrItem = Array("", "")

	For i = 1 To GRID0.Rows
		HNam = Trim(GRID0.GetGridCell( i, 2 ))
		If Len(HNam) = 0 Then
			Exit For
		End If
		Code = GRID0.GetGridCell( i, 1 )
		CdTp = Trim(GRID0.GetGridCell( i, 3 ))

		Data  = Code & CdTp
		ArrItem(0) = Data
		ArrItem(1) = HNam


		Item = Join(ArrItem, "~")
		SYSTEM.Trace Item
		ArrData(i - 1) = Item
	Next
	Data = Join(ArrData, "|")
	Cnt = i

	SCREEN.Proc "main.SetCodeList", Data & ", " & Cnt
End Sub

Sub send_f()
	GRID0.SetDataPosition 0
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
'SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If o_cont.Data = "Y" Then
	cont.Data = "Y"
	npos.Data = o_npos.Data
	GRID0.SetDataPosition 2
	SCREEN.Send 0
Else
	cont.Data = ""
	npos.Data = ""
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


