_AW_ONSEND_AW_
Dim accn, pass, ret

SCREEN.OnSend False
VIEWGRID.Clear

accn = Trim(AN20.Data)						'계좌번호
pass = Trim(pswd.Data)						'비밀번호

If Error_check() = False Then				'보내기전 에러체크
	pswd.SetFocus
	Exit Sub
Else
	ret = P_pswdConfirm(AN20.Data, pswd.Data, msg)
		If ret <> True Then
			GUIDE.Text = msg
			pswd.SetFocus
			Exit Sub
		End If
	Call CONTROL0.Send(accn , pass)
End If

