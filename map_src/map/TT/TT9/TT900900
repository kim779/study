RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN10.Name
	h_acnm.Data = AN10.Name
	zPwd.Data = AN10.Password
	If Trim(AN10.Data) = "" Then
		AN10.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

If CheckInput(AN10, zPwd) = True Then
	SCREEN.onsend = True
 	'Exit Sub
Else
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Or LEDGER.Ecod = "1801"Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable True
Else
	next_btn.Enable False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AN10)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_

Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


