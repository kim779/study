_AW_ONDECLARE_AW_
Sub init_mmgb()
	Dim i, atmval, gubn
	atmval = Trim(atm.Data)
	gubn = SCREEN.Object("main.OBJ_HEAD1.mmgb").Data

	For i=1 To S410.Rows
		If atmval=Trim(S410.GetGridCell(i, 13)) Then
			S410.SetPRgb i, 13, 66
			S410.SetPRgb i, 14, 66
			S410.SetGridCell i, 11,  ""
			S410.SetGridCell i, 12,  ""
			S410.SetGridCell i, 15,  ""
			S410.SetGridCell i, 16,  ""
			If gubn = 1 Then
				S410.SetGridCell i, 11,  "●"
				S410.SetGridCell i, 15,  "●"
				SCREEN.Object("main.ed_focod1").Data = Trim(S410.GetGridCell(i, 1 ))
				SCREEN.Object("main.ed_focod2").Data = Trim(S410.GetGridCell(i, 17 ))
				Call set_tab(1, "left")
				Call set_tab(2, "right")
			ElseIf gubn = 2 Then
				S410.SetGridCell i, 11,  "●"
				S410.SetGridCell i, 12,  "●"
				SCREEN.Object("main.ed_focod1").Data = Trim(S410.GetGridCell(i, 1 ))
				SCREEN.Object("main.ed_focod2").Data = Trim(S410.GetGridCell(i, 1 ))
				Call set_tab(1, "left")
				Call set_tab(2, "right")
			Else
				S410.SetGridCell i, 15,  "●"
				S410.SetGridCell i, 16,  "●"
				SCREEN.Object("main.ed_focod1").Data = Trim(S410.GetGridCell(i, 17 ))
				SCREEN.Object("main.ed_focod2").Data = Trim(S410.GetGridCell(i, 17 ))
				Call set_tab(2, "left")
				Call set_tab(1, "right")
			End If
			S410.Index = i + 4
			SCREEN.Proc "main.send_sise", "left"
			SCREEN.Proc "main.send_sise", "right"
			S410.Index = i - 1
			S410.SetFocus
		Else
			S410.SetGridCell i, 11,  ""
			S410.SetGridCell i, 12,  ""
			S410.SetGridCell i, 15,  ""
			S410.SetGridCell i, 16,  ""
			S410.SetPRgb i, 13, 68
			S410.SetPRgb i, 14, 68
		End If
	Next
End Sub

Sub jisu_update()
	Dim ii, kospi, k200, hangsa, trans
	kospi = CDbl(SCREEN.Object("OBJ_KOSPI.20023").Data)
	k200 = CDbl(SCREEN.Object("OBJ_K200.20023").Data)
	For ii = 1 To S410.Rows
		hangsa = CDbl(S410.GetGridCell(ii, 13))
		trans = (hangsa * kospi) / k200
		S410.SetGridCell ii,14, FormatNumber(trans,2,,-2)
	Next
End Sub

Sub set_tab(id, target)
	Dim refobjgb
	If target = "left" Then
		refobjgb = "1"
	Else
		refobjgb = "2"
	End If
	SCREEN.Object("main.OBJ_order" & refobjgb & ".tab_order").ID = id
	SCREEN.Proc "main.OBJ_order" & refobjgb & ".order_tab_change", ""
End Sub

