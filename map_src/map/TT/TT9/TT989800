_AW_ONDECLARE_AW_
Sub qry_list()
	QryGubn.Data = "1"
	SCREEN.Send 0
End Sub


Sub change_tab(id)
	UTAB0.ID = id
	Select Case id
		Case 1 :
			PANEL2.Visible = True
			PANEL5.visible = False
			BTN_DEL.Visible = False
			BTN_DEL.Enable = False
			bcod.Data = ""
			name.Data = ""
			bhil.Data = ""
			shil.Data = ""
		Case 2 :
			PANEL2.Visible = False
			PANEL5.visible = True
			BTN_DEL.Visible = True
			BTN_DEL.Enable = True
	End Select
End Sub

_AW_ONSTART_AW_
Call qry_list

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call qry_list
