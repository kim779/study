    If param = 0 Then
        GRID1.SetRect 287, 0, 881, 415
        For ii = 9 To 11
        	GRID1.SetColumnVisible ii+1, False
           	For jj = 1 To 22
            	SCREEN.Object("TABLE" & (((jj-1)*12 )+ii)).Visible = False
