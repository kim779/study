RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Send_f()
	Dim data
	GRID0.Clear
	data = CONTROL0.GetMemoData(1,"","")
	Call data_split(data)
End Sub

Sub data_split(data)
	Dim ipos, ii, vdata, vname, kind, sdata
	ipos = InStr(data,"|")
	While ipos <> 0
		vdata = Mid(data, 1, ipos-1)
		sdata = vdata
		data = Mid(data, ipos+1)
		ipos = InStr(data,"|")
		GRID0.InsertRow(GRID0.Rows)
		If Mid(vdata,1,1)="A" Or Mid(vdata,1,1)="J" Then
			vdata = Mid(vdata,2)
			kind = 100
		ElseIf Len(vdata) = 5 Then
			kind = 112
		ElseIf Mid(vdata,1,1)="F" Then  '신주인수권
			kind = 109
		ElseIf Mid(vdata,1,1)="1" Or Mid(vdata,1,1)="4" Then
			kind = 101
		ElseIf Mid(vdata,1,1)="2" Or Mid(vdata,1,1)="3" Then
			kind = 102
		End If
		vname = SCREEN.GetName(kind, vdata,0)
		Call GRID0.SetGridCell(GRID0.Rows, 2, vdata)
		Call GRID0.SetGridCell(GRID0.Rows, 3, vname)
		Call GRID0.SetGridCell(GRID0.Rows, 4, sdata)
		'MsgBox vdata
	Wend

End Sub

_AW_ONSTART_AW_
Call Send_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call Send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim code, data
If GRID0.HitPos = 3 Then
	If GRID0.Column <> 1 Then
		code = GRID0.GetGridCell(GRID0.row, 4)
		data = CONTROL0.GetMemoData(2, code, "")
		MEMO0.Text = data
	Else
		code = GRID0.GetGridCell(GRID0.row, 4)
		data = CONTROL0.GetMemoData(3, code, "")
		Call GRID0.RemoveRow(GRID0.Row-1)
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
	If GRID0.row = -1 Then Exit Sub
	code = GRID0.GetGridCell(GRID0.row, 4)
	data = CONTROL0.GetMemoData(3, code, MEMO0.Text)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



