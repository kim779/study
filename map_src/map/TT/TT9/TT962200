Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN15.Name
	h_acnm.Data = AN15.Name
	zPwd.Data = AN15.Password

	If Trim(AN15.Data) = "" Then
		AN15.SetFocus
