RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim baseyear, grows
baseyear = 2006
grows = 0
'2006년부터 A 알파벳을 사용
'2006~2025 : A~W 알파벳이 사용, 2026~2036에는 다시 숫자가 사용됨

Sub init_fcombo()
	Dim FSO, F, ReadData, Dummy
	grows = 0
	Set FSO = CreateObject("Scripting.FileSystemObject")
	Set F = FSO.OpenTextFile(SYSTEM.Home & "\tab\fjcode.dat", 1)
	Do While Not F.AtEndOfStream
		ReadData = F.Read(8)
		Dummy = F.Read(41)
		If Len(Trim(ReadData)) > 0 Then
			If Left(ReadData,1) = "1" Then
				grows = grows + 1
				grid.InsertRow(-1)
				grid.SetGridCell grows, 1, ReadData
				iyear = baseyear+Asc(Mid(ReadData, 4,1))-Asc("A")
				imon  = Asc(Mid(ReadData, 5,1))
				If imon >= 65 Then
					imon = imon - 65 + 10
					imon = CStr(imon)
				Else
					imon = imon - 49 + 1
					imon = "0" & CStr(imon)
				End If
				grid.SetGridCell grows, 2, iyear & imon
			End If
		End If
	Loop
End Sub

_AW_ONSTART_AW_
init_fcombo()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim fcod, code, yymm
pyymm = Trim(SCREEN.Object("parent.yymm").data)
SYSTEM.Trace "test ["&ii&"] rows=["&grows&"]"
If IsNumeric(pyymm) = True Then
	For ii=1 To grows
		fcod = Trim(grid.GetGridCell(ii, 1))
		yymm = Trim(grid.GetGridCell(ii, 2))
		If IsNumeric(yymm) Then
			If CLng(yymm) >= CLng(pyymm) Then
				S30301.Data = fcod
				Exit For
			End If
		End If
	Next
	If Trim(S30301.Data) = "" Then
		S30301.Data = "00000000"
	End If
Else
	If Trim(S30301.Data) = "" Then
		S30301.Data = "00000000"
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(31023)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(grid)
_AW_ENDSCRIPT_AW_


}



