Sub scrchange(param)
    Dim scrtype, grid, mapname
    scrtype = param Mod 2
    viewgb.Data = scrtype
    mapname = OBJ.GetObject
    Set grid = SCREEN.Object("OBJ.GRID0")
    If scrtype = 0 Then
    	If mapname = "TT910201" Then
	        SCREEN.SetSize 926, 460
	        PANEL0.SetRect -2, 30, 928, 462
	        PANEL3.SetRect -2, 0, 928, 32
	        BTN_1.Visible   = False
	        BTN_2.Visible   = True
	        LABEL6.Text = "화면확장"
	        grid.SetRect 0, 0, 914, 415
			For ii=17 To 19
				grid.SetColumnVisible ii, False
			Next
		Else
			SCREEN.SetSize 926, 460
	        PANEL0.SetRect -2, 30, 928, 462
	        PANEL3.SetRect -2, 0, 928, 32
	        BTN_1.Visible   = False
	        BTN_2.Visible   = True
	        LABEL6.Text = "화면확장"
	        grid.SetColumnVisible 19, False
	        grid.SetColumnVisible 18, False
	        grid.SetColumnVisible 17, False
			For ii=8 To 16
				If ii < 12 Then
					grid.SetColumnWidth ii, 86
				Else
					grid.SetColumnWidth ii, 85
				End If
			Next
			grid.SetRect 0, 0, 914, 415
		End If
    ElseIf scrtype = 1 Then
    	If mapname = "TT910201" Then
	        SCREEN.SetSize 1123, 460
	        PANEL0.SetRect -2, 30, 1125, 462
	        PANEL3.SetRect -2, 0, 1125, 32
	        BTN_1.Visible = True
	        BTN_2.Visible = False
	        LABEL6.Text = "화면축소"
	        grid.SetRect 0, 0, 1110, 415
	        For ii=17 To 19
				grid.SetColumnVisible ii, True
			Next
		Else
			SCREEN.SetSize 1123, 460
	        PANEL0.SetRect -2, 30, 1125, 462
	        PANEL3.SetRect -2, 0, 1125, 32
	        BTN_1.Visible = True
	        BTN_2.Visible = False
	        LABEL6.Text = "화면축소"
	        grid.SetRect 0, 0, 1110, 415
	        For ii=8 To 19
	        	If ii > 16 Then
					grid.SetColumnVisible ii, True
				ElseIf ii < 13 Then
					grid.SetColumnWidth ii, 81
				Else
					grid.SetColumnWidth ii, 80
				End If
			Next
		End If
    End If
    Call p_write_ini()
End Sub

