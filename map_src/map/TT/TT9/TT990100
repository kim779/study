_AW_ONDECLARE_AW_
Sub send_sise(target)
	Dim code, rsymb, fogb, refobjgb, focod

	If target = "left" Then
		refobjgb = "1"
	Else
		refobjgb = "2"
	End If

	focod = SCREEN.Object("ed_focod" & refobjgb).Data
	code = Left(Trim(focod), 1)

	If code = "1" Or code = "4" Then
		fogb = 101
	ElseIf code = "2" Or code = "3" Then
		fogb = 102
	End If

	SCREEN.Object("hnam" & refobjgb).Data = SCREEN.GetName (fogb, focod, 0)

	If target = "left" Then
		If code = "2" Or code = "3" Then
			If Right(OBJ_sise1.GetObject,2) <> "11" Then
				OBJ_sise1.SetObject("TT990111")
			End If
		Else
			If Right(OBJ_sise1.GetObject,2) <> "13" Then
				OBJ_sise1.SetObject("TT990113")
			End If
		End If

	Else
		If code = "2" Or code = "3" Then
			If Right(OBJ_sise2.GetObject,2) <> "12" Then
				OBJ_sise2.SetObject("TT990112")
			End If
		Else
			If Right(OBJ_sise2.GetObject,2) <> "14" Then
				OBJ_sise2.SetObject("TT990114")
			End If
		End If
	End If
	SCREEN.Object("OBJ_sise" & refobjgb).Send
	SCREEN.Object("OBJ_order" & refobjgb & ".OBJ_odr.hnam").data = SCREEN.Object("hnam" & refobjgb).Data
	SCREEN.Object("OBJ_order" & refobjgb & ".OBJ_odr.ed_focod" & refobjgb).data = SCREEN.Object("ed_focod" & refobjgb).Data
	SCREEN.Object("OBJ_order" & refobjgb & ".OBJ_odr.ed_jprc" & refobjgb).data = ""
	SCREEN.Proc "OBJ_order" & refobjgb & ".OBJ_odr.ChangeCode", ""
End Sub

