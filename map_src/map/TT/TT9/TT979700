_AW_ONDECLARE_AW_
Dim objset
objset = Array(obj_copt, obj_popt, obj_futu)
Sub make_hsga()
	Dim atmg, item
	item = ""

	For ii=1 To grid.Rows
		atmyn = Trim(grid.GetGridCell(ii, 1))
		ocod = Trim(grid.GetGridCell(ii, 2))
		hang = Trim(grid.GetGridCell(ii, 3))
		If ocod="" Then
			Exit For
		End If
		item = item & ocod & hang
		If ii <> grid.Rows Then
			item = item & vbTab
		End If
		If atmyn = "Y" Then
			item = ocod & vbTab & item
		End If
		'SYSTEM.trace "["&ii&"] ["&item&"]"
	Next

	SCREEN.Object("HSGA").SetItems item
End Sub

Sub ch_hsga()
	For ii=LBound(objset) To UBound(objset)
		objset(ii).Send
	Next
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

