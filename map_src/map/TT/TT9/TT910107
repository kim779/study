RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	GRID1.Clear
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
Dim datagubn
If SCREEN.Object("parent.r1").Checked Then
	sjcd.Data = "00"
ElseIf SCREEN.Object("parent.r3").Checked Then
	sjcd.Data = "90"
End If

If SCREEN.Object("parent.r1_2").Checked Then
	datagubn = 1
ElseIf SCREEN.Object("parent.r1_1").Checked Then
    datagubn = 2
Else
    datagubn = 3
End If

If SCREEN.Object("parent.r2_2").Checked Then
    datagubn = datagubn + 3
End If


vagb.Data = datagubn
sdate.Data = SCREEN.Object("parent.sdate").Data
edate.Data = SCREEN.Object("parent.edate").Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(outTime)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
If Trim(GRID1.GetGridCell(1, 1)) = "" Or Trim(GRID1.GetGridCell(1, 2)) = "" Then
	Exit Sub
End If


Dim jisu, upjong, dmsg

If GRID1.HitPos = 3 Then
	jisu = sjcd.Data
	upjong = GRID1.GetGridCell(GRID1.Row, 1)
	dmsg = "jisu" & vbTab & jisu & vbLf &_
	  	   "upjong" & vbTab & upjong & vbLf

	SCREEN.CreateWindow 1, "IB291100 /t/d/p5/s", dmsg
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



