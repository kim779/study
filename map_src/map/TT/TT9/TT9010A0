{


_AW_ONSEND_AW_
SCREEN.OnSend = False

GRID0.Clear

If SYSTEM.ConnectBy = 1 Then   'Á÷¿ø
	SCREEN.OnSend = False
	SCREEN.Proc "parent.setbank", ""
	Exit Sub
Else

	Dim accList,a,b,g,idx,d

	accList = CONTROL0.GetTypeData ("4","" )
	a = 1
	idx = 1

	Do While a < Len(accList)
		b = InStr(a,accList,vbLf,0)
		If b = 0 Then
			Exit Do
		End If

		g = Mid( accList, a, b-a )
		a = b + 1

		d = Mid(g,4,2)
		If d = "10" Or d ="00" Then
			GRID0.SetGridCell idx, 1, Left(g,11)
			GRID0.SetGridCell idx, 2, Right(g,Len(g)-11)
			idx = idx + 1
		End If
	Loop

End If

Dim ii, chk
chk = 0

For ii =1 To GRID0.Rows
	If Trim(GRID0.getgridcell(ii, 1)) = "" Then
		Exit For
	End If

	If Left(Trim(GRID0.getgridcell(ii, 1)), 1) <> "5" Then
		chk = 1
	End If
Next

If chk = 0 Then
	obj.Send
Else
	SCREEN.Proc "parent.setbank", ""
End If



