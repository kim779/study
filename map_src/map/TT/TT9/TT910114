If time.Data <> "99" Then
	If OBJ.GetObject <> "TT910121" Then
		OBJ.SetObject("TT910121")
	End If
	sdate.Visible = False
	edate.Visible = False
	link.Visible = False
	LABEL0.Text = "증감"
Else
	If OBJ.GetObject <> "TT910122" Then
		OBJ.SetObject("TT910122")
	End If	
	
	If r3_1.Checked Then
		sdate.Enable = True
	Else
		sdate.Enable = False
	End If		
	sdate.Visible = True
	edate.Visible = True
	link.Visible = True
	LABEL0.Text = "일별"
	sdate.Data = change_date("m", -3)
End If
Call send_f()
