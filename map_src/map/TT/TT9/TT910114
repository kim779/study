RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	p_write_ini()
	OBJ.Proc "send_f", ""
End Sub

Sub p_write_ini()
	Dim msgb, vagb, cagb
	
	If r1_1.Checked Then
		msgb = "1"
	ElseIf r1_2.Checked Then
	 	msgb = "2"
	Else
		msgb = "3"
	End If
	
	If r2_1.Checked Then
		vagb = "1"
	Else
		vagb = "2"
	End If
	
	If r3_1.Checked Then
		cagb = "1"
	Else
		cagb = "2"
	End If
	
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "msgb", msgb
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "vagb", vagb
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "cagb", cagb
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "tmgb", time.Data
	End If
End Sub

Sub p_read_ini()	
	If SCREEN.CreateObject("INFO") Then
		Dim msgb, vagb, cagb, ii
		msgb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "msgb"))
		vagb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "vagb"))
		cagb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "cagb"))
		tmgb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "tmgb"))

		If msgb <> "" Then			
			For ii=1 To 3
				If CLng(msgb) = ii Then					
					SCREEN.Object("r1_"&ii).Checked = True
				Else
					SCREEN.Object("r1_"&ii).Checked = False
				End If
			Next			
		Else
			For ii=1 To 3
				If ii = 3 Then
					SCREEN.Object("r1_"&ii).Checked = True
				Else
					SCREEN.Object("r1_"&ii).Checked = False
				End If
			Next
		End If

		If vagb <> "" Then
			For ii=1 To 2
				If CLng(vagb) = ii Then
					SCREEN.Object("r2_"&ii).Checked = True
				Else
					SCREEN.Object("r2_"&ii).Checked = False
				End If
			Next			
		Else
			For ii=1 To 2
				If ii = 2 Then
					SCREEN.Object("r2_"&ii).Checked = True
				Else
					SCREEN.Object("r2_"&ii).Checked = False
				End If
			Next
		End If
		
		If cagb <> "" Then
			For ii=1 To 2
				If CLng(cagb) = ii Then
					SCREEN.Object("r3_"&ii).Checked = True
				Else
					SCREEN.Object("r3_"&ii).Checked = False
				End If
			Next			
		Else
			For ii=1 To 2
				If ii = 1 Then
					SCREEN.Object("r3_"&ii).Checked = True
				Else
					SCREEN.Object("r3_"&ii).Checked = False
				End If
			Next
		End If
		
		If tmgb <> "" Then
			time.Data = tmgb
		Else
			time.Data = "00"
		End If
		
		If time.Data <> "99" Then
			If OBJ.GetObject <> "TT910121" Then
				OBJ.SetObject("TT910121")
			End If
			sdate.Visible = False
			edate.Visible = False
			link.Visible = False
			LABEL0.Text = "증감"
		Else
			If OBJ.GetObject <> "TT910122" Then
				OBJ.SetObject("TT910122")
			End If	
			
			If r3_1.Checked Then
				sdate.Enable = True
			Else
				sdate.Enable = False
			End If		
			sdate.Visible = True
			edate.Visible = True
			link.Visible = True
			LABEL0.Text = "일별"
			sdate.Data = change_date("m", -3)
		End If
	End If
End Sub

