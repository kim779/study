_AW_SCRIPT_AW_(VIEWGRID)
_AW_ONCLICK_AW_
If VIEWGRID.HitPos = HP_ITEM Then
	If Mid(Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 2)), 2, 6) <> "" And _
								Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 8)) <> "" Then
		If VIEWGRID.Column = 1 Then
				btn_check
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(C_all)
_AW_ONCLICK_AW_
all_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CONTROL0)
_AW_ONDBLCLK_AW_
Dim row, sList
If  CONTROL0.Flag = "A" Then
	VIEWGRID.Clear
	VIEWGRID.InsertRows 0, CONTROL0.DataList, True
'	Call VIEWGRID.Sort (2, True, True)
Else
	row = Find_Row(Left(CONTROL0.DataList, 22))
	sList = Mid(CONTROL0.DataList, 23, Len(CONTROL0.DataList)-22)

	Select Case CONTROL0.Flag
		Case "I"						'insert
				VIEWGRID.InsertRow row
				VIEWGRID.Update row, sList
		Case "D"						'delete
				VIEWGRID.RemoveRow row-1
		Case "U"						'update
				VIEWGRID.Update row-1, sList
	End Select
End If
abc.Text = CONTROL0.datalist
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call CONTROL0.Send("10110000002", "0423")
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


