RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MAX_ROWS = 50
Const HP_ITEM  = 3
'미니
'Const MD_MAP	= "DH012200/t/S/p5/d"
'Const MS_MAP	= "DH012100/t/S/p5/d"
'통합
Const MD_MAP	= "DH010100/t/S/p5/d"
Const MS_MAP	= "DH010100/t/S/p5/d"

'***************************************************************************
'	Func : run_xorder
'***************************************************************************
Sub run_xorder

Dim s_data, accn, pswd
num.Data = 0

accn = SCREEN.Object("parent.OBJ1.AN16").data
pswd = Trim(SCREEN.Object("parent.OBJ1.pswd").data)
For ii = 1 To VIEWGRID.Rows
	If VIEWGRID.GetGridCell(ii ,1) = 1 Then
		If CDbl(num.Data) = MAX_ROWS Then Exit For
		If Trim(pswd) = "" Then Exit For

		s_data = "#" &s_data
		s_data = VIEWGRID.GetCell(ii , "c_msgb") & "|" & s_data		' 7 주문구분
		s_data = VIEWGRID.GetCell(ii , "c_curr") & "|" & s_data		' 6 주문가
		s_data = VIEWGRID.GetCell(ii , "c_xqty") & "|" & s_data		' 5 주문가능수량
		s_data = VIEWGRID.GetCell(ii , "c_hnam") & "|" & s_data		' 4 종목명
		s_data = VIEWGRID.GetCell(ii , "c_code") & "|" & s_data		' 3 종목코드
		s_data = pswd & "|" & s_data									' 2 비밀번호
		s_data = accn & "|" & s_data									' 1 계좌번호

		num.Data = num.Data + 1
	End If
Next

If num.Data > 0 Then
	num.Push ""
	SCREEN.CreateWindow 2, "DH700302 /t/s/p?/d", "s_data" & vbTab & s_data
	cls_check
End If

End Sub

'***************************************************************************
'	Func : All check
'***************************************************************************
Sub all_check()
	Dim cnt
	cnt = 0
	If Trim(VIEWGRID.GetGridCell(1,1)) <> "" Then
		If C_all.Checked = True Then
			For i = 1 To VIEWGRID.Rows
				If Trim(VIEWGRID.GetGridCell(i, 2)) <> "" Then
					VIEWGRID.SetGridCell i , 1, 1
					cnt = cnt + 1
				End If
			Next
			If cnt > 0 Then
				SCREEN.Object("parent.B_xodr").Enable = True
			End If
		ElseIf C_all.Checked = False Then
			For i = 1 To VIEWGRID.Rows
				VIEWGRID.SetGridCell i ,1, 0
			Next
			SCREEN.object("parent.B_xodr").Enable = False
		End If
	End If
End Sub

'***************************************************************************
'	Func : btn check
'***************************************************************************
Sub btn_check()
	Dim cnt
	cnt = 0
	For i = 1 To VIEWGRID.Rows
			If Trim(VIEWGRID.GetGridCell(i, 2)) <> "" Then
				If Trim(VIEWGRID.GetGridCell(i, 1)) = 1 Then
					cnt = cnt + 1
				End If
			End If
	Next
	If cnt > 0 Then
		SCREEN.object("parent.B_xodr").Enable = True
	Else
		SCREEN.object("parent.B_xodr").Enable = False
	End If
End Sub

'***************************************************************************
'	Func : cls_check
'***************************************************************************
Sub cls_check()
	For i = 1 To VIEWGRID.Rows
		VIEWGRID.SetGridCell i ,1, 0
	Next
	SCREEN.Object("parent.B_XODR").Enable = False
	C_all.Checked = False
End Sub

'***************************************************************************
'	Func : Find_Row
'***************************************************************************
Function Find_Row(sKey)
	Dim sCode, sGubn, sDate

	sCode = Mid(sKey, 1, 7)
	sDate = Mid(sKey, 13, 8)
	sGubn = Mid(sKey, 21, 2)
	For row = 1 To VIEWGRID.Rows
		If Trim(sCode) = Trim(VIEWGRID.GetGridCell (row, 1)) _
				And Trim(sGubn) = Trim(VIEWGRID.GetGridCell (row, 5)) _
				And Trim(sDate) = Trim(VIEWGRID.GetGridCell (row, 15)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

_AW_ONSEND_AW_
SCREEN.OnSend False
VIEWGRID.Clear

If Trim(SCREEN.Object("parent.pswd_login").Data) = "" Then
	SCREEN.OnSend = False
	Exit Sub
End If

Dim accn, pswd
accn = SCREEN.Object("parent.OBJ1.AN16").data
pswd = Trim(SCREEN.Object("parent.OBJ1.pswd").data)

If accn <> ""  And pswd <> "" Then
	Call CONTROL0.Send(accn , pswd)
Else
	If pswd = "" Then
		SCREEN.Object("parent.OBJ1.pswd").Setfocus
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
