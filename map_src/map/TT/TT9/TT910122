Set re = New RegExp
re.Global = True
re.IgnoreCase = True
re.MultiLine = True
re.Pattern = "[^0-9.\-\+]"

ymd = Date
nowdate = Year(ymd)

If Len(Month(ymd)) < 2 Then
	nowdate = nowdate & "0" & Month(ymd)
Else
	nowdate = nowdate & Month(ymd)
End If

If Len(Day(ymd)) < 2 Then
	nowdate = nowdate & "0" & Day(ymd)
Else
	nowdate = nowdate & Day(ymd)
End If

'투자코드,투자자명,ColNumber
g_ArrData = Array(Array("기관계", "0", "8", True),_
	Array("증권", "1", "10", True),_
	Array("보험", "2", "11", True),_
	Array("투신", "3", "9", True),_
	Array("은행", "4", "12", True),_
	Array("종금/신금", "5", "13", True),_
    Array("기금/연금", "6", "14", True),_
    Array("기타", "7", "17", True),_
    Array("개인", "8", "7", True),_
    Array("외국인", "9", "6", True),_
    Array("미등록외국인", "10", "17", False),_
    Array("선물업자", "11", "17", False),_
	 Array("사모펀드", "12", "15", True),_
	Array("국가", "13", "16", True))

Sub send_f()
	S63500.Clear
	S63303.Data = SCREEN.Object("main.ed_upcd").Data
	SCREEN.Send 0
End Sub

Sub send_eachtuja(bval)
	Dim ii, upgb, upcd, sjcd

	upcd = SCREEN.Object("main.ed_upcd").Data
	upgb = Trim(SCREEN.Object("main.upgb").Data)
	If upgb = "0" Or upgb = "1" Then
		sjcd = "0"
		If upcd = 101 Then
			upcd = 1001
		End If
	Else
		sjcd = "1"
		upcd = CLng(upcd) - 200
	End If

	For ii = LBound(g_ArrData) To UBound(g_ArrData)
		SCREEN.Object("OBJ" & ii & ".62302").Data = sjcd
		SCREEN.Object("OBJ" & ii & ".62303").Data = upcd
		SCREEN.Object("OBJ" & ii & ".62304").Data = g_ArrData(ii)(1)
		If bval Then
			If g_ArrData(ii)(3) = True Then
				If CLng(upgb) = 3 Then
					SCREEN.Object("OBJ" & ii).ClearAll 0
				Else
					SCREEN.Object("OBJ" & ii).Proc "send_f", ""
				End If
			End If
		Else
			SCREEN.Object("OBJ" & ii).ClearAll 0
		End If
	Next
End Sub


'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	Data = re.Replace(Data,"")
	If Len(Data) > 0 Then
		If SCREEN.Object("parent.r1_3").Checked And Int(Data) > 0 Then
			SetSign = "+" & Data
		Else
			SetSign = Data
		End If
	End If
End Function
'-----------------------------------------------------------------------
Function ForceSign(Data, Rate)
	ForceSign = Data
	Data = re.Replace(Data,"")
	Rate = re.Replace(Rate,"")
	If Len(Rate) > 0 Then
		If CDbl(Rate) > 0 Then
			ForceSign = "+" & Data
		ElseIf CDbl(Rate) < 0 Then
			ForceSign = "-" & Data
		End If
	End If
End Function
'-----------------------------------------------------------------------
Function SetTimeElement(hh, mm, ss)
	If Len(hh) = 1 Then
		hh = "0" & hh
	End If
	If Len(mm) = 1 Then
		mm = "0" & mm
	End If
	If Len(ss) = 1 Then
		ss = "0" & ss
	End If
	SetTimeElement = hh & ":" & mm & ":" & ss
End Function
'-----------------------------------------------------------------------
Function GetTime(SrcTime, Interval)
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = CLng(Mid(SrcTime, 1, 2))
	AMin = CLng(Mid(SrcTime, 3, 2))
	ASec = CLng(Mid(SrcTime, 5, 2))
	If Interval = 0 Then '30초간격
		If ASec >= 30 Then
			ASec = 0
			AMin = AMin + 1
		Else
			ASec = 30
		End If
	Else
		If (AMin Mod Interval) > 0 Then
			ASec = 0
			AMin = (AMin / Interval) + Interval
		End If

		If ASec > 0 Then
			ASec = 0
			AMin = AMin + Interval
		End If
	End If
	ADate = TimeSerial(AHour, AMin, ASec)

	GetTime = SetTimeElement(Hour(ADate), Minute(ADate), Second(ADate))
End Function
'-----------------------------------------------------------------------
Function GetTimeJisu(SrcTime, Interval)
	Dim remain
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = CLng(Mid(SrcTime, 1, 2))
	AMin = CLng(Mid(SrcTime, 3, 2))
	ASec = CLng(Mid(SrcTime, 5, 2))

	If Interval = 0 Then '30초간격
		If ASec > 0 Then
			If ASec < 40 Then
				ASec = 30
			Else
				ASec = 0
				AMin = AMin + 1
			End If
		End If
	Else
		If (AMin Mod Interval) > 0 Then
			ASec = 0
			AMin = (AMin / Interval) + Interval
		End If

		If ASec > 0 Then
			ASec = 0
			AMin = AMin + Interval
		End If
	End If

	ADate = TimeSerial(AHour, AMin, ASec)

	GetTimeJisu = SetTimeElement(Hour(ADate), Minute(ADate), Second(ADate))
End Function
'-----------------------------------------------------------------------
Sub ProcSetData(Data, Data2)
	Dim ii, jj, temp, tmpstr
	Dim ArrData, ArrData2
	Dim curdate
	Dim a, b
	ArrData = Split(Data, "|")
	ArrData2 = Split(Data2, "|")

	curdate = S63500.GetGridCell(1, 1)
	curdate = re.Replace(curdate,"")

	If Len(curdate) = 0 Then
		Call send_f()
		Exit Sub
	End If

	If curdate <> nowdate Then
		Exit Sub
	End If

	If S63307.Data = "0" Then
		jj = 2
	Else
		jj = 5
	End If

	If S63308.Data = "1" Then
		jj = jj + 1
	ElseIf S63308.Data = "3" Then
		jj = jj + 2
	End If

	'row가 없을때 생성하도록 설계
	'

	For ii = LBound(g_ArrData) To UBound(g_ArrData)

		If g_ArrData(ii)(1) = Trim(ArrData(0)) Then
			tmpstr = "0"

			If SCREEN.Object("parent.r3_1").Checked Then
				If S63500.Rows > 1 Then
					tmpstr = Trim( S63500.GetGridCell(2, g_ArrData(ii)(2)) )
				Else
					tmpstr = "0"
				End If
				'SYSTEM.Trace "0 tmpstr=["&tmpstr&"]"

				If Len(tmpstr) = 0 Then
					a = 0
				Else
					a = CLng(tmpstr)
				End If

				If Len(ArrData(jj)) = 0 Then
					b = 0
				Else
					b = CLng(ArrData(jj))
				End If

				'SYSTEM.Trace "1 tmpstr=["&b&"]"
				ArrData(jj) = a + b
				'SYSTEM.Trace "2 tmpstr=["&ArrData(jj)&"]"
			End If

			If ArrData(jj) = 0 Then
				ArrData(jj) = ""
			End If

			S63500.SetGridCell 1, g_ArrData(ii)(2), SetSign(ArrData(jj))
		End If
	Next
End Sub

