_AW_ONDECLARE_AW_
Sub init_fcombo()
	Dim FSO, F, ReadData, Dummy, item, ii
	Set FSO = CreateObject("Scripting.FileSystemObject")
	Set F = FSO.OpenTextFile(SYSTEM.Home & "\tab\fjcode.dat", 1)

	ii = 1
	item = ""

	Do While Not F.AtEndOfStream
		ReadData = F.Read(8)
		Dummy = F.Read(41)
		If Len(Trim(ReadData)) > 0 Then
			If Left(ReadData,1) = "1" Then
				item = item & ReadData & ReadData & vbTab
				If ii = 1 Then
					item = ReadData & vbTab & item
				End If
				ii = ii + 1
			End If
		End If
	Loop

	If Len(item) > 0 Then
		S30301.SetItems item
		SCREEN.Send 0
	End If
	F.Close
End Sub

_AW_ONSTART_AW_
Call init_fcombo()

