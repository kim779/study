_AW_ONDECLARE_AW_
Sub GroupComboChange()
	total_order.Data = "0"
	total_chg.Data = "0"
	total_buy.Data = "0"
	total_sell.Data = "0"
	total_trade.Data = "0"
	chg_rate.Data = "0.00"
	tot_fee_sell.Data = "0"
	tot_fee_buy.Data = "0"

	acc_gb.Data = COMBO0.Data
	GRID1.Clear
	GRID0.Clear
	If COMBO0.Data = "1" Then
		send_btn.Enable = False
		grp_no.Data = SCREEN.Object("OBJECT0.Grid0").GetGridCell(COMBO0.Index, 1)
		SCREEN.Object("OBJECT1.grp_no").data = grp_no.Data
		SCREEN.Object("OBJECT1.grp_name").data = SCREEN.Object("OBJECT0.Grid0").GetGridCell(COMBO0.Index, 2)
		OBJECT1.Send
	Else
		send_f()
	End If
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Function Find_Row(acc_no, mtp,code)


	For row = 1 To GRID0.Rows
		If Trim(acc_no) = Trim(GRID0.GetGridCell (row, 2)) _
				And Trim(mtp) = Trim(GRID0.GetGridCell (row, 4)) _
				And Trim(code) = Trim(GRID0.GetGridCell (row, 6)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

_AW_ONSTART_AW_
mng_no.Data = LOGIN.Brno

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0035"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii,jj, Ordqty, chgqty, tOrdqty, tchgqty, chgamt, tBuy, tSell, mmgb, tcolor

If LEDGER.Next = "Y" Then
	Send_c()

Else
	tOrdqty = 0
	tchgqty = 0
	tBuy = 0
	tSell = 0
	For ii=1 To GRID0.Rows
		Ordqty = Trim(GRID0.GetCell(ii, "col9"))
		chgqty = Trim(GRID0.GetCell(ii, "col10"))
		mmgb   = Trim(GRID0.GetCell(ii, "col6"))
		chgamt = Trim(GRID0.GetCell(ii, "col12"))
		If mmgb = "1" Then
			tSell = tSell + CLng(chgamt)
		ElseIf mmgb = "2" Then
			tBuy = tBuy + CLng(chgamt)
		End If

		tOrdqty = tOrdqty + CLng(Ordqty)
		tchgqty = tchgqty + CLng(chgqty)
		'SYSTEM.Trace CStr(ii) & ": "& Ordqty & ", " & tOrdqty

		If Ordqty = "" Then Ordqty = "0"
		If chgqty = "" Then chgqty = "0"

		Call GRID0.SetCell(ii, "col0", CStr(CLng(Ordqty)-CLng(chgqty))) '미체결수량

		If mmgb = "1" Then
			tcolor = 95 '파란색
		Else
			tcolor = 94 '빨간색
		End If

		For jj = 1 To GRID0.Columns
		  Call GRID0.SetTRgb(ii,jj,tcolor)
		Next

	Next
	'SYSTEM.Trace CStr(tOrdqty) & ": "& CStr(tchgqty)
	total_order.Data = CStr(tOrdqty)
	total_chg.Data = CStr(tchgqty)
	total_buy.Data = CStr(tBuy)
	total_sell.Data = CStr(tSell)
	total_trade.Data = CStr(tBuy+tSell)
	If Tordqty <> 0 Then
		chg_rate.Data = FormatNumber((tchgqty/Tordqty*100),2)
	End If


	If COMBO0.Data = "0" Then
		CONTROL0.SetFilterAcc("")
	End If
	Call CONTROL0.SendRaw("LAW|"&mng_no.Data)
	rtime.Data = Time
End If

