pnl_msg.Text = CONTROL0.DataMsg
GRID1.InsertRow 0
Call GRID1.SetGridCell(1,1,CONTROL0.DataMsg)
If (InStr(CONTROL0.DataMsg,"매수")>0) Or (InStr(CONTROL0.DataMsg,"매    수")>0) Then
