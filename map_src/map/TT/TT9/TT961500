_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN15.Name
	h_acnm.Data = AN15.Name
	zPwd.Data = AN15.Password

	If Trim(accn.Data) = "" Then
		accn.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 첫 조회
Sub send_click()
	'SCREEN.ClearAll 0, 2
	'LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'==계좌번호, 비밀번호 체크
Function L_CheckInput(accn, zPwd)
 	L_CheckInput = False
	If Trim(accn.data) = "" Or Len(Trim(accn.data)) < 14 Then
		Call alert_msg("계좌번호를 확인하십시오.")
 		accn.Setfocus
 		Exit Function
	End If

	If Len(Trim(zPwd.data)) = 0 Then
		Call alert_msg("비밀번호를 확인하십시오.")
 		zPwd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zPwd.data)) < 4 Then
			Call alert_msg("비밀번호를 확인하십시오.")
	 		zPwd.Setfocus
	 		Exit Function
		End If
	End If
	L_CheckInput = True
End Function

