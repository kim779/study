'직원/고객에 따른 비밀번호 컨트롤 설정
Call Check_LoginType(zPwd)

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
End If

If L_CheckInput(accn, zPwd) = True Then
	SCREEN.onsend = True
	ANCM.Data = h_acnm.Data
Else
	SCREEN.ClearAll 0, 2
	ANCM.Data = h_acnm.Data
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" And LEDGER.Ecod <> "0136" Then
	Call send_c()
End If

