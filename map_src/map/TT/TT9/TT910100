_AW_ONDECLARE_AW_
varCell = Array(25, 27, 29)

Sub setpage(param)
	ArrData = Split(param, "|")
	CURPAGE.Data = ArrData(0)
	TOTPAGE.Data = ArrData(1)
End Sub

Sub scrchange(param)
    Dim scrtype
    scrtype = param Mod 2
    viewgb.Data = scrtype
    If scrtype = 0 Then
        SCREEN.SetSize 894, 460
        PANEL0.SetRect -2, 30, 896, 462
        PANEL3.SetRect -2, 0, 896, 32
        If daygb.Data = "00" Then
	    	BTN_1.Visible   = False
        	BTN_2.Visible   = True
        	bt_Next.Visible = True
        	bt_Prev.Visible = True
        	LABEL0.Visible  = True
			LABEL1.Visible  = True
			LABEL3.Visible  = True
			LABEL4.Visible  = True
			CURPAGE.Visible = True
			TOTPAGE.Visible = True

	    Else
	    	BTN_1.Visible   = False
			BTN_2.Visible   = False
			bt_Next.Visible = False
			bt_Prev.Visible = False
			LABEL0.Visible  = False
			LABEL1.Visible  = False
			LABEL3.Visible  = False
			LABEL4.Visible  = False
			CURPAGE.Visible = False
			TOTPAGE.Visible = False
	    End If
        LABEL6.Text = "화면확장"
    ElseIf scrtype = 1 Then
        SCREEN.SetSize 1092, 460
        PANEL0.SetRect -2, 30, 1094, 462
        PANEL3.SetRect -2, 0, 1094, 32
        BTN_1.Visible = True
        BTN_2.Visible = False
        LABEL6.Text = "화면축소"
    End If

    OBJECT0.Proc "scrchange", viewgb.Data
    Call p_write_ini()
End Sub

Sub send_f()
	qrgb.Data = "D"
	setparams()
	setmapobj()
	If daygb.Data <> "00" Then
		scrchange(0)
		OBJECT0.Proc "send_f", ""
	Else
		scrchange(viewgb.Data)
	End If
End Sub

Sub send_nxtprv(param)
	qrgb.Data = param
	OBJECT0.Proc "send_f", ""
End Sub

Sub p_write_ini()
    Dim upcd, msgb, vlgb
    If r1.Checked Then
        upcd = "1"
    ElseIf r2.Checked Then
        upcd = "2"
    ElseIf r3.Checked Then
        upcd = "3"
    Else
        upcd = "4"
    End If
    If r1_1.Checked Then
        msgb = "1"
    ElseIf r1_2.Checked Then
        msgb = "2"
    Else
        msgb = "3"
    End If
    If r2_1.Checked Then
		vlgb = "1"
    Else
		vlgb = "2"
    End If
    If SCREEN.CreateObject("Info") Then
        INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "upcd", upcd
        INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "msgb", msgb
        INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "vlgb", vlgb
        INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "viewgubn", viewgb.Data
    End If
End Sub

Sub p_read_ini()
    If SCREEN.CreateObject("INFO") Then
        Dim upcd, msgb, vlgb, viewgubn, gubn
        upcd = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "upcd"))
        msgb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "msgb"))
        vlgb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "vlgb"))
        viewgubn = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "viewgubn"))
        If upcd <> "" Then
            For ii=1 To 4
                If ii = CLng(upcd) Then
                    SCREEN.Object("r"&ii).Checked = True
                Else
                    SCREEN.Object("r"&ii).Checked = False
                End If
            Next
        Else
            For ii=1 To 4
                If ii = 1 Then
                    SCREEN.Object("r"&ii).Checked = True
                Else
                    SCREEN.Object("r"&ii).Checked = False
                End If
            Next
        End If
        If msgb <> "" Then
            For ii=1 To 3
                If ii = CLng(msgb) Then
                        SCREEN.Object("r1_"&ii).Checked = True
                Else
                        SCREEN.Object("r1_"&ii).Checked = False
                End If
            Next
        Else
        For ii=1 To 3
                If ii = 1 Then
                    SCREEN.Object("r1_"&ii).Checked = True
                Else
                    SCREEN.Object("r1_"&ii).Checked = False
                End If
            Next
        End If
        If msgb <> "" Then
            For ii=1 To 3
                If ii = CLng(msgb) Then
                	SCREEN.Object("r1_"&ii).Checked = True
                Else
                    SCREEN.Object("r1_"&ii).Checked = False
                End If
            Next
        Else
	        For ii=1 To 3
                If ii = 1 Then
                    SCREEN.Object("r1_"&ii).Checked = True
                Else
                    SCREEN.Object("r1_"&ii).Checked = False
                End If
            Next
        End If
        If vlgb <> "" Then
            For ii=1 To 2
                If ii = CLng(vlgb) Then
                    SCREEN.Object("r2_"&ii).Checked = True
                Else
                    SCREEN.Object("r2_"&ii).Checked = False
                End If
            Next
        Else
            For ii=1 To 2
                If ii = 1 Then
					SCREEN.Object("r2_"&ii).Checked = True
                Else
                    SCREEN.Object("r2_"&ii).Checked = False
                End If
            Next
        End If
        If viewgubn <> "" Then
			viewgb.Data = viewgubn
        Else
            viewgb.Data = "0"
        End If

		setparams()
		setmapobj()
        scrchange(viewgb.Data)
    End If
End Sub

Sub setmapobj()
	Dim objname, newobjname, mapno
	objname = OBJECT0.GetObject
	If daygb.Data <> "00" Then
		mapno = "07"
		OBJECT0.SetRect 6, 38, 887, 453
	Else
		mapno = dtgb.Data
		OBJECT0.SetRect 6, 38, 1085, 453
	End If
	newobjname = "TT9101" & mapno
	If objname <> newobjname Then
		OBJECT0.SetObject(newobjname)
	End If
End Sub

Sub setparams()
 	Dim datagubn
	If r1.Checked Then
		upgb.Data = "0"
	ElseIf r2.Checked Then
		upgb.Data = "1"
	ElseIf r3.Checked Then
		upgb.Data = "2"
	Else
		upgb.Data = "3"
	End If

	If r1_1.Checked Then
		datagubn = 1
	ElseIf r1_2.Checked Then
	    datagubn = 3
	Else
	    datagubn = 5
	End If

	If r2_2.Checked Then
	    datagubn = datagubn + 1
	End If

	If Len(datagubn) < 2 Then
	    dtgb.Data = "0" & datagubn
	Else
	    dtgb.Data = datagubn
	End If
End Sub

