_AW_ONRECEIVE_AW_
Dim ii
Dim hesum, hcsum, hjsum, htsum

hesum = 0
hcsum = 0
hjsum = 0
htsum = 0

For ii = 1 To GRID0.Rows
	If IsNumeric(GRID0.GetGridCell(ii, 5)) = True Then
		hesum = hesum + CDbl(GRID0.GetGridCell(ii, 5))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 6)) = True Then
		hcsum = hcsum + CDbl(GRID0.GetGridCell(ii, 6))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 7)) = True Then
		hjsum = hjsum + CDbl(GRID0.GetGridCell(ii, 7))
	End If

	If IsNumeric(GRID0.GetGridCell(ii, 9)) = True Then
		htsum = htsum + CDbl(GRID0.GetGridCell(ii, 9))
	End If
Next

	tesum.Data = hesum
	tcsum.Data = hcsum
	tjsum.Data = hjsum
	ttsum.Data = htsum
	


