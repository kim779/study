_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Function Find_Row(acc_no, mtp,code)


	For row = 1 To GRID0.Rows
		If Trim(acc_no) = Trim(GRID0.GetGridCell (row, 2)) _
				And Trim(mtp) = Trim(GRID0.GetGridCell (row, 4)) _
				And Trim(code) = Trim(GRID0.GetGridCell (row, 6)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

Function NumericFormat(str, Length)
	Dim ii, jj
	ii = Len(str)
	For jj=1 To 5-ii
		str = "0" & str
	Next
	NumericFormat = str
End Function

Sub OneStepUp
	Dim ii, row
	row = GRID0.Row
	If row >= 2 Then
		GRID0.InsertRow row-2
		For ii = 1 To GRID0.Columns
			Call GRID0.SetGridCell(row-1, ii, GRID0.GetGridCell(row+1, ii))
		Next
		Call GRID0.RemoveRow(row)
		GRID0.Row = row-1
		GRID0.Index = row-2
	End If
End Sub

Sub OneStepDown
	Dim ii, row
	row = GRID0.Row
	If row < GRID0.Rows Then
		GRID0.InsertRow row+1
		For ii = 1 To GRID0.Columns
			Call GRID0.SetGridCell(row+2, ii, GRID0.GetGridCell(row, ii))
		Next
		Call GRID0.RemoveRow(row-1)
		GRID0.Row = row+1
		GRID0.Index = row
	End If
End Sub

Sub SelectDelete
	If GRID0.Row >= 1 Then
		Call GRID0.RemoveRow(GRID0.Row-1)
	End If
End Sub

