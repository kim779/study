_AW_SCRIPT_AW_(410)
_AW_ONCLICK_AW_

If (S410.HitPos <> 3 ) Then
	Exit Sub
End If
Dim ii

Dim totrows,totcols, currow, curcol
curcol = S410.Column
currow = S410.Row
totrows = S410.Rows
Totcols = S410.Columns

If curcol = 11 Or curcol = 12 Or curcol = 15 Or curcol = 16 Then
	If curcol = 11 Or curcol = 12 Then
		SCREEN.Object("main.ed_focod").Data = Trim(S410.GetGridCell(S410.Row, 1 ))		
		SCREEN.Proc "main.send_sise_left", ""
	Else
		SCREEN.Object("main.ed_focod").Data = Trim(S410.GetGridCell(S410.Row, 17 ))
	End If
	For ii = 1 To S410.Rows	
		S410.SetGridCell ii, 11, ""
		S410.SetGridCell ii, 12, ""
		S410.SetGridCell ii, 15, ""
		S410.SetGridCell ii, 16, ""
		If ii = currow Then
			S410.SetGridCell currow, curcol,  "●"
		End If
	Next
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_


Exit Sub

Dim ls_temp
Dim ls_codx, col

ls_temp = S410.HitPos

If (ls_temp <> 3 ) Then
	Exit Sub
End If


col = S410.Column

If col = 8 Then
	Exit Sub
End If

If col < 8 Then
	ls_codx = Trim(S410.GetGridCell(S410.Row, 1 ))
	If Trim(ls_codx) = "" Then
		Exit Sub
	End If
	S40301.Data = ls_codx
	S40301.Trigger "40301", True
	S40301.Trigger "ed_focod", True
	SYSTEM.SetHistory "40301", ls_codx
	SYSTEM.SetHistory "ed_focod", ls_codx
	SCREEN.CreateWindow 1, "HD741200 /S/d", "ed_focod"&vbTab&ls_codx

ElseIf col > 9 Then
	ls_codx = Trim(S410.GetGridCell(S410.Row, 10))
	If Trim(ls_codx) = "" Then
		Exit Sub
	End If
	S40301.Data = ls_codx
	S40301.Trigger "40301", True
	S40301.Trigger "ed_focod", True
	SYSTEM.SetHistory "40301", ls_codx
	SYSTEM.SetHistory "ed_focod", ls_codx
	SCREEN.CreateWindow 1, "HD741200 /S/d", "ed_focod"&vbTab&ls_codx
End If
