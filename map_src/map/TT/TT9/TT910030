_AW_SCRIPT_AW_(LISTGRID)
_AW_ONDBLCLK_AW_
' Row가 -1이면 조회할 필요 없음.
If  LISTGRID.Row <> -1 Then

	' 확인된 사항이면 수정 금지하도록 한다.
	If LISTGRID.GetCell( LISTGRID.Row, "chck" )="Y" Then
		SCREEN.Object("Object0.memo").Enable = False
		title.Enable = False
	Else
		SCREEN.Object("Object0.memo").Enable = True
		title.Enable = True
	End If

	' 본문조회키를 세팅한다.
	SCREEN.Object("Object0.ckey").Data = LISTGRID.GetGridCell( LISTGRID.Row, 11 )
	SCREEN.Object("Object1.ckey").Data = LISTGRID.GetGridCell( LISTGRID.Row, 11 )
	title.text = Trim(LISTGRID.getgridcell(LISTGRID.Row, 3))
	SCREEN.Object("object1.cust_id").data = Trim(LISTGRID.getgridcell(LISTGRID.Row, 6))
	OBJECT0.Send
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


