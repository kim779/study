		Else
			name = SCREEN.GetName(108, focod.data, 0)'주식옵션
		End If
	End If

	If Trim(name) = "" Then
		HNAM.Data = ""
		focod.Data = ""
		Exit Sub
	End If
	HNAM.Data = name
