_AW_ONDECLARE_AW_
Sub Map_OpenSize()
	Dim msize, xy
	If SCREEN.CreateObject("INFO") = False Then
		Exit Sub
	End If

	msize = INFO.PopData(LOGIN.Name, "userconf.ini", "MAPSIZE", SCREEN.GetMapName(1))
	If Trim(msize) <> "" Then
		xy = Split(msize, ",")
		SCREEN.SetSize xy(0), xy(1)
		S17412.HogaType xy(2)
		S17412.Refresh
		BTN_HS.Visible	Mid(xy(3),1,1)
		BTN_HM.Visible	Mid(xy(3),2,1)
		BTN_WS.Visible  Mid(xy(3),3,1)
	 	BTN_WM.Visible  Mid(xy(3),4,1)
 	End If
End Sub

Sub Push_OpenSize(xval, yval, hogb, btn)
	Dim msize
	If SCREEN.CreateObject("INFO") = False Then
		Exit Sub
	End If

	msize = xval &","& yval &","& hogb &","& btn
	INFO.PushData LOGIN.Name, "userconf.ini", "MAPSIZE", SCREEN.GetMapName(1), msize
End Sub

Sub change_bg()
	SCREEN.SetTimer 80, True     ' 1초후에 Main화면의 OnTimer 수행
End Sub

Sub OnAlert()
	Dim var
	If Trim(S2027.Data) = "" Then
		Exit Sub
	End If

	If Trim(S2027.Data) = 0 Then
		Exit Sub
	End If

	If Trim(S2321.Data) = "" Then
		Exit Sub
	End If

	If Trim(S2321.Data) = 0 Then
		Exit Sub
	End If

	var = S2027.Data / S2321.Data * 100
	S2403.Data = FormatNumber(var, 2)
	
'전일종가대비 시가 고가 저가 비율
If Trim(S2320.Data) = "" Or Trim(S2320.Data) > 0 Then

	If Trim(S2029.Data) = "" Then
		Exit Sub
	End If

	If Trim(S2030.Data) = "" Then
		Exit Sub
	End If

	If Trim(S2031.Data) = "" Then
		Exit Sub
	End If

	si_rate.Data = FormatNumber(((S2029.Data - S2320.Data) / S2320.Data) * 100, 2, 0, 0, 0)
	go_rate.Data = FormatNumber(((S2030.Data - S2320.Data) / S2320.Data) * 100, 2, 0, 0, 0)
	jeo_rate.Data = FormatNumber(((S2031.Data - S2320.Data) / S2320.Data) * 100, 2, 0, 0, 0)

	If Trim(si_rate.Data) > 0 Then
		si_rate.TRgb = "94"
	End If

	If Trim(go_rate.Data) > 0 Then
		go_rate.TRgb = "94"
	End If

	If Trim(jeo_rate.Data) > 0 Then
		jeo_rate.TRgb = "94"
	End If
End If

End Sub

