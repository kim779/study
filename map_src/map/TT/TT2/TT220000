	   "016" & vbTab & key_value & vbLf & "1301" & vbTab & SCREEN.Object("main.1301").Data

SCREEN.CreateWindow 4, "IBNEWSXX /S/d/p1", dmsg

'제목 클릭하면 카운트 0, Y 설정
'뉴스가 오면 Y
