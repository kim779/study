'선물 직전월물 만기일+1  (= 현재 최근월물의 시작일)
Sub Check_date()
	Dim yy, mm, dd

	yy = Year(Date)
	Select Case Month(Date)
		Case 1, 2, 3
			yy = yy - 1 : mm = "12"
		Case 4, 5, 6 : mm = "03"
		Case 7, 8, 9 : mm = "06"
		Case 10, 11, 12 : mm = "09"
	End Select

	dd = 16 - Weekday(yy&"-"&mm&"-"&"01", vbFriday)
	If Len(dd) = 1 Then dd = "0"&dd
	x_day = yy&mm&dd
	S63311.Data = x_day
End Sub

Sub Check_date1()
	t_day = EDIT0.data

	yy = Mid(t_day, 1, 4)
	mm = Mid(t_day, 5, 2)
	dd = Mid(t_day, 7, 2)
	x_day = yy & "-" & mm & "-" & dd
	If IsDate(x_day) = False Then
		Exit Sub
	End If

	x_day = DateSerial(yy-1, mm, dd)
	yy = Year(x_day)
	mm = Month(x_day)
	If Len(mm) = 1 Then mm = "0"&mm
	dd = Day(x_day)
	If Len(dd) = 1 Then dd = "0"&dd
	x_day = yy&mm&dd
	S63311.Data = x_day
End Sub

