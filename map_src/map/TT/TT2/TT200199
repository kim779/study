_AW_ONDECLARE_AW_
'***************************************************************************************************
'c_wqty : 미체결(Working Order),  c_dqty : 체결수량 (Deal Order), c_kqty : 취소수량 (Kill Order)
'***************************************************************************************************
Const HP_ITEM  = 3
'미니
Const MD_MAP	= "DH112100/t/S/p5/d"
Const MS_MAP	= "DH112200/t/S/p5/d"

'Const c_jmno = 3, c_ojno = 4, c_code = 5, c_hnam = 6, c_jmgb = 7, c_hogb = 8, c_accn = 1
'Const c_jprc = 9, c_jqty = 10 ,c_dqty = 13, c_dprc = 12, c_wqty = 14, c_stat = 15

Sub OnNotice()
Dim r_stat, r_jmno, r_ojno, row_F, row_O
	r_stat = Trim(RTSGRID.GetGridCell(1, 11))					' 접수구분
	r_jmno = Trim(RTSGRID.GetGridCell(1, 2))						' 주문번호
	r_ojno = Trim(RTSGRID.GetGridCell(1, 3))						' 원주문번호

	If Right(Trim(RTSGRID.GetGridCell(1, 1)), 2) <> "21" Then
		Exit Sub
	End If

	If InStr(r_stat,"접수") > 0 Then									' 기본셋팅
		Call RTSGRID.SetGridCell (1,13, "0")
		Call RTSGRID.SetGridCell (1,14, "0")
	ElseIf r_stat = "거부" Or r_stat = "접수오류" Then
		Call RTSGRID.SetGridCell (1, 13, "0")
		Call RTSGRID.SetGridCell (1, 14, "0")
	End If

	If VIEWGRID.Rows = 0 Then				' VIEWGRID가 empty일 경우
		VIEWGRID.InsertRow 0
		Update_Row(1)
		RTSGRID.RemoveRow 0
		Exit Sub
	End If

	row_F = Find_Row(r_jmno)
	If row_F > 0 Then
		If r_stat = "체결" Then
			Call Modify_dqty(RTSGRID.GetGridCell(1, 13), row_F)
			RTSGRID.RemoveRow 0
			Exit Sub
		ElseIf r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
			If row_O > 0	Then
					Modify_wqty(row_O)
			End If

			VIEWGRID.SetCell row_F, "c_wqty", Trim(RTSGRID.GetGridCell(1, 8))						' 미체결수량
			VIEWGRID.SetCell row_F, "c_stat", Trim(RTSGRID.GetGridCell(1,11))						' 접수구분
			RTSGRID.RemoveRow 0
			Exit Sub
		ElseIf r_stat = "거부" Or r_stat = "접수오류" Then

		ElseIf InStr(r_stat,"접수") > 0 Then

		Else
			RTSGRID.RemoveRow 0
			Exit Sub
		End If
	Else			' 주문번호 일치하는 row가 없는경우
		If r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
			If row_O > 0	Then
					Modify_wqty(row_O)
			End If
			Call RTSGRID.SetGridCell (1, 13, "0")
			Call RTSGRID.SetGridCell (1, 14, "0")
		End If
		VIEWGRID.InsertRow 0
		row_F = 1
	End If
	Update_Row(row_F)
	RTSGRID.RemoveRow 0
End Sub

'****************************************************************************************************************************
' DESC :  Help Funtion
'****************************************************************************************************************************
Sub Modify_dqty(amt, row_F)
	Dim amt_T, t_dprc
	amount = Trim(VIEWGRID.GetCell (row_F, "c_dqty"))													' 체결수량
	If amount = "" Then
		amount = "0"
	End If
	amount = CDbl(amount) + CDbl(amt)
	Call VIEWGRID.SetCell (row_F, "c_dqty", amount)
	Call VIEWGRID.SetCell (row_F, "c_stat", Trim(RTSGRID.GetGridCell(1,11)))					' 처리구분
	Call VIEWGRID.SetCell (row_F, "c_wqty", Trim(RTSGRID.GetGridCell(1,8)))						' 미체결수량

	If Trim(RTSGRID.GetGridCell(1, 14)) <> "" Then
		t_dprc = Trim(CDbl(RTSGRID.GetGridCell(1, 14))/100)
		t_dprc = FormatNumber(t_dprc, 2)
		Call VIEWGRID.SetCell (row_F, "c_dprc", t_dprc)	' 체결가격
	End If
End Sub

Sub Modify_wqty(row)
	Dim h_qty
	h_qty = RTSGRID.GetGridCell (1, 13)											' 정정/취소 확인수량
	If Trim(VIEWGRID.GetCell (row, "c_wqty")) <> "" Then
		h_qty = CDbl(VIEWGRID.GetCell (row, "c_wqty")) - h_qty
	Else
		h_qty = "0"
	End If

	Call VIEWGRID.SetCell (row, "c_wqty", h_qty)
End Sub

Function Find_Row(jm_num)														' 주문번호/원주문번호가 일치하는 Row Return
	For row = 1 To VIEWGRID.Rows
		If Trim(RTSGRID.GetGridCell (1, 1)) = Trim(VIEWGRID.GetCell (row, "c_accn")) Then
			If Trim(jm_num) = Trim(VIEWGRID.GetCell(row, "c_jmno")) Then
				Find_Row = row
				Exit Function
			End If
		End If
	Next
	Find_Row = 0
End Function

Sub Update_Row(row)																' 해당 Row에 Update Row
		VIEWGRID.SetCell row, "c_accn", Trim(RTSGRID.GetGridCell(1, 1))				' 계좌번호
		VIEWGRID.SetCell row, "c_jmno", Trim(RTSGRID.GetGridCell(1, 2))			' 주문번호
		VIEWGRID.SetCell row, "c_ojno", Trim(RTSGRID.GetGridCell(1, 3))			' 원주문번호
		VIEWGRID.SetCell row, "c_code", Trim(RTSGRID.GetGridCell(1, 4))			' 종목코드
		VIEWGRID.SetCell row, "c_hnam", Trim(RTSGRID.GetGridCell(1, 5))			' 종목명
		VIEWGRID.SetCell row, "c_wqty", Trim(RTSGRID.GetGridCell(1, 8))			' 미체결수량
		VIEWGRID.SetCell row, "c_dqty", Trim(RTSGRID.GetGridCell(1, 13))			' 체결수량
		VIEWGRID.SetCell row, "c_dprc", Trim(RTSGRID.GetGridCell(1, 14))			' 체결가격
		VIEWGRID.SetCell row, "c_jqty", Trim(RTSGRID.GetGridCell(1, 9))			' 주문수량
		VIEWGRID.SetCell row, "c_jprc", Trim(RTSGRID.GetGridCell(1, 10))			' 주문단가
		VIEWGRID.SetCell row, "c_stat", Trim(RTSGRID.GetGridCell(1,11))			' 접수구분

		If Trim(RTSGRID.GetGridCell(1, 7)) <> "" Then									' 호가구분
			VIEWGRID.SetCell row, "c_hogb", Trim(RTSGRID.GetGridCell(1, 7))
			VIEWGRID.SetCell row, "c_htmp", Get_hogb(Trim(RTSGRID.GetGridCell(1, 7)))
		End If

		Dim ho, ogin
		If Trim(RTSGRID.GetGridCell(1, 6)) <> "" Then							' 주문구분
			ogin = Trim(RTSGRID.GetGridCell(1, 6))
			ho = Left(ogin, 2)
			Select Case ho
				Case "매수"
					ogin = "+" & ogin
					color = 94
				Case "매도"
					ogin = "-" & ogin
					color = 95
				Case Else
					Exit Sub
			End Select
			VIEWGRID.SetCell row, "c_jmgb", ogin
		End If

End Sub

'***************************************************************
'주문유형 (char -> string)
'***************************************************************
Function Get_hogb(hogb)
	Select Case hogb
		Case "L", "00"
			Get_hogb = "지정가"
		Case "M", "03"
			Get_hogb = "시장가"
		Case "C", "05"
			Get_hogb = "조건부"
		Case "B", "06"
			Get_hogb = "최유리"
		Case Else
			Get_hogb = ""
	End Select
End Function

'***************************************************************
'연속여부 확인
'***************************************************************
Function P_IsNext()
	If SYSTEM.SystemID = "H" Then				'하나증권
		If LEDGER.contf = "1" Then
			P_isNext = True
			Exit Function
		End If
	Else												'대투증권
		If LEDGER.TrContYn = "1" Then
			P_isNext = True
			Exit Function
		End If
	End If
	P_isNext = False
End Function

