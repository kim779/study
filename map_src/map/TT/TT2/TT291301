sdate.Data = SCREEN.Object("main.sdate").Data
edate.Data = SCREEN.Object("main.edate").Data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
GRID0.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim code
If GRID0.HitPos = 3 Then
	If GRID0.Column >= 2 And GRID0.Column <=4 Then
		code = GRID0.GetGridCell(GRID0.Row, 2)
	ElseIf GRID0.Column >= 5 And GRID0.Column <=7 Then
		code = GRID0.GetGridCell(GRID0.Row, 5)
	End If

	If Trim(code) <> "" Then
		SCREEN.Object("main.1301").Data = code
		SCREEN.Object("main.1301").Trigger "", True
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


