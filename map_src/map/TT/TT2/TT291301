_AW_ONDECLARE_AW_
Sub send_f()
	GRID0.Clear
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
If SCREEN.Object("main.r_all").Checked Then
	sjgb.Data = "0"
ElseIf SCREEN.Object("main.r_kospi").Checked Then
	sjgb.Data = "1"
Else
	sjgb.Data = "9"
End If

