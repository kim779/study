Sub SetStaticDataOnly()
	arrangeOK.Data = 0
End Sub

Sub setArrangeOnly(data)

	Dim temp(100,2), field, count, ii, jj, strTemp, firstword

	arrangeOK.Data = 1

	For ii=0 To 100
		For jj=0 To 2
			temp(ii,jj) = ""
		Next
	Next

	If data = "01" Then
		field = 22				'업종코드
	ElseIf data = "02" Then
		field = 6				'종목명
	ElseIf data = "03" Then
		field = 2				'종목코드
	Else
		Exit Sub
	End If

	count = 0

	'데이터 수신
	For ii=1 To S90303.Rows
		If Trim(S90303.GetGridCell(ii,2)) <> "" Then

			temp(count,0) = Trim(S90303.GetGridCell(ii,2))

			If field = 6 Then
				firstword = Trim(Left(S90303.GetGridCell(ii,field),1))
				If firstword = "!" Or firstword = "/" Or firstword = "$" Or firstword = "%" Or firstword = "&" Or firstword = "@" Or firstword = "X" Then
					temp(count,1) = Mid(Trim(S90303.GetGridCell(ii,field)),2)
				Else
					temp(count,1) = Trim(S90303.GetGridCell(ii,field))
				End If
			Else
				temp(count,1) = Trim(S90303.GetGridCell(ii,field))
			End If

			count = count + 1

		End If
	Next

	count = count - 1

	For ii=0 To count
		SYSTEM.Trace "temp(" & ii & ")(0) : " & temp(ii,0) & " (1) : " &  temp(ii,1)
	Next

'	S90303.Clear
'	SCREEN.Object("OBJ1.90303").Clear

	'정렬
	For ii=0 To count-1
		For jj=ii+1 To count
			If temp(ii,1) > temp(jj,1) Then
				strTemp = temp(ii,0)
				temp(ii,0) = temp(jj,0)
				temp(jj,0) = strTemp

				strTemp = temp(ii,1)
				temp(ii,1) = temp(jj,1)
				temp(jj,1) = strTemp
			End If
		Next
	Next

	count = 0

	'재배치
	For ii=1 To S90303.Rows
		S90303.SetGridCell ii,2, temp(count,0)
		count = count + 1
	Next

	SCREEN.Send 0
End Sub


Sub OnPortfolio(confirm)
	Dim groupNames, parseData, Items, codelist, row, countGroup

	SYSTEM.Trace "reduce_start"

	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If
	If UCase(confirm) <> "OK" And UCase(confirm) <> "START" Then
		Exit Sub
	End If

	Items = ""
	DX_INTEREST.SetUserName(LOGIN.Name)
	groupNames = DX_INTEREST.LoadGroupNames()


	countGroup = 0
	Do While Len(groupNames) > 0
		parseData = Mid(groupNames, 1, InStr(groupNames, vbTab) -1)
		groupNames = Mid(groupNames, InStr(groupNames, vbTab) + 1)
		Items = parseData & vbTab & Items
		countGroup = countGroup + 1
	Loop

	'계좌 보유종목 조회
	If countGroup < 100 Then
		Items = "00 보유종목" & vbTab & Items
	End If


	If Items = "" Then
		intercombo.SetItems("")
	Else
		intercombo.SetItems(vbTab & Items)
	End If

	Call p_read_com()
'	intercombo.Data = SYSTEM.Pop("cxPortfolioItem")
'	SCREEN.Proc "OBJ1.OnGroup", intercombo.Data

	'Call OnGroup(intercombo.Data)

	CONTROL0.OnPortfolio confirm
	CONTROL0.ChangeGroup intercombo.Data
End Sub

Sub SyncComboBox()

	If SCREEN.Object("main.tab_tuja").ID <> 0 Then
		Exit Sub
	End If

	If intercombo.Data <> SCREEN.Object("main.OBJ_tuja.intercombo").Data Then
		SCREEN.Object("main.OBJ_tuja.intercombo").data = intercombo.Data
	End If
End Sub

Sub OnGroup(group)
	S90303.Clear()
	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If

	If Trim(group) <> "" Then
		If InStr(group, "00") > 0 Then
			SCREEN.SetTimer 4, False
		Else
			codelist = DX_INTEREST.LoadCodeList(group)
			row = 1
			Do While Len(codelist) > 0
				parseData = Mid(codelist, 1, InStr(codelist, vbTab) -1)
				codelist = Mid(codelist, InStr(codelist, vbTab) + 1)
				S90303.InsertRow(-1)
				S90303.SetGridCell S90303.rows, 2, parseData
	'			S90303.SetGridCell row, 2, parseData
				row = row + 1
			Loop
			SCREEN.Send 0
		End If
	End If
End Sub

Sub OnPredict(bNowPrice)
	If bNowPrice = "0" Then
		predict = True
	Else
		predict = False
	End If
	S90303.SetColumnVisible 8, predict
	S90303.SetColumnVisible 10, predict
	S90303.SetColumnVisible 12, predict
    S90303.SetColumnVisible 14, predict

	S90303.SetColumnVisible 7, Not predict
	S90303.SetColumnVisible 9, Not predict
	S90303.SetColumnVisible 11, Not predict
    S90303.SetColumnVisible 13, Not predict
End Sub

Sub p_read_com()
	If SCREEN.CreateObject("Info") Then
		SYSTEM.Trace "!!!!!!!reduce::read file : " & Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP"))
	 	Dim data
	 	data = Trim(INFO.PopData(LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP"))
		If data = "" Then
			intercombo.Data = "01"
		Else
			intercombo.Data = data
		End If
		SYSTEM.Trace "!!!!!!!reduce::read combo: " & intercombo.Data
	End If
End Sub

Sub p_write_com()
	If SCREEN.CreateObject("Info") Then
		SYSTEM.Trace "reduce::write : " & intercombo.Data
	  INFO.PushData LOGIN.Name, "intercfg.ini", "MAIN", "SELECTGROUP_MAP", intercombo.Data
	End If
End Sub

