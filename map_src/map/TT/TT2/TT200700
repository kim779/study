'-----------------------------------------------------------------------
Sub SetDate(StrDate)
	S11309.Data = StrDate
	SYSTEM.Trace StrDate & "|"
End Sub
'-----------------------------------------------------------------------
Function GetToday()
	YY = Year(Date)
	MM = Month(Date)
	If Len(MM) = 1 Then
		MM = "0" & MM
	End If
	DD = Day(Date)
	If Len(DD) = 1 Then
		DD = "0" & DD
	End If
	GetToday = YY & MM & DD
End Function
'-----------------------------------------------------------------------
Sub Onalert()
	If is_real.Checked = False Then
		Exit Sub
	End If
End Sub
'-----------------------------------------------------------------------
Sub IsReal_check()
	If is_real.Checked = False Then
		SCREEN.Object("obj0.1301").Clear
		SCREEN.Object("obj0.1021").Clear

		count = 0
	Else
		SCREEN.Object("obj0.1301").Data = S1301.Data
		SCREEN.Object("obj0.1021").Data = "A" + S1301.Data

		'ELW인지 주식종목인지 구별
		If Trim(S1301.Data) <> "" Then

			If IsNumeric(Left(Trim(S1301.Data), 1)) = False Then
				Exit Sub
			End If

			If Left(Trim(S1301.Data), 1) < 5 Or Left(Trim(S1301.Data), 1) > 8 Then
				SCREEN.Object("obj0.1021").Data = "A" + S1301.Data
			Else
				SCREEN.Object("obj0.1021").Data = "J" + S1301.Data
			End If
		End If

		If count = 0 Then

			SCREEN.Send 0
			count = 1
		End If
	End If
End Sub

