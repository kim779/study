_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.SetFocus

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, masu, mado, sum, tColor

For ii = 1 To S30000.Rows
	masu = Trim(S30000.GetGridCell(ii, 5))
	mado = Trim(S30000.GetGridCell(ii, 6))
	sum = 0

	If masu <> "" And mado = "" Then
		sum = masu
	ElseIf masu = "" And mado <> "" Then
		sum = "-" & mado
	End If

	S30000.SetGridCell ii, 7, sum

	If CCur(sum) > 0 Then
		tColor = "94"
	ElseIf CCur(sum) < 0 Then
		tColor = "95"
	End If

	S30000.SetTrgb ii, 7, tColor
Next

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SYSTEM.Trace "ontimer data="&TRAD.Data&" text="&TRAD.Text&" domino="&tradcd.Data
If Trim(tradcd.Data) <> "" Then
TRAD.Data = tradcd.Data
End If
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(30000)
_AW_ONCLICK_AW_
Select Case S30000.HitPos
Case 2
	If GUBN.Data <> "1" Then
		Exit Sub
	End If
	GUBN.Data = "N"
	S30000.Column = 2
	S30000.Row = 1
	SDAY.Data = S30000.Cell
	S30000.Row = S30000.Rows
	EDAY.Data = S30000.Cell
	S30000.SetDataPosition 2
Case 6
