		Exit Sub
	End If
	GUBN.Data = "N"
	S30000.Column = 2
	S30000.Row = 1
	SDAY.Data = S30000.Cell
	S30000.Row = S30000.Rows
	EDAY.Data = S30000.Cell
	S30000.SetDataPosition 2
Case Else
	Exit Sub
End Select
SCREEN.Send 2
Exit Sub
