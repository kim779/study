_AW_SCRIPT_AW_(newsViewBtn)
_AW_ONCLICK_AW_
If news_output.Visible = True Then
	'클릭시 뉴스 전문보기
	Dim	key_value, key_text, dmsg
	key_value = Trim(keyv_temp.Data)

	If Trim(key_value) = "" Then
		newsViewBtn.Visible = False
		news_output.Visible = False
		new_news.Text = "N"
		Exit Sub
	End If

	key_text = Trim(news_output.Data)

	If Trim(key_text) = "" Then
		newsViewBtn.Visible = False
		news_output.Visible = False
		new_news.Text = "N"
		Exit Sub
	End If

	key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.

	dmsg = "015" & vbTab & key_text & vbLf &_
		   "016" & vbTab & key_value & vbLf & "1301" & vbTab & SCREEN.Object("main.1301").Data

	SCREEN.CreateWindow 4, "IBNEWSXX /S/d/p1", dmsg

	'제목 클릭하면 카운트 0, Y 설정
	'뉴스가 오면 Y
	newsViewBtn.Visible = False
	news_output.Visible = False
	new_news.Text = "N"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


