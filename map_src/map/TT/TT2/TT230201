RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
End Sub

Dim old_time
old_time = 0

'거래원 실시간 처리
Sub Onalert()
	Dim code, rcod, gtime, rtime
	code = Trim(SCREEN.Object("PARENT.1301").Data)
	rcod = Trim(S192.Data)

	'종목별검색
	If code <> "" Then
		If rcod <> code Then
			Exit Sub
		End If
	End If

	'회원별검색: 외국계합(888)이 아닐땐 거래원코드비교, 888일땐 거래원명 비교
	If TRAD.Data = "888" Then
		If Mid(Trim(S191.Data), 1, 1) <> "+" Then
			Exit Sub
		End If
	Else
		If S190.Data <> TRAD.Data Then
			Exit Sub
		End If
	End If

	gtime = Trim(GRID.GetGridCell(1, 1))
	rtime = Trim(S194.Data)


	If Is_numeric(gtime) = False Or Is_numeric(rtime) = False Then
		Exit Sub
	End If

	If Len(rtime) < 6 Then
		Exit Sub
	End If

	If CDbl(rtime) > 180000 Then
		Exit Sub
	End If


	If CDbl(rtime) >= CDbl(old_time) Then
		GRID.InsertRow(0)
		GRID.SetGridCell 1, 1, S194.Data
		GRID.SetGridCell 1, 2, S192.Data
		GRID.SetGridCell 1, 3, S193.Data
		GRID.SetGridCell 1, 4, Replace(S191.Data, "+", " ")

		GRID.SetGridCell 1, 5, S196.Data
		GRID.SetGridCell 1, 6, S195.Data
		GRID.SetGridCell 1, 7, S200.Data

		old_time = rtime
	End If
End Sub

_AW_ONINDECLARE_AW_
#load DH888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
TRAD.Data = SCREEN.Object("PARENT.TRAD").Data
CODX.Data = Trim(SCREEN.Object("PARENT.1301").Data)

If TRAD.Data = "888" Then
	CHKF.Data = "1"

	GRID.SetColumnVisible 4, True
	GRID.SetColumnWidth 5, 54
	GRID.SetHead 5, "매도량"
	GRID.SetColumnWidth 6, 54
	GRID.SetHead 6, "매수량"
	GRID.SetColumnWidth 7, 68

Else
	CHKF.Data = "2"

	GRID.SetColumnVisible 4, False
	GRID.SetColumnWidth 5, 80
	GRID.SetHead 5, "매도수량"
	GRID.SetColumnWidth 6, 80
	GRID.SetHead 6, "매수수량"
	GRID.SetColumnWidth 7, 86
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, jongmok, sec

For ii=1 To GRID.Rows
	jongmok = Trim(GRID.GetGridCell(ii, 3))
	GRID.SetGridCell ii, 3, jongmok

	sec = Trim(GRID.GetGridCell(ii, 4))
	GRID.SetGridCell ii, 4, sec
Next


