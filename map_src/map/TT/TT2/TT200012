'***************************************************************************
Sub Set_account()
	SCREEN.Object("parent.guide").text = ""
	ACNM.Data = AN10.name
	pswd.Data = AN10.Password
	SCREEN.Proc "main.Set_account", "account"
	If Trim(pswd.Data) <> "" Then
		Call first_send()
	Else
		VIEWGRID.Clear
	End If
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Error_check = False
	If Trim(AN10.Data) = "" Then
		MsgBox "계좌번호를 확인하세요", , "조회에러"
		Exit Function
	End If
	If Trim(pswd.Data) = "" Then
		MsgBox "비밀번호를 확인하세요", , "조회에러"
		pswd.SetFocus
		Exit Function
	End If
	Error_check = True
End Function

Sub GRID_click(status)
	Dim jqty, tab_id, jprc, mvol, mgbn, ogno

	If status = "click" And VIEWGRID.HitPos <> 3 Then
		Exit Sub
	End If

	code = Mid(Trim(VIEWGRID.GetGridCell(VIEWGRID.row, c_code)), 2, 6)	'종목코드
	If Trim(code) = "" Then
	    Exit Sub
	End If

	SCREEN.Proc "parent.send_sise", "account" & "," & code

	tab_id = SCREEN.Object("parent.tab_order").id
	If tab_id < 3 Then		'매수/매도
		SYSTEM.push "S_ogno", ""
		SYSTEM.push "S_jprc", ""
		VIEWGRID.SetFocus
		Exit Sub
	End If

	mvol = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, c_wqty))		'미체결수량
	jprc = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, c_jprc))		'체결단가
	mgbn = Is_numeric(mvol)

	If mgbn = True Then				'미체결주문
		ogno = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, c_jmno))		'주문번호
		SCREEN.Object("parent.obj_order.o_jmno").clear				'기존 주문번호 clear
	End If

	SYSTEM.Push "S_ogno", ogno
	SYSTEM.Push "S_jprc", jprc
	SCREEN.Object("parent.obj_jumn.ed_jqty").data = mvol				'미체결수량

	SCREEN.Proc "main.obj_jumn.Get_jmno", ""
	SCREEN.SetTimer 1, False
End Sub

