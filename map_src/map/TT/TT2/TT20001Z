'-----------------------------------------------------------------------
Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim ArrCols, i
		ArrCols = Array("", "", "", "")

		For i = LBound(ArrCols) To UBound(ArrCols)
			Dim tmpCol
			tmpCol = "col" & Trim(i + 17)

			INFO.PushData LOGIN.Name, "userconf.ini", "IB200090", tmpCol, S90303.GetHead(i + 17)
		Next
	End If
End Sub
'-----------------------------------------------------------------------
Sub p_read_ini()
	Dim ArrCols, i, HeadData, chk
	chk = 0
	If SCREEN.CreateObject("INFO") = True Then
		ArrCols = Array("", "", "","")

		For i = LBound(ArrCols) To UBound(ArrCols)
			Dim tmpCol
			tmpCol = "col" & Trim(i + 17)

			If Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB200090", tmpCol)) <> "" Then
				ArrCols(i) = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB200090", tmpCol))
			Else
				chk = 1
			End If
		Next

		If chk = 0 Then
			For i = LBound(ArrCols) To UBound(ArrCols)
				S90303.SetHead i + 17, ArrCols(i)
			Next
		Else
			Call Set_standard()
		End If
	End If
End Sub
'-----------------------------------------------------------------------
Sub SetItems()
	Dim i, j, HeadData, PrcFlag, PrgFlag

	For i = 17 To 20
		HeadData = S90303.GetHead(i)

		For j = LBound(g_ArrData) To UBound(g_ArrData)
			If HeadData = g_ArrData(j)(0) Then
				g_ArrItems(i - 17).Data = g_ArrData(j)(3)
				Exit For
			End If
		Next
	Next
End Sub

