Sub OnGroup(group)
	S90303.Clear()
	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If

	If Trim(group) <> "" Then
		codelist = DX_INTEREST.LoadCodeList(group)
		row = 1
		Do While Len(codelist) > 0
			parseData = Mid(codelist, 1, InStr(codelist, vbTab) -1)
			codelist = Mid(codelist, InStr(codelist, vbTab) + 1)
			S90303.InsertRow(-1)
			S90303.SetGridCell S90303.rows, 2, parseData
'			S90303.SetGridCell row, 2, parseData
			row = row + 1
		Loop
		p_read_ini
		SCREEN.Send 0
	End If
End Sub

