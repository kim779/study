RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MAX_ROWS = 50
Const HP_ITEM  = 3
'미니
'Const MD_MAP	= "DH012200/t/S/p5/d"
'Const MS_MAP	= "DH012100/t/S/p5/d"
'통합
Const MD_MAP	= "DH010100/t/S/p5/d"
Const MS_MAP	= "DH010100/t/S/p5/d"

Const jmno = 2, ojno = 3, hnam = 4, jmgb = 5, hogb = 6, jprc = 7, jamt = 8 ,camt = 10, stat = 12, code = 14
Const c_chk = 1, c_code = 2, c_hnam = 3, c_msgb = 4, c_aprc = 6, c_xqty = 6, c_curr = 8

'***************************************************************************
'	Func : run_xorder
'***************************************************************************
Sub run_xorder

Dim s_data, accn, pswd
num.Data = 0

accn = SCREEN.Object("parent.OBJ1.AN21").data
pswd = Trim(SCREEN.Object("parent.OBJ1.pswd").data)
For ii = 1 To VIEWGRID.Rows
	If VIEWGRID.GetGridCell(ii ,1) = 1 Then
		If CDbl(num.Data) = MAX_ROWS Then Exit For
		If Trim(pswd) = "" Then Exit For

		s_data = "#" &s_data
		s_data = VIEWGRID.GetGridCell(ii , c_msgb) & "|" & s_data		' 7 주문구분
		s_data = VIEWGRID.GetGridCell(ii , c_curr) & "|" & s_data		' 6 주문가
		s_data = VIEWGRID.GetGridCell(ii , c_xqty) & "|" & s_data		' 5 주문가능수량
		s_data = VIEWGRID.GetGridCell(ii , c_hnam) & "|" & s_data		' 4 종목명
		s_data = VIEWGRID.GetGridCell(ii , c_code) & "|" & s_data		' 3 종목코드
		s_data = pswd & "|" & s_data									' 2 비밀번호
		s_data = accn & "|" & s_data									' 1 계좌번호

		num.Data = num.Data + 1
	End If
Next

If num.Data > 0 Then
	num.Push ""
	SCREEN.CreateWindow 2, "DH720302 /t/s/p?/d", "s_data" & vbTab & s_data
	cls_check
End If

End Sub

'***************************************************************************
'	Func : All check
'***************************************************************************
Sub all_check()
	Dim cnt
	cnt = 0
	If Trim(VIEWGRID.GetGridCell(1,1)) <> "" Then
		If C_all.Checked = True Then
			For i = 1 To VIEWGRID.Rows
				If Trim(VIEWGRID.GetGridCell(i, c_code)) <> "" Then
					VIEWGRID.SetGridCell i , 1, 1
					cnt = cnt + 1
				End If
			Next
			If cnt > 0 Then
				SCREEN.Object("parent.B_xodr").Enable = True
			End If
		ElseIf C_all.Checked = False Then
			For i = 1 To VIEWGRID.Rows
				VIEWGRID.SetGridCell i ,1, 0
			Next
			SCREEN.object("parent.B_xodr").Enable = False
		End If
	End If
End Sub

'***************************************************************************
'	Func : btn check
'***************************************************************************
Sub btn_check()
	Dim cnt
	cnt = 0
	For i = 1 To VIEWGRID.Rows
			If Trim(VIEWGRID.GetGridCell(i, c_code)) <> "" Then
				If Trim(VIEWGRID.GetGridCell(i, 1)) = 1 Then
					cnt = cnt + 1
				End If
			End If
	Next
	If cnt > 0 Then
		SCREEN.object("parent.B_xodr").Enable = True
	Else
		SCREEN.object("parent.B_xodr").Enable = False
	End If
End Sub

'***************************************************************************
'	Func : cls_check
'***************************************************************************
Sub cls_check()
	For i = 1 To VIEWGRID.Rows
		VIEWGRID.SetGridCell i ,1, 0
	Next
	SCREEN.Object("parent.B_XODR").Enable = False
	C_all.Checked = False
End Sub

'***************************************************************************
'	Func : Find_Row
'***************************************************************************
Function Find_Row(sCode)
	For row = 1 To VIEWGRID.Rows
		If Trim(sCode) = Trim(VIEWGRID.GetGridCell (row, 2)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

_AW_ONSEND_AW_
SCREEN.OnSend False

If Trim(SCREEN.Object("parent.pswd_login").Data) = "" Then
	SCREEN.OnSend = False
	Exit Sub
End If

Dim accn, pswd
accn = SCREEN.Object("parent.OBJ1.AN21").data
pswd = Trim(SCREEN.Object("parent.OBJ1.pswd").data)

If accn <> ""  And pswd <> "" Then
	VIEWGRID.Clear
	Call CONTROL0.Send(accn , pswd)
Else
	SCREEN.OnSend False
	If pswd = "" Then
		SCREEN.Object("parent.OBJ1.pswd").Setfocus
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("parent.B_N2").Enable = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(VIEWGRID)
_AW_ONCLICK_AW_
If VIEWGRID.HitPos = HP_ITEM Then
	If Mid(Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 2)), 2, 6) <> "" And _
								Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 6)) <> "" Then
		If VIEWGRID.Column = 1 Then
				btn_check
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(C_all)
_AW_ONCLICK_AW_
all_check()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CONTROL0)
_AW_ONDBLCLK_AW_
Dim row, sList

If  CONTROL0.Flag = "A" Then
	VIEWGRID.Clear
	VIEWGRID.InsertRows 0, CONTROL0.DataList, True
	Call VIEWGRID.Sort (2, True, True)
Else
	row = Find_Row(Left(CONTROL0.DataList, 8))
	sList = Mid(CONTROL0.DataList, 9, Len(CONTROL0.DataList)-8)
	If row = 0 Then						' Insert
			VIEWGRID.InsertRow row
			VIEWGRID.Update row, sList
	Else
		If Trim(sList) = "" Then		' delete
			VIEWGRID.RemoveRow row-1
		Else									' Update
			VIEWGRID.Update row-1 , sList
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



