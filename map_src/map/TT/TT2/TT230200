RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Const myFILE = "userconf.ini"

Dim start_f
start_f = 0

Sub ToggleChart()
	If Trim(B_GUBN.Text) = "데이터" Then '데이터를 보여줌.
		B_GUBN.Text = "차트"
		obj_date.SetObject "TT230202"
		obj_time.SetObject "TT230201"
		CHK.Text = "2"
	Else
		B_GUBN.Text = "데이터"
		obj_date.SetObject "TT230205"
		obj_time.SetObject "TT230204"
		CHK.Text = "1"
	End If
End Sub

Sub objSend()
	If Trim(ed_trcd.Data) <> "" Then
		Exit Sub
	End If

	SCREEN.Proc "obj_date.send_f", ""
	SCREEN.Proc "obj_time.send_f", ""
End Sub

_AW_ONSTART_AW_
SCREEN.SetTimer 0.5, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

If Trim(ed_trcd.Data) <> "" Then
	Exit Sub
End If

obj_date.Send
obj_time.Send

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.IgnoreChange True

If Trim(ed_trcd.Data) <> "" Then
	TRAD.Data = ed_trcd.Data
Else
	Exit Sub
End If

ed_trcd.Clear

Call objSend()

SCREEN.IgnoreChange False

S1301.SetFocus

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(TRAD)
_AW_ONCHANGE_AW_
sect.Data = 1

Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )

If retn <> True Then
       Exit Sub
End If

obj_hnam.Send
Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTN)
_AW_ONCLICK_AW_
sect.Data = 5

Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(B_GUBN)
_AW_ONCLICK_AW_
sect.Data = 4
Call ToggleChart()
Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
