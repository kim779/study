SCREEN.ChangeMap "IB230300"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
sect.Data = 2

obj_hnam.Send

If start_f = 0 Then
	start_f = 1
Else
	Call objSend()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB202201 /t/s/p5/d", "appendCODE" & _
			vbTab & S1301.Data & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctl_Category)
_AW_ONCLICK_AW_
Dim codx
codx = ctl_Category.GetPreCode(S1301.Data)

If Trim(codx) = "" Then
	Exit Sub
End If

S1301.Data = codx
S1301.Trigger "",True

obj_hnam.Send
Call objSend()
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim codx
codx = ctl_Category.GetNextCode(S1301.Data)

If Trim(codx) = "" Then
	Exit Sub
End If

S1301.Data = codx
S1301.Trigger "",True

obj_hnam.Send
Call objSend()
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
S1301.Data = ctl_Category.GetCurCode
S1301.Trigger "",True

SCREEN.Send 0

obj_hnam.Send
Call objSend()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


