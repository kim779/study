RESOURCE DIVISION
{


_AW_ONSTART_AW_
If SCREEN.CreateObject("Info") Then
	c_upgb.Data = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "CB_IB203600"))
End If

EDIT0.Data = emgn.Data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
' 종목코드에 'A'제거...
Dim code

If Trim(S210500.GetGridCell(1,1)) <> "" Then
	For i = 1 To S210500.Rows
		code = Trim(S210500.GetGridCell(i,1))
		If code <> "" Then
			If Left(code,1) = "A" Then code = Mid(code,2,11)
			S210500.SetGridCell i, 1, code
		End If
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(210500)
_AW_ONCLICK_AW_
Dim code

If S210500.HitPos = 3 Then
	code = S210500.GetGridCell(S210500.row, 2)
	If Trim(code) <> "" Then
		If Left(code,1) = "A" Then code = Mid(code,2,11)
		S1301.Data = code
		S1301.Trigger "", True
	End If
End If
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
SCREEN.CreateWindow 1, "IB200100 /t /s /p5 /d", _
	"1301" & vbTab & S1301.Data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_upgb)
_AW_ONCHANGE_AW_
SCREEN.CreateObject("Info")
INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "CB_IB203600", c_upgb.Data

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(company)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To S210500.Rows
	str = str & Right(Trim(S210500.GetGridCell(i, 2)), 6)
	str = str & vbTab
	str = str & Trim(S210500.GetGridCell(i, 3))
	str = str & vbLf
Next

If Len(Trim(str)) > 6 Then
	SYSTEM.SetAutoCode str, S210500.Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(emgn)
