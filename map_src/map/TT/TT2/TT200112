' DESC :  Help Funtion
'****************************************************************************************************************************
Sub Modify_dqty(amt, row_F)
	Dim amt_T, t_dprc
	amount = Trim(VIEWGRID.GetCell (row_F, c_dqty))													' 체결수량
	If amount = "" Then
		amount = "0"
	End If
	amount = CDbl(amount) + CDbl(amt)
	Call VIEWGRID.SetCell (row_F, "c_dqty", amount)
	Call VIEWGRID.SetCell (row_F, "c_stat", Trim(RTSGRID.GetGridCell(1,11)))					' 처리구분
	Call VIEWGRID.SetCell (row_F, "c_wqty", Trim(RTSGRID.GetGridCell(1,8)))						' 미체결수량

	If Trim(RTSGRID.GetGridCell(1, 14)) <> "" Then
		t_dprc = Trim(CDbl(RTSGRID.GetGridCell(1, 14))/100)
		t_dprc = FormatNumber(t_dprc, 2)
		Call VIEWGRID.SetCell (row_F, "c_dprc", t_dprc)	' 체결가격
	End If
End Sub

Sub Modify_wqty(row)
	Dim h_qty
	h_qty = RTSGRID.GetGridCell (1, 13)											' 정정/취소 확인수량
	If Trim(VIEWGRID.GetCell (row, "c_wqty")) <> "" Then
		h_qty = CDbl(VIEWGRID.GetCell (row, "c_wqty")) - h_qty
	Else
		h_qty = "0"
	End If

	Call VIEWGRID.SetCell (row, "c_wqty", h_qty)
End Sub

Function Find_Row(jm_num)														' 주문번호/원주문번호가 일치하는 Row Return
	For row = 1 To VIEWGRID.Rows
		If Trim(RTSGRID.GetGridCell (1, 1)) = Trim(VIEWGRID.GetCell (row, "c_accn")) Then
			If Trim(jm_num) = Trim(VIEWGRID.GetCell(row, "c_jmno")) Then
				Find_Row = row
				Exit Function
			End If
		End If
	Next
	Find_Row = 0
End Function

Sub Update_Row(row)																' 해당 Row에 Update Row
		VIEWGRID.SetCell row, "c_accn", Trim(RTSGRID.GetGridCell(1, 1))				' 계좌번호
		VIEWGRID.SetCell row, "c_jmno", Trim(RTSGRID.GetGridCell(1, 2))			' 주문번호
		VIEWGRID.SetCell row, "c_ojno", Trim(RTSGRID.GetGridCell(1, 3))			' 원주문번호
		VIEWGRID.SetCell row, "c_code", Trim(RTSGRID.GetGridCell(1, 4))			' 종목코드
		VIEWGRID.SetCell row, "c_hnam", Trim(RTSGRID.GetGridCell(1, 5))			' 종목명
		VIEWGRID.SetCell row, "c_wqty", Trim(RTSGRID.GetGridCell(1, 8))			' 미체결수량
		VIEWGRID.SetCell row, "c_dqty", Trim(RTSGRID.GetGridCell(1, 13))			' 체결수량
		VIEWGRID.SetCell row, "c_dprc", Trim(RTSGRID.GetGridCell(1, 14))			' 체결가격
		VIEWGRID.SetCell row, "c_jqty", Trim(RTSGRID.GetGridCell(1, 9))			' 주문수량
		VIEWGRID.SetCell row, "c_jprc", Trim(RTSGRID.GetGridCell(1, 10))			' 주문단가
		VIEWGRID.SetCell row, "c_stat", Trim(RTSGRID.GetGridCell(1,11))			' 접수구분

		If Trim(RTSGRID.GetGridCell(1, 7)) <> "" Then										' 호가구분
			VIEWGRID.SetCell row, "c_hogb", Trim(RTSGRID.GetGridCell(1, 7))
			VIEWGRID.SetCell row, "c_htmp", Get_hogb(Trim(RTSGRID.GetGridCell(1, 7)))
		End If

		Dim ho, color, ogin
		If Trim(RTSGRID.GetGridCell(1, 6)) <> "" Then							' 주문구분
			ogin = Trim(RTSGRID.GetGridCell(1, 6))
			ho = Left(ogin, 2)
			Select Case ho
				Case "매수"
					ogin = "+" & ogin
					color = 94
				Case "매도"
					ogin  = "-" & ogin
					color = 95
				Case Else
					Exit Sub
			End Select
			VIEWGRID.SetCell row, "c_jmgb", ogin
		End If

End Sub

'***************************************************************
'주문유형 (char -> string)
'***************************************************************
Function Get_hogb(hogb)
	Select Case hogb
		Case "L", "00"
			Get_hogb = "지정가"
		Case "M", "03"
			Get_hogb = "시장가"
		Case "C", "05"
			Get_hogb = "조건부"
		Case "B", "06"
			Get_hogb = "최유리"
	End Select
End Function

'***************************************************************************
'	Func : All check
'***************************************************************************
Sub all_check()
	Dim cnt
	cnt = 0
	If Trim(VIEWGRID.GetCell(1,"c_chk")) <> "" Then
		If C_all.Checked = True Then
			For i = 1 To VIEWGRID.Rows
				If Trim(VIEWGRID.GetCell(i,"c_jmno")) <> "" Then
					VIEWGRID.SetCell i, "c_chk", 1
					cnt = cnt + 1
				End If
			Next
			If cnt > 0 Then
				B_CAN.Enable = True
			End If
		ElseIf C_all.Checked = False Then
			For i = 1 To VIEWGRID.Rows
				VIEWGRID.SetCell i ,"c_chk", 0
			Next
			B_CAN.Enable = False
		End If
	End If
End Sub

'***************************************************************************
'	Func : btn check
'***************************************************************************
Sub btn_check()
	Dim cnt
	cnt = 0
	For i = 1 To VIEWGRID.Rows
			If Trim(VIEWGRID.GetCell(i, "c_jmno")) <> "" Then
				If Trim(VIEWGRID.GetCell(i, "c_chk")) = 1 Then
					cnt = cnt + 1
				End If
			End If
	Next
	If cnt > 0 Then
		B_CAN.Enable = True
	Else
		B_CAN.Enable = False
	End If
End Sub

'***************************************************************************
'	Func : cls_check
'***************************************************************************
Sub cls_check()
	For i = 1 To VIEWGRID.Rows
		VIEWGRID.SetCell i ,"c_chk", 0
	Next
	B_CAN.Enable = False
	C_all.Checked = False
End Sub


'*****************************************************************************
'	Func : pswd_check
'*****************************************************************************
Function pswd_check()
	pswd_check = False
	If Trim(pswd.data) = "" Then
		Exit Function
	End If

	If SYSTEM.CheckPasswd(Trim(pswd.data)) <> True Then
		SCREEN.IgnoreChange True
		pswd.Clear
		pswd.SetFocus
		SCREEN.IgnoreChange False
		Exit Function
	End If

	pswd_check = True
	SYSTEM.Push wnd_key.Data, pswd.Data
End Function

