_AW_ONDECLARE_AW_
'***************************************************************************************************
'c_wqty : 미체결(Working Order),  c_dqty : 체결수량 (Deal Order), c_kqty : 취소수량 (Kill Order)
'***************************************************************************************************
Const MAX_ROWS = 50
Const HP_ITEM  = 3
'미니
Const JJ_MAP	= "DH112300/t/s/p5/d"
Const CC_MAP	= "DH112400/t/s/p5/d"

'****************************************************************************************************************************
' 주문번호 : c_jmno, 원주문번호 : c_ojno,  종목코드 : c_code, 종목명   : c_hnam, 주문구분 : c_jmgb,  호가구분  : c_hogb,
' 주문가격 : c_jprc, 주문수량 : c_jqty,    체결수량 : c_dqty, 체결가격 : c_dprc, 미체결수량 : c_wqty, 주문상태 : c_stat
'****************************************************************************************************************************
' DESC :  선물  실시간 주문  미체결
'****************************************************************************************************************************
Sub OnNotice()
Dim r_stat, r_jmno, r_ojno, row_F, row_O
	r_stat = Trim(RTSGRID.GetGridCell(1, 11))					' 접수구분
	r_jmno = Trim(RTSGRID.GetGridCell(1, 2))						' 주문번호
	r_ojno = Trim(RTSGRID.GetGridCell(1, 3))						' 원주문번호
	r_wqty = Trim(RTSGRID.GetGridCell(1, 8))						' 미체결수량

	If Right(Trim(RTSGRID.GetGridCell(1, 1)), 2) <> "21" Then
		RTSGRID.RemoveRow 0
		Exit Sub
	End If

	If InStr(r_stat,"접수") > 0 Then									' 기본셋팅
		Call RTSGRID.SetGridCell (1,13, "0")
		Call RTSGRID.SetGridCell (1,14, "0")
	ElseIf r_stat = "거부" Or r_stat = "접수오류" Then
		Call RTSGRID.SetGridCell (1, 13, "0")
		Call RTSGRID.SetGridCell (1, 14, "0")
	End If

	If VIEWGRID.Rows = 0 Then											' VIEWGRID가 empty일 경우
		If r_wqty <> "" And CDbl(r_wqty) > 0 Then
			VIEWGRID.InsertRow 0
			Update_Row(1)
		End If
		RTSGRID.RemoveRow 0
		Exit Sub
	End If

	row_F = Find_Row(r_jmno)
	If row_F > 0 Then
		If r_stat = "체결" Then
			Call Modify_dqty(RTSGRID.GetGridCell(1, 13), row_F)
			If r_wqty = "" Or CDbl(r_wqty) < 1 Then
				VIEWGRID.RemoveRow row_F-1
			End If
			RTSGRID.RemoveRow 0
			Exit Sub
		ElseIf r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
			If row_O > 0	Then
					Modify_wqty(row_O)
					If CDbl(Trim(VIEWGRID.GetCell (row_O, "c_wqty"))) < 1 Then
							VIEWGRID.RemoveRow row_O-1
					End If
			End If
			VIEWGRID.SetCell row_F, "c_wqty", r_wqty														' 미체결수량
			VIEWGRID.SetCell row_F, "c_stat", Trim(RTSGRID.GetGridCell(1,11))					' 접수구분
			RTSGRID.RemoveRow 0

			If r_wqty = "" Or CDbl(r_wqty) < 1 Then
				VIEWGRID.RemoveRow row_F-1
			End If
			Exit Sub

		ElseIf r_stat = "거부" Or r_stat = "접수오류" Then
		ElseIf InStr(r_stat,"접수") > 0 Then
		Else
			RTSGRID.RemoveRow 0
			Exit Sub
		End If
	Else			' 주문번호 일치하는 row가 없는경우
		If r_stat = "정정확인" Or r_stat = "취소확인" Then
			row_O = Find_Row(r_ojno)
			If row_O > 0 Then
					Modify_wqty(row_O)
					If CDbl(Trim(VIEWGRID.GetCell (row_O, "c_wqty"))) < 1 Then
							VIEWGRID.RemoveRow row_O-1
					End If
			End If
			Call RTSGRID.SetGridCell (1, 13, "0")
			Call RTSGRID.SetGridCell (1, 14, "0")
		End If
		VIEWGRID.InsertRow 0
		row_F = 1
	End If

	If r_wqty = "" Or CDbl(r_wqty) < 1 Then
		VIEWGRID.RemoveRow row_F-1
		RTSGRID.RemoveRow 0
		Exit Sub
	End If
	Update_Row(row_F)
	RTSGRID.RemoveRow 0
End Sub

