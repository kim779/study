_AW_ONDECLARE_AW_
Dim bNowPrice
Sub OnPortfolio(confirm)
	Dim groupNames, parseData, Items, codelist, row

	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If
	If UCase(confirm) <> "OK" And UCase(confirm) <> "START" Then
		Exit Sub
	End If

	Items = ""
	DX_INTEREST.SetUserName(LOGIN.Name)
	groupNames = DX_INTEREST.LoadGroupNames()
	Do While Len(groupNames) > 0
		parseData = Mid(groupNames, 1, InStr(groupNames, vbTab) -1)
		groupNames = Mid(groupNames, InStr(groupNames, vbTab) + 1)
		Items = parseData & vbTab & Items
	Loop
	If Items = "" Then
		intercombo.SetItems("")
	Else
		intercombo.SetItems(vbTab & Items)
	End If

	intercombo.Data = SYSTEM.Pop("cxPortfolioItem")
	SCREEN.Proc "OBJ1.OnGroup", intercombo.Data
End Sub

Sub OnGroup(group)
	S90303.Clear()
	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If

	If Trim(group) <> "" Then
		codelist = DX_INTEREST.LoadCodeList(group)
		row = 1
		Do While Len(codelist) > 0
			parseData = Mid(codelist, 1, InStr(codelist, vbTab) -1)
			codelist = Mid(codelist, InStr(codelist, vbTab) + 1)
			S90303.InsertRow(-1)
			S90303.SetGridCell S90303.rows, 2, parseData
'			S90303.SetGridCell row, 2, parseData
			row = row + 1
		Loop
		SCREEN.Send 0
	End If
End Sub

Sub OnPredict(bNowPrice)
	If bNowPrice = "0" Then
		predict = True
	Else
		predict = False
	End If
	S90303.SetColumnVisible 5, predict
	S90303.SetColumnVisible 7, predict
	S90303.SetColumnVisible 9, predict
    S90303.SetColumnVisible 11, predict

	S90303.SetColumnVisible 4, Not predict
	S90303.SetColumnVisible 6, Not predict
	S90303.SetColumnVisible 8, Not predict
    S90303.SetColumnVisible 10, Not predict
End Sub


Sub start()
	SCREEN.SetTimer 4, False
End Sub

