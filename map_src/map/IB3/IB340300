Sub beforeDateChg()
	Dim comDate, SrtDt
	SrtDt = Trim(zQryStrDt.Data)

	isGiganChk.Text = "N"

	SrtDt = Left(SrtDt, 4) & "-" & Mid(SrtDt, 5, 2) & "-" & Right(SrtDt, 2)
	comDate = change_indate("m", 1, SrtDt)

	If CLng(comDate) < CLng(zQryEndDt.Data) Then
		zQryEndDt.Data = comDate
		RADIO2.Checked = True

		isGiganChk.Text = "Y"
	End If

	If CLng(zQryStrDt.Data) > CLng(zQryEndDt.Data) Then
		zQryEndDt.Data = comDate
		RADIO2.Checked = True

		isGiganChk.Text = "Y"
	End If

	sect.Text = 4
	'Call send_f()
End Sub

Sub afterDateChg()
	Dim comDate, EndDt
	EndDt = Trim(zQryEndDt.Data)

	isGiganChk.Text = "N"

	EndDt = Left(EndDt, 4) & "-" & Mid(EndDt, 5, 2) & "-" & Right(EndDt, 2)
	comDate = change_indate("m", -1, EndDt)

	If CLng(comDate) > CLng(zQryStrDt.Data) Then
		zQryStrDt.Data = comDate
		RADIO2.Checked = True

		isGiganChk.Text = "Y"
	End If

	If CLng(zQryStrDt.Data) > CLng(zQryEndDt.Data) Then
		zQryStrDt.Data = comDate
		RADIO2.Checked = True

		isGiganChk.Text = "Y"
	End If

	sect.Text = 5
	'Call send_f()
End Sub

