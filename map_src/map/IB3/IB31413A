_AW_ONDECLARE_AW_
Dim Mydata

Function data_split()
	Mydata = Split(s_data.data, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)							' 한 레코드를 개체별로 자르는중..

		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(0))				' CUD
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))				' 주문유형
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))				' 시장구분
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))				' 매매구분
		If GRID.getGridCell( NREC.Data - ii, 4) = "2" Then
			GRID.SetTRgb NREC.Data - ii, 4, 94
		Else
			GRID.SetTRgb NREC.Data - ii, 4, 95
		End If
		GRID.SetGridCell NREC.Data - ii, 5,Trim(Mydata(ii)(4))				' 계좌번호
		GRID.SetGridCell NREC.Data - ii, 6,Trim(Mydata(ii)(5))				' 비밀번호
		GRID.SetGridCell NREC.Data - ii, 7,Trim(Mydata(ii)(6))				' 주문번호
		GRID.SetGridCell NREC.Data - ii, 8,Trim(Mydata(ii)(7))				' 종목코드
		GRID.SetGridCell NREC.Data - ii, 9,Trim(Mydata(ii)(8))				' 종목명
		GRID.SetGridCell NREC.Data - ii, 10,Trim(Mydata(ii)(9))				' 주문수량
		GRID.SetGridCell NREC.Data - ii, 11,Trim(Mydata(ii)(10))			' 주문가격
		If Mid(Trim(GRID.getGridCell(NREC.Data - ii, 8)),2,1) = "0" Then
			GRID.SetGridCell NREC.Data - ii, 12,Trim(Mydata(ii)(10))*100 		' 주문가격
		Else
			GRID.SetGridCell NREC.Data - ii, 12,Trim(Mydata(ii)(10))			' 주문가격
		End If
		GRID.SetGridCell NREC.Data - ii, 13,Trim(Mydata(ii)(11))			' 호가구분
		GRID.SetGridCell NREC.Data - ii, 14,Trim(Mydata(ii)(12))			' 주문조건
		GRID.SetGridCell NREC.Data - ii, 15,Trim(Mydata(ii)(13))			' 모두구분
		GRID.SetGridCell NREC.Data - ii, 16,Trim(Mydata(ii)(14))			' 처리구분
		GRID.SetGridCell NREC.Data - ii, 20,Trim(Mydata(ii)(15))			' 기타
	Next
End Function

Sub AllSell()
	Dim ii, tprc

	For ii = 1 To GRID.Rows
		If Trim(GRID.getGridCell(ii, 1)) = "0" Then		Exit For
		tprc = Trim(GRID.GetGridCell(ii,11))
		If tprc = "" Then tprc = "0"
		If Mid(Trim(GRID.getGridCell(ii, 8)),2,1) = "0" Then
			GRID.SetGridCell ii, 12,tprc*100 		' 주문가격
		Else
			GRID.SetGridCell ii, 12,tprc			' 주문가격
		End If

		GRID.SetGridCell ii,6, pswd.Data  '2009.07
	Next
	SCREEN.Send 0
End Sub


