_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999922) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "1"

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(c_hogb.Text, 4)		'매매구분
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & ed_jprc.Data & vbLf
		SCREEN.CreateWindow 2, "IB30015A /p5 /d", dmsg
		If SYSTEM.Pop("fo_mado_order") <> "OK" Then
			Exit Sub
		End If
	End If
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

End Sub

Sub PopupAbleQty()
	If Len(Trim(SCREEN.Object("parent.ed_pswd").Data))<4 Then
		MsgBox "비밀번호를 입력하십시오.", , "IBK투자증권"
		Exit Sub
	End If

	If Len(Trim(ed_focod.Data))<8 Then
		MsgBox "종목코드를 입력하십시오.", , "IBK투자증권"
		Exit Sub
	End If

	Dim dmsg, ptnc, avol

	Select Case c_hogb.Data
		Case "03", "05", "06"
			ptnc = c_hogb.Data
		Case Else
			ptnc = "00"
	End Select

	If ed_jprc.Enable Then
		If Left(Trim(ed_focod.Data), 3)<>"401" And Left(Trim(ed_focod.Data), 3)<>"D01" Then
			If FormatNumber(ed_jprc.Data)=0 Then
				MsgBox "주문가격을 입력하십시오.", , "IBK투자증권"
				Exit Sub
			End If
		End If
	End If

	dmsg =	"ed_acno" & vbTab & SCREEN.Object("parent.AN20").Data & vbLf &_
			"zPwd" & vbTab & SCREEN.Object("parent.ed_pswd").Data & vbLf &_
			"zQryTp" & vbTab & "1" & vbLf &_
			"zFnoIsuNo" & vbTab & ed_focod.Data & vbLf &_
			"zBnsTp" & vbTab & mmgb & vbLf &_
			"dOrdPrc" & vbTab & ed_jprc.Data & vbLf &_
			"zFnoOrdprcPtnCode" & vbTab & ptnc

	SCREEN.CreateWindow 2, "IB304190 /p5 /d", dmsg

	avol = SYSTEM.Pop("IB304190_QTY")
	If Len(Trim(avol))>0 Then
		ed_jqty.Data = avol
		SYSTEM.Push "IB304190_QTY", ""
	End If
	ed_jqty.SetFocus
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

'선물옵션주문 공통
#load IB999922

_AW_ONENDSUB_AW_
