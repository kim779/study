Call SetConfig()				'TabStop 설정
Call init_option("parent.clearpush_buy")		'주문 환경설정 init
Call init_data()				'주문 init

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
get_avol() '주문가능수량

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_jprc)
_AW_ONCHANGE_AW_
If ed_jprc.Enable = False Then
	ed_jprc.Data = "0"
Else
	Dim gubn, symb

	gubn = Left(ed_focod.Data, 3)
	symb = "main.OBJ_sise."

	Select Case gubn
	Case "101", "A01"		'지수선물
		If CDbl(ed_jprc.Data) <> 5 Then	Exit Sub
		symb = symb & "31023"
	Case "103", "403", "A03", "D03"		'스타선물
		If CDbl(ed_jprc.Data) <> 50 Then	Exit Sub
		symb = symb & "31023"
	Case "201", "301", "B01", "C01"		'지수옵션
		If CDbl(ed_jprc.Data) <> 0 Then	Exit Sub
		symb = symb & "41023"
	Case Else
		Exit Sub
	End Select

	ed_jprc.Data = SCREEN.Object(symb).Data
End If

'환경설정용 단가에 저장할것
OrdCfg.Price = CStr(ed_jprc.Data / 100)
OrdCfg.Push
_AW_ONENDSUB_AW_
_AW_ONSETFOCUS_AW_
Dim symb

Select Case Left(ed_focod.data, 1)
	Case "1", "4", "A", "D"		'지수선물
		symb = "31023"
	Case "2", "3", "B", "C"		'스타선물
		symb = "41023"
	Case Else
		Exit Sub
End Select

If Left(ed_focod.Data, 3)<>"401" And Left(ed_focod.Data, 3)<>"D01" Then
	If CDbl(ed_jprc.Data) <= 0.00 Then
		ed_jprc.Data = SCREEN.Object("main.OBJ_sise."&symb).Data
	End If
Else
	' 스프레드의 경우 숫자가 아닐경우에만 현재가 세팅한다.
	If IsNumeric(ed_jprc.Data) <> True Then
		ed_jprc.Data = SCREEN.Object("main.OBJ_sise."&symb).Data
	End If
End If
