RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999922) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "1"

Const myFILE = "userconf.ini"

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, prc, dmsg

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If


	If Left(Trim(ed_fcod.Data), 3) = "185" Or Left(Trim(ed_fcod.Data), 3) = "186" Or _
		Left(Trim(ed_fcod.Data), 3) = "A85" Or Left(Trim(ed_fcod.Data), 3) = "A86" Then
		prc = ed_jprc.Data
	Else
		prc = FormatNumber((ed_jprc.Data)/100, 2, -1, 0)
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(c_hogb.Text, 4)		'매매구분
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & prc & vbLf
		SCREEN.CreateWindow 2, "IB31415A /p5 /d", dmsg
		If SYSTEM.Pop("fo_mado_order") <> "OK" Then
			Exit Sub
		End If
	End If
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")

End Sub

Sub SettingPrice(price)
	Dim code

	If Len(Trim(ed_fcod.Data)) <> 8 Then Exit Sub
'	Select Case Left(Trim(ed_fcod.Data),3)
'		Case "185", "186"
'			ed_jprc.Data = price & ".00"
'		Case Else
'			ed_jprc.Data = price
'	End Select
	ed_jprc.Data = price
	Hoga_unit(Trim(ed_fcod.Data))
End Sub

Sub SettHoga()
	If Left(Trim(ed_fcod.Data), 3) = "186" Or Left(Trim(ed_fcod.Data), 3) = "486" Or _
		Left(Trim(ed_fcod.Data), 3) = "A86" Or Left(Trim(ed_fcod.Data), 3) = "D86" Then
		r_hogb0.Checked = True
		r_hogb1.Enable = False
		c_hogb.Data = "00"
		c_hogb.Enable = False
	Else
		r_hogb1.Enable = True
		c_hogb.Enable = True
	End If
End Sub

Sub LoadConfig()
	If SCREEN.CreateObject("INFO") Then
		BTN_JQTY_1.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB314100", "BTN_JQTY_1"))
		BTN_JQTY_2.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB314100", "BTN_JQTY_2"))
		BTN_JQTY_3.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB314100", "BTN_JQTY_3"))
		BTN_JQTY_4.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB314100", "BTN_JQTY_4"))
		BTN_JQTY_5.Text = Trim(INFO.PopData(LOGIN.Name, myFILE, "IB314100", "BTN_JQTY_5"))
		If BTN_JQTY_1.Text="" Then BTN_JQTY_1.Text = 1 End If
		If BTN_JQTY_2.Text="" Then BTN_JQTY_2.Text = 2 End If
		If BTN_JQTY_3.Text="" Then BTN_JQTY_3.Text = 3 End If
		If BTN_JQTY_4.Text="" Then BTN_JQTY_4.Text = 5 End If
		If BTN_JQTY_5.Text="" Then BTN_JQTY_5.Text = 10 End If
	End If
	Call SaveConfig()
End Sub

Sub SaveConfig()
