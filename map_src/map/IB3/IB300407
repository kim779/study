_AW_ONDECLARE_AW_
Sub Parse()
	Dim data, ii, jj, row, vals, mmgb
	VIEWGRID.Clear
	data = Split(Trim(t_data.Data), "@")
	For ii=0 To UBound(data)
		vals = Split(Trim(data(ii)), "|")
		VIEWGRID.SetGridCell ii+1, 1, Trim(vals(0))
		VIEWGRID.SetGridCell ii+1, 2, Trim(vals(1))
		VIEWGRID.SetGridCell ii+1, 3, SCREEN.GetName(115, Trim(vals(1)), 0)
		VIEWGRID.SetGridCell ii+1, 4, Trim(vals(2))
	Next
	If (ii+1)>14 Then
		VIEWGRID.SetRows ii+1
	Else
		VIEWGRID.SetRows 14
	End If
	L_CNT.Data = "" & ii
End Sub

_AW_ONSTART_AW_
Call Parse()

