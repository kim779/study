_AW_ONDECLARE_AW_
Sub read_code()
	If SCREEN.CreateObject("Info") Then
		Dim code, gubn, objnm

		For ii = 1 To 6
			objnm = "obj"&ii
			gubn = "CODE"&ii
			code = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB330026", gubn))
			If code = "" Then
				SCREEN.Object(objnm).clearall 0
			Else
				SCREEN.Object(objnm&".ed_focod").Data = code
				SCREEN.Object(objnm).send
			End If

		Next

	End If
End Sub


Sub write_code()
	Dim tjcd1, tjcd2, tjcd3

	If SCREEN.CreateObject("Info") Then
		Dim code, gubn, objnm

		For ii = 1 To 6
			objnm = "obj"&ii
			gubn = "CODE"&ii
			code = Trim(SCREEN.Object(objnm&".ed_focod").Data)
			INFO.pushData LOGIN.Name, "userconf.ini", "IB330026", gubn, code

		Next

	End If

End Sub

_AW_ONSTART_AW_
read_code()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
write_code()

_AW_ONENDSUB_AW_
}



