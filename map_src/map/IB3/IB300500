Sub init_mmgb()
	Dim i, atmval, gubn
	atmval = Trim(atm.Data)
	gubn = SCREEN.Object("main.OBJ_HEAD1.mmgb").Data

	For i=1 To S410.Rows
		If strt_yn.Data = "Y" Then
			If gubn = 1 Then
				If Trim(SCREEN.Object("main.ed_focod1").Data) = Trim(S410.GetGridCell(i, 1 )) Then
					If CLng(SCREEN.Object("main.OBJ_order1.tab_order").ID) = 1 Then
						S410.SetGridCell i, 11,  "●"
					Else
						S410.SetGridCell i, 12,  "●"
					End If
				End If
				If Trim(SCREEN.Object("main.ed_focod2").Data) = Trim(S410.GetGridCell(i, 17 )) Then
					If CLng(SCREEN.Object("main.OBJ_order2.tab_order").ID) = 1 Then
						S410.SetGridCell i, 16,  "●"
					Else
						S410.SetGridCell i, 15,  "●"
					End If
				End If
			ElseIf gubn = 2 Then
				If Trim(SCREEN.Object("main.ed_focod1").Data) = Trim(S410.GetGridCell(i, 1 )) Then
					S410.SetGridCell i, 11,  "●"
				End If
				If Trim(SCREEN.Object("main.ed_focod2").Data) = Trim(S410.GetGridCell(i, 1 )) Then
					S410.SetGridCell i, 12,  "●"
				End If
			Else
				If Trim(SCREEN.Object("main.ed_focod1").Data) = Trim(S410.GetGridCell(i, 17 )) Then
					S410.SetGridCell i, 15,  "●"
				End If
				If Trim(SCREEN.Object("main.ed_focod2").Data) = Trim(S410.GetGridCell(i, 17 )) Then
					S410.SetGridCell i, 16,  "●"
				End If
			End If
		End If
		If atmval=Trim(S410.GetGridCell(i, 13)) Then
			S410.SetPRgb i, 13, 66
			S410.SetPRgb i, 14, 66
			If strt_yn.Data = "N" Then
'				S410.SetGridCell i, 11,  ""
'				S410.SetGridCell i, 12,  ""
'				S410.SetGridCell i, 15,  ""
'				S410.SetGridCell i, 16,  ""
				If gubn = 1 Then
					S410.SetGridCell i, 11,  "●"
					S410.SetGridCell i, 15,  "●"
