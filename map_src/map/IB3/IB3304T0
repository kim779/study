_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.Data = Trim(AN20.Password)

	If Trim(zPwd.Data) = "" And SYSTEM.ConnectBy <> "1" Then
		zPwd.Data = "9999"
		zPwd.Enable = False
	End If

	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 2,2

	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	send_btn.Enable = False
	SCREEN.Object("obj_Buf.edt_sndCnt").Data	= "1"
	ACNM.Data = AN20.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

