'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2

	If Len(Trim(AN20.Data)) = 11 Then
		ACNM.Data = Trim(AN20.Name)
		zPwd.Data = Trim(AN20.Password)

		If SYSTEM.ConnectBy = 1 And Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If

		Call send_f()
	Else
		AN20.SetFocus
		Exit Sub
	End If
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 2,2
	ACNM.Data = AN20.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

