{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'PowerBase TR1547(SONBQ036)과 비슷한 화면.
'SONBQ006은 PowerBase TR이 없음.

LEDGER.Rcnt = "0025"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
Call guide_msg("")

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.AN20").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오")
	SCREEN.Object("parent.AN20").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 And Trim(SCREEN.Object("parent.zPwd").Data) = "" Then
	SCREEN.Object("parent.zPwd").Data = "9999"
	zPwd.Data = "9999"
Else
	zPwd.Data = Trim(SCREEN.Object("parent.zPwd").Data)
End If

'직원용일때 비밀번호를 입력하지 않았을 때
'각 항목설정시 비밀번호 확인장 뜨지 않도록 하고
'조회버튼 클릭시 확인창 뜨도록 수정

Dim sel
sel = Trim(SCREEN.Object("parent.sel").Text)

If Is_numeric(sel) = False Then
	sel = 0
End If

