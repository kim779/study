_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	ed_focod.DATA = GRID0.GetGridCell(GRID0.Index+1, 1)
	HNAM.Data = GRID0.GetGridCell(GRID0.Index+1, 2)
	If Trim(ed_focod.DATA) = "" Then
	    Exit Sub
	End If

	If Left(Trim(ed_focod.Data), 1) = "1" Or Left(Trim(ed_focod.Data), 1) = "4" Or Left(Trim(ed_focod.Data), 1) = "A" Or Left(Trim(ed_focod.Data), 1) = "D" Then
		ed_focod.Trigger "30301", True
		ed_focod.Trigger "ed_focod", True
		SYSTEM.SetHistory "30301", ed_focod.Data
	Else
		ed_focod.Trigger "40301", True
		ed_focod.Trigger "ed_focod", True
		SYSTEM.SetHistory "40301", ed_focod.Data
	End If

	SYSTEM.SetHistory "ed_focod", ed_focod.Data
End If
