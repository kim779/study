Function l_zeropad(ed_str)
	Dim sln, str
	str = Trim(ed_str.Data)
	If str = "" Then
		l_zeropad = ""
		Exit Function
	End If
	l_zeropad = String(Len(ed_str.Data) - Len(str), "0") & str
End Function

