'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.Data = AN20.Password
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 조회
Sub send_f()
	zQryTrxTp.Data = "1"
	temp_ACNM.Data = ACNM.Data
	LEDGER.Fkey = "C"
	canBuy.Clear
	SCREEN.Send 0
End Sub

' 주문
Sub send_o()
	zQryTrxTp.Data = "2"
	temp_ACNM.Data = ACNM.Data
	canBuy.Clear
	SCREEN.Send 0
End Sub

'주문가능여부
'주문가능여부카운트 세고 전체카운트와 같을 경우 주문가능
Sub Check_Ord()

	Dim val, val2, count

	count = 0


	For ii = 1 To GRID0.Rows
	 val = GRID0.GetGridCell(ii, 11)
'    주문가능여부로 판단
	 If Trim(val) = "주문가능" Then
	 	count = count + 1
	 End If
	Next

	If GRID0.Rows = 0 Then
		canBuy.Data = "종목이 없습니다"
		next_btn.Enable = False
		Exit Sub
	End If

	If count < GRID0.Rows Then
		canBuy.Data = "주문불가능 종목 보유"
		next_btn.Enable = False
	Else
		canBuy.Data = "주문가능"
		next_btn.Enable = True
	End If
End Sub

