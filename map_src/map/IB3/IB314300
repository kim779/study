_AW_ONDECLARE_AW_
Sub send_sise_all(gubn)
	SYSTEM.Trace "2ed_cfocod = " & ed_cfocod.Data
	Dim code, fogb, rsymb, acnm, jmNm
	code = Left(ed_cfocod.Data, 1)
	jmNm = SCREEN.GetName(127, Trim(ed_cfocod.Data), 0)

	If jmNm <> "" Then							'국내선물
		ed_cfocod.Trigger "ed_fcod", True

		If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
			fogb = 127
			rsymb = "100301"
			OBJ_sise.SetObject("IB314410")
		ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C" Then
			fogb = 102
			rsymb = "40301"
			OBJ_sise.SetObject("IB314414")
		End If
	Else										'지수선물
		ed_cfocod.Trigger "ed_focod", True

		If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
			fogb = 101
			rsymb = "30301"
			OBJ_sise.SetObject("IB314412")
		ElseIf code = "2" Or code = "3" Or code = "B" Or code = "C" Then
			fogb = 102
			rsymb = "40301"
			OBJ_sise.SetObject("IB314414")
		End If
	End If

	HNAM.Data = SCREEN.GetName (fogb, ed_cfocod.Data, 0)
	SCREEN.Object("OBJ_order.OBJ_odr.hnam").data = HNAM.data

	If gubn = "main" Then
		SCREEN.IgnoreChange True
		SCREEN.Object("OBJ_order.OBJ_odr.ed_cfocod").data = ed_cfocod.data
		SCREEN.IgnoreChange False
	End If

	acnm = Trim(SCREEN.Object("OBJ_order.acnm").data)

	If Trim(HNAM.Data) =  "" Then
		SCREEN.ClearAll 0, 2
		OBJ_order.ClearAll 2
		SCREEN.Object("obj_order.obj_odr").ClearAll 2
		OBJ_sise.ClearAll 2
		SCREEN.Object("obj_sise.obj0").ClearAll 2
		SCREEN.Object("OBJ_order.acnm").data = acnm
		OBJ_sise.Send
		Exit Sub
	Else
		ed_cfocod.Trigger "ed_cfocod", True
		ed_cfocod.Trigger rsymb, True
		ed_cfocod.Trigger rsymb, False
		SYSTEM.SetHistory rsymb, ed_cfocod.Data
		SYSTEM.SetHistory "ed_cfocod", ed_cfocod.Data
	End If

	OBJ_sise.Send
	SCREEN.Proc "OBJ_order.OBJ_odr.afterSendSiseJumn", ""
End Sub

