_AW_ONDECLARE_AW_

Function Nullcheck(Data)
	Nullcheck = Data
	If Trim(Nullcheck) = "" Then
		Nullcheck = 0
	End If
End Function

Function SetSign(Data)
	SetSign = Data
	If Data > 0 Then
		SetSign = "+" & Data
	End If
End Function

Function idx(data)
	idx = data
	Select Case Fix(idx)
		Case 9
			idx = 1
		Case 8
			idx = 2
		Case 0
			idx = 3
		Case 1
			idx = 4
		Case 2
			idx = 5
		Case 3
			idx = 6
		Case 4
			idx = 7
		Case 5
			idx = 8
		Case 6
			idx = 9
'		Case 12
'			idx = 10
'		Case 13
'			idx = 11
		Case 7
			idx = 10
	End Select
End Function

Sub ProcSetData(Data)
	Dim id
	obj0.Send
	obj1.Send
	ArrData = Split(Data, "|")

	id = idx(arrdata(0))
	If id <> 3 Then
		GRID0.SetGridCell 11, 2, SetSign(Fix(arrdata(3) + CLng(Nullcheck(GRID0.GetGridCell(11,2)))))

		GRID0.SetGridCell 11, 4, Fix(arrdata(1) + CLng(Nullcheck(GRID0.GetGridCell(11,4))))

		GRID0.SetGridCell 11, 6, Fix(arrdata(2) + CLng(Nullcheck(GRID0.GetGridCell(11,6))))

		GRID0.SetGridCell 11, 8, CLng(Nullcheck(GRID0.GetGridCell(11,4)))+CLng(Nullcheck(GRID0.GetGridCell(11,6)))

	End If

	GRID0.SetGridCell id, 2, SetSign(Fix(arrdata(3) + CLng(Nullcheck(GRID0.GetGridCell(id,2)))))
	GRID0.SetGridCell id, 4, Fix(arrdata(1) + CLng(Nullcheck(GRID0.GetGridCell(id,4))))
	GRID0.SetGridCell id, 5, FormatNumber( CDbl(Nullcheck(GRID0.GetGridCell(id,4))) / CDbl(Nullcheck(GRID0.GetGridCell(11,4)))*100, 2, 0, 0, 0 )

	GRID0.SetGridCell id, 6, Fix(arrdata(2) + CLng(Nullcheck(GRID0.GetGridCell(id,6))))
	GRID0.SetGridCell id, 7, FormatNumber(CDbl(Nullcheck(GRID0.GetGridCell(id,6))) / CDbl(Nullcheck(GRID0.GetGridCell(11,6)))*100, 2, 0, 0, 0)

	GRID0.SetGridCell id, 8, CLng(Nullcheck(GRID0.GetGridCell(id,4)))+CLng(Nullcheck(GRID0.GetGridCell(id,6)))
	GRID0.SetGridCell id, 9, FormatNumber(CDbl(Nullcheck(GRID0.GetGridCell(id,8))) / CDbl(Nullcheck(GRID0.GetGridCell(11,8)))*100, 2, 0, 0, 0)

	obj1.Send

End Sub

