RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim YY,DD

Sub startset()
	YY = Right(Trim(MMYY.Data),2)
	OUTPUT0.Data = Trim(MMYY.Data)
	grid.SetHead 14, YY&"월"
	grid.SetHead 19, YY&"월"
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
Call startset()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If YY = "" Then
	Call startset()
End If

Dim i
For i = 1 To grid.Rows
	grid.SetPRgb i, 16, 200
	If Trim(atmg.Data) = Trim(grid.GetGridCell(i,16)) Then
		grid.SetPRgb i, 16, 245

		grid.Index = i+4
		grid.SetFocus
		grid.Index = i-1
	End If
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(grid)
_AW_ONCLICK_AW_
If grid.HitPos = 3 Then
	If grid.Column = 14 Then
		ed_focod.data = Mid(grid.GetGridCell(grid.Row,1),2)
		ed_focod.Trigger "ed_focod",True
	ElseIf grid.Column = 19 Then
		ed_focod.data = Mid(grid.GetGridCell(grid.Row,18),2)
		ed_focod.Trigger "ed_focod",True
	Else
		Exit Sub
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(MMYY)
_AW_ONCHANGE_AW_
Call startset()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(OUTPUT0)
_AW_ENDSCRIPT_AW_


}



