_AW_SCRIPT_AW_(ed_jprc_lowCon)
_AW_ONCHANGE_AW_
If ed_jprc_lowCon.Enable = False Then
	ed_jprc_lowCon.Data = "0.00"
Else
	Dim gubn, symb

	gubn = Left(ed_cfocod.Data, 3)
	symb = "main.OBJ_sise."

	Select Case gubn
	Case "101", "A01"		'지수선물
		If CDbl(ed_jprc_low.Data) <> 5 Then	Exit Sub
		symb = symb & "31023"
	Case "103", "403", "A03", "D03"		'스타선물
		If CDbl(ed_jprc_low.Data) <> 50 Then	Exit Sub
		symb = symb & "31023"
	Case "201", "301", "B01", "C01"		'지수옵션
		If CDbl(ed_jprc_low.Data) <> 0 Then	Exit Sub
		symb = symb & "41023"
	Case "161", "163", "164", "175", "176", "177", _
		"A61", "A63", "A64", "A75", "A76", "A77"  '상품선물
		If CDbl(ed_jprc_low.Data) <> 0 Then	Exit Sub
		symb = symb & "101023"
	Case "185", "186", "A85", "A86"  			'상품선물
		symb = symb & "101023"
		Exit Sub
	Case "275", "375", "B75", "C75"		'상품옵션 (달러)
		If CDbl(ed_jprc_low.Data) <> 0 Then	Exit Sub
		symb = symb & "111023"
	Case Else
		Exit Sub
	End Select

	ed_jprc_lowCon.Data = SCREEN.Object(symb).Data
End If

'환경설정용 단가에 저장할것
OrdCfg.Price = CStr(ed_jprc_lowCon.Data / 100)
OrdCfg.Push
_AW_ONENDSUB_AW_
_AW_ONSETFOCUS_AW_
