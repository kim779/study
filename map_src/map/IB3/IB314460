{


_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

' 공통함수(IB999930) 전역변수: 매매구분. 1-매도, 2-매수, 3-정정, 4-취소
mmgb = "2"
jumunGb = "StopLimit"

'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg, tmpCode

	init_data()										'주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		SYSTEM.Push "StopLimit_masu_order", ""
		hogb = Mid(c_hogb.Text, 4)		'매매구분

		Dim prcCon, prc
		tmpCode = Left(Trim(ed_cfocod.Data), 3)
		If tmpCode = "185" Or tmpCode = "186" Or tmpCode = "187" Or tmpCode = "A85" Or tmpCode = "A86" Or tmpCode = "A87" Then
			prcCon = ed_jprc_con.Data
			prc = ed_jprc.Data
		Else
			prcCon = FormatNumber((ed_jprc_con.Data)/100, 2, -1, 0)
			prc = FormatNumber((ed_jprc.Data)/100, 2, -1, 0)
		End If

		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			   "o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			   "o_hnam" & vbTab & HNAM.Data & vbLf &_
			   "o_hogb" & vbTab & hogb & vbLf &_
			   "o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			   "o_jprc_con" & vbTab & prcCon & vbLf &_
		       "o_jprc" 	& vbTab & prc & vbLf

		SCREEN.CreateWindow 2, "IB31446A /p5 /d", dmsg
		If SYSTEM.Pop("StopLimit_masu_order") <> "OK" Then
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송
	Call QueryOption("after")

	Call clearLastStat()

End Sub

_AW_ONINDECLARE_AW_
