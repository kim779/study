	Case "161", "163", "164", "175", "176", "177", _
		"A61", "A63", "A64", "A75", "A76", "A77"  '상품선물
		If CDbl(ed_jprc_low.Data) <> 0 Then	Exit Sub
		symb = symb & "101023"
	Case "185", "186", "A85", "A86"  			'상품선물
		symb = symb & "101023"
		Exit Sub
	Case "275", "375", "B75", "C75"		'상품옵션 (달러)
		If CDbl(ed_jprc_low.Data) <> 0 Then	Exit Sub
		symb = symb & "111023"
	Case Else
		Exit Sub
End Select

If Left(ed_cfocod.Data, 1)<>"4" And Left(ed_cfocod.Data, 1)<>"D" Then
	If CDbl(ed_jprc_lowCon.Data) <= 0.00 Then
		'ed_jprc.Data = SCREEN.Object("main.OBJ_sise."&symb).Data
		ed_jprc_lowCon.Data = SCREEN.Object(symb).Data
	End If
Else
	' 스프레드의 경우 숫자가 아닐경우에만 현재가 세팅한다.
	If IsNumeric(ed_jprc_lowCon.Data) <> True Then
		'ed_jprc.Data = SCREEN.Object("main.OBJ_sise."&symb).Data
		ed_jprc_lowCon.Data = SCREEN.Object(symb).Data
	End If
End If
