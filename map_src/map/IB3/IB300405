RESOURCE DIVISION
{


_AW_ONDECLARE_AW_

Sub Parse()
	Dim data, ii, jj, row, vals, mmgb
	VIEWGRID.Clear
	data = Split(Trim(t_data.Data), "@")
	For ii=0 To UBound(data)
		vals = Split(Trim(data(ii)), "|")
		VIEWGRID.SetGridCell ii+1, 1, Trim(vals(0))
		VIEWGRID.SetGridCell ii+1, 2, SCREEN.GetName(115, Trim(vals(0)), 0)
		mmgb = Trim(vals(1))
		Select Case mmgb
			Case "1"	VIEWGRID.SetGridCell ii+1, 3, "-매도"
			Case "2"	VIEWGRID.SetGridCell ii+1, 3, "+매수"
		End Select
		VIEWGRID.SetGridCell ii+1, 4, Trim(vals(2))
		VIEWGRID.SetGridCell ii+1, 5, Trim(vals(3))
	Next
	If (ii+1)>14 Then
		VIEWGRID.SetRows ii+1
	Else
		VIEWGRID.SetRows 14
	End If
	L_CNT.Data = "" & ii
End Sub

_AW_ONSTART_AW_
SYSTEM.Push "IB300400_RESULT", "FALSE"
Call Parse()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BTN_OK)
_AW_ONCLICK_AW_
SYSTEM.Push "IB300400_RESULT", "TRUE"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_CANCEL)
_AW_ONCLICK_AW_
SYSTEM.Push "IB300400_RESULT", "FALSE"
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



