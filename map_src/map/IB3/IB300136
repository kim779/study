'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit For
		End If
		If Trim(VIEWGRID.GetGridCell (ii, 6)) > "0" Then
			VIEWGRID.SetGridCell ii, 1, Flag
		End If

	Next
	btn_chk()
End Sub

Sub btn_chk()
	Dim cnt, ii

	cnt = 0
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit For
		End If
		If VIEWGRID.getGridCell(ii, 1) = "1" And Trim(VIEWGRID.GetGridCell (ii, 6)) > "0" Then
			cnt = cnt +1
		End If
	Next

	If cnt > 0 Then
		btn_j.Enable = True
	Else
		btn_j.Enable = False
		allCheck.Checked = False
	End If
End Sub


'***************************************************************************
' DESC: clear_check
'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit For
		End If
		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
	btn_chk()
End Sub

'***************************************************************************
'	Func : Find_Row
'***************************************************************************
Function Find_Row(sCode)
	For row = 1 To VIEWGRID.Rows
		If Trim(sCode) = Trim(VIEWGRID.GetGridCell (row, 2)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function


'***************************************************************************
' DESC : calc_sum()함수 : 주식평가금액, 주식평가손익, 주식수익률 계산
'***************************************************************************
Sub calc_sum()
	Dim migm, tmigm, pggm, tpggm, pgsi, srat, ii, tpgsi

	tpggm = 0
	tmigm = 0
	tpgsi = 0

	For ii = 1 To VIEWGRID.Rows
		migm = VIEWGRID.GetGridCell(ii, 13)				'매입금액의 합
		If Is_numeric(migm) = False Then
			migm = 0
		End If
		tmigm = tmigm + migm

		pggm = VIEWGRID.GetGridCell(ii, 10)				'평가금액의 합
		If Is_numeric(pggm) = False Then
			pggm = 0
		End If
		tpggm = tpggm + pggm

		pgsi = Trim(VIEWGRID.GetGridCell(ii, 11))
		If pgsi = ""  Then
			pgsi = 0
		End If
		tpgsi = tpgsi + pgsi
	Next

	o_migm.Data = tmigm									'매입금액의 합
	o_pggm.Data = tpggm									'평가금액의 합
	o_pgsi.Data = tpgsi									'평가손익의 합

	If tpgsi > 0 Then
		o_pgsi.Data = "+" & o_pgsi.Data
	End If

	If tmigm =< 0 Then									'손익률
		srat = 0
	Else
		srat = CCur(tpgsi / tmigm) * 100
		srat = FormatNumber(srat, 2, 0, 0, 0)
	End If

	o_srat.Data = srat
	If srat > 0 Then
		o_srat.Data = "+" & srat
	End If

End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False

	VIEWGRID.Clear
	If Trim(ed_accn.Data) = "" Or Len(Trim(ed_accn.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If
	If Trim(ed_pswd.Data) = "" Or Len(Trim(ed_pswd.Data)) < 4 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Function
	End If

	ret = P_pswdConfirm(ed_accn.data, ed_pswd.data, msg)
	If ret <> True Then
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		SCREEN.Object("main.GUIDE").Text = msg
		Exit Function
	End If

	Error_check = True
End Function

