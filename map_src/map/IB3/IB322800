_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.clearall 2, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0020"
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim i
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	For i=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,4)) <> "" Then
			GRID0.SetGridCell i,4, FormatPercent(Trim(GRID0.GetGridCell(i,4)))
		End If
	Next
		For i=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,5)) <> "" Then
			GRID0.SetGridCell i,5, FormatPercent(Trim(GRID0.GetGridCell(i,5)))
		End If
	Next
		For i=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,6)) <> "" Then
			GRID0.SetGridCell i,6, FormatPercent(Trim(GRID0.GetGridCell(i,6)))
		End If
	Next
		For i=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,8)) <> "" Then
			GRID0.SetGridCell i,8, FormatPercent(Trim(GRID0.GetGridCell(i,8)))
		End If
	Next
End If

