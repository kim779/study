_AW_SCRIPT_AW_(zpwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	sect = 0
	Call send_f()
End If
