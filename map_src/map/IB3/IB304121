_AW_ONDECLARE_AW_
Option Explicit
Dim runMingam
Dim g_BefK200Time

g_BefK200Time = "0"
'-----------------------------------------------------------------------------
Function GetInt(StrData)
	Dim Data
	GetInt = 0

	If Len(StrData) > 6 Then
		Data = Mid(StrData, 1, 2) & Mid(StrData, 4, 2) & Mid(StrData, 7, 2)
	Else
		Data = StrData
	End If
	'LABEL2.Data = Data
	If IsNumeric(Data) Then
		GetInt = CLng(Data)
	Else
		Exit Function
	End If
End Function
'----------------------------------------------------------
If SCREEN.CreateObject("DX_OPSENSCAL") = False Then
	runMingam = False
Else
	runMingam = True
	DX_OPSENSCAL.UserName 	= LOGIN.Name 								'ReadCfg작업을 위해 UserName 필요
	DX_OPSENSCAL.ReadCfg
End If

Sub OnAlert()
	If runMingam = False Or Trim(S40301.Data) = "" Then
		Exit Sub
	End If

	If g_BefK200Time = S20034.Data Then
		Exit Sub
	End If

	If Mid(S20034.Data, 1, 1) <> "장" Then
		If GetInt(Trim(S20034.Data)) - GetInt(g_BefK200Time) <= 1 And g_BefK200Time <> "0" Then
			'g_BefK200Time = S20034.Data
			Exit Sub
		End If
	End If
	g_BefK200Time = Trim(S20034.Data)

	' IV, Delta, Gamma, Theta, Vegga, Rho 계산
	' 입력인자 : 현재가, K200, 선물최근월물, 장시간
	If IsNumeric(TABLE3.GetTableText(3)) = True Then
		DX_OPSENSCAL.CalcEx Abs(TABLE3.GetTableText(3)), S20023.Data, S31023.Data, S20034.Data
	Else
		DX_OPSENSCAL.CalcEx 0, S20023.Data, S31023.Data, S20034.Data
	End If

	   iv.Data = DX_OPSENSCAL.iv
	delta.Data = DX_OPSENSCAL.delta
	gamma.Data = DX_OPSENSCAL.gamma
	theta.Data = DX_OPSENSCAL.theta
  	 bega.Data = DX_OPSENSCAL.Vegga
	  low.Data = DX_OPSENSCAL.rho
	 irga.Data = DX_OPSENSCAL.TheoryValue

End Sub

