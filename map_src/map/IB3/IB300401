Dim row, col, f_cod, idx_mdjm, idx_msjm, pval, code, rgb, pcol, ridx, arr, arr2, ii, jj
idx_mdjm = 5
idx_msjm = 6
row = S90303.Row
col = S90303.Column

'SYSTEM.Trace "row[" & row & "] col[" & col & "] hpos[" & S90303.HitPos & "]"

If S90303.HitPos = 4 Then
	If col=5 Then
		For ii=1 To S90303.Rows
			code = Trim(S90303.GetGridCell(ii, 3))
'			SYSTEM.Trace "row[2] col[5] code[" & code & "]"
			If Len(code)=8 Then
				S90303.SetGridCell ii, 5, "1"
				S90303.SetGridCell ii, 6, "0"
			Else
				S90303.SetGridCell ii, 5, "0"
				S90303.SetGridCell ii, 6, "0"
			End If
		Next
	ElseIf col=6 Then
		For ii=1 To S90303.Rows
			code = Trim(S90303.GetGridCell(ii, 3))
'			SYSTEM.Trace "row[2] col[6] code[" & code & "]"
			If Len(code)=8 Then
				S90303.SetGridCell ii, 5, "0"
				S90303.SetGridCell ii, 6, "1"
			Else
				S90303.SetGridCell ii, 5, "0"
				S90303.SetGridCell ii, 6, "0"
			End If
		Next
	ElseIf col=12 Or col=14 Or col=15 Or col=16 Or col=18 Then
		For row=1 To S90303.Rows
			code = Trim(S90303.GetGridCell(row, 3))
			If Len(code)=8 Then
				pcol = CLng(Trim(S90303.GetGridCell(row, 10)))
				If (row Mod 2)=0 Then
					rgb = 77
				Else
					rgb = 68
				End If
				For ii=12 To 18
					S90303.SetPRgb row, ii, rgb
				Next
				S90303.SetPRgb row, col, 78
				S90303.SetGridCell row, 10, col
				S90303.SetGridCell row, 8, Trim(S90303.GetGridCell(row, col))
			End If
		Next
	End If
ElseIf S90303.HitPos = 3 Then
	code = Trim(S90303.GetGridCell(row, 3))
	If col=2 Then ' 체크박스 검증
		If Len(code)<>8 Then
			S90303.SetGridCell row, col, "0"
		End If
	ElseIf col=3 Then	' 종목코드 선택
		If SelDialog.DoSelect() Then
			arr = Split(Trim(SelDialog.GetProperties()), "#")
			For ii=0 To UBound(arr)
				arr2 = Split(arr(ii), "|")
				If UBound(arr2)>0 Then
					S90303.SetGridCell row+ii, 2, "1"
					S90303.SetGridCell row+ii, 3, arr2(0)
					If Trim(arr2(1))="1" Then
						S90303.SetGridCell row+ii, 5, "1"
						S90303.SetGridCell row+ii, 6, "0"
					ElseIf Trim(arr2(1))="2" Then
						S90303.SetGridCell row+ii, 5, "0"
						S90303.SetGridCell row+ii, 6, "1"
					End If
					If UBound(arr2)>=2 Then
						S90303.SetGridCell row+ii, 7, Trim(arr2(2))
					Else
						S90303.SetGridCell row+ii, 7, ""
					End If
				End If
			Next
			Call RequestSise()
		End If
	ElseIf col=4 Then	' 삭제버튼 클릭
		'S90303.Index row-1
		S90303.RemoveRow row-1
		Call RequestSise()
	ElseIf col=9 Then	' 주문상태 클
		pval = Trim(S90303.GetGridCell(row, col))
		If Len(pval)>7 Then
			MsgBox Right(pval, Len(pval)-7), vbOKOnly, "IBK투자증권"
		End If
	ElseIf col=idx_mdjm Or col=idx_msjm Then	' 매도/매수 선택
		If Len(code)<>8 Then
			S90303.SetGridCell row, idx_mdjm,"0"
			S90303.SetGridCell row, idx_msjm,"0"
			Exit Sub
		End If

		If col=idx_mdjm Then
			S90303.SetGridCell row, idx_mdjm,"1"
			S90303.SetGridCell row, idx_msjm,"0"
		Else
			S90303.SetGridCell row, idx_mdjm,"0"
			S90303.SetGridCell row, idx_msjm,"1"
		End If
	ElseIf col=12 Or col=14 Or col=15 Or col=16 Or col=18 Then
		If Len(code)<>8 Then
			Exit Sub
		End If

		pcol = CLng(Trim(S90303.GetGridCell(row, 10)))

		If (row Mod 2)=0 Then
			rgb = 77
		Else
			rgb = 68
		End If
		For ii=12 To 18
			S90303.SetPRgb row, ii, rgb
		Next

		If pcol=col Then
			S90303.SetGridCell row, 10, "-1"
			S90303.SetGridCell row, 8, ""
		Else
			S90303.SetPRgb row, col, 78
			S90303.SetGridCell row, 10, col
			S90303.SetGridCell row, 8, Trim(S90303.GetGridCell(row, col))
		End If
	End If
End If
