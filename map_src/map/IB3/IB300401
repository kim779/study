_AW_ONDECLARE_AW_
Sub OnAlert()
	Dim ii, val, code
	For ii=1 To S90303.Rows
		code = Trim(S90303.GetGridCell(ii,3))
		val = Trim(S90303.GetGridCell(ii,10))
		If Len(code)=8 And Len(val)>0 Then
			val = CLng(val)
			If val>0 Then
				S90303.SetGridCell ii, 8, Trim(S90303.GetGridCell(ii, val))
			End If
		End If
	Next
End Sub

Sub DisablePriceTrace()
	Dim row, jj, rgb
	For row=1 To S90303.Rows
		S90303.SetGridCell row, 10, -1

		Select Case (row Mod 2)
			Case 0		rgb=77
			Case 1		rgb=68
		End Select
		For jj=12 To 18
			S90303.SetPRgb row, jj, rgb
		Next
	Next
End Sub

Sub RequestSise()
	SCREEN.Send 0
End Sub

Sub DoMultiSelect()
	If SelDialog.DoSelect() Then
		row = 1
		S90303.Clear
		arr = Split(Trim(SelDialog.GetProperties()), "#")
		For ii=0 To UBound(arr)
			arr2 = Split(arr(ii), "|")
			If UBound(arr2)>0 Then
				S90303.SetGridCell row+ii, 2, "1"
				S90303.SetGridCell row+ii, 3, arr2(0)
				If Trim(arr2(1))="1" Then
					S90303.SetGridCell row+ii, 5, "1"
					S90303.SetGridCell row+ii, 6, "0"
				ElseIf Trim(arr2(1))="2" Then
					S90303.SetGridCell row+ii, 5, "0"
					S90303.SetGridCell row+ii, 6, "1"
				End If
				If UBound(arr2)>=2 Then
					S90303.SetGridCell row+ii, 7, Trim(arr2(2))
				Else
					S90303.SetGridCell row+ii, 7, ""
				End If
			End If
		Next
		Call RequestSise()
	End If
End Sub

Sub CheckBtnAll()
	Dim ii, code, val, jqty

	If chk_all.Checked Then
		val = "1"
	Else
		val = "0"
	End If

	For ii=1 To S90303.Rows
		code = Trim(S90303.GetGridCell(ii, 3))
		jqty = Trim(S90303.GetGridCell(ii, 7))
		If Len(code)=8 Then
			S90303.SetGridCell ii, 2, val
		End If
	Next
End Sub

Sub SetItemPrice(row, htick)
	Dim code, rgb, col
	code = Trim(S90303.GetGridCell(row, 3))
	If Len(code)=8 Then
		Select Case (row Mod 2)
			Case 0		rgb=77
			Case 1		rgb=68
		End Select
		For jj=12 To 18
			S90303.SetPRgb row, jj, rgb
		Next

		Select Case htick
			Case -2	col=12
			Case -1	col=14
			Case  0	col=15
			Case  1	col=16
			Case  2	col=18
		End Select

		S90303.SetPRgb row, col, 78
		S90303.SetGridCell row, 10, col
		S90303.SetGridCell row, 8, Trim(S90303.GetGridCell(row, col))
	End If
End Sub

Sub SetPrice(htick)
	Dim ii
	For ii=1 To S90303.Rows
		If S90303.GetGridCell(ii, 5)="1" Then		' 매도주문 -> 매수1호가에 세팅!
			Call SetItemPrice( ii, 1 )
		ElseIf S90303.GetGridCell(ii, 6)="1" Then	' 매수주문 -> 매도1호가에 세팅!
			Call SetItemPrice( ii, -1)
		End If
	Next
End Sub

Sub ClearJumun()
	Dim ii
	chk_all.Checked = False
	For ii=1 To S90303.Rows
		S90303.SetGridCell ii, 2, "0"
	Next
End Sub

Sub SelectMany(stype)
	Dim ii, code, mmgb, fchar
	For ii=1 To S90303.Rows
		code = Trim(S90303.GetGridCell(ii,3))
		If Len(code)=8 Then
			fchar = Left(code, 1)
			If S90303.GetGridCell(ii, 5)="1" Then
				mmgb = 1
			ElseIf S90303.GetGridCell(ii, 6)="1" Then
				mmgb = 2
			Else
				mmgb = -1
			End If

			If mmgb<>-1 Then
				If stype="UP" Then
					If mmgb=2 And (fchar="1" Or fchar="2") Then
						S90303.SetGridCell ii, 2, "1"
					ElseIf mmgb=1 And fchar="3" Then
						S90303.SetGridCell ii, 2, "1"
					Else
						S90303.SetGridCell ii, 2, "0"
					End If
				ElseIf stype="DN" Then
					If mmgb=1 And (fchar="1" Or fchar="2") Then
						S90303.SetGridCell ii, 2, "1"
					ElseIf mmgb=2 And fchar="3" Then
						S90303.SetGridCell ii, 2, "1"
					Else
						S90303.SetGridCell ii, 2, "0"
					End If
				End If
			End If
		End If
	Next
End Sub

'4101에서 호출
Sub DominoSelect(data)
	row = 1
	S90303.Clear
	arr = Split(Trim(data), "#")
	For ii=0 To UBound(arr)
		arr2 = Split(arr(ii), "|")
		If UBound(arr2)>0 Then
			S90303.SetGridCell row+ii, 2, "1"
			S90303.SetGridCell row+ii, 3, arr2(0)
			If Trim(arr2(1))="1" Then
				S90303.SetGridCell row+ii, 5, "1"
				S90303.SetGridCell row+ii, 6, "0"
			ElseIf Trim(arr2(1))="2" Then
				S90303.SetGridCell row+ii, 5, "0"
				S90303.SetGridCell row+ii, 6, "1"
			End If

			S90303.SetGridCell row+ii, 7, arr2(2)

			If UBound(arr2)>=3 Then
				S90303.SetGridCell row+ii, 8, Trim(arr2(3))
			Else
				S90303.SetGridCell row+ii, 8, ""
			End If
		End If
	Next
	Call RequestSise()
End Sub

