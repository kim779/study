RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub OnAlert()
	Dim ii, val, code
	For ii=1 To S90303.Rows
		code = Trim(S90303.GetGridCell(ii,3))
		val = Trim(S90303.GetGridCell(ii,13))
		If Len(code)=8 And Len(val)>0 Then
			val = CLng(val)
			If val>0 Then
				S90303.SetGridCell ii, 11, Trim(S90303.GetGridCell(ii, val))
			End If
		End If
	Next
End Sub

Sub DisablePriceTrace()
	Dim row, jj, rgb
	For row=1 To S90303.Rows
		S90303.SetGridCell row, 13, -1

		Select Case (row Mod 2)
			Case 0		rgb=77
			Case 1		rgb=68
		End Select
		For jj=15 To 22
			S90303.SetPRgb row, jj, rgb
		Next
	Next
End Sub


Sub QueryMicheg()
	S90303.Clear
	OBJ_Miche.Proc "first_send", ""
End Sub

Sub ClearJumun()
	Dim ii
	chk_all.Checked = False
	For ii=1 To S90303.Rows
		S90303.SetGridCell ii, 2, "0"
	Next
End Sub

Sub CheckBtnAll()
	Dim ii, code, val, jqty

	If chk_all.Checked Then
		val = 1
	Else
		val = 0
	End If

	For ii=1 To S90303.Rows
		code = Trim(S90303.GetGridCell(ii, 3))
		jqty = Trim(S90303.GetGridCell(ii, 11))
		If Len(code)=8 Then
			S90303.SetGridCell ii, 2, val
		End If
	Next
End Sub

Sub OnEndQueryMicheg()
	Dim mgrid, code, mkgb, ii, ridx, mmgb
	Set mgrid = SCREEN.Object("OBJ_Miche.VIEWGRID")

	ridx = 1
	For ii=1 To mgrid.Rows
		code = Trim(mgrid.GetGridCell(ii, 7))
		If Mid(code,2,2)="01" Or Mid(code, 2, 2) = "05" Or Mid(code, 2, 2) = "09" Then		' 금리/통화/상품선물은 제외(poop미지원)
			If ridx>100 Then
				MsgBox "최대 미체결내역 조회건수는 100건 입니다.", vbOKOnly, "IBK투자증권"
				Exit For
			End If
			S90303.SetGridCell ridx,  2, "1"
			S90303.SetGridCell ridx,  3, code
			S90303.SetGridCell ridx,  4, Trim(mgrid.GetGridCell(ii, 5))

			mmgb = Trim(mgrid.GetGridCell(ii, 9))
			S90303.SetGridCell ridx,  5, mmgb
			If mmgb="매도" Then
				S90303.SetTRgb ridx, 5, 95
			Else
				S90303.SetTRgb ridx, 5, 94
			End If
			S90303.SetGridCell ridx,  6, Trim(mgrid.GetGridCell(ii, 12))
			S90303.SetGridCell ridx,  7, Trim(mgrid.GetGridCell(ii, 15))
			S90303.SetGridCell ridx,  8, Trim(mgrid.GetGridCell(ii, 11))
			S90303.SetGridCell ridx,  9, Trim(mgrid.GetGridCell(ii, 14))
			S90303.SetGridCell ridx, 10, Trim(mgrid.GetGridCell(ii, 17))
			ridx = ridx + 1
		End If
	Next
	SCREEN.Send 0
End Sub


Sub SetItemPrice(row, htick)
	Dim code, rgb, col
	'MsgBox row & ", " & htick
	code = Trim(S90303.GetGridCell(row, 3))
	If Len(code)=8 Then
		Select Case (row Mod 2)
			Case 0		rgb=77
			Case 1		rgb=68
		End Select
		For jj=15 To 22
			S90303.SetPRgb row, jj, rgb
		Next

		Select Case htick
			Case -2	col=15
			Case -1	col=17
			Case  0	col=18
			Case  1	col=19
			Case  2	col=21
		End Select

		S90303.SetPRgb row, col, 78
		S90303.SetGridCell row, 13, col
		S90303.SetGridCell row, 11, Trim(S90303.GetGridCell(row, col))
	End If
End Sub

Sub SetPrice(htick)
	Dim ii, mmgb
	For ii=1 To S90303.Rows
		mmgb = Trim(S90303.GetGridCell(ii, 5))
		If mmgb="매도" Then		' 매도주문 -> 매수1호가에 세팅!
			Call SetItemPrice( ii, 1 )
		ElseIf mmgb="매수" Then	' 매수주문 -> 매도1호가에 세팅!
			Call SetItemPrice( ii, -1)
		End If
	Next
End Sub

_AW_ONRECEIVE_AW_
Dim ii
For ii=1 To S90303.Rows
	S90303.SetGridCell ii, 13, "-1"
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(90303)
_AW_ONCLICK_AW_
Dim row, col, f_cod, idx_mdjm, idx_msjm, pval, code, rgb, pcol, ridx

row = S90303.Row
col = S90303.Column

'SYSTEM.Trace "row[" & row & "], col[" & col & "]"

If S90303.HitPos = 4 Then
	If col=15 Or col=17 Or col=18 Or col=19 Or col=21 Then
		For row=1 To S90303.Rows
			code = Trim(S90303.GetGridCell(row, 3))
			If Len(code)<>8 Then
				Exit Sub
			End If

			pcol = CLng(Trim(S90303.GetGridCell(row, 13)))

			If (row Mod 2)=0 Then
				rgb = 77
			Else
				rgb = 68
			End If
			For ii=15 To 22
				S90303.SetPRgb row, ii, rgb
			Next

			S90303.SetPRgb row, col, 78
			S90303.SetGridCell row, 13, col
			S90303.SetGridCell row, 11, Trim(S90303.GetGridCell(row, col))
		Next
	End If
ElseIf S90303.HitPos = 3 Then
	code = Trim(S90303.GetGridCell(row, 3))
	If col=2 Then ' 체크박스 검증
		If Len(code)<>8 Then
			S90303.SetGridCell row, col, "0"
		End If
	ElseIf col=15 Or col=17 Or col=18 Or col=19 Or col=21 Then
		If Len(code)<>8 Then
			Exit Sub
		End If

		pcol = CLng(Trim(S90303.GetGridCell(row, 13)))

		If (row Mod 2)=0 Then
			rgb = 77
		Else
			rgb = 68
		End If
		For ii=15 To 22
			S90303.SetPRgb row, ii, rgb
		Next

		If pcol=col Then
			S90303.SetGridCell row, 13, "-1"
			S90303.SetGridCell row, 11, ""
		Else
			S90303.SetPRgb row, col, 78
			S90303.SetGridCell row, 13, col
			S90303.SetGridCell row, 11, Trim(S90303.GetGridCell(row, col))
		End If
	ElseIf col=12 Then	' 주문상태 클
		pval = Trim(S90303.GetGridCell(row, col))
		If Len(pval)>5 Then
			MsgBox Right(pval, Len(pval)-5), vbOKOnly, "IBK투자증권"
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(chk_all)
_AW_ONCLICK_AW_
Call CheckBtnAll()
'SCREEN.SetTimer 1, False
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Call CheckBtnAll()
