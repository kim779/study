'***************************************************************************
' DESC: clear_check()
'***************************************************************************
Sub clear_check()
	CHECK0.Checked = False
	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell (ii, 1)) = "" Then
			Exit Sub
		End If
		If GRID0.GetGridCell(ii, 15) = "1" Then
			GRID0.SetGridCell ii, 15, "0"
		End If
	Next
End Sub

'***************************************************************************
' DESC: chkcnt()
'***************************************************************************
Function chkcnt()
	Dim gcnt
	gcnt = 0

	chkcnt = False
	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(ii, 15)) = 1 Then
			gcnt = gcnt + 1
		End If
	Next

	If gcnt > 0 Then
		chkcnt = True
	Else
		CHECK0.Checked = False
	End If
End Function

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_chk(Flag)
	For ii = 1 To GRID0.Rows
		If Trim(GRID0.GetGridCell (ii, 1)) = "" Then
			Exit Sub
		End If

		val = Trim(GRID0.GetGridCell (ii, 5)) '청산가능수량

		If val <> "" Then
				GRID0.SetGridCell ii, 15, Flag
		End If
	Next
End Sub

Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False
	GRID0.Clear

	If Trim(account.Data) = "" Or Len(Trim(account.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zpwd.Data) = "" Or Len(Trim(zpwd.Data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Exit Function
		End If
	End If

	Error_check = True
End Function

