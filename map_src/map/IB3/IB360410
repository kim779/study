'***************************************************************************
' DESC: 주문전송
'***************************************************************************
Sub DoOrder()
	Dim hogb, cPos, dmsg
	Dim sHnam

	init_data2()										'주문 기본세팅

	If Error_check2() = False Then			'주문전 Error Check
		flash_fg.Data = 0
		Exit Sub
	End If

	sHnam = Replace(Mid(SCREEN.Object("OBJ_hnam.1022").Data,2), "/","／")
	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		hogb = Mid(shogb.Text, 4)		'매매구분
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("main.OBJ_order.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & sHnam & vbLf &_
			"o_hogb" & vbTab & hogb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & ed_jprc.Data & vbLf
		If R_cash.Checked Then
			SCREEN.CreateWindow 2, "IB36041A /p5 /d", dmsg
		Else
			dmsg = dmsg & "o_sygb" & vbTab & c_sygb.Text & vbLf
			SCREEN.CreateWindow 2, "IB10015B /p5 /d", dmsg
		End If

		If SYSTEM.Pop("stock_mado_order") <> "OK" Then
			flash_fg.Data = 0
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")
	flash_fg.Data = 0

	cPos = OrdCfg.ReadCfg("CursorPos")
	Select Case cPos
		Case "0" : SCREEN.Object("main.OBJ_order.AN1A").SetFocus()
		Case "1" : SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus()
		Case "2" : S1301.SetFocus()
		Case "3" : ed_jqty.SetFocus()
		Case "4" : ed_jprc.SetFocus()
	End Select
End Sub

Sub Query_Qty()
	ed_acno.Data = SCREEN.Object("main.OBJ_order.AN1A").Data
	ed_pswd.Data = SCREEN.Object("main.OBJ_order.ed_pswd").Data

	'== obj:: send_tr(acno, pwd, mmgb, cod2, pric)
	Dim	param
	If R_credit.Checked Then
'		Dim dat
'		Dim dat2
'		dat = change_date ("d" , 2 )
'		dat2 = week_check( dat)
'		ILJAA.Data = dat2
