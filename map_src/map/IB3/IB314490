	mapNm = Left(Trim(SCREEN.GetMapName(1)), 6)

	Select Case tab_order.ID
		Case 1 : mapNm = mapNm & "50"
		Case 2 : mapNm = mapNm & "60"
		Case 3 : mapNm = mapNm & "70"
	End Select

	OBJ_odr.SetObject mapNm
End Sub

