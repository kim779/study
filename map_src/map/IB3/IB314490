Sub Set_account()
	ACNM.Data = AN20.name
	ed_pswd.Data = AN20.Password
	SCREEN.Proc "main.Set_account", "jumn"
	SCREEN.Object("obj_odr.o_jmno").Clear
	SCREEN.Object("main.guide").Text = ""
