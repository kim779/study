RESOURCE DIVISION
{


_AW_ONDECLARE_AW_

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False
	grid.Clear

	If Trim(accn.Data) = "" Or Len(Trim(accn.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zpwd.Data) = "" Or Len(Trim(zpwd.Data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Exit Function
		End If
	End If

	Error_check = True
End Function

Sub Send_c()
	grid.SetDataPosition(2)
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub


Sub Send_f()
	grid.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"
LEDGER.Fkey = "C"
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.Object("parent.guide").text = ""
accn.Data = Trim(SCREEN.Object("main.OBJ_order.AN20").Data)		'계좌번호
zpwd.Data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)	'비밀번호
'
If Error_check() = False Then				'주문전 Error Check
	SCREEN.OnSend = False
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii

For ii = 1 To grid.Rows
	If Trim(grid.GetGridCell(ii, 3)) = "매수" Then
		grid.SettRgb ii, 3, 94
	ElseIf Trim(grid.GetGridCell(ii, 3)) = "매도" Then
		grid.SettRgb ii, 3, 95
	End If
Next

If LEDGER.Next = "Y" Then
	'Call Send_c()
	SCREEN.SetTimer 1, False
Else

End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call Send_c()

