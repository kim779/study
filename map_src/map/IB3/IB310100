'***************************************************************************
' DESC: clear_check
'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, c_code)) = "" Then
			Exit For
		End If

		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
	btn_chk()
End Sub

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, c_code)) = "" Then
			Exit For
		End If
		VIEWGRID.SetGridCell ii, 1, Flag
	Next
	btn_chk()
End Sub
'***************************************************************************
' DESC: 가변로우인경우 처음조회시 체크안되는거 방지
'***************************************************************************
Sub set_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		VIEWGRID.SetGridCell ii, 1,"0"
	Next
	btn_chk()
End Sub

Sub btn_chk()
	Dim cnt, ii

	cnt = 0
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, c_code)) = "" Then
			Exit For
		End If
		If VIEWGRID.getGridCell(ii, 1) = "1" And Trim(VIEWGRID.GetGridCell (ii, c_wqty)) > "0" Then
			cnt = cnt +1
		End If
	Next

	If cnt > 0 Then
		btn_m.Enable = True
		btn_c.Enable = True
	Else
		btn_m.Enable = False
		btn_c.Enable = False
		allCheck.Checked = False
	End If
End Sub
'***************************************************************************
' DESC: first_send
'***************************************************************************
Sub first_send()
	LEDGER.Fkey = "C"
	VIEWGRID.Clear
	SCREEN.Send 0
End Sub

'***************************************************************************
' DESC: 종목코드 변경시
'***************************************************************************
Sub code_change()
	Dim name, major, minor

	major = Left(focod.Data,1)
	minor = Mid(focod.Data, 2, 2)
	If Trim(major) = "" Then
		HNAM.Data = ""
		Exit Sub
	ElseIf major = "1" Or major = "4" Or major = "A" Or major = "D" Then
		name = SCREEN.GetName(101, focod.data, 0)'지수선물
	Else
		If minor < 10 Then
			name = SCREEN.GetName(102, focod.data, 0)'지수옵션
		Else
			name = SCREEN.GetName(108, focod.data, 0)'주식옵션
		End If
	End If

	If Trim(name) = "" Then
		HNAM.Data = ""
		focod.Data = ""
		Exit Sub
	End If
	HNAM.Data = name
	If Trim(AN20.Data) = "" Or Trim(zPwd.Data) = "" Then
		Exit Sub
	End If
	Call first_send()
End Sub

'***************************************************************************
' DESC: 계좌명/비밀번호 Setting
'***************************************************************************
Sub Set_account()
	SCREEN.Object("parent.guide").text = ""
	ACNM.Data = AN20.name
	zPwd.Data = AN20.Password

	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If

'	If Trim(zPwd.Data) <> "" Then
'		Call first_send()
'	Else
