'	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call first_send()
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim ret, msg
	GUIDE.Text = ""
	SCREEN.Object("obj.guide").text = ""
	Error_check = False
	S901.Clear
	VIEWGRID.Clear

	If CheckInput(AN20, zPwd) = False Then
		Exit Function
	End If
	If SYSTEM.ConnectBy = "1" Then
		ret = P_pswdConfirm(AN20.data, zPwd.data, msg)
		If ret <> True Then
			zPwd.SetFocus
			GUIDE.Text = msg
			SCREEN.Object("obj.guide").text = msg
			Exit Function
		End If
	End If

	Error_check = True
End Function

