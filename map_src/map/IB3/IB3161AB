	S103310.SetGridCell 1, 7, Null_check(ArrData(6)) + cvol
	S103310.SetGridCell 1, 8, ArrData(7)
	S103310.SetGridCell 1, 9, ArrData(8)
 	S103310.SetGridCell 1, 10, mgvl
	S103310.SetGridCell 1, 11, ArrData(10)
	S103310.SetGridCell 1, 12, ArrData(11)

	g_ArrInput(1) = ADateTime
