'TimeType, GridLastDate or GridLastTime
'-----------------------------------------------------------------------
Function Null_check(Data)
	If Trim(data) = "" Then
		Null_check = 0
		Exit Function
	End If
	Null_check  = CLng(Data)
End Function
'-----------------------------------------------------------------------
Function SetPrcSign(Diff, Data)
	Giho = Mid(LTrim(Diff), 1, 1)
	If Giho = "1" Or Giho = "2" Then
		SetPrcSign = "+" & LTrim(Data)
	ElseIf Giho = "4" Or Giho = "5" Then
		SetPrcSign = "-" & LTrim(Data)
	Else
		SetPrcSign = Data
	End If
End Function
'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	If Data > 0 Then
		SetSign = "+" & Data
	End If
End Function
'-----------------------------------------------------------------------
Function SetTimeElement(Element)
	If Len(Element) = 1 Then
		Element = "0" & Element
	End If
	SetTimeElement = Element
End Function
'-----------------------------------------------------------------------
Function GetTime(SrcTime, MinGap)
	SrcTime = SrcTime - SrcTime Mod MinGap + MinGap
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = Mid(SrcTime, 1, 2)
	AMin = CLng(Mid(SrcTime, 3, 2))
	AMin = AMin - AMin Mod MinGap

	ADate = TimeSerial(AHour, AMin + MinGap, ASec)

	AHour = SetTimeElement(Hour(ADate))
	AMin = SetTimeElement(Minute(ADate))
	ASec = SetTimeElement(Second(ADate))


	GetTime = AHour & AMin & ASec
End Function
