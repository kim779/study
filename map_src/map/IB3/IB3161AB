	If mgvl > 0 Then
		mgvl = "+" & mgvl
	End If
	S103310.SetGridCell 1, 1, ADateTime
	S103310.SetGridCell 1, 2, ArrData(1)
	S103310.SetGridCell 1, 3, ArrData(2)
	S103310.SetGridCell 1, 4, ArrData(3)
	S103310.SetGridCell 1, 5, ArrData(4)
