_AW_ONDECLARE_AW_
Sub SetCfg()
	Dim val

	Select Case BuyQtyGB.Data
	Case "1" : R0_1.Checked = True
	Case "2" : R0_3.Checked = True
'	Case "3" : R0_2.Checked = True
	Case Else : R0_0.Checked = True
	End Select
	ChangeR0()

	If Trim(BuyPrcGB.Data) = "" Then
		BuyPrcGB.Data = "023"
	End If

	cboPrice2.Data = BuyPrcGB.Data

	Select Case SellQtyGB.Data
	Case "1" : R1_1.Checked = True
	Case "2" : R1_2.Checked = True
	Case "3" : R1_3.Checked = True
	Case Else : R1_0.Checked = True
	End Select
	ChangeR1()

	If Trim(SellPrcGB.Data) = "" Then
		SellPrcGB.Data = "023"
	End If
	cboPrice3.Data = SellPrcGB.Data

	If (Trim(JJPrcGB.Data) = "") Then
		JJPrcGB.Data = "1"
	End If
	Select Case CLng(JJPrcGB.Data)
	Case 0
		R4_2.Checked = True
	Case 1
		R4_1.Checked = True
	Case Else
		R4_0.Checked = True
	End Select

End Sub

Sub SaveCfg()
	If R0_0.Checked Then
		BuyQtyGB.Data = "0"
	ElseIf R0_1.Checked Then
		BuyQtyGB.Data = "1"
'	ElseIf R0_2.Checked Then
'		BuyQtyGB.Data = "3"
	ElseIf R0_3.Checked Then
		BuyQtyGB.Data = "2"
	End If

	If R1_0.Checked Then
		SellQtyGB.Data = "0"
	ElseIf R1_1.Checked Then
		SellQtyGB.Data = "1"
	ElseIf R1_2.Checked Then
		SellQtyGB.Data = "2"
	ElseIf R1_3.Checked Then
		SellQtyGB.Data = "3"
	End If

	BuyPrcGB.Data = cboPrice2.Data
	SellPrcGB.Data = cboPrice3.Data

	If R4_0.Checked Then
		JJPrcGB.Data = 2
	ElseIf R4_1.Checked Then
		JJPrcGB.Data = 1
	ElseIf R4_2.Checked Then
		JJPrcGB.Data = 0
	End If

	BuyQtyGB.Trigger "", False
	BuyFixQty.Trigger "", False
	BuyFixPrcQty.Trigger "", False
	BuyPrcGB.Trigger "", False
	SellQtyGB.Trigger "", False
	SellFixQty.Trigger "", False
	SellFixPrcQty.Trigger "", False
	SellPrcGB.Trigger "", False
	JJPrcGB.Trigger "", False
End Sub

