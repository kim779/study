Sub autosend()
	Dim autoi
	autoi = FormatDateTime(Time, 4)
	autoi = Replace(autoi,":","")
	If autoi >= 0900 And autoi =< 1830 Then
		SCREEN.SetTimer 600, False
	End If
End Sub

