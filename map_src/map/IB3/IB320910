RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN20.Name
	zPwd.Data = AN20.Password
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'비밀번호 오류
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2,2
	SCREEN.Object("main.ACNM").data = SCREEN.Object("main.AN20").Name
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus
End If

If LEDGER.Ecod = "3024" Then
	SCREEN.ClearAll 2,2
	SCREEN.Object("main.ACNM").data = SCREEN.Object("main.AN20").Name
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus
End If

SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg

'메인 그리드에 데이터 삽입하기
'구분값에 맞춰서 종목코드 비교후 맞을 경우 해당열에 잔고와 평균가 삽입
'종목코드 가운데 숫자 비교
Dim ii, jj, object_code, main_code, tp, remain_money, normal_cost, change_cost

For ii=1 To GRID0.Rows
	object_code = Trim(GRID0.GetGridCell(ii, 1))
	tp = Left(object_code, 1)

	For jj=1 To SCREEN.Object("main.GRID").Rows
		'2 : 콜   3 : 풋
		If tp = "2" Or tp = "B" Then
			'메인그리드  : 콜종목번호 1 : 풋종목번호 9
			main_code = Trim(SCREEN.Object("main.GRID").GetGridCell(jj, 1))
		ElseIf tp = "3" Or tp = "C" Then
			main_code = Trim(SCREEN.Object("main.GRID").GetGridCell(jj, 9))
		End If

		If object_code = main_code Then
			'맞을 경우 잔고와 평균가 삽입
			remain_money = Trim(GRID0.GetGridCell(ii, 3))
			normal_cost = GRID0.GetGridCell(ii, 6)
			change_cost = FormatNumber((normal_cost), 2, 0, 0, 0)'Left(normal_cost, 13)


			If tp = "2" Or tp = "B" Then
				'Call alert_msg(Remain_money)
				SCREEN.Object("main.GRID").SetGridCell jj, 4, remain_money
				SCREEN.Object("main.GRID").SetGridCell jj, 5, change_cost
			ElseIf tp = "3" Or tp = "C" Then
				'Call alert_msg(Remain_money)
				SCREEN.Object("main.GRID").SetGridCell jj, 13, remain_money
				SCREEN.Object("main.GRID").SetGridCell jj, 12, change_cost
			End If
		End If
	Next
Next

'포커스
If SCREEN.Object("main.selection").data = "1" Then
	SCREEN.Object("main.zPwd").SetFocus
ElseIf SCREEN.Object("main.selection").data = "2" Then
	SCREEN.Object("main.send_btn").SetFocus
ElseIf SCREEN.Object("main.selection").data = "3" Then
	SCREEN.Object("main.zPdGrpCode").SetFocus
ElseIf SCREEN.Object("main.selection").data = "4" Then
	SCREEN.Object("main.MGYM").SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


