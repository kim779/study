_AW_ONDECLARE_AW_

Sub data_split(sdata)
	Dim MyData
	Mydata = Split(sdata, "|", -1, 1)
	Call TABLE0.SetTableCell(1,Mydata(0))
	Call TABLE0.SetTableCell(2,Mydata(1))
	Call TABLE0.SetTableCell(3,Mydata(3))
	Call TABLE0.SetTableCell(4,Mydata(4))
	Call TABLE0.SetTableCell(5,Mydata(7))
	Call TABLE0.SetTableCell(6,Mydata(5))
	Call TABLE0.SetTableCell(7,Mydata(6))
	ed_pswd.Data = Mydata(2)
	ed_acno.Data = Mydata(0)
	ed_ogno.Data = Mydata(6)
	ed_fcod.Data = Mydata(3)
	ed_jqty2.Data = Mydata(5)
	If InStr(1, "매수", Mydata(4), 1) <> 0 Then
		LABEL24.TRgb = 94
	Else
		LABEL24.TRgb = 95
	End If
	LABEL24.Data = Trim(TABLE0.GetTableCell(4))+"주문을 취소 하시겠습니까?"
	SCREEN.Object("OBJ_sise.100301").data = Mydata(3)
	OBJ_sise.Send

	Call Hoga_unit(Trim(ed_fcod.Data))

	ed_jprc.Data = Replace(Trim(Mydata(7)), ",", "")

End Sub

Sub SetPrcVisible(vis)
	LABEL1.Visible = vis
	ed_jprc.Visible = vis
	c_pric.Visible = vis
End Sub

Sub SetQtyVisible(vis)
	LABEL2.Visible = vis
	ed_jqty.Visible = vis
	c_jqty.Visible = vis
End Sub

Sub ChangeOrderType(tp)
	ed_mmgb2.Data = tp
	Select Case tp
		Case "2"
			Call SetPrcVisible(True)
			Call SetQtyVisible(False)
			ed_mmgb.Data = "3"
			ed_jqty.Data = 0
			JUMUN_B.Text = "전부정정"
			LABEL24.Data = Trim(TABLE0.GetTableCell(4))+"주문을 정정 하시겠습니까?"
			ed_jprc.SetFocus
		Case "1"
			Call SetPrcVisible(False)
			Call SetQtyVisible(False)
			ed_mmgb.Data = "4"
			JUMUN_B.Text = "전부취소"
			LABEL24.Data = Trim(TABLE0.GetTableCell(4))+"주문을 취소 하시겠습니까?"
			ed_jqty.Data = 0
	End Select
End Sub

Sub DoOrder()
	OBJ_snd.Send
End Sub

Sub AfterClose()
	SCREEN.CloseWindow
End Sub

