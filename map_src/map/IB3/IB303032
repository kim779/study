_AW_ONDECLARE_AW_
desc1.Text = "* 대용증권의 매도금액은 D+2일에"&vbLf&_
			"  선물계좌로 입금되오니 원치 않을"&vbLf&_
			"  경우 대용지정 해지 후 주문하시기"&vbLf&_
			"  바랍니다."

desc2.Text = "* 대용증권 매도에 따른 가입금액은"&vbLf&_
			"  인출가능금액 및 주문가능금액으로"&vbLf&_
			"  사용하실 수 없습니다."&vbLf&_
			"  (단, 매도체결금액이 대용금액 보다"&vbLf&_
			"  큰 경우 차액 만큼 주문 가능합니다.)"

Sub first_send()
	b_next.Enable = False
	SCREEN.Send 0
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False

	If Trim(ed_accn.Data) = "" Or Len(Trim(ed_accn.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Trim(ed_pswd.Data) = "" Or Len(Trim(ed_pswd.Data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하십시오."
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Exit Function
		End If
	End If

	ret = P_pswdConfirm(ed_accn.data, ed_pswd.data, msg)
	If ret <> True Then
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		SCREEN.Object("main.GUIDE").Text = msg
		Exit Function
	End If

	Error_check = True
End Function

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
first_send()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.Object("Main.GUIDE").Text = ""
SCREEN.ClearAll 0, 2

ed_accn.data = Trim(SCREEN.Object("main.OBJ_order.AN1A").Data)
ed_pswd.data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)

If b_next.Enable = False Then
	LEDGER.Fkey = "C"
Else
	LEDGER.Fkey = "7"
End If

If Error_check() = False Then				'주문전 Error Check
	SCREEN.OnSend = False
	Exit Sub
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

If LEDGER.Next = "Y" Then
	b_next.Enable = True
Else
	b_next.Enable = False
End If

