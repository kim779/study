				s_data = accn & "|" & s_data				'계좌번호	5
				s_data = "3" & "|" & s_data					'매매구분	4
				s_data = mkgb2 & "|" & s_data				'시장구분	3
				smkgb = VIEWGRID.GetGridCell(ii, 7) '시장구분자 1:KRX 2:NXT 6:동경 K:KRX N:NXT J:동경
				Select Case Trim(smkgb) '시장구분자 1:KRX 2:NXT 6:동경 K:KRX N:NXT J:동경
				Case "1", "K"
				s_data = "1" & "|" & s_data '주문유형 2
				Case "2", "N"
				s_data = "N" & "|" & s_data '주문유형 2
				Case Else
				s_data = "1" & "|" & s_data '주문유형 2
				End Select
				s_data = "1" & "|" & s_data					'CUD		1
			End If
		End If
	Next

	num.data = cnt

	If cnt > 0 Then
		num.Push ""
		SCREEN.CreateWindow 2, "IB110103 /p5 /d", "s_data" & vbTab & s_data & vbLf & "AN1A" & vbTab & AN1A.Data & vbLf & "pswd" & vbTab & SCREEN.Object("main.OBJ_order.ed_pswd").Data
		clear_check()
	End If

	If chkcnt() = False Then
		BUTTON0.Enable = False
		BUTTON2.Enable = False
	Else
		BUTTON0.Enable = True
		BUTTON2.Enable = True
	End If
