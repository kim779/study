_AW_ONDECLARE_AW_
Sub SetCfg()
	Select Case CursorPos.Data
	Case "1"
		R0_1.Checked = True
	Case "2"
		R0_2.Checked = True
	Case "3"
		R0_3.Checked = True
	Case "4"
		R0_4.Checked = True
	'Case "0"
	Case Else
		R0_0.Checked = True
	End Select

	Select Case JJCursorPos.Data
	Case "1"
		R1_1.Checked = True
	Case "2"
		R1_2.Checked = True
	'Case "3"
	'	R1_3.Checked = True
	'Case "0"
	Case Else
		R1_0.Checked = True
	End Select

	If ShortCutKey.Data = "1" Then
		chk2.Checked = True
	Else
		chk2.Checked = False
	End If

	If NotMoveCode.Data = "1" Then
		chk3_0.Checked = True
	Else
		chk3_0.Checked = False
	End If

	If msgPopup.Data = "1" Then
		chk3_1.Checked = True
	Else
		chk3_1.Checked = False
	End If

	If odrnumauto.Data = "1" Then
		chk4.Checked = True
	Else
		chk4.Checked = False
	End If
End Sub

Sub SaveCfg()
	If R0_1.Checked Then
		CursorPos.Data = "1"
	ElseIf R0_2.Checked Then
		CursorPos.Data = "2"
	ElseIf R0_3.Checked Then
		CursorPos.Data = "3"
	ElseIf R0_4.Checked Then
		CursorPos.Data = "4"
	Else
		CursorPos.Data = "0"
	End If

	If R1_1.Checked Then
		JJCursorPos.Data = "1"
	ElseIf R1_2.Checked Then
		JJCursorPos.Data = "2"
	Else
		JJCursorPos.Data = "0"
	End If

	If chk2.Checked Then
		ShortCutKey.Data = "1"
	Else
		ShortCutKey.Data = "0"
	End If

	If chk3_0.Checked Then
		NotMoveCode.Data = "1"
	Else
		NotMoveCode.Data = "0"
	End If

	If chk3_1.Checked Then
		msgPopup.Data = "1"
	Else
		msgPopup.Data = "0"
	End If

	If chk4.Checked Then
		odrnumauto.Data = "1"
	Else
		odrnumauto.Data = "0"
	End If

	CursorPos.Trigger "", False
	JJCursorPos.Trigger "", False
	ShortCutKey.Trigger "", False
	NotMoveCode.Trigger "", False
	msgPopup.Trigger "", False
	odrnumauto.Trigger "", False
End Sub

_AW_ONSTART_AW_
LBLIOC.Data = "- IOC(주문즉시 체결 그리고 잔량자동취소) : 숫자패드 ""/"" 키"
LBLFOK.Data = "- FOK(주문즉시 전부체결 또는 전부자동취소) : 숫자패드 ""*"" 키"

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
SaveCfg()

_AW_ONENDSUB_AW_
