RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
LEDGER.Fkey = "C"

LEDGER.Hsiz = 44
LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(Pwd.Data))
Pwd.Data = "HEAD"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim OrdNo,i

If Trim(Left(LEDGER.Ecod, 1)) = "0" Then
	If TrxTp.Data = "1" Then
		SCREEN.Object("parent.btn_jumn").Enable = True
		SCREEN.Proc "parent.OnSendReceive", ""
	Else
		SCREEN.Object("parent.btn_jumn").Enable = False
		SCREEN.Proc "parent.OnSendReceive", ""
	End If
		For ii=1 To SCREEN.Object("parent.GRID_out").Rows
			If SCREEN.Object("parent.GRID_out").GetGridCell(ii, 1) = "1" Then
				i = i+1
				OrdNo = Trim(GRID0.GetGridCell(i, 7))
				If Len(OrdNo)>0 Then
					Call SCREEN.Object("parent.GRID_out").SetGridCell(ii, 14, CLng(OrdNo))
				End If
			End If
		Next
Else
		SCREEN.Object("parent.btn_jumn").Enable = False
		SCREEN.Proc "parent.OnSendReceive", ""
		MsgBox LEDGER.Emsg, , "IBK투자증권"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



