Dim g_ArrHogaCtrl

g_ArrHogaCtrl = Array(Array(OBJ_hoga, S2023, S2024, S2033, S2027, S2403, LABEL0), obj_10Hoga, 0)
'0:5호가, 1:10호가, 2:최초 실행시 보여지는 화면 인덱스
'-----------------------------------------------------------------------
Sub ProcSetVisible(Index)
	If Index = "0" Then	' 호가컨트롤 표기
		For i = LBound(g_ArrHogaCtrl(0)) To UBound(g_ArrHogaCtrl(0))
			g_ArrHogaCtrl(0)(i).Visible = True
			If i = 0 Then
				OBJ_hoga.Proc "SetVisible", Index	' 호가컨트롤 Visible True
				obj_10Hoga.SetObject("IB10BLNK")	' 빈 화면
			End If
		Next

		g_ArrHogaCtrl(1).Visible = False	' 10호가 Visible False
	Else				' 10호가 화면 표기
		For i = LBound(g_ArrHogaCtrl(0)) To UBound(g_ArrHogaCtrl(0))
			g_ArrHogaCtrl(0)(i).Visible = False
			If i = 0 Then
				OBJ_hoga.Proc "SetVisible", Index	' 호가컨트롤 Visible False
				obj_10Hoga.SetObject("IB30002H")	' 10호가 맵
				obj_10Hoga.Proc "SetDangaObject", "Main.OBJ_order.OBJ_odr.ed_jprc"	' 클릭 주문단가 연결용
			End If
		Next
		g_ArrHogaCtrl(1).Visible = True		' 10호가 Visible True
	End If

	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB300021", "HOGA_INDEX", Index
	End If
End Sub

