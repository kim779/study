Sub Fixdanga()	'금액 매매
	Dim SellQtyGB, SellFixPrcQty, DanGa, qry
	Dim siseObjPath

	SellQtyGB = Trim(OrdCfg.ReadCfg("SellQtyGB"))

	If SellQtyGB <> "2" Then
		MsgBox "주문설정에서 매매금액을 설정하여 주십시오",0,"IBK투자증권"
		Exit Sub
	End If

	SellFixPrcQty = Trim(OrdCfg.ReadCfg("SellFixPrcQty"))

	If SellFixPrcQty = "" Then
		Exit Sub
	End If

	DanGa = edCurrPRC.Data

	qry = CDbl(SellFixPrcQty) / CDbl(DanGa)

	ed_stopVol.Data = Fix(qry)
End Sub

Sub Query_Qty()

	sStopPush = Trim(SYSTEM.Pop("PUSH_STOP"))
	Trim(SYSTEM.Push("PUSH_STOP", ""))

	If(Len(sStopPush) = 0) Then
		Exit Sub
	End If

	Dim array  '0 계좌  1 계좌비번  2 신용구분 3 신용날자 4 shogb
	array = Split(sStopPush, "|")
	shogb.Data = array(4)
	Dim	param

	If array(2) = "1" Then
		'MsgBox "현금 0=" & array(0) & "  1=" & array(1) & "  2=" & array(2) & "  3=" & array(3) & "  4=" & array(4)
			param = array(0) &","& array(1) &","& _
				"1" &","& edStopCode.Data &","& edCurrPRC.Data &","& "2"
		OBJ_avol.Proc "send_tr", param
	Else
		'MsgBox "신용 0=" & array(0) & "  1=" & array(1) & "  2=" & array(2) & "  3=" & array(3) & "  4=" & array(4)
		param = array(0) &","& array(1) &","& _
				"1" &","& edStopCode.Data &","& edCurrPRC.Data &","& "2" & "," & array(3)
		OBJ_trust_avol.Proc "send_tr", param
	End If
End Sub

