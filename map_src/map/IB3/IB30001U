_AW_ONSTART_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S90777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S90777.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S90777.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(90303)
_AW_ONCLICK_AW_
Dim codx

If S90303.HitPos = 3 Then
	If Trim(codx) = "" Then
	    Exit Sub
	End If

	If Len(Trim(S90303.GetGridCell(S90303.index+1, 2))) > 6 Then
		Exit Sub
	End If

	SCREEN.Proc "parent.send2", S90303.GetGridCell(S90303.Row, 2)

	SCREEN.Object("main.1301").Data = S90303.GetGridCell(S90303.Row, 2)
	SCREEN.Proc "main.Send_sise_all", "main"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


