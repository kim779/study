Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN20.Name
	zpwd.Data = AN20.Password
	h_acnm.Data = ANCM.Data
	If Len(Trim(AN20.Data)) < 11 Then
