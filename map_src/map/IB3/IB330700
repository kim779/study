	If SYSTEM.ConnectBy <> 0 Then
		zpwd.Enable = True
		If Len(Trim(zpwd.Data)) < 4 Then
			zpwd.SetFocus
			Exit Sub
		End If
	End If
	Call send_f()
End Sub



Sub send_f()
