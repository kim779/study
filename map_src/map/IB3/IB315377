'***************************************************************************
Sub Set_account()
	ACNM.Data = AN20.name
	ed_pswd.Data = AN20.Password

	If chk.Text = "Y" Then
		chk.Text = "N"
		Exit Sub
	End If

'	If Trim(ed_pswd.Data) = "" Then
'		MsgBox "계좌 비밀번호 저장 후 사용하십시오.", , "IBK투자증권"
'		SCREEN.CloseWindow
'	End If

End Sub

'***************************************************************************
' DESC: 소수점처리
'***************************************************************************
Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SCREEN.SetTimer 1, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0010"

If LOGIN.Order = True Then '고객
	zUserTp.Data = 2
Else
	zUserTp.Data = 1
End If

Dim accn, pass, data1

accn = Trim(AN20.Data)
pass = Trim(ed_pswd.Data)

data1 = Trim(zTrxPtnTp.Data)

If data1 <> "6" And data1 <> "4" And data1 <> "7" Then
	If Trim(accn) = "" Then
	'	MsgBox "계좌번호를 확인하세요", , "IBK 투자증권"
		AN20.SetFocus
		SCREEN.OnSend = False
		Exit Sub
	End If

	If Len(Trim(pass)) < 4 Then
		MsgBox "비밀번호를 확인하세요", ,  "IBK 투자증권"
		ed_pswd.SetFocus
		SCREEN.OnSend = False
		Exit Sub
	End If
End If

jmga_i.Data = inpot(jmga_o.Data, 2)
rtga_i.Data = Inpot(rtga_o.Data, 8)
