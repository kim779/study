_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ECode
Dim Proc
Dim Param
Dim Call_Map
ECode = LEDGER.Ecod
Emsg = LEDGER.Emsg
Call_Map = CallMap.Data

If (ECode <> "0000") And (ECode <> "3455") Then
	MsgBox Emsg,,"IBK투자증권"
	SCREEN.CloseWindow
	Exit Sub
End If

If Trim(Call_Map) = "" Then
	Call_Map = "IB315400"
End If

If Trim(zTrxPtnTp.Data) = "3" Then
	zTrxPtnTp.Data = "7"
	Param = zTrxPtnTp.Data & vbTab & Left(ECode, 1) & vbTab & Emsg & vbTab & AN20.Data & vbTab & ACNM.Data & vbTab & rtga_i.Data & vbTab & ed_focod.Data & vbTab & jmga_o.Data & vbTab & EDIT12.Data & vbTab & EDIT8.Data
	SYSTEM.Trigger "AddAccount", Param, Call_Map
Else
	Param = zTrxPtnTp.Data & vbTab & Left(ECode, 1) & vbTab & Emsg & vbTab & AN20.Data & vbTab & ACNM.Data & vbTab & rtga_i.Data & vbTab & ed_focod.Data & vbTab & jmga_o.Data & vbTab & EDIT12.Data & vbTab & EDIT8.Data
	SYSTEM.Trigger "AddAccount", Param, Call_Map
End If

