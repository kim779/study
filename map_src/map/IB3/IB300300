		out_sprc2.Data = SCREEN.Object("OBJ_jumn.ExecAfCsgnMgn").Data		'체결후위탁증거금
		out_prc2.Data = SCREEN.Object("OBJ_jumn.ExecAfMnyCsgnMgn").Data	'체결후현금위탁증거금

