		prc2 = Trim(out_prc2.Data)
		prc3 = 0
		If prc1 <> "" And prc2 <> "" Then
			prc3 = prc1 - prc2
			If prc3 > 0 Then
				out_prc3.Data = "-"&prc3
			ElseIf prc3 < 0 Then
				out_prc3.Data = Replace(prc3, "-", "+")
			Else
