Function FmtNum(val, tlen, sflg)
	Dim olen, sdat
	If sflg=True Then
		olen = tlen - 1
		If CDbl(val)>=0 Then
			sdat = "+"
		Else
			sdat = "-"
		End If
	Else
		If CDbl(val)<0 Then
			FmtNum = ""
			Exit Function
		End If
		olen = tlen
		sdat = ""
	End If

	FmtNum = sdat & Replace( Space(oLen-Len(val)) & val, " ", "0" )
End Function

Function FmtReal(val, tlen, plen, sflg)
	Dim olen, sdat, rval
	rval = "" & FormatNumber(Abs(val), plen, -1, 0, 0)

	If sflg=True Then
		olen = tlen - 1
		If CDbl(val)>=0 Then
			sdat = "+"
		Else
			sdat = "-"
		End If
	Else
		If CDbl(val)<0 Then	' 음수인데 부호가 없으면 에러처리
			FmtReal = ""
			Exit Function
		End If
		olen = tlen
		sdat = ""
	End If

	'MsgBox "rval=|" & rval & "|, sdat=|" & sdat & "|, olen=" & olen & ", rlen=" & Len(rval)

	If oLen < Len(rval) Then	' 자리수가 모잘라도 에러처
		FmtReal = ""
	Else
		FmtReal = sdat & Replace( Space(oLen-Len(rval)) & rval, " ", "0" )
	End If
End Function

Function inpot(data, plen)
	Dim tlen, fdat, bdat

	Dim nCount, nIndex, ii
	nCount = 0
	nIndex = 1

	nIndex = InStr(nIndex, data, ",", 0)

	While nIndex <> 0	'콤마 갯수를 구한다.
		nIndex = InStr(nIndex + 1, data, ",", 0)
		nCount = nCount + 1
	Wend

'	MsgBox "inpot nCount[" & nCount & "]"

	data = Replace(data, ",", "")

	For ii = 0 To nCount	'콤마 갯수만큼 0을 더해준다.
		data = "0" & data
	Next

'	MsgBox "inpot data[" & data & "]"

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

