' 관심종목 oop 조회
Sub oop_call()
	Dim sdata, codes, ii

	codes = ""

	For ii = 1 To GRID_out.Rows
		codes = codes & Trim(GRID_out.GetGridCell(ii, 2))
		codes = codes & Chr(127)
	Next

	sdata = "$90303" & Chr(127) & cp_lpad(ii,2,"0") & cp_lpad(ii,4,"0") & _
					"020" & Space(16) & "00000" & Space(80) & _
					"1301" & Chr(127) & codes & Chr(10) & "2023" & Chr(10) & vbTab
	Call SCREEN.Service("pooppoop", sdata, Len(sdata), &H02)
End Sub

