			End If
		End If

		prc1 = Trim(out_sprc1.Data)
		prc2 = Trim(out_sprc2.Data)
		If prc1 <> "" And prc2 <> "" Then
			prc3 = prc1 - prc2
			If prc3 > 0 Then
				out_sprc3.Data = "-"&prc3
			ElseIf prc3 < 0 Then
				out_sprc3.Data = Replace(prc3, "-", "+")
			Else
				out_sprc3.Data = prc3
			End If
		End If

		'체크된것만 남기기
		For ii = GRID_out.Rows To 1 Step -1
			If Trim(GRID_out.GetGridCell(ii, 13)) = "" Then
				GRID_out.RemoveRow(ii -1)
			End If
		Next

		'시장가 세팅
		For ii = 1 To GRID_out.Rows
			If r2.Checked = True Then
				'GRID_out.setGridCell ii, 12, GRID_out.GetGridCell(ii,11)'주문단가
			Else
				GRID_out.setGridCell ii, 12, "0"
			End If
		Next
	End If
End Sub

