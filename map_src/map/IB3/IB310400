RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sect
sect = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN20.Name
	h_acnm.Data = AN20.Name
	zpwd.Data = AN20.Password
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zpwd.Data)) < 4 Then
			zpwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zpwd)

LEDGER.Rcnt = "0015"

If SCREEN.CreateObject("Info") Then
	Dim combo
	combo = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "COMBO"))
	COMBO0.Data = combo
End If

'If (SYSTEM.ConnectBy=1 And Len(Trim(zpwd.Data))>3) Or (SYSTEM.ConnectBy=0) Then
'	SCREEN.SetTimer 1, False
'End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

	' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "0" And Trim(zpwd.Data) = "" Then
	   zpwd.Data = "9999"
	End If

If CheckInput(AN20, zpwd) = True Then
	SCREEN.onsend = True

	ANCM.Data = h_acnm.Data
 	'Exit Sub
Else
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
	zpwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
	next_btn.Enable True
	next_btn.Setfocus
Else
	next_btn.Enable False
	exec.SetFocus
End If

If sect = 0 Then
	zpwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call send_f()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(AN20)
_AW_ONCHANGE_AW_
Call Set_account()	'-- 계좌명, 비밀번호 설정
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(exec)
_AW_ONCLICK_AW_
sect = 1

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(sdt)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edt)
