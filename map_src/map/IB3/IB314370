		MsgBox "STOP주문은 시장가주문이므로 돈육선물은 지원불가합니다", , "IBK투자증권"
		Call QueryOption("after")
		Exit Sub
	Else
		Dim tmpCode3, symbol
		tmpCode3 = Left(Trim(ed_cfocod.Data), 3)
		symbol = "main.OBJ_sise."

		If Len(Trim(tmpCode3)) < 3 Then
			Exit Sub
		End If

		If tmpCode3 = "101" Or tmpCode3 = "103" Or tmpCode3 = "A01" Or tmpCode3 = "A03" Then
			symbol = symbol & "31023"
		ElseIf tmpCode3 = "201" Or tmpCode3 = "301" Or tmpCode3 = "B01" Or tmpCode3 = "C01" Then
			symbol = symbol & "41023"
		ElseIf tmpCode3 = "161" Or tmpCode3 = "162" Or tmpCode3 = "163" Or tmpCode3 = "164" Or _
					tmpCode3 = "165" Or tmpCode3 = "166" Or tmpCode3 = "167" Or _
					tmpCode3 = "175" Or tmpCode3 = "176" Or tmpCode3 = "177" Or _
					tmpCode3 = "185" Or tmpCode3 = "186" Or tmpCode3 = "187" Or _
					tmpCode3 = "A61" Or tmpCode3 = "A62" Or tmpCode3 = "A63" Or tmpCode3 = "A64" Or _
					tmpCode3 = "A65" Or tmpCode3 = "A66" Or tmpCode3 = "A67" Or _
					tmpCode3 = "A75" Or tmpCode3 = "A76" Or tmpCode3 = "A77" Or _
					tmpCode3 = "A85" Or tmpCode3 = "A86" Or tmpCode3 = "A87" Or _Then
			symbol = symbol & "101023"
		Else
			Exit Sub
		End If

		If ed_omgb.Data = "매도" Then

			If CDbl(ed_jprc.Text) >= CDbl(SCREEN.Object(symbol).Text) Then
				MsgBox "조건가격은 현재가보다 작아야합니다.", , "IBK투자증권"
				Exit Sub
			End If
		ElseIf ed_omgb.Data = "매수" Then
			If CDbl(ed_jprc.Text) <= CDbl(SCREEN.Object(symbol).Text) Then
				MsgBox "조건가격은 현재가보다 커야합니다.", , "IBK투자증권"
				Exit Sub
			End If
		End If
	End If

	tmpCode = Left(Trim(ed_cfocod.Data), 3)

	If tmpCode = "185" Or tmpCode = "186" Or tmpCode = "187" Or tmpCode = "485" Or tmpCode = "486" Or tmpCode = "487" Or _
		tmpCode = "A85" Or tmpCode = "A86" Or tmpCode = "A87" Or tmpCode = "D85" Or tmpCode = "D86" Or tmpCode = "D87" Then
		prc = ed_jprc.Data
	Else
		prc = FormatNumber((ed_jprc.Data)/100, 2, -1, 0)
	End If

	'주문전송 확인 If OrdCfg.OrderConfirm() = True Then
	If chk_OrderConfirm.Checked Then
		If r_mdgb1.Checked = True Then
			mdgb = "일부정정"
		Else
			mdgb = "전부정정"
		End If
		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & HNAM.Data & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_hogb" & vbTab & Mid(c_hogb.Text, 4) & vbLf &_
			"o_mdgb" & vbTab & mdgb & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf &_
			"o_jprc" & vbTab & prc & vbLf
		SCREEN.CreateWindow 2, "IB31437A /p5 /d", dmsg
		If SYSTEM.Pop("fo_modify_order") <> "OK" Then
			Exit Sub
		End If
	End If
	jmbtclick.Data = 1
	SCREEN.Object("parent.obj_snd").send		'주문전송

	Call QueryOption("after")
	ed_omgb.Data = ""

End Sub

