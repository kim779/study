RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)


Sub p_read_ini()
	Dim rdval
	If SCREEN.CreateObject("Info") Then
		rdval = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "rdval"))
	Else
		rdval = "1"
	End If

	If rdval = "1" Then
		r1.Checked = True
		r2.Checked = False
		xflg.Data = "1"
	Else
		r1.Checked = False
		r2.Checked = True
		xflg.Data = "D"
	End If
End Sub

Sub p_write_ini(val)
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "rdval", val
	End If
End Sub

_AW_ONSTART_AW_
p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.1301").Data
If Len(Trim(S1301.Data)) <> 6 Then
	SCREEN.OnSend False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(r1)
_AW_ONCLICK_AW_
xflg.Data = "1"
p_write_ini("1")
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r2)
_AW_ONCLICK_AW_
xflg.Data = "D"
