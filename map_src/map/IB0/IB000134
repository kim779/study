RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	GRID1.Clear
	tmcd.Data = ""
	SCREEN.Send 0
End Sub

Sub OBJSend()
	OBJ2.Send
End Sub


Sub Change_MKGubn_OBJ(sMKGubn)
	If sMKGubn <> cxMarket.sMarket Then
		cxMarket.sMarket = sMKGubn
		send_f()
	End If
End Sub

_AW_ONSTART_AW_
If UCase(TypeName( SCREEN.Object("Main.cxMarket") )) <> "NOTHING" Then
	cxMarket.sMarket = SCREEN.Object("Main.cxMarket").sMarket
End If

send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
GRID1.Clear

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
tmcd.data = GRID1.GetGridCell(1, 1)
SCREEN.Object("OBJ2").Send
GRID1.SetFocus

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
'OBJ_chart.Send
'SYSTEM.Trace "object send"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(C_GUBN)
_AW_ONCHANGE_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn_Q)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btn_A)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To SCREEN.Object("OBJ2.GRID0").Rows
	str = str & Trim(SCREEN.Object("OBJ2.GRID0").GetGridCell(i, 2))
	str = str & vbTab
	str = str & Trim(SCREEN.Object("OBJ2.GRID0").GetGridCell(i, 3))
	str = str & vbLf
Next
If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, SCREEN.Object("OBJ2.GRID0").Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
If GRID1.HitPos = 3 Then
	tmcd.data = GRID1.GetGridCell(GRID1.Row, 1)
    SCREEN.Object("OBJ2").Send
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



