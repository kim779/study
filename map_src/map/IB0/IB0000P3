'FIRST가 1이면 체크안된거고, 0이면 체크된거임.
'TODAY가 없으면 FIRST를 1로 세팅한다.
Sub Set_Ini()
	Dim Today, Check

	If SCREEN.CreateObject("Info") Then

	 	Today = INFO.PopData("", "NOTICECOOKIE.ini", "EVENT_POPUP3", "TODAY")

	 	If Today = "0" Then
	 		INFO.PushData "", "NOTICECOOKIE.INI", "EVENT_POPUP3", "TODAY", CDAT.Data
			INFO.PushData "", "NOTICECOOKIE.ini", "EVENT_POPUP3", "FIRST", "1"
	 	Else
	 		INFO.PushData "", "NOTICECOOKIE.INI", "EVENT_POPUP3", "TODAY", CDAT.Data
	 	End If

	 	Check = INFO.PopData("", "NOTICECOOKIE.ini", "EVENT_POPUP3", "FIRST")

	 	If Check = "0" Then
	 		CHECK0.Checked = True
			INFO.PushData "", "NOTICECOOKIE.ini", "EVENT_POPUP3", "FIRST", "0"
	 	Else
	 		CHECK0.Checked = False
			INFO.PushData "", "NOTICECOOKIE.ini", "EVENT_POPUP3", "FIRST", "1"
	 	End If
	End If

End Sub

_AW_ONSTART_AW_
Call Set_Ini()

