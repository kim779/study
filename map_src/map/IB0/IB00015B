_AW_SCRIPT_AW_(GRID2)
_AW_ONCLICK_AW_
Dim cod2

If GRID2.HitPos = 3 Then
	cod2 = GRID2.GetGridCell(GRID2.index +1, 2)
	If Trim(cod2) <> "" Then
		S1301.Data = cod2
		SCREEN.Object("main.1301").Data = S1301.Data
		isclick.Checked = True
		SCREEN.Proc "main.send_sise_all", "theme"
		SCREEN.SetTimer 2, False
	End If
End If
