RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim initflag, grdact
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)
initflag = False
grdact = ""

Sub ChangeMarket(sMarket)
	If sMarket = "NXT" Then
		S300777.Data = "2"
	ElseIf sMarket = "통합" Then
		S300777.Data = "3"
	ElseIf sMarket = "KRX" Then
		S300777.Data = "1"
	End If

	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Dim sjcd, tjcd, gubn
If SCREEN.CreateObject("Info") Then
	sjcd = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "300903"))
	If sjcd = "" Then
		sjcd = "0"
	End If
	S300903.Data = sjcd
	tjcd = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "300904"))
	If tjcd = "" Then
		tjcd = "0"
	End If
	S300904.Data = tjcd
	gubn = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "300905"))
	If gubn = "" Then
		gubn = "1"
	End If
	S300905.Data = gubn
End If

If UCase(TypeName( SCREEN.Object("main.cxMarket") )) <> "NOTHING" Then
SYSTEM.Trace "onStart 3600 = " & SCREEN.Object("main.cxMarket").sMarket
	If SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S300777.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S300777.Data = "3"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S300777.Data = "1"
	End If
End If

S300900.Data = "F"
S300901.Data = LOGIN.Day0

SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket") )) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S300777.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S300777.Data = "3"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S300777.Data = "1"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
S300900.Data = "X"
initflag = True

If S300300.Rows < 1 Then
	Exit Sub
End If

Select Case grdact
Case "up"
	S300300.Index S300300.Rows - 3
	S300300.Index S300300.Rows - 2
	S300300.Index S300300.Rows - 1
Case "dn"

End Select
grdact = ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(300901)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SBTN)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(300300)
_AW_ONCLICK_AW_
If S300300.HitPos = 3 Then
	If S300300.Column < 8 Then
		S1301.DATA = Trim(S300300.GetGridCell(S300300.INDEX +1, 1))
		SCREEN.Object("main.1301").Data = S1301.Data
		SCREEN.Object("main.1301").Trigger "", True
		SCREEN.Proc "main.send_sise_all", "main"
	ElseIf S300300.Column > 8 Then
		S1301.DATA = Trim(S300300.GetGridCell(S300300.INDEX +1, 9))
		SCREEN.Object("main.1301").Data = S1301.Data
		SCREEN.Object("main.1301").Trigger "", True
		SCREEN.Proc "main.send_sise_all", "main"
	End If
ElseIf initflag = True Then
	grdact = ""
	Select Case S300300.HitPos
	Case 1, 5
		grdact = "up"
	Case 2, 6
		grdact = "dn"
	End Select
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(300903)
_AW_ONCHANGE_AW_
If SCREEN.CreateObject("Info") Then
	INFO.pushData LOGIN.Name, myFILE, myMAP, "300903", S300903.Data
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(300905)
_AW_ONCHANGE_AW_
If SCREEN.CreateObject("Info") Then
	INFO.pushData LOGIN.Name, myFILE, myMAP, "300905", S300905.Data
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(300904)
_AW_ONCHANGE_AW_
If SCREEN.CreateObject("Info") Then
	INFO.pushData LOGIN.Name, myFILE, myMAP, "300904", S300904.Data
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


