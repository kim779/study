sub send_f()
	If r1_all.Checked Then
		S1301.Data = SCREEN.Object("main.1301").Data
		OBJ_hnam.Send
		Exit sub
	Else
		SCREEN.Send 0
	End If
End sub

sub showgrid(val)
	GRID0.Clear
	If val = "1" Then
		BUTTON.Enable False
		S1301.Enable False
		GRID0.SetColumnVisible 7, True
		GRID0.SetColumnWidth 3, 365
		r2_1.Enable False
		r2_2.Enable False
		r2_3.Enable False
		For ii=1 To 20
			If ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	Else
		BUTTON.Enable True
		S1301.Enable True
		GRID0.SetColumnVisible 7, False
		GRID0.SetColumnWidth 3, 445
		r2_1.Enable True
		r2_2.Enable True
		r2_3.Enable True
		rd_click()
	End If
End sub

sub rd_click()
	Dim ii

	If r2_1.Checked Then
		For ii=1 To 20
			If ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	ElseIf r2_2.Checked Then
		For ii=1 To 20
			If ii = 2 Then
				SCREEN.Object("GUBN"&ii).Checked = True
			Else
				SCREEN.Object("GUBN"&ii).Checked = False
			End If
		Next
	ElseIf r2_3.Checked Then
		For ii=1 To 20
			If ii = 2 Or ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	Else

	End If
End sub

Const file = "newsinfo.ini"

