	End If
End Function

sub Onalert()
	Dim	v_gubn
	Dim strKeys
	Dim v_subgubn
	Dim c_list , f, c_yn

	c_yn = "N"

	'종목코드 체크
	If r1_one.Checked Then
		If Trim(GRID11.GetGridCell(1,4)) = "" Then
		 	Exit sub
		Else
			If Trim(GRID11.GetGridCell(1,12)) <> "" Then
				c_list = Split(Trim(GRID11.GetGridCell(1,12)) , "A", -1, 1)
			For Each f in c_list
				If Len(f) <> 0 And Trim(cod2.data) = f Then
					c_yn = "Y"
					Exit For
				End If
			Next
			End If
		End If
		If Trim(GRID11.GetGridCell(1,4)) <> Trim(cod2.data) And c_yn = "N" Then
			GRID11.Clear()
			Exit sub
		End If
	End If

	'뉴스 제공사 체크
	If Trim(GRID11.GetGridCell(1,2)) = "" Then
		Exit sub
	End If

	If IsNumeric(Trim(GRID11.GetGridCell(1,8))) = False Then
		Exit sub
	End If

	v_gubn = CLng(Trim(GRID11.GetGridCell(1,8)))

	If v_gubn < 1 Or v_gubn > 20 Then
		Exit sub
	End If

	If SCREEN.Object("GUBN"&v_gubn).Checked = False Then
		Exit sub
	End If

	Select Case v_gubn
		Case 1
			If GUBN1.Checked = False Then
				Exit sub
			End If
			v_name = "시황"
		Case 2
			If GUBN2.Checked = False Then
				Exit sub
			End If
