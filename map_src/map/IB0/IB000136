_AW_ONDECLARE_AW_
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)

Sub click_tab(param)
	Dim objseq
	tabid = SCREEN.Object("tab_info"&param).ID
	Select Case tabid
	Case 1
		SCREEN.Object("OBJ"&param).SetObject("IB000140")
	Case 2
		SCREEN.Object("OBJ"&param).SetObject("IB000141")
	Case 3
		SCREEN.Object("OBJ"&param).SetObject("IB000142")
	Case 4
		SCREEN.Object("OBJ"&param).SetObject("IB000143")
	Case 5
		SCREEN.Object("OBJ"&param).SetObject("IB000144")
	Case 6
		SCREEN.Object("OBJ"&param).SetObject("IB000145")
	Case 7
		If param = 1 Then
			SCREEN.Object("OBJ"&param).SetObject("IB000146")
		ElseIf param = 2 Then
			SCREEN.Object("OBJ"&param).SetObject("IB000147")
		ElseIf param = 3 Then
			SCREEN.Object("OBJ"&param).SetObject("IB000148")
		ElseIf param = 4 Then
			SCREEN.Object("OBJ"&param).SetObject("IB000149")
		End If
	End Select
	SCREEN.Object("OBJ"&param).Proc "settype", param
	SCREEN.Object("OBJ"&param).Send
End Sub


Sub click_tab2(param)
	Dim objseq
	tabid = SCREEN.Object("tab_info"&param).ID
	Select Case tabid
	Case 1
		SCREEN.Object("OBJ"&param).SetObject("IB000140")
	Case 2
