	Case 3
		SCREEN.Object("OBJ"&param).SetObject("IB000142")
	Case 4
		SCREEN.Object("OBJ"&param).SetObject("IB000143")
	Case 5
		SCREEN.Object("OBJ"&param).SetObject("IB000144")
	Case 6
		SCREEN.Object("OBJ"&param).SetObject("IB000145")
	Case 7
		If param = 1 Then
			SCREEN.Object("OBJ"&param).SetObject("IB000146")
		ElseIf param = 2 Then
			SCREEN.Object("OBJ"&param).SetObject("IB000147")
		ElseIf param = 3 Then
			SCREEN.Object("OBJ"&param).SetObject("IB000148")
		ElseIf param = 4 Then
			SCREEN.Object("OBJ"&param).SetObject("IB000149")
		End If
	End Select
	SCREEN.Object("OBJ"&param).Proc "settype", param
	'SCREEN.Object("OBJ"&param).Send
End Sub

Sub p_write_ini()
	Dim ii
	If SCREEN.CreateObject("Info") Then
		For ii=1 To 4
			INFO.pushData LOGIN.Name, myFILE, myMAP, "tab"&ii, SCREEN.Object("tab_info"&ii).ID
		Next
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim tabid, ii
		For ii=1 To 4
			tabid = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "tab"&ii))
			If tabid = "" Then
				tabid = ii
			End If
			SCREEN.Object("tab_info"&ii).ID = tabid
			click_tab2(ii)
		Next
	End If

	SCREEN.SetTimer 2,False
End Sub

_AW_ONSTART_AW_
p_read_ini()

