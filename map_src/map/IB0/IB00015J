{


_AW_ONINDECLARE_AW_
#LOAD IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S90308.Data = S90303.rows

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S90777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S90777.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S90777.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim group
group = Trim(SCREEN.Object("parent.parent.intercombo").data)

If InStr(group, "00") <> 0 Then
	Call deleteRow()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(90303)
_AW_ONCLICK_AW_
If S90303.HitPos = 3 Then
	If Trim(S90303.GetGridCell(S90303.Row, 2)) = "" Then
	    Exit Sub
	End If

	If Len(Trim(S90303.GetGridCell(S90303.index+1, 2))) > 6 Then
		Exit Sub
	End If

	If S90303.Column = 5 Then
		Call newsClick()
	End If

	SCREEN.Object("main.1301").Data = Trim(S90303.GetGridCell(S90303.Row, 2))
	SCREEN.Object("main.1301").Trigger "", True
	SCREEN.Proc "main.send_sise_all", "main"
ElseIf S90303.HitPos = 4 Then
	Dim ii, res

	For ii=1 To S90303.Rows
		S90303.SetGridCell ii, 5, ""
		S90303.SetGridCell ii, 4, ""
		S90303.SetGridCell ii, 3, ""

		res = ii Mod 2

		If res = 0 Then
			S90303.SetPRgb ii, 5, 77
		Else
			S90303.SetPRgb ii, 5, 68
		End If
	Next
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


