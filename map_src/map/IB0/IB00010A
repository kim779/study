Const file = "newsinfo.ini"

Function ReadConf()
	If SCREEN.CreateObject("Info") Then
	 	ReadConf = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "ITEMS"))
	Else
		ReadConf = ""
	End If
End Function

Function ReadVersion()
	If SCREEN.CreateObject("Info") Then
	 	ReadVersion = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "VERSION"))
	Else
		ReadVersion = ""
	End If
End Function

Sub Onalert()
	Dim	v_gubn
	Dim jcod
	Dim c_list , f, c_yn
	c_yn = "N"

	jcod = Trim(SCREEN.Object("parent.1301").Data)
	'종목코드 체크
	If jcod = "" Then
		Exit Sub
	End If

	If Trim(GRID8.GetGridCell(1,12)) <> "" Then
		c_list = Split(Trim(GRID8.GetGridCell(1,12)) , "A", -1, 1)
		For Each f in c_list
			If Len(f) <> 0 And jcod = f Then
				c_yn = "Y"
				Exit For
			End If
		Next
	End If

	If Trim(GRID8.GetGridCell(1,4)) <> jcod And c_yn = "N" Then
		GRID8.Clear()
		Exit Sub
	End If

	'뉴스 제공사 체크
	If Trim(GRID8.GetGridCell(1,2)) = "" Then
		Exit Sub
	End If

	If IsNumeric(Trim(GRID8.GetGridCell(1,8))) = False Then
		Exit Sub
	End If

	v_gubn = CLng(Trim(GRID8.GetGridCell(1,8)))

	If v_gubn < 1 Or v_gubn > 20 Then
		Exit Sub
	End If

	strKeys = editFilter.Data

	If Trim(strKeys) <> "ALL" Then
		If InStr(strKeys,Trim(v_name)) < 1 Then
			Exit Sub
		End If
	End If

	For ii = 1 To GRID8.Rows
		If Trim(GRID8.GetGridCell(ii,4))<>"" Then
			c_yn = "N"
			If Trim(GRID8.GetGridCell(ii,12)) <> "" Then
				c_list = Split(Trim(GRID8.GetGridCell(ii,12)) , "A", -1, 1)
				For Each f in c_list
					If Len(f) <> 0 And jcod = f Then
						c_yn = "Y"
						Exit For
					End If
				Next
			End If
			If Trim(GRID8.GetGridCell(ii,4)) = jcod Or c_yn = "Y" Then
				'메인 뉴스 버튼 N->Y 변경 '메인에 제목 보내기
				SCREEN.Object("parent.newsViewBtn").Visible = True
				SCREEN.Object("parent.news_output").Visible = True
				SCREEN.Object("parent.news_output").Blink True, 192
				SCREEN.Object("parent.news_output").Data = " " + Trim(GRID8.GetGridCell(1,2))
				SCREEN.Object("parent.keyv_temp").Data = Trim(GRID8.GetGridCell(1,11))
				SCREEN.Proc "parent.change_bg", ""
			End If
		End If
	Next
	GRID8.Clear()
End Sub

