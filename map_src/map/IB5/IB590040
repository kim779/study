_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim tmpb
LEDGER.Rcnt = "0008"

SCREEN.OnSend = False
zIn.Data = "00001"
ed_acno.Data = Trim(SCREEN.Object("Main.AN3A").Data)

If Len(Trim(ed_acno.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("Main.AN3A").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 And Trim(SCREEN.Object("Main.pswd").Data) = "" Then
	ed_pswd.Data = "9999"
Else
	ed_pswd.Data = Trim(SCREEN.Object("Main.pswd").Data)
End If

If Len(Trim(ed_pswd.Data)) < 4 Then
	Call alert_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("Main.pswd").SetFocus
	Exit Sub
End If

'------------------------------------------------------------------------ 일방향 암호화
LEDGER.Hsiz = 44
LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(ed_pswd.Data))
'------------------------------------------------------------------------

'k835 에서 서비스를 조회해서 환율조회해야 한다.
'외화매수인 경우 외화예금입금환율
'외화매도인 경우 외화예금출금환율
' 매도/매수 구분에 따라 매도환율/매수환율 구분하여 적용환율 조회
' * 적용환율 입력 환율에 기입
Select Case SCREEN.Object("parent.tab_ex").ID
Case 2:		' 외화매수
	tmpb = Trim(SCREEN.Object("Main.obj_exchange.obj_srhreate.o_bfxchrat").Data) & "0"
Case 1:		' 외화매도
	tmpb = Trim(SCREEN.Object("Main.obj_exchange.obj_srhreate.o_xchrat").Data) & "0"
End Select

' Zero Padding
tmpb = "0000000000000000" & Trim(tmpb)
ed_gdxchrat.Data = Right(Trim(tmpb), 16)
sign.Data = "+"

If SCREEN.Object("parent.tab_ex").ID = 2 Then
	ed_Sgubn.Data = "01"     '외화매수
Else
	ed_Sgubn.Data = "02"      '외화매도
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim desc, ltim

Select Case LEDGER.Ecod
	Case "0136"	' 조회가 완료되었습니다.
		' Proceed

	Case Else
		Exit Sub
End Select



' Description
SCREEN.Object("Parent.URATE").Clear()
If Trim(PrvlgRat.Data) <> "" And Trim(PrvlgRat.Data) <> "0" Then
	If CDbl(PrvlgRat.Data) > 0 Then
		desc = "우대율:" & CDbl(Trim(PrvlgRat.Data)) & "%"
	End If

	SCREEN.Object("Parent.URATE").Text = Trim(desc)
End If

' Description
'ltim = "(최종조회시간 : " & Hour(Now()) & ":" & Minute(Now()) & ":" & Second(Now()) & ")"
'SCREEN.Object("Parent.LTIM").Text = Trim(ltim)


' 적용환율
SCREEN.Object("Parent.ed_appexrate_skip").Data = ApplXchrat.Data

' 우대환율
SCREEN.Object("Parent.ed_prvrate_skip").Data = PrvlgRat.Data

SCREEN.Object("Main.obj_exchange.dtlBtn").Enable = True
SCREEN.Object("Main.obj_exchange.ed_appPrc_skip").Enable = True
SCREEN.Object("Main.obj_exchange.ed_appPrc_skip").SetFocus()

