		' 처리구분
		ed_trxtp.Data = "1"   '0:환전예상금액 1:전문송신 2:은행응답불능 3:은행응답정상
		LEDGER.Fkey = "5"

		' 외화 환전 시 전문 체크

	End Select

	' 우대환율 존재시, 우대환율 입력
	' 입력가이드 상으로는 01로 입력하라고 되어 있음
	ed_chgrtpcode.Data = "01"        '01고시환율
	If Trim(ed_prvrate_skip.Data) <> "" Then
		If CDbl(ed_prvrate_skip.Data) > 0 Then
			ed_chgrtpcode.Data = "02"	' 02우대환율
		End If
	End If

	' 환전 유형코드
	If tab_ex.ID = 2 Then		' 외화매수
		ed_chgptncode.Data = "01"    '환전유형코드 01외화매수 02외화매도
	Else
		ed_chgptncode.Data = "02"
	End If

	' 대상통화코드 & 환전통화코드
	Select Case tab_ex.ID
	Case 2:		' 외화매수
