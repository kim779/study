		Case 1:	' HKD
			ed_chgcrcycode.Data = "HKD"
		Case 2:	' CNY
			ed_chgcrcycode.Data = "CNY"
		End Select
		ed_tgtcrcycode.Data = "KRW"     '대상통화코드

	Case 1:		' 외화매도
		Select Case cbo_type_medo.Index
		Case 0:	' USD
			ed_tgtcrcycode.Data = "USD"
		Case 1:	' HKD
			ed_tgtcrcycode.Data = "HKD"
		Case 2:	' CNY
			ed_tgtcrcycode.Data = "CNY"
		End Select
		ed_chgcrcycode.Data = "KRW"     '환전통화코드

	End Select


	'적용환율 'obj_appreate 에서 조회해온값을 사용해야 한다.
	If Trim(ed_appexrate_skip.Text) = "" Then
		ed_appexrate_skip.Data = "0.0"
	End If
	ed_appexrate.Data = t_format(Trim(Replace(ed_appexrate_skip.Text, ",", "")), 9, 4)

	'우대율 'obj_appreate 에서 조회해온값을 사용해야 한다.
