RESOURCE DIVISION
{


_AW_ONSTART_AW_
SYSTEM.Push "FOstock_Rmasu_order", "NO"

Dim myTime, myHour, myMinute, myGubn, pos

myTime = Time
myHour = Hour(myTime)
myMinute = Minute(myTime)
myGubn = Trim(o_hogb.Data)

pos = InStr(myGubn, "장개시전")

If pos > 0 And myHour = 7 Then
	If myMinute >= 20 And myMinute <= 30 Then
		beforeJang.Visible = True
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(B_OK)
_AW_ONCLICK_AW_
SYSTEM.Push "FOstock_Rmasu_order", "OK"

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(B_CANCEL)
