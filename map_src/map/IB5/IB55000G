SYSTEM.Push "FOstock_Rmasu_order", "NO"

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(o_acno)
_AW_ENDSCRIPT_AW_


}



