		Exit Sub
	End If

	If S90303.Column = 5 Then
		Call newsClick()

		data = Trim(S90303.GetGridCell(S90303.Row, 15))
		If data <> "" Then
			S90303.SetGridCell S90303.Row, 5, "추"
