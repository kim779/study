'***************************************************************************
Function chkcnt()
	Dim gcnt
	gcnt = 0

	chkcnt = False
	For ii = 1 To 500
		If Trim(GRID0.GetGridCell(ii, 1)) = 1 Then
			gcnt = gcnt + 1
		End If
	Next

	If gcnt > 0 Then
		chkcnt = True
	End If
End Function

'***************************************************************************
