'== 계좌명, 비밀번호 설정
Sub Set_account()
	ANCM.Data = AN3A.Name
	zPwd.Data = AN3A.Password
	ed_acnt.Data = AN3A.Data
	GUIDE.Text = ""


	If Len(Trim(AN3A.Data)) <> 11 Then
		AN3A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	GRID0.Clear()
