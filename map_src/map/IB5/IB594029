RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Dim DominoB, DominoC

Sub Setting_Acct()
	Dim ii, items, bank_name, bank_code, first_code, first_name

	count = 0
	cnt = 0

	first_code = Trim(GRID0.GetGridCell(1, 1))

'	items = first_code & vbTab
	items = first_code
	For ii=1 To GRID0.Rows
		bank_name = Trim(GRID0.GetGridCell(ii, 2))
		bank_code = Trim(GRID0.GetGridCell(ii, 1))

		If Mid(Trim(GRID0.GetGridCell(ii, 2)), 5) = "기업은행" Then
			DominoB = Mid(Trim(GRID0.GetGridCell(ii, 2)), 5)
			DominoC = Trim(GRID0.GetGridCell(ii, 1))
		End If

		If bank_name <> "" Then
			items = items & vbTab & bank_code & bank_name
		End If

	Next


	SCREEN.Object("parent.CMB_MY").SetItems(items)


	If SCREEN.Object("main.UTAB0").ID = "1" Or SCREEN.Object("main.UTAB0").ID = "3" Then
		SCREEN.Object("parent.CMB_MY").data = DominoC
		SCREEN.Object("parent.bank_code").data = DominoC
		SCREEN.Object("parent.SELECTBANK").Text = DominoB
	End If
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0050"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

SYSTEM.Trace "IB594000은행리스트조회 - [" & ecod  & "]   " & LEDGER.Emsg

If ecod = "" Then
	Exit Sub
End If

If Left(ecod, 1) = "0" Then
	If LEDGER.Next = "Y" Then
		Call send_c()
	Else
		Call Setting_Acct()
	End If
Else
	SCREEN.Object("main.GUIDE.GUIDE").Text = Trim(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim msg
msg = GRID0.GetGridCell(GRID0.row, 1) & "|" & _
	GRID0.GetGridCell(GRID0.row, 2)

SYSTEM.Push "bankno", msg

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim name
name = GRID0.GetGridCell(GRID0.row, 3)

SYSTEM.Push "KNAME", name

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON2)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



