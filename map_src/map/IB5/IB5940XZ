_AW_ONRECEIVE_AW_
SYSTEM.Trace "----- SACAT403 Ecod = " & "[" & LEDGER.Ecod & "]"
SYSTEM.Trace "----- SACAT403 Emsg = " & "[" & LEDGER.Emsg & "]"

Dim Msg
Dim bAgent
bAgent = False

Dim MyDate
MyDate = Date
MyDate = Replace(MyDate, "-", "")


'SYSTEM.Trace "----- SACAT403 PdptnNm =" & PdptnNm.Data
'SYSTEM.Trace "----- SACAT403 AcntNm =" & AcntNm.Data
'SYSTEM.Trace "----- SACAT403 AgntNm =" & AgntNm.Data
'SYSTEM.Trace "----- SACAT403 RegDt =" & RegDt.Data
'SYSTEM.Trace "----- SACAT403 AbndDt =" & AbndDt.Data

SYSTEM.Trace "----- SACAT403 MyDate =" & MyDate
SYSTEM.Trace "----- SACAT403 otFireDate =" & otFireDate.Data

If LEDGER.Ecod = "0136" Then
	If otFireDate.Data = MyDate Then   '해지일이 영업일과 같으명 해지된 상태
		bAgent = False
'	ElseIf otFireDate.Data = "99999999" Then   '해지일이 99999999 이면 대리인 등록을 안한 상태
'		bAgent = False
	ElseIf Len(Trim(otFireDate.Data)) = 0 Then
		bAgent = False
	ElseIf CDbl(otFireDate.Data) > CDbl(MyDate) Then
		bAgent = True
	End If

	If bAgent = True Then
SYSTEM.Trace "AGENT EXIST!!!!!!!!!"
		SCREEN.Proc "parent.sendOBJ0", "1"  '대리인이 있음
	Else
SYSTEM.Trace "AGENT NO EXIST!!!!!!!!!"
		SCREEN.Proc "parent.sendOBJ0", "0"
	End If
Else
		SCREEN.Proc "parent.sendOBJ0", "0"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
