RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub InitIMAX
	send_f()
End Sub

'== 첫 조회
Sub send_f()
SYSTEM.Trace "send_f  5500"
	LEDGER.Fkey = "C"
	GRID0.Clear
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub
'***************************************************************************
' DESC: 0보다큰 숫자형식인지 검사. 유효숫자( > 0):true else false
'***************************************************************************
Function Is_numeric(data)
	Dim number
	number = Trim(data)

	If number = "" Then
		number = 0
	End If

	Is_numeric = False
	If IsNumeric(number) = False Then
		Exit Function
	End If


	Is_numeric = True
End Function

_AW_ONINDECLARE_AW_
#load IB888888
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Fkey = "C"
GRID0.Clear

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False
zAcntNo.Data = Trim(SCREEN.Object("main.OBJ_order.AN3A").Data)

If SYSTEM.ConnectBy = "0"  Then
	pswd.Data = "9999"
Else
	LEDGER.Hsiz = 44
	LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data))
	pswd.Data = "HEAD"
End If

If CheckInput(zAcntNo, pswd) = True Then
	VIEWGRID.Clear
	SCREEN.OnSend True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
Dim i, j
ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = "0" Then
	wDp.TRgb = 69		'원화예수금
	wPsWd.TRgb = 69     '원화출금가능금액
	wPsEx.TRgb = 69     '원화환전가능금액
	wExDp.TRgb = 69     '원화환전예수금(익일)

	For ii = 1 To VIEWGRID.Rows
		VIEWGRID.SetGridCell ii, 6, VIEWGRID.GetGridCell(ii, 11)  '매수증거금
		VIEWGRID.SetGridCell ii, 8, VIEWGRID.GetGridCell(ii, 12)  '매도환원금
	Next

	obj_tab.Proc "ClearData", ""
	obj_tab.Proc "Send_f", ""

Else
	If ecod = "3669" Or ecod = "1801" Then
		Exit Sub
	End If
End If

If Trim(ecod) <> "0133" Then
	SCREEN.Object("Main.GUIDE").Text = Trim(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(VIEWGRID)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(pswd)
_AW_ONKEYCHANGE_AW_
If SCREEN.Key = 13 And Len(Trim(pswd.Data)) > 0  Then
	Call Send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(wDp)
_AW_ENDSCRIPT_AW_


