	ACNM.Data = AN3A.name
	zPwd.Data = AN3A.Password

	If Trim(AN3A.Data) = "" Then
		AN3A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	VIEWGRID.Clear()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	VIEWGRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

