_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	Call scrClear()

	LEDGER.Fkey = "C"
	Tp.Data = "0"
	TrxTp.Data = "0"
	UserId.Data = LOGIN.User
	SCREEN.Send 0
End Sub

Sub send_c()
	GRID0.SetDataPosition 2

	LEDGER.Fkey = "7"
	Tp.Data = "0"
	TrxTp.Data = "0"
	UserId.Data = LOGIN.User
	SCREEN.Send 0
End Sub


Sub scrClear()
	bank_acct.Clear
	OUT_ACNM.Clear
	Nick.Clear
End Sub

Function check_Input()
	check_Input = False
	If Trim(CMB_MY.Data) = "" Then
		alert_msg("은행명을 확인하세요")
		CMB_MY.SetFocus
		Exit Function
	End If

	If Trim(bank_acct.Data) = "" Then
		alert_msg("계좌번호를 확인하세요")
		bank_acct.SetFocus
		Exit Function
	End If

	If Trim(OUT_ACNM.Data) = "" Then
		alert_msg("예금주명을 확인하세요")
		BTNNAME.SetFocus
		Exit Function
	End If

	check_Input = True
End Function

Sub SettingForSend()
	'선택한 값 세팅
	LEDGER.Fkey = "5"

	If F1.Checked = True Then
		Tp.Data = "1"
		Bank_Code.Data = Trim(CMB_MY.Data)
	ElseIf F2.Checked = True Then
		Tp.Data = "2"
		Bank_Code.Data = "068"
	End If

	UserId.Data = LOGIN.User
	acct.Data = Trim(bank_acct.Data)
	BnkCpcrdNo.Data = Trim(OUT_ACNM.Data)
	BnkAcntNm.Data = Trim(Nick.Data)

	SCREEN.Send 0
End Sub

Sub modify_action()
	If check_Input() = False Then
		Exit Sub
	End If

	Dim temp_code, temp_acct, dmsg, ty, md, bk

	If F1.Checked = True Then
		ty = "타금융기관"
		bk = Mid(Trim(CMB_MY.Text), 5)
	Else
		ty = "IBK투자증권"
		bk = "IBK투자증권"
	End If

	Dim FormatAcct
	FormatAcct = Trim(bank_acct.Data)

	If ty = "IBK투자증권" Then
		FormatAcct = Left(Trim(FormatAcct), 3) & "-" & Mid(Trim(FormatAcct), 4, 2) & "-" & Mid(Trim(FormatAcct), 6)
	End If

	dmsg = "vs" & vbTab & ty & vbLf &_
			"bank" & vbTab & bk & vbLf &_
			"acct" & vbTab & FormatAcct & vbLf &_
			"name" & vbTab & Trim(OUT_ACNM.Data) & vbLf &_
			"nick" & vbTab & Trim(Nick.data) & vbLf

	SCREEN.CreateWindow 2, "IB81018B /p5 /d", dmsg

	If SYSTEM.Pop("confirm") = "OK" Then
		Call SettingForSend()
	End If

End Sub

Sub delete_action(accnText, accnName)
	TrxTp.Data = "3"
	SYSTEM.Push "favorAccnDel", ""

	Dim dmsg
	dmsg =  "bank" & vbTab & Trim(SELECTBANK.Text) & vbLf &_
			"acct" & vbTab & accnText & vbLf &_
			"name" & vbTab & accnName & vbLf &_
			"nick" & vbTab & Trim(Nick.Data) & vbLf

	SCREEN.CreateWindow 2, "IB81018C /p5 /d", dmsg

	If SYSTEM.Pop("favorAccnDel") = "OK" Then
		SYSTEM.Push "favorAccnDel", ""
		Call SettingForSend()
	End If
End Sub

Sub send_action()
	If check_Input() = False Then
		Exit Sub
	End If

	TrxTp.Data = "1"

	Dim corpTp, bnkName, FormatAcct, dmsg
	If F1.Checked = True Then
		corpTp = "타금융기관"
		bnkName = Mid(Trim(CMB_MY.Text), 5)
	Else
		corpTp = "IBK투자증권"
		bnkName = "IBK투자증권"
	End If

	FormatAcct = Trim(bank_acct.Data)

	If corpTp = "IBK투자증권" Then
		FormatAcct = Left(Trim(FormatAcct), 3) & "-" & Mid(Trim(FormatAcct), 4, 2) & "-" & Mid(Trim(FormatAcct), 6)
	End If

	dmsg = "vs" & vbTab & corpTp & vbLf &_
			"bank" & vbTab & bnkName & vbLf &_
			"acct" & vbTab & FormatAcct & vbLf &_
			"name" & vbTab & Trim(OUT_ACNM.Data) & vbLf &_
			"nick" & vbTab & Trim(Nick.data) & vbLf

	SCREEN.CreateWindow 2, "IB81018A /p5 /d", dmsg

	If SYSTEM.Pop("confirm") = "OK" Then
		Call SettingForSend()
	End If
End Sub


