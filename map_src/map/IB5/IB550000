RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim binit
m_binit = False

g_flag = Array(0, 0, 0, 0, 0, 0, 0, 0, 0)

Sub all_account()
	OBJ_jango.Proc "send_f", ""
End Sub

' Main Init
Sub Acc_SearchComplete(gubn)
	' 충돌 방지
	If g_flag(gubn-1) <> 0 Then
		Exit Sub
	End If

	If gubn = "1" Then
		If SCREEN.Object("OBJ_inter.ed_initimax").Data = 0 Then
			SCREEN.Proc "OBJ_inter.InitIMAX",""
		End If
	ElseIf gubn = "2" Then
		If SCREEN.Object("OBJ_hoga.ed_initimax").Data = 0 Then
			SCREEN.Proc "OBJ_hoga.InitIMAX",""
		End If
	ElseIf gubn = "3" Then
		SCREEN.Proc "OBJ_order.InitIMAX", ""
	ElseIf gubn = "4" Then
		SCREEN.Proc "OBJ_jango.InitIMAX",""
	Else
		Exit Sub
	End If

	' 충돌 방지
    g_flag(gubn-1) = 1

End Sub

Sub ChangeIMaxCode(smkgubn , scode)
	SCREEN.Proc "Main.OBJ_hoga.ChangeIMaxCode", smkgubn & "," & scode
	SCREEN.Proc "Main.OBJ_order.ChangeIMaxCode", smkgubn & "," & scode
End Sub

_AW_ONINDECLARE_AW_
#load IB999938

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(IMAXSKIN)
_AW_ONCHANGE_AW_
IMAXSKIN.Trigger "", False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_jango)
_AW_ONCLICK_AW_
Select Case tab_jango.ID
	Case 1 : OBJ_jango.SetObject("IB550510")  '미체결
	Case 2 : OBJ_jango.SetObject("IB550540")  '잔고조회
	Case 3 : OBJ_jango.SetObject("IB556040")  '예수금
	Case 4 : OBJ_jango.SetObject("IB550550")  '차트
	Case 5 : OBJ_jango.SetObject("IB550560")  '글로벌 뉴스
End Select

If  tab_jango.ID = 2 Or tab_jango.ID = 4 Then
 SCREEN.Proc "OBJ_jango.InitIMAX",""
End If

'Call tab_accout_click()
OBJ_jango.Proc "send_f", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(IMAXGROUP)
_AW_ONCHANGE_AW_
SYSTEM.Trace "IB550000 groupid =" & IMAXGROUP.Data
IMAXGROUP.Trigger "", False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


