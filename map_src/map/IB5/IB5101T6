'원주문 셋팅후 커서위치
Call ogno_focus()

code = Trim(SYSTEM.Pop("F_code"))
If code <> "" Then
	ed_focod.Data = code
	Call changecode()
End If
ed_jprc.SetFocus

SYSTEM.Push "F_code", ""
SYSTEM.Push "F_jqty", ""
SYSTEM.Push "F_ogno", ""
SCREEN.IgnoreChange False
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


