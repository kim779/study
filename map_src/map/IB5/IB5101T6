'마지막 주문번호 Setting
Call Get_jmno()

'원주문 셋팅후 커서위치
Call ogno_focus()

'정정수량 설정
ed_jqty.Data = "0"
ed_jqty.Enable = False
c_jqty.Enable = ed_jqty.Enable

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_jqty)
