_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.IgnoreChange True

Dim jqty, jprc, ogno, code, name, acno, ret, msg

acno = SCREEN.Object("parent.AN20").Data
ed_pswd.Data = SCREEN.Object("parent.ed_pswd").Data
If Trim(acno) = "" Then
	SCREEN.Object("parent.AN20").Setfocus
	MsgBox "계좌번호를 확인하세요", , "조회에러"
	Exit Sub
End If
If Trim(ed_pswd.data) = "" Then
	SCREEN.Object("parent.ed_pswd").Setfocus
	MsgBox "비밀번호를 확인하세요", , "조회에러"
	Exit Sub
End If

ret = P_pswdConfirm(acno, ed_pswd.data, msg)
If ret <> True Then
	SCREEN.Object("parent.ed_pswd").Clear
	SCREEN.Object("parent.ed_pswd").SetFocus
	MsgBox msg, ,"조회에러"
	Exit Sub
End If

SYSTEM.Push "F_code", ""
SYSTEM.Push "F_jqty", ""
SYSTEM.Push "F_ogno", ""

SCREEN.CreateWindow 2, "IB51010F /p? /d", "ed_accn" & vbTab & acno & vbLf &_
