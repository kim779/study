_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	GRID0.SetDataPosition 0
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False
LEDGER.Rcnt = "0012"

ed_In.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("main.OBJ1.CMB_ACCT").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("main.OBJ1.CMB_ACCT").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = "0" Then
   ed_pswd.Data = "9999"
Else
	If Len(Trim(SCREEN.Object("parent.OBJ1.zPwd").data)) < 4 Then
			Call alert_msg("계좌번호 비밀번호를 확인하여 주십시오.")
		SCREEN.Object("main.OBJ1.zPwd").SetFocus
		Exit Sub
	End If

	LEDGER.Hsiz = 44
	LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(SCREEN.Object("parent.OBJ1.zPwd").data))
	ed_pswd.Data = "HEAD"
End If

ed_stdt.Data = zStrDt.Data
ed_eddt.Data = zEndDt.Data

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod, ii

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = "0" Then
	For ii = 1 To GRID0.Rows
		GRID0.SetGridCell ii, 1, GRID0.GetGridCell(ii, 8)   		'이체일자
		GRID0.SetGridCell ii, 2, zAcntNo.Data   					'출금계좌
		GRID0.SetGridCell ii, 3, GRID0.GetGridCell(ii, 13)   		'이체번호
		GRID0.SetGridCell ii, 4, Trim(GRID0.GetGridCell(ii, 19))    '거래명
		GRID0.SetGridCell ii, 5, Trim(GRID0.GetGridCell(ii, 17))    '입금은행계좌
		GRID0.SetGridCell ii, 6, GRID0.GetGridCell(ii, 9)   		'은행계좌명
		GRID0.SetGridCell ii, 7, GRID0.GetGridCell(ii, 10)   		'통화
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zStrDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


