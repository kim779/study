	ed_upcd.Data = Trim(GRID0.GetGridCell(GRID0.Row, 2))
	upname.Text = GRID0.GetGridCell(GRID0.Row, 3)
	SCREEN.Proc "OBJ0.send_f", ""
	SCREEN.Proc "OBJ1.send_f", ""
	SCREEN.Proc "OBJ2.send_f", ""
End If
