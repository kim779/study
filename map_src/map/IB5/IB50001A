Dim ii
Dim code, name
Dim data
Dim precode

If SCREEN.Object("parent.c_upgb").data = "001" Then
	precode = "001"
ElseIf SCREEN.Object("parent.c_upgb").data = "201" Then
	precode = "201"
Else
	precode = "101"
End If

For ii = 0 To GRID0.Rows
	code = Trim(GRID0.GetGridCell(ii, 2))
	name = Trim(GRID0.GetGridCell(ii, 3))
	data = data&code&name&vbTab

Next


SCREEN.Object("parent.cb1").SetItems precode & data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
