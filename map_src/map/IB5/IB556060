RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Public Today
Today = getCurrDay()

mmgb = "1"

Sub InitIMAX
	ed_imaxcode.Data = l_initimax("ctrl_code")
	ed_imaxprc.Data = l_initimax("ctrl_prc")
	Call init_data()
	Call ChangeCode()

	ed_mmgb.Data = mmgb

	GetParentGroupAdnSkin()

	SCREEN.SetTimerx 10,1000, False
End Sub

Sub DoOrder()
	Dim hogb, cPos, dmsg, stmp
	Dim sHnam

	init_data()										'주문 기본세팅

	stmp = Trim(GetMkCode(IMAXEXID.Data) )

'IMAX 321뉴욕 537나스닥 66아맥스
	If stmp <> "81" And  stmp <> "82" And stmp <> "87" Then
		MsgBox "미국주식만 가능합니다.", , "IBK투자증권"
		Exit Sub
	End If

	If Error_check() = False Then			'주문전 Error Check
		flash_fg.Data = 0
		Exit Sub
	End If

	'개인 3억이상 주문시 경고창 5억이상 주문시 주문 거부창
'법인 5억이상 주문시 경고차 10억이상 주문시 주문 거부창
'매도 매수화면의 거래시 필요한 원화 계산  환율 * 원화 * 수량
	If Len(Trim(out_ERate.Data)) = 0 Or Len(Trim(IMAXPRICE.Data)) = 0 Or ed_jqty.Data = 0 Then
		Exit Sub
	End If

	If IsCorporation(ed_acno.Data) = True Then  '법인
		If Round(CDbl(out_ERate.Text) * CDbl(IMAXPRICE.Text) * ed_jqty.Data, 0) >= 1000000000 Then
			MsgBox "주문금액 10억이상 불가합니다..",,"IBK투자증권"
			Exit Sub
