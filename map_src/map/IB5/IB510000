_AW_ONCLICK_AW_
dbx.Text = ed_focod.Data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_account)
_AW_ONCLICK_AW_
Select Case tab_account.ID
Case 1
	OBJ_account.SetObject ("IB510021")
Case 2
	OBJ_account.SetObject ("IB510022")
Case 3
	OBJ_account.SetObject ("IB510023")
Case 4
	OBJ_account.SetObject ("IB510024")
Case Else
	Exit Sub
End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_focod)
_AW_ONCHANGE_AW_
dbx.Text = "CHANG"
Call send_sise_all("main")
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


