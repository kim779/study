Sub CalWon()
SYSTEM.Trace "!!!!!!!!!!!!!!!!!!!!!!!!!CalWon map="& SCREEN.GetMapName(0)
	If Trim(QTYPE.Text) <> "QUERY" Then
		SCREEN.IgnoreChange False
