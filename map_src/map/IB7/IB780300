RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim bTrans
Dim ii, item, strDate, strTime

'grid0의 getIndex
Sub GetGridCellToSetGridCell(gridName, getIndex, setIndex)

	For ii = 1 To SCREEN.Object("OBJECT1.GRID0").Columns
		If ii = 5 Then		'전일대비일때 간격맞춰주기 위해서.. 공백을 없애주니 간격이 맞아짐.
			item =  SCREEN.Object("OBJECT1.GRID0").GetGridCell(getIndex, ii)
			item = Replace(item, " ", "")
		ElseIf ii = 10 Then	'일시에 시간도 더해주기 위해서..
			item = SCREEN.Object("OBJECT1.GRID0").GetGridCell(getIndex, ii)
			strDate = Mid(item, 1,4) & "/" & Mid(item, 5,2) & "/" & Mid(item, 7,2)
			item = SCREEN.Object("OBJECT1.GRID0").GetGridCell(getIndex, ii +1)

			If(IsNumeric(item)) Then
				strTime = Mid(item, 1,2) & ":" & Mid(item, 3,2) & ":" & Mid(item, 5,2)
			Else
				strTime = Mid(item, 1,1) & " " & Mid(item, 2,1) & " " & Mid(item, 3,1)
			End If

			item = strDate & " " & strTime
		Else
			item = SCREEN.Object("OBJECT1.GRID0").GetGridCell(getIndex, ii)
		End If

		SCREEN.Object(gridName).SetGridCell setIndex, ii, item
	Next

End Sub

Sub SetRealData()
	SetData()
	If(Trim(jnam.Data) = "" Or bTrans = "1") Then
		FindName()
	End If
End Sub

Sub SetData()

' grid1
	Call GetGridCellToSetGridCell("GRID1", 1, 1)		' KOSPI
	Call GetGridCellToSetGridCell("GRID1", 3, 2)		' KOSPI200
	Call GetGridCellToSetGridCell("GRID1", 2, 3)		' KOSDAQ
	Call GetGridCellToSetGridCell("GRID1", 4, 4)		' 코스피200 F 201203
	Call GetGridCellToSetGridCell("GRID1", 11, 5)		' S&P 500 선물
	Call GetGridCellToSetGridCell("GRID1", 9, 6)		' 나스닥100 선물
	Call GetGridCellToSetGridCell("GRID1", 10, 7)		' MINI 나스닥 100 선물
	Call GetGridCellToSetGridCell("GRID1", 12, 8)		' 니케이 225
	Call GetGridCellToSetGridCell("GRID1", 13, 9)		' 상해종합
	Call GetGridCellToSetGridCell("GRID1", 14, 10)		' 항셍
	Call GetGridCellToSetGridCell("GRID1", 15, 11)		' 홍콩 H
	Call GetGridCellToSetGridCell("GRID1", 16, 12)		' 상해 B
	Call GetGridCellToSetGridCell("GRID1", 17, 13)		' 심천 B
	Call GetGridCellToSetGridCell("GRID1", 18, 14)		' 인도 BOMBAY
	Call GetGridCellToSetGridCell("GRID1", 19, 15)		' 대만 가권
	Call GetGridCellToSetGridCell("GRID1", 20, 16)		' 베트남 호치민
	Call GetGridCellToSetGridCell("GRID1", 6, 17)		' 다우산업
	Call GetGridCellToSetGridCell("GRID1", 8, 18)		' S&P 500
	Call GetGridCellToSetGridCell("GRID1", 7, 19)		' 나스닥 종합
	Call GetGridCellToSetGridCell("GRID1", 22, 20)		' 필라델피아 반도체
	Call GetGridCellToSetGridCell("GRID1", 23, 21)		' 멕시코 INMEX
	Call GetGridCellToSetGridCell("GRID1", 21, 22)		' 브라질 BOVESPA
	Call GetGridCellToSetGridCell("GRID1", 24, 23)		' 영국 FTSE100
	Call GetGridCellToSetGridCell("GRID1", 25, 24)		' 독일 Xetra DAX
	Call GetGridCellToSetGridCell("GRID1", 26, 25)		' 프랑스 CAC40
	Call GetGridCellToSetGridCell("GRID1", 27, 26)		' 러시아 RTSL

' grid2
	Call GetGridCellToSetGridCell("GRID2", 28, 1)		' 원/달
	Call GetGridCellToSetGridCell("GRID2", 31, 2)		' 일본 엔/달러
	Call GetGridCellToSetGridCell("GRID2", 32, 3)		' 달러/유로
	Call GetGridCellToSetGridCell("GRID2", 33, 4)		' 중국 위안/달러
	Call GetGridCellToSetGridCell("GRID2", 34, 5)		' CD 91일
	Call GetGridCellToSetGridCell("GRID2", 35, 6)		' 국고채권 3
	Call GetGridCellToSetGridCell("GRID2", 36, 7)		' 회사채권(무보증AA-)
	Call GetGridCellToSetGridCell("GRID2", 37, 8)		' 브렌트유 12-01
	Call GetGridCellToSetGridCell("GRID2", 38, 9)		' WTI 12-01
	Call GetGridCellToSetGridCell("GRID2", 40, 10)		' 금 11-12
	Call GetGridCellToSetGridCell("GRID2", 41, 11)		' DDR2
	Call GetGridCellToSetGridCell("GRID2", 42, 12)		' DDR3

End Sub

Sub SendOBJ()
	Dim codx

	'해외지수 5 국내지수 2
	codx = symb.Data

	If(Trim(codx) ="") Then
		codx = "001"
	End If

	symb.Data = codx
	FLAG.Data = "5"

	If(codx = "001" Or codx = "101" Or codx = "201" Or codx = "101FC000") Then
		FLAG.Data = "2"
	End If

	bTrans = "1"

	OBJECT1.Proc "SendData", ""
	OBJECT0.Send

End Sub

Sub FindName()

	Dim Code, Name
	For ii = 1 To SCREEN.Object("OBJECT1.GRID0").Rows
		Code = SCREEN.Object("OBJECT1.GRID0").GetGridCell(ii, 1)

		If (Trim(Code) = Trim(symb.Data)) Then
			Name = SCREEN.Object("OBJECT1.GRID0").GetGridCell(ii, 3)
		End If
	Next
		jnam.Data = Name

'	bTrans = "0"

End Sub

