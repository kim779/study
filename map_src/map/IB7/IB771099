_AW_ONDECLARE_AW_
Dim count

Sub IsReal_check()
	Select Case UT1.index
		Case 2
			If is_real.Checked = False Then
				SCREEN.Object("obj01.1301").Clear
				SCREEN.Object("obj01.1021").Clear
'				S1021.clear
				count = 0
			Else
				SCREEN.Object("obj01.1301").Data = S1301.Data
				SCREEN.Object("obj01.1021").Data = "A" + S1301.Data

				'ELW인지 주식종목인지 구별
				If Trim(S1301.Data) <> "" Then
					If IsNumeric(Left(Trim(S1301.Data), 1)) = False Then
						Exit Sub
					End If
					If Trim(SCREEN.GetCodeType(S1301.Data)) = "27" Then	'ETN은 'Q'로 시작함
						SCREEN.Object("obj01.1021").Data = "Q" + S1301.Data
					Else
						If Left(Trim(S1301.Data), 1) < 5 Or Left(Trim(S1301.Data), 1)>8 Then
							SCREEN.Object("obj01.1021").Data = "A" + S1301.Data
						Else
							SCREEN.Object("obj01.1021").Data = "J" + S1301.Data
						End If
					End If
				End If

				If count = 0 Then
					SCREEN.Send 0
					count = 1
				End If
			End If
		Case Else
	End Select
End Sub
'-----------------------------------------------------------------------
Sub SetHogaVisible()
	If  OBJ01.GetObject = "IB200510" Then
		Sindex = "0"
		If SCREEN.CreateObject("Info") Then
			Sindex = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB200510", "HOGA_INDEX"))
			If Len(Sindex) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB200510", "HOGA_INDEX", "0"
				Sindex = "0"
			End If
		End If
		If SIndex = "0" Then
			bt_Hoga.Text = "10호가"
		Else
			bt_Hoga.Text = "5호가"
		End If
		OBJ01.Proc "ProcSetVisible", Sindex
	End If
End Sub

_AW_ONSTART_AW_
count = 0

Select Case UT1.index
	Case 1
		bt_Hoga.Visible = True
		is_real.Visible False
	Case 2
		is_real.Visible True
		bt_Hoga.Visible = False
	Case Else
		is_real.Visible False
		bt_Hoga.Visible = False
End Select
SetHogaVisible

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Call IsReal_check()
'SYSTEM.Trace "TRN"

