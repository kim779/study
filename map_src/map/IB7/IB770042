RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub ClickLink(row)

	Dim data, msg
	If UTAB1.ID = 2 Then
		data = GRID21.GetGridCell(row, 2)
	ElseIf UTAB1.ID = 3 Then
		data = GRID22.GetGridCell(row, 2)
	End If

	If Trim(data) <> "" Then
		msg = "IB" & data & "00 /t/d/p5/S"
		SCREEN.CreateWindow 1, msg, ""
	End If
End Sub

Sub InitPosition(data)
'	MsgBox data

	Dim array
	array = Split(data, ";")




'	indx = SCREEN.Object("obj_noti.oevent").data

	If array(0) = 0 Then
		GRID11.Visible = True
		GRID12.Visible = False
		GRID21.Visible = False
		GRID22.Visible = False
		GRID41.Visible = False


		For ii=1 To GRID11.Rows
			data = Trim(GRID11.GetGridCell(ii, 4))

			If data = "1" Then
				SCREEN.Object("bt1" & ii).Visible True
			End If

			SCREEN.Object("point1" & ii).Visible True
		Next
	ElseIf array(0) = 1 Then
		GRID11.Visible = False
		GRID12.Visible = True
		GRID21.Visible = False
		GRID22.Visible = False
		GRID41.Visible = False

		For ii=1 To GRID12.Rows
			data = Trim(GRID12.GetGridCell(ii, 3))

			If data = "1" Then
				SCREEN.Object("bt1" & ii).Visible True
			End If

			SCREEN.Object("point1" & ii).Visible True
		Next
	ElseIf array(0) = 2 Then
		GRID11.Visible = False
		GRID12.Visible = False
		GRID21.Visible = True
		GRID22.Visible = False
		GRID41.Visible = False

		For ii=1 To GRID21.Rows
			data = Trim(GRID21.GetGridCell(ii, 4))

			If data = "1" Then
				SCREEN.Object("bt1" & ii).Visible True
			End If

			SCREEN.Object("point1" & ii).Visible True
			SCREEN.Object("link2" & ii).Visible True
		Next
	ElseIf array(0) = 3 Then
		GRID11.Visible = False
		GRID12.Visible = False
		GRID21.Visible = False
