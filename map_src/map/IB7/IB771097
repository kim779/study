				check = con20.Text
		End Select

		For jj = 1 To GRID2.rows
			searchString = Trim(GRID2.GetGridCell(jj, 2))

			If Trim(check) = "1" Then
				result = InStr(searchString, searchChar)
			End If

			If Trim(result) = "0" Then
				news.Text = "일치하는 뉴스 없음"
			Else
				news.Text = "일치"

				If Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "SOUND")) = "1" Then
					SCREEN.CreateObject "DX_WAVE"
					DX_WAVE.play "CHIMES"
				End If


				If Trim(GRID2.GetGridCell(jj, 11)) = "" Then
					Exit For
				Else
					If Trim(strKeys) = "ALL" Or InStr(strKeys,Trim(GRID2.GetGridCell(ii,7))) > 0 Then
						GRID1.InsertRow 0												'add GRID row
						GRID1.SetGridCell 1, 1, Mid(GRID2.GetGridCell(jj, 11), 1, 8)	'DATE
						GRID1.SetGridCell 1, 2, GRID2.GetGridCell(jj, 6)				'TIME
						GRID1.SetGridCell 1, 3, GRID2.GetGridCell(jj, 2)				'TITLE
						GRID1.SetGridCell 1, 4, v_name
						GRID1.SetGridCell 1, 6, GRID2.GetGridCell(jj, 4)				'종목코드
						GRID1.SetGridCell 1, 8, GRID2.GetGridCell(jj, 3)				'RECN
						GRID1.SetGridCell 1, 11, GRID2.GetGridCell(jj, 10)				'flag
						GRID1.SetGridCell 1, 10, GRID2.GetGridCell(jj, 11)
					End If				'keyv
				End If
				GRID2.Clear()
				Exit Sub
			End If
		Next
	Next
	GRID2.Clear()
End Sub


