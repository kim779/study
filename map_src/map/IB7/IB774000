RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
cxMarket.MNum = SCREEN.GetMapName(1)
cxMarket.Major = SCREEN.Major

SYSTEM.Push "7740_LAST", ""
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1777.Data =  "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1777.Data =  "3"
	End If
	'SYSTEM.Trace "yes cxMarket 1777 = " & S1777.Data
Else
	SYSTEM.Trace "no cxMarket map = " & SCREEN.GetMapName(0)
End If

SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
SYSTEM.Push "7740_LAST", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If Trim(S1301.Data) = "000000" Or Len(Trim(S1301.Data)) < 6 Then
	S1301.SetFocus
	Exit Sub
End If

obj_hnam.Send
S1301.Trigger "",True

If Trim(S1301.Data) <> "" And Trim(SYSTEM.Pop("7740_LAST")) <> Trim(S1301.Data) Then
	BROWSER0.Navigate("http://newdart.fss.or.kr/html/search/SearchCompanyIR_M.html?textCrpNm="&Trim(S1301.Data))
	SYSTEM.Push "7740_LAST", S1301.Data
Else

End If

S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

If UCase(TypeName( SCREEN.Object("cbSOrder") )) <> "NOTHING" Then
	If cxMarket.sMarket = "통합" Then
		cbSOrder.Data = "S"
	ElseIf cxMarket.sMarket = "KRX" Then
		cbSOrder.Data = "1"
	ElseIf cxMarket.sMarket = "NXT" Then
		cbSOrder.Data = "N"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



