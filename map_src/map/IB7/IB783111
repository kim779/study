RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB783111"



Sub write_set( a )

If SCREEN.CreateObject("INFO") Then
	INFO.PushData LOGIN.Name, myFILE, myMAP, "SAVE", a

End If

If a = "1" Then
	GRID0.SetHead 9, "시간"
Else
   	GRID0.SetHead 9, "거래일"
End If

End Sub

Sub read_set()

	SCREEN.CreateObject("INFO")

	Dim a
	a = INFO.PopData( LOGIN.Name, myFILE, myMAP, "SAVE" )
	Select Case a
	Case "1" R_1.Checked = True
	Case "2" R_3.Checked = True
	Case "3" R_4.Checked = True
	Case "4" R_5.Checked = True
	Case "5" R_6.Checked = True
	Case Else
		R_1.Checked = True
		a = "1"
	End Select

	If a = "1" Then
	GRID0.SetHead 9, "시간"
Else
   	GRID0.SetHead 9, "거래일"
End If

	gubn.Data = a
	SCREEN.Send 0

End Sub

_AW_ONSTART_AW_
read_set()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
codx = GRID0.GetGridCell(1, 1)
'SYSTEM.Trace "codx" & codx
cox = Trim(codx)
If codx = "" Then
	Exit Sub
End If
SCREEN.Object ("main.symb").text = codx
SCREEN.Object("main.OBJ20").send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim str, codx
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

str = GRID0.GetGridCell(GRID0.Row, 2)
codx = GRID0.GetGridCell(GRID0.Row, 1)


str = Trim(str)
cox = Trim(codx)
If str = "" Or codx = "" Then
	Exit Sub
End If

SCREEN.Object ("main.symb").text = codx
SCREEN.Object("main.OBJ20.LABEL0").text = str
SCREEN.Object("main.OBJ20.EDIT0").Data = codx
SCREEN.Object("main.OBJ20").send
