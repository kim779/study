		Exit Sub
	End If
	key_text = GRID0.GetGridCell(1, 3) '제목

	If Trim(key_text) <= "" Then
		Exit Sub
	End If

	key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.
	SCREEN.CreateWindow 4, "IBNEWSXX /S/t/d/p1", "015"& vbTab & key_text & vbLf & _
		"016" & vbTab & key_value & vbLf & "1301" & vbTab & Mid(GRID0.GetGridCell(1, 6), 2)
End Sub

