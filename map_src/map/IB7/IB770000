_AW_ONDECLARE_AW_
Dim flag
flag = False

'FIRST가 1이면 체크안된거고, 0이면 체크된거임.
'TODAY가 없으면 FIRST를 1로 세팅한다.
Sub Set_Ini()
	Dim Today, Check

	If SCREEN.CreateObject("Info") Then

	 	Today = INFO.PopData("", "NOTICECOOKIE.ini", "7700", "TODAY")

	 	If Today = "0" Then
	 		INFO.PushData "", "NOTICECOOKIE.INI", "7700", "TODAY", CDAT.Data
			INFO.PushData "", "NOTICECOOKIE.ini", "7700", "FIRST", "1"
	 	Else
	 		INFO.PushData "", "NOTICECOOKIE.INI", "7700", "TODAY", CDAT.Data
	 	End If

	 	Check = INFO.PopData("", "NOTICECOOKIE.ini", "7700", "FIRST")

	 	If Check = "0" Then
	 		CHECK0.Checked = True
			INFO.PushData "", "NOTICECOOKIE.ini", "7700", "FIRST", "0"
	 	Else
	 		CHECK0.Checked = False
			INFO.PushData "", "NOTICECOOKIE.ini", "7700", "FIRST", "1"
	 	End If
	End If

End Sub

Sub Set_Ini2(data)
	Dim evnt, comp, evis
	Dim tp, mi, si, mt, st, ms, ss

	If SCREEN.CreateObject("Info") Then

	 	tp = INFO.PopData("", "NOTICE7700_2.INI", "TYPE", "TP")

		Select Case tp
		Case "A"	'A TYPE
			mi = Trim(INFO.PopData("", "NOTICE7700_2.INI", "ATYPE", "MI"))
			si = Trim(INFO.PopData("", "NOTICE7700_2.INI", "ATYPE", "SI"))
			mt = Trim(INFO.PopData("", "NOTICE7700_2.INI", "ATYPE", "MT"))
			st = Trim(INFO.PopData("", "NOTICE7700_2.INI", "ATYPE", "ST"))
			ms = Trim(INFO.PopData("", "NOTICE7700_2.INI", "ATYPE", "MS"))
			ss = Trim(INFO.PopData("", "NOTICE7700_2.INI", "ATYPE", "SS"))

		Case "B"	'B TYPE
			mi = Trim(INFO.PopData("", "NOTICE7700_2.INI", "BTYPE", "MI"))
			si = Trim(INFO.PopData("", "NOTICE7700_2.INI", "BTYPE", "SI"))
			mt = Trim(INFO.PopData("", "NOTICE7700_2.INI", "BTYPE", "MT"))
			st = Trim(INFO.PopData("", "NOTICE7700_2.INI", "BTYPE", "ST"))
			ms = Trim(INFO.PopData("", "NOTICE7700_2.INI", "BTYPE", "MS"))
			ss = Trim(INFO.PopData("", "NOTICE7700_2.INI", "BTYPE", "SS"))

		Case "C"	'C TYPE
			mi = Trim(INFO.PopData("", "NOTICE7700_2.INI", "CTYPE", "MI"))
			si = Trim(INFO.PopData("", "NOTICE7700_2.INI", "CTYPE", "SI"))
			mt = Trim(INFO.PopData("", "NOTICE7700_2.INI", "CTYPE", "MT"))
			st = Trim(INFO.PopData("", "NOTICE7700_2.INI", "CTYPE", "ST"))
			ms = Trim(INFO.PopData("", "NOTICE7700_2.INI", "CTYPE", "MS"))
			ss = Trim(INFO.PopData("", "NOTICE7700_2.INI", "CTYPE", "SS"))

		Case Else
			Exit Sub
		End Select

		If data = "mc" Then '메인클릭
			If Trim(ms) <> "" Then
				If mt = "1" Then '화면
					SCREEN.CreateWindow 1, "IB" & ms & "00" & "/t/d", ""
				Else 'URL
					SYSTEM.Push "IB980001_URL", ms
					'OBJECT0.SetObject("BLANK")
					'OBJECT0.SetObject("IB980001")
					'SCREEN.Object("OBJECT0").Proc "starturl", ""
					SCREEN.CreateWindow 1, "IB980001 /p?", ""
				End If
			End If

			Exit Sub
		ElseIf  data = "sc" Then '서브클릭
			If Trim(ss) <> "" Then
				If st = "1" Then '화면
					SCREEN.CreateWindow 1, "IB" & ss & "00" & "/t/d", ""
				Else 'URL
					SYSTEM.Push "IB980001_URL", ss
					'OBJECT0.SetObject("BLANK")
					'OBJECT0.SetObject("IB980001")
					'SCREEN.Object("OBJECT0").Proc "starturl", ""
					SCREEN.CreateWindow 1, "IB980001 /p?", ""
				End If
			End If

			Exit Sub
		End If

		'이미지 셋팅
		MAINV.text = mi
		SBMV.Text = si

	End If

	'탭설정
	evnt = INFO.PopData("", "NOTICE7700_2.INI", "NOTICE", "EVENT")
	comp  = INFO.PopData("", "NOTICE7700_2.INI", "NOTICE", "COMPANY")
	evis = INFO.PopData("", "NOTICE7700_2.INI", "VISIBLE", "EVENT")

	Call Set_tab(evnt & ";" & comp & ";" & evis)


	'MsgBox evnt & " : " & comp & " : "& evis &" : "& tp &" : "& mi &" : "& si &" : "& mt &" : "& st &" : "& ms &" : "& ss


End Sub


Sub	Set_tab(data)
	Dim array
	array = Split(data, ";")
	SCREEN.Object("obj_gongzi.UTAB1").index = array(0)
	SCREEN.Object("obj_gongzi.UTAB3").index = array(1)

	SCREEN.Proc "obj_gongzi.InitPosition", data
	SCREEN.proc "obj_gongzi.Set_EventTab", array(2)

End Sub

Sub main_refresh()
	SYSTEM.Trigger "refresh" , "" , "IB201800"
End Sub

