RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim staticTime, SelectObj, maxNumber

Sub StopAction()
	staticTime = -1
End Sub

Sub clickButton(position)
	Dim ii
	For ii=1 To maxNumber
		SCREEN.Object("BUTTON" & (ii-1)).Visible True
		SCREEN.Object("rbtn" & ii).Visible False
	Next


	Select Case position
		Case 0 :
			BUTTON0.Visible False
			rbtn1.Visible True
		Case 1 :
			BUTTON1.Visible False
			rbtn2.Visible True
		Case 2 :
			BUTTON2.Visible False
			rbtn3.Visible True
		Case 3 :
			BUTTON3.Visible False
			rbtn4.Visible True
		Case 4 :
			BUTTON4.Visible False
			rbtn5.Visible True
	End Select
End Sub

Sub buttonVisible(vis)
		Dim ii, row
		BUTTON0.Visible False
		rbtn1.Visible False
		BUTTON1.Visible False
		rbtn2.Visible False
		BUTTON2.Visible False
		rbtn3.Visible False
		BUTTON3.Visible False
		rbtn4.Visible False
		BUTTON4.Visible False
		rbtn5.Visible False

		row = CInt(vis)

		For ii = 1 To row
			If ii=1 Then
				SCREEN.Object("rbtn" & ii).Visible True
			Else
				SCREEN.Object("BUTTON" & (ii-1)).Visible True
			End If
		Next

End Sub

_AW_ONSTART_AW_
staticTime = 0
SelectObj = 0
maxNumber = 0

Call buttonVisible(0)

If SCREEN.CreateObject("Info") Then
 	maxNumber = Trim(INFO.PopData("", "notice7700.ini", "ADNumber", "num"))

 	If Trim(maxNumber) <> "" Then
 		Call buttonVisible(maxNumber)
 	Else
 		maxNumber = 3
 		Call buttonVisible(maxNumber)
 	End If
End If

SCREEN.SetTimer 20, False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If staticTime >= 0 And CInt(staticTime) < CInt(maxNumber) Then

	Select Case staticTime
		Case 0 : obj.SetObject("IB77004A")
				Call clickButton(0)
		Case 1 : obj.SetObject("IB77004B")
				Call clickButton(1)
		Case 2 : obj.SetObject("IB77004C")
				Call clickButton(2)
		Case 3 : obj.SetObject("IB77004D")
				Call clickButton(3)
		Case 4 : obj.SetObject("IB77004E")
				Call clickButton(4)
	End Select

	SelectObj = staticTime
	staticTime = staticTime + 1

	If Trim(staticTime) <> "" And Trim(maxNumber) <> "" Then
		If 	CInt(staticTime) >= CInt(maxNumber) Then
			staticTime = 0
		End If
	Else
		staticTime = -1
	End If

	SCREEN.SetTimer 30, False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(btnLink)
_AW_ONCLICK_AW_
If SCREEN.CreateObject("Info") Then
 	Dim link
 	link = Trim(INFO.PopData("", "notice7700.ini", SelectObj, "url"))
 	SYSTEM.Navigate link & vbTab & "1000" & vbTab & "800"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


