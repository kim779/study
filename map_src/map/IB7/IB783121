RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB783121"



Sub write_set( a )

If SCREEN.CreateObject("INFO") Then
	INFO.PushData LOGIN.Name, myFILE, myMAP, "SAVE", a

End If

End Sub

Sub read_set()

	SCREEN.CreateObject("INFO")

	Dim a
	a = INFO.PopData( LOGIN.Name, myFILE, myMAP, "SAVE" )

	If IsNumeric(a) Then
		COMBO1.Index = a
	Else
		COMBO1.Index = 0
	End If

	SCREEN.Send 0

End Sub

_AW_ONSTART_AW_
read_set()

'SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(COMBO1)
_AW_ONCHANGE_AW_
write_set(COMBO1.Index)

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



