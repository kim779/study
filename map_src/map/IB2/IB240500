_AW_ONDECLARE_AW_
Sub SetGrid()
	If COMBO2.Data = "9" Then
		GRID0.SetColumnVisible 8, True
		GRID0.SetColumnVisible 9, True

		GRID0.SetColumnWidth 2, 107
		GRID0.SetColumnWidth 3, 90
		GRID0.SetColumnWidth 4, 69
		GRID0.SetColumnWidth 5, 67
		GRID0.SetColumnWidth 6, 71
		GRID0.SetColumnWidth 7, 64

	Else
		GRID0.SetColumnVisible 8, False
		GRID0.SetColumnVisible 9, False

		GRID0.SetColumnWidth 2, 128
		GRID0.SetColumnWidth 3, 110
		GRID0.SetColumnWidth 4, 90
		GRID0.SetColumnWidth 5, 88
		GRID0.SetColumnWidth 6, 92
		GRID0.SetColumnWidth 7, 85

	End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)

SYSTEM.Trace "[IB240500]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0

End Sub

_AW_ONSEND_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

