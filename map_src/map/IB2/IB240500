Dim code

If GRID0.HitPos = 3 Then
	code = GRID0.GetGridCell(GRID0.row, 1)
	If Trim(code) <> "" Then
		S1301.Data = code
		S1301.Trigger "", True
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(company)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To GRID0.Rows
	str = str & Trim(GRID0.GetGridCell(i, 1))
	str = str & vbTab
	str = str & Trim(GRID0.GetGridCell(i, 2))
	str = str & vbLf
Next
If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, GRID0.Rows
End If
