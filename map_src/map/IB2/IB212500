RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim upcd_flg
upcd_flg = 1

Const myFILE = "userconf.ini"
Const myMAP = "IB212500"

Sub p_write_com()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "COMBO1", S200901.Data

End If
End Sub

Sub p_read_com()
If SCREEN.CreateObject("Info") Then
 	S200901.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COMBO1"))
End If

If Len(Trim(S200901.data)) = 0 Then
	S200901.data = "001"
	c_upgb.DATA = "001"
End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

Call p_read_com()
S200901.Data = c_upgb.Data
If S200901.Data = 889 Then
	S200901.Enable = False
	UBUT.Enable = False
Else
	S200901.Enable = True
	UBUT.Enable = True
End If

SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
'거래소 선택
If r_masu.Checked = True Then
	msgb.data = "0"				'매수
Else
	msgb.data = "1"				'매도
End If

'Grid Head 바꾸기..
If msgb.Data = "0" Then
	S200500.SetHead  9, "매수수량"
  	S200500.SetHead 10, "매수비중"
Else
	S200500.SetHead  9, "매도수량"
	S200500.SetHead 10, "매도비중"
End If

If cxMarket.sMarket = "KRX" Then
	S200777.DATA = "1"
ElseIf cxMarket.sMarket = "NXT" Then
	S200777.DATA = "2"
ElseIf cxMarket.sMarket = "통합" Then
	S200777.DATA = "3"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If S200901.Data = 889 Then
	c_upgb.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(200500)
_AW_ONDBLCLK_AW_
Dim code

If S200500.HitPos = 3 Then
	code = S200500.GetGridCell(S200500.Row, 2)

	If Trim(code) <> "" Then
		S1301.Data = code
		S1301.Trigger "", True
		SYSTEM.SetHistory "1301", S1301.DATA
'		SCREEN.CreateWindow 1, "IB201400 /t/s/d", "1301" & vbTab & S1301.Data & vbLf
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r_mado)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(chck_fo)
_AW_ONCLICK_AW_
If chck_fo.Checked = True Then
   fogb.Data = "1"
Else
   fogb.Data = "0"
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(r_masu)
_AW_ONCLICK_AW_

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(MGGB)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(MVOL)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UBUT)
_AW_ONCLICK_AW_
Dim retn

Select Case c_upgb.Data
	Case "001", "101", "401"		'KOSPI, KOSPI200, KOSPI100
		retn = SCREEN.GetCode(104, "200901", "200022", 0)
	Case "201"							'KOSDAQ
		retn = SCREEN.GetCode(104, "200901", "200022", 9)
	Case "501"							'KONEX
		retn = SCREEN.GetCode(104, "200901", "200022", 501)
End Select


If (retn <> True) Then
	S200901.SetFocus
	Exit Sub
Else
	S200901.SetFocus
	SCREEN.Send 2
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(200901)
_AW_ONCHANGE_AW_
Dim	cod
If S200901.Data = 998 Then
	c_upgb.Setfocus
End If

If (Len(Trim(S200901.Data)) <> 3) Then
	S200901.SetFocus
	Exit Sub
Else
	SCREEN.IgnoreChange True
	r_upgb = P_GetBigCd(S200901.DATA)
	If S200901.Data = 889 Then
		r_upgb = 889
	End If
	Select Case r_upgb
		Case "001"		'KOSPI
			c_upgb.DATA = r_upgb
		Case "101"		'KOSPI200
			c_upgb.DATA = r_upgb
		Case "201"		'KOSDAQ
			c_upgb.DATA = r_upgb
		Case "301"		'KOSDAQ50
			c_upgb.DATA = r_upgb
		Case "303"		'KOSTAR
			c_upgb.DATA = r_upgb
		Case "401"		'KOSPI100
			c_upgb.DATA = r_upgb
		Case "501"		'KONEX
			c_upgb.DATA = r_upgb
		Case "889"
			c_upgb.Data = r_upgb
		Case Else
		   S200901.DATA = "001"
		   c_upgb.DATA = "001"
	End Select

	If upcd_flg = 1 Then
		upcd_flg = 2
	Else
		Call p_write_com()
		SCREEN.Send 2
	End If
	SCREEN.IgnoreChange False
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_upgb)
_AW_ONCHANGE_AW_
SCREEN.IgnoreChange True
S200901.Data = c_upgb.Data
SCREEN.IgnoreChange False

If S200901.Data = 889 Then
	S200901.Enable = False
	UBUT.Enable = False
Else
	S200901.Enable = True
	UBUT.Enable = True
End If

SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.DATA))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



