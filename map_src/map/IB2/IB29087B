_AW_ONDECLARE_AW_
Dim tu_sum, tu_int, t_sum, val

Function Is_numeric(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		Is_numeric = 0
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Is_numeric = 0
		Exit Function
	End If

	Is_numeric = CDbl(num)
End Function

Sub sendobj()
Dim i
	vagb.Data = 0 '금액
	If Left(Trim(SCREEN.Object("parent.TABLE14").GetHead(1)) , 1) <> "M" Then
		For i = 1 To 3
			SCREEN.Object("v"&i).visible = True
		Next
		For i = 4 To 6
			SCREEN.Object("v"&i).visible = False
		Next
	Else
		For i = 1 To 3
			SCREEN.Object("v"&i).visible = False
		Next
		For i = 4 To 6
			SCREEN.Object("v"&i).visible = True
		Next
	End If
End Sub

_AW_ONSEND_AW_
Call sendobj()


If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
