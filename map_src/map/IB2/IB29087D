{


_AW_ONDECLARE_AW_
Sub OnAlert()
	For upcd=0 To 3
		For ii=1 To 12
			If ii < 10 Then
				t_head = "t"&upcd&"0"
				n_head = "n"&upcd&"0"
				v_head = "v"&upcd&"0"
			Else
				t_head = "t"&upcd
				n_head = "n"&upcd
				v_head = "v"&upcd
			End If

			code = SCREEN.OBJECT(t_head&ii).GetTableCell(1)
			SCREEN.OBJECT(v_head&ii).SetTableCell 1, code

			For jj=2 To 7
				data1 = SCREEN.OBJECT(t_head&ii).GetTableCell(jj)
				data2 = SCREEN.OBJECT(n_head&ii).GetTableCell(jj)

				If Len(Trim(data1)) = 0 Then
					data1 = 0
				End If

				If Len(Trim(data2)) = 0 Then
					data2 = 0
				End If

				data = CLng(data1) + CLng(data2)
				If jj=6 Or jj=7 Then
					If data > 0 Then
						data = "+"&data
					End If
				End If
				SCREEN.OBJECT(v_head&ii).SetTableCell jj, data
			Next
		Next
	Next
End Sub

_AW_ONSTART_AW_
fday.data = SCREEN.Object("parent.fday").data
tday.data = SCREEN.Object("parent.tday").data

