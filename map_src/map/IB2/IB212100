RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Change_MKGubn_Main(sMKGubn)

SYSTEM.Trace "[IB212100]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0


End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_

If SHYUL.Data = "1" Then
	GRID.Column = 6
	GRID.Head = "상승폭"
	GRID.Column = 7
	GRID.Head = "상승율"
Else
	GRID.Column = 6
	GRID.Head = "하락폭"
	GRID.Column = 7
	GRID.Head = "하락율"
End If

'	GRID.Column = 5
'	GRID.Head = TME_GB.Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID)
_AW_ONDBLCLK_AW_
If GRID.HitPos = 3 Then
	X301.DATA = GRID.GetGridCell(GRID.Row, 2)
	If Trim(X301.DATA) = "" Then
	    Exit Sub
	End If

	X301.Trigger "1301", True
	SYSTEM.SetHistory "1301", X301.DATA
'	SCREEN.CreateWindow 1, "IB201400 /t/s/d", "1301" & vbTab & X301.DATA & vbLf
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(company)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To GRID.Rows
	str = str & Trim(GRID.GetGridCell(i, 3))
	str = str & vbTab
	str = str & Trim(GRID.GetGridCell(i, 5))
	str = str & vbLf
Next

If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, GRID.Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GIVOL)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(KOSPIGB)
_AW_ONCHANGE_AW_
SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SHYUL)
_AW_ONCHANGE_AW_
SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GTIME)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To GRID.Rows
	str = str & Right(Trim(GRID.GetGridCell(i, 2)), 6)
	str = str & vbTab
	str = str & Trim(GRID.GetGridCell(i, 3))
	str = str & vbLf
Next

If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, GRID.Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
