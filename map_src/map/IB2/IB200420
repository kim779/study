	smsu = Trim(t_smsu.GetTableCell(1))
	If Len(smsu) > 0 Then
		If InStr(1, smsu, "+") > 0 Then
			giho = "+"
		ElseIf InStr(1, smsu, "-") > 0 Then
			giho = "-"
		End If
		smsu = Replace(smsu, giho, "")
		smsu = FormatCurrency(smsu)
		smsu = Mid(smsu, 2, Len(smsu)-1)
		TABLE5.SetTableCell 1, giho&smsu
	End If
End Sub
