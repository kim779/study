_AW_ONDECLARE_AW_
Option Explicit

Dim startFlag
startFlag = 1

Sub SetCompNm()
	Dim ii, compNm_b, compNm
	compNm_b = ""
	compNm = ""

	For ii = 0 To 999
		WCODF.Index = ii

		compNm = Trim(WCODF.Text)

		If Trim(compNm_b) <> Trim(compNM) Then
			compNm_b = compNm
			GRID0.InsertRow -1
			GRID0.SetGridCell GRID0.Rows, 1, compNm
		Else
			Exit For
		End If
	Next

	GRID0.Index = 0
	WCODF.Index = 0
End Sub


Sub selUpcd()
	Dim IsBool

	If Trim(UPCD.Data) = "888" Then
		IsBool = False
	Else
		IsBool = True
	End If

	PANEL0.Visible = IsBool
	S200901.Visible = IsBool
	UBUT.Visible = IsBool
	S200022.Visible = IsBool

'	SYSTEM.Trace "upcd onchange upcd = " & UPCD.Data
'	SYSTEM.Trace "upcd onchange s200901 = " & S200901.Data

	S200901.Data = Trim(UPCD.Data)
	S200022.Data = SCREEN.GetName(104, S200901.Data, 0)
End Sub



Sub selMMgb()
	If R1_1.Checked = True Then
		obj.SetObject "IB240210"
	Else
		obj.SetObject "IB240220"
	End If

	obj.Send
End Sub


Sub Change_MKGubn_Main(sMKGubn)

	SYSTEM.Trace "[IB240200]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	obj.Send

End Sub

