_AW_SCRIPT_AW_(200901)
_AW_ONCHANGE_AW_
'SYSTEM.Trace "s200901 onchange upcd = " & UPCD.Data
'SYSTEM.Trace "s200901 onchange s200901 = " & S200901.Data

Dim	cod, r_upgb

If (Len(Trim(S200901.Data)) <> 3) Then
	S200901.SetFocus
	Exit Sub
End If

r_upgb = P_GetBigCd(S200901.Data)

'SYSTEM.Trace "200901 r_upgb = " & r_upgb

Select Case r_upgb
	Case "001"		'KOSPI
		UPCD.Data = r_upgb
	Case "101"		'KOSPI200
		UPCD.Data = r_upgb
	Case "201"		'KOSDAQ
		UPCD.Data = r_upgb
	Case "301"		'KOSDAQ50
		UPCD.Data = r_upgb
	Case "303"		'KOSTA
		UPCD.Data = r_upgb
	Case "401"		'KOSPI100
		UPCD.Data = r_upgb
	Case "888"
		UPCD.Data = r_upgb
		S200901.Data = r_upgb
	Case Else
	   S200901.Data = "001"
	   UPCD.Data = "001"
End Select

S200022.Data = SCREEN.GetName(104, S200901.Data, 0)
obj.Send
