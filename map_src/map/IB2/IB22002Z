	Else
		S31023.Visible = True
		S31024.Visible = True
		S31033.Visible = True
		S31027.Visible = True

		S31111.Visible = False
		S31116.Visible = False
		S31115.Visible = False
		S31112.Visible = False
	End If
End Sub

