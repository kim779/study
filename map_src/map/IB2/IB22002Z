_AW_ONDECLARE_AW_
Sub setFutureCode()
	futureList.Clear
	futureList.Data = Trim(SCREEN.Object("obj_getFutureCode.futureList").Data)
	Dim fcodeArr, ii, items, fdata, idx, fcod
	items = ""
	fcodeArr = Split(Trim(futureList.Data), "|")

	For ii = LBound(fcodeArr)+1 To UBound(fcodeArr)
			fdata = Trim(fcodeArr(ii))
			idx = Left(fdata, 2)
			fcod = Mid(fdata, 3)

			If items = "" Then
				items = idx
			End If

			items = items & vbTab & idx & fcod
	Next

	cFCod.SetItems items
	SCREEN.Send 0
End Sub

Sub codeTrigger()

'	SYSTEM.Trace "cFCod.Text [" & cFCod.Text & "]parent.ed_focod [" & SCREEN.Object("parent.ed_focod").Data & "] main.ed_focod[" & SCREEN.Object("main.ed_focod").data & "]"
	' 2009/03/31 선물코드 클릭시 종목이 트리거될 수 있도록 수정
	ls_codx = Trim(cFCod.Text)
	If SCREEN.Object("main.ed_focod").Data <> ls_codx Then
		SCREEN.Object("parent.ed_focod").Data = ls_codx
		SCREEN.Object("main.ed_focod").data = ls_codx
		SCREEN.Proc "main.send_sise_all", "main"
	End If
End Sub

Sub SetPredict(chkPrd)
	'SYSTEM.Trace "SETPREDICT " & chkPrd
	If chkPrd <> 0 Then
		S31023.Visible = False
		S31024.Visible = False
