_AW_ONDECLARE_AW_
'== D-2 날짜 구하기
Sub getM_1()
	Dim yy, mm, dd, cday, MyWeek

	cday = DateAdd("d", -30, Date)
	MyWeek = Weekday(cday)

	If MyWeek = 1 Then
		cday= DateAdd("d", -2 , cday)
	ElseIf MyWeek = 7 Then
		cday= DateAdd("d", -1 , cday)
	End If

	yy = Year(cday)
	mm = Month(cday)
	dd = Day(cday)

	If Len(mm) = 1 Then mm = "0"&mm
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd
	sdate.Data = CDbl(cday)
End Sub

Sub Change_MKGubn_Main(sMKGubn)

SYSTEM.Trace "[IB200900]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	OBJECT0.Proc "change_code", ""
	Send_Screen()
End Sub

Sub Send_Main()
	cxMarket.sCode = Trim(S1301.Data)
	OBJECT0.Send
End Sub

Sub Send_Screen()
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
End Sub

Sub Clear_grid()
	SCREEN.Object("OBJECT0.GRID0").Clear
End Sub

_AW_ONSTART_AW_
