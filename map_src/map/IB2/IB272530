RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'----------------------------------------------------------
Sub SendData(Data)
	ArrData = Split(Data, "|")
	If UBound(ArrData) < 1 Then
		Exit Sub
	End If
	If ArrData(0) = "1" Then
		ed_cttp.Data = ArrData(1)
	Else
		'ArrData - 0:Type, 1:종목코드, 2:차트타입, 3:연속일자
		ed_code.Data = ArrData(1)
		ed_cttp.Data = ArrData(2)
		ed_ckdt.Data = ArrData(3)
		If Len(Trim(ed_ckdt.Data)) = 0 Then
			Exit Sub
		End If
		ed_date.Data = ArrData(4)
	End If
	SCREEN.Send 0
End Sub
'----------------------------------------------------------
Sub SetInit()
	AYear = Year(Date)
	AMon = Month(Date)
	If Len(AMon) = 1 Then
		AMon = "0" & AMon
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If

	ed_date.Data = AYear & AMon & ADay
End Sub

_AW_ONSTART_AW_
'SetInit

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



