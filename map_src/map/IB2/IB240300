RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB240300"
Dim IsStart
Sub p_read_ini()
If SCREEN.CreateObject("Info") Then
 	CHK.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "G_CHCK"))
End If
End Sub


Sub p_write_ini()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "G_CHCK", CHK.text
End If
End Sub


Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	Send_Screen()

End Sub

Sub Send_Screen()
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

p_read_ini()
IsStart = 0
'If CHK.text = "1" Then
'	CHK.text = "1"
'	OBJECT0.SetObject "IB240310"
'	GRAPH.Text = "그래프"
'Else
'	CHK.text = "2"
'	OBJECT0.SetObject "IB240320"
'	GRAPH.Text = "텍스트"
'End If


Send_Screen()
S1301.SetFocus

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If S1301.Data = "000000" Or Trim(S1301.Data) = "" Or S1301.Data = "      " Then
	SCREEN.OnSend False
Else
	'서비스 명 변경 및 거래소 구분코드 MKCD 추가.
	If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
		If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
			S1777.Data = "1"
		ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
			S1777.Data = "2"
		ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
			S1777.Data = "3"
		End If
	End If
	cxMarket.sCode = Trim(S1301.Data)
	OBJECT0.Send
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If IsStart = 0 Then
	S1301.SetFocus
	IsStart = 1
End If

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRAPH)
_AW_ONCLICK_AW_
If CHK.text = "1" Then
	CHK.text = "2"
	OBJECT0.SetObject "IB240310"
	GRAPH.Text = "차 트"
Else
	CHK.text = "1"
	OBJECT0.SetObject "IB240320"
	GRAPH.Text = "데이터"
End If
cxMarket.sCode = Trim(S1301.Data)
OBJECT0.Send

GRAPH.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_date)
_AW_ONCHANGE_AW_
Send_Screen()
_AW_ONENDSUB_AW_
_AW_ONKEYCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

Send_Screen()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctl_Category)
_AW_ONCLICK_AW_
Dim codx
codx = ctl_Category.GetPreCode(S1301.Data)
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

Send_Screen()

GRAPH.SetFocus
S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim codx
codx = ctl_Category.GetNextCode(S1301.Data)
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

SCREEN.Send 0

GRAPH.SetFocus
S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
S1301.Data = ctl_Category.GetCurCode
S1301.Trigger "",True

SCREEN.Send 0

GRAPH.SetFocus
S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB202201 /t/s/p5/d", "appendCODE" & _
			vbTab & S1301.Data & vbLf & "map" & vbTab & "1" & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If S1301.Data = "000000" Or Trim(S1301.Data) = "" Then
	S1301.Clear
	S1301.SetFocus
	Exit Sub
End If

S1301.Trigger "", True
OBJECT0.ClearAll 2
Send_Screen()

S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

If UCase(TypeName( SCREEN.Object("cbSOrder") )) <> "NOTHING" Then
	If cxMarket.sMarket = "통합" Then
		cbSOrder.Data = "S"
	ElseIf cxMarket.sMarket = "KRX" Then
		cbSOrder.Data = "1"
	ElseIf cxMarket.sMarket = "NXT" Then
		cbSOrder.Data = "N"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



