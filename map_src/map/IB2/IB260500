_AW_ONDECLARE_AW_
Sub Set_radio()
Dim items
items =  "0"

GIVOL.Index = 0

	If r_hogb1.Checked Then
		ed_vagb.Data = 2
		GRID.SetHead 7, "거래대금"
		items = items & vbTab & "1전체" & vbTab & "55억이상" & vbTab & "610억이상" & vbTab & "750억이상" & vbTab & "8100억이상"
	Else
		ed_vagb.Data = 1
		GRID.SetHead 7, "거래량"
		items = items & vbTab & "1전체" & vbTab & "21만주이상" & vbTab & "35만주이상" & vbTab & "410만주이상"

	End If

	GIVOL.SetItems(items)
	GRID.Clear
	SCREEN.Send 0
End Sub

Sub OnGridClickedXX(strdata)
	Dim scode
	Dim arr
	arr = Split(strdata, vbTab, -1, 0)

	scode = GRID.GetGridCell(CInt(arr(2)) + 1, 1)
	S1301.DATA = Mid(scode,2)

	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.DATA
End Sub

Sub OnGridDragClickedXX(strdata)

	Dim scode
	scode = Split(strdata, vbTab, -1, 0)

	S1301.DATA = scode(1)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.DATA

End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	GRID.Clear
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

If cxMarket.sMarket = "KRX" Then
	mkcd.Data = "1"
ElseIf cxMarket.sMarket = "NXT" Then
	mkcd.Data = "2"
ElseIf cxMarket.sMarket = "통합" Then
	mkcd.Data = "3"
End If

