Sub Caldata()
	Dim kospi,kosdaq,k200,kstar, ii
	kospi = kosdaq = k200 = kstar = 0

	rows = rowstart.Data

	For ii = rows To S26500.Rows
		kospi = Trim(S26500.GetGridCell(ii, 2))
		If kospi = "" Then
			kospi = 0
		End If

		kosdaq = Trim(S26500.GetGridCell(ii, 3))
		If kosdaq = "" Then
			kosdaq = 0
		End If

		k200 = Trim(S26500.GetGridCell(ii, 5))
		If k200 = "" Then
			k200 = 0
		End If

		kstar = Trim(S26500.GetGridCell(ii, 6))
		If kstar = "" Then
			kstar = 0
		End If

		S26500.SetGridCell ii, 4, CLng(kospi)+CLng(kosdaq)
		S26500.SetGridCell ii, 7, CLng(k200)+CLng(kstar)


		If CLng(kospi) <> 0 Then
			S26500.SetGridCell ii, 8, FormatNumber(CLng(k200)/CLng(kospi)*100, 2, -1, 0, 0)
		End If

		If CLng(kosdaq) <> 0 Then
			S26500.SetGridCell ii, 9, FormatNumber(CLng(kstar)/CLng(kosdaq)*100, 2, -1, 0, 0)
		End If

		If CLng(kospi) <> 0 Then
			S26500.SetGridCell ii, 10,FormatNumber(CLng(kosdaq)/CLng(kospi)*100, 2, -1, 0, 0)
		End If
	Next
End Sub

