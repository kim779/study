'*************************************************************************
' change_date : 시스템 일자에서 원하는만큼 일자를 옮김
' 호출형식 예) change_date("m",-3) -> 시스템일자에서 3달전 일자를 Return
' m : month , d : day , y : year
'*************************************************************************
Public Function change_date2(dat,diff, tday)
	Dim cday, yy, mm, dd
	Dim y, m,d, temp
	y = Mid(tday,1,4)
	m = Mid(tday,5,2)
	d = Mid(tday,7,2)
	temp = DateSerial(y, m, d)

	cday = DateAdd(dat, diff, temp)

	yy = Year(cday)
	mm = Month(cday)
	If Len(mm) = 1 Then mm = "0"&mm
	dd = Day(cday)
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd

	change_date2 = CDbl(cday)
End Function

