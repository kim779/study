RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Change_MKGubn_Main(sMKGubn)

SYSTEM.Trace "[IB270400]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	func.Data = "F"
	grcd.Data = "901"	'2017-12-14 추가
	SCREEN.Send 0


End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major


func.Data = "F"
grcd.Data = "901"	'2017-12-14 추가
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
func.Data = " "
GRCB.Data = grcd.Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
Dim code

If GRID0.HitPos = 3 Then
	code = GRID0.GetGridCell(GRID0.Index+1, 2)
	If Trim(code) <> "" Then
		S1301.Data = code
		S1301.Trigger "", True
		S1301.Trigger "", False
      SYSTEM.SetHistory "1301", S1301.Data
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRCB)
_AW_ONCHANGE_AW_
grcd.Data = GRCB.Data
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(company)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To GRID0.Rows
	str = str & Trim(GRID0.GetGridCell(i, 2))
	str = str & vbTab
	str = str & Trim(GRID0.GetGridCell(i, 3))
	str = str & vbLf
Next
If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, GRID0.Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

If UCase(TypeName( SCREEN.Object("cbSOrder") )) <> "NOTHING" Then
	If cxMarket.sMarket = "통합" Then
		cbSOrder.Data = "S"
	ElseIf cxMarket.sMarket = "KRX" Then
		cbSOrder.Data = "1"
	ElseIf cxMarket.sMarket = "NXT" Then
		cbSOrder.Data = "N"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



