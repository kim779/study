_AW_ONDECLARE_AW_
Dim real_f, count
real_f = True


Sub Onalert()

	If real_f = False Then
		Exit Sub
	End If

End Sub


Sub IsReal_check()
	If is_real.Checked = False Then
		SCREEN.Object("obj0.1301").Clear
		SCREEN.Object("obj0.1021").Clear
		count = 0
	Else
		SCREEN.Object("obj0.1301").Data = S1301.Data

		If S1777.Data = "1" Then
			SCREEN.Object("obj0.1021").Data = "A" + S1301.Data
		ElseIf S1777.Data = "2" Then
			SCREEN.Object("obj0.1021").Data = "N.A" + S1301.Data
		ElseIf S1777.Data = "3" Then
			SCREEN.Object("obj0.1021").Data = "M.A" + S1301.Data
		End If

		'ELW인지 주식종목인지 구별
		If Trim(S1301.Data) <> "" Then

			If IsNumeric(Left(Trim(S1301.Data), 1)) = False Then
				Exit Sub
			End If

			If Trim(SCREEN.GetCodeType(S1301.Data)) = "27" Then	'ETN은 'Q'로 시작함
				If S1777.Data = "1" Then
					SCREEN.Object("obj0.1021").Data = "Q" + S1301.Data
				ElseIf S1777.Data = "2" Then
					SCREEN.Object("obj0.1021").Data = "N.Q" + S1301.Data
				ElseIf S1777.Data = "3" Then
					SCREEN.Object("obj0.1021").Data = "M.Q" + S1301.Data
				End If

			Else
				If Left(Trim(S1301.Data), 1) < 5 Or Left(Trim(S1301.Data), 1) > 8 Then
					If S1777.Data = "1" Then
						SCREEN.Object("obj0.1021").Data = "A" + S1301.Data
					ElseIf S1777.Data = "2" Then
						SCREEN.Object("obj0.1021").Data = "N.A" + S1301.Data
					ElseIf S1777.Data = "3" Then
						SCREEN.Object("obj0.1021").Data = "M.A" + S1301.Data
					End If
				Else
					SCREEN.Object("obj0.1021").Data = "J" + S1301.Data	 'ELW
				End If
			End If
		End If

		If count = 0 Then
			SCREEN.Send 0
			count = 1
		End If

	End If
End Sub

Sub MKTriggerFromMain(sdata)
	cxMarket.sMarket = sdata
	SCREEN.Send 0
End Sub

