_AW_ONDECLARE_AW_
Sub sendobj()
Dim i
	vagb.Data = 1 '수량
	If Left(Trim(SCREEN.Object("parent.LABEL3").data) , 1) <> "M" Then
		For i = 1 To 3
			SCREEN.Object("v"&i).visible = True
		Next
		For i = 4 To 6
			SCREEN.Object("v"&i).visible = False
		Next
	Else
		For i = 1 To 3
			SCREEN.Object("v"&i).visible = False
		Next
		For i = 4 To 6
			SCREEN.Object("v"&i).visible = True
		Next
	End If
End Sub

_AW_ONSEND_AW_
Call sendobj()

