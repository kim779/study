_AW_SCRIPT_AW_(ed_fcod)
_AW_ONCHANGE_AW_
Dim name, cdType
name = ""

If Trim(ed_fcod.Data) <> "" Then
	cdType = Mid(Trim(ed_fcod.Data), 2, 2)

	If Trim(cdType) <> "" Then
		If IsNumeric(cdType) = False Then
			SCREEN.Object("main.GUIDE").Text = "종목번호를 확인하여 주십시오."
			Exit Sub
		End If

		If ("10" <= cdType And cdType <= "59")     Or     ("B0" <= cdType And cdType <= "ZZ") _
					Or   ("0A" <=  cdType And cdType <= "0Z") Or   ("1A" <=  cdType And cdType <= "1Z") _
					Or   ("2A" <=  cdType And cdType <= "2Z") Or   ("3A" <=  cdType And cdType <= "3Z") _
					Or   ("4A" <=  cdType And cdType <= "4Z") Or   ("5A" <=  cdType And cdType <= "5Z") _
					Or   ("6A" <=  cdType And cdType <= "6Z") Or   ("7A" <=  cdType And cdType <= "7Z") _
					Or   ("8A" <=  cdType And cdType <= "8Z") Or   ("9A" <=  cdType And cdType <= "9Z")  Then
			name = SCREEN.GetName(130, ed_fcod.Data, 0)

			ed_fcod.Trigger "ed_fcod", True
			SYSTEM.SetHistory "ed_fcod", ed_fcod.Data
		Else
			name = SCREEN.GetName(130, ed_fcod.Data, 0)
		End If
	Else
		name = ""
	End If
Else
	name = ""
End If

HNAM.Data = name
g_hnam.Data = HNAM.Data

Call send_f()
