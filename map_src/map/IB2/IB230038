'==계좌번호, 비밀번호 체크
Function l_CheckInput_Local(ed_accn, ed_pswd)
 	l_CheckInput_Local = False
	If Trim(ed_accn.data) = "" Or Len(Trim(ed_accn.data)) <> 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
 		ed_accn.Setfocus
 		Exit Function
	End If

	If Len(Trim(ed_pswd.data)) = 0 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
 		ed_pswd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(ed_pswd.data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
	 		ed_pswd.Setfocus
	 		Exit Function
		End If
	End If
	l_CheckInput_Local = True
End Function

