_AW_ONDECLARE_AW_
Sub MKTriggerFromMain(sdata)
	cxMarket.sMarket = sdata
	SCREEN.Send 2
End Sub

_AW_ONINDECLARE_AW_
#load IB999901

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
cxMarket.sMarket = LoadMKGubn
cxMarket.MNum = "IB100000"
SCREEN.Send 2

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If radTime.Checked = True Then
	gbdt.Data = 0
	SCREEN.Object("OBJ1.gbdt").data = 0
	GRID0.SetColumnVisible 1, True
	GRID0.SetColumnVisible 2, False
Else
	gbdt.Data = 1
	SCREEN.Object("OBJ1.gbdt").data = 1
	GRID0.SetColumnVisible 1, False
	GRID0.SetColumnVisible 2, True
End If

If cxMarket.sMarket = "KRX" Then
	mkcd.Data = "1"
ElseIf cxMarket.sMarket = "NXT" Then
	mkcd.Data = "2"
ElseIf cxMarket.sMarket = "통합" Then
	mkcd.Data = "3"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, var

For ii=1 To GRID0.Rows
	var = Trim(GRID0.GetGridCell(ii, 1))
	GRID0.SetGridCell ii, 1, var
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(radTime)
_AW_ONCLICK_AW_
SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(radDate)
