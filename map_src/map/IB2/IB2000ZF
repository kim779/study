	Case "2"
		SCREEN.SetTimer 300, False
	Case "3"
		SCREEN.SetTimer 600, False
	Case "4"
		SCREEN.SetTimer 1800, False
	Case "5"
		SCREEN.SetTimer 3000, False
	Case "6"
		SCREEN.SetTimer 6000, False
End Select

If Trim(c_rate.Data) <> "" Then
	rate.Data = Trim(c_rate.Data)
Else
	rate.Data = "999"
End If

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
Else

End If

