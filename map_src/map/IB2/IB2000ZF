_AW_ONDECLARE_AW_
Option Explicit

Dim xstr, xvalue, xistrue
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)

Sub p_write_ini()
	If SCREEN.CreateObject("info") Then
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_jgub", jgub.data
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_uchk", uchk.data
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_gchk", gchk.data
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_rate", c_rate.data
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_gvol", gvol.data
		INFO.PushData LOGIN.Name, myFILE, myMAP, "c_com1", com1.data
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
		jgub.data   = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_jgub"))
		uchk.data   = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_uchk"))
		gchk.data   = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_gchk"))
		c_rate.data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_rate"))
		gvol.data   = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_gvol"))
	 	com1.data   = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_com1"))

		'첫 조회시(userconf.ini 파일에 내용이 없을 때)
		If Trim(jgub.Data) = "" Then
			jgub.Index = 0
		End If

		If Trim(uchk.Data) = "" Then
			uchk.Data = 0
		End If

		If Trim(gchk.Data) = "" Then
			gchk.Data = 0
		End If

		If Trim(com1.Data) = "" Then
			jgub.Index = 0
		End If

		If uchk.Data = "1" Then
			u_chk.Checked = True
		Else
			u_chk.Checked = False
		End If

		If gchk.Data = "1" Then
			g_chk.Checked = True
		Else
			g_chk.Checked = False
		End If
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
coln.data = "0"
sort.Data = "0"

Call p_read_ini()
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Select Case com1.Data
	Case "1"
