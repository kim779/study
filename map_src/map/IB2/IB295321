_AW_ONSTART_AW_
Dim cha, bicha, Tot, KP200, vo, bs

If SCREEN.CreateObject("info") Then
	cha = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295321", "IB295321_chaik"))
	bicha = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295321", "IB295321_bichaik"))
	tot = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295321", "IB295321_total"))
	KP200 = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295321", "IB295321_kp"))
	vo = Trim(INFO.popdata(LOGIN.name, "userconf.ini", "IB295321", "IB295321_vol"))

	chaik.Data = cha
	bichaik.Data = bicha
	total.Data = Tot
	KP.Data = KP200
	vol.Data = vo

End If

If chaik.Data = "1" Then
	CHECK0.checked = True
Else
	CHECK0.checked = False
End If

If bichaik.Data = "1" Then
	CHECK1.checked = True
Else
	CHECK1.checked = False
End If

If total.Data = "1" Then
	CHECK2.checked = True
Else
	CHECK2.checked = False
End If

If KP.Data = "1" Then
	CHECK3.checked = True
Else
	CHECK3.checked = False
End If

If vol.Data = "1" Then
	CHECK4.checked = True
Else
	CHECK4.checked = False
End If

obj.Send

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Select Case SCREEN.Object("MAIN.trgb").Data
Case "1"
      COMB.Data = "1"
Case "2"
      COMB.Data = "2"
End Select

vggb.Data = SCREEN.Object("main.vggb").data
cycle.Data = SCREEN.Object("main.cycle").data
sdt.Data = SCREEN.Object("main.sdt").data
edt.Data = SCREEN.Object("main.edt").data


If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If


If CHECK4.Checked = True Then
	obj.SetObject "IB295323"
	obj.send
Else
	obj.SetObject "IB295322"
	obj.send
End If

obj.Send

