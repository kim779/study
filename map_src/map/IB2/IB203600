	code = S210500.GetGridCell(S210500.row, 3)
	SYSTEM.Trace S210500.GetGridCell(S210500.row, 3)
	If Trim(code) <> "" Then
		If Left(code,1) = "A" Then code = Mid(code,2,11)
		S1301.Data = code
		S1301.Trigger "", True
	End If
End If
