RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub SendTR(data)
	SCREEN.Object("main.1301").data = data
	SCREEN.Send 2
End Sub

Sub saveDepthInfo()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "SepType", S17412.sDepthInfo
	End If
SYSTEM.Trace "saveDepthInfo SepType = " & S17412.sDepthInfo
End Sub

Sub LoadDepthInfo()
SYSTEM.Trace "LoadDepthInfo myMAP(parent) = " & SCREEN.GetMapName(1)  & " self = " & SCREEN.GetMapName(0)
	If SCREEN.CreateObject("Info") Then
		S17412.sDepthInfo =	Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "SepType"))
	End If
End Sub

_AW_ONSTART_AW_
LoadDepthInfo()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.1301").Data
If Len(Trim(S1301.Data)) <> 6 Then
	SCREEN.OnSend False
End If

If UCase(TypeName( SCREEN.Object("main.cxMarket") )) <> "NOTHING" Then
SYSTEM.Trace "[IB1001E0][onSend] Change_MKGubn = " & SCREEN.Object("main.cxMarket").sMarket
	If Trim(SCREEN.Object("main.cxMarket").sMarket) = "통합" Then
		S1777.Data = "3"
		S17412.SetMKtype(3)
	ElseIf Trim(SCREEN.Object("main.cxMarket").sMarket) = "KRX" Then
		S1777.Data = "1"
		S17412.SetMKtype(1)
	ElseIf Trim(SCREEN.Object("main.cxMarket").sMarket) = "NXT" Then
		S1777.Data = "2"
		S17412.SetMKtype(2)
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(17412)
_AW_ONCHANGE_AW_
saveDepthInfo
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



