RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_TR()
	Dim cnt, who
	cnt = 0
	If CK_KO.Checked = True Then
		who = 0
		cnt = cnt + 1
	End If
	If CK_KQ.Checked = True Then
		who = 1
		cnt = cnt + 1
	End If
	If CK_F.Checked = True Then
		who = 2
		cnt = cnt + 1
	End If
	If cnt = 0 Or cnt = 1 Then
		Select Case who
		Case 0 :
			CK_KO.Checked = True
			CK_KO.Enable = False
		Case 1 :
			CK_KQ.Checked = True
			CK_KQ.Enable = False
		Case 2 :
			CK_F.Checked = True
			CK_F.Enable = False
		End Select
	Else
		CK_KO.Enable = True
		CK_KQ.Enable = True
		CK_F.Enable = True
	End If
End Sub

Sub func_CHK()
	If CK_KO.Checked = False And CK_KQ.Checked = False And CK_F.Checked = True Then
		OBJ_chart.SetObject "IB20005G"
		OBJ_chart.Send
		Exit Sub
	End If

	If CK_F.Checked = True Then
		OBJ_chart.SetObject "IB20005G"
	Else
		OBJ_chart.SetObject "IB20005G"
	End If
End Sub

_AW_ONSTART_AW_
Dim kospi, kosdaq, future

If SCREEN.CreateObject("Info") Then
	kospi = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200051_CHK1"))
	kosdaq = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200051_CHK2"))
	future = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200051_CHK3"))
End If

Select Case kospi
	Case "1" CK_KO.Checked = True
	Case "0" CK_KO.Checked = False
End Select

Select Case kosdaq
	Case "1" CK_KQ.Checked = True
	Case "0" CK_KQ.Checked = False
End Select

Select Case future
	Case "1" CK_F.Checked = True
	Case "0" CK_F.Checked = False
End Select

send_TR()
func_CHK()

SCREEN.SetTimer 5, True

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
OBJ_chart.Send

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
OBJ_chart.Send
'SYSTEM.Trace "object send"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(CK_KO)
_AW_ONCLICK_AW_
Call send_TR()

Call func_CHK()

SCREEN.CreateObject("Info")
If CK_KO.Checked = True Then
	INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200051_CHK1", "1"
Else
	INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200051_CHK1", "0"
End If

OBJ_chart.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CK_KQ)
_AW_ONCLICK_AW_
Call send_TR()

Call func_CHK()

SCREEN.CreateObject("Info")
If CK_KQ.Checked = True Then
	INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200051_CHK2", "1"
Else
	INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200051_CHK2", "0"
End If

OBJ_chart.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


