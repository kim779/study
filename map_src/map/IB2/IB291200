Option Explicit

Const R_TCNT = 2
Const R_UNIT = 10
Const BCOLOR = 57
Const FCOLOR = 63
Dim strExpr
Dim ii

'Radio Button 처리
Sub ControlRBtn(iNum)
	For ii=0 To R_TCNT - 1
		strExpr = "BUTTON" & R_UNIT*(ii+1) & ".TRgb="
		If ii = CLng(iNum-1) Then
			If CLng(lblRBtnNo.Text) = 0  Or CLng(lblRBtnNo.Text) <> CLng(iNum) Then
				lblRBtnNo.Text = iNum
				strExpr = strExpr & BCOLOR
			Else
				lblRBtnNo.Text = 0
				strExpr = strExpr & FCOLOR
			End If
		Else
			strExpr = strExpr & FCOLOR
		End If
		execute strExpr
	Next
End Sub

