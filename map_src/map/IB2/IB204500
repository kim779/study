RESOURCE DIVISION
{


_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Dim	cod
Dim r_upgb

c_upgb.Data = "0"
upcd.data = "899"
gsmm.Data = "12"
upcd.Enable = False
UBUT.Enable = False

SCREEN.SetTimer 0, True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If S200307.Data >= 1 Then
	S201300.SetFocus
	S201300.INDEX = 0
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(company)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To S201300.Rows
	str = str & Right(Trim(S201300.GetGridCell(i, 1)), 6)
	str = str & vbTab
	str = str & Trim(S201300.GetGridCell(i, 3))
	str = str & vbLf
Next

If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, S201300.Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(201300)
_AW_ONDBLCLK_AW_
S1301.Data = ""

Select Case S201300.HitPos
Case 3	'DATA부 click
	If Len(Trim(S201300.GetGridCell(S201300.Index +1, 1))) = 7 Then
		S1301.DATA = Right(Trim(S201300.GetGridCell(S201300.Index +1, 1)),6)
		If Trim(S1301.DATA) = "" Then
		    Exit Sub
		End If

		S1301.Trigger "", False
		S1301.Trigger "", True
	   SYSTEM.SetHistory "1301", S1301.DATA

	End If
Case Else
	SCREEN.OnSend = False
	Exit Sub
End Select

If Len(Trim(S1301.data)) >= 6 Then
SCREEN.CreateWindow 1, "IB200100 /t /s /p5 /d", _
	"1301" & vbTab & S1301.Data
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(UBUT)
_AW_ONCLICK_AW_
Dim retn

Select Case c_upgb.Data
	Case "1", "101", "401"		'KOSPI, KOSPI200, KOSPI100
		retn = SCREEN.GetCode(104, "upcd", "200022", 0)
	Case "2", "301"							'KOSDAQ
		retn = SCREEN.GetCode(104, "upcd", "200022", 9)
	Case "801"
		retn = SCREEN.GetCode(104, "upcd", "200022", 801)
End Select


If (retn <> True) Then
	upcd.SetFocus
	Exit Sub
Else
	upcd.SetFocus
	SCREEN.Send 2
End If

If c_upgb.Data = "899" Then
	upcd.Enable = False
	UBUT.Enable = False
Else
	upcd.Enable = True
	UBUT.Enable = True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(upcd)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_upgb)
_AW_ONCHANGE_AW_

If c_upgb.Data = "0" Then
	upcd.Data = "899"
	S200022.Data = ""
	upcd.Enable = False
	UBUT.Enable = False
ElseIf c_upgb.Data = "1" Then
	upcd.Enable = True
	upcd.Data = "001"
	S200022.Data = "KOSPI(종합)"
	UBUT.Enable = True
ElseIf c_upgb.Data = "2" Then
	upcd.Enable = True
	upcd.Data = "201"
	S200022.Data = "KOSDAQ(종합)"
	UBUT.Enable = True
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(gsmm)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



