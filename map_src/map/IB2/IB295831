If end_key = "999999" Then
	SYSTEM.Trace "end_key"
	SCREEN.Object("main.BUTTON4").Enable = False
Else
	SCREEN.Object("main.BUTTON4").Enable = True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



