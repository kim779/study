_AW_ONDECLARE_AW_
Sub change_chart(key)
	'	drChart.DelAllBozoMsg()'
	'	drChart.AddBozoMsg 1, "UD", key


	Dim inputData
	Dim tnkey

	Dim    cod2 	'[15];            종목코드
	Dim    codx
	Dim    sDate 	'[8];             검색시작일
	Dim    nrec		'[4];             조회건수
	Dim    unit		'[3];             조회단위 1분봉, 3분봉
	Dim    gubn		'[1];             조회구분
					'				  0 : 틱, 1 : 분, 2 : 일
					'				  3 : 주, 4 : 월
	Dim    egbn		'[1];             수정주가 구분
	Dim    smod		'[1];             조회모드
	Dim    nkey		'[23];      	Next Key
	Dim    bgbn		'[1];             허봉, 실봉구분
					'				  0: 허봉 1: 실봉
	Dim    dgbn		'[1];             당일 구분
	Dim    temp
	CStr   str
	Select Case key
			Case 1 gubn = "0"
			Case 2 gubn = "2"
			Case 3 gubn = "0"
	End Select

	codx = S1301.Data

	' 코드 연동용 시장 접두 제거
	codx = Replace(codx, "M.", "")
	codx = Replace(codx, "N.", "")

	code_type = SCREEN.GetCodeType( Trim(codx) )
	If code_type = 0 Then
		code_type = SCREEN.GetName( 199, Trim(codx), 0)
	End If 

	prefix = ""
	suffix = "         "

	If code_type = "" Then
		Exit Sub
	End If

	Select Case code_type
	Case 27	' ETN - ETN종목은 접두가 Q로 시작

		' 시장선택 구분자가 존재하면 시장에 따라 prefix 선택
		If UCase(TypeName( SCREEN.Object("main.cxMarket") )) <> "NOTHING" Then

SYSTEM.Trace "ETN sMarket : " & SCREEN.Object("main.cxMarket").sMarket

			Select Case Trim(SCREEN.Object("main.cxMarket").sMarket)
			Case "KRX"
				prefix = "Q"
				suffix = "        "

			Case "NXT"
				prefix = "N.Q"
				suffix = "      "

			Case "통합"
				prefix = "M.Q"
				suffix = "      "
			End Select
		End If

	Case 9	' ELW - ELW 종목은 접두가 J로 시작
		prefix = "J"	' ELW는 대체 거래소 없음

	Case Else	' 다른 일반종목은 접두가 A로 시작
SYSTEM.Trace "NORMAL sMarket : " & SCREEN.Object("main.cxMarket").sMarket

		If UCase(TypeName( SCREEN.Object("main.cxMarket") )) <> "NOTHING" Then
			Select Case Trim(SCREEN.Object("main.cxMarket").sMarket)
			Case "KRX"
				prefix = "A"
				'suffix = "        "
				suffix = "     "

			Case "NXT"
				prefix = "N.A"
				'suffix = "      "
				suffix = "   "

			Case "통합"
				prefix = "M.A"
				'suffix = "      "
				suffix = "   "'

			End Select
		End If

	End Select

	g_gubn = key

	cod2 = prefix + Trim(codx) + suffix

	sDate = "        "
	temp = 120
	nrec=Trim(temp)

	If(Len(nrec)=3) Then
	    str = " "
		nrec = str & nrec
	End If
	If(Len(nrec)=2) Then
	    str = "  "
		nrec = str & nrec
	End If
	If(Len(nrec)=1) Then
	    str = "   "
		nrec = str & nrec
	End If

	If(Len(nrec)=0) Then
		nrec = " 120"
		request_count.Data = 120
	End If

	unit = g_gunit
	egbn = "1"
	smod = "1"
	tnkey = LTrim(drChart.GetNextKey())

	If tnkey = "" Then
		nkey = "                       "
	Else
		If key = "3" Then
			nkey = tnkey & "                 "
		Else
			nkey = "                       "
		End If
	End If

	bgbn = "1"
	dgbn = "0"

	SYSTEM.Trace "change_chart unit : " & unit & " g_unit : " & g_gunit
	'drChart.SetSubMsg "UM", "E"
	inputData = cod2 & sDate & nrec & gubn & nkey & smod & bgbn

	Dim szTR
	szTR = "ping2958"
	drChart.SendTr szTR, cod2, inputData,1
'SYSTEM.Trace "ping2958  inputData cod2 = " & cod2 & " len = " & Len(cod2)
'SYSTEM.Trace "ping2958  sDate = " & sDate & " len = " & Len(sDate)
'SYSTEM.Trace "ping2958  nrec = " & nrec & " len = " & Len(nrec)
'SYSTEM.Trace "ping2958  gubn = " & gubn & " len = " & Len(gubn)
'SYSTEM.Trace "ping2958  nkey = " & nkey & " len = " & Len(nkey)
'SYSTEM.Trace "ping2958  smod = " & smod & " len = " & Len(smod)
'SYSTEM.Trace "ping2958  bgbn = " & bgbn & " len = " & Len(bgbn)

	next_time.Data = ""

End Sub

Sub Set_stime()
	Dim stime, t_string, tstring
	stime= drChart.GetChartProperty("GetData(자료일자, 0)")

	t_string = Split(stime, "/", -1, 1)
	tstring = Split(t_string(1), ":", -1, 1)

	next_time.Data = tstring(0) & tstring(1) & tstring(2) & "  "

	change_chart(1)

End Sub

Sub Onalert()
	SYSTEM.Trace "[map] onalert"

End Sub

_AW_ONSTART_AW_
Dim szPropName

szPropName = "bShowPriceMinMaxText(0)"
drChart.GetChartProperty( szPropName )

S1301.Data = SCREEN.Object("main.1301").Data

change_chart(1)

