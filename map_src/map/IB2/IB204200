	Set_reason()
'
	For jj = 1 To GRID.Rows
		ii = Trim(GRID.GetGridCell(jj, 6))		'거래정지사유 코드

		If ii = "" Then
			ii = 0
		ElseIf IsNumeric(ii) = False Then
		    ii = 0
		ElseIf  ii > 80 Then
			ii = 0
		Else

		End If
		Set_reason()
		reason = stop_reason(ii)
		GRID.SetGridCell jj, 7, reason
	Next

End Sub

