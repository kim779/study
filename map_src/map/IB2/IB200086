RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "WithFee"

'== 계좌명, 비밀번호 설정
Sub Set_account()
'	SCREEN.ClearAll 0, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Error_check() = False Then
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.Object("obj.Ledger").FKey = "C"

	If Trim(zOrdDt.Data) = Trim(tday.Data) Then
		obj.SetObject("IB200089")
	Else
		obj.SetObject("IB20008E")
	End If

	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	SCREEN.Object("obj.Ledger").FKey = "7"
	SCREEN.Object("obj.GRID0").SetDataPosition(2)
	obj.Send
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Error_check = False
	If Trim(AN1A.Data) = "" Then
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus
		Call guide_msg("계좌번호를 확인하십시오")
		Exit Function
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Call guide_msg("비밀번호를 확인하십시오")
			Exit Function
		End If
	End If
	Error_check = True
End Function

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'매매비용 포함여부
Dim stock_fee
If SCREEN.CreateObject("Info") Then
	stock_fee = INFO.PopData(LOGIN.Name, myFILE, myMAP, "Stock")
	If Trim(stock_fee) = "" Then
		stock_fee = False
	End If
	CHECK0.Checked = stock_fee
End If

'If SCREEN.CreateObject("Info") Then
'	combo = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "100136_COM1"))
'	zQryTp.Data = combo
'End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim ret, msg
obj.ClearAll 2
SCREEN.Proc "main.set_guide", " "
SCREEN.OnSend = False
AN1A.Data = SCREEN.Object("main.OBJ_order.AN1A").Data
Call Password_initSetting(zPwd)

If Error_check() = False Then				'보내기전 에러체크
	SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
	Exit Sub
End If

SCREEN.Object("obj.account").data = AN1A.Data
SCREEN.Object("obj.zInputPwd").data = zPwd.Data
SCREEN.Object("obj.zQryTp").data = zQryTp.Data
SCREEN.Object("obj.zCmsnAmtAppTp").data = zCmsnAmtAppTp.Data


'SYSTEM.Trace "zQryTp.Data : " & SCREEN.Object("obj.zCmsnAmtAppTp").data

b_chk.Data = "0"
next_btn.Enable = False
obj.Send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	Call send_f()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zQryTp)
_AW_ONCHANGE_AW_
SCREEN.Send 0

SCREEN.CreateObject("Info")
INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "100136_COM1", zQryTp.data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHECK0)
_AW_ONCLICK_AW_
If CHECK0.Checked = False Then
	zCmsnAmtAppTp.Data = 0
Else
    zCmsnAmtAppTp.Data = 1
End If
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "Stock", CHECK0.Checked
End If

SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
'버튼클릭자료수집
Call btnClickCnt(send_btn)

send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
'버튼클릭자료수집
Call btnClickCnt(next_btn)

send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB130131 /t/s/p5/", ""
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(zOrdDt)
_AW_ONCHANGE_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(COMBO0)
_AW_ONCHANGE_AW_
If COMBO0.Data = 0 Then
	zOrdDt.Visible = False
	obj.SetObject("IB200089")
ElseIf COMBO0.Data = 1 Then
	zOrdDt.Visible = True
	obj.SetObject("IB20008E")
End If

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tday)
_AW_ENDSCRIPT_AW_


