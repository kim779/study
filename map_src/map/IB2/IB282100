Sub send_sise_all(xval)
SCREEN.IgnoreChange True
	If xval <> "jumun" And xval <> "account" Then
  		S1301.Trigger "", False
 	End If
	S1301.Trigger "", True

	Select Case SCREEN.GetCodeType(Trim(S1301.Data))
		Case 27	' ETF/ETN
			ETN_DESC.Enable = True
			ETN_DESC.Visible = True
		Case Else
			ETN_DESC.Enable = False
			ETN_DESC.Visible = False
	End Select


	If xval <> "jumun" Then
		Call Ord_ChangeCode(S1301.Data)
	End If

	SendFlag = 1
	cxMarket.sCode = Trim(S1301.Data)

	SCREEN.Send 0
	obj_sise.Send
	obj_obj_sise.Send
	SCREEN.Object("OBJECT0.1301").Data = Trim(S1301.Data)
	OBJECT0.Send

SCREEN.IgnoreChange False
End Sub

