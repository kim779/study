Sub ChangeCode()
	r_upgb = P_GetBigCd(S20301.Data)
	If S20301.Data = 889 Then
		r_upgb = 889
	End If

	Select Case r_upgb
		Case "001"		'KOSPI
			c_upgb.Data = r_upgb
		Case "101"		'KOSPI200
			c_upgb.Data = r_upgb
		Case "201"		'KOSDAQ
