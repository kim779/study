	End Select

	SYSTEM.SetHistory "20301", S20301.Data

    S200901.Data = S20301.Data
End Sub

Sub company()
	Dim i, str
	str = ""
	For i = 1 To S210500.Rows
		str = str & Right(Trim(S210500.GetGridCell(i, 3)), 6)
		str = str & vbTab
		str = str & Trim(S210500.GetGridCell(i, 4))
		str = str & vbLf
	Next

	If Len(Trim(str)) > 0 Then
		SYSTEM.SetAutoCode str, S210500.Rows
	End If
End Sub

