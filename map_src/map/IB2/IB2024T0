Sub p_read_ini()
If SCREEN.CreateObject("Info") Then
 	CHK.TEXT = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "G_CHCK"))
	If CHK.TEXT = "그래프" Then
		OBJ.SetObject "IB202420"
		TEXT.Visible = True
		CHART.Visible = False
		KFGB.Visible = True
		CHK.TEXT = CHART.TEXT
	ElseIf CHK.TEXT = "텍스트" Then
		OBJ.SetObject "IB202410"
		TEXT.Visible = False
		CHART.Visible = True
		KFGB.Visible = False
		CHK.TEXT = TEXT.TEXT
	Else
		OBJ.SetObject "IB202420"
		TEXT.Visible = True
		CHART.Visible = False
		KFGB.Visible = True
		CHK.TEXT = CHART.TEXT
	End If
	SCREEN.Object("obj.gubn").data = GUBN.Data
	OBJ.Send
End If
End Sub


Sub p_write_ini()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "G_CHCK", CHK.TEXT
End If
End Sub

Sub SetFirstData()
	AYear = Year(DateAdd("m", -1, Date))
	AMon = Month(DateAdd("m", -1, Date))
	If Len(AMon) = 1 Then
		AMon = "0" & AMon
	End If
	ADay = Day(DateAdd("m", -1, Date))
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If

	S12901_D.Data = AYear & AMon & ADay
End Sub


Sub chgDataTp2()
	If Trim(cb_DataTp2.Data) = "1" Then
		If TEXT.Visible = False Then
			S12901_D.Enable = False
		Else
			S12901_D.Enable = True
		End If
	Else
		S12901_D.Enable = True
	End If
End Sub

Sub MKTriggerFromMain(sdata)
	cxMarket.sMarket = sdata
	SCREEN.Send 0
End Sub

