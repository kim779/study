	Case 5
		S310.SetHead 7, "Reit"
	Case 6
		S310.SetHead 7, "ETF"
	Case Else
		S310.SetHead 7, "지 수"
End Select

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S1301.Data = SCREEN.Object("main.1301").Data
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S1301.Data = "N." & SCREEN.Object("main.1301").Data
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S1301.Data = "M." & SCREEN.Object("main.1301").Data
	End If
End If

