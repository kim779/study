_AW_ONCLICK_AW_

Dim i, str
str = ""
For i = 1 To S210300.Rows
	str = str & Right(Trim(S210300.GetGridCell(i, 1)), 6)
	str = str & vbTab
	str = str & Trim(S210300.GetGridCell(i, 4))
	str = str & vbLf
Next

If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, S210300.Rows
End If
