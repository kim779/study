RESOURCE DIVISION
{


_AW_SCRIPT_AW_(drChart)
_AW_ONCHANGE_AW_
'drChart.GetChartState() 리턴값
'STATE_NONE					0
'STATE_STARTRECEIVE			1 	TR받은 직후
'STATE_ENDRECEIVE			2 	조회결과를 차트컨트롤에 그린 후
'STATE_CHANGEONPAGECNT		3	데이터 조회 스크롤 시
'STATE_SENDTR				4	TR 전송시
'STATE_DESTROYCHART			5	차트화면 내려갈때

Dim TotCnt
Dim DataCnt
Dim ret
ret = drChart.GetChartState()
TotCnt = drChart.GetChartProperty("GetDataCount")
DataCnt = drChart.GetChartProperty( "GetOnePageDataCount" )

SYSTEM.Trace "ret[" & ret & "] TotCnt[" & TotCnt & "] DataCnt[" & DataCnt & "]"

If ret = 2 Then
	SCREEN.IgnoreChange False
	'request_count.Data = TotCnt
	SCREEN.IgnoreChange True
End If

If ret =  3 Then
	SCREEN.IgnoreChange False
	data_count.Data = DataCnt
	SCREEN.IgnoreChange True
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



