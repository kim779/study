	End If

	Select Case r_upgb
		Case "001"		'KOSPI
			c_upgb.Data = r_upgb
		Case "101"		'KOSPI200
			c_upgb.Data = r_upgb
		Case "201"		'KOSDAQ
			c_upgb.Data = r_upgb
		Case "301"		'KOSDAQ50
			If S20301.Data = "303" Then
				c_upgb.Data = "201"
			ElseIf S20301.Data = "305" Then
				c_upgb.Data = "201"
			Else
				c_upgb.Data = r_upgb
			End If
		Case "401"		'KOSPI100
			c_upgb.Data = r_upgb
		Case "501"		'KONEX
			c_upgb.Data = r_upgb
		Case "888"		'ELW
			c_upgb.Data = r_upgb
		Case "303"		'KOSTA
			c_upgb.Data = r_upgb
		Case "999"		'KRX100
			c_upgb.Data = r_upgb
		Case "601"		'SECTOR
			c_upgb.Data = r_upgb
		Case "701"		'SECTOR
			c_upgb.Data = r_upgb
		Case "801"		'기타
			c_upgb.Data = r_upgb
		Case "889"		'전체(ELW제외)
			c_upgb.Data = r_upgb
		Case Else
		   S20301.Data = "001"
		   c_upgb.Data = "001"
	End Select

	SYSTEM.SetHistory "20301", S20301.Data

	S200901.Data = S20301.Data
End Sub

