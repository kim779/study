_AW_ONDECLARE_AW_
Option Explicit

Sub sendProc()
	If SCREEN.GetCodeType(S1301.Data) <> 9 Then
		E1301.Clear
		S1301.Clear
	Else
		E1301.Data = Trim(S1301.Data)
		S1301.Trigger "1301", True
	End If

	SCREEN.Send 0
End Sub

