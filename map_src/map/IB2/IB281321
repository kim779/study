#load "IB888888"

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim gicho
gicho = Trim(S1843.Data)

If gicho = "" Or Trim(S1301.Data) = "" Then
	SCREEN.Object("main.obj.obj1").Send
	Exit Sub
End If

If gicho = "KOSPI200" Then			'기초자산이 K200
	SCREEN.Object("parent.obj1").SetObject("IB281323")
	SCREEN.Object("parent.obj1.20301").data = "101"
ElseIf gicho = "KOSDAQ150" Then			'기초자산이 K200
	SCREEN.Object("parent.obj1").SetObject("IB281323")
	SCREEN.Object("parent.obj1.20301").data = "305"
Else								'기초자산 현물종목
	gicho = Mid(gicho, 4, 6)
	SCREEN.Object("parent.obj1").SetObject("IB281322")
	SCREEN.IgnoreChange True
	SCREEN.Object("parent.obj1.1301").data = gicho
	SCREEN.Object("parent.obj1.E1301").data = S1301.Data
	SCREEN.IgnoreChange False
End If

SCREEN.Object("parent.obj1").Send


