Const MYFILE = "userconf.ini"
Dim curPage

Sub send_f()
	SCREEN.ClearAll 0, 2
	pageInptNum.Data = 1
	savePrePage.Text = "0"
	SCREEN.Send 0
End Sub

Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim chkYn, chTRGB, chTYPEE, chSORT, chRadio

		If chkAutoSend.Checked = True Then
			rtsGubn.Data = "1"
			chkYn = "Check"
		Else
			rtsGubn.Data = "0"
			chkYn = "None"
		End If

		chTRGB = TRGB.data
		chTYPEE = TYPEE.data
		chSORT = SORT.data

		If RADIO0.Checked Then
			chRadio = "0"
		Else
			chRadio = "1"
		End If

		INFO.PushData LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "rtsChk", chkYn
		INFO.PushData LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "TRGB", chTRGB
		INFO.PushData LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "TYPEE", chTYPEE
		INFO.PushData LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "SORT", chSORT
		INFO.PushData LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "RADIO", chRadio
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim chkYn, chTRGB, chTYPEE, chSORT, chRadio

		chkYn = Trim(INFO.PopData(LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "rtsChk"))
		chTRGB = Trim(INFO.PopData(LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "TRGB"))
		chTYPEE = Trim(INFO.PopData(LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "TYPEE"))
		chSORT = Trim(INFO.PopData(LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "SORT"))
		chRadio = Trim(INFO.PopData(LOGIN.Name, MYFILE, SCREEN.GetMapName(0), "RADIO"))

		If chkYn = "" Then
			chkYn = "None"
		End If

		If chkYn = "Check" Then
			chkAutoSend.Checked = True
			rtsGubn.Data = "1"
		Else
			chkAutoSend.Checked = False
			rtsGubn.Data = "0"
		End If

		TRGB.Data = chTRGB
		TYPEE.Data = chTYPEE
		SORT.Data = chSORT

		If chRadio ="" Then
			chRadio = "0"
		End If

		If chRadio = "0" Then
			RADIO0.Checked = True
		Else
			RADIO1.Checked = True
		End If

	End If
End Sub

