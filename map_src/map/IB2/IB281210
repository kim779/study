RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim ctl
Dim g_BefTime

g_BefTime = ""
'-----------------------------------------------------------------------
Function GetTimeElement(Element)
	GetTimeElement = Element
	If Len(Element) = 1 Then
		GetTimeElement = "0" & Element
	End If
End Function
'-----------------------------------------------------------------------
Function GetTime(ATime)
	If Len(ATime) = 0 Then
		Exit Function
	End If
	Dim DL, AHour, AMin, ASec
	If Mid(ATime, 1, 1) = "장" Then
		AHour = GetTimeElement(Hour(Time))
		AMin = GetTimeElement(Minute(Time))
		ASec = GetTimeElement(Second(Time))

		ATime = AHour & ":" & AMin & ":" & ASec
	End If
	GetTime = ""	
	DL = Split(ATime, ":")
	AHour = GetTimeElement(Trim(DL(0)))
	AMin = GetTimeElement(Trim(DL(1)))
	ASec = GetTimeElement(Trim(DL(2)))
	
	GetTime = AHour & AMin & ASec
End Function
'-----------------------------------------------------------------------
'ELW 종목 기초자산코드 GET
Function get_gicho_code()
	get_gicho_code = ""
	If Trim(E1301.Data) = "" Then
			MsgBox "종목코드를 입력하세요"
			E1301.SetFocus
			Exit Function
	End If
	get_gicho_code = Trim(elw_ctrl.GetGcjs(E1301.Data))
End Function
'-----------------------------------------------------------------------
Sub OnAlert()
	If S16310.Rows <= 0 Then
		Exit Sub
	End If
	
	Dim i, Data, ATime, DL, Index
	
	DL = Array("", "", "", "", "", "", "", "", "", "")
	Index = 0
	If Len(g_BefTime) = 0 Then
		Index = S16310.Rows
	Else
		For i = 1 To S16310.Rows
			ATime = Trim(S16310.GetGridCell(i, 1))
			If g_BefTime = ATime Then
				Index = i - 1
				Exit For
			End If
		Next
	End If

	For i = 1 To Index
		ATime = Trim(S16310.GetGridCell(Index - i + 1, 1))
		DL(0) = ATime

		DL(1) = Trim(S16310.GetGridCell(Index - i + 1, 2))
		DL(2) = Trim(S16310.GetGridCell(Index - i + 1, 3))
		DL(3) = Trim(S16310.GetGridCell(Index - i + 1, 4))
		DL(4) = Trim(S16310.GetGridCell(Index - i + 1, 5))
		DL(5) = Trim(S16310.GetGridCell(Index - i + 1, 6))
		DL(6) = Trim(S16310.GetGridCell(Index - i + 1, 7))
		DL(7) = Trim(S16310.GetGridCell(Index - i + 1, 8))
		DL(8) = Trim(S16310.GetGridCell(Index - i + 1, 9))
		DL(9) = Trim(S16310.GetGridCell(Index - i + 1, 10))

		Data = Join(DL, "|")
		SCREEN.Proc "main.SetData", Data
	Next

	ATime = Trim(S16310.GetGridCell(1, 1))
	g_BefTime = ATime
End Sub

