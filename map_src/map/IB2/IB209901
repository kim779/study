_AW_ONDECLARE_AW_

Sub closemap()
	SCREEN.CloseWindow
End Sub

Function FullCode(code)
	tp = SCREEN.GetCodeType(code)
	If tp=9 Then
		code = "J"&code
	ElseIf tp=27 Then
		code = "Q"&code
	Else
		code = "A"&code
	End If
	FullCode = code
End Function

Sub Send_f()
	Dim data, code, tp
	code = FullCode(Trim(S1301.Data))
	ctrl_log.Memo_Search(code)
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
If Len(Trim(EDIT0.Data)) > 6 Then
	S1301.Data = Mid(EDIT0.Data, 2)
Else
	S1301.Data = EDIT0.Data
End If
Call Send_f()

