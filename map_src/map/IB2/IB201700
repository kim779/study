RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim Isstart
Isstart = False
Sub send_f()
	If Isstart = False Then
		Exit Sub
	End If
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
	'SCREEN.Proc "obj.send_f", ""
End Sub

Sub Change_MKGubn_Main(sMKGubn)

	SYSTEM.Trace "[IB201700]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	Isstart = True
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Send 0
	Call send_f()
	Send_Obj()

End Sub

Sub Send_Obj()
	cxMarket.sCode = Trim(S1301.Data)
	SCREEN.Proc "obj.send_f", ""
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.MNum = SCREEN.GetMapName(1)
cxMarket.Major = SCREEN.Major

Isstart = True
cxMarket.sCode = Trim(S1301.Data)
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
    End If
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(jcod)
_AW_ONCHANGE_AW_
If Trim(jcod.Data) = "000000" Or Trim(jcod.Data) = "" Then
	SCREEN.ClearAll 0, 2
End If
S1301.Data = jcod.Data
SCREEN.Object("obj.cod2").Data = jcod.Data
jcod.SetFocus
Call send_f()
Send_Obj()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_

SCREEN.CreateWindow 1, "IB202201 /t/s/p5/d", "appendCODE" & _
			vbTab & S1301.Data & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctl_Category)
_AW_ONCLICK_AW_
Dim codx
codx = ctl_Category.GetPreCode(S1301.Data)
If Trim(codx) = "" Then
End If
S1301.Data = codx
S1301.Trigger "",True

Call send_f()
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim codx
codx = ctl_Category.GetNextCode(S1301.Data)

If Trim(codx) = "" Then
	Exit Sub
End If

S1301.Data = codx
S1301.Trigger "",True

Call send_f()
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
S1301.Data = ctl_Category.GetCurCode
S1301.Trigger "",True

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
Dim stim, etim

If S1301.Data = "000000" Or Trim(S1301.Data) = "" Then
	S1301.Clear
End If
jcod.Data = S1301.Data
'SCREEN.Object("obj.cod2").Data = S1301.Data

stim = (Hour(Now)-1)*10000 + (Minute(Now)*100)
etim = (Hour(Now)*10000) + (Minute(Now)*100)

If Len(Trim(SCREEN.Object("obj.stim").data)) = 0 Then
	SCREEN.Object("obj.stim").data = stim
End If

If Len(Trim(SCREEN.Object("obj.etim").data)) = 0 Then
	SCREEN.Object("obj.etim").data = etim
End If

Call send_f()
Send_Obj()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

If UCase(TypeName( SCREEN.Object("cbSOrder") )) <> "NOTHING" Then
	If cxMarket.sMarket = "통합" Then
		cbSOrder.Data = "S"
	ElseIf cxMarket.sMarket = "KRX" Then
		cbSOrder.Data = "1"
	ElseIf cxMarket.sMarket = "NXT" Then
		cbSOrder.Data = "N"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


