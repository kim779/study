_AW_ONCLICK_AW_
Dim value , hsga

codx = Trim(SCREEN.Object("main.E1301").data)

If codx = "" Then
	Exit Sub
End If

'If codx < 500000 Then
If SCREEN.GetCodeType(codx) <> 9 Then
	MsgBox "예상손익계산은 ELW 종목만 계산이 가능합니다.", 0, "알림"
	Exit Sub
End If

'콜/풋 세팅
xcall.Data = Trim(SCREEN.Object("MAIN.1852").Data)
'전환비율
jun.Data = Trim(SCREEN.Object("MAIN.1855").data)
'행사가
gsga.Data = Trim(SCREEN.Object("MAIN.1352").data)

hsga = CDbl(gsga.Data) * 100

'권행사가능 여부
If (Trim(xcall.Data) = "콜") Then
	If (CDbl(hsga) < CDbl(Ijisu.Data)) Then
		OisOK.Data = "권리행사 가능"
	Else
		OisOK.Data = "권리행사 불가능"
	End If

ElseIf (Trim(xcall.Data) = "풋") Then
	If (CDbl(hsga) > CDbl(Ijisu.Data)) Then
		OisOK.Data = "권리행사 가능"
	Else
		OisOK.Data = "권리행사 불가능"
	End If

Else
	OisOK.Clear
End If

curr.Data = Trim(SCREEN.Object("main.2023").data)

SCREEN.Send 0
