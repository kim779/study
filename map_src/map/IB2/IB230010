_AW_ONDECLARE_AW_
Sub OnAlert()
'/* For 매매동향RTS Data Reflush	*/
'	If S1191.Data = "M" Then
'		S1191.Data = " "
'		SCREEN.Send 0
'	End If
	Dim var
	If Trim(S101027.Data) = "" Then
		Exit Sub
	End If

	If Trim(S101027.Data) = 0 Then
		Exit Sub
	End If

	If Trim(S101321.Data) = "" Then
		Exit Sub
	End If

	If Trim(S101321.Data) = 0 Then
		Exit Sub
	End If

	var = S101027.Data / S101321.Data * 100
	S101403.Data = FormatNumber(var, 2)

	Call Cal_rate()
End Sub

Sub Cal_rate()
'전일종가대비 시가 고가 저가 비율
If Trim(S101320.Data) <> "" Then

	If Trim(S101029.Data) = "" Then
		Exit Sub
	End If

	If Trim(S101030.Data) = "" Then
		Exit Sub
	End If

	If Trim(S101031.Data) = "" Then
		Exit Sub
	End If

	si_rate.Data = FormatNumber(((S101029.Data - S101320.Data) / S101320.Data) * 100, 2, 0, 0, 0)
	go_rate.Data = FormatNumber(((S101030.Data - S101320.Data) / S101320.Data) * 100, 2, 0, 0, 0)
	jeo_rate.Data = FormatNumber(((S101031.Data - S101320.Data) / S101320.Data) * 100, 2, 0, 0, 0)

	If Trim(si_rate.Data) > 0 Then
		si_rate.TRgb = "94"
	End If

	If Trim(go_rate.Data) > 0 Then
		go_rate.TRgb = "94"
	End If

	If Trim(jeo_rate.Data) > 0 Then
		jeo_rate.TRgb = "94"
	End If
End If
End Sub

_AW_ONSEND_AW_
If Trim(SCREEN.Object("parent.ed_fcod").data) = "" Then
	S100301.Data = "00000000"
Else
	S100301.Data = Trim(SCREEN.Object("parent.ed_fcod").data)
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.OBJ_Base").Send
If SCREEN.Object("main.tab_info").ID = "1" Then
	SCREEN.Object("main.OBJ_info.1301").Data = Trim(S101005.Data)
	SCREEN.Object("main.OBJ_info").Send
End If

If Trim(S100301.Data) = "" Then
	Exit Sub
End If

Dim code

code = Mid(Trim(S100301.Data), 2, 2)


If (code < "10" Or code > "59") And (code < "B0" Or  code >= "ZZ") _
	And (code < "0A" Or  code >= "0Z") And (code < "1A" Or  code >= "1Z") _
	And (code < "2A" Or  code >= "2Z") And (code < "3A" Or  code >= "3Z") _
	And (code < "4A" Or  code >= "4Z") And (code < "5A" Or  code >= "5Z") _
	And (code < "6A" Or  code >= "6Z") And (code < "7A" Or  code >= "7Z") _
	And (code < "8A" Or  code >= "8Z") And (code < "9A" Or  code >= "9Z") Then
	SYSTEM.Trace "hoga exit sub code=" & S100301.Data
	Exit Sub
End If

OnAlert()
Cal_rate()



