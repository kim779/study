Sub send_f()

	If r1.Checked Then
		upgb.Data = "0"
	ElseIf r2.Checked Then
		upgb.Data = "1"
	ElseIf r3.Checked Then
		upgb.Data = "2"
	Else
		upgb.Data = "3"
	End If

	GRID0.Clear
	SCREEN.Send 0
End Sub

Sub comboset()
	Dim ii, index, txt, item, list, garr
	list = ""

	If r1.Checked Then
		garr = g_ArrData
	ElseIf r3.Checked Then
		garr = g_ArrData
	Else
		garr = g_ArrData_l
	End If

	For ii = LBound(garr) To UBound(garr)
'	For ii = 5 To uppb
		txt = garr(ii)(0)
		index = garr(ii)(1)
		If index < 10 Then
			index = "0" & index
		End If
		item = index & txt
		If Len(list) = 0 Then
			list = index & vbTab & item
		Else
			list = list & vbTab & item
		End If
	Next
	SCOMB.SetItems list
End Sub

Sub p_write_ini()
	Dim upcd

	If r1.Checked Then
		upcd = "1"
	ElseIf r2.Checked Then
	 	upcd = "2"
	ElseIf r3.Checked Then
		upcd = "3"
	Else
		upcd = "4"
	End If

	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "upcd", upcd
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim upcd
		upcd = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(0), "upcd"))

		If upcd <> "" Then
			For ii=1 To 4
				If ii = CLng(upcd) Then
					SCREEN.Object("r"&ii).Checked = True
				Else
					SCREEN.Object("r"&ii).Checked = False
				End If
			Next
		Else
			For ii=1 To 4
				If ii = 1 Then
					SCREEN.Object("r"&ii).Checked = True
				Else
					SCREEN.Object("r"&ii).Checked = False
				End If
			Next
		End If
	End If
End Sub

'거래소 구분값추가로 인한 연동 함수추가
