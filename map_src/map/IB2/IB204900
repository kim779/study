RESOURCE DIVISION
{


_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(210500)
_AW_ONDBLCLK_AW_
Dim code, retn

If S210500.HitPos = 3 Then
	code = Trim(S210500.GetGridCell(S210500.Row, 1))
	If Trim(code) <> "" Then
		code = Trim(Mid(code,2,11))
		S1301.Data = Trim(code)
		S1301.Trigger "", True

		' ONLY DOUBLE CLICK CODE 0805
		retn = SCREEN.GetCodeType(Trim(S1301.Data))
		Select Case retn
			Case 1, 2, 3, 4, 5, 7 ' 거래소, 코스닥, K-OTC, 뮤추얼, Reit
				SCREEN.CreateWindow 1, "IB200100 /t /s /p5 /d", "1301" & vbTab & S1301.Data
			Case 6, 27	' ETF/ETN
				SCREEN.CreateWindow 1, "IB282100 /t /s /p5 /d", "1301" & vbTab & S1301.Data
			Case 9	' ELW
				SCREEN.CreateWindow 1, "IB280200 /t /s /p5 /d", "1301" & vbTab & S1301.Data
			Case Else
				SCREEN.CreateWindow 1, "IB200100 /t /s /p5 /d", "1301" & vbTab & S1301.Data
		End Select
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(c_upgb)
_AW_ONCHANGE_AW_


SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(company)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To S210500.Rows
	str = str & Right(Trim(S210500.GetGridCell(i, 1)), 6)
	str = str & vbTab
	str = str & Trim(S210500.GetGridCell(i, 2))
	str = str & vbLf
Next

If Len(Trim(str)) > 6 Then
	SYSTEM.SetAutoCode str, S210500.Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



