RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim	g_CtTp
Dim g_TchFlag

g_CtTp = "0"
g_TchFlag = False
'-------------------------------------------------------------------------
'AType : 0-All, 1-ChartType
Sub SendChart(AType)
	If AType = "1" Then
		Data = AType & "|" & g_CtTp
	Else
		ItemCd = EDIT0.Data
		If Len(Trim(ot_ckdt.Data)) = 0 Then
			CkDt = "99999999"
		Else
			CkDt = ot_ckdt.Data
		End If
		Data = "0" & "|" & ItemCd & "|" & g_CtTp & "|" & CkDt & "|" & ed_date.data

	End If

	OBJ_CHART.Proc "SendData", Data
End Sub
'-------------------------------------------------------------------------
Sub SetInit()
	ot_ckdt.Data = "99999999"
End Sub

Sub send_f()

	GRID0.Clear
	SCREEN.Object("OBJ_CHART.CTL").Clear

	SCREEN.Send 0
	SCREEN.SetTimer 2, False
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
'cxMarket.Major = SCREEN.Major


'
SCREEN.Send 0
SCREEN.SetTimer 2, False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SendChart("0")

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_date)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.Column >= 4 And GRID0.Column <= 6 Then
	g_CtTp = CStr(GRID0.Column - 4)
	SendChart("0")
	GRID0.Column = 2
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


