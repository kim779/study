Const myFILE = "userconf.ini"
Const myMAP = "IB203500"

Dim r_upgb

Sub p_write_com()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "COMBO1", S20301.Data

End If
End Sub

Sub p_read_com()
If SCREEN.CreateObject("Info") Then
 	S20301.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COMBO1"))
End If

If Len(Trim(S20301.data)) = 0 Then
	S20301.data = "001"
	c_upgb.DATA = "001"
End If
End Sub

Sub ChangeCode()
	r_upgb = P_GetBigCd(S20301.Data)
	If S20301.Data = 889 Then
		r_upgb = 889
	End If

	Select Case r_upgb
		Case "001"		'KOSPI
			c_upgb.Data = r_upgb
		Case "101"		'KOSPI200
			c_upgb.Data = r_upgb
		Case "201"		'KOSDAQ
			c_upgb.Data = r_upgb
		Case "301"		'KOSDAQ50
			If S20301.Data = "303" Then
				c_upgb.Data = "201"
			ElseIf S20301.Data = "305" Then
				c_upgb.Data = "201"
			Else
				c_upgb.Data = r_upgb
			End If
		Case "401"		'KOSPI100
			c_upgb.Data = r_upgb
		Case "303"		'KOSTA
			c_upgb.Data = r_upgb
		Case "999"		'KRX100
			c_upgb.Data = r_upgb
		Case "601"		'SECTOR
			c_upgb.Data = r_upgb
		Case "701"		'SECTOR
			c_upgb.Data = r_upgb
		Case "801"		'기타
			c_upgb.Data = r_upgb
		Case "889"		'전체(ELW제외)
			c_upgb.Data = r_upgb
		Case Else
		   S20301.Data = "001"
		   c_upgb.Data = "001"
	End Select

	SYSTEM.SetHistory "20301", S20301.Data

    S200901.Data = S20301.Data
End Sub

Sub company()
	Dim i, str
	str = ""
	For i = 1 To S201300.Rows
		str = str & Right(Trim(S201300.GetGridCell(i, 2)), 6)
		str = str & vbTab
		str = str & Trim(S201300.GetGridCell(i, 5))
		str = str & vbLf
	Next

	If Len(Trim(str)) > 0 Then
		SYSTEM.SetAutoCode str, S201300.Rows
	End If
End Sub

Function numGrow(num)
	numGrow = num +1
End Function

