_AW_ONDECLARE_AW_
Sub change_code(codx)
	If Len(Trim(codx)) <> 6 Then
		Exit Sub
	End If
SYSTEM.Trace "[IB201600] change_code codx = " & codx	
	S1301.Data = codx
	SCREEN.Send 0
	OBJ01.Send
End Sub

Sub change_tab(index)
	UT1.Index = index

	Select Case UT1.index
		Case 1
			OBJ01.SetObject "IB2016T2"
		Case 2
			OBJ01.SetObject "IB2016T3"
		Case 3
			OBJ01.SetObject "IB2016T4"
		Case 4
			OBJ01.SetObject "IB2016T5"
		Case 5
			OBJ01.SetObject "IB2016T6"
		Case 6
			OBJ01.SetObject "IB2016T7"
		Case 7
			OBJ01.SetObject "IB2016T8"
	End Select

	SCREEN.Object("OBJ01.1777").Data = S1777.Data
	OBJ01.send
End Sub

Sub changerange(rg1,rg2)
	'Dim arr,rg1,rg2

	If rg1 > rg2 Then
		S17412.SetPriceRange rg1,rg2
	Else
		S17412.SetPriceRange rg2,rg1
	End If
End Sub

Sub changepercent(rg1,rg2)
	S17412.SetPercent rg1,rg2
End Sub

Sub change_Market(sVal)
SYSTEM.Trace "[IB201600] change_Market sVal = " & sVal
	If sVal = "KRX" Then
		S1777.Data = "1"
		S17412.SetMKtype(1)
	ElseIf sVal = "NXT" Then
		S1777.Data =  "2"
		S17412.SetMKtype(2)
	ElseIf sVal = "통합" Then
		S1777.Data =  "3"
		S17412.SetMKtype(3)
	End If

	SCREEN.Send 0


	SYSTEM.Trace "[IB2016]change_Market  sVal = " & sVal


	SCREEN.Object("OBJ01.1777").Data = S1777.Data

	OBJ01.Send
End Sub

