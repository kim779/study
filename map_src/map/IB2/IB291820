_AW_ONSEND_AW_
gbdt.Data = SCREEN.Object("parent.gbdt").data

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, var

For ii=1 To GRID0.Rows
	var = Trim(GRID0.GetGridCell(ii, 1))
	GRID0.SetGridCell ii, 1, var
Next

If gbdt.Data = "0" Then          '일자별
	obj.Setobject "IB291822"
Else                             '시간별
	obj.Setobject "IB291821"
End If

obj.Send

