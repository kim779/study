_AW_ONDECLARE_AW_
Const myFile = "userconf.ini", myMap = "IB295700"
Dim str1

Private Sub loadUserConfig()
	If SCREEN.CreateObject("Info") Then
	   str1  = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "COMB"))
	   If str1 = "" Then
			COMB.Data = GUBN.TEXT
			COM2.Data = COM_A.TEXT

			BSIS_1.Data = BSIS_1A.TEXT
			BSIS_2.Data = BSIS_2A.TEXT
			GRYL_1.Data = GRYL_1A.TEXT
			GRYL_2.Data = GRYL_2A.TEXT

			If(COMB.Data = "2") Then
			       F1.Data = BSIS_1.Data
			       F2.Data = BSIS_2.Data
			Else
			       F1.Data = GRYL_1.Data
			       F2.Data = GRYL_2.Data
			End If


			ILSU.Data = ILSU_A.Text

			INFO.pushData LOGIN.Name, myFile, myMap, "COMB", COMB.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "COM2", COM2.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "BSIS_1", BSIS_1.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "BSIS_2", BSIS_2.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GRYL_1", GRYL_1.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GRYL_2", GRYL_2.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GJDY", GJDY.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "ILSU", ILSU.Data
		Else
			COMB.Data  = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "COMB" 	))
			COM2.Data  = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "COM2" 	))
			BSIS_1.Data    = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "BSIS_1" ))
			BSIS_2.Data    = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "BSIS_2" ))
			GRYL_1.Data    = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "GRYL_1" ))
			GRYL_2.Data    = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "GRYL_2" ))
			GJDY.Data  = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "GJDY" 	))
			ILSU.Data  = Trim(INFO.popData(LOGIN.Name, myFile, myMap, "ILSU" 	))
			If(COMB.Data = "2") Then
			       F1.Data = BSIS_1.Data
			       F2.Data = BSIS_2.Data
			Else
			       F1.Data = GRYL_1.Data
			       F2.Data = GRYL_2.Data
			End If
    End If
	End If
End Sub


Private Sub saveUserConfig()
	If SCREEN.CreateObject("Info") Then
			INFO.pushData LOGIN.Name, myFile, myMap, "COMB", COMB.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "COM2", COM2.Data

			If(COMB.Data = "2") Then
			       BSIS_1.Data = F1.Data
			       BSIS_2.Data = F2.Data
			Else
			       GRYL_1.Data = F1.Data
			       GRYL_2.Data = F2.Data
			End If

			INFO.pushData LOGIN.Name, myFile, myMap, "BSIS_1", BSIS_1.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "BSIS_2", BSIS_2.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GRYL_1", GRYL_1.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GRYL_2", GRYL_2.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "GJDY", GJDY.Data
			INFO.pushData LOGIN.Name, myFile, myMap, "ILSU", ILSU.Data
	End If
End Sub

_AW_ONSTART_AW_
SCREEN.IgnoreChange True
loadUserConfig()
SCREEN.IgnoreChange False
OBJ.SEND

