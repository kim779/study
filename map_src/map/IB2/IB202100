_AW_ONDECLARE_AW_
Sub Onalert_c()
	Dim i, data
	For i = 1 To GRID0.Rows
		'data = FormatNumber(Trim(GRID0.GetGridCell (i, 4))*100, 2, 0, 0, 0)
		If Trim(GRID0.GetGridCell (i, 4)) <> "" Then
			data = Round((Abs(GRID0.GetGridCell (i, 4)) - Trim(GRID0.GetGridCell (i, 8))) / Trim(GRID0.GetGridCell (i, 8)) * 100 ,2)
			If data > 0 Then
				'data = "+"& data
				GRID0.SetGridCell i, 9, "+" & FormatNumber(data, 2, 0, 0, 0) & " %"
			Else
				GRID0.SetGridCell i, 9, FormatNumber(data, 2, 0, 0, 0) & " %"
			End If
		End If

		'SYSTEM.Trace("실시간처리 " & data & "==" & Trim(GRID0.GetGridCell (i, 4)) & "==" & Trim(GRID0.GetGridCell (i, 6))&"=>"& (GRID0.GetGridCell (i, 4)-GRID0.GetGridCell (i, 6))/GRID0.GetGridCell (i, 6))
	Next
End Sub

Sub  Onalert()
	Call Onalert_c()
End Sub


Sub send_f()
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
End Sub

