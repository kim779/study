_AW_ONDECLARE_AW_
Dim sect
sect = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 0, 2
	ANCM.Data = AN20.Name
	h_acnm.Data = AN20.Name
	zpwd.Data = AN20.Password
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

Function Error_check()
	Dim msg, ret

	SCREEN.Object("main.GUIDE").Text = ""
	Error_check = False

	If Trim(ed_accn.Data) = "" Or Len(Trim(ed_accn.Data)) < 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
		Exit Function
	End If
	If Trim(zpwd.Data) = "" Or Len(Trim(zpwd.Data)) < 4 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		Exit Function
	End If

	ret = P_pswdConfirm(ed_accn.data, zpwd.data, msg)
	If ret <> True Then
		SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
		SCREEN.Object("main.GUIDE").Text = msg
		Exit Function
	End If

	Error_check = True
End Function

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'==계좌번호, 비밀번호 체크
Function l_CheckInput(ed_accn, zpwd)
 	l_CheckInput = False
	If Trim(ed_accn.data) = "" Or Len(Trim(ed_accn.data)) <> 11 Then
		SCREEN.Object("main.GUIDE").Text = "계좌번호를 확인하세요"
 		ed_accn.Setfocus
 		Exit Function
	End If

	If Len(Trim(zpwd.data)) = 0 Then
		SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
 		zpwd.Setfocus
 		Exit Function
	End If

	If SYSTEM.ConnectBy = 1 Then 					'직원일 경우에만 체크
		If Len(Trim(zpwd.data)) < 4 Then
			SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요"
	 		zpwd.Setfocus
	 		Exit Function
		End If
	End If
	l_CheckInput = True
End Function

_AW_ONINDECLARE_AW_
#LOAD IB888833
#LOAD IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
zFnoIsuNo.Clear

ed_accn.Data = Trim(SCREEN.Object("main.OBJ_order.AN20").Data)		'계좌번호
zpwd.Data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)	'비밀번호

If SYSTEM.ConnectBy = 1 Then
	If Error_check() = False Then				'주문전 Error Check
		SCREEN.OnSend = False
		Exit Sub
	End If
Else
	zpwd.Data = "9999"
End If


If l_CheckInput(ed_accn, zpwd) = True Then
	SCREEN.onsend = True
	SCREEN.ClearAll 0, 2
	ANCM.Data = h_acnm.Data
Else
	SCREEN.ClearAll 0, 2
	ANCM.Data = h_acnm.Data
	zpwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim sign

If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 0, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
'	next_btn.Enable True
'	next_btn.Setfocus
Else
'	next_btn.Enable False
	send_btn.SetFocus
End If

If sect = 0 Then
	zpwd.SetFocus
End If

Dim t_f, t_o, t_t, i
'
t_f= TABLE0.GetTableCell(1)
t_o = TABLE1.GetTableCell(1)

If Trim(t_f) = "" Then
	t_f = 0
End If

If Trim(t_o) = "" Then
	t_o = 0
End If

t_t = CLng(t_f) + CLng(t_o)

If t_t > 0 Then
	sign = "+"
Else
	sign = "-"
End If

TABLE2.SetTableCell 1, sign & t_t

For i=1 To GRID0.Rows
