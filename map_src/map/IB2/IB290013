_AW_ONDECLARE_AW_
Sub send_f()
	S21310.Clear
	S20301.Data = SCREEN.Object("main.ed_upcd").Data
	OBJECT0.Proc "send_f", ""
	SCREEN.Send 0
End Sub

Sub setjs(param)
	ArrData = Split(param, "|")

	celltime = Trim(S21310.GetGridCell(1, 1))
	recvtime = ArrData(0)
	If celltime = recvtime Then
		S21310.SetGridCell 1, 5, ArrData(1)
		S21310.SetGridCell 1, 6, ArrData(2)
		S21310.SetGridCell 1, 7, ArrData(3)
		S21310.SetGridCell 1, 8, ArrData(4)
		S21310.SetGridCell 1, 9, ArrData(5)
	End If

End Sub

_AW_ONSEND_AW_
Dim code
code = Trim(S20301.Data)
If Len(code) > 0 Then
	code = CLng(code)
Else
	code = 0
End If

'upgb 801
'KTOP 30(812) 2초

'upgb 201
'KOSDAQ150(305) 2초

'upgb 101
