RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim xstr, xvalue, xistrue

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	focus.Text = "3"
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

TRGB.Pop("0334_TRGB")
COMBO.Pop("0334_COMBO")
focus.Text = "3"
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'GRID.Column = 4
'If GRID.Column <= 0 Then
'   GRID.Column = 3
'   GRID.COLUMN.TRGB = 242
'Else
'   GRID.Column = 3
'   GRID.COLUMN.TRGB = 241
'End If

Select Case focus.Text
	Case "1"	TRGB.SetFocus()
	Case "2"	COMBO.SetFocus()
	Case "3"	SYMBOL2.SetFocus()
End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SYMBOL2)
_AW_ONCLICK_AW_
focus.Text = "3"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(TRGB)
_AW_ONCHANGE_AW_
TRGB.PUSH("0334_TRGB")
focus.Text = "1"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(COMBO)
_AW_ONCHANGE_AW_
COMBO.PUSH("0334_COMBO")
focus.Text = "2"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID)
_AW_ONCLICK_AW_
If GRID.HitPos = 3 Then
	S1301.DATA = GRID.GetGridCell(GRID.row, 3)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.Data
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
focus.Text = "3"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



