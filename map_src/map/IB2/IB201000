RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB200800"

Sub p_read_ini()
If SCREEN.CreateObject("Info") Then
 	CHK.text = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "G_CHCK"))
End If
End Sub

Sub p_write_ini()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "G_CHCK", CHK.text
End If
End Sub

Sub OnAlert()
	Dim	srat

	If Trim(S2311.Data) = "" Or Trim(S2314.Data) = "" Then
		Exit Sub
	End If

	srat = (S2314.Data / S2027.Data)*100
	S2352.Data = FormatNumber(srat, 2, -1)

	If Trim(S2352.data) < 50 Then
		S2352.TRgb = 95
	ElseIf Trim(S2352.data) = 50 Then
		S2352.TRgb = 69
	ElseIf Trim(S2352.data) > 50 Then
		S2352.TRgb = 94
	End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn

	Send_Main()
End Sub

Sub Send_Main()
	cxMarket.sCode = S1301.Data
	SCREEN.SEND 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.MNum = SCREEN.GetMapName(1)
cxMarket.Major = SCREEN.Major

p_read_ini()
CHK.Data = 2

S1301.SetFocus

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If cxMarket.sMarket = "통합" Then
	S1777.Data = "3"
ElseIf cxMarket.sMarket = "KRX" Then
	S1777.Data = "1"
ElseIf cxMarket.sMarket = "NXT" Then
	S1777.Data = "2"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
cxMarket.sCode = Trim(S1301.Data)
obj0.Send
Call OnAlert()

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
p_write_ini()

_AW_ONENDSUB_AW_
