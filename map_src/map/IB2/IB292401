_AW_ONDECLARE_AW_
Option Explicit

Dim befval
befval = 0

Sub send_f()
	befval = 0
	SCREEN.ClearAll 0, 2
	SCREEN.Send 0
End Sub

Sub diffupdate(val)
	If befval = 0 Then
	   befval = CLng(val)
	Else
	   If befval = CLng(val) Then
	      Exit Sub
	   End If
	End If

	Dim xval, diff, xstr, ii

	For ii = 1 To 8
		xval = Trim(SCREEN.Object("A"&ii).GetTableCell(1))

		If Len(xval) > 0 Then
			diff = CLng(xval)-CLng(val)

			If diff > 0 Then
				xstr = "+"&diff
			ElseIf diff < 0 Then
				xstr = "-"&diff
			End If

			SCREEN.Object("C"&ii).SetTableCell 1, xstr
		End If
	Next

	befval = CLng(val)
End Sub

_AW_ONSEND_AW_
cod2.Data = SCREEN.Object("parent.1301").Data

