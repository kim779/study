RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Navigate()
	SCREEN.SetTimer 3, False
End Sub

'날짜 8자리, 구분자
Function SetDateString(as_val, Div_string)
	SetDateString = ""

	If Len(as_val) = 0 Then
		Exit Function
	End If

	SetDateString = Mid(as_val, 1, 4) & Div_string & Mid(as_val, 5, 2) & Div_string & Mid(as_val, 7, 2)
End Function

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Proc "OBJ_STAFF.Send_F", ""

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Dim shost, id ,StartDay, EndDay, Dateurl1, Dateurl2

StartDay = SetDateString(change_date("m", -1), "-")
EndDay =  SetDateString(getCurrDay(), "-")
Dateurl1 = "sdate%3D" + StartDay + "%26edate%3D" + EndDay
Dateurl2 = "sdate="   + StartDay + "&edate="     + EndDay

If Trim(S1301.Data) <> "" Then
	shost = SYSTEM.Host
	If Mid(shost,1,6) = "172.17" Then	' 내부망
		If SYSTEM.ConnectBy = 1 Then	' 직원
			id = Trim(LOGIN.User)		' 직원사번
		Else
			id = Trim(SCREEN.Object("OBJ_STAFF.emno").Data) ' 직원사번
		End If
		If Len(id) > 0 Then	' 직원사번 존재시 CDN으로 망연계 인터넷 단말에서 조회
			url = "https://www.ibks.com/redirectCDN.jsp?url=http%3A//consensus.hankyung.com/analysis/list%3F"+ Dateurl1 + "&report_type%3DCO%26search_value%3DREPORT_TITLE%26search_text%3D"&Trim(S1301.Data)&"&id="&id
			SYSTEM.Navigate url
		Else				' 직원 사번 미존재시 일반 고객으로 간주
			BROWSER0.Navigate("https://consensus.hankyung.com/analysis/list?" + Dateurl2 + "&report_type=CO&search_value=REPORT_TITLE&search_text=" + Trim(S1301.Data))
		End If
	Else	' 외부망 :: bypass
		BROWSER0.Navigate("https://consensus.hankyung.com/analysis/list?" + Dateurl2 + "&report_type=CO&search_value=REPORT_TITLE&search_text=" + Trim(S1301.Data))
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BROWSER0)
_AW_ONCLICK_AW_
SYSTEM.Push "DOYOUAGREE", "YES"
SCREEN.CloseWindow()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "1301", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
If Trim(S1301.Data) = "000000" Or Trim(S1301.Data) = "" Then
	Exit Sub
End If
S1301.Trigger "",True
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



