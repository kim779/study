Sub send_f()
	If SCREEN.GetCodeType(Trim(S1301.Data)) = 9 Then
		E1301.Data = S1301.Data
		S1301.Trigger "1301", True

		cx_1843.Send S1301.Data
	Else
		E1301.Clear
