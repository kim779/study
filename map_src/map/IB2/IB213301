'--------------------------------------------------------------------------------------------------------------
'pibo2912 서비스조회후 호출됨, 모화면의 콤보변경시 호출
Sub GetColumnDataFromCtrl()
	Dim strdata, ii, strtmp
	strdata = edUpcode.Data & ":"

	mGubn = SCREEN.Object("parent.edgubn").data

	For ii = 1 To StockGrid.Rows
		If Len(Trim(StockGrid.GetGridText(ii,1))) > 0 Then
			strtmp = Trim(StockGrid.GetGridText(ii,1))              '업종코드
			strdata = strdata & strtmp & ":"
		End If
		StockGrid.SetGridCell ii,9, ""  							'비중컬럼 초기화
	Next

	If mGubn = "0" Then												'시가총액
		If 	Len(Trim(StockGrid.GetGridText(1, 8))) > 0 Then
			SCREEN.Proc  "Main.GetBijungArr", strdata & "," &  "5"  '시가총액 비중 조회해오기
		End If
	ElseIf mGubn = "1" Then											'거래량
		If 	Len(Trim(StockGrid.GetGridText(1, 6))) > 0 Then
			SCREEN.Proc  "Main.GetBijungArr", strdata & "," &  "6"	'거래량 비중 조회해오기
		End If
	ElseIf mGubn = "2" Then 										'거래대금
		If 	Len(Trim(StockGrid.GetGridText(1, 7))) > 0 Then
			SCREEN.Proc  "Main.GetBijungArr", strdata & "," &  "7"	'거래대금 비중 조회해오기
		End If
	End If
	SetSort()
End Sub


'--------------------------------------------------------------------------------------------------------------
'모화면에 비중데이터 조회 요청후 조회가 완료되면 호출됨
Sub SetBijungArr()
	Dim sArr, sArr2, ii, jj, stmp

	For ii = 1 To SCREEN.Object("parent.Grid0").Rows
		If Len(Trim(SCREEN.Object("parent.Grid0").GetGridText(ii,1))) > 0 Then
			For jj = 1 To StockGrid.Rows
				stmp = Trim(StockGrid.GetGridText(jj,1))
				If Trim(SCREEN.Object("parent.Grid0").GetGridText(ii,1)) = stmp Then
				'	SYSTEM.Trace(stmp & "   " & SCREEN.Object("parent.Grid0").GetGridText(ii,1))
					StockGrid.SetGridCell jj, 9, Trim(SCREEN.Object("parent.Grid0").GetGridText(ii,2))
				End If
			Next
		End If
	Next

	SetSort()
End Sub


'--------------------------------------------------------------------------------------------------------------
Sub SetSort()
	Dim ii, data

	mGubn = SCREEN.Object("parent.edgubn").data

	If mGubn = "0" Then												'시가총액
		StockGrid.Sort 8, False, False

	ElseIf mGubn = "1" Then											'거래량
		StockGrid.Sort 6, False, False

	ElseIf mGubn = "2" Then 										'거래대금
		StockGrid.Sort 7, False, False

	ElseIf mGubn = "3" Or mGubn = "4" Then							'외국인
		StockGrid.Sort 8, False, False

	End If

	For ii = 1 To StockGrid.Rows
		StockGrid.SetGridCell ii, 2, Trim(StockGrid.GetGridText(ii,2))
	Next

End Sub








