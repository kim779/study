Sub Set_combo()

Dim items, item1, item2, item3, item4, item5

S1301.Data = SCREEN.object("parent.elw_gcjs").data
If Trim(S1301.Data) = "ASKET" Then

	item1 = Trim(Mid(SCREEN.Object("parent.1881").Data, 2, 6))&Trim(SCREEN.Object("parent.1861").Data)
	item2 = Trim(Mid(SCREEN.Object("parent.1882").Data, 2, 6))&Trim(SCREEN.Object("parent.1862").Data)
	item3 = Trim(Mid(SCREEN.Object("parent.1883").Data, 2, 6))&Trim(SCREEN.Object("parent.1863").Data)
	item4 = Trim(Mid(SCREEN.Object("parent.1884").Data, 2, 6))&Trim(SCREEN.Object("parent.1864").Data)
	item5 = Trim(Mid(SCREEN.Object("parent.1885").Data, 2, 6))&Trim(SCREEN.Object("parent.1865").Data)

	If item3 = "" Then
		items = vbTab & item1 & vbTab & item2
	Else
		items = vbTab & item1 & vbTab & item2 & vbTab & item3
	End If
	If item4 <> "" Then
		items = items & vbTab & item4
	End If
	If item5 <> "" Then
		items = items & vbTab & item5
	End If

	COMBO0.SetItems(items)
	COMBO0.Index = SCREEN.Object("parent.obj1.combo0").index
	COMBO0.Refresh
	S1301.Data = COMBO0.data
	PANEL1.Visible = False
	COMBO0.Visible = True
Else
	S1301.Data = Mid(SCREEN.Object("parent.1881").Data, 2, 6)
	PANEL1.Visible = True
	COMBO0.Visible = False
End If

SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
