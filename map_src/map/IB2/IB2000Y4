Sub send_f()
	If r1_all.Checked Then
		S1301.Data = SCREEN.Object("main.1301").Data
		OBJ_hnam.Send
		Exit Sub
	Else
		SCREEN.Send 0
	End If
End Sub

Sub showgrid(val)
	GRID0.Clear
	If val = "1" Then
		BUTTON.Enable False
		S1301.Enable False
		GRID0.SetColumnVisible 7, True
		GRID0.SetColumnWidth 3, 402
		r2_1.Enable False
		r2_2.Enable False
		r2_3.Enable False

		For ii=1 To 20
			SCREEN.Object("GUBN"&ii).Checked = True
			SYSTEM.Trace "showgrid : [" & ii & "] " & SCREEN.Object("GUBN"&ii).Checked
		Next
	Else
		BUTTON.Enable True
		S1301.Enable True
		GRID0.SetColumnVisible 7, False
		GRID0.SetColumnWidth 3, 482
		r2_1.Enable True
		r2_2.Enable True
		r2_3.Enable True
		rd_click()
	End If
End Sub

Sub rd_click()
	Dim ii

	If r2_1.Checked Then
		For ii=1 To 20
			If ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	ElseIf r2_2.Checked Then
		For ii=1 To 20
			If ii = 2 Then
				SCREEN.Object("GUBN"&ii).Checked = True
			Else
				SCREEN.Object("GUBN"&ii).Checked = False
			End If
		Next
	ElseIf r2_3.Checked Then
		For ii=1 To 20
			If ii = 2 Or ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	Else

	End If
End Sub

Const file = "newsinfo.ini"

Function ReadConf()
	If SCREEN.CreateObject("Info") Then
	 	ReadConf = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "ITEMS"))
	Else
		ReadConf = ""
	End If
End Function

Function ReadVersion()
	If SCREEN.CreateObject("Info") Then
	 	ReadVersion = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "VERSION"))
	Else
		ReadVersion = ""
	End If
End Function

Sub Onalert()
	Dim	v_gubn
	Dim strKeys
	Dim v_subgubn
	Dim c_list , f, c_yn

	c_yn = "N"
	'종목코드 체크
	If r1_one.Checked Then
		If Trim(GRID4.GetGridCell(1,4)) = "" Then
		 	Exit Sub
		Else
			If Trim(GRID4.GetGridCell(1,12)) <> "" Then
				c_list = Split(Trim(GRID4.GetGridCell(1,12)) , "A", -1, 1)
			For Each f in c_list
				If Len(f) <> 0 And Trim(cod2.data) = f Then
					c_yn = "Y"
					Exit For
				End If
			Next
			End If
		End If
		If Trim(GRID4.GetGridCell(1,4)) <> Trim(cod2.data) And c_yn = "N" Then
			GRID4.Clear()
			Exit Sub
		End If
	End If

	'뉴스 제공사 체크
	If Trim(GRID4.GetGridCell(1,2)) = "" Then
		Exit Sub
	End If

	If IsNumeric(Trim(GRID4.GetGridCell(1,8))) = False Then
		Exit Sub
	End If

	v_gubn = CLng(Trim(GRID4.GetGridCell(1,8)))

	If v_gubn < 1 Or v_gubn > 20 Then
		Exit Sub
	End If

	If SCREEN.Object("GUBN"&v_gubn).Checked = False Then
		Exit Sub
	End If

	Select Case v_gubn
		Case 1
			If GUBN1.Checked = False Then
				Exit Sub
			End If
			v_name = "시황"
		Case 2
