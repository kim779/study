_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB295300"

Sub p_read_ini()
If SCREEN.CreateObject("Info") Then
 	g_chck1.TEXT = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "G_CHCK"))
	If g_chck1.TEXT = "1" Then
		OBJ.SetObject "IB295320"
		CHART.Visible = False
		TEXT.Visible = True
		If CHKB.Checked = True Then
		   SCREEN.Object("OBJ.CHCK").Data = "1"
		Else
		   SCREEN.Object("OBJ.CHCK").Data = "0"
		End If
	Else
		OBJ.SetObject "IB295310"
		TEXT.Visible = False
		CHART.Visible = True
		If CHKB.Checked = True Then
		   SCREEN.Object("OBJ.CHCK").Data = "1"
		Else
		   SCREEN.Object("OBJ.CHCK").Data = "0"
		End If
		OBJ.Send
	End If
End If
End Sub


Sub p_write_ini()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "G_CHCK", g_chck1.TEXT
End If
End Sub


