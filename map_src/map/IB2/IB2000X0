_AW_ONDECLARE_AW_
Dim ArrHogaCtrl
Dim g_IniIndex
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(1)&SCREEN.GetMapName(0)
ArrHogaCtrl = Array(S17412, obj_10Hoga, 0)
'0:5호가, 1:10호가, 2:최초 화면열었을 때 인덱스
g_IniIndex = ""
'-----------------------------------------------------------------------
Sub SetIniName(IniIndex)
	g_IniIndex = IniIndex
	Sindex = "0"
	If SCREEN.CreateObject("Info") Then
		Sindex = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB2000X0", "HOGA_INDEX" & g_IniIndex))
		If Len(Sindex) = 0 Then
			INFO.PushData LOGIN.Name, "userconf.ini", "IB2000X0", "HOGA_INDEX" & g_IniIndex, "0"
			Sindex = "0"
		End If
	End If
	ArrHogaCtrl(2) = Sindex
	SetHogaVisible Sindex
End Sub
'-----------------------------------------------------------------------
Sub SetHogaVisible(SIndex)
	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB2000X0", "HOGA_INDEX" & g_IniIndex, SIndex
	End If

	If SIndex = "0" Then	' 호가컨트롤 Visible
		ArrHogaCtrl(0).visible = True	' 호가컨트롤
		ArrHogaCtrl(1).Visible = False	' 호가OBJECT
		ArrHogaCtrl(1).SetObject("IB13BLNK")
		SCREEN.Object("parent.bt_reduce").Text = "10"
	Else					' 호가OBJECT Visible
		ArrHogaCtrl(0).visible = False	' 호가컨트롤
		ArrHogaCtrl(1).Visible = True	' 호가OBJECT
		ArrHogaCtrl(1).SetObject("IB2000X1")
		If Trim(SCREEN.GetMapName(1)) = "IB103300" Then	' [1033] 스마트창구대출 화면은 Depth가 다르다
			obj_10Hoga.Proc "SetDangaObject", ""
		Else
			obj_10Hoga.Proc "SetDangaObject", "Main.OBJ_order.OBJ_odr.ed_jprc"
		End If
		SCREEN.Object("parent.bt_reduce").Text = "5"
	End If
End Sub

Sub ChangeHoga()
	ArrHogaCtrl(2) = (ArrHogaCtrl(2) + 1) Mod 2
	SetHogaVisible(ArrHogaCtrl(2))
End Sub

Sub saveDepthInfo()
	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "SepType", S17412.sDepthInfo
	End If
End Sub

Sub LoadDepthInfo()
	If SCREEN.CreateObject("Info") Then
		S17412.sDepthInfo =	Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "SepType"))
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB999901

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SYSTEM.Trace "[map][IB200000][2] obj_reduce2 [호가] onStart"
LoadDepthInfo()
If Trim(SCREEN.GetMapName(1)) = "IB103300" Then	' [1033] 스마트창구대출 화면은 Depth가 다르다
'	Select Case SCREEN.Object("Main.tab_ordtyp").ID
'	Case 0 	: '매도상환
'			: obj_10Hoga.Proc "SetDangaObject", "Main.OBJ_order.OBJ_odr.ed_jprc"
'	Case 2 	: '현금상환
'			: obj_10Hoga.Proc "SetDangaObject", "Main.OBJ_order.edSangPrc"
'	Case 4 	: '만기연장
'			: obj_10Hoga.Proc "SetDangaObject", ""
'	Case 6 	: '대출신청
'			: obj_10Hoga.Proc "SetDangaObject", "Main.OBJ_order.zLoanPrslAmt"
'	Case 8	: '담보교체
'			: obj_10Hoga.Proc "SetDangaObject", ""
'	Case 10	: '현금상환취소
'			: obj_10Hoga.Proc "SetDangaObject", ""
'	End Select
	obj_10Hoga.Proc "SetDangaObject", ""
Else
	obj_10Hoga.Proc "SetDangaObject", "Main.OBJ_order.OBJ_odr.ed_jprc"
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If ArrHogaCtrl(1).Visible = True Then
	obj_10Hoga.Send
End If

S1301.Data = SCREEN.Object("main.1301").data

If Trim(S1301.Data) = "" Then
	SCREEN.OnSend = False
	Exit Sub
End If

If UCase(TypeName( SCREEN.Object("main.cxMarket") )) <> "NOTHING" Then
SYSTEM.Trace "[IB2000X0][onSend] Change_MKGubn = " & SCREEN.Object("main.cxMarket").sMarket
	If Trim(SCREEN.Object("main.cxMarket").sMarket) = "통합" Then
		S1777.Data = "3"
		S17412.SetMKtype(3)
	ElseIf Trim(SCREEN.Object("main.cxMarket").sMarket) = "KRX" Then
		S1777.Data = "1"
		S17412.SetMKtype(1)
	ElseIf Trim(SCREEN.Object("main.cxMarket").sMarket) = "NXT" Then
		S1777.Data = "2"
		S17412.SetMKtype(2)
	End If
End If


