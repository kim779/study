Sub send_f()
	If R1.Checked Then
		If OBJ0.GetObject <> "IB282620" Then
			OBJ0.SetObject("IB282620")
		End If
	ElseIf R2.Checked Then
		If OBJ0.GetObject <> "IB282610" Then
			OBJ0.SetObject("IB282610")
		End If
	End If
	OBJ0.Send
End Sub
