_AW_ONDECLARE_AW_
' Spread refresh check
Dim bSpreadReload
bSpreadReload = False

'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_Check(Flag)
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit For
		End If
		If Trim(VIEWGRID.GetGridCell (ii, 6)) > "0" Then
			VIEWGRID.SetGridCell ii, 1, Flag
		End If

	Next
	btn_chk()
End Sub

Sub btn_chk()
	Dim cnt, ii

	cnt = 0
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit For
		End If
		If VIEWGRID.getGridCell(ii, 1) = "1" And Trim(VIEWGRID.GetGridCell (ii, 6)) > "0" Then
			cnt = cnt +1
		End If
	Next

	If cnt > 0 Then
		SCREEN.Object("parent.btn_j").Enable = True
	Else
		SCREEN.Object("parent.btn_j").Enable = False
		allCheck.Checked = False
	End If
End Sub


'***************************************************************************
' DESC: clear_check
'***************************************************************************
Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit For
		End If
		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
	btn_chk()
End Sub

'***************************************************************************
'	Func : Find_Row
'***************************************************************************
Function Find_Row(sCode)
	For row = 1 To VIEWGRID.Rows
		If Trim(sCode) = Trim(VIEWGRID.GetGridCell (row, 2)) Then
			Find_Row = row
			Exit Function
		End If
	Next
	Find_Row = 0
End Function

'***************************************************************************
' DESC : calc_sum()함수 : 주식평가금액, 주식평가손익, 주식수익률 계산
'***************************************************************************
Sub calc_sum()
	Dim migm, tmigm, pggm, tpggm, pgsi, srat, ii

	tpggm = 0
	tmigm = 0

	For ii = 0 To VIEWGRID.Rows
		migm = VIEWGRID.GetGridCell(ii, 13)				'매입금액의 합
		If Is_numeric(migm) = False Then
			migm = 0
		End If
		tmigm = tmigm + migm

		pggm = VIEWGRID.GetGridCell(ii, 10)				'평가금액의 합
		If Is_numeric(pggm) = False Then
			pggm = 0
		End If
		tpggm = tpggm + pggm
	Next

	SCREEN.Object("parent.o_migm").Data = tmigm									'매입금액의 합
	SCREEN.Object("parent.o_pggm").Data = tpggm									'평가금액의 합

	SCREEN.Object("parent.o_pgsi").Data = tpggm - tmigm							'평가손익
	If SCREEN.Object("parent.o_pgsi").Data > 0 Then
		SCREEN.Object("parent.o_pgsi").Data = "+" & SCREEN.Object("parent.o_pgsi").Data
	End If

	If tmigm =< 0 Then									'손익률
		srat = 0
	Else
		srat = CCur((tpggm - tmigm) / tmigm) * 100
	End If

	SCREEN.Object("parent.o_srat").Data = srat
	If srat > 0 Then
		SCREEN.Object("parent.o_srat").Data = "+" & srat & "%"
	End If

End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

ed_accn.Data = Trim(SCREEN.Object("main.OBJ_order.AN20").Data)		'계좌번호
'ed_pswd.Data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)	'비밀번호
Call Password_initSetting(ed_pswd)

If Trim(ed_accn.data) = "" Or Trim(ed_pswd.data) = "" Then
	Exit Sub
End If

If Len(Trim(ed_accn.data))< 11 Or Len(Trim(ed_pswd.data)) < 4 Then
	SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
	Exit Sub
End If

SCREEN.Wait = True
VIEWGRID.Clear
Call CONTROL0.Send(ed_accn.data , ed_pswd.data, 0, 0)

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If bSpreadReload = True Then
	SCREEN.Send 0
	bSpreadReload = False
Else
	ed_jqty.Push("F_jqty")
	SYSTEM.SetHistory "ed_focod", ed_focod.data

	SCREEN.Object("main.OBJ_order.OBJ_odr.ed_focod").data = ed_focod.Data
	SCREEN.Proc "main.OBJ_order.OBJ_odr.ChangeCode", ""

	SCREEN.Object("main.OBJ_order.OBJ_odr.ed_jqty").data = ed_jqty.Data
	SCREEN.Object("main.OBJ_order.OBJ_odr.OrdCfg").Qty = ed_jqty.Data

	VIEWGRID.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(VIEWGRID)
_AW_ONCLICK_AW_
Dim jqty, code, gubn, name

If VIEWGRID.HitPos = 3 Then
	If VIEWGRID.Column = 1 Then
		btn_chk()
	Else

		ed_focod.Data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 2))	'종목코드
		ed_jqty.Data = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 6))	'주문수량
		ed_jqty.Data = Right(ed_jqty.data, 7)

		gubn = Trim(VIEWGRID.GetGridCell(VIEWGRID.row, 4))	'매도/매수 구분
		If InStr(Trim(gubn), "매도") > 0 Then
			gubn = 2
		Else
			gubn = 1
		End If

		If Trim(ed_focod.Data) = "" Then
		    Exit Sub
		End If
		SCREEN.IgnoreChange True
		If gubn <> SCREEN.Object("main.OBJ_order.tab_order").ID Then
			SCREEN.Object("main.OBJ_order.tab_order").ID = gubn
			SCREEN.Proc "main.OBJ_order.order_tab_change", ""
		End If
		SCREEN.IgnoreChange False
		Select Case Left(ed_focod.Data, 1)
			Case "1", "4", "A", "D"
				name = SCREEN.GetName (101, ed_focod.Data, 0)
			Case "2", "3", "B", "C"
				name = SCREEN.GetName (102, ed_focod.Data, 0)
		End Select

		If Trim(name) =  "" Then
			ed_focod.Data = ""
		Else
			SCREEN.SetTimer 1, False
		End If
	End If
End If
