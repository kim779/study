_AW_ONDECLARE_AW_

Dim g_IsFirst
Dim g_StdCode
Dim g_BefAccVol
Dim g_Today
Dim g_Flag

g_IsFirst = True
g_StdCode = ""
g_BefAccVol = 0
g_Today = GetToday()
g_Flag = 1
'-----------------------------------------------------------------------
Sub SetFlag(Flag)
	g_Flag = Flag
End Sub
'-----------------------------------------------------------------------
Function Str2Int(Data)
	Str2Int = 0
	AData = Trim(Data)
	If Len(AData) = 0 Then
		Exit Function
	End If
	Str2Int = CLng(AData)
End Function
'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	If Data > 0 Then
		SetSign = "+" & Data
	End If
End Function
'-----------------------------------------------------------------------
Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function
