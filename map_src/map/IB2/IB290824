	Case Else
		S40301.Data = "2"
	End Select

ElseIf  SCREEN.GetMapName(1) = "IB290830" Or SCREEN.GetMapName(1) = "IB290850" Then
	Select Case Left(Trim(SCREEN.Object("parent.TABLE28").GetHead(1)) , 1)
