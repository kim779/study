		Case "1" : obj_odr.SetObject("IB200095")
		Case "2" : obj_odr.SetObject("IB200096")
		Case "3" : obj_odr.SetObject("IB200097")
		Case "4" : obj_odr.SetObject("IB200098")
		End Select
	End Select

End Sub

