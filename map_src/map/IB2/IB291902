		sItem = hCombo.Data & vbTab & "01금융투자" & vbTab & "02보험" & vbTab & "03투신" & vbTab & "12사모" & vbTab & "04은행" & vbTab & "05기타금융" & vbTab & "06연기금" & vbTab &  "13국가" & vbTab & "07기타법인" & vbTab & "08개인" & vbTab & "09외국인"
