RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub OBJ_setting()
	SCREEN.SetTimer 4, False
End Sub

_AW_ONSTART_AW_
Call OBJ_setting()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

OBJ_setting()
SCREEN.OnSend False

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Dim flag

If SCREEN.CreateObject("Info") Then
	flag = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200052_RDO1"))
End If

OBJ0.SetObject "IB2000YG"
OBJ1.SetObject "IB2000YH"

Select Case flag
	Case "1"
		OBJ.SetObject "IB2000YE"
		rVol.Checked True
		rAmt.Checked False
		SCREEN.Object("OBJ0.gubn").Data = 1
		SCREEN.Object("OBJ1.gubn").Data = 1
	Case "0"
		OBJ.SetObject "IB2000YF"
		rVol.Checked False
		rAmt.Checked True
		SCREEN.Object("OBJ0.gubn").Data = 0
		SCREEN.Object("OBJ1.gubn").Data = 0
End Select

OBJ.Send
OBJ0.Send
OBJ1.Send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(rVol)
_AW_ONCLICK_AW_
OBJ.SetObject "IB2000YE"

SCREEN.CreateObject("Info")
INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200052_RDO1", "1"

Call OBJ_setting()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(rAmt)
_AW_ONCLICK_AW_
OBJ.SetObject "IB2000YF"

SCREEN.CreateObject("Info")
INFO.pushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "200052_RDO1", "0"

