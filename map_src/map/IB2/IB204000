RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	SCREEN.ClearAll 0, 2
	send_f

End Sub

Sub send_f()
	focus.Text = "1"

	indx.Data = "0000"
	b_next.Enable = True
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		mkcd.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		mkcd.Data =  "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		mkcd.Data =  "3"
	End If

Else

End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Select Case focus.Text
	Case "1"	b_send.SetFocus()
	Case "2"	b_next.SetFocus()
	Case "3"	c_sjgb.SetFocus()
End Select

If indx.Data = "0000" Then
	b_next.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(c_sjgb)
_AW_ONCHANGE_AW_
focus.Text = "3"
indx.Data = "0000"
b_next.Enable = True
grid_r.Clear()
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(grid_r)
_AW_ONDBLCLK_AW_
Dim code

If grid_r.HitPos = 3 Then
	code = grid_r.GetGridCell(grid_r.row, 3)
	If Trim(code) <> "" Then
		S1301.Data = code
		S1301.Trigger "", True
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_next)
_AW_ONCLICK_AW_
focus.Text = "2"
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
send_f
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To grid_l.Rows
	str = str & Right(Trim(grid_l.GetGridCell(i, 1)), 6)
	str = str & vbTab
	str = str & Trim(grid_l.GetGridCell(i, 4))
	str = str & vbLf
Next

For i = 1 To grid_r.Rows
	str = str & Right(Trim(grid_r.GetGridCell(i, 1)), 6)
	str = str & vbTab
	str = str & Trim(grid_r.GetGridCell(i, 4))
	str = str & vbLf
Next

If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, grid_l.Rows+grid_r.Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(grid_l)
_AW_ONDBLCLK_AW_
Dim code

If grid_l.HitPos = 3 Then
	code = grid_l.GetGridCell(grid_l.row, 3)
	If Trim(code) <> "" Then
		S1301.Data = code
		S1301.Trigger "", True
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
Change_MKGubn_Main(cxMarket.sMarket)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



