RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Const R_TCNT = 6
Const R_UNIT = 10
Const DNIMG = "_DN.bmp"
Const HVIMG = "_EN.bmp"
Const UPIMG = ".bmp"
Dim strExpr
Dim ii
Dim check
Dim status
Dim mscd, gubn
'Radio Button 처리
Sub ControlRBtn(iNum, radFlag)
	Dim WHIMG

	For ii=0 To R_TCNT
		'strExpr = "BUTTON" & R_UNIT*(ii+1) & ".text=" & Chr(34) & "투자자별" & "0" & (ii+2)
		If ii = CLng(iNum) Then
		   If (ISGRAPH.Text = "G") And (CLng(lblRBtnNo.Text) = CLng(iNum)) Then
	            ISGRAPH.Text = "T"
		   Else
		   		Select Case iNum
	   			Case 1 : mscd = "0"
	   			Case 2 : mscd = "27"
	   			Case 3 : mscd = "50"
	   			Case 4 : mscd = "50"
	   			Case 5 : mscd = "42"
	   			Case 6 : mscd = "43"
	   			End Select
	   			If SCREEN.Object("main.stock").data = 1 Then
	   				gubn = "1"
	   			Else
	   				gubn = "0"
	   			End If

		   		If status = "0" Then
		   			obj2.SetObject("IB290812")
		   			SCREEN.Object("obj2.mscd").Data = mscd
		   			SCREEN.Object("obj2.gubn").Data = gubn
		            ISGRAPH.Text = "G"
		        Else
		         	SCREEN.CreateWindow 4, "IB290812 /t/s/p5/d", _
		         		"mscd" & vbTab & mscd & vbLf & _
		         		"gubn" & vbTab & gubn & vbLf
		         	ISGRAPH.Text = "G"
		        End If
				'		strExpr = strExpr & DNIMG
			End If
		Else
				'strExpr = strExpr & UPIMG
		End If
	'	strExpr = strExpr & Chr(34)

		'execute strExpr
	Next

	lblRBtnNo.Text = iNum

	'obj2.Send
End Sub


Sub objgubn(val)
OBJECT0.Visible = False
	If val <> "" Then
		Select Case val
		Case "49"
			LABEL6.Text = "주식선물"
			If SCREEN.Object("main.future").data = 1 Then
				obj3.SetObject "IB290881"
			ElseIf SCREEN.Object("main.future").data = 2 Then
