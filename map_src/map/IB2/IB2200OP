'	drChart.ChangeMinorFID "610"    '일,주,월 차트
	e_gubn.Data = gubn  '파일저장용

	'SYSTEM.Trace "Query_chart STEP1 gubn : " & e_gubn.Data & " gubn1 : " & gubn
	'SYSTEM.Trace "Query_chart STEP2 unit : " & unit

	Select Case gubn
		Case 1
			Call change_chart(1)
			Call Bt_Period_Set()
			S101308.Data = "01"       '101308 = 일,주,월 구분 Symbol
			b_day.PRgb = 37736184
			'b_day.Visible = False
		Case 2
			Call change_chart(2)
			Call Bt_Period_Set()
			S101308.Data = "02"
			b_week.PRgb = 37736184
			'b_week.Visible = False
		Case 3
			Call change_chart(3)
			Call Bt_Period_Set()
			S101308.Data = "03"
			b_mon.PRgb = 37736184
		Case 4
			'SYSTEM.Trace "Query_chart STEP3"
			Call Bt_Gap_Init()
			Call Set_bgk_Color(unit)
			Call change_chart(4)
			'SYSTEM.Trace "Query_chart STEP4"


			'drChart.ChangeMinorFID "510"  '분 차트
			mtgubn.data = 1

			b_min.PRgb = 37736184
			'b_min.Visible = False
		Case 5
			Call Bt_Gap_Init()
			Call Set_bgk_Color(unit)
			Call change_chart(5)



			mtgubn.data = 2

			b_tick.PRgb = 37736184
			'b_tick.Visible = False
		Case Else
			Exit Sub
	End Select
'	SCREEN.Send 0
End Sub

Sub Set_bgk_Color(unit)

	If e_gubn.Data = 4 Then
		bungap.Data = unit
	ElseIf e_gubn.Data = 5 Then
		tickgap.Data = unit
	End If


	'SYSTEM.Trace "Set_bgk_color gap unit : " & unit
	Select Case unit       '해당 Gap 버튼만 눌림표시
		Case 1
			g_gunit = "001"
			COMBO0.Data = "001"
			b_1.PRgb = 37736184

		Case 5
			g_gunit = "005"
			COMBO0.Data = "005"
			'b_5.Visible = False
			b_5.PRgb = 37736184
		Case 10
			g_gunit = "010"
			COMBO0.Data = "010"
			'b_10.Visible = False
			b_10.PRgb = 37736184
		Case 30
			g_gunit = "030"
			COMBO0.Data = "030"
			'b_30.Visible = False
			b_30.PRgb = 37736184
		Case Else
			g_gunit = l_format(unit, "0", 3)
			COMBO0.Data = g_gunit
			'Exit Sub
	End Select
End Sub

Sub Set_Gap(unit)
	'SYSTEM.Trace "Set_Gap START!!!"
	S101308.Data = unit       '101308 = 분,틱일 경우 Gap 조절 Symbol

	If e_gubn.Data = 4 Then
		bungap.Data = unit
	ElseIf e_gubn.Data = 5 Then
		tickgap.Data = unit
	End If

	Call Bt_Gap_Init()
	'SYSTEM.Trace "Set_gap unit : " & unit & " bungap.Data : " & bungap.Data
	Select Case unit       '해당 Gap 버튼만 눌림표시
		Case 1
			g_gunit = "001"
			COMBO0.Data = "001"
			SYSTEM.Trace "set_gap unit 1"
			b_1.PRgb = 37736184
			'b_1.Visible = False
		Case 5
			g_gunit = "005"
			'b_5.Visible = False
			COMBO0.Data = "005"
			b_5.PRgb = 37736184
		Case 10
			g_gunit = "010"
			'b_10.Visible = False
			COMBO0.Data = "010"
			b_10.PRgb = 37736184
		Case 30
			g_gunit = "030"
			COMBO0.Data = "030"
			'b_30.Visible = False
			b_30.PRgb = 37736184
		Case Else
			SYSTEM.Trace "Set_gap unit : " & unit
			g_gunit = l_format(unit, "0", 3)
			'Exit Sub
	End Select
	Call Query_Chart(g_gubn, unit)
End Sub

Sub Bt_Period_Set()
	b_1.Visible = False
	b_5.Visible = False
	b_10.Visible = False
	b_30.Visible = False
	COMBO0.Visible = False
End Sub

Sub Bt_Period_Init()
	b_day.PRgb = 208
