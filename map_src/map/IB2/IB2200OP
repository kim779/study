Sub change_chart(key)
	'	drChart.DelAllBozoMsg()'
	'	drChart.AddBozoMsg 1, "UD", key


	Dim inputData

	Dim    cod2 	'[15];            종목코드
	Dim    sDate 	'[8];             검색시작일
	Dim    nrec		'[4];             조회건수
	Dim    unit		'[3];             조회단위 1분봉, 3분봉
	Dim    gubn		'[1];             조회구분
					'				  0 : 틱, 1 : 분, 2 : 일
					'				  3 : 주, 4 : 월
	Dim    egbn		'[1];             수정주가 구분
	Dim    smod		'[1];             조회모드
	Dim    nkey		'[23];      Next Key
	Dim    bgbn		'[1];             허봉, 실봉구분
					'				  0: 허봉 1: 실봉
	Dim    dgbn		'[1];             당일 구분
	Dim    temp
	CStr   str
	Select Case key
			Case 1 gubn = "2"
			Case 2 gubn = "3"
			Case 3 gubn = "4"
			Case 4 gubn = "1"
			Case 5 gubn = "0"
			End Select
	g_gubn = key
	cod2 = SCREEN.Object("main.ed_focod").data & "       "
	sDate = "        "
	temp = request_count.Text
	nrec=Trim(temp)

	SYSTEM.Trace "nrec[" & nrec & "]"

	If(Len(nrec)=3) Then
	    str = " "
		nrec = str & nrec
	End If
	If(Len(nrec)=2) Then
	    str = "  "
		nrec = str & nrec
	End If
	If(Len(nrec)=1) Then
	    str = "   "
		nrec = str & nrec
	End If

	If(Len(nrec)=0) Then
		nrec = " 120"
		request_count.Data = 120
	End If

	unit = g_gunit
	'gubn = "2"
	egbn = "1"
	smod = "1"
	nkey = "                       "
	bgbn = "1"
	dgbn = "0"

	'SYSTEM.Trace "change_chart unit : " & unit & " g_unit : " & g_gunit
	'drChart.SetSubMsg "UM", "E"
	inputData = cod2 & sDate & nrec & unit & gubn & egbn & smod & nkey & bgbn & dgbn

	Dim szTR
	szTR = "pibf0041"
	drChart.SendTr szTR, SCREEN.Object("main.ed_focod").data, inputData,1

End Sub

