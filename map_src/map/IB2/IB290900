RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const MYFILE = "userconf.ini"
Const MYMAP = "IB290900"

Dim startFlag
startFlag = "0"

Sub p_write_ini()
	If SCREEN.CreateObject("Info") Then
		Dim saveGugn

		If quantityRadio.Checked = True Then
			saveGubn = "수량"
		Else
			saveGubn = "금액"
		End If

		INFO.PushData LOGIN.Name, MYFILE, MYMAP, "view", Trim(gubnBtn.Text)
	  	INFO.PushData LOGIN.Name, MYFILE, MYMAP, "gubn", saveGubn

	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
		Dim tmpView, tmpGubn

		tmpView = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "view"))

		If tmpView = "차트" Then
			gubnBtn.Text = tmpView
			obj_data.SetObject "IB290910"
		ElseIf tmpView = "데이터" Then
			gubnBtn.Text = tmpView
			obj_data.SetObject "IB290920"
		Else
			gubnBtn.Text = "차트"
			obj_data.SetObject "IB290910"
		End If

		tmpGubn = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "gubn"))

		If tmpGubn = "수량" Then
			quantityRadio.Checked = True
			Call ChangeColName(False)
		ElseIf tmpGubn = "금액" Then
			amtRadio.Checked = True
			Call ChangeColName(True)
		Else
			quantityRadio.Checked = True
			Call ChangeColName(False)
		End If

		startFlag = "1"
		Send_OBJ1()
	End If
End Sub

Sub SetView()
	If gubnBtn.Text = "차트" Then
		gubnBtn.Text = "데이터"
		obj_data.SetObject "IB290920"
	ElseIf gubnBtn.Text = "데이터" Then
		gubnBtn.Text = "차트"
		obj_data.SetObject "IB290910"
	Else
		gubnBtn.Text = "데이터"
		obj_data.SetObject "IB290920"
	End If

	Send_OBJ1()

	If quantityRadio.Checked Then
		Call ChangeColName(False)
	Else
		Call ChangeColName(True)
	End If

End Sub

Sub ChangeColName(bAmt)
	If bAmt Then
		SCREEN.Object("obj_data.Grid0").SetHead 6, "기관|매도금액"
		SCREEN.Object("obj_data.Grid0").SetHead 7, "기관|매수금액"
		SCREEN.Object("obj_data.Grid0").SetHead 8, "기관|순매수금액"
		SCREEN.Object("obj_data.Grid0").SetHead 9, "외국인(장내거래)|매도금액"
		SCREEN.Object("obj_data.Grid0").SetHead 10, "외국인(장내거래)|매수금액"
		SCREEN.Object("obj_data.Grid0").SetHead 11, "외국인(장내거래)|순매수금액"
	Else
		SCREEN.Object("obj_data.Grid0").SetHead 6, "기관|매도수량"
		SCREEN.Object("obj_data.Grid0").SetHead 7, "기관|매수수량"
		SCREEN.Object("obj_data.Grid0").SetHead 8, "기관|순매수수량"
		SCREEN.Object("obj_data.Grid0").SetHead 9, "외국인(장내거래)|매도수량"
		SCREEN.Object("obj_data.Grid0").SetHead 10, "외국인(장내거래)|매수수량"
		SCREEN.Object("obj_data.Grid0").SetHead 11, "외국인(장내거래)|순매수수량"
	End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	Send_OBJ()
End Sub


Sub Send_OBJ()
	cxMarket.sCode = Trim(S1301.Data)
	obj_hnam.Send
	obj_data.Send
End Sub

Sub Send_OBJ1()
	cxMarket.sCode = Trim(S1301.Data)
	obj_data.Send
End Sub

Sub Send_OBJ2()
	cxMarket.sCode = Trim(S1301.Data)
	obj_hnam.Send
End Sub

_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major


Call p_read_ini()

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
Call p_write_ini()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(1301)
_AW_ONCHANGE_AW_
Dim jmNm
jmNm = SCREEN.GetName(100, Trim(S1301.Data), 0)

If Trim(jmNm) <> "" Then
	S1301.Trigger "", True
	Send_OBJ2()

	If startFlag = "1" Then
		Send_OBJ1()
	End If
Else
	SCREEN.ClearAll 0, 2
	obj_data.ClearAll 2
End If

S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(codeSearchBtn)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, 1301, "hnam", 0 )

If retn = True Then
	Send_OBJ()
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ctrl_Catetory)
_AW_ONCLICK_AW_
Dim codx
codx = ctrl_Catetory.GetPreCode(S1301.Data)
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

Send_OBJ()

gubnBtn.SetFocus
S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ONDBLCLK_AW_
Dim codx
codx = ctrl_Catetory.GetNextCode(S1301.Data)
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

Send_OBJ()

gubnBtn.SetFocus
S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ONCHANGE_AW_
Dim codx
codx = ctrl_Catetory.GetCurCode()
If Trim(codx) = "" Then
	Exit Sub
End If
S1301.Data = codx
S1301.Trigger "",True

Send_OBJ()

gubnBtn.SetFocus
S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON1)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB202201 /t/s/p5/d", "appendCODE" & _
			vbTab & S1301.Data & vbLf
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(amtRadio)
_AW_ONCLICK_AW_
Send_OBJ1()
Call ChangeColName(True)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(quantityRadio)
_AW_ONCLICK_AW_
Send_OBJ1()
Call ChangeColName(False)
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(endDt)
_AW_ONCHANGE_AW_
Send_OBJ1()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(gubnBtn)
_AW_ONCLICK_AW_
Call SetView()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Send_OBJ1()
S1301.SetFocus
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON3)
_AW_ONCLICK_AW_
SCREEN.CreateWindow 1, "IB240300 /t /s /p5", ""
'SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
Send_OBJ()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



