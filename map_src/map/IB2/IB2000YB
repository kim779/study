RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim grd_click
Dim bFlag
Dim g_ArrData
Dim g_BefCurIndex
Dim g_Index
Dim index
Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)

index = 0
grd_click = 0
bFlag = False
g_ArrData = Array(Array(S200401, S200402, S200403, S200405, S200404),_
	Array(S200458, S200459, S200460, S200462, S200461))
g_BefCurIndex = 1
g_Index = 1
'------------------------------------------------------------------------
Sub COMBOChange()
	grd_click = 0
	If rd_CurDate.Checked Then
		For i = LBound(g_ArrData(0)) To UBound(g_ArrData(0))
			g_ArrData(0)(i).Visible = True
			g_ArrData(1)(i).Visible = False
		Next
		g_ArrData(0)(g_Index - 1).Checked = True
	Else
		For i = LBound(g_ArrData(0)) To UBound(g_ArrData(0))
			g_ArrData(0)(i).Visible = False
			g_ArrData(1)(i).Visible = True
		Next
		g_ArrData(1)(g_Index - 1).Checked = True
	End If
End Sub

Sub Setradio(gubn, field)
	'SYSTEM.Trace "setradio ======== "& gubn &", "& field
	g_index = field
	If gubn = 2 Then
		Select Case field
			Case "1"
				S200458.Checked = True
			Case "2"
				S200459.Checked = True
			Case "3"
				S200460.Checked = True
			Case "4"
				S200462.Checked = True
			Case "5"
				S200461.Checked = True
		End Select
	Else
		Select Case field
			Case "1"
				S200401.Checked = True
			Case "2"
				S200402.Checked = True
			Case "3"
				S200403.Checked = True
			Case "4"
				S200405.Checked = True
			Case "5"
				S200404.Checked = True
		End Select
	End If
End Sub

