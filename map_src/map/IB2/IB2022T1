_AW_ONDECLARE_AW_
Sub OnGroup(group)
	S90303.Clear()
	If SCREEN.CreateObject("DX_INTEREST") = False Then
		Exit Sub
	End If

	If Trim(group) <> "" Then
		If InStr(group, "00") > 0 Then
			SCREEN.SetTimer 4, False
		Else
			codelist = DX_INTEREST.LoadCodeList(group)
			row = 1
			Do While Len(codelist) > 0
				parseData = Mid(codelist, 1, InStr(codelist, vbTab) -1)
				codelist = Mid(codelist, InStr(codelist, vbTab) + 1)
				S90303.InsertRow(-1)
				S90303.SetGridCell S90303.rows, 2, parseData
	'			S90303.SetGridCell row, 2, parseData
				row = row + 1
			Loop
			SCREEN.Send 0
		End If
	End If
End Sub

Sub OnPredict(bNowPrice)
	If bNowPrice = "0" Then
		predict = True
	Else
		predict = False
	End If
	S90303.SetColumnVisible 8, predict
	S90303.SetColumnVisible 10, predict
	S90303.SetColumnVisible 12, predict
    S90303.SetColumnVisible 14, predict

	S90303.SetColumnVisible 7, Not predict
	S90303.SetColumnVisible 9, Not predict
	S90303.SetColumnVisible 11, Not predict
    S90303.SetColumnVisible 13, Not predict
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S90308.Data = S90303.rows

For ii=1 To S90303.Rows
	S90303.SetGridCell ii, 5, ""
	S90303.SetGridCell ii, 18, ""
Next

If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
	If SCREEN.Object("main.cxMarket").sMarket = "KRX" Then
		S90777.Data = "1"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "NXT" Then
		S90777.Data = "2"
	ElseIf SCREEN.Object("main.cxMarket").sMarket = "통합" Then
		S90777.Data = "3"
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim group
group = Trim(SCREEN.Object("parent.intercombo").data)

If InStr(group, "00") <> 0 Then
	Call deleteRow()
End If

If Trim(arrangeOK.data) = 0 Then
	data = Trim(SCREEN.Object("parent.arrange").data)
	setArrange2(data)
End If

For ii=1 To S90303.Rows
	data = Trim(S90303.GetGridCell(ii, 18))

	If data <> "" Then
		S90303.SetGridCell ii, 5, "추"
	End If
Next

S90303.SetFocus

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call SettingRemain(0)

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(90303)
_AW_ONCLICK_AW_


If S90303.HitPos = 3 Then
	S1301.DATA = S90303.GetGridCell(S90303.Row, 2)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	If Len(Trim(S90303.GetGridCell(S90303.index+1, 2))) > 6 Then
		Exit Sub
	End If

	If S90303.Column = 5 Then
		Call newsClick()

		data = Trim(S90303.GetGridCell(S90303.Row, 18))
		If data <> "" Then
			S90303.SetGridCell S90303.Row, 5, "추"
		End If
	End If

	S1301.Trigger "1301", True
	S1301.Trigger "1301", False
ElseIf S90303.HitPos = 4 Then
	Dim ii, res

	For ii=1 To S90303.Rows
		S90303.SetGridCell ii, 5, ""
		S90303.SetGridCell ii, 4, ""
		S90303.SetGridCell ii, 3, ""

		res = ii Mod 2

		If res = 0 Then
			S90303.SetPRgb ii, 5, 77
		Else
			S90303.SetPRgb ii, 5, 68
		End If

		data = Trim(S90303.GetGridCell(ii, 18))

		If data <> "" Then
			S90303.SetGridCell ii, 5, "추"
		End If
	Next
End If
