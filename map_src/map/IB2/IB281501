Function chk_onesect(maxobj, minobj, val)
	chk_onesect = 0
	max = Trim(maxobj.Data)
	min = Trim(minobj.Data)
	If CDbl(max) = 0 Then
		max = val
		maxobj.Data = val
	End If
	If CDbl(min) = 0 Then
		min = val
		minobj.Data = val
	End If

	If CDbl(max) < CDbl(val) Then
		chk_onesect = 1
		maxobj.Data = val
	ElseIf CDbl(min) > CDbl(val) Then
		chk_onesect = 2
		minobj.Data = val
	End If
End Function

Function chk_section(nrow, maxcnum, mincnum, val)
	chk_section = 0
	max = Trim(pgrid.GetGridCell(nrow, maxcnum))
	min = Trim(pgrid.GetGridCell(nrow, mincnum))
	If CDbl(max) = 0 Then
		max = val
		pgrid.SetGridCell nrow, maxcnum, val
	End If
	If CDbl(min) = 0 Then
		min = val
		pgrid.SetGridCell nrow, mincnum, val
	End If

	If CDbl(max) < CDbl(val) Then
		chk_section = 1
		pgrid.SetGridCell nrow, maxcnum, val
	ElseIf CDbl(min) > CDbl(val) Then
		chk_section = 2
		pgrid.SetGridCell nrow, mincnum, val
	End If
End Function

