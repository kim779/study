Function TimeDiff(ATime, BTime)
	AHour = ATime \ 10000
	AMin = (ATime Mod 10000) \ 100
	ASec = ATime Mod 100
	ASecTime = AHour*3600 + AMin*60 + ASec

	BHour = BTime \ 10000
	BMin = (BTime Mod 10000) \ 100
	BSec = BTime Mod 100
	BSecTime = BHour*3600 + BMin*60 + BSec

	RSecTime = BSecTime - ASecTime
	If (RSecTime < 0) Then
		TimeDiff = 0
	Else
		TimeDiff = (RSecTime\3600)*10000 + ((RSecTime Mod 3600)\60)*100 + RSecTime Mod 60
	End If

End Function
