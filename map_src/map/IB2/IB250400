Sub OnGridClickedXX(strdata)

	Dim arr
	arr = Split(strdata, vbTab, -1, 0)

	S1301.DATA = S207300.GetGridCell(CInt(arr(2)) + 1, 2)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.DATA
End Sub

Sub OnGridDragClickedXX(strdata)

	Dim scode
	scode = Split(strdata, vbTab, -1, 0)

	S1301.DATA = scode(1)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If

	S1301.Trigger "", False
	S1301.Trigger "", True
	SYSTEM.SetHistory "1301", S1301.DATA

