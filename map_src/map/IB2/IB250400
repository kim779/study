		Case "001"		'KOSPI
			upgb.DATA = r_upgb
		Case "101"		'KOSPI200
			upgb.DATA = r_upgb
		Case "201"		'KOSDAQ
			upgb.DATA = r_upgb
		Case "301"		'KOSDAQ50
			upgb.DATA = r_upgb
		Case "303"		'KOSTAR
			upgb.DATA = r_upgb
		Case "401"		'KOSPI100
			upgb.DATA = r_upgb
		Case "501"		'KONEX
			upgb.DATA = r_upgb
		Case "888"		'ELW
			upgb.DATA = r_upgb
		Case "889"
			upgb.Data = r_upgb
		Case Else
		   S20301.DATA = "001"
		   upgb.DATA = "001"
	End Select
If upcd_flg = 1 Then
	upcd_flg = 2
Else
	Call p_write_com()
	SCREEN.Send 0
End If
	SCREEN.IgnoreChange False
End If
