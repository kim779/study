{


_AW_ONDECLARE_AW_
Dim start_f

start_f = False

Dim upcd_flg
upcd_flg = 1

Const myFILE = "userconf.ini"
Const myMAP = "IB240700"

Sub p_write_com()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "COMBO1", S200901.Data

End If
End Sub

Sub p_read_com()
If SCREEN.CreateObject("Info") Then
 	S200901.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COMBO1"))
End If

If Len(Trim(S200901.data)) = 0 Then
	S200901.data = "001"
	c_upgb.DATA = "001"
End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major


'c_upgb.Pop("c_upgb")
'S200901.Pop("200901")
'SYSTEM.Trace(S200901.Data)

SCREEN.SetTimer 1, True		'ResizableEx인 경우 vrow값 서버에 제대로 올려주기위해
							'화면이 다 뜬 상태에서 send

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If start_f = False Then
	SCREEN.OnSend = False
	Exit Sub
End If

S200331.Data = "0"
If S200999.CHECKED = True Then
	S200331.data = "1"
	strHead = "순매수량"
Else
	S200331.data = "2"
	strHead = "순매도량"
End If

For ii = 0 To S215300.Columns
	If S215300.GetColumnName(ii) = "215001" Then
		S215300.Column = ii
		S215300.SetHead ii, strHead
		Exit For
	End If
Next

If cxMarket.sMarket = "KRX" Then
	S200777.DATA = "1"
ElseIf cxMarket.sMarket = "NXT" Then
	S200777.DATA = "2"
ElseIf cxMarket.sMarket = "통합" Then
	S200777.DATA = "3"
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If S200301.Data = 1 Then
	S215300.SetFocus
	S215300.INDEX = 0
ElseIf S200301.Data = "-1" Then
	S215300.SetFocus
	S215300.INDEX = S215300.Rows-1
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
start_f = True
Call p_read_com()
SCREEN.Send 0

