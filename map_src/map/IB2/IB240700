Dim i, str
str = ""
For i = 1 To S215300.Rows
	str = str & Right(Trim(S215300.GetGridCell(i, 3)), 6) & vbTab
	str = str & Trim(S215300.GetGridCell(i, 4)) & vbLf
Next

If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, S215300.Rows
End If
