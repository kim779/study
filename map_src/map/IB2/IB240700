_AW_SCRIPT_AW_(UBUT)
_AW_ONCLICK_AW_
Dim retn

Select Case c_upgb.Data
	Case "001", "101", "401"		'KOSPI, KOSPI200, KOSPI100
		retn = SCREEN.GetCode(104, "200901", "20022", 0)
	Case "201"							'KOSDAQ
		retn = SCREEN.GetCode(104, "200901", "20022", 9)
End Select


If (retn <> True) Then
	S200901.SetFocus
	Exit Sub
Else
	S200901.SetFocus
	SCREEN.Send 2
End If
