RESOURCE DIVISION
{


_AW_ONINDECLARE_AW_
#load IB888888
#load IB999901

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
S1301.Data = SYSTEM.GetHistory(False, 1301)
'SCREEN.Send 0

SCREEN.SetTimer 5, False
'------

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
S1301.Data = SCREEN.object("main.1301").Data
If Len(Trim(S1301.Data)) <> 6 Then
	SCREEN.OnSend False
End If
If trg_ac.Data = "1" Then
	SCREEN.SetTimer 10, False
	SCREEN.OnSend = False
Else
	SCREEN.OnSend = True
End If


If mkcd.Data = "2" Then
	S1301.Data = "N." & S1301.Data
ElseIf mkcd.Data = "3" Then
	S1301.Data = "M." & S1301.Data
End If 

SetMKGubn777()
SYSTEM.Trace "[MKGUBN][IB2000XB][pino2702][OnSend] 섹터탭 mkcd = " & mkcd.Data
SYSTEM.Trace "[MKGUBN][IB2000XB][pino2702][OnSend] 섹터탭 S1301 = " & S1301.Data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
GRID1.Row = 1
If GRID1.GetGridCell(1, 1) <> "  " Then
	SCREEN.Object("OBJ1.tmcd").data = GRID1.GetGridCell(1, 1)
	OBJ1.send
Else
	ssjm.Clear
	SCREEN.Object("OBJ1.grid2").clear
End If


Dim ii, str, items
For ii = 1 To GRID1.Rows
	str = Trim(GRID1.GetGridCell(ii, 2))

	items = items & vbTab & str
Next

TMCB.SetItems(items)

S1301.SetFocus

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If trg_ac.Data = "0" Then
	SCREEN.Send 0
Else
	trg_ac.Data = "0"
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim i, str
str = ""
For i = 1 To SCREEN.Object("OBJ1.GRID2").Rows
	str = str & Trim(SCREEN.Object("OBJ1.GRID2").GetGridCell(i, 2))
	str = str & vbTab
	str = str & Trim(SCREEN.Object("OBJ1.GRID2").GetGridCell(i, 3))
	str = str & vbLf
Next
If Len(Trim(str)) > 0 Then
	SYSTEM.SetAutoCode str, SCREEN.Object("OBJ1.GRID2").Rows
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(TMCB)
_AW_ONCHANGE_AW_
SCREEN.Object("OBJ1.tmcd").data = GRID1.GetGridCell(TMCB.Index +1 , 1)
OBJ1.send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(trg_ac)
_AW_ONCHANGE_AW_
'SYSTEM.Trace "trg_ac: " & trg_ac.Data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID1)
_AW_ONCLICK_AW_
If GRID1.HitPos = 3 Then
	SCREEN.Object("OBJ1.tmcd").data = GRID1.GetGridCell(GRID1.Row, 1)
	OBJ1.send
End If

'-----
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



