_AW_SCRIPT_AW_(62303)
_AW_ONCHANGE_AW_
Dim   r_upgb

SCREEN.IgnoreChange True
	r_upgb = P_GetBigCd(S62303.Data)
	Select Case r_upgb
		Case "001"		'KOSPI
			S62302.DATA = "00"
			SYMBOL2.Enable = True
		Case "101"		'KOSPI200
			S62302.DATA = "10"
			S62303.Data = "101"
			SYMBOL2.Enable = False
		Case "201"		'KOSDAQ
			S62302.DATA = "90"
			SYMBOL2.Enable = True
		Case Else
			S62303.Data = "001"
			S62302.DATA = "00"
			SYMBOL2.Enable = True
	End Select
SCREEN.IgnoreChange False




SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


