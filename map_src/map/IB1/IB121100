Sub EachBtnEnable()
	Dim bool, ii, tmpAccn, flag
	flag = "N"

	For ii = 0 To 4
		tmpAccn = SCREEN.Object("preAccn_" & ii).Text

		If Trim(AN10.Data) = Trim(tmpAccn) Then
			flag = "Y"
			Exit For
		End If
	Next

	If flag = "N" Then
		isInitial.Text = "False"
		bool = False
	Else
		isInitial.Text = "True"
		bool = True
	End If

	send_btn.Enable = bool

	If bool = False Then
		next_btn.Enable = bool
	End If

	Select Case UTAB1.ID
	Case 2 SCREEN.Object("OBJECT1.BUTTON0").Enable = bool
	Case 1 SCREEN.Object("OBJECT1.BUTTON1").Enable = bool
	Case 6 SCREEN.Object("OBJECT1.BUTTON2").Enable = bool
	Case 5 SCREEN.Object("OBJECT1.BUTTON2").Enable = bool
	End Select

	SCREEN.Object("OBJECT2.BUTTON0").Enable = bool
End Sub

Sub checkInitial()
	Dim ii, tmpAccn, tmpPreAccn

	For ii = 0 To 4
		tmpAccn = "accn1211_" & ii
		tmpPreAccn = "preAccn_" & ii

		If Trim(SYSTEM.Pop(tmpAccn)) <> "" Then
			SCREEN.Object(tmpPreAccn).Text = Trim(SYSTEM.Pop(tmpAccn))
		End If
	Next

	Call EachBtnEnable()
End Sub

