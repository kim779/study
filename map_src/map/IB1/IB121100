Function initialCheck()
	initialCheck = False

	Dim ii, tmpAccn, tmpCnt

	For ii = 0 To 4
		tmpCnt = "accn1211_" & ii
		SCREEN.Object("preAccn_" & ii).Text = Trim(SYSTEM.Pop(tmpCnt))
	Next

	For ii = 0 To 4
		tmpCnt = "accn1211_" & ii
		tmpAccn = SCREEN.Object("preAccn_" & ii).Text

		If Trim(AN10.Data) = Trim(tmpAccn) Then
			initialCheck = True
			Exit Function
		End If
	Next

	initialCheck = False
End Function

Sub SetInicialAccn()
	Dim ii, tmpAccn, tmpCnt

	For ii = 0 To 4
		tmpCnt = "accn1211_" & ii
		tmpAccn = Trim(SYSTEM.Pop(tmpCnt))

		If Trim(tmpAccn) = Trim(AN10.Data) Then
			Exit For
		End If

		If tmpAccn = "" Then
			SYSTEM.Push tmpCnt, Trim(AN10.Data)
			Exit For
		End If

		If ii = 4 And tmpAccn <> "" Then
			SYSTEM.Push "accn1211_0", Trim(AN10.Data)
		End If
	Next

	For ii = 0 To 4
		tmpCnt = "accn1211_" & ii
		SCREEN.Object("preAccn_" & ii).Text = Trim(SYSTEM.Pop(tmpCnt))
	Next
End Sub

