_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ANCM.Data = AN20.Name
	zpwd.Data = AN20.Password
	If Trim(AN20.Data) = "" Then
		AN20.SetFocus
		Exit Sub
	End If
	If Trim(zpwd.Data) = "" Then
		zpwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	If SYSTEM.ConnectBy = "0" And Trim(zpwd.Data) = "" Then
	   zpwd.Data = "9999"
	End If

	If CheckInput(AN20, zpwd) = True Then
	Else
		SCREEN.ClearAll 2, 2
		ANCM.Data = AN20.Name
		zpwd.SetFocus
		Exit Sub
	End If

	OGRID.Clear

	obj1.Send

End Sub


Sub SetSellQty(code, qty)	'청산수량세팅
	Dim ii, codeGrid

	For ii=1 To OGRID.Rows
		codeGrid = Trim(OGRID.GetGridCell(ii,1))

		If codeGrid = code Then
			OGRID.SetGridCell ii, 4, qty
			Exit For
		End If
	Next
End Sub

Sub SetGrid(data)

	Dim parseData, col

	OGRID.InsertRow(-1)

'	SYSTEM.Trace "sendGriddata dataset : " & data

	For col = 1 To 9
		parseData  = Mid(data, 1, InStr(data, "#") -1)
		data = Mid(data, InStr(data, "#") + 1)

'		SYSTEM.Trace "SetGrid InStrdata : " & "[" & OGRID.Rows & "]" & "[" & col & "]" & InStr(data, vbTab)
'		SYSTEM.Trace "SetGrid parseData : " & parseData

		If col = 5 Or col = 8 Then
			If Trim(parseData) <> "" Then
				parseData = FormatNumber(parseData, 2, -1, 0, 0)
			End If

		End If

		If col <> 4 Then
			OGRID.SetGridCell OGRID.Rows, col, parseData
		End If

		If col = 8 Then
			If OGRID.GetGridCell(OGRID.Rows, col) > 0 Then
				OGRID.SetTRgb OGRID.Rows, col, 94
			End If

		End If
	Next

	'평가손익
	OGRID.SetGridCell OGRID.Rows, 10, data
End Sub


