Sub CalKospi()
	Dim ii, sum, kp
	sum = 0

	For ii = 1 To GRID0.Rows
		kp = Trim(GRID0.GetGridCell(ii, 11))
		sum = sum + kp
	Next

	kospisum.Data = FormatNumber(sum, 2, -1, 0, 0)

	If kospisum.Data > 0 Then
		kospisum.TRgb = 94
	ElseIf kospisum.Data < 0 Then
		kospisum.TRgb = 95
	ElseIf kospisum.Data = 0 Then
		kospisum.TRgb = 130
	End If
End Sub


Sub p_write_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim sort
		sort = ""

		If sortR_asc.Checked = True Then
			sort = "asc"
		Else
			sort = "dsc"
		End If

		INFO.PushData LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "sort", sort
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") = True Then
		Dim sort
		sort = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "sort"))

		If sort = "" Then
			sort = "asc"
		End If

		If sort = "asc" Then
			sortR_asc.Checked = True
		Else
			sortR_dsc.Checked = True
		End If
	End If
End Sub


Sub SetTermTp()
	Dim val

	If sortR_asc.Checked = True Then
		val = 0
	Else
		val = 3
	End If

	If RADIO0.Checked = True Then
		zStrDt.SetFormat "9999/99/99"
		zEndDt.SetFormat "9999/99/99"

		val = val + 1
	ElseIf RADIO1.Checked = True Then
		zStrDt.SetFormat "9999/99/99"
		zEndDt.SetFormat "9999/99/99"

		val = val + 2
	Else
		zStrDt.SetFormat "9999/99"
		zEndDt.SetFormat "9999/99"

	 	val = val + 3
	End If

	zQryTermTp.Data = val

	Call send_f()
End Sub

