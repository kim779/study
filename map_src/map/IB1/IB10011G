_AW_ONDECLARE_AW_
Dim start_f
start_f = 1

Sub OnAlert()
	Dim var, shogb
	If Trim(S2027.Data) = "" Then
		Exit Sub
	End If

	If Trim(S2027.Data) = 0 Then
		Exit Sub
	End If

	If Trim(S2321.Data) = "" Then
		Exit Sub
	End If

	If Trim(S2321.Data) = 0 Then
		Exit Sub
	End If

	var = S2027.Data / S2321.Data * 100
	S2403.Data = FormatNumber(var, 2)



	If ( SCREEN.Object("parent.OBJ_order.tab_order").ID = "1" Or SCREEN.Object("parent.OBJ_order.tab_order").ID = "2") Then
		shogb = SCREEN.Object("parent.parent.OBJ_order.OBJ_odr.shogb").data
		'If shogb = "05" Or Right(shogb,1) = "0" Then
		If shogb = "05" Or Right(shogb,1) = "0" Or shogb = "01" Then
			If SCREEN.Object("parent.OBJ_order.OBJ_odr.CHK_auto").Checked = True And SCREEN.Object("parent.OBJ_order.OBJ_odr.c_hogb").Checked = False  Then
				If SCREEN.Object("parent.OBJ_order.OBJ_odr.flash_fg").Data = 0 Then
					Select Case SCREEN.Object("parent.OBJ_order.OBJ_odr.cboPrice").Data
					Case "2025" : SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_jprc").Data = S2025.Data
					Case "2023" : SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_jprc").Data = S2023.Data
					Case "2026" : SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_jprc").Data = S2026.Data
					Case "2302" : SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_jprc").Data = S2302.Data
					Case "2303" : SCREEN.Object("parent.OBJ_order.OBJ_odr.ed_jprc").Data = S2303.Data
					End Select
					SCREEN.Proc "parent.OBJ_order.OBJ_odr.OBJ_JUNGSAN.CalcJungsan", ""
				End If
			End If
		End If
	End If

'	OBJECT1.SEnd
	Call Cal_rate()
End Sub


Sub Cal_rate()
'전일종가대비 시가 고가 저가 비율
If Trim(S2320.Data) <> "" Then

	If Trim(S2029.Data) = "" Then
		Exit Sub
	End If

	If Trim(S2030.Data) = "" Then
		Exit Sub
	End If

	If Trim(S2031.Data) = "" Then
		Exit Sub
	End If

	si_rate.Data = FormatNumber(((S2029.Data - S2320.Data) / S2320.Data) * 100, 2, 0, 0, 0)
	go_rate.Data = FormatNumber(((S2030.Data - S2320.Data) / S2320.Data) * 100, 2, 0, 0, 0)
	jeo_rate.Data = FormatNumber(((S2031.Data - S2320.Data) / S2320.Data) * 100, 2, 0, 0, 0)

	If Trim(si_rate.Data) > 0 Then
		si_rate.TRgb = "94"
	End If

	If Trim(go_rate.Data) > 0 Then
		go_rate.TRgb = "94"
	End If

	If Trim(jeo_rate.Data) > 0 Then
		jeo_rate.TRgb = "94"
	End If
End If
End Sub

