_AW_ONDECLARE_AW_
' 찾아라 드래곤볼
Sub find_avol()
	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	next_btn.Enable = False
	GRID0.SetDataPosition(0)
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'***************************************************************************
' DESC: 주문전 Error Check
'***************************************************************************
Function Error_check()
	Error_check = False
	If Trim(AN1A.Data) = "" Then
		SCREEN.Object("main.OBJ_order.AN1A").SetFocus
		Call guide_msg("계좌번호를 확인하십시오")
		Exit Function
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(zPwd.Data)) < 4 Then
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Call guide_msg("비밀번호를 확인하십시오")
			Exit Function
		End If
	End If
	Error_check = True
End Function

