'***************************************************************************
' DESC: 0보다큰 숫자형식인지 검사. 유효숫자( > 0):true else false
'***************************************************************************
Function Is_numeric(data)
	Dim number
	number = Trim(data)

	If number = "" Then
		number = 0
	End If

	Is_numeric = False
	If IsNumeric(number) = False Then
		Exit Function
	End If
	If CDbl(number) <= 0 Then
		Exit Function
	End If

	Is_numeric = True
End Function

'***************************************************************************
' DESC : Onalert()함수 : 주식평가금액, 주식평가손익, 주식수익률 계산
'***************************************************************************
Sub Onalert()
	Dim migm, tmigm, pggm, tpggm, pgsi, srat,ii,tmp, samt, tsamt

	tpggm = 0
	tmigm = 0
	tsamt = 0

	For ii = 0 To VIEWGRID.Rows
'		tmp = Trim(VIEWGRID.GetGridCell(ii, 2))
'		VIEWGRID.SetGridCell ii,16,Mid(tmp,2)

		migm = VIEWGRID.GetGridCell(ii, 10)				'매입금액의 합
		If Is_numeric(migm) = False Then
		   If Trim(migm) = "" Then
		   migm =0
		   Else
			migm = CDbl(migm)
			End If
		End If
		tmigm = tmigm + migm

		pggm = VIEWGRID.GetGridCell(ii, 11)				'평가금액의 합
		If Is_numeric(pggm) = False Then
			If Trim(pggm) = "" Then
			pggm = 0
			Else
			pggm = CDbl(pggm)
			End If
		End If
		tpggm = tpggm + pggm

		samt = VIEWGRID.GetGridCell(ii, 16)				'신용금액의 합
		If Is_numeric(samt) = True Then
			tsamt = tsamt + samt
		End If
	Next

	o_migm.Data = tmigm									'매입금액의 합
	o_pggm.Data = tpggm									'평가금액의 합

	o_pgsi.Data = tpggm - tmigm							'평가손익
	If o_pgsi.Data > 0 Then
		o_pgsi.Data = "+" & o_pgsi.Data
	End If

	If tmigm =< 0 Then									'손익률
		srat = 0
	Else
		srat = CCur((tpggm - tmigm) / tmigm * 100)
'		If cbo_type.Data = "1" Then
'			srat = CCur( (tpggm - tmigm) / (tmigm+tsamt) * 100)
'		Else
'			srat = CCur((tpggm - tmigm) / tmigm * 100)
'		End If
	End If

	o_srat.Data = srat

	If srat > 0 Then
		o_srat.Data = "+" & FormatNumber(srat,2,,-2) '&"%"
	Else
		o_srat.Data = "-" & FormatNumber(srat,2,,-2) '&"%"
	End If

'	If srat > 0 Then
'		o_srat.Data = "+" & srat '&"%"
'	Else
'		o_srat.Data = srat
'	End If
End Sub
