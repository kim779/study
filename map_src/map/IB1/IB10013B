Sub TaxRateSend()
	'SYSTEM.Trace "TaxRateSend() : " & AN1A.Data & vbTab & pswd.data
	SCREEN.Object("obj.account").data = AN1A.Data
	SCREEN.Object("obj.pswd").data = pswd.data
	obj.Send
End Sub

