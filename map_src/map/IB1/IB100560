Dim curr, cfgga

SCREEN.Proc "main.OBJ_sise.Query", ""

If Len(Trim(SCREEN.Object("main.ed_pswd").Data)) <> 4 Then
	SCREEN.Object("main.guide").Text = "비밀번호를 확인하세요."
	Exit Sub
End If

curr = Trim(SCREEN.Object("main.OBJ_chart.OBJ_sise.2023").Data)
cfgga = Trim(ed_jcfg.Data)

If IsNumeric(curr) = False Or IsNumeric(cfgga) = False Then
	Exit Sub
End If
SCREEN.Object("main.guide").Text = " "
If R_s.Checked = True Then
	If CDbl(Trim(SCREEN.Object("main.OBJ_chart.OBJ_sise.2023").Data)) >= _
	CDbl(Trim(ed_jcfg.Data)) Then
		SCREEN.Object("main.guide").Text = "가격설정이 현재가 보다 같거나 작습니다."
		Exit Sub
	End If
Else
	If CDbl(Trim(SCREEN.Object("main.OBJ_chart.OBJ_sise.2023").Data)) <= _
	 CDbl(Trim(ed_jcfg.Data)) Then
		SCREEN.Object("main.guide").Text = "가격설정이 현재가 보다 같거나 큽니다."
		Exit Sub
	End If
End If

IScfg.Text = "설정"
SCREEN.Proc "main.OBJ_chart.snd_order", ed_jcfg.Data & ", 2"
