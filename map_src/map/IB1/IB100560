_AW_ONDECLARE_AW_
Sub base_setting()
	OK.Enable = True
	CANCEL.Enable =False
	ed_jcfg.Enable = True
	R_s.Enable = True
	R_h.Enable = True
	ed_jqty.Enable = True
	shogb.Enable =True
	ed_jprc.Enable = True
	If IsNumeric(S1377.Data) Then
		ed_jqty.SetDelta S1377.Data
	End If
	Set_mkgb(S1301.Data)
	IScfg.Text = "미설정"
	SCREEN.Proc "main.OBJ_chart.cancel_order", "2"
End Sub

'***************************************************************************
' DESEC: 시장구분 Setting
'			1:거래소 2:코스닥 3:프리보드 4:장외
'***************************************************************************
Function Set_mkgb(code)
	Dim retn
	Set_mkgb = True
	ed_jprc.SetType 0
	'ed_jcfg.SetType 0
	retn = SCREEN.GetCodeType(code)
	Select Case retn
		Case 1
			ed_mkgb.Data = "1"	'거래소
			ed_jprc.SetType 100
			ed_jcfg.SetType 100
		Case 2
			ed_mkgb.Data = "2"	'코스닥
			ed_jprc.SetType 200
			ed_jcfg.SetType 200
		Case 3
			ed_mkgb.Data = "3"	'프리보드
		Case 4, 5, 6, 7
			ed_mkgb.Data = "4"	'장외
		Case Else
			Select Case Left(code, 1)
				Case "5", "6", "7", "8"			'ELW종목
					ed_mkgb.Data = "1"	'거래소
					ed_jprc.SetType 100
					ed_jcfg.SetType 100
				Case Else
					ed_mkgb.Data = "0"
					Set_mkgb = False
			End Select
	End Select
End Function

'***************************************************************************
' DESC: 호가조건 ComboBox 전환시 Setting
'			00:지정가 03:시장가 05:조건부지정가 06:최유리지정가
'			07:최우선지정가 09:자사주 10:자사주스톡옵션 12:자사주신탁
'			61:장개시전시간외 81:시간외종가 91:시간외단일가
'        호가구분에따라 단가를 enable/disable
'***************************************************************************
Sub Set_comb_hogb()
SCREEN.IgnoreChange True
	Select Case shogb.Data
		Case "00", "10", "20"			'보통/지정가(' ', IOC, FOK)
			ed_hogb.Data = "00"
			ed_jprc.Enable = True
			ed_jcfg.Data = SCREEN.Object("main.OBJ_chart.OBJ_sise.2025").Data
			ed_jprc.Data = SCREEN.Object("main.OBJ_chart.OBJ_sise.2025").Data
		Case "03", "13", "23"			'시장가(' ', IOC, FOK)
			ed_hogb.Data = "03"
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
		Case "05"						'조건부
			ed_hogb.Data = shogb.Data
			ed_jprc.Enable = True
			ed_jcfg.Data = SCREEN.Object("main.OBJ_chart.OBJ_sise.2025").Data
			ed_jprc.Data = SCREEN.Object("main.OBJ_chart.OBJ_sise.2025").Data
		Case "06", "16", "26"		'최유리(' ', IOC, FOK)
			ed_hogb.Data = "06"
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
			'ed_jcfg.Enable = False
		Case Else '"61", "81", "07"				'장전시간외(61), 장마감시간외(81), 최우선
			ed_hogb.Data = shogb.Data
			ed_jprc.Data = "0"
			ed_jprc.Enable = False
			'ed_jcfg.Enable = False
	End Select

	'-- 주문조건 (0:없음, 1:IOC, 2:FOK)
	Select Case Left(shogb.Data,1)
	Case "1", "2"
		ed_jmgb.Data = Left(shogb.Data,1)
	Case Else
		ed_jmgb.Data = "0"
	End Select
SCREEN.IgnoreChange False
End Sub

