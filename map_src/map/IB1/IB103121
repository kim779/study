Sub ChangeGridData()
	Dim sRow15, sNum, codx

	For ii = m_nIndex To GRID0.Rows
		sRow15 = Trim(GRID0.GetGridCell(ii, 15))

		If chkNumData(sRow15) = True Then	'이자율
			sNum = FormatNumber(sRow15 * 100, 2) & "%"
		Else
			sNum = ""
		End If

		GRID0.SetGridCell ii, 15, sNum

		codx = Trim(GRID0.GetGridCell(ii, 4))
		GRID0.SetGridCell ii, 4, "A" & Mid(codx, 4, 6)
	Next

	m_nIndex = ii

End Sub


Function chkNumData(num)
	chkNumData = False

	If Trim(num) = "" Then
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Exit Function
	End If

	chkNumData = True
End Function

