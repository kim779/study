'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	Call send_f()
End Sub

'== 조회
Sub send_f()
	zTrxTp.Data = 1
	LEDGER.Fkey = "C"
	dFirmSecBuyMnyMgnRat_copy.Clear
	dFirm_output.Clear
	SCREEN.Send 0
End Sub

'== 변경
Sub send_c()
	If RADIO0.Checked = True Then
		zTrxTp.Data = 3		'차등화증거금률적용
	Else
		zTrxTp.Data = 2		'증거금률100%로 변경
	End If
	LEDGER.Fkey = "C"

	SCREEN.Send 0
End Sub

