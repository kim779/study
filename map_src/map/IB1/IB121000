		dFirmSecBuyMnyMgnRat_copy.Data = temp.Data
		dFirmSecBuyMnyMgnRat.Data = temp.Data
		dFirm_output.Data = CStr((var1+var2) * 100)
	End If

	If zMgnLbrlzChoicTn.data <> "" Then
		If zMgnLbrlzChoicTn.data = 0 Then
			YN.Data = "미수가능"
		ElseIf zMgnLbrlzChoicTn.data = 1 Then
			YN.Data = "증거금 100% 미수불가"
		End If
	End If

	If zMgnLbrlzChoicTn.Data = 0 Then
		RADIO0.Checked = True
	Else
		RADIO1.Checked = True
	End If
Else
	alert_msg(LEDGER.Emsg)
