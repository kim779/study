'-----------------------------------------------------------------------
Sub send_f()
	range.Checked = False
	stime.Enable = False

	etime.Enable = False

	is_real.Checked = True
	stime.Data = "0730"

	jcod.Data = SCREEN.object("main.1301").Data
	S1301.Data = jcod.Data
	If Trim(jcod.Data) = "000000" Or Trim(jcod.Data) = "" Then
		SCREEN.OnSend False
		Exit Sub
	End If
	SCREEN.Send 0
End Sub
'-----------------------------------------------------------------------
Sub SetDate(StrDate)
	S11309.Data = StrDate
	'SYSTEM.Trace StrDate & "|"
End Sub
'-----------------------------------------------------------------------
Function GetToday()
	YY = Year(Date)
	MM = Month(Date)
	If Len(MM) = 1 Then
		MM = "0" & MM
	End If
	DD = Day(Date)
	If Len(DD) = 1 Then
		DD = "0" & DD
	End If
	GetToday = YY & MM & DD
End Function
'-----------------------------------------------------------------------
Sub Onalert()
	If is_real.Checked = False Then
		Exit Sub
	End If
End Sub
'-----------------------------------------------------------------------
Sub IsReal_check()
	If is_real.Checked = False Then
		SCREEN.Object("OBJ.1301").Clear
		SCREEN.Object("OBJ.1021").Clear
	Else
		SCREEN.Object("OBJ.1301").Data = S1301.Data
		SCREEN.Object("OBJ.1021").Data = "A" + S1301.Data

		'ELW인지 주식종목인지 구별
		If Trim(S1301.Data) <> "" Then

			If IsNumeric(Left(Trim(S1301.Data), 1)) = False Then
				Exit Sub
			End If

			If Trim(SCREEN.GetCodeType(S1301.Data)) = "27" Then	'ETN은 'Q'로 시작함
				SCREEN.Object("OBJ.1021").Data = "Q" & S1301.Data
			Else
				If Left(Trim(S1301.Data), 1) < 5 Or Left(Trim(S1301.Data), 1) > 8 Then
					SCREEN.Object("OBJ.1021").Data = "A" + S1301.Data
				Else
					SCREEN.Object("OBJ.1021").Data = "J" + S1301.Data
				End If
			End If
		End If


	End If
End Sub

