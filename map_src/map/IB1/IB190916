Sub Onalert()
	Dim	v_gubn
	Dim strKeys
	Dim v_subgubn

	ArrData = Array("",_
	Trim(TABLE0.GetTableCell(1)),_
	Trim(TABLE0.GetTableCell(2)),_
	Trim(TABLE0.GetTableCell(3)),_
	Trim(TABLE0.GetTableCell(4)),_
	Trim(TABLE0.GetTableCell(5)),_
	Trim(TABLE0.GetTableCell(6)),_
	Trim(TABLE0.GetTableCell(7)),_
	Trim(TABLE0.GetTableCell(8)),_
	Trim(TABLE0.GetTableCell(9)),_
	Trim(TABLE0.GetTableCell(10)),_
	Trim(TABLE0.GetTableCell(11))_
	)

	'종목코드 체크
	If r1_one.Checked Then
		If ArrData(4) <> Trim(S1301.data) Then
			Exit Sub
		End If
	End If

	'뉴스 제공사 체크
	If ArrData(2) = "" Then
		Exit Sub
	End If

	If IsNumeric(ArrData(8)) = False Then
		Exit Sub
	End If

	v_gubn = CLng(ArrData(8))

	If v_gubn < 1 Or v_gubn > 20 Then
		Exit Sub
	End If

	If SCREEN.Object("GUBN"&v_gubn).Checked = False Then
		Exit Sub
	End If

	Select Case v_gubn
		Case 1
			If GUBN1.Checked = False Then
				Exit Sub
			End If
			v_name = "시황"
		Case 2
			If GUBN2.Checked = False Then
				Exit Sub
			End If
			v_name = "공시"

			v_subgubn = CLng(ArrData(9))

			If v_subgubn = 99 Then
				v_name = "코스닥공시"
			ElseIf v_subgubn = 88 Then
				v_name = "프리보드공시"
			Else
				v_name = "거래소공시"
			End If
		Case 3
			If GUBN3.Checked = False Then
				Exit Sub
			End If
			v_name = "이투데이"
		Case 4
			If GUBN4.Checked = False Then
				Exit Sub
			End If
			v_name = "시황속보"
		Case 5
			If GUBN5.Checked = False Then
				Exit Sub
			End If
			v_name = "전자신문"
		Case 6
			If GUBN6.Checked = False Then
				Exit Sub
			End If
			v_name = "이데일리"
		Case 7
