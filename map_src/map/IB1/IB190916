Sub showgrid(val)
	GRID0.Clear
	If val = "1" Then
		BUTTON.Enable False
		jcod.Enable False
		GRID0.SetColumnVisible 7, True
		GRID0.SetColumnWidth 3, 365
		r2_1.Enable False
		r2_2.Enable False
		r2_3.Enable False
		For ii=1 To 20
			SCREEN.Object("GUBN"&ii).Checked = True
		Next
	Else
		BUTTON.Enable True
		jcod.Enable True
		GRID0.SetColumnVisible 7, False
		GRID0.SetColumnWidth 3, 445
		r2_1.Enable True
		r2_2.Enable True
		r2_3.Enable True
		rd_click()
	End If
End Sub

Sub rd_click()
	Dim ii

	If r2_1.Checked Then
		For ii=1 To 20
			If ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	ElseIf r2_2.Checked Then
		For ii=1 To 20
			If ii = 2 Then
				SCREEN.Object("GUBN"&ii).Checked = True
			Else
				SCREEN.Object("GUBN"&ii).Checked = False
			End If
		Next
	ElseIf r2_3.Checked Then
		For ii=1 To 20
			If ii = 2 Or ii = 7 Then
				SCREEN.Object("GUBN"&ii).Checked = False
			Else
				SCREEN.Object("GUBN"&ii).Checked = True
			End If
		Next
	Else

	End If
End Sub

