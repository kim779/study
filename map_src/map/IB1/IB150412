_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0006"
send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
QryTp.Data = "1"

AcntNo.Data = SYSTEM.Pop("Account")
Pwd.Data = SYSTEM.Pop("pwd")
BaseDt.Data = SYSTEM.Pop("BaseDate")

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	send_c()
End If

Dim acct, ii
Dim first, sec, third
Dim intrst

For ii = 1 To GRID0.Rows
	'acct = GRID0.GetGridText(ii, 1)
	acct = Replace(GRID0.GetGridText(ii, 1), "-", "")
	Intrst = GRID0.GetGridCell(ii, 13)

	first = Left(acct, 3)
	sec = Mid(acct, 4, 2)
	third = Mid(acct,6, 6)
'
	acct = first + "-" + sec + "-" + third
'
	'SYSTEM.Trace acct

	If first <> "   " Then
		GRID0.SetGridCell ii, 3, acct
	End If

	Intrst = Right(Intrst, 15)

	GRID0.SetGridCell ii, 13, Intrst
Next

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


