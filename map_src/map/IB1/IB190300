If LEDGER.Next = "Y" Then
	count.Data = count.Data + 1
	If trcnt.Data = 0 Then
		jj = 1
	Else
		jj = trcnt.Data*LEDGER.Rcnt+1
	End If
	For ii = jj To (trcnt.Data+1)*LEDGER.Rcnt
		'SYSTEM.Trace "NUMBER CONT QUERY " & ii
		GRID0.SetGridCell ii, 6, Trim(GRID0.GetGridCell (ii,6))
		GRID0.SetGridCell ii, 7, Trim(GRID0.GetGridCell (ii,7))
		For kk=1 To GRID0.Columns
			If Trim(GRID0.GetGridCell (ii,6)) = "매도" Then
				mmgbval = -8
				GRID0.SetTRgb ii, kk, 95
			Else
				mmgbval = -4
				GRID0.SetTRgb ii, kk, 94
			End If

			If kk >= 9 And kk <= 12 Then
				If Len(Trim(GRID0.GetGridCell (ii, kk))) > 0 Then
					SCREEN.Object("OBJ_BOTTOM.OSUM"&(kk+mmgbval)).Data = Int(SCREEN.Object("OBJ_BOTTOM.OSUM"&(kk+mmgbval)).Data) + Int(Trim(GRID0.GetGridCell (ii, kk)))
				End If
			End If
		Next
	Next
	trcnt.Data = trcnt.Data + 1
	Call Send_c()
