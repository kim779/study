_AW_ONDECLARE_AW_
Sub EndQueryGroup(Mode)
	If Mode = 1 Then
		SCREEN.Proc "OBJ_GRP.StrQueryGroupList", "COMBO0"
	Else
		'Call Send_f()
	End If
End Sub

Sub Send_f()
	'SYSTEM.Trace "send first"
	Dim ii
	trcnt.Data = 0
	jcod.Data = ""
	If chk_cod.Checked Then
		If Trim(S1301.Data) = "000000" Or Trim(S1301.Data) = "" Then
			jcod.Data = ""
		Else
			jcod.Data = "A" & S1301.Data
		End If
	End If
	For ii=1 To 12
		SCREEN.Object("OBJ_BOTTOM.OSUM"&ii).data = 0
	Next
	GRID0.Clear
	LEDGER.Rcnt = "0035"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub Send_c()
	'SYSTEM.Trace "send continue"
	GRID0.SetDataPosition 2
	LEDGER.Rcnt = "0035"
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub accn_list_done()
	Dim grid, item
	item = ""
	Set grid = SCREEN.Object("main.acnt_all.GRID0")
	For ii=1 To grid.Rows
		acnt = Trim(grid.GetGridCell(ii, 1))
		acnm = Trim(grid.GetGridCell(ii, 2))
		If acnt="" Then
			Exit For
		End If
		txt = Mid(acnt,1,3) & "-" & Mid(acnt, 4, 2) & "-" & Mid(acnt, 6) & "  " & Split(acnm, "|")(0)
		item = item & acnt & txt & vbTab
		If ii=1 Then
			item = Mid(item, 1, 11) & vbTab & item
		End If
	Next

	SCREEN.Object("cmb_acnt").SetItems item
End Sub

Sub SaveLog(sLog)

    Dim Stuff, myFSO, WriteStuff, sDate

    sDate = "[" & Now & "] "

	Set myFSO = CreateObject("Scripting.FileSystemObject")
	Set WriteStuff = myFSO.OpenTextFile("IB1903_Log.dat", 8, True)
	WriteStuff.WriteLine(sDate & sLog)
	WriteStuff.Close
	Set WriteStuff = Nothing
	Set myFSO = Nothing

End Sub

