		'ELW인지 주식인지 판단
		If Len(Trim(jmcd1103.Data)) = 6 Then
			zIsuNo.Data = jmcd1103.Data

			If SCREEN.GetCodeType(jmcd1103.Data) = 9 Then
				zIsuNo_A.Data = "J"
			ElseIf SCREEN.GetCodeType(jmcd1103.Data) = 27 Then
				zIsuNo_A.Data = "Q"
			Else
				zIsuNo_A.Data = "A"
			End If
		End If
	Else
		zIsuNo_A.Data = ""
		zIsuNo.Data = ""
	End If

	Dim tmp
