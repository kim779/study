' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(zPwd.Data) = "" Then
   zPwd.Data = "9999"
End If

'오브젝트에 데이터 날리기
If CheckInput(AN1A, zPwd) = True Then
	SCREEN.Object("OBJECT0.zAcntNo").data = AN1A.Data
	If RADIO1.Checked = True Then
		SCREEN.Object("OBJECT0.zPwd").data = zPwd.data
	End If

	If CHECK0.Checked = True Then
		SCREEN.Object("OBJECT0.zIsuNo").data = "A" + S1301.Data
