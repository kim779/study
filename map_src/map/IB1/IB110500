_AW_ONDECLARE_AW_
'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	ACNM.Data = AN1A.Name
	zPwd.Data = AN1A.Password

	If Len(Trim(AN1A.Data)) <> 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If CLng(SYSTEM.ConnectBy) = 0 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Proc "OBJECT0.send_f", ""
End Sub

'== 첫 조회
Sub send_f()
	OBJECT0.ClearAll 2
	GUIDE.Text = ""
	SCREEN.Object("OBJECT0.Ledger").FKey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	SCREEN.Object("OBJECT0.Ledger").FKey = "7"
	SCREEN.Object("OBJECT0.GRID0").SetDataPosition(2)
	OBJECT0.Send
End Sub

