SCREEN.OnSend = False

zAcntNo.Data = SCREEN.Object("main.AN1A").Data
zPwd.Data = SCREEN.Object("main.Pwd").Data
zAcnm.Data = SCREEN.Object("main.Acnm").Data
edSangPrc.Data = SCREEN.Object("parent.edSangPrc").Data
zLoanDt.Data = Trim(SCREEN.Object("main.grid0").GetGridCell(SCREEN.Object("main.grid0").row, 6))
zLoanDtlClssCode.Data = Trim(SCREEN.Object("parent.zLoanDtlClssCode").Data)
zIsuNo.Data = SCREEN.Object("main.1301").Data

If Trim(SCREEN.GetCodeType(zIsuNo.Data)) = "27" Then	'ETN은 'Q'로 시작함
	EDIT6.Data = "Q"
Else
	EDIT6.Data = "A"
End If

If Len(Trim(zPwd.Data)) < 4 Then
	SCREEN.Object("main.GUIDE").Text = "비밀번호를 확인하세요."
	SCREEN.Object("main.GUIDE").TRgb = 94
	SCREEN.Object("main.pwd").SetFocus
	Exit Sub
ElseIf CDbl(Trim(edSangPrc.Data)) = "0" Then
	MsgBox "금액을 입력하세요.", , "IBK투자증권"
	SCREEN.Object("parent.edSangPrc").SetFocus
	SCREEN.ClearAll 0 , 2
	Exit Sub
ElseIf Len(Trim(zIsuNo.Data)) = 0 Then
	MsgBox "종목을 선택하세요.", , "IBK투자증권"
	SCREEN.ClearAll 0 , 2
	Exit Sub
ElseIf Len(Trim(zLoanDt.Data)) = 0 Then
	MsgBox "대출일이 없습니다.", , "IBK투자증권"
	SCREEN.ClearAll 0 , 2
	Exit Sub
End If

If SYSTEM.UserPass <> Trim(zPwd.Data) Then
	If Trim(zPwd.Data) <> "HEAD" And Len(Trim(zPwd.Data)) >= 4 Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
		zPwd.Data = "HEAD"
	ElseIf Trim(zPwd.Data) = "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = Trim(SCREEN.Object("main.LEDGER").EPwd)
		zPwd.Data = "HEAD"
	End If

	If Trim(zPwd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			SCREEN.Object("main.Pwd").Data = ""
			SCREEN.Object("main.Pwd").SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If
End If

SCREEN.Proc "parent.SetBasicData" ,""

SCREEN.onsend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg

If Mid(LEDGER.Ecod, 1 ,1) <> "0" Then
	SCREEN.ClearAll 0 , 2
	Exit Sub
End If

Dim SinInt, SangAmt

SangAmt = Int(Trim(zRfundAbleQty.Data))
SinInt = Int(Trim(zCrdtIntrstAmt.Data)) + Int(Trim(zOvdIntrstSumAmt.Data))

SCREEN.Proc "parent.SetObjData", SangAmt & "," & SinInt


If zSend.Data = 1 Then
	Dim getMoney
	getMoney = CDbl(zRfundAmt.Data) + CDbl(zCrdtIntrstAmt.Data)

	SCREEN.Proc "parent.obj_getMoney.contributionBnk", getMoney

	zSend.Data = 0
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(zPwd)
_AW_ONKEYCHANGE_AW_
'== 비밀번호 변경시 조회 버튼 기능 수행.
If SCREEN.Key = "13" Then  '-- Enter 키 입력
	If Trim(S1301.Data) = "" Then
		S1301.SetFocus
		Exit Sub
	End If

	If RADIO1.Checked = True Then
		If CDbl(Trim(lLoanQty.Data)) = "0" Then
			lLoanQty.SetFocus
			Exit Sub
		End If
	ElseIf RADIO0.Checked = True Then
		If CDbl(Trim(lAbleAmt.Data)) = "0" Then
			lAbleAmt.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
	selection.Data = 1
End If
