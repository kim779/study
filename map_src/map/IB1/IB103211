_AW_ONDECLARE_AW_
Sub Init()
	zAcntNo.Data = SCREEN.Object("main.AN1A").Data
	zPwd.Data = SCREEN.Object("main.Pwd").Data
	zAcnm.Data = SCREEN.Object("main.Acnm").Data
