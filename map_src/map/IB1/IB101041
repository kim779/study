Function Is_numeric(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		Is_numeric = 0
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Is_numeric = 0
		Exit Function
	End If

	Is_numeric = CDbl(num)
End Function

