	End If

	If Trim(dCrdtPldgRat.Data) <> "" Then
		dCrdtPldgRat.Data = dCrdtPldgRat.Data * 100
	End If

	Select Case selection.Data
		Case "1"	zPwd.SetFocus()
		Case "2"	send_btn.SetFocus()
	End Select
End If

