_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

' 값 누적
Sub acc_value()
	Dim result

	'매도/수량
	result = 0
	If Trim(ISellQty.Data) <> "" Then
		If Trim(md_1.Data) <> "" Then
			result = CLng(md_1.Data) + CLng(ISellQty.Data)
		Else
			result = ISellQty.Data
		End If
    Else
		If Trim(md_1.Data) <> "" Then
			result = md_1.Data
		End If
	End If
	md_1.Data = result

End Sub

Sub reDraw()
	Dim ii
	For ii = gridPos To GRID0.Rows
		Dim str, str2, str3
		str = Trim(GRID0.GetGridCell(ii, 4))


		If InStr(1,str,"매수") <> 0 Then
			GRID0.SetTRgb ii, 4, 94
		ElseIf InStr(1,str,"매도") <> 0  Then
			GRID0.SetTRgb ii, 4, 95
		Else
			GRID0.SetTRgb ii, 4, 69
		End If

		str2 = Trim(GRID0.GetGridCell(ii, 2))
		If InStr(1,str2,"매수") <> 0 Then
			GRID0.SetTRgb ii, 2, 94
		ElseIf InStr(1,str2,"매도") <> 0  Then
			GRID0.SetTRgb ii, 2, 95
		Else
			GRID0.SetTRgb ii, 2, 69
		End If

		str3 = Trim(GRID0.GetGridCell(ii,1))

		If Left(str3, 1) = "A" Or Left(str3, 1) = "J" Or Left(str3, 1) = "Q" Then
			GRID0.SetGridCell ii, 1, Mid(str3, 2)
		End If
	Next
End Sub

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

