Sub Fixdanga()
	Dim SellQtyGB, SellFixPrcQty, DanGa, qry

	SellQtyGB = Trim(OrdCfg.ReadCfg("SellQtyGB"))

	If SellQtyGB <> "2" Then
		MsgBox "주문설정에서 매매금액을 설정하여 주십시오",0,"IBK투자증권"
		Exit Sub
	End If

	SellFixPrcQty = Trim(OrdCfg.ReadCfg("SellFixPrcQty"))

	If SellFixPrcQty = "" Then
		Exit Sub
	End If

	If c_hogb.Checked <> True Then
		If  ed_jprc.Data = "000000000" Then
		 	DanGa = Trim(SCREEN.Object("main.obj_sise.2023").Data)
		 	ed_jprc.Data = DanGa
		Else
		  	DanGa = ed_jprc.Data
		End If
	Else
		DanGa = Trim(SCREEN.Object("main.obj_sise.2023").Data)
	End If

	If Trim(DanGa) = "" Then
		Exit Sub
	End If

	qry = CDbl(SellFixPrcQty) / CDbl(DanGa)
	ed_jqty.Data = Fix(qry)

	OBJ_JUNGSAN.Proc "CalcJungsan", ""
End Sub

