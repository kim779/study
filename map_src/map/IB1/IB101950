Sub Fixdanga()	'금액 매매
	Dim SellQtyGB, SellFixPrcQty, DanGa, qry
	Dim siseObjPath

	SellQtyGB = Trim(OrdCfg.ReadCfg("SellQtyGB"))

	If SellQtyGB <> "2" Then
		MsgBox "주문설정에서 매매금액을 설정하여 주십시오",0,"IBK투자증권"
		Exit Sub
	End If

	SellFixPrcQty = Trim(OrdCfg.ReadCfg("SellFixPrcQty"))

	If SellFixPrcQty = "" Then
		Exit Sub
	End If

	If SCREEN.GetMapName(1) = "IB101100" Then
		siseObjPath = "parent.obj_obj_sise"
	Else
		siseObjPath = "obj_obj_sise"
	End If

	If c_hogb.Checked <> True Then
		If  ed_jprc.Data = "000000000" Then
		 	DanGa = Trim(SCREEN.Object(siseObjPath & ".2023").Data)
			ed_jprc.Data = DanGa
		Else
		   	DanGa = ed_jprc.Data
		End If
	Else
		DanGa = Trim(SCREEN.Object(siseObjPath & ".2023").Data)
	End If

	If DanGa = "0" Or DanGa = "" Then
	  	Exit Sub
	Else
		qry = CDbl(SellFixPrcQty) / CDbl(DanGa)
	End If

	ed_jqty.Data = Fix(qry)
	OBJ_JUNGSAN.Proc "CalcJungsan", ""
End Sub

