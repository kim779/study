'=== 가격자동 체크박스 체크값 기억/설정 ===
Sub Set_Auto(mmgb)
	Dim flag
	If (mmgb < "1") Or (mmgb > "3") Then Exit Sub
	flag = SYSTEM.Pop("auto_flag_s")		'-매도,매수,정정
	If Len(Trim(flag)) <> 3 Then flag = "000"	'-default:자동아님
	SCREEN.Object("obj_odr.chk_auto").Checked = (Mid(flag,mmgb,1) = "1")
	SCREEN.Object("obj_odr.cboPrice").Enable = (Mid(flag,mmgb,1) = "1")
End Sub
Sub Get_Auto(mmgb, c_auto)
	Dim flag, val
	If c_auto = "True" Then
		val = "1"
	Else
		val = "0"
	End If

	flag = SYSTEM.Pop("auto_flag_s")		'-매도,매수,정정
	If Len(Trim(flag)) <> 3 Then flag = "000"	'-default:자동아님
	Select Case mmgb
	Case "1" : flag = val & Mid(flag,2)
	Case "2" : flag = Left(flag,1) & val & Mid(flag,3)
	Case "3" : flag = Left(flag,2) & val
	Case Else : Exit Sub
	End Select
	SYSTEM.Push "auto_flag_s", flag
End Sub


