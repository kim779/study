Function RemovePlus(strData)

	strData = Trim(strData)

	If Mid(strData, 1, 1) = "+" Then
		strData = Mid(strData, 2, Len(strData) -1)
	End If

	RemovePlus = strData

End Function

Function zeropad(str, length)
	Dim strTemp
	strTemp = Trim(str)
	If strTemp = "" Then
		zeropad = ""
		Exit Function
	End If
	zeropad = String(length - Len(strTemp), "0") & strTemp
End Function

