Sub chkOption(cmp)
	Dim ecmp0, ecmp1, IsBool
	ecmp0 = "e_" & Mid(cmp,3) & "0"
	ecmp1 = "e_" & Mid(cmp,3) & "1"

	IsBool = SCREEN.Object(cmp).Checked

	SCREEN.Object(ecmp0).Enable = IsBool
	SCREEN.Object(ecmp1).Enable = IsBool

	Call write_ini(cmp, "C")		'현재가검색 check
	Call write_ini(ecmp0, "E")	'현재가검색값0
	Call write_ini(ecmp1, "E")	'현재가검색값1

	SCREEN.Object(ecmp0).SetFocus

	If IsBool = False Then
		Call send_f()
	End If
End Sub


Sub sendOption(comNm)
	Dim com0, com1

	If send_check() = False Then
		Exit Sub
	End If

	com0 = comNm & "0"
	com1 = comNm & "1"

	Call write_ini(com0, "E")
	Call write_ini(com1, "E")
	Call send_f()
End Sub

