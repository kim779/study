'*****************************************************************************
'p_read_ini() - 화면 시작시 실행.
'userconf.ini 파일에 저장된 맵 형태, 각 설정값, 저장된 헤더이름을 가져와 세팅
'*****************************************************************************
Sub p_read_ini()
	If SCREEN.CreateObject("Info") = True Then
		Dim mapTp, compNm, tmpSingle, ii, headList
		mapTp = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "mapTp"))

		If mapTp = "" Then
			mapTp = "0"
		End If

		Call SetScreen(mapTp)

		Call read_ini("CO_SORT", "L")		'발행사
		Call read_ini("ELWLP", "L")		'발행사
		Call read_ini("ELWUD", "L")		'기초자산
		Call read_ini("CBKCOD", "L")	'권리유형
		Call read_ini("JJIS", "L")		'잔존일

		For ii = LBound(componentArr) To UBound(componentArr)
			compNm = Trim(componentArr(ii))
			tmpSingle = Left(compNm, 1)

			If tmpSingle <> "l" Then
				Call read_ini(compNm, UCase(tmpSingle))
			End If
		Next

		headList = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, "headList"))

		If headList <> "" Then
			viewHeadList = headList
		Else
			viewHeadList = baseHeadList
		End If

		Call SetHeaderName()
	Else
		Call SetScreen("0")
		Call SetHeaderName()
	End If
End Sub


'*****************************************************************************
'read_ini() - 화면 시작시 실행(p_read_ini).
'현재가, 거래량틍 설정 항목 세팅
'*****************************************************************************
Sub read_ini(symb, gubn)
	Dim rdata, name, edt0, edt1
	rdata = Trim(INFO.PopData(LOGIN.Name, MYFILE, MYMAP, symb))

	If rdata = "" Then
		Exit Sub
	End If

	If gubn = "E" Or gubn = "L" Then		'edit box, list box
		SCREEN.Object(symb).Data = rdata
	ElseIf gubn = "C" Then					'check box
		SCREEN.Object(symb).Checked = rdata

		If rdata = "1" Then
			name = "e_" & Mid(symb, 3) ', Len(symb) - 2)
			edt0 = name & "0"
			edt1 = name & "1"

			SCREEN.Object(edt0).Enable = True
			SCREEN.Object(edt1).Enable = True
		End If
	End If
End Sub


'*****************************************************************************
'SetScreen() - 화면 시작시 실행(p_read_ini).
'param - 0 : 기본, 1 : 설정항목 보여줌
'*****************************************************************************
Sub SetScreen(param)
	Dim tmpComp, ii, IsBool

	mapType.Data = param

	If Trim(param) = "0" Then
		IsBool = False
	Else
		IsBool = True
	End If

	For ii = LBound(componentArr) To UBound(componentArr)
		tmpComp = Trim(componentArr(ii))
		SCREEN.Object(tmpComp).Visible IsBool
	Next

	If param = "0" Then
		upPanel.SetRect 0, 0, 699, 93 - 67
		grd.SetRect 0, 93 - 67, 699, 277
		btnY1.Text = "DOWN_EX.BMP"
	Else
		upPanel.SetRect 0, 0, 699, 93
		grd.SetRect 0, 93, 699, 277
		btnY1.Text = "UP_EX.BMP"
	End If
End Sub


Sub SetHeaderName()
	Dim headListArr, ii, jj, idx, tmpNm
	headListArr = Split(viewHeadList, "|")

	For ii = 0 To 19
		idx = 7 + ii
		tmpNm = ""

		If ii <= UBound(headListArr) Then
			tmpNm = Trim(headListArr(ii))
			grd.SetHead idx, tmpNm
			grd.SetColumnVisible idx, True
		Else
			tmpNm = ""
			grd.SetHead idx, tmpNm
			grd.SetColumnVisible idx, False
		End If
	Next

	Call send_f()
End Sub




