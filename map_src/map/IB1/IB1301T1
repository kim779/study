RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim gridPos
gridPos = 1

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0019"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("parent.GUIDE.GUIDE").Text = ""

account.Data = SCREEN.Object("parent.AN1A").Data
zInputPwd.Data = SCREEN.Object("parent.zPwd").Data

If SYSTEM.ConnectBy = "0" Then
	zInputPwd.Data = "9999"
	SCREEN.Object("parent.zPwd").Data = "9999"
End If

If Len(Trim(account.Data)) < 11 Then
	MsgBox "계좌번호를 확인하세요.", , "IBK투자증권"
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

If Len(Trim(zInputPwd.Data)) < 4 Then
	MsgBox "비밀번호를 확인하세요.", , "IBK투자증권"
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If

zQryTp.Data = SCREEN.Object("parent.zQryTp").Data
zCmsnAmtAppTp.Data = SCREEN.Object("parent.zCmsnAmtAppTp").Data

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'비밀번호 오류
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2,2
	SCREEN.Object("main.ACNM").data = SCREEN.Object("main.AN1A").Name
	SCREEN.Object("main.zPwd").Clear
	SCREEN.Object("main.zPwd").SetFocus

ElseIf Left(Trim(LEDGER.Ecod), 1) = "0" Then

	'수수료 + 제세금
	Dim ii, val1, val2, val_rate, val_rate_table
	'소수점  두자리
	Dim before_val1, before_val2, before_val3, table_be
	Dim change_val1, change_val2, change_val3, table_ch

	For ii = gridPos To GRID0.Rows
		 before_val1 = CStr(GRID0.GetGridCell(ii, 8))
		 change_val1 = Left(before_val1, 10)
		 GRID0.SetGridCell ii, 8, change_val1

		 before_val2 = CStr(GRID0.GetGridCell(ii, 11))
		 change_val2 = Left(before_val2, 8)
		 GRID0.SetGridCell ii, 11, change_val2

		 val1 = GRID0.GetGridCell(ii, 13)  '-- 수수료
		 val2 = GRID0.GetGridCell(ii, 14)  '-- 제세금

		 '수수료 + 제세금
 		 If Trim(val1) <> "" And Trim(val2) <> "" Then
 		 	sum = CLng(val2) + CLng(val1)
		 	GRID0.SetGridCell ii, 12, sum  '-- 합계
		 Else
		 	If Trim(val1) <> "" Then
		 		GRID0.SetGridCell ii, 12, CLng(val1)
		 	ElseIf Trim(val2) <> "" Then
		 		GRID0.SetGridCell ii, 12, CLng(val2)
		 	End If
		 End If

		 '수익율 * 100
		 profit = Trim(GRID0.GetGridCell(ii, 16))
		 If chkNumericData(profit) = True Then
		 	profit = profit * 100
		 	GRID0.SetGRidCell ii, 16, FormatNumber((profit), 2, 0, 0, 0)

		 	If profit > 0 Then
		 		GRID0.SetTRgb ii, 16, 94
		 	ElseIf profit = 0.00 Then
		 		GRID0.SetTRgb ii, 16, 69
		 	Else
		 		GRID0.SetTRgb ii, 16, 95
		 	End If
		 End If
	Next

	gridPos = GRID0.Rows + 1

	'수익률 * 100
	val_rate_table	= dTotPnlRat.GetTableCell(1) * 100
    If Trim(val_rate_table) <> "" Then
		dTotPnlRat.SetTableCell 1, FormatNumber((val_rate_table), 2, 0, 0, 0)

	 	If val_rate_table > 0 Then
	 		dTotPnlRat.SetTRgb 1, 1, 94
	 	ElseIf val_rate_table = 0.00 Then
	 		dTotPnlRat.SetTRgb 1, 1, 69
	 	Else
	 		dTotPnlRat.SetTRgb 1, 1, 95
	 	End If
	End If


Else
	SCREEN.ClearAll 2, 2
	SCREEN.Object("main.ACNM").data = SCREEN.Object("main.AN1A").Name
End If

Select Case SCREEN.Object("main.sec").data
	Case "1"	SCREEN.Object("main.zPwd").SetFocus()
	Case "2"	SCREEN.Object("main.send_btn").SetFocus()
	Case "3"	SCREEN.Object("main.next_btn").SetFocus()
	Case "4"	SCREEN.Object("main.zQryTp").SetFocus()
End Select

'다음버튼 살리기
If LEDGER.Next = "Y" Then
	SCREEN.Object("main.next_btn").Enable = True
Else
	SCREEN.Object("main.next_btn").Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.DATA = Right(GRID0.GetGridCell(GRID0.Row, 1), 11)

	If Trim(S1301.DATA) = "" Then
		Exit Sub
	End If

	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



