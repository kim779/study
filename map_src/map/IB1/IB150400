RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub tab_mainChange()
	If tab_mainHangmok.ID = 0 Then
		obj.SetObject "IB150420"
	Else
		obj.SetObject "IB150410"
	End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)
	cxMarket.sMarket = sMKGubn
	If tab_mainHangmok.ID = 0 Then
		SCREEN.Proc "main.obk.send_f", ""
	End If
	'SCREEN.Object("obj").Send
End Sub

_AW_ONSTART_AW_
cxMarket.MNum = SCREEN.GetMapName(1)
cxMarket.Major = SCREEN.Major

Call tab_mainChange()

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(tab_mainHangmok)
_AW_ONCLICK_AW_
Call tab_mainChange()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(edMarketTrigger)
_AW_ONCHANGE_AW_
Change_MKGubn_Main(Trim(edMarketTrigger.Data))
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cxMarket)
_AW_ONCLICK_AW_
SCREEN.Proc "main.Change_MKGubn_Main", cxMarket.sMarket

If UCase(TypeName( SCREEN.Object("cbSOrder") )) <> "NOTHING" Then
	If cxMarket.sMarket = "통합" Then
		cbSOrder.Data = "S"
	ElseIf cxMarket.sMarket = "KRX" Then
		cbSOrder.Data = "1"
	ElseIf cxMarket.sMarket = "NXT" Then
		cbSOrder.Data = "N"
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



