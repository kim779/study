Sub write_ini(symb, gubn)
	Dim wdata, chck
	If gubn = "E" Or gubn = "L" Then		'edit box, list box
		wdata = Trim(SCREEN.Object(symb).text)
		If InStr(1, wdata, ".") = 0 Then
			wdata = Trim(SCREEN.Object(symb).data)
		End If
		INFO.PushData LOGIN.Name, myFILE, myMAP, symb, wdata
	ElseIf gubn = "C" Then					'check box
		If SCREEN.Object(symb).checked = True Then
			chck = "1"
		Else
			chck = "0"
		End If

		INFO.PushData LOGIN.Name, myFILE, myMAP, symb, chck
	End If
End Sub

