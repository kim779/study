RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Const myFILE = "userconf.ini"
Const myMAP = "IB280500"
Dim dbuff

Function P_SetGubn(gubn)
	s_gubn.Data = gubn
	SCREEN.Send 0
End Function

Function P_send()
   SCREEN.Send 0
End Function



Sub p_read_ini()
If SCREEN.CreateObject("Info") Then
 	ELWUD.data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "ELWUD"))
 	CBKCOD.data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "CBKCOD"))
 	JJIS.data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "JJIS"))
 	CO_SORT.data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COSORT"))
	ELWLP.data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "ELWLP"))

	If Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "CGVOL")) = "0" Then
 		C_GVOL.Checked = False
	End If
End If

End Sub


Sub p_write_ini()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "ELWUD", ELWUD.Data
  INFO.PushData LOGIN.Name, myFILE, myMAP, "CBKCOD", CBKCOD.Data
  INFO.PushData LOGIN.Name, myFILE, myMAP, "JJIS", JJIS.Data
  INFO.PushData LOGIN.Name, myFILE, myMAP, "COSORT", CO_SORT.Data
  INFO.PushData LOGIN.Name, myFILE, myMAP, "ELWLP", ELWLP.Data
	If C_GVOL.Checked = True Then
		dbuff = "1"
	Else
		dbuff = "0"
	End If
  INFO.PushData LOGIN.Name, myFILE, myMAP, "CGVOL", dbuff
End If
End Sub

Sub grd_refresh()
	grd.Refresh()
End Sub

_AW_ONSTART_AW_
CO_SORT.Data = "03"
SCREEN.SetTimer 7, False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If R_TOP.Checked = True Then
	ASCF.Data = "0"
End If
If R_BOT.Checked = True Then
	ASCF.Data = "1"
End If


Call	p_write_ini()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
iflag.Data = "1"

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call p_read_ini()
lobj.Send
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ELWUD)
_AW_ONCHANGE_AW_
SCREEN.Send 0
