RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Proc "main.Set_guide", " "

AcntNo.Data = SCREEN.Object("parent.parent.AN1A").data
zIsuNo.Data = SCREEN.Object("parent.1301").data

If Trim(AcntNo.Data) = "" Or Len(Trim(AcntNo.Data)) < 11 Then
	MsgBox "계좌번호를 확인하세요", ,"IBK투자증권"
	Exit Sub
End If

If Trim(zIsuNo.Data) = "" Then
	MsgBox "종목코드를 확인하세요", ,"IBK투자증권"
	SCREEN.Object("parent.1301").SetFocus
	Exit Sub
End If

If SCREEN.GetCodeType(zIsuNo.Data) = 9 Then		' ELW
	zIsuNo_A.Data = "J"
ElseIf SCREEN.GetCodeType(zIsuNo.Data) = 27 Then
	zIsuNo_A.Data = "Q"
Else
	zIsuNo_A.Data = "A"
End If
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
SCREEN.Object("parent.SecinQty").data = SecinQty.Data

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



