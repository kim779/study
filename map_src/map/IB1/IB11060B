	MsgBox "비밀번호를 입력하십시오.", , "IBK투자증권"
	pswd.SetFocus
	Exit Sub
End If

ret = P_pswdConfirm(AN1A.data, pswd.data, msg)
If ret <> True Then
	pswd.Clear
	pswd.SetFocus
	MsgBox "비밀번호 오류입니다.", , "IBK투자증권"
	GUIDE.Text = msg
	Exit Sub
End If

cnt = 0

en_accn.Data = Mid(AN1A.data, 1, 8)
en_pswd.Data = pswd.Data
pswd2 = SYSTEM.Encrypt(en_pswd.Data, en_accn.Data)

accn = AN1A.data										'계좌번호
mkgb2 = ""												'시장구분

For ii = 1 To VIEWGRID.Rows
	If VIEWGRID.GetGridCell(ii ,1) = 1 Then
		cnt = cnt + 1
		ret = s_chk_elw_price(mkgb2, code, VIEWGRID, ii)
		If ret = True Then
'			code = VIEWGRID.GetGridCell(ii, 6)			'종목코드
			If SCREEN.GetCodeType(VIEWGRID.GetGridCell(ii, 6)) = "9" Then
			     code = "J" & VIEWGRID.GetGridCell(ii, 6)   '종목코드
			ElseIf SCREEN.GetCodeType(VIEWGRID.GetGridCell(ii, 6)) = "27" Then
			     code = "Q" & VIEWGRID.GetGridCell(ii, 6)   '종목코드
			Else
			     code = VIEWGRID.GetGridCell(ii, 6)   '종목코드
			End If
			jprc = VIEWGRID.GetGridCell(ii, 11)			'주문가격(or 정정가격)
			jmsu = VIEWGRID.GetGridCell(ii, 12)			'주문수량
			jmnu = VIEWGRID.GetGridCell(ii, 4)			'주문번호
			jmna = VIEWGRID.GetGridCell(ii, 7)			'종목명
			mcsu = VIEWGRID.GetGridCell(ii, 16)			'미체결량

			s_data = "#" & s_data
			s_data = ii & "|" & s_data					'ii			16
			s_data = "X" & "|" & s_data					'처리구분	15
			s_data = "2" & "|" & s_data					'모두구분	14
			s_data = "0" & "|" & s_data					'주문조건	13
			s_data = "99" & "|" & s_data				'호가구분	12
			s_data = jprc & "|" & s_data				'주문가격	11
			s_data = mcsu & "|" & s_data				'주문수량(정정, 취소수량)	10
			s_data = jmna & "|" & s_data				'종목명		9
			s_data = code & "|" & s_data				'종목코드	8
			s_data = jmnu & "|" & s_data				'주문번호	7
			s_data = pswd2 & "|" & s_data				'비밀번호	6
			s_data = accn & "|" & s_data				'계좌번호	5
			s_data = "4" & "|" & s_data					'매매구분	4
			s_data = mkgb2 & "|" & s_data				'시장구분	3
			s_data = "1" & "|" & s_data					'주문유형	2
			s_data = "1" & "|" & s_data					'CUD		1
		End If
	End If
Next

num.data = cnt

If cnt > 0 Then
	num.Push ""
	SCREEN.CreateWindow 2, "IB110104 /p5 /d", "s_data" & vbTab & s_data
	clear_check()
End If

