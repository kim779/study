_AW_ONDECLARE_AW_
Option Explicit
Dim InitialYn
InitialYn = "N"

Sub send_initial()
	'SYSTEM.Trace "1"
	InitialYn = "Y"
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "3"
	SCREEN.Send 0
End Sub

Sub send_f()
	InitialYn = "N"
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	InitialYn = "N"
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

'그리드 클릭시 데이터 매도탭에 전달
'대출일이 있을경우 신용매도 / 없을 경우 매도
Sub click_grid()
		Dim	jongmok_code, code, capacity, credit_date, val, price, ptnNm

		'종목번호
		jongmok_code = Trim(GRID0.GetGridCell(GRID0.Row, 1))

		If Len(jongmok_code) <> 7 Then
			Exit Sub
		End If

		code = Mid(jongmok_code, 2, 6)
		ptnNm = Trim(GRID0.GetGridCell(GRID0.Row, 4)) '유가증권 잔고 유형명

		capacity = GRID0.GetGridCell(GRID0.Row, 23)		'보유잔고 -> 매도가능
		credit_date = GRID0.GetGridCell(GRID0.Row, 20)	'대출일
		price = GRID0.GetGridCell(GRID0.Row, 21)

		If InStr(ptnNm, "자기융자") > 0 Or InStr(ptnNm, "담보융자") > 0 Then
			If SCREEN.Object("main.UTAB1").ID <> 5 Then
				SCREEN.Object("main.UTAB1").ID = 5
				SCREEN.Proc "main.SelectUTab1", ""
			End If

			If InStr(ptnNm, "자기융자") > 0 Then
				SCREEN.Object("main.OBJECT1.zMgntrnCode").Data = 103
			Else
				SCREEN.Object("main.OBJECT1.zMgntrnCode").Data = 180
			End If

			SCREEN.Object("main.OBJECT1.zLoanDt").Data = credit_date
		Else
			If SCREEN.Object("main.UTAB1").ID <> 1 Then
				SCREEN.Object("main.UTAB1").ID = 1
				SCREEN.Proc "main.SelectUTab1", ""
			End If
		End If

		SCREEN.Object("main.OBJECT1.OBJECT0.1301").Data = code
		SCREEN.Object("main.OBJECT1.OBJECT0").Send
		SCREEN.Object("main.OBJECT1.IOrdQty").Data = capacity

'		If Trim(credit_date) = "" Then
'		    val = "Order"
'			SCREEN.proc "Main.setOrder", val& "," & code & "," & capacity & "," & price
'		Else
'		    val = "creditOrder"
'			SCREEN.proc "Main.CreditOrder", val& "," & code & "," & capacity & "," & credit_date & "," & price
'		End If
End Sub

