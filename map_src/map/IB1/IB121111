LEDGER.Rcnt = "0011"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

zAcntNo.Data = Trim(SCREEN.Object("main.AN10").Data)

'MsgBox Len(Trim(zAcntNo.Data))
'Exit Sub

If Len(Trim(zAcntNo.Data)) <> 11 Then
	MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"
	SCREEN.Object("main.AN10").SetFocus
	Exit Sub
End If

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" Then
   zPwd.Data = "9999"
Else
	If Len(Trim(SCREEN.Object("main.zPwd").Data)) < 4 Then
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		SCREEN.Object("main.zPwd").SetFocus
		Exit Sub
	End If

	zPwd.Data = SCREEN.Object("main.zPwd").Data
	
	If SYSTEM.UserPass <> Trim(zPwd.Data) Then
		If Trim(zPwd.Data) <> "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		Else
			LEDGER.Hsiz = 44
			LEDGER.EPwd = Trim(SCREEN.Object("main.LEDGER").EPwd)
			zPwd.Data = "HEAD"
		End If
	
		If Trim(zPwd.Data) = "HEAD" Then
			If Len(Trim(LEDGER.EPwd)) <> 44 Then
				SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
				SCREEN.Object("main.zPwd").Data = ""
				SCREEN.Object("main.zPwd").SetFocus
				SCREEN.OnSend = False
				Exit Sub
			End If
		End If
