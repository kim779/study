Sub sendData(szVal)
	If szVal = "QRY" Then
		'/* 계좌번호 */
		accn = Trim(SCREEN.Object("main.AN5A").Data)
		If Len(accn) <> 11 Then
			'SCREEN.Object("main.guide").text = "계좌번호를 확인해 주십시오."
			Exit Sub
		End If
		'비밀번호 체크만...
		If SYSTEM.ConnectBy = "0" Then
			pass = "9999"
		Else
			pass = Trim(SCREEN.Object("main.pswd2").Data)
		End If
		If Len(pass) < 4 Then
			'SCREEN.Object("main.guide").text = "비밀번호를 확인해 주십시오."
			Exit Sub
		End If

		SCREEN.Proc "obj_svrcondlist.refreshList", ""
		'obj_svrcondlist.Send
	End If
End Sub

Sub DisplayCondList()
	tab_Type.ID = 0
	SetObj()
End Sub

Sub SetObj()

	Dim nID
	nID = SCREEN.Object("main.tab_condType").ID

	L_CNT.Data = ""
	If tab_Type.ID = 0 Then
		'감시내역
		If nID = 7 Then		'청산
			obj_svrcondlist.SetObject "IB102011"
		ElseIf nID = 2 Then	'신규 매수
			obj_svrcondlist.SetObject "IB102012"
		ElseIf nID = 5 Then	'잔고편입
			obj_svrcondlist.SetObject "IB102013"
		Else
		End If
		L_CNT.Visible = True
		btn_exe.Visible = True
		btn_stop.Visible = True
		btn_del.Visible = True

		BUTTON1.Visible = False
		cautionBtn.Visible = False
		send_btn.Visible = False
		sendData "QRY"
	Else
		'실시간잔고
		obj_svrcondlist.SetObject "IB102015"
		L_CNT.Visible = False
		btn_exe.Visible = False
		btn_stop.Visible = False
		btn_del.Visible = False

		BUTTON1.Visible = True
		cautionBtn.Visible = True
		send_btn.Visible = True
	End If

End Sub


Sub DisplayCondCnt()
	Dim nCondCnt
	nCondCnt = Trim(SCREEN.Object("obj_svrcondlist.OUTPUT1").data)
	If nCondCnt = "" Then
		nCondCnt = "0"
	End If
	Dim nExeCnt
	nExeCnt = Trim(SCREEN.Object("obj_svrcondlist.OUTPUT2").data)
	If nExeCnt = "" Then
		nExeCnt = "0"
	End If

	Dim szText
	szText = "총 "&CInt(nCondCnt)&"건 중 "&CInt(nExeCnt)&"건 감시 중"

	L_CNT.Data = szText
	If tab_Type.ID = 0 Then
		If nID = 7 Then		'청산
			L_CNT.TRgb = 32
		ElseIf nID = 2 Then	'신규 매수
			L_CNT.TRgb = 54
		ElseIf nID = 2 Then	'잔고편입
			L_CNT.TRgb = 32
		Else

		End If
	End If
End Sub

