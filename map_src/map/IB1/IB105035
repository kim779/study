			S20031.TRgb = 95
		ElseIf Mid(diff, 1, 1) = "+" Then
			S20031.TRgb = 94
		End If
	End If

	If Mid(siga, 1, 1) = "0" Then
		S20029.Data = S20023.Data
		If Mid(diff, 1, 1) = "-" Then
			S20029.TRgb = 95
		ElseIf Mid(diff, 1, 1) = "+" Then
			S20029.TRgb = 94
