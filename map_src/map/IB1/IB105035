Sub Onalert()
	Dim curr, koga, jega, diff, siga

	curr = Trim(S20023.Data)
	koga = Trim(S20030.Data)
	jega = Trim(S20031.Data)
	diff = Trim(S20033.Data)
	siga = Trim(S20029.Data)

