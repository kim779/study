Sub send_sise_all(xval)
SCREEN.IgnoreChange True
	S1301.Trigger "", True

	If xval <> "jumun" Then
		Call Ord_ChangeCode(S1301.Data)
	End If

	SCREEN.Object("OBJ_order.obj_sise.1301").Data = Trim(S1301.Data)
	SCREEN.Object("OBJ_order.obj_sise").Send

SCREEN.IgnoreChange False

	If tab_account.ID = 7 Then
		SCREEN.Proc "OBJ_account.send_main", ""
	End If
End Sub

Sub all_account()
	OBJ_account.Send
End Sub

'모든 obj 1301에 종목정보 전송
Sub Send_sise_all2(code)
	S1301.Trigger "1301", True

	If xval <> "jumun" Then
		SCREEN.IgnoreChange True
			SCREEN.Object("OBJ_order.obj_odr.1301").Data = code
			SCREEN.Proc "OBJ_order.obj_odr.ChangeCode", ""
		SCREEN.IgnoreChange False
	End If

End Sub


'하단 obj용 종목코드 전송 함수
Sub Send_sise_all3(code)
	S1301.Trigger "1301", True
	S1301.Trigger "1301", False

	If xval <> "jumun" Then
			SCREEN.IgnoreChange True
			SCREEN.Object("OBJ_order.obj_odr.1301").Data = code
			SCREEN.IgnoreChange False
			SCREEN.Proc "OBJ_order.obj_odr.ChangeCode", ""
	End If

End Sub

