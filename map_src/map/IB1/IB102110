_AW_ONDECLARE_AW_
Dim g_ArrHogaCtrl

g_ArrHogaCtrl = Array(S17412, Array(S2023, S2024, S2033, S2027, S2403, LABEL0), obj_10Hoga, 0)
'0:5호가, 1:10호가, 2:최초 실행시 보여지는 화면 인덱스
'-----------------------------------------------------------------------
Sub ProcSetVisible(Index)
	If Index = "0" Then
		g_ArrHogaCtrl(0).visible = True
		For i = LBound(g_ArrHogaCtrl(1)) To UBound(g_ArrHogaCtrl(1))
			g_ArrHogaCtrl(1)(i).Visible = True
		Next
		g_ArrHogaCtrl(2).Visible = False
		g_ArrHogaCtrl(2).SetObject("IB10BLNK")
	Else
		g_ArrHogaCtrl(0).visible = False
		For i = LBound(g_ArrHogaCtrl(1)) To UBound(g_ArrHogaCtrl(1))
			g_ArrHogaCtrl(1)(i).Visible = False
		Next
		g_ArrHogaCtrl(2).Visible = True
		g_ArrHogaCtrl(2).SetObject("IB10211H")
		obj_10Hoga.Proc "SetDangaObject", "Main.OBJ_order.OBJ_odr.ed_jprc"
	End If

	If SCREEN.CreateObject("Info") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB102110", "HOGA_INDEX", Index
	End If
End Sub

_AW_ONSEND_AW_
obj_10Hoga.Proc "SetDangaObject", "Main.OBJ_order.OBJ_odr.ed_jprc"
S1301.Data = SCREEN.Object("main.1301").Data

If g_ArrHogaCtrl(2).Visible = True Then
	obj_10Hoga.Send
End If

If UCase(TypeName( SCREEN.Object("main.cxMarket") )) <> "NOTHING" Then
SYSTEM.Trace "[IB1001E0][onSend] Change_MKGubn = " & SCREEN.Object("main.cxMarket").sMarket
	If Trim(SCREEN.Object("main.cxMarket").sMarket) = "통합" Then
		S1777.Data = "3"
		S17412.SetMKtype(3)
	ElseIf Trim(SCREEN.Object("main.cxMarket").sMarket) = "KRX" Then
		S1777.Data = "1"
		S17412.SetMKtype(1)
	ElseIf Trim(SCREEN.Object("main.cxMarket").sMarket) = "NXT" Then
		S1777.Data = "2"
		S17412.SetMKtype(2)
	End If
End If

