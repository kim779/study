Option Explicit

Const myFILE = "userconf.ini"
Const myMAP = "IB105041"


Call p_read_ini()


Sub read_ini(symb, gubn)
	Dim rdata, name, edt0, edt1
	rdata = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, symb))
	If rdata = "" Then
		Exit Sub
	End If

	If gubn = "E" Or gubn = "L" Then		'edit box, list box
		SCREEN.Object(symb).data = rdata
	ElseIf gubn = "C" Then					'check box

		SCREEN.Object(symb).checked = rdata
		If rdata = "1" Then
			name = "e_" & Mid(symb, 3, Len(symb) - 2)
			edt0 = name & "0"
			edt1 = name & "1"
			SCREEN.Object(edt0).enable = True
			SCREEN.Object(edt1).enable = True
		End If
	End If
End Sub

'화면정보 Read
Sub p_read_ini()
	If SCREEN.CreateObject("Info") Then
		SCREEN.IgnoreChange True

		Call read_ini("CO_SORT", "L")
		Call read_ini("ELWLP", "L")		'발행사
		Call read_ini("ELWUD", "L")		'기초자산
		Call read_ini("CBKCOD", "L")		'권리유형
		Call read_ini("JJIS", "L")			'잔존일

		Call read_ini("c_curr", "C")		'현재가검색 check
		Call read_ini("e_curr0", "E")		'현재가검색값0
		Call read_ini("e_curr1", "E")		'현재가검색값1
'
		Call read_ini("c_gvol", "C")		'거래량검색 check
		Call read_ini("e_gvol0", "E")		'거래량검색값0
		Call read_ini("e_gvol1", "E")		'거래량검색값1

		Call read_ini("c_rate", "C")		'등락율검색 check
		Call read_ini("e_rate0", "E")		'등락율검색값0
		Call read_ini("e_rate1", "E")		'등락율검색값1

		Call read_ini("c_hsga", "C")		'행사가검색 check
