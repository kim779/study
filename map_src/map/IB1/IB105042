	End If
End Sub


'gubn =1 일때 ed0, ed1 이 양수인수 체크
'ed0 이 ed1 보다 큰지 체크
Function check_number(ed0, ed1, gubn)
	Dim val0, val1

	check_number = False
	val0 = CDbl(ed0.data)
	val1 = CDbl(ed1.data)

	'양수값 체크
	If gubn = 1 Then
		If val0 < 0 Then
			MsgBox "양수를 입력하세요", , "조건에러"
			ed0.Setfocus()
			Exit Function
		End If
		If val1 < 0 Then
			MsgBox "양수를 입력하세요", , "조건에러"
			ed1.Setfocus()
			Exit Function
		End If
	End If

	'범위 체크
	If val1 < val0 Then
		val0 = Trim(ed0.text)
		MsgBox val0 & "  " & "보다 큰값을 입력하세요", , "조건에러"
		ed1.Setfocus()
		Exit Function
	End If

	check_number = True
End Function

Function send_check()

	send_check = False

	'현재가 범위 체크
	If c_curr.Checked = True Then
		If check_number(e_curr0, e_curr1, 1) = False Then
			Exit Function
		End If
	End If

	'거래량 범위 체크
	If c_gvol.Checked = True Then
		If check_number(e_gvol0, e_gvol1, 1) = False Then
			Exit Function
		End If
	End If

	'등락율 범위 체크
	If c_rate.Checked = True Then
		If check_number(e_rate0, e_rate1, 0) = False Then
			Exit Function
		End If
	End If

	'행사가 범위 체크
	If c_hsga.Checked = True Then
		If check_number(e_hsga0, e_hsga1, 1) = False Then
			Exit Function
		End If
	End If

	'프리미엄 범위 체크
	If c_prim.Checked = True Then
		If check_number(e_prim0, e_prim1, 0) = False Then
			Exit Function
		End If
	End If


	'기어링 범위 체크
	If c_prty.Checked = True Then
		If check_number(e_prty0, e_prty1, 1) = False Then
			Exit Function
		End If
	End If


	'e*기어링 범위 체크
	If c_lvrg.Checked = True Then
		If check_number(e_lvrg0, e_lvrg1, 0) = False Then
			Exit Function
		End If
	End If


		'전환비율 범위 체크
	If c_jhre.Checked = True Then
		If check_number(e_jhre0, e_jhre1, 1) = False Then
			Exit Function
		End If
	End If


	send_check = True
End Function

