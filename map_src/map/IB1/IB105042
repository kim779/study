		Call read_ini("e_prim1", "E")		'프리미엄검색값1

		Call read_ini("c_prty", "C")		'기어링검색 check
		Call read_ini("e_prty0", "E")		'기어링검색값0
		Call read_ini("e_prty1", "E")		'기어링검색값1

