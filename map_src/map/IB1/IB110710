RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos, flag_date1, flag_date2

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0015"

SCREEN.OnSend = False

zIn.Data = "00001"

flag_date1 = "N"		'오늘보다 이후인지 확인
flag_date2 = "N"		'기간이 1개월 초과인지 확인

Dim loc, srtDt, EndDt
loc = Trim(SCREEN.Object("parent.dateSel").Text)
srtDt = Trim(SCREEN.Object("parent.zQrySrtDt").Data)
EndDt = Trim(SCREEN.Object("parent.zQryEndDt").Data)

Dim Today
Today = getCurrDay()

If CLng(srtDt) >= CLng(Today) Then
	srtDt = change_indate("d", -1, Date)
	srtDt = week_check(srtDt)

	flag_date1 = "Y"
	SCREEN.Object("parent.zQrySrtDt").Data = srtDt
End If

If CLng(EndDt) >= CLng(Today) Then
	EndDt = change_indate("d", -1, Date)
	EndDt = week_check(EndDt)

	flag_date1 = "Y"
	SCREEN.Object("parent.zQryEndDt").Data = EndDt
End If

zQrySrtDt.Data = srtDt
zQryEndDt.Data = EndDt

'조회기간 확인
'조회기간이 1개월이 넘으면 1개월로 세팅후
'onreceive에서 1개월 체크후 메세지 박스 띄움.
If loc <> "" Then
	Dim tmpDate

	If loc = "1" Then
		tmpDate = change_indate("m", 1, Trim(SCREEN.Object("parent.zQrySrtDt").Text))

		If CLng(tmpDate) < CLng(EndDt) Then
			flag_date2 = "Y"
			SCREEN.Object("parent.zQryEndDt").Data = tmpDate
			zQryEndDt.Data = tmpDate

			SCREEN.Object("parent.RADIO3").Checked = True
		End If
	Else
		tmpDate = change_indate("m", -1, Trim(SCREEN.Object("parent.zQryEndDt").Text))

		If CLng(tmpDate) > CLng(srtDt) Then
			flag_date2 = "Y"
			SCREEN.Object("parent.zQrySrtDt").Data = tmpDate
			zQrySrtDt.Data = tmpDate

			SCREEN.Object("parent.RADIO3").Checked = True
		End If
	End If
End If

Dim jmcd
jmcd = ""

If SCREEN.Object("parent.jmEnableChk").Checked = True Then
	jmcd = Trim(SCREEN.Object("parent.jmcd1104").Data)

	If Len(Trim(jmcd)) = 6 Then
		If SCREEN.GetCodeType(jmcd) = 9 Then
			jmcd = "J" & jmcd
		ElseIf SCREEN.GetCodeType(jmcd) = 27 Then
			jmcd = "Q" & jmcd
		Else
			jmcd = "A" & jmcd
		End If
	Else
		Call alert_msg("종목코드를 확인하여 주십시오.")
		SCREEN.Object("parent.jmcd1104").SetFocus
		Exit Sub
	End If
End If

zIsuNo.Data = jmcd
zAcntNo.Data = Trim(SCREEN.Object("parent.AN1A").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call alert_msg("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

zBnsTp.Data = Trim(SCREEN.Object("parent.zBnsTp").Data)
zRmnno.Data = ""
zStslOrdprcTp.Data = ""

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If Is_numeric(ecod) = False Then
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	SCREEN.Object("parent.next_btn").Enable = True
Else
	SCREEN.Object("parent.next_btn").Enable = False
End If

If Left(ecod, 1) = "0" Then
	Dim ii, jmcd, PtnNm, Mkgb, MktNm

	For ii = gridPos To GRID0.Rows
		jmcd = Trim(GRID0.GetGridCell(ii, 2))
		PtnNm = Trim(GRID0.GetGridCell(ii, 10))

		If Len(jmcd) = 7 And (Left(jmcd, 1) = "A" Or Left(jmcd, 1) = "J" Or Left(jmcd, 1) = "Q") Then
			jmcd = Mid(jmcd, 2)
		End If

		'20250417 전문변경 후 주문유형명 변경해줌
		'If Trim(PtnNm) = "01" Then
		'	GRID0.SetGridCell ii, 10, "스톱지정가"
		'ElseIf Trim(PtnNm) = "02" Then
		'	GRID0.SetGridCell ii, 10, "중간가"
		'ElseIf Trim(PtnNm) = "보통" Then
		'	GRID0.SetGridCell ii, 10, "지정가"
		'End If


		If Trim(PtnNm) <> "스톱지정가" Then '호가유형코드 스탑지정가
			GRID0.SetGridCell ii, 39, ""
			GRID0.SetGridCell ii, 42, ""
		End If

		GRID0.SetGridCell ii, 2, jmcd
		GRID0.SetGridCell ii, 3, jmcd


		'체결 거래소 데이터 변경
		Mkgb = Trim(GRID0.GetGridCell(ii, 43))
		If Mkgb <> "" Then
			Select Case Mkgb
				Case "KR" :
					GRID0.SetGridCell ii, 12, "KRX"
				Case "NX" :
					GRID0.SetGridCell ii, 12, "NXT"
				Case "SO" :
					GRID0.SetGridCell ii, 12, "SOR"
				Case "00" :
					GRID0.SetGridCell ii, 12, ""
			End Select

		End If
		'주문방식 중앙정렬 요청
		MktNm = Trim(GRID0.GetGridCell(ii, 38))
		If MktNm <> "" Then
			GRID0.SetGridCell ii, 38, MktNm
		End If




	Next
Else
	If ecod <> "2679" Then
		Call alert_msg(Trim(LEDGER.Emsg))
	End If
End If

If Trim(flag_date1) = "Y" Or Trim(flag_date2) = "Y" Then
	Dim aMsg1, aMsg2
	aMsg1 = "당일 내역은 조회가 불가능합니다."
	aMsg2 = "거래기간은 최대 1개월까지 조회가 가능합니다."

	If Trim(flag_date1) = "Y" And Trim(flag_date2) <> "Y" Then
		Call alert_msg(aMsg1)
	ElseIf Trim(flag_date1) <> "Y" And Trim(flag_date2) = "Y" Then
		Call alert_msg(aMsg2)
	ElseIf Trim(flag_date1) = "Y" And Trim(flag_date2) = "Y" Then
		Call alert_msg(aMsg1 & vbLf & vbLf & aMsg2)
	End If

	flag_date1 = "N"
	flag_date2 = "N"
End If

Dim pos
pos = Trim(SCREEN.Object("parent.sel").Text)

If pos = "" Then
	pos = "11"
End If

Select Case pos
	Case "1" : SCREEN.Object("parent.AN1A").SetFocus
	Case "2" : SCREEN.Object("parent.zPwd").SetFocus
	Case "3" : SCREEN.Object("parent.zBnsTp").SetFocus
	Case "4" : SCREEN.Object("parent.jmcd1104").SetFocus
	Case "5" : SCREEN.Object("parent.zQrySrtDt").SetFocus
	Case "6" : SCREEN.Object("parent.zQryEndDt").SetFocus
	Case "7" : SCREEN.Object("parent.RADIO0").SetFocus
	Case "8" : SCREEN.Object("parent.RADIO1").SetFocus
	Case "9" : SCREEN.Object("parent.RADIO2").SetFocus
	Case "10" : SCREEN.Object("parent.RADIO3").SetFocus
	Case "11" : SCREEN.Object("parent.send_btn").SetFocus
	Case "12" : SCREEN.Object("parent.next_btn").SetFocus
End Select

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim jmcd
jmcd = Trim(GRID0.GetGridCell(GRID0.Row, 3))

If Len(jmcd) <> 6 Then
	Exit Sub
End If

S1301.Data = jmcd
S1301.Trigger "", True
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



