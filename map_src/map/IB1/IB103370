	Dim dmsg
	dmsg = "o_acno" & vbTab & zAcntNo.Data & vbLf &_
			"o_acnm" & vbTab & zAcnm.Data & vbLf &_
			"o_hnam" & vbTab & Trim(SCREEN.Object("main.obj_grid.grid0").GetGridCell(SCREEN.Object("main.obj_grid.grid0").row, 2)) & vbLf &_
			"o_cqty" & vbTab & Trim(lRfundQty.Data) & vbLf &_
