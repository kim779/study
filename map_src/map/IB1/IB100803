Sub btn_Jung(bShow, rat, jumun_rat, memeunit)
	Dim accn, pswd2, cnt, code, jprc, s_data, jmsu, mkgb2, ret, mcsu, bMod, hogaunit, strPrice

	If Trim(pswd.Data) = "" Then
		MsgBox "계좌비밀번호를 입력하십시오."
		pswd.SetFocus
		Exit Sub
	End If

	cnt = 0

	en_accn.Data = Mid(AN1A.data, 1, 8)
	en_pswd.Data = SCREEN.Object("main.ed_pswd").Data
	pswd2 = SYSTEM.Encrypt(en_pswd.Data, en_accn.Data)

	accn = AN1A.data										'계좌번호
	mkgb2 = ""

	For ii = 1 To VIEWGRID.Rows
		bMod = False

		If VIEWGRID.GetGridCell(ii ,1) = 1 Then
			cnt = cnt + 1
			ret = s_chk_elw_price(mkgb2, code, VIEWGRID, ii)
			If ret = True Then
	'			code = VIEWGRID.GetGridCell(ii, 6)			'종목코드
				If SCREEN.GetCodeType(VIEWGRID.GetGridCell(ii, 7)) = "9" Then
				     code = "J" & VIEWGRID.GetGridCell(ii, 7)   '종목코드
				Else
				     code = VIEWGRID.GetGridCell(ii, 7)   '종목코드
				End If
				jprc = VIEWGRID.GetGridCell(ii, 12)			'주문가격(or 정정가격)
				jmsu = VIEWGRID.GetGridCell(ii, 13)			'주문수량
				jmnu = VIEWGRID.GetGridCell(ii, 4)			'주문번호
				jmna = VIEWGRID.GetGridCell(ii, 8)			'종목명
				mcsu = VIEWGRID.GetGridCell(ii, 17)			'미체결량

				mcsu = Int(Int(Int(mcsu) * Int(rat)) / 100)

				mcsu = Int(Int(CDbl(mcsu) /Int(memeunit)) * Int(memeunit))	'매매 유닛으로 나눈다.

				s_data = "#" & s_data
				s_data = ii & "|" & s_data					'ii			16
				s_data = "X" & "|" & s_data					'처리구분	15
				s_data = "2" & "|" & s_data					'모두구분	14
				s_data = "0" & "|" & s_data					'주문조건	13
				s_data = "00" & "|" & s_data				'호가구분	12
'				s_data = jprc & "|" & s_data				'주문가격	11

				If jumun_rat <> "" Then
					hogaunit = get_hoga_unit(jprc, code)

					If Int(CDbl(jprc) + CDbl(CDbl(jprc) * Int(jumun_rat) / 100)) Mod Int(hogaunit) <> 0 Then '나머지가 0이 아니면 ((몫) * 호가유닛))
						strPrice = Int(Int(CDbl(jprc) + CDbl(CDbl(jprc) * Int(jumun_rat) / 100)) / Int(hogaunit)) * Int(hogaunit)
						bMod = True
					Else
						strPrice = Int(CDbl(jprc) + CDbl(CDbl(jprc) * Int(jumun_rat) / 100))
					End If

					If bMod = True And Trim(VIEWGRID.GetGridCell(ii, 9)) = "매도" Then
						strPrice = strPrice + get_hoga_unit(strPrice, code)
					Else
						strPrice = strPrice
					End If

					s_data = strPrice & "|" & s_data		'주문가격	11

				Else
					s_data = ed_jprc.Data & "|" & s_data				'주문가격	11
				End If

				s_data = mcsu & "|" & s_data				'주문수량(정정, 취소수량)	10
				s_data = jmna & "|" & s_data				'종목명		9
				s_data = code & "|" & s_data				'종목코드	8
				s_data = jmnu & "|" & s_data				'주문번호	7
				s_data = pswd2 & "|" & s_data				'비밀번호	6
				s_data = accn & "|" & s_data				'계좌번호	5
				s_data = "3" & "|" & s_data					'매매구분	4
				s_data = mkgb2 & "|" & s_data				'시장구분	3
				s_data = "1" & "|" & s_data					'주문유형	2
				s_data = "1" & "|" & s_data					'CUD		1
			End If
		End If
	Next

	num.data = cnt

	If cnt > 0 Then
		If bShow Then
			num.Push ""
			SCREEN.CreateWindow 2, "IB100807 /p5 /d", "s_data" & vbTab & s_data & vbLf & "AN1A" & vbTab & AN1A.Data & vbLf & "pswd" & vbTab & SCREEN.Object("main.ed_pswd").Data
			clear_check()
		Else
			num.Push ""
			SCREEN.Object("main.OBJ_Jung.s_data").Data = s_data
			SCREEN.Object("main.OBJ_Jung.AN1A").Data = AN1A.Data
			SCREEN.Object("main.OBJ_Jung.pswd").Data = SCREEN.Object("main.ed_pswd").Data
			SCREEN.Proc "main.OBJ_Jung.btn_Order", ""
			clear_check()
		End If
	End If

	If chkcnt() = False Then
		BUTTON0.Enable = False
		BUTTON2.Enable = False
	Else
		BUTTON0.Enable = True
		BUTTON2.Enable = True
	End If
End Sub

