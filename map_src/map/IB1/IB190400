RESOURCE DIVISION
{


_AW_ONDECLARE_AW_

Sub RemoveNonGroupingRows()
	OBJ_GRP.Proc "RemoveNonGroupingRows", "parent.GRID0,2"
End Sub

Sub EndQueryGroup(Mode)
	If Mode = 1 Then
		SCREEN.Proc "OBJ_GRP.StrQueryGroupList", "COMBO0"
	Else
		'Call Send_f()
	End If
End Sub

Sub setparam()
	If RADIO0.Checked Then
		qtyp.Data = "2"
		gpno.Data = ""
		acno.Data = ""
	ElseIf RADIO1.Checked Then
		qtyp.Data = "2"
		gpno.Data = COMBO0.Data
		acno.Data = ""
	ElseIf RADIO2.Checked Then
		qtyp.Data = "1"
		gpno.Data = ""
		acno.Data = cmb_acnt.Data
	End If
End Sub

Sub Send_f()
	setparam()

	If RADIO2.Checked = True And Trim(cmb_acnt.Data) = "" Then
		MsgBox "특정계좌를 확인하십시오.", , "IBK투자증권"
		cmb_acnt.SetFocus
		Exit Sub
	End If

	Dim ii
	'SYSTEM.Trace "Send_f"
	'SCREEN.ClearAll 0, 2
	For ii=0 To 5
		SCREEN.Object("OBJ_BOTTOM.OUTSUM"&ii).Data = 0
	Next
	GRID0.Clear
	LEDGER.Rcnt = "0035"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub Send_c()

	GRID0.SetDataPosition 2
	LEDGER.Rcnt = "0035"
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

Sub accn_list_done()
	Dim grid, item
	item = ""
	Set grid = SCREEN.Object("main.acnt_all.GRID0")
	For ii=1 To grid.Rows
		acnt = Trim(grid.GetGridCell(ii, 1))
		acnm = Trim(grid.GetGridCell(ii, 2))
		If acnt="" Then
			Exit For
		End If
		txt = Mid(acnt,1,3) & "-" & Mid(acnt, 4, 2) & "-" & Mid(acnt, 6) & "  " & Split(acnm, "|")(0)
		item = item & acnt & txt & vbTab
		If ii=1 Then
