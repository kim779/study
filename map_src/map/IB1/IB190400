Sub SaveLog(sLog)

    Dim Stuff, myFSO, WriteStuff, sDate

    sDate = "[" & Now & "] "

	Set myFSO = CreateObject("Scripting.FileSystemObject")
	Set WriteStuff = myFSO.OpenTextFile("IB1904_Log.dat", 8, True)
	WriteStuff.WriteLine(sDate & sLog)
	WriteStuff.Close
	Set WriteStuff = Nothing
	Set myFSO = Nothing

End Sub

