_AW_ONDECLARE_AW_
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'SACMT207 비밀번호검증TR

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
Dim acnt
SCREEN.OnSend = False
SYSTEM.Trace "IB120920 send"
IntaccNo.Data = SCREEN.Object("parent.AN1A").Data
Pwd.Data = SCREEN.Object("parent.zPwd").Data

If SYSTEM.UserPass <> Trim(Pwd.Data) Then
	If Trim(Pwd.Data) <> "HEAD" And Len(Trim(Pwd.Data)) >= 4 Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(Pwd.Data))
		Pwd.Data = "HEAD"
	ElseIf Trim(Pwd.Data) = "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = Trim(SCREEN.Object("parent.LEDGER").EPwd)
		Pwd.Data = "HEAD"
	End If

	If Trim(Pwd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			SCREEN.Object("parent.zPwd").Data = ""
			SCREEN.Object("parent.zPwd").SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If
End If


If Len(Trim(IntaccNo.Data)) < 11 Then
	MsgBox "계좌번호를 확인하세요.", , "IBK투자증권"
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

If Len(Trim(Pwd.Data)) < 4 Then
	MsgBox "비밀번호를 확인하세요.", , "IBK투자증권"
	SCREEN.Object("parent.zPwd").SetFocus
	Exit Sub
End If


acnt = Trim(IntaccNo.Data)
acnt = Mid(acnt,1,3) & "00" & Mid(acnt, 6, 6)
IntaccNo.Data = acnt

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(LEDGER.Ecod, 1) = "0" Then
	SCREEN.Object("parent.GUIDE").Text = Trim(LEDGER.Emsg)
	SCREEN.SetTimer 2, False
Else
	SCREEN.Object("parent.zPwd").Data = ""
	SCREEN.Object("parent.zPwd").SetFocus
	SCREEN.Object("parent.GUIDE").Text = Trim(LEDGER.Emsg)
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
SCREEN.Proc "parent.popup_jango", ""

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


