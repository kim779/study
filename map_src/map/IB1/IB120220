Function chkNumData(num)
	chkNumData = False

	If Trim(num) = "" Then
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Exit Function
	End If

	chkNumData = True
End Function

Sub SetGridTextColor(row, col, data)
	Dim tColor

	If data > 0 Then
		tColor = "94"
	ElseIf data < 0 Then
		tColor = "95"
	Else
		tColor = "69"
	End If

	GRID0.SetTRgb row, col, tColor
End Sub


