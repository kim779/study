'수수료에 따른 계산
Sub SetCal()
	Dim presentCost, RemainQty, hfee, rate, buyCost, resultCost, sum, sooikRate, pyunggaCost, maeipCost, hTax, hFee_save
	Dim maeipRate, maeipfee, creditMoney
	Dim code, chcode, codx
	Dim ii, gubn
	Dim machaeFee, machaeFee_save

'제세금 = 현재가 * 수량 * 0.003
'수수료 = 현재가 * 수량 * 매체수수료율

'평가금액 계산시 수수료 = 10원단위미만 절삭(현재가 * 수량 * 수수료율)
'평가금액 계산시 제세금 = 원단위미만 반올림(현재가 * 잔고 * 0.003)
'평가금액 = 수수료미적용 평가금액 - (수수료 + 제세금 + 세이브수수료(있을경우))

'매입금액 계산시 수수료 = 10원단위미만 절삭(매입평균가 * 수량 * 수수료율)
'매입금액 = 수수료미적용 매입금액 + (수수료 + 세이브수수료(있을경우))

'평가손익 = 평가금액 - 매입금액
'수익률 = (( 평가금액 - 매입금액 ) / (매입금액 - 신용금액)) * 100

'ELW와 ETF는 수수료만 계산
'비상장일때 수수료 및 제세금 제외
'상장폐지일때 제세금 계산 제외
'매입평균가가 0원 이하인 경우 수수료 제외
'매입가가 0원 이하인 경우 save수수료는 계산에서 제외
'채권일 경우 현재가가 없으면 평가손익, 수익률 0% 로 표시

	sum = 0

	For ii = gridPos To GRID0.Rows
		presentCost = Trim(GRID0.GetGridCell(ii, 18))					'현재가
		RemainQty = Trim(GRID0.GetGridCell(ii, 7))						'잔고수량
		maeipCost =	Trim(GRID0.GetGridCell(ii, 45))						'매입금액
		pyunggaCost	= Trim(GRID0.GetGridCell(ii, 35))					'평가금액
		buyCost = Trim(GRID0.GetGridCell(ii, 27))						'매입평균가
		creditMoney = Trim(GRID0.GetGridCell(ii, 20))					'신용금액
		code = Trim(GRID0.GetGridCell(ii, 1))
		codx = code
		gubn = Trim(GRID0.GetGridCell(ii, 5))							'구분

		If Len(code) = 7 Then
			If Left(code, 1) = "A" Or Left(code, 1) = "J" Or Left(code, 1) = "Q" Then
				codx = Mid(code, 2)
			End If
		End If

		GRID0.SetGridCell ii, 2, codx

		If chkNumData(presentCost) = False Then
			presentCost = 0
		Else
			presentCost = CCur(presentCost)
		End If

		If chkNumData(RemainQty) = False Then
			RemainQty = 0
		Else
			RemainQty = CCur(RemainQty)
		End If

		If chkNumData(maeipCost) = False Then
			maeipCost = 0
		Else
			maeipCost = CCur(maeipCost)
		End If

		If chkNumData(pyunggaCost) = False Then
			pyunggaCost = 0
		Else
			pyunggaCost = CCur(pyunggaCost)
		End If

		If chkNumData(buyCost) = False Then
			buyCost = 0
		Else
			buyCost = CCur(buyCost)
		End If

		If chkNumData(creditMoney) = False Then
			creditMoney = 0
		Else
			creditMoney = CCur(creditMoney)
		End If

		machaeFee = Trim(fee.Data)					'수수료율
		hFee_save = Trim(fee_save.Data)			'세이브 수수료

		hFee = presentCost * RemainQty * machaeFee 							'수수료(현재가 기준)
		hFee = Fix(hFee)
		hFee = ((Fix(hFee / 10)) * 10) + hFee_save

		hTax = presentCost * RemainQty * 0.003								'제세금(현재가 기준)
		hTax = Round(hTax)													'제세금은 소숫점 첫째자리에서 반올림

		If buyCost <> 0 Then
			If RemainQty <> 0 Then
			    maeipRate = (buyCost * RemainQty * machaeFee)   					'수수료 = 현재가 * 수량 * 수수료율
				maeipRate = Fix(maeipRate)
				maeipRate = ((Fix(maeipRate / 10)) * 10) + hFee_save
			Else
				maeipRate = 0
			End If
		Else
			maeipRate = 0
		End If

		If maeipCost <> 0 Then
			maeipCost = maeipCost + maeipRate	'매입금액(수수료 포함)
		Else
			maeipCost = 0
		End If

		GRID0.SetGridCell ii, 46, maeipCost

		If maeipCost = 0 Then
			hFee = hFee - hFee_save
		End If

		If Len(code) = 7 Then
			If SCREEN.GetCodeType(codx) = 9 Or SCREEN.GetCodeType(codx) = 6 Then	'ELW와 ETF는 수수료만 계산
				If InStr(gubn, "비상장") > 0 Then
					pyunggaCost = pyunggaCost
				Else
					pyunggaCost = pyunggaCost - (hFee)						'평가금액
				End If
			Else
				If buyCost > 0 Then
					If InStr(gubn, "비상장") > 0 Then
						pyunggaCost = pyunggaCost
					ElseIf InStr(gubn, "상장폐지") > 0 Then
						pyunggaCost = pyunggaCost - (hFee)
					Else
						pyunggaCost = pyunggaCost - (hFee + hTax)
					End If
				Else
					'매입평균가가 0원 이하일 경우 수수료 계산 제외
					If InStr(gubn, "비상장") > 0 Or InStr(gubn, "상장폐지") > 0Then
						pyunggaCost = pyunggaCost
					Else
						pyunggaCost = pyunggaCost - (hTax)
					End If
				End If
			End If
		Else
			If buyCost > 0 Then
				If InStr(gubn, "비상장") > 0 Then
					pyunggaCost = pyunggaCost
				ElseIf InStr(gubn, "상장폐지") > 0 Then
					pyunggaCost = pyunggaCost - (hFee)
				Else
					pyunggaCost = pyunggaCost - (hFee + hTax)
				End If
			Else
				'매입평균가가 0원 이하일 경우 수수료 계산 제외
				If InStr(gubn, "비상장") > 0 Or InStr(gubn, "상장폐지") > 0Then
					pyunggaCost = pyunggaCost
				Else
					pyunggaCost = pyunggaCost - (hTax)
				End If
			End If
		End If

		'채권일 경우, 현재가가 없으면 손익 0
		If presentCost = 0 And Len(Trim(GRID0.GetGridCell(ii, 1))) = 12 Then
			resultCost = 0															'매도손익금액
		Else
			resultCost = pyunggaCost - maeipCost									'매도손익금액
		End If

		'채권일 경우, 현재가가 없으면 손익률 0
		If presentCost = 0 And Len(Trim(GRID0.GetGridCell(ii, 1))) = 12 Then
			sooikRate = 0.00
		Else
			If maeipCost = 0 And  creditMoney = 0 Then
				sooikRate = 0.00
			Else
				If (maeipCost - creditMoney) <> 0 Then
					sooikRate = ((pyunggaCost - maeipCost) / (maeipCost - creditMoney )) * 100
				Else
					sooikRate = 0.00
				End If
			End If
		End If

		GRID0.SetGridCell ii, 36, pyunggaCost									'평가금액
		GRID0.SetGridCell ii, 17, FormatNumber(sooikRate, 2, -1, 0, 0) & "%"	'손익률
		Call SetGridTextColor(ii, 17, sooikRate)

		GRID0.SetGridCell ii, 15, resultCost									'매도손익금액
		Call SetGridTextColor(ii, 15, resultCost)
	Next

	gridPos = ii
End Sub

Sub SetTotal()
	Dim ii, TotalMaeip, TotalPyungga, TotalCredit, maeipCost, pyunggaCost, creditMoney, D2Dps
	TotalMaeip = 0
	TotalPyungga = 0
	TotalCredit = 0

	For ii = 1 To GRID0.Rows
		maeipCost = 0
		pyunggaCost = 0
		creditMoney = 0

		maeipCost = Trim(GRID0.GetGridCell(ii, 46))
		pyunggaCost = Trim(GRID0.GetGridCell(ii, 36))
		creditMoney = Trim(GRID0.GetGridCell(ii, 20))

		If chkNumData(maeipCost) = False Then
			maeipCost = 0
		End If

		If chkNumData(pyunggaCost) = False Then
			pyunggaCost = 0
		End If

		If chkNumData(creditMoney) = False Then
			creditMoney = 0
		End If

		TotalMaeip = TotalMaeip + maeipCost
		TotalPyungga = TotalPyungga + pyunggaCost
		TotalCredit = TotalCredit + creditMoney
	Next

	If chkNumData(zD2Dps.Data) = True Then
		D2Dps = Trim(zD2Dps.Data)
	Else
		D2Dps = 0
	End If

	OUTPUT0.Data = TotalMaeip
	OUTPUT1.Data = TotalPyungga - TotalCredit
	OUTPUT2.Data = D2Dps
	OUTPUT3.Data = D2Dps + TotalPyungga - TotalCredit
End Sub

