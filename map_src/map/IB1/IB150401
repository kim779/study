_AW_ONDECLARE_AW_
Dim gridPos
gridPos = 1

Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
SCREEN.Object("parent.GUIDE").Text = ""

AcntNo.Data = SCREEN.Object("parent.AN1A").Data
Pwd.Data = SCREEN.Object("parent.zPwd").Data

LoanDt.Data = SCREEN.Object("parent.LoanDt").Data
QryBaseDt.Data = SCREEN.Object("parent.QryBaseDt").Data
LoanPtnCode.Data = SCREEN.Object("parent.LoanPtnCode").Data
IsuNo.Data = SCREEN.Object("parent.IsuNo").Data

If Len(Trim(AcntNo.Data)) < 11 Then
	MsgBox "계좌번호를 확인하세요.", , "IBK투자증권"
	SCREEN.Object("parent.AN1A").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = "0" Then
	Pwd.Data = "9999"
	SCREEN.Object("parent.zPwd").Data = "9999"
End If

If SYSTEM.ConnectBy = "1" Then
	If Len(Trim(Pwd.data)) < 4 Then
		MsgBox "비밀번호를 확인하세요.", , "IBK투자증권"
		SCREEN.Object("parent.zPwd").SetFocus
		Exit Sub
	End If
End If

If  SCREEN.Object("parent.GRID0").rows = 0 Then
	MsgBox "계좌종목잔고현황을 확인하세요.", , "IBK투자증권"
	SCREEN.OnSend = False
Else
	SCREEN.OnSend = True
End If

'zQryTp.Data = SCREEN.Object("parent.zQryTp").Data
'zCmsnAmtAppTp.Data = SCREEN.Object("parent.zCmsnAmtAppTp").Data

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim i
Dim data, data2, data3
For i = 1 To GRID0.Rows
	data = FormatNumber(Trim(GRID0.GetGridCell (i, 4))*100, 2, 0, 0, 0)
	data2 = FormatNumber(Trim(GRID0.GetGridCell (i, 5))*100, 2, 0, 0, 0)

	GRID0.SetGridCell i, 4, data & "%"
	GRID0.SetGridCell i, 5, data2 & "%"
Next

If Len(Trim(GrdtnIntrat.Data)) > 0 Then
data3 = FormatNumber(Trim(GrdtnIntrat.Data)*100, 2, 0, 0, 0)
GrdtnIntrat.Data =  data3 & "%"
End If

