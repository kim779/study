_AW_ONDECLARE_AW_
Public start
start = 1

Const file = "newsinfo.ini"

Function ReadConf()
	If SCREEN.CreateObject("Info") Then
	 	ReadConf = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "ITEMS"))
	Else
		ReadConf = ""
	End If
End Function

Sub Onalert()
	Dim	v_gubn
	Dim	v_name
	Dim strKeys
	Dim v_subgubn

	TABLE0.Row = 4

	If Trim(TABLE0.data) = "" Then
		Exit Sub
	End If

	SYSTEM.Trace "TABLE0.data : " &  Trim(TABLE0.data)
	SYSTEM.Trace "cod2.data : " &  Trim(cod2.data)
	If Trim(TABLE0.data) <> Trim(S1301.data) Then
		Exit Sub
	End If

	If Trim(TABLE0.data) = Trim(S1301.data) Then

		'메인 뉴스 버튼 N->Y 변경 '메인에 제목 보내기
		SCREEN.Object("parent.newsViewBtn").Visible = True
		SCREEN.Object("parent.news_output").Visible = True
		SCREEN.Object("parent.news_output").Blink True, 66
		SCREEN.Object("parent.news_output").Data = " " + TABLE0.GetTableCell(2)
		SCREEN.Object("parent.keyv_temp").Data = TABLE0.GetTableCell(11)
		SCREEN.Proc "parent.change_bg", ""
	End If

	TABLE0.Row = 8
	If Trim(TABLE0.Data) = "" Then
		Exit Sub
	End If

	If IsNumeric(TABLE0.Data) = False Then
		Exit Sub
	End If

	v_gubn = CLng(TABLE0.Data)

	If v_gubn < 1 And v_gubn > 20 Then
		Exit Sub
	End If

	Select Case v_gubn
	Case 1
		If GUBN1.Checked = False Then
			Exit Sub
		End If
		v_name = "시황"
	Case 2
		If GUBN2.Checked = False Then
			Exit Sub
		End If
		v_name = "공시"

		TABLE0.Row = 9
		v_subgubn = TABLE0.Data

		If v_subgubn = 99 Then
			v_name = "코스닥공시"
		ElseIf v_subgubn = 88 Then
			v_name = "프리보드공시"
		Else
			v_name = "거래소공시"
		End If
	Case 3
		If GUBN3.Checked = False Then
			Exit Sub
		End If
		v_name = "이투데이"
	Case 4
		If GUBN4.Checked = False Then
			Exit Sub
		End If
		v_name = "시황속보"
	Case 5
		If GUBN5.Checked = False Then
			Exit Sub
		End If
		v_name = "전자신문"
	Case 6
		If GUBN6.Checked = False Then
			Exit Sub
		End If
		v_name = "이데일리"
	Case 7
		If GUBN7.Checked = False Then
			Exit Sub
		End If
		v_name = "월드인덱스"
	Case 8
		If GUBN8.Checked = False Then
			Exit Sub
		End If
		v_name = "연합뉴스"
	Case 9
		If GUBN9.Checked = False Then
			Exit Sub
		End If
		v_name = "머니투데이"
	Case 10
		If GUBN10.Checked = False Then
			Exit Sub
		End If
		v_name = "한경뉴스"
	Case 11
		If GUBN11.Checked = False Then
			Exit Sub
		End If
		v_name = "매경뉴스"
	Case 12
		If GUBN12.Checked = False Then
			Exit Sub
		End If
		v_name = "아시아경제"
	Case 13
		If GUBN13.Checked = False Then
			Exit Sub
		End If
		v_name = "헤럴드경제"
	Case 14
		If GUBN14.Checked = False Then
			Exit Sub
		End If
		v_name = "촉n토크"
	Case 15
		If GUBN15.Checked = False Then
			Exit Sub
		End If
		v_name = "IR GO"
	Case 16
		If GUBN16.Checked = False Then
			Exit Sub
		End If
		v_name = "컨슈머타임스"
	Case 17
		If GUBN17.Checked = False Then
			Exit Sub
		End If
		v_name = "뉴스웨이"
	End Select

	strKeys = editFilter.Data

	If InStr(strKeys,v_name) < 1 Then
		Exit Sub
	End If

	' add GRID row
	GRID0.InsertRow 0

	' set GRID data
	TABLE0.Row = 6		' TIME
	GRID0.SetGridCell 1, 2, TABLE0.Data
	TABLE0.Row = 8		'
	GRID0.SetGridCell 1, 3, v_name
	TABLE0.Row = 2		' TITLE
	GRID0.SetGridCell 1, 4, TABLE0.Data
	TABLE0.Row = 3		' RECN
	GRID0.SetGridCell 1, 5, TABLE0.Data
	TABLE0.Row = 10		' flag
	GRID0.SetGridCell 1, 6, TABLE0.Data
	TABLE0.Row = 11		' keyv
	GRID0.SetGridCell 1, 7, TABLE0.Data
	GRID0.SetGridCell 1, 1, Mid(TABLE0.Data, 1, 8)

	TABLE0.Data = ""
	GRID0.Index = 0
'	If GRID0.Index < 1000 Then
'		GRID0.Index = GRID0.Index + 1
'	End If
End Sub

Sub click_grid()
		Dim	key_value, key_text
		key_value = GRID0.GetGridCell(GRID0.Row, 7)
		If Trim(key_value) <= "" Then
			Exit Sub
		End If
		key_text = GRID0.GetGridCell(GRID0.Row, 4)
		If Trim(key_text) <= "" Then
			Exit Sub
		End If

		key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.
		SCREEN.CreateWindow 4, "IBNEWSXX /S/d/p1", "015"& vbTab & key_text & vbLf & _
			"016" & vbTab & key_value & vbLf & "1301" & vbTab & SCREEN.Object("parent.1301").Data

'		keyv.text = key_value
'		SCREEN.Object("OBJ1.isrn").data = recn
'		OBJ1.send
End Sub

