RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub EndQueryGroup(flag)
	If flag=1 Then
		OBJ_group.Proc "QueryGroupList", "parent.CB_GROUP"
		GetAccounts()
	End If
End Sub

Sub GetAccounts()
	OBJ_group.Proc "QueryAccountList", CB_GROUP.Data & "," & "parent.GD_ACCNTS"
	If tab_accn.ID = 2 Or tab_accn.ID = 2 Then
		GetSubAccounts()
	End If
End Sub

Sub GetSubAccounts()
	OBJ_group.Proc "StrQueryAcntList", CB_GROUP.Data&",2,OBJ_accn.acgrid,OBJ_accn.cmb_acnt"
End Sub

Sub send_sise_all(xval)
	SCREEN.IgnoreChange True

	S1301.Trigger "", True
	SCREEN.Object("OBJ_sise.1301").data = Trim(S1301.Data)
	SCREEN.Object("OBJ_sise2.1301").data = Trim(S1301.Data)
	SCREEN.Object("OBJ_accn.1301").data = Trim(S1301.Data)
	OBJ_sise.Send
	OBJ_sise2.Send

	' 주문탭이면 그리드 클리어.
	If tab_accn.ID=1 Then
		SCREEN.Proc "OBJ_accn.MyChangeCode", ""
	End If

	SCREEN.IgnoreChange False
End Sub

Sub tab_accn_change(id)
	Dim map
	If id=1 Then
		map = "IB190130"
	ElseIf id=2 Then
		map = "IB190170"
	ElseIf id=3 Then
		map = "IB190171"
	End If

	If id<>1 Then
		BTN_MASU.Visible = False
		BTN_MADO.Visible = False
	End If

	tab_accn.ID = id
	If map<>OBJ_accn.GetObject() Then
		OBJ_accn.SetObject map
	End If
End Sub


Sub SetPrice(prc)
	If tab_accn.ID=1 Then
		SCREEN.Proc "OBJ_accn.SetPrice", prc
	End If
End Sub

Sub SetOrderGrid()
	If tab_accn.ID<>1 Then
		Exit Sub
	End If

	If mmgb.Data = "1" Then
		BTN_MADO.Visible = True
		BTN_MASU.Visible = False
	ElseIf mmgb.Data = "2" Then
		BTN_MADO.Visible = False
		BTN_MASU.Visible = True
	Else
		BTN_MADO.Visible = False
		BTN_MASU.Visible = False
	End If

	SCREEN.Proc "OBJ_accn.SetOrderGrid", ""
End Sub

Sub CheckDanjuBtn()
	If tab_order.ID=1 And tab_accn.Id=1 Then
		CHK_DANJU.Visible = True
	Else
		CHK_DANJU.Visible = False
	End If
End Sub

_AW_SCRIPT_AW_(tab_accn)
_AW_ONCLICK_AW_
Call tab_accn_change(tab_accn.ID)
Call CheckDanjuBtn()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CB_GROUP)
_AW_ONCHANGE_AW_
Call GetAccounts
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN01)
_AW_ONCLICK_AW_

OBJ_group.Proc "Refresh"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_order)
_AW_ONCLICK_AW_

If tab_order.ID=1 Then
	OBJ_odr.SetObject "IB190111"
Else
	OBJ_odr.SetObject "IB190112"
End If

Call CheckDanjuBtn()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(tab_sise)
_AW_ONCLICK_AW_
Select Case tab_sise.ID
Case 0 : OBJ_sise2.SetObject "IB100110"
		OPEN_BTN1.Visible = False
Case 1 : OBJ_sise2.SetObject "IB100111"
		OPEN_BTN1.Visible = True
Case 2 : OBJ_sise2.SetObject "IB100112"
		OPEN_BTN1.Visible = True
Case 3 : OBJ_sise2.SetObject "IB100113"
		OPEN_BTN1.Visible = True
Case 4 : OBJ_sise2.SetObject "IB100114"
		OPEN_BTN1.Visible = False
Case 5 : OBJ_sise2.SetObject "IB100115"
		OPEN_BTN1.Visible = True
End Select
OBJ_sise2.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(OPEN_BTN1)
_AW_ONCLICK_AW_
Select Case tab_sise.ID
Case 1
        SCREEN.CreateWindow 1, "IB200700 /t/d/p5/S", _
		"1301" & vbTab & S1301.data
Case 2
        SCREEN.CreateWindow 1, "IB201100 /t/d/p5/S", _
        "1301" & vbTab & S1301.Data & vbLf
Case 3
        SCREEN.CreateWindow 1, "IB230100 /t/d/s/p5", _
        "1301" & vbTab & S1301.Data
Case 5
         SCREEN.CreateWindow 1, "IB711200 /t/d/p5/S", _
        "1301" & vbTab & S1301.Data
Case Else
         Exit Sub
End Select
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(CHK_DANJU)
_AW_ONCLICK_AW_

If tab_accn.ID = 1 Then
	SCREEN.Proc "OBJ_accn.SetDanju", "" & CHK_DANJU.Checked
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_MADO)
_AW_ONCLICK_AW_
SCREEN.Proc "OBJ_accn.SendOrder", mmgb.Data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BTN_MASU)
_AW_ONCLICK_AW_
SCREEN.Proc "OBJ_accn.SendOrder", mmgb.Data
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


