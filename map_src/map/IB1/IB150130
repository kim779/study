' -- TR 보내기전 입력 필드 확인

SCREEN.OnSend = False

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
Else
	If Trim(SYSTEM.UserPass) <> Trim(zPwd.Data) Then
		If Len(Trim(zPwd.Data)) >= 4 And Trim(zPwd.Data) <> "HEAD" Then
			LEDGER.Hsiz = 44
			LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
			zPwd.Data = "HEAD"
		End If
	End If

	If Trim(zPwd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
			zPwd.Data = ""
			zPwd.SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If

End If

If CheckInput(AN1A, zPwd) = True Then
	SCREEN.onsend = True
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(LEDGER.Ecod, 1) <> "0" Then
	SCREEN.ClearAll 0, 2
	ACNM.Data = AN1A.Name
Else
	If Trim(dAppPldgRat.Data) <> "" Then
		dAppPldgRat.Data = dAppPldgRat.Data * 100
	End If

	If Trim(dCrdtPldgRat.Data) <> "" Then
		dCrdtPldgRat.Data = dCrdtPldgRat.Data * 100
	End If

	Select Case selection.Data
		Case "1"	zPwd.SetFocus()
		Case "2"	send_btn.SetFocus()
	End Select
End If

