'== 계좌명, 비밀번호 설정
Sub Set_account()
	Dim accn, pwd
	SCREEN.IgnoreChange True
	SCREEN.ClearAll 0, 2

	accn = SYSTEM.pop ("1501_ACC")
	pwd  = SYSTEM.pop ("1501_ACC_PWD")
	SYSTEM.Push "1501_ACC" , ""
	SYSTEM.Push "1501_ACC_PWD" , ""
	If Trim(accn) <> "" Then
		AN1A.Data = accn
		zPwd.Data = pwd
	Else
		zPwd.Data = AN1A.Password
	End If
	ACNM.Data = AN1A.Name

	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		SCREEN.IgnoreChange False
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			SCREEN.IgnoreChange False
			Exit Sub
		End If
	End If

	SCREEN.IgnoreChange False
	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ACNM.Data = AN1A.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
