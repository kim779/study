	RADIO0.Checked = True
	cmb_ordtype.Enable = False
	LABEL2.Visible = False
	CreditStrDt.Visible = False
	CreditStrDt.Clear
Else
	If szData = "03" Then
		RADIO1.Checked = True
		cmb_ordtype.Enable = True
		cmb_ordtype.Index = 1

	ElseIf szData = "01" Then
		RADIO1.Checked = True
		cmb_ordtype.Enable = True
		cmb_ordtype.Index = 0
	ElseIf szData = "80" Then
		RADIO2.Checked = True
		cmb_ordtype.Enable = False
