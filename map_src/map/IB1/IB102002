'매도 손실제한 예상가격 계산
Sub CalcTargetPrc_loss()
	'평균단가
	Dim avPrc
	avPrc = Trim(e_avprc.Data)

	If avPrc = "" Then
		edt_prc_1.Data = ""
		Exit Sub
	End If

	Dim nIndex, szCondData, TargetP
	'감시설정값
	szCondData = Trim(edt_cond_1.Data)
	If szCondData = "" Or szCondData = "0" Then
		edt_prc_1.Data = ""
		Exit Sub
	End If

	'0:현재가 1:주당손실 2:손실율
	nIndex = cmb_cond_1.Index

	If nIndex = 0 Then
		'현재가 감시는 예상 가격 필요없음
		edt_prc_1.Data = ""
		Exit Sub
	ElseIf nIndex = 1 Then
		'주당손실 예상가격 = 평균단가 - 감시 설정값
		TargetP = avPrc - szCondData
	ElseIf nIndex = 2 Then
		'손실율 예상가격 = 평균단가 * ((100 - 감시설정값) / 100)
		TargetP = avPrc * ((100 - szCondData) / 100.0)
	End If

	If TargetP > 0 Then
		'호가틱 다운틱 보정
		Dim szCalcPrc
		szCalcPrc = GetHogaPrc(E_shrt_cd.Data, TargetP, False)

		If CLng(Trim(edt_cond_1.Data))  <> 0 Then
			edt_prc_1.Data = Trim(FormatNumber(szCalcPrc,0)) & " 원"
		Else
			edt_prc_1.Data = ""
		End If
	Else
		edt_prc_1.Data = ""
	End If

End Sub
