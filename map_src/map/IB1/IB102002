		MsgBox "입력 가능한 범위를 초과했어요." & vbCrLf &"다시 입력해 주세요.", , "IBK투자증권"

		edt_prc_2.Data = ""
		edt_cond_3_1.Data = ""
		edt_cond_3_2.Data = ""
		Exit Sub
	End If

	If TargetP > 0 Then
		'호가틱 업틱 보정
		Dim szCalcPrc
		szCalcPrc = GetHogaPrc(E_shrt_cd.Data, TargetP, False)
		'고점 / 고점대비 설정값 둘다 있을때만 예상가격 보여줌
		If CLng(Trim(edt_cond_3_1.Data)) <> 0	And CLng(Trim(edt_cond_3_2.Data)) <> 0 Then
			edt_prc_3.Data = Trim(FormatNumber(szCalcPrc,0)) & " 원"
		Else
			edt_prc_3.Data = ""
		End If
	Else
		edt_prc_3.Data = ""
	End If

End Sub

Function KsGetHogaUnitUp(szCode, nBaseHoga)
' ---------------------------------------------------- */
' KOSPI/KOSDAQ     주식 상방 호가단위                  */
' ---------------------------------------------------- */
'   2,000원 미만 -------------------------->     1원   */
'   2,000원 ~  5,000원 미만---------------->     5원   */
'   5,000원 ~ 20,000원 미만---------------->    10원   */
'  20,000원 ~ 50,000원 미만---------------->    50원   */
'  50,000원 ~ 200,000원미만---------------->   100원   */
' 200,000원 ~ 500,000원 미만--------------->   500원   */
' 500,000원 이상 --------------------------> 1,000원   */
' ---------------------------------------------------- */
' ETF/ETN                                              */
' ---------------------------------------------------- */
'   2,000원 미만 -------------------------->     1원   */
'   2,000원 이상--------------------------->     5원   */
' ---------------------------------------------------- */
	KsGetHogaUnitUp = 0

	If nBaseHoga = "" Then
		nBaseHoga = 0
	Else
		nBaseHoga = CLng(nBaseHoga)
	End If
	'코스피:1  코스닥:2  ETF:6  ETN:27
	Dim szCheckType
	szCheckType = SCREEN.GetCodeType(szCode)
	If szCheckType = "6" Or szCheckType = "27" Then
		' ETF/ETN
		If nBaseHoga < 2000 Then
			KsGetHogaUnitUp = 1
		Else
			KsGetHogaUnitUp = 5
		End If
	Else
		'코스피/코스닥
		If nBaseHoga < 2000 Then
			KsGetHogaUnitUp = 1
		ElseIf nBaseHoga < 5000 Then
			KsGetHogaUnitUp = 5
		ElseIf nBaseHoga < 20000 Then
			KsGetHogaUnitUp = 10
		ElseIf nBaseHoga < 50000 Then
			KsGetHogaUnitUp = 50
		ElseIf nBaseHoga < 200000 Then
			KsGetHogaUnitUp = 100
		ElseIf nBaseHoga < 500000 Then
			KsGetHogaUnitUp = 500
		Else
			KsGetHogaUnitUp = 1000
		End If
	End If
End Function

Function KsGetHogaUnitDn(szCode, nBaseHoga)
' ---------------------------------------------------- */
' KOSPI/KOSDAQ     주식 하방  호가단위                  */
' ---------------------------------------------------- */
'   2,000원 미만 -------------------------->     1원   */
'   2,000원 ~  5,000원 미만---------------->     5원   */
'   5,000원 ~ 20,000원 미만---------------->    10원   */
'  20,000원 ~ 50,000원 미만---------------->    50원   */
'  50,000원 ~ 200,000원미만---------------->   100원   */
' 200,000원 ~ 500,000원 미만--------------->   500원   */
' 500,000원 이상 --------------------------> 1,000원   */
' ---------------------------------------------------- */
' ETF/ETN                                              */
' ---------------------------------------------------- */
'   2,000원 미만 -------------------------->     1원   */
'   2,000원 이상--------------------------->     5원   */
' ---------------------------------------------------- */
	KsGetHogaUnitDn = 0

	If nBaseHoga = "" Then
		nBaseHoga = 0
	Else
		nBaseHoga = CLng(nBaseHoga)
	End If

	If szCode = "" Or Len(Trim(szCode)) <> 6 Then
		Exit Function
	End If
	'코스피:1  코스닥:2  ETF:6  ETN:27
	Dim szCheckType
	szCheckType = SCREEN.GetCodeType(szCode)
	If szCheckType = "6" Or szCheckType = "27" Then
		' ETF/ETN
		If nBaseHoga <= 2000 Then
			KsGetHogaUnitDn = 1
		Else
			KsGetHogaUnitDn = 5
		End If
	Else
		'코스피/코스닥
		If nBaseHoga <= 2000 Then
			KsGetHogaUnitDn = 1
		ElseIf nBaseHoga <= 5000 Then
			KsGetHogaUnitDn = 5
		ElseIf nBaseHoga <= 20000 Then
			KsGetHogaUnitDn = 10
		ElseIf nBaseHoga <= 50000 Then
			KsGetHogaUnitDn = 50
		ElseIf nBaseHoga <= 200000 Then
			KsGetHogaUnitDn = 100
		ElseIf nBaseHoga <= 500000 Then
			KsGetHogaUnitDn = 500
		Else
			KsGetHogaUnitDn = 1000
		End If
	End If
End Function

'계산된 가격을 호가단위에 맞게 보정
'bUpTick = TRUE    -> UP틱 보정
'bUpTick = FALSE   -> DN틱 보정
Function GetHogaPrc(szCode, nHoga, bUpTick)
	Dim nHogaUnit, nTick, nCalcHoga
	nCalcHoga = 0
	GetHogaPrc = nCalcHoga
	If nHoga = "" Then
		nHoga = 0
	Else
		nHoga = CLng(nHoga)
	End If
	If szCode = "" Or Len(Trim(szCode)) <> 6 Then
		Exit Function
	End If

	'nHoga 한틱 호가틱 가져오기
	nHogaUnit = KsGetHogaUnitUp(szCode, nHoga)
	If nHogaUnit = 0 Then
		Exit Function
	End If
	'\(정수 나눗셈) 연산자
	'두 숫자를 나누어 정수 결과를 반환하는 데 사용합니다.
	nTick = nHoga \ nHogaUnit
	nCalcHoga = nTick * nHogaUnit

	If CLng(nCalcHoga) = CLng(nHoga) Then
		'호가단위에 맞는 가격 계산 불필요
		GetHogaPrc = nCalcHoga
	Else
		If bUpTick = True Then
			'nHoga에서 업틱
			nHogaUnit = KsGetHogaUnitUp(szCode, nHoga)
			GetHogaPrc = nCalcHoga + nHogaUnit
		Else
			'nHoga에서 다운틱
			nHogaUnit = KsGetHogaUnitDn(szCode, nHoga)
			GetHogaPrc = nCalcHoga '- nHogaUnit
		End If
	End If

End Function


