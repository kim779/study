'========================================================
'매도 조건 단건조회
'=======================================================
Sub LoadCond()
obj_cond.Clearall 0
SCREEN.Object("obj_cond.e_acnt_no").data = Trim(SCREEN.Object("main.AN5A").Data)
SCREEN.Object("obj_cond.e_sq").data = E_sq.Data
obj_cond.Send

End Sub

'========================================================
'주문유형에 따른 주문가격컨트롤 활성/비활성화
'=======================================================
Sub SetOrdPrcCtrlByOrdType()
	Dim bEnablePrc
	bEnablePrc = True
	If RADIO4.Checked = True Then
		'시장가
		bEnablePrc = False
	ElseIf RADIO5.Checked = True Then
		If cmb_hoga.Index = 1 Then
			'최유리 지정가
			bEnablePrc = False
		ElseIf cmb_hoga.Index = 2 Then
			'최우선 지정가
			bEnablePrc = False
		End If
	End If

	If bEnablePrc = True Then
		RADIO8.Enable = True
		RADIO9.Enable = True
		If RADIO8.Checked = True Then
			cmb_prc.Enable = True
			ed_jprc.Enable = False
		Else
			cmb_prc.Enable = False
			ed_jprc.Enable = True
		End If
	Else
		InitCondCtrls("ORD_PRC")
		cmb_prc.Enable = False
		ed_jprc.Enable = False
		RADIO8.Enable = False
		RADIO9.Enable = False
	End If

End Sub

