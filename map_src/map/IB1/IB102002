Sub CalcTargetPrc_TS()
'평균단가
	Dim avPrc
	avPrc = Trim(e_avprc.Data)

	If avPrc = "" Then
		edt_prc_3.Data = ""
		Exit Sub
	End If

	Dim nIndex, szCondData, TargetP
	'감시설정값
	szCondData = Trim(edt_cond_3_1.Data)
	If szCondData = "" Or szCondData = "0" Then
		edt_prc_3.Data = ""
		Exit Sub
	End If

	'0:현재가 1:주당이익 2:이익율
	nIndex = cmb_cond_3_1.Index


	If nIndex = 0 Then
		'현재가 감시는 해당 가격이 고점
		TargetP = szCondData
	ElseIf nIndex = 1 Then
		'주당이익 예상가격 = 평균단가 + 감시 설정값
		TargetP = CLng(avPrc) + CLng(szCondData)
	ElseIf nIndex = 2 Then
		'이익율 예상가격 = 평균단가 * ((100 + 감시설정값) / 100)
		TargetP = avPrc * ((100 + szCondData) / 100.0)
	End If


	EDIT0.Data = TargetP


	nIndex = cmb_cond_3_2.Index
	szCondData = Trim(edt_cond_3_2.Data)
	'/* TS고점대비설정단위/* 1:가격 2:율 3:Tick */
	If nIndex = 0 Then
		'가격
	'	MsgBox "TargetP<" & TargetP &">szCondData" & szCondData &">"
		TargetP = CLng(TargetP) - CLng(szCondData)
	ElseIf nIndex = 1 Then
		'틱
		If CLng(szCondData) = 0 Then
			TargetP = CLng(TargetP)
		Else
			'업틱으로 호가단위 맞추고 계산하자
			TargetP = GetHogaPrc(E_shrt_cd.Data, TargetP, True)
			For i = 0 To CLng(szCondData)-1
				TargetP = CLng(TargetP) - KsGetHogaUnitDn(E_shrt_cd.Data, TargetP)
			Next
		End If
	Else
		'%
		TargetP = TargetP * ((100 - szCondData) / 100.0)
	End If

	If CLng(TargetP) > 999999999 And CLng(Trim(edt_cond_3_1.Data)) <> 0	And CLng(Trim(edt_cond_3_2.Data)) <> 0 Then
		'예상 감시가격이 9자리 이상 큰수이면 에러
