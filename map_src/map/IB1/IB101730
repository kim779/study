                Array("거래급등", "IB10173S", ""))
Sub makecond()
	Dim ii
	For ii=LBound(g_ArrData) To UBound(g_ArrData)
		GRID0.InsertRow -1
		GRID0.SetGridCell ii+1, 1, g_ArrData(ii)(0)
	Next
End Sub

_AW_ONSTART_AW_
makecond()
SNAME.Text = Trim(GRID0.GetGridCell(GRID0.Row,1))

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	Dim namobj
	namobj = g_ArrData(GRID0.row-1)(1)
	OBJ.SetObject(namobj)
	OBJ.Send
	SNAME.Text = Trim(GRID0.GetGridCell(GRID0.Row,1))
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


