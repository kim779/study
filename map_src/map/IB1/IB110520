	zAcntNo.Data = ""
	MsgBox "계좌번호를 확인하여 주십시오.", , "IBK투자증권"
	SCREEN.Object("main.AN1A").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 Then
	zPwd.Data = "9999"
Else
	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.Data = ""
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		SCREEN.Object("main.zPwd").SetFocus
		Exit Sub
	End If
End If

If SCREEN.Object("main.CHECK0").Checked = True Then
	Dim jmcd
	jmcd = Trim(SCREEN.Object("main.jmcd1104").Data)

	If jmcd = "" Then
		zIsuNo.Data = ""
	Else
		If Len(jmcd) <> 6 Then
			MsgBox "종목번호를 확인하여 주십시오.", , "IBK투자증권"
			SCREEN.Object("main.jmcd1104").SetFocus
			Exit Sub
		End If

		If SCREEN.GetCodeType(jmcd) = 9 Then
			jmcd = "J" & jmcd
		ElseIf SCREEN.GetCodeType(jmcd) = 27 Then
			jmcd = "Q" & jmcd
		Else
			jmcd = "A" & jmcd
		End If

		zIsuNo.Data = jmcd
	End If
Else
	zIsuNo.Data = ""
End If

SCREEN.OnSend = True

