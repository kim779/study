End If

Call reDraw()

gridPos = GRID0.Rows + 1

Select Case SCREEN.Object("main.sec").Data
Case "1" : SCREEN.Object("parent.send_btn").SetFocus
Case "2" : SCREEN.Object("parent.next_btn").SetFocus
Case "3" : SCREEN.Object("parent.jmcd1104").SetFocus
End Select

Dim ii, tmpb
For ii = 1 To GRID0.Rows
	tmpb = Trim(GRID0.GetGridCell (ii, 29))
	Select Case Trim(tmpb)
