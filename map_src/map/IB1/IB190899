If Trim(o_jmno.Data) <> "" Then
	l_jmno.Text = Trim(o_jmno.Data)
End If


'정상적인 주문일경우, 주문전송후 주문번호 깜빡임
ecod = LEDGER.Ecod
If Trim(ecod) <> "" Then
	If IsNumeric(ecod) = True	Then
		If CDbl(ecod) = 0 Then
			If doType.Data = 1 Then
				SCREEN.Object(objnm & ".o_jmno").blink True, 161
			Else
				Select Case SCREEN.Object("parent.TAB_ORDER").ID
					Case 1			'매도
						SCREEN.Object(objnm & ".o_jmno").blink True, 162
					Case 3			'정정
						SCREEN.Object(objnm & ".o_jmno").blink True, 163
					Case 4			'취소
