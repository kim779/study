'ed_pswd.Data = SCREEN.Object(objnm & ".ed_pswd").data		'비밀번호
'------------------------------------------------------------------------ 일방향 암호화
LEDGER.Hsiz = 44
LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(SCREEN.Object(objnm & ".ed_pswd").data))
ed_pswd.Data = "HEAD"
'------------------------------------------------------------------------
ed_ogno.Data = SCREEN.Object(objnm & ".ed_ogno").data		'원주문번호
en_accn.Data = Mid(ed_acno.Data, 1, 8) 	'계좌번호암호화

'종목코드
code = Trim(SCREEN.Object(objnm & ".1301").data)

If Trim(SCREEN.GetCodeType(code)) = "27" Then	'ETN은 'Q'로 시작함
	ed_code.Data = "Q" & code
Else
	Select Case Mid(code, 1, 1)
		Case "5", "6", "7", "8"
			ed_code.Data = "J" & code
		Case Else
			ed_code.Data = "A" & code
	End Select
End If

ed_jqty.Data = SCREEN.Object(objnm & ".ed_jqty").data		'주문수량
