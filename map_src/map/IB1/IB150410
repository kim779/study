_AW_ONDECLARE_AW_
Dim sect
sect = 0

'== 계좌명, 비밀번호 설정
Sub Set_account()
	SCREEN.ClearAll 2, 2
	LoanDt.Clear
	zIsuNo_chae.Clear
	chae_nm.Clear
	jusik_nm.Clear
	zIsuNo.Clear

	If Len(Trim(AN1A.Data)) = 11 Then
		ACNM.Data = Trim(AN1A.Name)
		zPwd.Data = Trim(AN1A.Password)
	Else
		AN1A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If

	Call send_f()
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ACNM.Data = Trim(AN1A.Name)
	next_btn.Enable = False
	LoanPtnCode.Data = "00"
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	LoanPtnCode.Data = "00"
	SCREEN.Send 0
End Sub

Sub grid_Click()
	Dim Lnm, LoanDtlClssNm, IsuNo2

	IsuNo2 = Trim(GRID0.GetGridCell(GRID0.row, 1))
	If Len(IsuNo2) < 6 Then
		Exit Sub
	End If

	LoanDt.Data = GRID0.GetGridCell(GRID0.row, 6)
	IsuNo.Data = GRID0.GetGridCell(GRID0.row, 1)

	If Left(IsuNo2, 1) = "A" Then
		zIsuNo.data = Right(IsuNo2, Len(IsuNo2)-1)
		jusik_nm.Visible = True
		zIsuNo.Visible = True
