_AW_ONDECLARE_AW_
Dim g_groupRow, g_gridRow
g_groupRow = 1
g_gridRow = 1

Sub RemoveNonGroupingRows()
	OBJ_GRP.Proc "RemoveNonGroupingRows", "parent.GRID1,1"
End Sub

Sub EndQueryGroup(Mode)
	If Mode = 1 Then
		SCREEN.Proc "OBJ_GRP.StrQueryGroupList", "COMBO0"
		SCREEN.Proc "OBJ_GRP.QueryGroupListToGrid", "parent.GRID0"
		SetAllCheck("1")
		Call GRID0.SetHeadCell(1, "1")

		'SYSTEM.Trace "GRID0[" & GRID0.Rows & "]"
		'SCREEN.Proc "OBJ_GRP.StrQueryAcntList", COMBO0.Data&",2,acgrid,cmb_acnt"
		Call Send_f("0")
	End If
End Sub

'0: 전체조회, 1:그룹조회 처음, 2:그룹조회 다음
Sub Send_f(val)
	LEDGER.Rcnt = "0050"'CalcRow()'"0008"
	LEDGER.Fkey = "C"

	If val = "0" Then
		GRID1.Clear
		OBJ_BOTTOM.ClearAll 2
		Call GRID1.SetDataPosition(0)
		zGrpNo.Data = GRID0.GetGridCell(1, 3)
		g_groupRow = 1
		g_gridRow = 1
	ElseIf val = "1" Then
		GRID1.Clear
		Call GRID1.SetDataPosition(0)
		zGrpNo.Data = ""
		g_groupRow = 1
		g_gridRow = 1
		Call SetCheckGroup()
	ElseIf val = "2" Then
		Call GRID1.SetDataPosition(2)
	End If

	SCREEN.Send 0
End Sub

Sub Send_c()
	'LEDGER.Rcnt = "0008"
	LEDGER.Fkey = "7"
	Call GRID1.SetDataPosition(2)

	SCREEN.Send 0

End Sub

Sub CheckInput()
	Dim ii, dd
	'MsgBox "CheckInput"
	dd = "" '임의의 값
	For ii=1 To GRID1.Rows
		dd = Trim(GRID1.GetGridCell(ii, 1))
		If dd <> "" Then
			Exit For
		End If
	Next
	'MsgBox "["&dd&"]"
	If dd = "" Then
		SCREEN.Object("Object0.zFnoOrdPtnCode").Data = "SS"
		SCREEN.Object("Object0.lFundOrdNo").data = "+000000000"
	Else
		SCREEN.Object("Object0.zFnoOrdPtnCode").Data = "00"
	End If
End Sub

Sub AddJumun(str)

	'MsgBox "["&str&"]"
	Dim no, msg
	no = Mid(str,1,10)
	msg = Mid(str,11,Len(str)-11)
	GRID1.InsertRow GRID1.Rows
	GRID1.SetGridCell GRID1.Rows, 1, no
	GRID1.SetGridCell GRID1.Rows, 2, msg
	SCREEN.Send 0
End Sub

Sub EndJumun()
	Dim ii, val, chk, Total, ival
	If GRID1.Rows > 0 Then
		Total = SCREEN.Object("main.OBJ_ODR.OBJ_FUNDACC.Grid0").rows

		ival = 1
		If Total > 0 Then
			For ii=1 To Total
				chk = SCREEN.Object("main.OBJ_ODR.OBJ_FUNDACC.Grid0").GetGridCell(ii, 23)
				If chk = 1 Then
					Call SCREEN.Object("main.OBJ_ODR.OBJ_FUNDACC.Grid0").SetGridCell(ii, 27, GRID1.GetGridCell(ival, 1))
					Call SCREEN.Object("main.OBJ_ODR.OBJ_FUNDACC.Grid0").SetGridCell(ii, 24, GRID1.GetGridCell(ival, 2))
					ival = ival + 1
				End If
			Next
		End If

		SCREEN.Object("main.OBJ_ODR.o_jmno").data = SCREEN.Object("Object0.OFundOrdNo").data
		SCREEN.Proc "main.OBJ_ODR.AfterOrder", ""
	End If
End Sub

Function GetState(val)
	Dim ss, ret
	ss = CStr(CLng(val))
	Select Case ss
		Case "0"
			ret = "정상"
		Case "6"
			ret = "정정확인"
		Case "8"
			ret = "취소확인"
		Case "7"
			ret = "정정중"
		Case "9"
			ret = "취소중"
		Case Else
			ret = "그외..거부"
	End Select
	GetState = ret
End Function

