Const myFILE = "userconf.ini"

Sub MyChangeCode()
	ed_jprc.Data = "0"

	ed_jqty.Data = "0"
	'ed_jqty.Enable = False

	' 기본을 [총평가금액 대비 목표비중]으로 변경
	'r_hogb0.Checked = True
	'r_mmgj2.Checked = True

	ed_mmrt.Data = "0.0"
	ed_mmrt.Enable = True
	ed_mmrt1.Data = "0.0"
