	SCREEN.Object("main.1301").Data = S1301.Data
	SCREEN.Object("OBJ_hnam.1301").Data = S1301.Data
	SCREEN.Object("OBJ_hnam").Send
	SCREEN.Proc "main.send_sise_all", "jumun"
End Sub

Sub AfterOrder()
	ed_jprc.Data = "0"
	ed_jqty.Data = "0"
	ed_mmrt.Data = "0.0"
	ed_mmrt1.Data = "0.0"
End Sub

Sub CheckHogb()
	If r_hogb1.Checked Then
		ed_jprc.Data = "0"
		ed_jprc.Enable = False
	Else
		ed_jprc.Enable = True
	End If
End Sub

Sub MyQueryHoga()
	Dim siseObj, prcOpt, cfgGB, mapid, mainmap
	siseObj = "parent.OBJ_sise."
	prcOpt = siseObj & "1377"
	If Is_numeric(SCREEN.Object(prcOpt).Data) Then
		ed_jqty.SetDelta SCREEN.Object(prcOpt).Data
	End If
	Set_mkgb(Trim(S1301.Data))
End Sub

Sub SetRateType(bVal)
	If bVal=False Then
		ed_mmrt.Data = "0.0"
		ed_mmrt1.Data = "0.0"
		ed_jqty.Enable = True
		ed_mmrt.Enable = False
		ed_mmrt1.Enable = False
	Else
		ed_jqty.Data = 0
		ed_jqty.Enable = False
		ed_mmrt.Enable = True
		ed_mmrt1.Enable = True
	End If
End Sub

Sub ApplyToOrderGrid()
	Dim val1, val2, val3

	If Len(S1301.Data)<>6 Then
		MsgBox "종목코드를 입력하십시오.", vbOKOnly, "IBK투자증권"
		S1301.SetFocus
		Exit Sub
	End If

	val1 = Trim(S1301.Data)
	val2 = Trim(SCREEN.Object("main.OBJ_sise.1301").Data)
	val3 = Trim(SCREEN.Object("main.OBJ_sise2.1301").Data)
	If val1<>val2 Or val1<>val3 Then
		MsgBox "종목시세가 정상적으로 조회되지 않았습니다." & vbCrLf & "종목코드를 다시 선택하시기 바랍니다..", vbOKOnly, "IBK투자증권"
		S1301.SetFocus
		Exit Sub
	End If

	' 매매기준이 직접입력일 경우 수량은 체크하지 않는다.
	If ed_jqty.Enable And (Not IsNumeric(ed_jqty.Data) Or CLng(ed_jqty.Data)<=0) And Not r_mmgj9.Checked Then
		MsgBox "수량을 입력하십시오.", vbOKOnly, "IBK투자증권"
		ed_jqty.SetFocus
		Exit Sub
	End If

	If Not IsNumeric(ed_jprc.Data) Or (CLng(ed_jprc.Data)<5 And ed_jprc.Enable=True And Not r_mmgj9.Checked) Then
		MsgBox "단가를 입력하십시오.", vbOKOnly, "IBK투자증권"
		ed_jprc.SetFocus
		Exit Sub
	End If

	If (r_mmgj2.Checked Or r_mmgj3.Checked) Then
		Dim mmrt

		If ed_mmrt1.Visible Then
			mmrt = Trim(ed_mmrt1.Data)
		Else
			mmrt = Trim(ed_mmrt.Data)
		End If
		If mmrt="" Then
			If ed_mmrt1.Visible Then
				ed_mmrt1.SetFocus
			Else
				ed_mmrt.SetFocus
			End If
			MsgBox "비율을 입력하십시오.", vbOKOnly, "IBK투자증권"
			Exit Sub
		End If
	End If

	If Not r_mmgj9.Checked Then
		Dim tab_accn, bRet
		bRet = MsgBox("수량반영시 기존 주문설정내역이 사라집니다." & vbCrLf & "계속하시겠습니까?", vbYesNo, "IBK투자증권")
		If bRet<>vbYes Then
			S1301.SetFocus
			Exit Sub
		End If
	End If

	SCREEN.Object("main.1301").Data = Trim(S1301.Data)
	SCREEN.Object("main.hnam").Data = Trim(SCREEN.GetName(100, Trim(S1301.Data), 99))
	SCREEN.Object("main.mmgb").Data = "2"
	SCREEN.Object("main.jqty").Data = ed_jqty.Data
	SCREEN.Object("main.jprc").Data = ed_jprc.Data
	SCREEN.Object("main.unit").Data = SCREEN.Object("main.OBJ_sise.1377").Data
	SCREEN.Object("main.curr").Data = SCREEN.Object("main.OBJ_sise.2023").Data

	' 현재가 조회 체크
'	If Not r_mmgj9.Checked Then
'		If CLng(SCREEN.Object("main.curr").Data)=0 Then
'			MsgBox _
'				SCREEN.Object("main.hnam").Data & _
'				"[" & Trim(S1301.Data) & "]의 현재가가 조회되지 않았습니다." & vbCrLf & _
'				"지정가 주문을 이용하시거나, 잠시 후, 이용해 주시기 바랍니다." & vbCrLf & _
'				"이용에 불편을 드려 죄송합니다.", vbOKOnly + vbInformation , _
'				"IBK투자증권"
'			Exit Sub
'		End If
'	End If

	' 호가구분 세팅
	If r_hogb1.Checked Then
		SCREEN.Object("main.hogb").Data = "03"
	ElseIf r_hogb2.Checked Then
		SCREEN.Object("main.hogb").Data = "82"
	Else
		SCREEN.Object("main.hogb").Data = "00"
	End If

	' 매매기준 세팅
	If r_mmgj0.Checked Then
		SCREEN.Object("main.mmgj").Data = "1"
	ElseIf r_mmgj1.Checked Then
		SCREEN.Object("main.mmgj").Data = "2"
	ElseIf r_mmgj2.Checked Then
		SCREEN.Object("main.mmgj").Data = "3"
	ElseIf r_mmgj3.Checked Then
		SCREEN.Object("main.mmgj").Data = "4"
	ElseIf r_mmgj9.Checked Then
		SCREEN.Object("main.mmgj").Data = "9"
	Else
		SCREEN.Object("main.mmgj").Data = "1"
		r_mmgj0.Checked = True
	End If

	If ed_mmrt1.Visible Then
		SCREEN.Object("main.mmrt").Data = Replace(ed_mmrt1.Data, " ", "0")
	Else
		SCREEN.Object("main.mmrt").Data = Replace(ed_mmrt.Data, " ", "0")
	End If

	SCREEN.Proc "main.tab_accn_change", "1"
	SCREEN.Proc "main.SetOrderGrid", ""
End Sub

Function GetBool(str)
	If Len(str)=0 Or str="0" Then
		GetBool = False
	Else
		GetBool = True
	End If
End Function

Sub LoadConfig()
	r_mmgj2.Checked = True	'기본값

	If SCREEN.CreateObject("INFO") Then
		r_hogb0.Checked = GetBool(Trim(INFO.PopData(LOGIN.Name, myFILE, "IB190112", "r_hogb0")))
		r_hogb1.Checked = GetBool(Trim(INFO.PopData(LOGIN.Name, myFILE, "IB190112", "r_hogb1")))
		r_hogb2.Checked = GetBool(Trim(INFO.PopData(LOGIN.Name, myFILE, "IB190112", "r_hogb2")))
		r_mmgj0.Checked = GetBool(Trim(INFO.PopData(LOGIN.Name, myFILE, "IB190112", "r_mmgj0")))
		r_mmgj1.Checked = GetBool(Trim(INFO.PopData(LOGIN.Name, myFILE, "IB190112", "r_mmgj1")))
		r_mmgj2.Checked = GetBool(Trim(INFO.PopData(LOGIN.Name, myFILE, "IB190112", "r_mmgj2")))
		r_mmgj3.Checked = GetBool(Trim(INFO.PopData(LOGIN.Name, myFILE, "IB190112", "r_mmgj3")))
		r_mmgj9.Checked = GetBool(Trim(INFO.PopData(LOGIN.Name, myFILE, "IB190112", "r_mmgj9")))

		If r_mmgj0.Checked Or r_mmgj1.Checked Or r_mmgj9.Checked Then
			Call SetRateType(False)
		Else
			Call SetRateType(True)
		End If

		Call CheckHogb()
	End If
End Sub

Sub SaveConfig()
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, myFILE, "IB190112", "r_hogb0", r_hogb0.Checked
		INFO.PushData LOGIN.Name, myFILE, "IB190112", "r_hogb1", r_hogb1.Checked
		INFO.PushData LOGIN.Name, myFILE, "IB190112", "r_hogb2", r_hogb2.Checked
		INFO.PushData LOGIN.Name, myFILE, "IB190112", "r_mmgj0", r_mmgj0.Checked
		INFO.PushData LOGIN.Name, myFILE, "IB190112", "r_mmgj1", r_mmgj1.Checked
		INFO.PushData LOGIN.Name, myFILE, "IB190112", "r_mmgj2", r_mmgj2.Checked
		INFO.PushData LOGIN.Name, myFILE, "IB190112", "r_mmgj3", r_mmgj3.Checked
		INFO.PushData LOGIN.Name, myFILE, "IB190112", "r_mmgj9", r_mmgj9.Checked
	End If
End Sub

Sub SetHogaObj()
	If r_hogb2.Checked Then
		SCREEN.Object("main.OBJ_sise").SetObject "IB190180"
	Else
		SCREEN.Object("main.OBJ_sise").SetObject "IB190120"
	End If

	SCREEN.Object("main.OBJ_sise").send
End Sub

