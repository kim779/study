Sub clear_check()
	allCheck.Checked = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit Sub
		End If
		If VIEWGRID.GetGridCell(ii, 1) = "1" Then
			VIEWGRID.SetGridCell ii, 1,"0"
		End If
	Next
End Sub

'***************************************************************

Function chkcnt()
	Dim gcnt
	gcnt = 0

	chkcnt = False
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell(ii, 1)) = 1 Then
			gcnt = gcnt + 1
		End If
	Next

	If gcnt > 0 Then
		chkcnt = True
	Else
		allCheck.Checked = False
	End If
End Function


'***************************************************************************
' DESC: grid chk = ALL
'***************************************************************************
Sub all_chk(Flag)
Dim val,quan
	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit Sub
		End If
		val = Trim(VIEWGRID.GetGridCell (ii, 4))
		quan = Trim(VIEWGRID.GetGridCell(ii, 6))

		If val = "00" Or val = "01" Then
			If quan <> "" Then
				VIEWGRID.SetGridCell ii, 1, Flag
			End If
		End If
	Next
End Sub

