RESOURCE DIVISION
{


_AW_ONINDECLARE_AW_
#LOAD IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'SACMT207 -> SACMT238로 변경

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_

Dim IsYN
IsYN = SYSTEM.CheckPasswd(Trim(Pwd.Data))

If IsYN ="Y" Then	'접속비밀번호와 일치하면 "Y"를 세팅해주고 send 하지 않음
	SCREEN.Object("main.zPwchk").Data = "Y"
	SCREEN.OnSend = False
Else
	SCREEN.OnSend = True
End If

If Trim(SYSTEM.UserPass) <> Trim(Pwd.Data) Then
	If Len(Trim(Pwd.Data)) >= 4 And Trim(Pwd.Data) <> "HEAD" Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(Pwd.Data))
		Pwd.Data = "HEAD"
	End If
End If

If Trim(Pwd.Data) = "HEAD" Then
	If Len(Trim(LEDGER.EPwd)) <> 44 Then
		SCREEN.Object("main.GUIDE").Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요."
		'Pwd.Data = ""
		'Pwd.SetFocus
		SCREEN.OnSend = False
		Exit Sub
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'접속비밀번호가 틀릴경우 여기로 들어옴

If Trim(zAvalYn.Data) = "Y" Then	'고객 비밀번호가 맞을 경우
	SCREEN.Object("main.zPwchk").Data = "Y"
Else								'고객 비밀번호가 아닐 경우
	SCREEN.Object("main.zPwchk").Data = "N"
	SCREEN.Object("main.GUIDE").Text = LEDGER.Emsg
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



