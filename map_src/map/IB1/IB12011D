{


_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	ACNM.Data = AN1A.name
''	pswd.Data = AN1A.Password
End Sub

Dim Mydata

Function data_split()
Dim ii
	Mydata = Split(s_data.data, "^", -1, 1) 					' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)				' 한 레코드를 개체별로 자르는중..
		GRID.InsertRow(0)

		GRID.SetGridCell 1, 1, Trim(Mydata(ii)(0))				' chk
		GRID.SetGridCell 1, 2, Trim(Mydata(ii)(1))				' 신용구분
		GRID.SetGridCell 1, 3, Trim(Mydata(ii)(2))				' 주문유형
		GRID.SetGridCell 1, 4, Trim(Mydata(ii)(3))				' 시장구분
		GRID.SetGridCell 1, 5, Trim(Mydata(ii)(4))				' 매매구분
		GRID.SetGridCell 1, 6, Trim(Mydata(ii)(5))				' 계좌번호
		GRID.SetGridCell 1, 7, Trim(Mydata(ii)(6))				' 비밀번호
		GRID.SetGridCell 1, 8, Trim(Mydata(ii)(7))				' 원주문번호
		GRID.SetGridCell 1, 9, Trim(Mydata(ii)(8))				' 종목코드
		GRID.SetGridCell 1, 10, Trim(Mydata(ii)(9))				' 종목명
		GRID.SetGridCell 1, 11, Trim(Mydata(ii)(10))			' 매입단가
		GRID.SetGridCell 1, 12, Trim(Mydata(ii)(11))			' 매도수량
		GRID.SetGridCell 1, 13, Trim(Mydata(ii)(12))			' 매도가격
		GRID.SetGridCell 1, 14, Trim(Mydata(ii)(13))			' 호가잔량
		GRID.SetGridCell 1, 15, Trim(Mydata(ii)(14))			' 주문조건
		GRID.SetGridCell 1, 16, Trim(Mydata(ii)(15))			' 정정취소
		GRID.SetGridCell 1, 17, Trim(Mydata(ii)(16))			' 호가구분
		GRID.SetGridCell 1, 18, Trim(Mydata(ii)(17))			' 처리구분
		GRID.SetGridCell 1, 19, Trim(Mydata(ii)(18))			' 신용구분코드
		GRID.SetGridCell 1, 20, Trim(Mydata(ii)(19))			' 대출일자
	Next

End Function

Sub AllSell()
Dim ii
For ii = 1 To NREC.Data

	If cxMarket.sMarket = "KRX" Then
		SCREEN.Object("OBJ.GRID").SetGridCell ii, 2, "1"
	ElseIf cxMarket.sMarket = "NXT" Then
		SCREEN.Object("OBJ.GRID").SetGridCell ii, 2, "N"
	ElseIf cxMarket.sMarket = "통합" Then
		SCREEN.Object("OBJ.GRID").SetGridCell ii, 2, "S"
	End If
	
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 1, GRID.GetGridCell (ii, 1)
	'SCREEN.Object("OBJ.GRID").SetGridCell ii, 2, GRID.GetGridCell (ii, 3)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 3, GRID.GetGridCell (ii, 4)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 4, GRID.GetGridCell (ii, 5)
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 5, GRID.GetGridCell (ii, 6)

	If pswd.Enable  = True Then
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 6, Trim(pswd.Data) '''GRID.GetGridCell (ii, 7)
	Else
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 6, GRID.GetGridCell (ii, 7)
	End If

