			SCREEN.Object("OBJ.GRID").SetGridCell ii, 11, "03"
			SCREEN.Object("OBJ.GRID").SetGridCell ii, 12, "1"
		End If
	Else
		SCREEN.Object("OBJ.GRID").SetGridCell ii, 11, GRID.GetGridCell (ii, 15)
		SCREEN.Object("OBJ.GRID").SetGridCell ii, 12, GRID.GetGridCell (ii, 16)
	End If
	
	SCREEN.Object("OBJ.GRID").SetGridCell ii, 12, GRID.GetGridCell (ii, 16)
