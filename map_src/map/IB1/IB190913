RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub show_obj(param)
	If param = 1 Then
		UBtn.Enable = True
		S20301.Enable = True
	Else
		UBtn.Enable = False
		S20301.Enable = False
		S20301.Clear
	End If
End Sub

_AW_ONSEND_AW_
Select Case upgb.Data
Case "00"
    S20301.data="001"
	show_obj(1)
Case "50"
    S20301.data="201"
	show_obj(1)
Case Else
	show_obj(0)
End Select

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
OBJ.Send

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(UBtn)
_AW_ONCLICK_AW_
Dim retn

Select Case c_upgb.Data
	Case "001", "101", "401"		'KOSPI, KOSPI200, KOSPI100
		retn = SCREEN.GetCode(104, "20301", "20022", 0)
	Case "201", "301"							'KOSDAQ
		retn = SCREEN.GetCode(104, "20301", "20022", 9)
	Case "801"
		retn = SCREEN.GetCode(104, "20301", "20022", 801)
End Select


If (retn <> True) Then
	S20301.SetFocus
	Exit Sub
Else
	S20301.SetFocus
	SCREEN.Send 2
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(upgb)
_AW_ONCHANGE_AW_
