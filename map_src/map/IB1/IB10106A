Dim codx

If S90303.HitPos = 3 Then
	If Len(Trim(S90303.GetGridCell(S90303.index+1, 2))) > 6 Then
		Exit Sub
	End If

	S1301.DATA = S90303.GetGridCell(S90303.Row, 2)
	If Trim(S1301.DATA) = "" Then
	    Exit Sub
	End If


	If S90303.Column = 5 Then
		Call newsClick()
	End If

	S1301.Data = Trim(S90303.GetGridCell(S90303.Row, 2))
	triggerPrc.Data = Trim(S90303.GetGridCell(S90303.Row, 7))
	triggerPrc.Trigger "triggerPrc", False
	triggerPrc.Trigger "triggerPrc", True
	SYSTEM.Push "PriceTrigger", "Yes"

	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
ElseIf S90303.HitPos = 4 Then
	Dim ii, res

	For ii=1 To S90303.Rows
		S90303.SetGridCell ii, 5, ""
		S90303.SetGridCell ii, 4, ""
		S90303.SetGridCell ii, 3, ""

		res = ii Mod 2

		If res = 0 Then
			S90303.SetPRgb ii, 5, 77
		Else
			S90303.SetPRgb ii, 5, 68
		End If
	Next
End If
