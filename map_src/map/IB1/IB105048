_AW_ONDECLARE_AW_
'Public start
'start = 1
Const file = "newsinfo.ini"

Function ReadConf()
	If SCREEN.CreateObject("Info") Then
	 	ReadConf = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "ITEMS"))
	Else
		ReadConf = ""
	End If
End Function

Function ReadVersion()
	If SCREEN.CreateObject("Info") Then
	 	ReadVersion = Trim(INFO.PopData(LOGIN.Name, file, "SELITEM", "VERSION"))
	Else
		ReadVersion = ""
	End If
End Function

Sub Onalert()
	Dim	v_gubn
	Dim	v_name
	Dim strKeys
	Dim v_subgubn

	If Trim(GRID2.GetGridCell(1, 8)) = "" Then
		Exit Sub
	End If

	If IsNumeric(GRID2.GetGridCell(1, 8)) = False Then
		Exit Sub
	End If

	v_gubn = CLng(GRID2.GetGridCell(1, 8))

	If v_gubn < 1 Or v_gubn > 20 Then
		Exit Sub
	End If

	Select Case v_gubn
	Case 1
		If GUBN1.Checked = False Then
			Exit Sub
		End If
		v_name = "시황"
	Case 2
		If GUBN2.Checked = False Then
			Exit Sub
		End If
		v_name = "공시"

		v_subgubn = Trim(GRID2.GetGridCell(1, 9))

		If IsNumeric(v_subgubn) = False Then
			Exit Sub
		End If

		If v_subgubn = 99 Then
			v_name = "코스닥공시"
		ElseIf v_subgubn = 88 Then
			v_name = "프리보드공시"
		Else
			v_name = "거래소공시"
		End If
	Case 3
		If GUBN3.Checked = False Then
			Exit Sub
		End If
		v_name = "이투데이"
	Case 4
		If GUBN4.Checked = False Then
			Exit Sub
		End If
		v_name = "시황속보"
	Case 5
		If GUBN5.Checked = False Then
			Exit Sub
		End If
		v_name = "전자신문"
	Case 6
		If GUBN6.Checked = False Then
			Exit Sub
		End If
		v_name = "이데일리"
	Case 7
		If GUBN7.Checked = False Then
			Exit Sub
		End If
		v_name = "월드인덱스"
	Case 8
		If GUBN8.Checked = False Then
			Exit Sub
		End If
		v_name = "연합뉴스"
	Case 9
		If GUBN9.Checked = False Then
			Exit Sub
		End If
		v_name = "머니투데이"
	Case 10
		If GUBN10.Checked = False Then
			Exit Sub
		End If
		v_name = "한경뉴스"
	Case 11
		If GUBN11.Checked = False Then
			Exit Sub
		End If
		v_name = "매경뉴스"
	Case 12
		If GUBN12.Checked = False Then
			Exit Sub
		End If
		v_name = "아시아경제"
	Case 13
		If GUBN13.Checked = False Then
			Exit Sub
		End If
		v_name = "헤럴드경제"
	Case 14
		If GUBN14.Checked = False Then
			Exit Sub
		End If
		v_name = "촉n토크"
	Case 15
		If GUBN15.Checked = False Then
			Exit Sub
		End If
		v_name = "IR GO"
	Case 16
		If GUBN16.Checked = False Then
			Exit Sub
		End If
		v_name = "컨슈머타임스"
	Case 17
		If GUBN17.Checked = False Then
			Exit Sub
		End If
		v_name = "뉴스웨이"
	End Select

	strKeys = editFilter.Data

'Exit Sub
	For ii = 1 To GRID2.Rows
		If Trim(GRID2.GetGridCell(ii,11))<>"" Then
			If Trim(strKeys) = "ALL" Or InStr(strKeys,Trim(GRID2.GetGridCell(ii,7))) > 0 Then
				GRID0.InsertRow 0
				GRID0.SetGridCell 1, 1, Mid(GRID2.GetGridCell(ii,11),1,8)
				GRID0.SetGridCell 1, 2, GRID2.GetGridCell(ii,6)
				GRID0.SetGridCell 1, 3, GRID2.GetGridCell(ii,2)
				GRID0.SetGridCell 1, 10, GRID2.GetGridCell(ii,11)
			End If
		End If
	Next


	GRID2.Clear()
End Sub


Sub click_grid()
	Dim	key_value, key_text
	key_value = GRID0.GetGridCell(GRID0.Row, 10) 'keyv
	If Trim(key_value) <= "" Then
		Exit Sub
	End If
	key_text = GRID0.GetGridCell(GRID0.Row, 3) '제목

	If Trim(key_text) <= "" Then
		Exit Sub
	End If

	key_text = Replace(key_text, "/", "-")	' '/'문자있으면 도미노로 넘겨주지 못함.
		SCREEN.CreateWindow 4, "IBNEWSXX /S/t/d/p1", "015"& vbTab & key_text & vbLf & _
		"016" & vbTab & key_value & vbLf & "1301" & vbTab & GRID0.GetGridCell(GRID0.row, 6)
End Sub

