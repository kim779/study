RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim nCurrRow

nCurrRow = 1

'== 첫 조회
Sub send_f()
	nCurrRow = 1
	zCrdtTp.Data = "1"

	SCREEN.ClearAll 0,2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
'Call Check_LoginType(zPwd)

LEDGER.Rcnt = "0033"
S1301.Data = startCod.Data
obj0.Send
startCod.SetFocus
SCREEN.SetTimer 5,False

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
GUIDE.Text = ""

If Len(Trim(startCod.Data)) = 6 Then
	S1301.Data = startCod.Data

	If SCREEN.GetCodeType(S1301.Data) = 9 Then
		EDIT2.Data = "J"
	ElseIf SCREEN.GetCodeType(S1301.Data) = 27 Then
		EDIT2.Data = "Q"
	Else
		EDIT2.Data = "A"
	End If
Else
	Call alert_msg("시작종목번호를 확인하여 주십시오.")
	S1301.Clear
	startCod.SetFocus
	Exit Sub
End If

If Trim(OUTPUT1.Data) <> "" Then
	OUTPUT2.Data = OUTPUT1.Data
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(LEDGER.Ecod, 1) <> "0" Then
	SCREEN.ClearAll 2, 2
Else

	Select Case selection.Data
		Case "1"	startCod.SetFocus()
		Case "2"	send_btn.SetFocus()
		Case "3"	next_btn.SetFocus()
		Case "4"	RADIO1.SetFocus()
		Case "5"	RADIO0.SetFocus()
		Case "6"	RADIO2.SetFocus()
		Case "7"	zLoanAbleYn.SetFocus()
	End Select
End If

If selection.Data = "3" Then
	OUTPUT1.Data = OUTPUT2.Data
End If

Dim ii, nTemp, strText, nAdd

nAdd = (GRID0.Rows - nCurrRow) + 1

For ii = nCurrRow To GRID0.Rows
	strText = Trim(GRID0.GetGridCell(ii, 9))

	If Len(strText) <> 0 Then
		GRID0.SetGridCell ii, 9, strText & "등급"
	End If

	If GRID0.GetGridCell(ii, 15) = "0.0000" Then
		nTemp = 0
	Else
		nTemp = CDbl(GRID0.GetGridCell(ii, 15)) * 100
	End If

	GRID0.SetGridCell ii, 15, nTemp & "%"
Next

nCurrRow = nCurrRow + nAdd

If LEDGER.Next = "Y" Then
	next_btn.Enable True
Else
	next_btn.Enable False
End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
send_f()
selection.Data = "1"

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
'If Trim(S1301.Data) = "" Then
'	S1301.Data = "000020"
'	send_f()
'Else
'	send_f()
'End If

send_f()
selection.Data = "2"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
send_c()
selection.Data = "3"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
_AW_ONCLICK_AW_
Dim retn
retn = SCREEN.GetCode(100, "startCod", "hnam", 0 )
If retn <> True Then
       Exit Sub
End If

SCREEN.Send 2
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	S1301.DATA = GRID0.GetGridCell(GRID0.Row, 2)

	If Trim(S1301.DATA) = "" Then
		Exit Sub
	End If

	S1301.Trigger "1301", False
	S1301.Trigger "1301", True
	SYSTEM.SetHistory "1301", S1301.DATA
