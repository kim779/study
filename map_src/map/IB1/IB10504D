Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cod)
_AW_ONCHANGE_AW_
obj0.Send

If Trim(cod.Data) <> "" Then
	If Len(Trim(cod.Data)) < 6 Then
		cod.SetFocus
		Exit Sub
	End If

	If SCREEN.GetCodeType(cod.Data) <> 9 Then
		cod.Clear
		cod.SetFocus
		Exit Sub
	End If
End If

Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


