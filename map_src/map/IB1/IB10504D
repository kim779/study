_AW_ONCLICK_AW_
If GRID0.Rows < 1 Then
	Exit Sub
End If

If GRID0.HitPos = 3 Then
	Dim cod2, lastDay
	cod2 = 	Trim(GRID0.GetGridCell(GRID0.Row, 2))
	lastDay = Trim(GRID0.GetGridCell(GRID0.Row, 8))

	If lastDay = "" Then
		Exit Sub
	End If

	If CDbl(lastDay) >= CDbl(getCurrDay()) Then
		If cod2 <> "" Then
			SCREEN.Object("main.1301").Data = cod2
			SCREEN.Object("main.E1301").Data = cod2
			SCREEN.Proc "main.send_sise_all", "sise"
			SCREEN.Object("main.OBJ_info").Send
		End If
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


