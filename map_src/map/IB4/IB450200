Dim size_chk
Function loadUserConfig()
	loadUserConfig = False
	If SCREEN.CreateObject("Info") Then

		str1  = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB450200", "GUBN"))
		If str1 = "" Then
		    saveUserConfig()
		Else
			GUBN.Data = str1
			If Trim(GUBN.Data) = "1" Then
				RADIO0.Checked = True
			Else
				RADIO1.Checked = True
			End If

			SKEY.Data = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB450200", "SKEY"))
			If Trim(SKEY.Data) = "1" Then
				S1.Checked = True
			Else
				S2.Checked = True
			End If

			FKEY.data = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB450200", "FKEY"))
			If Trim(FKEY.Data) = "2" Then
				FCHECK.Checked = True
			Else
				FCHECK.Checked = False
			End If

			OKEY.data = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB450200", "OKEY"))
			If Trim(OKEY.Data) = "2" Then
				OCHECK.Checked = True
			Else
				OCHECK.Checked = False
			End If

			SCREEN.Object("obj1.tjcd").index = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB450200", "TJCD1"))
			SCREEN.Object("obj2.tjcd").index = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB450200", "TJCD2"))
			SCREEN.Object("obj3.tjcd").index = Trim(INFO.popData(LOGIN.Name, "userconf.ini", "IB450200", "TJCD3"))

			loadUserConfig = True
		End If

	End If
End Function

Sub saveUserConfig()
	Dim tjcd1, tjcd2, tjcd3

	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, "userconf.ini", "IB450200", "GUBN", GUBN.Data
		INFO.pushData LOGIN.Name, "userconf.ini", "IB450200", "SKEY", SKEY.Data
		INFO.pushData LOGIN.Name, "userconf.ini", "IB450200", "FKEY", FKEY.Data
		INFO.pushData LOGIN.Name, "userconf.ini", "IB450200", "OKEY", OKEY.Data
		tjcd1 = SCREEN.Object("obj1.tjcd").index
		tjcd2 = SCREEN.Object("obj2.tjcd").index
		tjcd3 = SCREEN.Object("obj3.tjcd").index
		INFO.pushData LOGIN.Name, "userconf.ini", "IB450200", "TJCD1", TJCD1
		INFO.pushData LOGIN.Name, "userconf.ini", "IB450200", "TJCD2", TJCD2
		INFO.pushData LOGIN.Name, "userconf.ini", "IB450200", "TJCD3", TJCD3
	End If
End Sub

