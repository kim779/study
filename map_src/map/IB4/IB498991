_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	GRID0.Clear
	next_btn.Enable = False
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SYSTEM.Push "fundno", "NO"
LEDGER.Rcnt = "0015"
send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
Else
	next_btn.Enable = False
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

Dim msg
msg = GRID0.GetGridCell(GRID0.row, 5) & "|" & _
	GRID0.GetGridCell(GRID0.row, 7) & "|" & _
	GRID0.GetGridCell(GRID0.ROW, 4)

SYSTEM.Push "fundno", msg

SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
