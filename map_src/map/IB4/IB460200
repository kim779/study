RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim sendFlag, gridPos
sendFlag = 1
gridPos = 1

Sub send_f()
	If sendFlag = 1 Then
		viewGrid.Clear
		gridPos = 1
		LEDGER.Fkey = "C"
	Else
		LEDGER.Fkey = "7"
		viewGrid.SetDataPosition 2
	End If

	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	viewGrid.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0035"
Call send_f()
'EmpNo.SetFocus

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

Dim dept, common_nm
If SCREEN.CreateObject("Info") Then
	dept = Trim(INFO.PopData("", "ACCNTDEPT.INI", "ACCNTDEPT", "DEPT"))
	common_nm = Trim(INFO.PopData("", "ACCNTDEPT.INI", "ACCNTDEPT", "COMMONNM"))
End If

EmpNo.Data = "9" & dept & common_nm

If Len(Trim(EmpNo.Data)) < 6 Then
	MsgBox "사원번호를 확인하세요.", , "IBK투자증권"
	EmpNo.SetFocus
	Exit Sub
End If

If Len(Trim(BaseDt.Data)) < 8 Then
	MsgBox "기준일을 확인하세요.", , "IBK투자증권"
	BaseDt.SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
	next_btn.SetFocus
Else
	next_btn.Enable = False
	send_btn.SetFocus
End If


'계좌명 툴팁처리시 계좌명에 &가 있을경우 툴팁에 언더바로 표시되어 교체
Dim ii, tmpNm

For ii = gridPos To viewGrid.Rows
	tmpNm = Trim(viewGrid.GetGridCell(ii, 2))

	If tmpNm = "" Then
		Exit Sub
	End If

	If InStr(tmpNm, "&") > 0 Then
		viewGrid.SetGridCell ii, 2, Replace(tmpNm, "&", "＆")
	End If
Next

gridPos = viewGrid.Rows + 1

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(EmpNo)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BaseDt)
_AW_ONCHANGE_AW_
sendFlag = 1
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(viewGrid)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
sendFlag = 1
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
sendFlag = 2
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



