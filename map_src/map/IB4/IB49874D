RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub radio_switch()
	'한도조회
	SCREEN.Object("OBJ1").Proc "send_f",""
End Sub

Sub CheckNext()
	If Int(hando.Data) < Int(joinAmt.Data) Then
		MsgBox "가입가능한도를 초과했습니다. (가입가능한도 " & Trim(hando.Text) & "원)"
	ElseIf Int(joinAmt.Data) < 1000 Then
		MsgBox "가입금액을 1,000원 이상으로 입력해 주세요 (기준가에 따라 매수금액이 상이할 수 있음)"
	Else
		'주문데이터 셋팅
		SCREEN.Object("main.OBJECT1.R4").Checked = True '분리과세하일드

		SCREEN.Object("main.OBJECT1.JB2").Checked = True'자유적립식

		If radio31.Checked Then
			SCREEN.Object("main.OBJECT1.nyear").Data = "12"
		ElseIf radio32.Checked Then
			SCREEN.Object("main.OBJECT1.nyear").Data = "24"
		Else
			SCREEN.Object("main.OBJECT1.nyear").Data = "36"
		End If
		SCREEN.Object("main.OBJECT1.Fund_Reserve_prc").Data	= joinAmt.Data '납입한도
		'화면변경
		SCREEN.Proc "main.changeStep", "3"
	End If

End Sub

_AW_ONSTART_AW_
radio_switch()

_AW_ONENDSUB_AW_
}



