'-----------------------------------------------------------------------
Function GetValue(Str)
	GetValue = 0
	If Len(Trim(Str)) = 0 Then
		Exit Function
	End If
	GetValue = CLng(Str)
End Function
'-----------------------------------------------------------------------
Sub ProcSetData(Data)
	min = CLng(SCREEN.Object("main.COMBO0").data)' * 60

	ArrData = Split(Data, "|")

	'ADateTime = GetTime(ArrData(0), min / 60)
	If min = 60 Then
		ADateTime = GetTime(ArrData(0), min * 10000)
	Else
		ADateTime = GetTime(ArrData(0), min * 100)
	End If

	IsFlag = False
	If ADateTime <> Trim(S103310.GetGridCell(1, 1)) Then
		S103310.InsertRow 0
		IsFlag = True
	End If

	Close = GetValue(ArrData(4))

	Diff = ArrData(5)
	CVol = GetValue(ArrData(6))
	GVol = GetValue(ArrData(7))
	OpenInt = ArrData(8)
	OpenIntDiff = ArrData(9)




	If IsFlag Then

		If Left(Trim(Diff),1) = "1" Or Left(Trim(Diff),1) = "2"  Then
			If Left(CStr(Close),1) <> "+" Then
				Close = "+" & Close
			End If
		ElseIf Left(Trim(Diff),1) = "4" Or Left(Trim(Diff),1) = "5"  Then
			If Left(CStr(Close),1) <> "-" Then
				Close = "-" & Close
			End If
		End If

		S103310.SetGridCell 1, 1, ADateTime				'시간
		S103310.SetGridCell 1, 2, Close					'시가
		S103310.SetGridCell 1, 3, Close					'고가
		S103310.SetGridCell 1, 4, Close					'저가
		S103310.SetGridCell 1, 5, Close					'종가
		S103310.SetGridCell 1, 6, Diff					'전일대비
		S103310.SetGridCell 1, 7, CVol					'체결량
		S103310.SetGridCell 1, 8, GVol					'거래량
		S103310.SetGridCell 1, 9, OpenInt				'미결제

		If OpenIntDiff > 0 Then
			OpenIntDiff = "+" & OpenIntDiff
		End If

		S103310.SetGridCell 1, 10, OpenIntDiff			'미결제증감
	Else
		High = GetValue( S103310.GetGridCell(1, 3) )
		Close = GetValue(ArrData(4))
		Close = Abs(Close)
		High = Abs(High)

		If High < Close Then
			If Left(Trim(Diff),1) = "1" Or Left(Trim(Diff),1) = "2"  Then
				Close = "+" & Close
			ElseIf Left(Trim(Diff),1) = "4" Or Left(Trim(Diff),1) = "5"  Then
				Close = "-" & Close
			End If
			S103310.SetGridCell 1, 3, Close
		End If

		Low = GetValue( S103310.GetGridCell(1, 4) )
		Close = Abs(Close)
		Low = Abs(Low)

		If Low > Close Then
			If Left(Trim(Diff),1) = "1" Or Left(Trim(Diff),1) = "2"  Then
				Close = "+" & Close
			ElseIf Left(Trim(Diff),1) = "4" Or Left(Trim(Diff),1) = "5"  Then
				Close = "-" & Close
			End If
			S103310.SetGridCell 1, 4, Close
		End If

		If Left(Trim(Diff),1) = "1" Or Left(Trim(Diff),1) = "2"  Then
			If Left(CStr(Close),1) <> "+" Then
				Close = "+" & Close
			End If
		ElseIf Left(Trim(Diff),1) = "4" Or Left(Trim(Diff),1) = "5"  Then
			If Left(CStr(Close),1) <> "-" Then
				Close = "-" & Close
			End If
		End If

		S103310.SetGridCell 1, 5, Close
		S103310.SetGridCell 1, 6, Diff

		BefGVol = GetValue( S103310.GetGridCell(2, 8) )
		CVol = GVol - BefGVol

		S103310.SetGridCell 1, 7, CVol
		S103310.SetGridCell 1, 8, GVol
		S103310.SetGridCell 1, 9, OpenInt

		BefOpenInt = GetValue( S103310.GetGridCell(2, 9) )
		OpenIntDiff = OpenInt - BefOpenInt

		If OpenIntDiff > 0 Then
			OpenIntDiff = "+" & OpenIntDiff
		End If
		S103310.SetGridCell 1, 10, OpenIntDiff
	End If

	g_ArrInput(1) = ADateTime
End Sub
