Sub complete_cusstatus()

	Dim char,check_char,tmptujaYN,tmpinfoYN,tmptujaNM,tmptujaGD,tempYN

	acntNM.Data = Trim(LOGIN.Name)
	tmptujaYN = Trim(SCREEN.Object("obj_cusstatus.OUTPUT7").Data)
	tmpinfoYN = Trim(SCREEN.Object("obj_cusstatus.OUTPUT8").Data)
	tmptujaNM = Trim(SCREEN.Object("obj_cusstatus.zGrdNm").Data)

	If Trim(tmptujaYN) = "0" Then
		tmptujaYN = "미희망"
	Else
		tmptujaYN = "희망"
	End If

	If tmptujaNM = "안정형" Then
		check_char = 1
	ElseIf tmptujaNM = "안정추구형" Then
		check_char = 3
	ElseIf tmptujaNM = "위험중립형" Then
		check_char = 4
	ElseIf tmptujaNM = "적극투자형" Then
		check_char = 5
	ElseIf tmptujaNM = "공격투자형" Then
		check_char = 6
	End If

	If Trim(tmpinfoYN) = "0" Then
		tmptujaNM = ""
		tmpinfoYN = "미제공"
		'check_char = 7
	Else
		tmpinfoYN = "제공"
	End If

	Select Case check_char
		Case 1 :
			tmptujaGD = "매우낮은위험이하"
		Case 3 :
			tmptujaGD = "보통위험이하"
		Case 4 :
			tmptujaGD = "다소높은위험이하"
		Case 5 :
			tmptujaGD = "높은위험이하"
		Case 6 :
			tmptujaGD = "매우높은위험이하"
		Case 7 :
			tmptujaGD = ""
	End Select

	If Trim(SCREEN.Object("obj_cusstatus.LEDGER").Ecod) = "3956" Then '"미등록"
			tujaNM.Data = "없음(미등록)"
			tujaGD.Data = "-"
			NotujaCase()
			Exit Sub
	ElseIf CDbl(SCREEN.Object("obj_cusstatus.zToday").Data) > CDbl(SCREEN.Object("obj_cusstatus.zDueDate").Data) Then '만료일
		tujaNM.Data = "없음(만료)"
		tujaGD.Data = "-"
		NotujaCase()
		Exit Sub

	ElseIf Trim(SCREEN.Object("obj_cusstatus.OUTPUT6").Data) = "0" Then ' 전문금융소비자 일경우 스킵
		tujaNM.Data = "전문금융소비자"
		tujaGD.Data = "매우높은위험이하"
		grdimg1.Visible = True

	ElseIf tmpinfoYN = "미제공" Then '미희망은 요건 없어짐
			tujaNM.Data = "없음(정보미제공)"
			tujaGD.Data = "-"
			BOX6.Visible = False
			BUTTON1.Visible = True
			grdimage.Visible = False
			tujaimg.Visible = False
	Else '일반금융소비자
		'tujaYN.Data = tmptujaYN
		'infoYN.Data = tmpinfoYN
		tujaNM.Data = tmptujaNM
		tujaGD.Data = tmptujaGD

		Select Case check_char
		Case 1 :
			'tmptujaGD = "매우낮은위험이하"
			tujaimg5.Visible = True
			grdimg6.Visible = True
		Case 3 :
			'tmptujaGD = "낮은위험이하"
			tujaimg4.Visible = True
			grdimg4.Visible = True
		Case 4 :
			'tmptujaGD = "보통위험이하"
			tujaimg3.Visible = True
			grdimg3.Visible = True
		Case 5 :
			'tmptujaGD = "다소높은위험이하"
			tujaimg2.Visible = True
			grdimg2.Visible = True
		Case 6 :
			'tmptujaGD = "매우높은위험이하"
			tujaimg1.Visible = True
			grdimg1.Visible = True
	End Select

	End If


'	If	Trim(SCREEN.Object("obj_cusstatus.OUTPUT7").Data)  = "0" Then '0불원, 1제공
'		UTAB2.index = 1
'		OBJ2.SetObject("IB498920")'펀드검색
'	Else
'		UTAB2.index = 2
'		OBJ2.SetObject("IB49892T")'추천펀드
'	End If
'	SCREEN.Object("OBJ2.accn").Data = LOGIN.Juno
	OBJ2.Proc "Chk_Grd", ""
End Sub


