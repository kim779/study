Sub ChangeCode(param)
	'MsgBox "ChangeCode"
	ArrData = Split(param, "|")
	For i = LBound(ArrData) To UBound(ArrData)
		If i = 0 Then
			fundcode.Data = ArrData(i)
			'SCREEN.Object("OBJ4.fundcode").Data = ArrData(i)
		Else
			FundName2.Text = ArrData(i)
			FundName.Text = ArrData(i)
			'= ArrData(i)
		End If
	Next
'	MsgBox SCREEN.Object("OBJ4.fundcode").Data
	If UTAB0.ID <> "1" Then '일별기준가 FUND정보를 갖고 와서 가입 위함
