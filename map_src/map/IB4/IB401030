RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim ss_ed_focod
Dim ss_MapName, ss_FutureObjectName, ss_OptionObjectName
Dim ss_LotationTarget
Dim ss_IsChanged

ss_LotationTarget = "MF010900"
ss_MapName = Left(SCREEN.GetMapName(0), 6)
ss_FutureObjectName = ss_MapName & "51"
ss_OptionObjectName = ss_MapName & "61"

Private Sub Changeed_focod()
	Dim ls_hnam, ls_goodsdiv, ls_cdmm, ls_cdtm

   ls_cdmm = CDMM.Data
   ls_cdmm = Left(Trim(ls_cdmm) & "00000", 5)
   ls_cdtm = CDTM.data
   ss_ed_focod = ls_cdmm & Right("000" & Trim(ls_cdtm), 3)
   ls_goodsdiv = ss_ed_focod
   ls_goodsdiv = Left(Trim(ls_goodsdiv), 1)
	Select Case ls_goodsdiv
		Case "1"
           SetCaseOfFutures()
           CDMM.SetFocus()
		Case "2"
           SetCaseOfCallOptions()
           CDTM.SetFocus()
		Case "3"
           SetCaseOfPutOptions()
           CDTM.SetFocus()
		Case "4"
'           SetCaseOfSpreads()
'           CDMM.SetFocus()
	End Select

   OBJ.Send
End Sub

Private Sub SetCaseOfCallOptions()
   Dim ls_hnam

	OBJ.SetObject ss_OptionObjectName
	HNAM.TRGB = 6
	CDTM.ENABLE = True
	CDMM.Data = Left(Trim(ss_ed_focod), 5)
	CDTM.Data = Right(Trim(ss_ed_focod), 3)

	ls_hnam = SCREEN.GetName(102, Trim(ss_ed_focod), 0)
	If (Trim(ls_hnam) = "") Then
		GetValidCallOptions()
   Else
      HNAM.Data = Trim(ls_hnam)
      ed_focod.Data = Trim(ss_ed_focod)
   End If

   ed_focod.Push("C_ed_focod")

	SCREEN.Object("MAIN.OBJ.40301").data = Trim(ss_ed_focod)
End Sub

Private Sub SetCaseOfPutOptions()
   Dim ls_hnam

	OBJ.SetObject ss_OptionObjectName
	HNAM.TRGB = 7
	CDTM.ENABLE = True
	CDMM.Data = Left(Trim(ss_ed_focod), 5)
	CDTM.Data = Right(Trim(ss_ed_focod), 3)

	ls_hnam = SCREEN.GetName(102, Trim(ss_ed_focod), 0)
	If (Trim(ls_hnam) = "") Then
		GetValidPutOptions()
   Else
      HNAM.Data = Trim(ls_hnam)
      ed_focod.Data = Trim(ss_ed_focod)
	End If

   ed_focod.Push("P_ed_focod")

	SCREEN.Object("MAIN.OBJ.40301").data = Trim(ss_ed_focod)
End Sub

Private Sub GetValidCallOptions ()
    Dim lb_rtn, ls_hnam

    ed_focod.Pop("C_ed_focod")

    ss_ed_focod = ed_focod.data
    ss_ed_focod = Trim(ss_ed_focod)
    ls_hnam = SCREEN.GetName(102, ss_ed_focod, 0)
    If Trim(ls_hnam) = "" Or Left(Trim(ls_hnam), 1) <> "콜" Then
       lb_rtn = SCREEN.GetCode(112, "ed_focod", "HNAM", 0)
       ss_ed_focod = ed_focod.data
       ss_ed_focod = Trim(ss_ed_focod)
       ls_hnam = SCREEN.GetName(102, ss_ed_focod, 0)
    End If
    HNAM.Data = Trim(ls_hnam)
    CDMM.Data = Left(ss_ed_focod, 5)
    CDTM.Data = Right(ss_ed_focod, 3)
End Sub

Private Sub GetValidPutOptions ()
    Dim lb_rtn, ls_hnam

    ed_focod.Pop("P_ed_focod")

    ss_ed_focod = ed_focod.data
    ss_ed_focod = Trim(ss_ed_focod)
    ls_hnam = SCREEN.GetName(102, ss_ed_focod, 0)
    If Trim(ls_hnam) = "" Or Left(Trim(ls_hnam), 1) <> "풋" Then
       lb_rtn = SCREEN.GetCode(113, "ed_focod", "HNAM", 0)
       ss_ed_focod = ed_focod.data
       ss_ed_focod = Trim(ss_ed_focod)
       ls_hnam = SCREEN.GetName(102, ss_ed_focod, 0)
    End If
    HNAM.Data = Trim(ls_hnam)
    CDMM.Data = Left(ss_ed_focod, 5)
    CDTM.Data = Right(ss_ed_focod, 3)
End Sub

Private Sub SetCaseOfFutures()
   Dim ls_hnam

	OBJ.SetObject ss_FutureObjectName

   HNAM.TRGB = 5
	CDMM.Data = Left(ss_ed_focod, 5)
   CDTM.Data = "000"
   CDTM.Enable = False

	ls_hnam = SCREEN.GetName(101, ss_ed_focod , 0)
	If (Trim(ls_hnam) = "") Then
		HNAM.Data = ""
	   GetValidFutures()
	Else
		HNAM.Data = ls_hnam
      ed_focod.Data = ss_ed_focod
	End If

   ed_focod.Push("F_ed_focod")

	SCREEN.Object("MAIN.OBJ.30301").data = ss_ed_focod
End Sub

Private Sub SetCaseOfSpreads()
   Dim ls_hnam

	OBJ.SetObject ss_FutureObjectName

	HNAM.TRGB = 5
   CDTM.ENABLE = True
   CDMM.Data = Left(ss_ed_focod, 5)
   CDTM.Data = Right("000" & ss_ed_focod, 3)

	ls_hnam = SCREEN.GetName(101, ss_ed_focod , 0)
	If (Trim(ls_hnam) = "") Then
		HNAM.Data = ""
	   GetValidFutures()
	Else
		HNAM.Data = ls_hnam
      ed_focod.Data = ss_ed_focod
	End If

	SCREEN.Object("MAIN.OBJ.30301").data = ss_ed_focod
End Sub

Private Sub GetValidFutures ()
Dim lb_rtn, ls_hnam

    ed_focod.Pop("F_ed_focod")

    ss_ed_focod = ed_focod.data
    ss_ed_focod = Trim(ss_ed_focod)
    ls_hnam = SCREEN.GetName(101, ss_ed_focod, 0)
    If Trim(ls_hnam) = "" Or Left(Trim(ls_hnam), 1) <> "선" Then
       lb_rtn = SCREEN.GetCode(111, "ed_focod", "HNAM", 0)
       ss_ed_focod = ed_focod.data
       ss_ed_focod = Trim(ss_ed_focod)
       ls_hnam = SCREEN.GetName(101, ss_ed_focod, 0)
    End If

    HNAM.Data = Trim(ls_hnam)
    CDMM.Data = Left(ss_ed_focod, 5)
    CDTM.Data = Right(ss_ed_focod, 3)
End Sub

_AW_ONSEND_AW_
Dim code

code = Left(ed_focod.Data, 1)

If code = "1" Or code = "4" Or code = "A" Or code = "D" Then
	HNAM.Data = SCREEN.GetName (101, ed_focod.Data, 0)
	OBJ.SetObject "IB401031"
	SCREEN.Object("obj.30301").data = ed_focod.Data
	If Trim(HNAM.Data) =  "" Then
		ed_focod.Data = ""
	Else
		ed_focod.Trigger "ed_focod", True
		ed_focod.Trigger "30301", True
		SYSTEM.SetHistory "30301", ed_focod.Data
		SYSTEM.SetHistory "ed_focod", ed_focod.Data
	End If
Else
	HNAM.Data = SCREEN.GetName (102, ed_focod.Data, 0)
	OBJ.SetObject "IB401032"
	SCREEN.Object("obj.40301").data = ed_focod.Data
	If Trim(HNAM.Data) =  "" Then
		ed_focod.Data = ""
	Else
		ed_focod.Trigger "ed_focod", True
		ed_focod.Trigger "40301", True
		SYSTEM.SetHistory "40301", ed_focod.Data
		SYSTEM.SetHistory "ed_focod", ed_focod.Data
	End If
End If

OBJ.Send
SCREEN.OnSend = False

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(SYMBOL14)
_AW_ONCLICK_AW_
SCREEN.CHANGEMAP "IB401000"
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(SYMBOL7)
_AW_ONCLICK_AW_
Dim ed_focod

ed_focod = SCREEN.GetCode (103, "ed_focod", "HNAM", 2)
If ed_focod <>  True Then
	Exit Sub
End If
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(ed_focod)
_AW_ONCHANGE_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



