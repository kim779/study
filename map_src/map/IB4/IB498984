			workday = Date
			'오늘이 토요일 이거나 일요일 이면 전영업일로 초기화
			If a = 7 Or a = 1 Then
				workday = LOGIN.Day0
			End If
		End If

		nHead  = 1
		nData  = GRID0.rows
