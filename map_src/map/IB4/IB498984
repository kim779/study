'**********************************************************************
' 기능     : Size만큼 filler 값으로 왼쪽 채움
' 파라메터 : as_string : 문자열
'            as_cnt    : 문자열의 길이
'            as_filler : filler
' 리턴값   : cp_lpad
' 개발자   : 김동겸	04/09/08
' 수정자1  :
'**********************************************************************
Public Function cp_lpad(as_string, ai_count, as_filler)
	Dim ls_str, li_cnt
    '대상 String이 NULL이면 Filler로 채운 문자열 Return
	If IsNull(as_string) Then
		cp_lpad = String(ai_count, as_filler)
	Else
		ls_str = Trim(as_string) ' 공백 Trimming
		SCREEN.CreateObject("DX_CSTRING")
		DX_CSTRING.Text = ls_str
		li_cnt = ai_count - DX_CSTRING.GetLength()
		If li_cnt >= 0 Then
			cp_lpad = String(li_cnt, as_filler) & ls_str
		Else
			cp_lpad = Right(ls_str, ai_count)
		End If
	End If
End Function


'**********************************************************************
' 기능     : Size만큼 filler 값으로 오른쪽 채움
' 파라메터 : as_string : 문자열
'            as_cnt    : 문자열의 길이
'            as_filler : filler
' 리턴값   : cp_rpad
' 개발자   : 김동겸	04/09/08
' 수정자1  :
'**********************************************************************
Public Function cp_rpad(as_string, ai_count, as_filler)
	Dim ls_str, li_cnt
	'대상 String이 NULL이면 Filler로 채운 문자열 Return
	If IsNull(as_string) Then
		cp_rpad = String(ai_count, as_filler)
	Else
		ls_str = Trim(as_string) ' 공백 Trimming
		SCREEN.CreateObject("DX_CSTRING")
		DX_CSTRING.Text = ls_str
		li_cnt = ai_count - DX_CSTRING.GetLength()
		If li_cnt >= 0 Then
			cp_rpad = ls_str & String(li_cnt, as_filler)
		Else
			cp_rpad = Left(ls_str, ai_count)
		End If
	End If
End Function

