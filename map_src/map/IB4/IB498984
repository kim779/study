		drSize = 14
		pday   = workday
		mgap   = "0000"
		xtype  = " "
		xUnit(0)= " "
		xUnit(1)= " "
		xUnit(2)= " "
		tipName = " "
		reserve = " "

		sTot = cp_lpad(nHead,2," ")
		sTot = sTot & cp_lpad(nData ,6 ," ")
		sTot = sTot & cp_lpad(irSize,2 ," ")
		sTot = sTot & cp_lpad(drSize,2 ," ")
		sTot = sTot & cp_rpad(pday  ,8 ," ")
		sTot = sTot & cp_rpad(mgap  ,4 ," ")
