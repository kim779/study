'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	If Trim(fundcode.Data) = "" Then
		MsgBox "펀드코드를 입력하세요"
		Exit Sub
	End If
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub main_send()
	fundcode.Data = SCREEN.Object("main.fundcode").Data
	FundName.Text = SCREEN.Object("main.FundName").Text
	send_f()
End Sub

