	If zSvcKindCode.Data = "1102" Or zSvcKindCode.Data = "1108" Or zSvcKindCode.Data = "1106" Then
		zAcntNo.Data = zBkeepOppAcntNoCM.Data '& zSub.Data
	Else
		zAcntNo.Data = AN55.data & zSub.Data
	End If
Else
	zAcntNo.Data = AN55.data & zSub.Data
End If

