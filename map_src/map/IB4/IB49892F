Sub Set_account()
	ACNM.Data = AN55.Name
	zPwd.Data = AN55.Password
	If Trim(AN55.Data) = "" Then
		AN55.SetFocus
		Exit Sub
	End If

	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If
	SCREEN.Send 0
End Sub

Sub SetComboBox(items, names)

	zBkeepOppAcntNoCM.Clear
	zBkeepOppAcntNoCM.SetItems(items)
	zBkeepOppAcntNmCM.Clear
	zBkeepOppAcntNmCM.SetItems(names)
	zBkeepOppAcntNoCM.Data = zBkeepOppAcntNo.Data

End Sub

