RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim gridPos
gridPos = 1

Sub send_f()
	viewGrid.Clear
	gridPos = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	viewGrid.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0030"
Call send_f()

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

Dim dept, common_nm
If SCREEN.CreateObject("Info") Then
	dept = Trim(INFO.PopData("", "ACCNTDEPT.INI", "ACCNTDEPT", "DEPT"))
	common_nm = Trim(INFO.PopData("", "ACCNTDEPT.INI", "ACCNTDEPT", "COMMONNM"))
End If

EmpNo.Data = "9" & dept & common_nm

If Len(Trim(EmpNo.Data)) < 6 Then
	MsgBox "사원번호를 확인하세요.", , "IBK투자증권"
	EmpNo.SetFocus
	Exit Sub
End If

If Len(Trim(BaseDt.Data)) < 8 Then
	MsgBox "기준일을 확인하세요.", , "IBK투자증권"
	BaseDt.SetFocus
	Exit Sub
End If

Select Case Trim(S65303.DATA)
	Case	"561", "562", "563", "564"
		m_branch.Data = "03"
	Case	"575", "576", "577"
		m_branch.Data = "04"
	Case	"585", "586", "587"
		m_branch.Data = "05"
	Case	"000"
		m_branch.Data = "00"
End Select

'MsgBox LEDGER.Fkey, 0, ""
SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, tmpNm

If LEDGER.Next = "Y" Then
	next_btn.Enable = True
	next_btn.SetFocus
Else
	next_btn.Enable = False
	send_btn.SetFocus
End If

For ii = gridPos To viewGrid.Rows
	If Trim(viewGrid.GetGridCell(ii, 4)) = "매수" Then
		viewGrid.SetGridCell ii, 4, "+매수"
	ElseIf Trim(viewGrid.GetGridCell(ii, 4)) = "매도" Then
		viewGrid.SetGridCell ii, 4, "-매도"
	End If

	'계좌명 툴팁처리시 계좌명에 &가 있을경우 툴팁에 언더바로 표시되어 교체
	tmpNm = Trim(viewGrid.GetGridCell(ii, 2))

	If tmpNm = "" Then
		Exit Sub
	End If

	If InStr(tmpNm, "&") > 0 Then
		viewGrid.SetGridCell ii, 2, Replace(tmpNm, "&", "＆")
	End If
Next

gridPos = viewGrid.Rows + 1

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(viewGrid)
_AW_ONCLICK_AW_
If viewGrid.HitPos <> "3" Then
	Exit Sub
End If

Dim jmnm
ed_fcod.Data = Trim(viewGrid.GetGridCell(viewGrid.Row, 3))
jmnm = Trim(SCREEN.GetName(127, ed_fcod.Data, 0))

If jmnm <> "" Then
	ed_fcod.Trigger "ed_fcod", True
	ed_fcod.Trigger "100301", True
	SYSTEM.SetHistory "ed_fcod", ed_fcod.Data
	SYSTEM.SetHistory "100301", ed_fcod.Data
Else
	If Left(Trim(ed_fcod.Data), 1) = "1" Or Left(Trim(ed_fcod.Data), 1) = "4" Or _
	   Left(Trim(ed_fcod.Data), 1) = "A" Or Left(Trim(ed_fcod.Data), 1) = "D" Then
		ed_fcod.Trigger "30301", True
		SYSTEM.SetHistory "30301", ed_fcod.Data
	ElseIf Left(ed_fcod.Data, 1) = "2" Or Left(ed_fcod.Data, 1) = "3" Or _
	       Left(ed_fcod.Data, 1) = "B" Or Left(ed_fcod.Data, 1) = "C" Then
		ed_fcod.Trigger "40301", True
		SYSTEM.SetHistory "40301", ed_fcod.Data
	End If

	ed_fcod.Trigger "ed_focod", True
	SYSTEM.SetHistory "ed_focod", ed_fcod.Data
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(next_btn)
_AW_ONCLICK_AW_
Call send_c()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BaseDt)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(65302)
_AW_ONCHANGE_AW_


'obj01.Send
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(65303)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(EDIT0)
_AW_ONCHANGE_AW_
Call send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



