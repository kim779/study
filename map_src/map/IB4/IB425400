_AW_ONDECLARE_AW_
Dim Radio, YM, Jasan, code, codedic,COMBO
Set codedic = createobject("scripting.dictionary")

Sub SelectRD()
	If rd1.Checked = True Then
		SCREEN.Object("jnam.jnam").Enable = False
		YYMM.Enable = True
	ElseIf rd2.Checked = True Then
		SCREEN.Object("jnam.jnam").Enable = True
		YYMM.Enable = False
	End If

Call Set_Ini("1", "0", "0")
'Call Trace("SelectRD")

End Sub

Sub send_yymm()
	SCREEN.ClearAll 0, 2
	gubn.Data = 0
	yy_mm.Data = YYMM.Data
	SCREEN.Send 0
End Sub

Sub send_id()
	SCREEN.ClearAll 0, 2
	gubn.Data = 1
	jsid.Data = SCREEN.Object("jnam.jnam").data
	SCREEN.Send 0
End Sub


Sub Get_Ini()
		If SCREEN.CreateObject("Info") Then
			Radio = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB425400", "Radio"))
			COMBO = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB425400", "COMBO"))

			'ini값이 없으면 초기 세팅으로 저장한다.
			If Len(Trim(Radio)) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB425400", "Radio", "1"
				Radio = "1"
			End If

			If Radio = "1" Then
				rd1.Checked = True
			Else
				rd2.Checked = True
			End If

			If Len(Trim(COMBO)) = 0 Then
				INFO.PushData LOGIN.Name, "userconf.ini", "IB425400", "COMBO", "1"
				COMBO = "1"
			End If

			COMBO0.Data = COMBO
		End If
				'///////////////////////////////YM///////////////////////////////////////////
				'라디오버튼이 선택되지 않아도 콤보박스 세팅해준다.
				YM = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB425400", "YM"))

				If Len(Trim(YM)) = 0 Then
					YYMM.Index = 0
					yy_mm.Data = YYMM.Data
				Else
					yy_mm.Data = YM

					Call SelectComboBoxItem("YYMM", YM)
				End If
				'///////////////////////////////YM///////////////////////////////////////////

				'///////////////////////////////Jasan////////////////////////////////////////
				'라디오버튼이 선택되지 않아도 콤보박스 세팅해준다.
				Jasan = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB425400", "Jasan"))

				If Len(Trim(Jasan)) = 0 Then
					SCREEN.Object("jnam.jnam").Index = 0
					yy_mm.Data = SCREEN.Object("jnam.jnam").Data
				Else
					jsid.Data = Jasan

					Call SelectComboBoxItem("jnam.jnam", Jasan)
				End If
				'///////////////////////////////Jasan////////////////////////////////////////

'	Call Trace("Get_Ini")
End Sub


'1저장함, 0 저장안함
Sub Set_Ini(bRadio, bYM, bJasan)
	If rd1.Checked Then
		Radio = "1"
	Else
		Radio = "2"
	End If

	If SCREEN.CreateObject("Info") Then
		If bRadio = "1" Then
			INFO.PushData LOGIN.Name, "userconf.ini", "IB425400", "Radio", Trim(Radio)
		End If

		If bYM = "1" Then
			YM = Trim(YYMM.Data)
			INFO.PushData LOGIN.Name, "userconf.ini", "IB425400", "YM", Trim(YM)
		End If

		If bJasan = "1" Then
			Jasan = Trim(SCREEN.Object("jnam.jnam").data)
			INFO.PushData LOGIN.Name, "userconf.ini", "IB425400", "Jasan", Trim(Jasan)
		End If

		COMBO = COMBO0.Data
		INFO.PushData LOGIN.Name, "userconf.ini", "IB425400", "COMBO", Trim(COMBO)
	End If

'	Call Trace("Set_Ini")

End Sub


Sub Trace(strDes)
'	SYSTEM.Trace "+++" & strDes & "+++Radio===>" & Radio
'	SYSTEM.Trace "+++" & strDes & "+++YM===>" & YM
'	SYSTEM.Trace "+++" & strDes & "+++Jasan===>" & Jasan
End Sub


'콤보박스에 같은 값이 없다고 가정하고 일치하는 아이템으로 세팅하기
Sub SelectComboBoxItem(hCombo, strItem)
	Dim i, value , temp
	i = 0
	temp =""
	SCREEN.Object(hCombo).Index = i

	value = Trim(SCREEN.Object(hCombo).Data)

'	SYSTEM.Trace "hCombo.Data===>" & Trim(SCREEN.Object(hCombo).Data)
'	SYSTEM.Trace "strItem===>" & strItem

			Do While Trim(value) <> ""
				SCREEN.Object(hCombo).Index = i
				value = SCREEN.Object(hCombo).Data

				If Trim(strItem) = Trim(value) Or Trim(value) = Trim(temp) Then
					Exit Do
				End If

				i = i+1
				temp = value
'				SYSTEM.Trace "hCombo.Index===>" & i
'				SYSTEM.Trace "hCombo.Data===>" & value
			Loop
End Sub


Sub codesave()
	Dim i
	codedic.RemoveAll()
	For i = 1 To GRID1.Rows
		codedic.add GRID1.GetGridCell(i,1), i
		codedic.add "*"&i&GRID1.GetGridCell(i,14), i
	Next

	'For Each aa In codedic.keys
	'	SYSTEM.Trace Trim(codedic.item(aa))
	'Next
End Sub

