RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_ArrData

g_ArrData = Array(0, 0, 0, 0)	'REAL 시간, REAL JISU, 거래소 지수, 거래소대비
'----------------------------------------------------------------
Sub SetData()
	For i = LBound(g_ArrData) To UBound(g_ArrData)
		If g_ArrData(0) = 0 Or g_ArrData(2) = 0 Then
			Exit Sub
		End If
	Next
	BefJisu = g_ArrData(2) - g_ArrData(3)


	'LABEL0.Data = g_ArrData(1) & "|" & g_ArrData(2)
	Diff = g_ArrData(1) - BefJisu
	If BefJisu = 0 Then
		Exit Sub
	End If
	DiffRate = Diff * 100 / BefJisu
	Gap = g_ArrData(2) - g_ArrData(1)


	If g_ArrData(1) > BefJisu Then
		RealJisu = "+" & FormatNumber(g_ArrData(1), 2, -2, -2, 0)
		Diff = "2 " & FormatNumber(Diff, 2, -2, -2, 0)
		DiffRate = "+" & FormatNumber(DiffRate, 2, -2, -2, 0)
	ElseIf g_ArrData(1) < BefJisu Then
		RealJisu = FormatNumber(g_ArrData(1), 2, -2, -2, 0)

		Diff = "5 " & FormatNumber(Abs(Diff), 2, -2, -2, 0)
		DiffRate = "-" & FormatNumber(DiffRate, 2, -2, -2, 0)
	Else
		RealJisu = FormatNumber(g_ArrData(1), 2, -2, -2, 0)
		Diff = "3 " & FormatNumber(Diff, 2, -2, -2, 0)
		DiffRate = FormatNumber(DiffRate, 2, -2, -2, 0)
	End If

	If g_ArrData(2) > BefJisu Then
		K200Jisu = "+" & FormatNumber(g_ArrData(2), 2, -2, -2, 0)
	ElseIf g_ArrData(2) < BefJisu Then
		K200Jisu = FormatNumber(g_ArrData(2), 2, -2, -2, 0)
	Else
		K200Jisu = FormatNumber(g_ArrData(2), 2, -2, -2, 0)
	End If

	If Gap > 0 Then
		Gap = "+" & FormatNumber(Gap, 2, -2, -2, 0)
	ElseIf Gap < 0 Then
		Gap = "-" & FormatNumber(Gap, 2, -2, -2, 0)
	Else
		Gap = FormatNumber(Gap, 2, -2, -2, 0)
	End If

	GRID.InsertRow 0
	GRID.SetGridCell 1, 1, g_ArrData(0)
	GRID.SetGridCell 1, 3, RealJisu
	GRID.SetGridCell 1, 4, K200Jisu
	GRID.SetGridCell 1, 5, Diff
	GRID.SetGridCell 1, 6, DiffRate
	GRID.SetGridCell 1, 7, Gap


End Sub
'----------------------------------------------------------------
Sub SetTime(Data)
	'LABEL0.Data = Data
End Sub
'----------------------------------------------------------------
Sub SetKRXData(Data)
	ArrData = Split(Data, "|")
	If UBound(ArrData) < 1 Then
		Exit Sub
	End If

	g_ArrData(2) = CDbl(ArrData(0))
	g_ArrData(3) = CDbl(ArrData(1))
	SetData
End Sub
'----------------------------------------------------------------
Sub SetRealData(Data)
	ArrData = Split(Data, "|")
	If UBound(ArrData) < 1 Then
		Exit Sub
	End If

	g_ArrData(0) = Trim(ArrData(0))
	g_ArrData(1) = CDbl(ArrData(1))
	SetData
End Sub

_AW_ONSTART_AW_
S21309.Data = "00"
SCREEN.Send 0
OBJECT0.Proc "SendData", ""
OBJECT1.Proc "SendData", ""

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
