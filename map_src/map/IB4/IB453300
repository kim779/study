'End If

If S100301.Data <> "" Then
	If Mid(S100301.Data, 1, 1) = "4" Or Mid(S100301.Data, 1, 1) = "D" Then
		S100301.Data = g_StdCode
		Exit Sub
	Else
		g_StdCode = S100301.Data
	End If
