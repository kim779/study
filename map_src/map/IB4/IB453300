RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_IsFirst
Dim g_StdCode
Dim g_BefAccVol
Dim g_Today

g_IsFirst = True
g_StdCode = ""
g_BefAccVol = 0
g_Today = GetToday()
'-----------------------------------------------------------------------
Function Str2Int(Data)
	Str2Int = 0
	AData = Trim(Data)
	If Len(AData) = 0 Then
		Exit Function
	End If
	Str2Int = CLng(AData)
End Function
'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	If Data > 0 Then
		SetSign = "+" & Data
	End If
End Function
'-----------------------------------------------------------------------
Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function
'-----------------------------------------------------------------------
Sub S100301Change()
	S100301.Trigger "", True
	S100301.Trigger "ed_fcod", True
	SYSTEM.SetHistory "ed_fcod", S100301.Data
	SCREEN.Send 0
End Sub
'-----------------------------------------------------------------------
Sub ProcSendData(Name1)
	If Len(S100301.Data) = 0 Then
		Exit Sub
	End If

	If Mid(S100301.Data, 1, 1) <> "1" And Mid(S100301.Data, 1, 1) <> "A" Then
		Exit Sub
	End If

	obj1.Proc "ProcSendData", S100021.Data & ", " & COMBO0.Data & ", " & ed_Date.Data
End Sub
'-----------------------------------------------------------------------
Sub OnAlert()
	If CLng(g_Today) <> CLng(ed_Date.Data) Then
		Exit Sub
	End If

	If Len(S101027.Data) = 0 Then
		Exit Sub
	End If

	If S101027.Data = "0" Then
		Exit Sub
	End If

	If CLng(g_BefAccVol) = Str2Int(S101027.Data) Then
		Exit Sub
	End If

	ArrData = Array("", "", "", "", "", "", "", "", "")
	'0:시간 혹은 일자
	'1:현물가, 2:현재가, 3:대비, 4:이론가, 5:이론베이시스
	'6:시장베이시스, 7:괴리치, 8:괴리율
	If COMBO0.Data = "0000" Then
		ArrData(0) = ed_Date.Data
	Else
		ArrData(0) = S101034.Data
	End If

	ArrData(1) = S101002.Data
	ArrData(2) = S101023.Data
	ArrData(3) = S101024.Data
	ArrData(4) = S101202.Data
	ArrData(5) = SetSign(FormatNumber(Abs(CDbl(ArrData(4))) - Abs(CDbl(ArrData(1))), 2, -2, -2, 0))
	ArrData(6) = SetSign(FormatNumber(Abs(CDbl(ArrData(2))) - Abs(CDbl(ArrData(1))), 2, -2, -2, 0))
	ArrData(7) = SetSign(FormatNumber(Abs(CDbl(ArrData(2))) - Abs(CDbl(ArrData(4))), 2, -2, -2, 0))

	If CDbl(ArrData(4)) = 0 Then
		ArrData(8) = 0
	Else
		ArrData(8) = SetSign(FormatNumber(CDbl(ArrData(7))*100/CDbl(ArrData(4)), 2, -2, -2, 0))
	End If

	Data = Join(ArrData, "|")
	obj1.Proc "ProcSetData", Data

	g_BefAccVol = S101027.Data
End Sub

_AW_ONSEND_AW_
If Mid(S100301.Data, 1, 1) = "4" Or Mid(S100301.Data, 1, 1) = "D" Then
	S100301.Data = ""
	SCREEN.OnSend = False
	Exit Sub
ElseIf Len(Trim(S100301.Data)) <> 8 Then
	S100301.Data = ""
	SCREEN.OnSend = False
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Len(Trim(S101027.Data)) = 0 Then
	S101027.Data = "0"
	g_BefAccVol = 0
Else
	g_BefAccVol = CLng(S101027.Data)
End If

ProcSendData("")

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(101023)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(101024)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(101202)
