RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub DoReceive()		'IB810101을 원본으로 작업
	Dim ii, items, accnCell, accnText, names, nameText
	items = ""
	names = ""

	For ii = 1 To GRID0.Rows
		accnCell = Trim(GRID0.GetGridCell(ii, 9))
		accnText = Trim(GRID0.GetGridCell(ii, 9))
		nameText = Trim(GRID0.GetGridCell(ii, 10))

		If Trim(accnCell) = "" Then
			Exit For
		End If

		If (CLng(Left(accnCell, 3)) < 551 Or CLng(Left(accncell, 3)) > 558) And CLng(Left(accncell, 3)) <> 561 Then	'551~555(은행예수금계좌) 제외 556추가
																													'160119 557계좌 추가 '190103 561계좌 추가
																													'201006 558계좌 추가(은행예수금계좌, IBK주거래생활금융통장)

			If Trim(items) = "" Then
				items  = accnCell
				names = nameText
			End If

			If Trim(GRID0.GetGridCell(ii, 11)) = "1" And Trim(GRID0.GetGridCell(ii, 12)) = "동일인" Then
				If Mid(accnText, 4, 2) = "10" Or Mid(accnText, 4, 2) = "51" And Len(accnCell) = 11 Then
					items =  items  & vbTab & accnCell & Left(accnText, 3) & "-" & Mid(accnText, 4, 2) & "-" & Mid(accnText, 6, 10)
					names = names & vbTab & nameText
				End If
			End If
		End If
	Next

	SCREEN.Proc "Parent.SetComboBox" , items & ", " & names
End Sub

_AW_ONSTART_AW_
LEDGER.Rcnt = "0025"
zElecfnUserId.Data = LEDGER.Usid

send_f()

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Trim(LEDGER.Next) = "Y" Then
	send_c()
Else
	GRID0.Sort 9, True, True
	Call DoReceive()
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(Out)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(send_btn)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



