Sub SetData(Data)
	rk200.Data = Data

	If Len(Trim(S20023.Data)) < 1 Then
		Exit Sub
	End If
	gapData = rk200.Data - S20023.Data

	If gapData > 0 Then
		gapData = "+" & FormatNumber(gapData, 2, -2, -2, 0)
	ElseIf gapData < 0 Then
		gapData = "-" & FormatNumber(gapData, 2, -2, -2, 0)
	Else
		gapData = FormatNumber(gapData, 2, -2, -2, 0)
	End If
	gap.Data = gapData
End Sub

