_AW_ONDECLARE_AW_
Sub GET_CHECK_COD()
	Dim t_rows
	Dim ii
	Dim ls_temp
	Dim ls_temp2
	Dim ls_cnt

	If COD_CNT.Data > 4 Then
		Exit Sub
	ElseIf COD_CNT.Data < 0 Then
		Exit Sub
	End If

	COD1.Data = ""
	COD2.Data = ""
	COD3.Data = ""
	COD4.Data = ""

	t_rows = SCREEN.Object("MAIN.OBJ02.HANG").Rows

	ls_cnt = 0
	For ii = 1  To t_rows
		ls_temp = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 1)

		If Trim(ls_temp) = "" Then
			ls_temp = ""
		Else
			ls_temp2 = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 2)
			If ls_temp2 = "1" Then
				If ls_cnt = 0 Then
					COD1.Data = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 1)
					ls_cnt = ls_cnt +1
				ElseIf ls_cnt = 1 Then
					COD2.Data = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 1)
					ls_cnt = ls_cnt +1
				ElseIf ls_cnt = 2 Then
					COD3.Data = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 1)
					ls_cnt = ls_cnt +1
				ElseIf ls_cnt = 3 Then
					COD4.Data = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 1)
					ls_cnt = ls_cnt +1
				End If
			End If
		End If
	Next
	For ii = 1  To t_rows
		ls_temp = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 5)

		If Trim(ls_temp) = "" Then
			ls_temp = ""
		Else
			ls_temp2 = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 4)
			If ls_temp2 = "1" Then
				If ls_cnt = 0 Then
					COD1.Data = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 5)
					ls_cnt = ls_cnt +1
				ElseIf ls_cnt = 1 Then
					COD2.Data = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 5)
					ls_cnt = ls_cnt +1
				ElseIf ls_cnt = 2 Then
					COD3.Data = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 5)
					ls_cnt = ls_cnt +1
				ElseIf ls_cnt = 3 Then
					COD4.Data = SCREEN.Object("MAIN.OBJ02.HANG").GetGridCell(ii, 5)
					ls_cnt = ls_cnt +1
				End If
			End If
		End If
	Next
'SYSTEM.Trace "end sub......"
End Sub

_AW_ONSEND_AW_
