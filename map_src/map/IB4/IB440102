_AW_ONDECLARE_AW_
Dim save
'-----------------------------------------------------------------
' DESC : 차트 속성 셋팅
'-----------------------------------------------------------------
Sub Query_Chart(trcd, gap)
	Dim sCode, retc, cnt
	sCode = Trim(SCREEN.Object("main.70301").data)
	cnt = Trim(edt_time.data)
	If Trim(sCode) = "" Then
		Exit Sub
	End If

	If StrComp(save, sCode&Trim(lab_01.Text)&Trim(lab_02.Text)&cnt, 1) = 0 Then
		Exit Sub
	End If
	save = sCode&Trim(lab_01.Text)&Trim(lab_02.Text)&cnt

	ctl0.ClearAllData
	ctl0.SetChartPeriod 0, trcd

	ctl0.Setticksize 0, 0.01
	ctl0.SetDisplaySize cnt						'요청갯수
	If trcd <> 2 Then
		ctl0.Setgraphheader 0, trcd, 3, gap		'분간격
		ctl0.Setchartcycle trcd, gap
	End If
	ctl0.SetInputValue 0, trcd, "71301", sCode
	ctl0.RequestData 0, trcd
	edt_time.SetFocus
End Sub
'-----------------------------------------------------------------
' DESC : 버튼관련 함수
