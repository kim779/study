		SCREEN.Object("tmpR"&ii).Data = "0"

	ElseIf ii = 10 Then
		SCREEN.Object("tmpR"&ii).Data = "1" '모집유형 디폴트 공모 1

	ElseIf ii = 11 Or  ii = 14 Then
		For jj = 0 To 2
			If SCREEN.Object("radio"&ii&jj).checked Then
				SCREEN.Object("tmpR"&ii).Data = CLng(jj)
			End If
		Next

	ElseIf ii = 13 Then
		For jj = 0 To 11
			If SCREEN.Object("radio"&ii&jj).checked Then
				SCREEN.Object("tmpR"&ii).Data = CLng(jj)
			End If
		Next
