Function P_pswdConfirm2(accn, pswd, msg)
	Dim ret, sdata
	'SCREEN.ClearAll 2, 2
	'SCREEN.Object("main.OBJ_order.jumn_obj.zAcntNo").Data = ""

	GUIDE.Text = ""
	P_pswdConfirm2 = False

	If SYSTEM.ConnectBy = "0" Then
		If Len(Trim(accn)) <> 11 Then
			msg = "계좌번호를 확인하여 주십시오."
			MsgBox msg, , "IBK투자증권"
			Exit Function
		End If

		If Len(Trim(pswd)) > 8 Or Len(Trim(pswd)) < 4 Then
			msg = "비밀번호를 확인하여 주십시오."
			MsgBox msg, , "IBK투자증권"
			Exit Function
		End If
		msg = ""

		sdata = accn&pswd
		ret = SCREEN.ServiceEx("pibopswd", accn&pswd, Len(sdata), 0, 600000)
		If Left(ret,1) <> "1" Then
			msg = Mid(ret,2,99)
			If Trim(msg) = "" Then
				msg = "대기 시간 초과입니다. 결과를 꼭 확인 바랍니다."
			End If

			If InStr(msg, "3669") > 0 Then
				MsgBox msg, , "IBK투자증권"
			End If

			GUIDE.Text = Trim(msg)
			Exit Function
		End If
	End If

	P_pswdConfirm2 = True
End Function

