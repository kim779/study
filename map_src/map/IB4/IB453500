_AW_ONDECLARE_AW_
Dim g_IsFirst
Dim g_StdCode
Dim g_BefAccVol
Dim g_Today

g_IsFirst = True
g_StdCode = ""
g_BefAccVol = 0
g_Today = GetToday()
'-----------------------------------------------------------------------
Function Str2Dbl(Data)
	Str2Dbl = 0
	AData = Trim(Data)
	If Len(AData) = 0 Then
		Exit Function
	End If
	Str2Dbl = CDbl(AData)
End Function
'-----------------------------------------------------------------------
Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function
'-----------------------------------------------------------------------
Sub OnAlert()
	If Len(Trim(S100021.Data)) = 0 Or Len(Trim(lb_ComCode.Data)) = 0 Then
		Exit Sub
	End If

	If Len(Trim(S101027.Data)) = 0 Then
		AccVol = 0
	Else
		AccVol = CLng(S101027.Data)
	End If

	If g_BefAccVol = AccVol Then
		Exit Sub
	End If
	ArrData = Array("", "", "", "", "", "", "")
	If COMBO0.Data = "0000" Then
		ArrData(0) = g_Today
	Else
		ArrData(0) = S101034.Data
	End If

	ArrData(1) = FormatNumber(Str2Dbl(S101023.Data), 2, -2, -2, 0)
	ArrData(2) = FormatNumber(Str2Dbl(S101024.Data), 2, -2, -2, 0)
	ArrData(3) = FormatNumber(Str2Dbl(S101202.Data), 2, -2, -2, 0)

	ArrData(4) = FormatNumber(Str2Dbl(lb_ComCurr.Data), 2, -2, -2, 0)
	ArrData(5) = FormatNumber(Str2Dbl(lb_ComDiff.Data), 2, -2, -2, 0)
	ArrData(6) = FormatNumber(Str2Dbl(lb_ComTheoPrc.Data), 2, -2, -2, 0)

	Data = Join(ArrData, "|")
	obj1.Proc "ProcSetData", Data
	g_BefAccVol = AccVol
End Sub
'-----------------------------------------------------------------------
Sub S100301Change()
	S100301.Trigger "", True
	S100301.Trigger "ed_fcod", True
	SYSTEM.SetHistory "ed_fcod", S100301.Data
	SCREEN.Send 0
End Sub
'-----------------------------------------------------------------------
Sub ProcCompData(Curr, Diff, TheoPrc)
	lb_ComCurr.Data = Curr
	lb_ComDiff.Data = Diff
	lb_ComTheoPrc.Data = TheoPrc
End Sub
'-----------------------------------------------------------------------
Sub ProcSetComCode(ComCode)
	lb_ComCode.Data = ComCode
	ProcSendData("")
End Sub
'-----------------------------------------------------------------------
Sub ProcSendData(Name1)
	If Len(S100301.Data) = 0 Then
		Exit Sub
	End If
	If Len(lb_ComCode.Data) = 0 Then
		Exit Sub
	End If
	
	Select Case Trim(Left(S100301.Data, 1))
	Case "1", "A"
		' Process
	Case Else
		Exit Sub
	End Select 
	
	
	Select Case Trim(Left(lb_ComCode.Data, 1))
	Case "1", "A"
		' Process
	Case Else
		Exit Sub
	End Select 

	obj1.Proc "ProcSendData", S100021.Data & ", " & lb_ComCode.Data & ", " & COMBO0.Data
End Sub

