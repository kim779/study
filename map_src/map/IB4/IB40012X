Sub Query_Chart(gubn)
	startf = 1

	Call Bt_Period_Init() '주기 버튼 전체 초기화
	Call Bt_Gap_Init()  'GAP 버튼 전체 초기화

	mtgubn.Data = 0   '분/틱 구분 초기화
'	drChart.ChangeMinorFID "610"    '일,주,월 차트
	e_gubn.Data = gubn  '파일저장용

	Select Case gubn
		Case 1
			Call change_chart(1)
			S101308.Data = "01"       '101308 = 일,주,월 구분 Symbol
			b_day.Visible = False
		Case 2
			Call change_chart(2)
			S101308.Data = "02"
			b_week.Visible = False
		Case 3
			Call change_chart(3)
			S101308.Data = "03"
			b_mon.Visible = False
		Case 4
			Call change_chart(4)
			'drChart.ChangeMinorFID "510"  '분 차트
			mtgubn.data = 1
			b_min.Visible = False
		Case 5
			Call change_chart(5)
			mtgubn.data = 2
			b_tick.Visible = False
		Case Else
			Exit Sub
	End Select
	SCREEN.Send 0
End Sub

Sub Set_Gap(unit)
	S101308.Data = unit       '101308 = 분,틱일 경우 Gap 조절 Symbol

	Call Bt_Gap_Init()
		Select Case unit       '해당 Gap 버튼만 눌림표시
		Case 1
			g_gunit = "001"
			b_1.Visible = False
		Case 5
			g_gunit = "005"
			b_5.Visible = False
		Case 10
			g_gunit = "010"
			b_10.Visible = False
		Case 30
			g_gunit = "030"
			b_30.Visible = False
		Case Else
			Exit Sub
	End Select
	Call Query_Chart(g_gubn)
End Sub

Sub Bt_Period_Init()
	b_day.Visible = True
	b_week.Visible = True
	b_mon.Visible = True
	b_min.Visible = True
	b_tick.Visible = True
End Sub

Sub Bt_Gap_Init()
	b_1.Visible = True
	b_5.Visible = True
	b_10.Visible = True
	b_30.Visible = True
End Sub

Sub load_config()
SYSTEM.Trace "this"
	If SCREEN.CreateObject("DX_INFO") Then
		gubn = Trim(DX_INFO.PopData(LOGIN.Name, "userconf.ini", map_name, "GUBN"))
		unit = Trim(DX_INFO.PopData(LOGIN.Name, "userconf.ini", map_name, "UNIT"))

		If Trim(unit) <> "" Then
			'mgap.Data = unit
			'tgap.Data = unit
		End If

		If Trim(gubn) <> "" Then
			Call Query_Chart(gubn)
		Else
			Call Query_Chart(5)
		End If
	End If
End Sub

Sub save_config()
	If SCREEN.CreateObject("DX_INFO") Then
		DX_INFO.PushData LOGIN.name, "userconf.ini", map_name, "GUBN", Trim(e_gubn.Data)
		'DX_INFO.PushData LOGIN.name, "userconf.ini", map_name, "UNIT", Trim(e_unit.Data)
	End If
End Sub

