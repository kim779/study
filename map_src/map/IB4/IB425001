_AW_ONDECLARE_AW_
Dim bChangeMap
bChangeMap = False

Sub p_write_ini(key, val)
	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, "userconf.ini", "IB425000", key, val
	End If
End Sub

Function p_read_ini(key)
	If SCREEN.CreateObject("INFO") Then
		p_read_ini = INFO.PopData(LOGIN.Name, "userconf.ini","IB425000", key)
	End If
End Function

Sub Initialize()
	mapName = p_read_ini("LASTMAP")
	If SCREEN.GetMapName(0)<>mapName Then
		bChangeMap = True
		SCREEN.SetTimer 1, True
	End If
End Sub

_AW_ONSTART_AW_

Call Initialize()

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
If bChangeMap=True Then
	SCREEN.ChangeMap p_read_ini("LASTMAP")
End If

