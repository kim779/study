RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_ArrData
Dim g_ArrInput

g_ArrData = Array("", "", "", "", "", "", "", "", "", "")
'시간 혹은 일자, 기준현재가, 기준대비, 기준이론가, 비교현재가
'비교대비, 비교이론가, SP, 이론SP, 괴리SP
g_ArrInput = Array("", "")
'TimeType, GridLastDate or GridLastTime
'-----------------------------------------------------------------------
Function SetPrcSign(Diff, Data)
	Giho = Mid(LTrim(Diff), 1, 1)
	If Giho = "1" Or Giho = "2" Then
		SetPrcSign = "+" & LTrim(Data)
	ElseIf Giho = "4" Or Giho = "5" Then
		SetPrcSign = "-" & LTrim(Data)
	Else
		SetPrcSign = Data
	End If
End Function
'-----------------------------------------------------------------------
Function SetSign(Data)
	SetSign = Data
	If Data > 0 Then
		SetSign = "+" & Data
	End If
End Function
'-----------------------------------------------------------------------
Function SetTimeElement(Element)
	If Len(Element) = 1 Then
		Element = "0" & Element
	End If
	SetTimeElement = Element
End Function
'-----------------------------------------------------------------------
Function GetTime(SrcTime, MinGap)
	'SrcTime = SrcTime - SrcTime Mod MinGap + MinGap
	If Len(SrcTime) = 5 Then
		SrcTime = "0" & SrcTime
	End If

	AHour = Mid(SrcTime, 1, 2)
	AMin = CLng(Mid(SrcTime, 3, 2))
	AMin = AMin - AMin Mod MinGap

	ADate = TimeSerial(AHour, AMin + MinGap, 0)

	AHour = SetTimeElement(Hour(ADate))
	AMin = SetTimeElement(Minute(ADate))
	ASec = SetTimeElement(Second(ADate))


	GetTime = AHour & AMin & ASec
End Function
'-----------------------------------------------------------------------
Sub ProcSendData(StdCode, CompCode, TimeType)
	ed_StdCode.Data = StdCode
	ed_CompCode.Data = CompCode
	ed_TimeType.Data = TimeType

	g_ArrInput(0) = TimeType

	If TimeType = "0000" Then
		GRID0.SetColumnVisible 1, False
		GRID0.SetColumnVisible 2, True
	Else
		GRID0.SetColumnVisible 1, True
		GRID0.SetColumnVisible 2, False
	End If
	GRID0.Clear
	SCREEN.Send 0
End Sub
'-----------------------------------------------------------------------
Sub ProcSetData(Data)
	ArrData = Split(Data, "|")

	TimeIndex = 1
	If g_ArrInput(0) = "0000" Then
		ADateTime = ArrData(0)
		TimeIndex = 2
	Else
		ADateTime = GetTime(ArrData(0), g_ArrInput(0) / 60)
		TimeIndex = 1
	End If

	If ADateTime <> g_ArrInput(1) Then
		GRID0.InsertRow 0
	End If

	StdCurr = SetPrcSign(ArrData(2), ArrData(1))
	StdDiff = ArrData(2)
	StdTheoPrc = ArrData(3)

	ComCurr = SetPrcSign(ArrData(5), ArrData(4))
	ComDiff = ArrData(5)
	ComTheoPrc = ArrData(6)

	Spread = SetSign(FormatNumber(CDbl(ArrData(1)) - CDbl(ArrData(4)), 2, -2, -2, 0))
	TheoSpread = SetSign(FormatNumber(StdTheoPrc - ComTheoPrc, 2, -2, -2, 0))
	AlienSpread = SetSign(FormatNumber(Spread - TheoSpread, 2, -2, -2, 0))

	GRID0.SetGridCell 1, TimeIndex, ADateTime
	GRID0.SetGridCell 1, 4, StdCurr
	GRID0.SetGridCell 1, 5, StdDiff
	GRID0.SetGridCell 1, 6, StdTheoPrc
	GRID0.SetGridCell 1, 7, ComCurr
	GRID0.SetGridCell 1, 8, ComDiff
	GRID0.SetGridCell 1, 9, ComTheoPrc
	GRID0.SetGridCell 1, 10, Spread
	GRID0.SetGridCell 1, 11, TheoSpread
	GRID0.SetGridCell 1, 12, AlienSpread

	g_ArrInput(1) = ADateTime
End Sub
'-----------------------------------------------------------------------

_AW_ONRECEIVE_AW_
If GRID0.Rows > 0 Then
	If g_ArrInput(0) = "0000" Then
		TimeIndex = 2
	Else
		TimeIndex = 1
	End If

	g_ArrInput(1) = GRID0.GetGridCell(1, TimeIndex)
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(DATE)
_AW_ONCHANGE_AW_
SCREEN.Object("obj.12901").data = S12901.Data
obj.Send
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


