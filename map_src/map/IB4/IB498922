Sub Set_option(data)
	If data = "1" Then
		If fund_DtlCode.Data = "74" Or fund_DtlCode.Data = "75" Then
			nyear.Visible = False
			nyear.Data = ""
			PANEL6.Visible = False
			LABEL1.Visible = False
			nday.Enable = False
			gprc.Enable = False
			gprc.Data = ""

			PANEL8.Visible = False
			pprc.Visible = False
			won.Visible = False
			limit.Visible = False
			LmtRmndAmt.Visible = False
		Else
			PANEL6.Visible = False
			nyear.Visible = False
			nyear.Data = ""
			LABEL1.Visible = False
			LABEL13.Visible = False
			gprc.Data = ""
		End If
	Else
		If fund_DtlCode.Data = "74" Or fund_DtlCode.Data = "75" Then
			R1.Enable = True
			R2.Enable = True
			Set_long()

			If R1.Checked = True Then
				nprc.Data = ""
				nprc.Visible = True
				pprc.Visible = False
				gprc.Data = "999999999999"
			Else
				pprc.Data = ""
				pprc.Visible = True
				nprc.Visible = False
			End If
		Else
			nyear.Visible = True
			nyear.data = "12"
			PANEL6.Visible = True
			LABEL1.Visible = True
			LABEL13.Visible = False
			nday.Enable = True
			gprc.Enable = False
			gprc.Data = "999999999999"
		End If
	End If
End Sub

Sub Set_long()
	nyear.Visible = True
	PANEL6.Visible = True
	LABEL1.Visible = False
	LABEL13.Visible = True
	nday.Enable = True
	gprc.Enable = False
	JY1.Enable = False

	PANEL8.Visible = True
	pprc.Visible = True
	won.Visible = True
	limit.Visible = True
	LmtRmndAmt.Visible = True

	JB2.Checked = True
	fund_Dtl.Data = "일반형"
	fund_DtlCode.Data = "61"
	zTaxchrPtnCode.Data "01"
	nyear.Data = "12"
End Sub


Sub Set_account()
	ACNM.Data = AN50.name
	ed_pswd.Data = AN50.Password
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus
	End If
End Sub

Sub FOrder()
	Dim Omsg, tt, nyr
	Dim jnam, gb, prc
	tt = Date

	lCvntTermMthQty.Data = nyear.Data
	If Len(Trim(AN50.Data)) <= 0 Then
		MsgBox "계좌 번호를 입력해주세요"
		AN50.SetFocus
		Exit Sub
	End If

	If Len(Trim(ed_pswd.Data)) <= 0 Then
		MsgBox "비밀번호를 입력해주세요"
		ed_pswd.SetFocus
		Exit Sub
	End If

	If JY1.Checked = True Then
		jnam = "임의식"
		prc = ""
	Else
		jnam = "자유적립식"
		prc = " "
		If fund_DtlCode.Data = "74" Or fund_DtlCode.Data = "75" Then
			prc = Trim(CDbl(pprc.Data))
			If CLng(nyear.Data) < 36 Then
				MsgBox "저축기간은 36개월 이상이어야 합니다."
				nyear.SetFocus
				Exit Sub
			End If
		Else
			prc = Trim(CDbl(nprc.Data))
			If CLng(nyear.Data) < 12 Then
				MsgBox "저축기간은 12개월 이상이어야 합니다."
				nyear.SetFocus
				Exit Sub
			End If
		End If
	End If

	If fund_DtlCode.Data = "74" Or fund_DtlCode.Data = "75" Then
		If JB2.Checked = True Then
			If CDbl(pprc.Data) < 10000 Then
				MsgBox "최저가입금액은 10,000원 입니다."
				pprc.SetFocus
				Exit Sub
			End If
		End If

		If R2.Checked = True Then
			Dim prc1, prc2
			prc1 = Trim(pprc.Data)
			prc2 = Trim(LmtRmndAmt.Data)

			If CDbl(prc1) > CDbl(prc2) Then
				MsgBox "한도금액을 초과했습니다."
				pprc.SetFocus
				Exit Sub
			End If
		End If
	End If


	Omsg = "f1" & vbTab & f_name.Data  & vbLf &_
	"f2" & vbTab & f_tran.Data & vbLf &_
	"f3" & vbTab & tt & vbLf &_
	"f4" & vbTab & jnam  & vbLf &_
	"f5" & vbTab & prc & vbLf &_
	"f7" & vbTab & Trim(nyear.Data) & vbLf &_
	"f9" & vbTab & nday.Data

	SCREEN.CreateWindow 2, "IB498923 /p5 /d", Omsg

	If SYSTEM.Pop("fund_order") <> "OK" Then
		Exit Sub
	End If

	FD_OBJ.Send
End Sub

Sub Set_OrPrc()

	zHirnkAcntNo.Data = AN50.Data
	zAcntPwd.Data = ed_pswd.Data
	zIvstfndCode.Data = f_num.Data
	If JY1.Checked = True Then
		zPayMthdCode.Data = "01"
	Else
		zPayMthdCode.Data = "04"
	End If

'	If nyear.Enable = True Then
'		lCvntTermMthQty.Data = nyear.Data
'	Else
'		lCvntTermMthQty.Data = "00"
'	End If

	If nday.Enable = True Then
		zMthPayDt.Data = nday.Data
	Else
		zMthPayDt.Data = "00"
	End If

	lPayUnitAmt.Data = gprc.Data
End Sub

Sub chk_acctPwd()
	' -- TR 보내기전 입력 필드 확인

	If CheckInput(AN50, ed_pswd) = True Then
		Set_OrPrc()
		FOrder()
	Else
		SCREEN.ClearAll 2, 2
		ACNM.Data = AN50.Name
		ed_pswd.SetFocus
		Exit Sub
	End If
End Sub

