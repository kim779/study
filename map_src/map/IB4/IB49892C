RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim read_f

Sub combosetting(data)
	sub_account.Clear
	'콤보박스의 SetItems는 반드시 제일 처음에 선택하는 데이터를 넣어줘야함.
	sub_account.SetItems(data)
End Sub

'== 계좌명, 비밀번호 설정
Sub Set_account()
	ACNM.Data = AN55.Name
	zPwd.Data = AN55.Password
	If Trim(AN55.Data) = "" Then
		AN55.SetFocus
		Exit Sub
	End If
	If read_f = 1 Then
		If Trim(zIvstfndCode.Data) <> "" Then
			sub_account.SetItems("")
			memsub.Data = ""
			OBJECT0.Proc "send_f", ""
		End If
	Else
		read_f = 1
	End If
	If Trim(zPwd.Data) = "" Then
		zPwd.SetFocus
		Exit Sub
	End If
	SCREEN.Send 0
End Sub

Sub Sub_send()
	OBJECT0.Proc "send_f", ""
End Sub

Sub Set_memsub()
	If Trim(memsub.Data) <> "" Then
		sub_account.Data = l_zeropad(memsub)
	End If
End Sub

Sub acct_set()
	Call Set_account()
End Sub

Sub SetComboBox(items, names)

	zBkeepOppAcntNoCM.Clear
	zBkeepOppAcntNoCM.SetItems(items)
	zBkeepOppAcntNmCM.Clear
	zBkeepOppAcntNmCM.SetItems(names)
	zBkeepOppAcntNm.Data = zBkeepOppAcntNmCM.Data

End Sub



