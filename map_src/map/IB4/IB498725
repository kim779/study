_AW_ONDECLARE_AW_
Dim array
Sub SendMsg(msg)
	If SCREEN.Object("OBJECT0.Scrkey").data = "Y" Then
		array = Split(msg, " ")
		If array(0) = "3206" Then
			msg = "0198 " & array(1) & " 등록이 완료되었습니다."
		End If
		GUIDE.Text = msg
	End If
End Sub

Sub b_send_enable()
	SCREEN.Proc "OBJECT1.inform_popup2", ""
End Sub

Sub CloseWindow()
	SCREEN.CloseWindow
End Sub

Sub changeStep(argStep)

	If SCREEN.Object("main.OBJECT1.RISKYN").Data <> "Y" Then '숙려대상자가 아니면 STEP4 진입시 STEP5,6을 보여준다
		If Int(Left(argStep,1)) = 4 Then
			For i = 1 To 6
				SCREEN.Object("l_STEP"&i).Visible = True
				SCREEN.Object("LABEL"&i).Visible = True
			Next

		End If
	End If

	Dim i
	For i = 1 To 6
		If Int(Left(argStep,1)) = i Then
			SCREEN.Object("l_STEP"&i).PRgb = "66"
		Else
			SCREEN.Object("l_STEP"&i).PRgb = "68"
		End If
	Next

	Select Case argStep
	Case "2" :
		Step2()
	Case "3" :
		Step3()
	Case "4" :
		Step4()
	Case "5" :
		Step5()
	Case "51" :
		Step51()
	Case "6" :
		Step6()
	Case "61" :
		Step61()
	End Select
End Sub

Sub Step1()
	SCREEN.Object("OBJECT2.stepnm").text = "STEP1. 가입상품안내"
	OBJECT3.SetObject("IB498741")

	SCREEN.Object("OBJECT2.f_name").data = Trim(f_name.Data)
	SCREEN.Object("OBJECT2.f_tran").data = Trim(f_tran.Data)
	SCREEN.Object("OBJECT2.domino").data = Trim(domino.Data)

		Select Case Trim(domino.Data)
		Case "매우낮은위험" :
			SCREEN.Object("OBJECT2.domino").TRgb = "39853824"
			SCREEN.Object("OBJECT2.domino").data = Trim(domino.Data) & "(6등급)"
		Case "낮은위험" :
			SCREEN.Object("OBJECT2.domino").TRgb = "46100224"
			SCREEN.Object("OBJECT2.domino").data = Trim(domino.Data) & "(5등급)"
		Case "보통위험" :
			SCREEN.Object("OBJECT2.domino").TRgb = "38842368"
			SCREEN.Object("OBJECT2.domino").data = Trim(domino.Data) & "(4등급)"
		Case "다소높은위험" :
			SCREEN.Object("OBJECT2.domino").TRgb = "33603839"
			SCREEN.Object("OBJECT2.domino").data = Trim(domino.Data) & "(3등급)"
		Case "높은위험" :
			SCREEN.Object("OBJECT2.domino").TRgb = "33580799"
			SCREEN.Object("OBJECT2.domino").data = Trim(domino.Data) & "(2등급)"
		Case "매우높은위험" :
			SCREEN.Object("OBJECT2.domino").TRgb = "33554687"
			SCREEN.Object("OBJECT2.domino").data = Trim(domino.Data) & "(1등급)"
	End Select

	Dim tujaGrd
	pro_yn.Data = "N"
		Select Case Trim(zGrdNm.Data)
		Case "안정형" :
			SCREEN.Object("OBJECT2.zGrdNm").TRgb = "39853824"
			tujaGrd = "매우낮은위험"
		Case "안정추구형" :
			SCREEN.Object("OBJECT2.zGrdNm").TRgb = "38842368"
			tujaGrd = "보통위험"
		Case "위험중립형" :
			SCREEN.Object("OBJECT2.zGrdNm").TRgb = "33603839"
			tujaGrd = "다소높은위험"
		Case "적극투자형" :
			SCREEN.Object("OBJECT2.zGrdNm").TRgb = "33580799"
			tujaGrd = "높은위험"
		Case "공격투자형" :
			SCREEN.Object("OBJECT2.zGrdNm").TRgb = "33554687"
			tujaGrd = "매우높은위험"
		Case "전문금융투자" :
			SCREEN.Object("OBJECT2.zGrdNm").TRgb = "33554687"
			tujaGrd = "매우높은위험"
			zGrdNm.Data = "전문금융소비자"
			pro_yn.Data = "Y"
	End Select

	If Trim(zGrdNm.Data) = "전문금융소비자" Then
		SCREEN.Object("OBJECT2.desc").Text = Trim(LOGIN.Name) & "고객님은 " & Trim(zGrdNm.Data) & "로, " & tujaGrd & " 이하 등급의 상품이 적합합니다."
	Else
		SCREEN.Object("OBJECT2.desc").Text = Trim(LOGIN.Name) & "고객님의 투자성향은 " & Trim(zGrdNm.Data) & "으로 " & tujaGrd & " 등급의 상품이 적합합니다."
	End If

	If flag.Data = "1" Then
		SCREEN.Object("OBJECT2.riskimg").Text = "box_riskclass_1.bmp"
		SCREEN.Object("OBJECT2.risknm").Text = "부적합"
	Else
		SCREEN.Object("OBJECT2.riskimg").Text = "box_riskclass_4.bmp"
		SCREEN.Object("OBJECT2.risknm").Text = "적합"
	End If

	SCREEN.Object("OBJECT2.zGrdNm").data = Trim(zGrdNm.Data)

End Sub

