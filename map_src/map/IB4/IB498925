_AW_ONDECLARE_AW_
Sub OBJ_EN_Set(gubn)
	Select Case gubn
		Case "1"
			OBJECT1.Enable = True
			SCREEN.Object("OBJECT1.b_send").Enable = False

			If SCREEN.GetMapName(1) = "IB498900" Then
				SCREEN.Proc "OBJECT2.Init_Object", "1"
			End If

			OBJECT2.Enable = False
			OBJECT0.Enable = False
			SCREEN.Object("OBJECT0.f_name").PRgb = "0"
			SCREEN.Object("OBJECT0.f_num").PRgb = "0"

			OBJECT1.Proc "selPrdt", ""
			SCREEN.Object("OBJECT1.ed_pswd").Setfocus
		Case "2"
			OBJECT1.Enable = False
			OBJECT2.Enable = True

			If SCREEN.GetMapName(1) = "IB498900"  Or SCREEN.GetMapName(1) = "IB498925" Then
				SCREEN.Proc "OBJECT2.Init_Object", "2"
				SCREEN.Object("OBJECT2.OBJECT0.zIvstfndCode").Data = f_num.Data
				SCREEN.Object("OBJECT2.OBJECT0.FUNDNAME").Data = f_name.Data
				OBJECT2.Proc "OBJECT0.sub_send", ""
			Else
				SCREEN.Object("OBJECT2.zIvstfndCode").Data = f_num.Data
				SCREEN.Object("OBJECT2.FUNDNAME").Data = f_name.Data
				OBJECT2.Proc "sub_send", ""
			End If

			OBJECT0.Enable = False
		Case "3"
			OBJECT1.Enable = False

			If SCREEN.GetMapName(1) = "IB498900" Then
				SCREEN.Proc "OBJECT2.Init_Object", "1"
			End If

			OBJECT2.Enable = False
			OBJECT0.Enable = False
		Case "4"
			OBJECT1.Enable = False

			If SCREEN.GetMapName(1) = "IB498900" Then
				SCREEN.Proc "OBJECT2.Init_Object", "1"
			End If

			OBJECT2.Enable = False
			OBJECT0.Enable = True
			SCREEN.Proc "OBJECT1.selPrdt", ""
	End Select
End Sub

Sub okClick()
	If SCREEN.Object("OBJECT0.Scrkey").data = "Y" Then
		OBJECT0.Proc "okClick", "0"
	End If
End Sub

Dim array
Sub SendMsg(msg)
	If SCREEN.Object("OBJECT0.Scrkey").data = "Y" Then
		array = Split(msg, " ")
		If array(0) = "3206" Then
			msg = "0198 " & array(1) & " 등록이 완료되었습니다."
		End If
		GUIDE.Text = msg
	End If
End Sub

Sub b_send_enable()
	SCREEN.Proc "OBJECT1.inform_popup2", ""
End Sub

