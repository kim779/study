RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim g_AccVol

g_AccVol = 0
'-----------------------------------------------------------------------
Function Str2Int(Data)
	Str2Int = 0
	AData = Trim(Data)

	If Len(AData) = 0 Then
		Exit Function
	End If
	Str2Int = CLng(AData)
End Function
'-----------------------------------------------------------------------
Function Str2Dbl(Data)
	Str2Dbl = 0
	AData = Trim(Data)
	If Len(AData) = 0 Then
		Exit Function
	End If
	Str2Dbl = CDbl(AData)
End Function
'-----------------------------------------------------------------------
Sub OnAlert()
	SetProcReal
End Sub
'-----------------------------------------------------------------------
Sub SetProcReal()
	AllFlag = False
	If g_AccVol = 0 Then
		AllFlag = True
	End If

	ArrData = Array(0, 0, 0, 0)
	For i = 1 To S104310.Rows
		ArrData(3) = Str2Dbl( S104310.GetGridCell(i, 5) )
		If ArrData(3) = 0 Then
			Exit For
		End If

		If AllFlag Then
			ArrData(0) = Str2Dbl( S104310.GetGridCell(i, 2) )
			ArrData(1) = S104310.GetGridCell(i, 3)
			ArrData(2) = Str2Int( S104310.GetGridCell(i, 4) )

			Data = Join(ArrData, "|")
			SCREEN.Proc "parent.OnRealData", Data
		ElseIf ArrData(3) <= g_AccVol Then
			Exit For
		Else
			ArrData(0) = Str2Dbl( S104310.GetGridCell(i, 2) )
			ArrData(1) = S104310.GetGridCell(i, 3)
			ArrData(2) = Str2Int( S104310.GetGridCell(i, 4) )

			Data = Join(ArrData, "|")
			SCREEN.Proc "parent.OnRealData", Data
		End If
	Next

	g_AccVol = Str2Int( S104310.GetGridCell(1, 5) )
End Sub

