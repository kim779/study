_AW_ONDECLARE_AW_
Sub Set_account()
	SCREEN.ClearAll 2, 2
	GUIDE.Text = ""
	csubb.SetItems ""

	'8729 화면에서 오픈시 ACCN Data Length : 14
	If Len(Trim(ACCN.Data)) = 14 Then
		AN15.data = Left(Trim(ACCN.Data), 11)
		SCREEN.Object("obj_getSubAccn.scnGb").data = "1"
	Else
		If Len(Trim(AN15.Data)) = 11 Then
			ANCM.Data = Trim(AN15.Name)
			zPwd.Data = Trim(AN15.Password)
		Else
			AN15.SetFocus
			Exit Sub
		End If
	End If

	SCREEN.Proc "obj_getSubAccn.send_f", ""

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If
	End If
End Sub

Sub Link_Account()
	csubb.Data = Right(Trim(ACCN.Data), 3)
	ANCM.Data = Trim(AN15.Name)
	zPwd.Data = Trim(AN15.Password)
	ACCN.Clear
End Sub

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	ANCM.Data = Trim(AN15.Name)
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID1.SetDataPosition(2)
	SCREEN.Send 0
End Sub

