_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	ed_accn.Data = SCREEN.Object("main.AN1A").data
	zPwd.Data = SCREEN.Object("main.AN1A").Password

	If SYSTEM.ConnectBy = 1 Then
		If Trim(zPwd.Data) = "" Then
			zPwd.SetFocus
			Exit Sub
		End If
	Else
		zPwd.Data = "9999"
	End If

	SCREEN.ClearAll 0, 2
	next_btn.Enable = False
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub FMNum(row,col,pindex)
	If GRID0.GetGridCell(row,col) <> "" Then
		GRID0.SetGridCell row,col,FormatNumber(GRID0.GetGridCell(row,col)*100,pindex,0,0)
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False
GUIDE.Text = ""

If SYSTEM.ConnectBy = 1 Then
	If CheckInput(SCREEN.Object("main.AN1A"), zPwd) = True Then
		ANCM.Data = h_acnm.Data
		SCREEN.onsend = True
 		'Exit Sub
	End If
Else
	SCREEN.onsend = True
	zPwd.Data = "9999"
	ANCM.Data = h_acnm.Data
	zPwd.SetFocus
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 2, 2
	ANCM.Data = h_acnm.Data
End If

If LEDGER.Next = "Y" Then
	sect = 1
	Call send_c()
Else
	Dim tmp,prc,qty
	For i = 1 To GRID0.Rows
		Call FMNum(i,4,3)

		tmp = GRID0.GetGridCell(i, 9)
		GRID0.SetGridCell i, 9, Trim(tmp)

		prc = GRID0.GetGridCell(i, 5)
		qty = GRID0.GetGridCell(i, 10)
		tmp = Int(prc) * qty / 10000
		GRID0.SetGridCell i, 16, Fix(tmp)
	Next
End If

