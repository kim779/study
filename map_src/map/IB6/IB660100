Sub clear_check()
	SCREEN.Object("obj_account.allCheck").Checked = False
	For ii = 1 To SCREEN.Object("obj_account.GRID").Rows
		If Trim(SCREEN.Object("obj_account.GRID").GetGridCell (ii, 8)) = "" Then
			Exit Sub
		End If
		If SCREEN.Object("obj_account.GRID").GetGridCell(ii, 1) = "1" Then
			SCREEN.Object("obj_account.GRID").SetGridCell ii, 1,"0"
		End If
	Next
	BUTTON1.Enable = False
	BUTTON2.Enable = False
End Sub

