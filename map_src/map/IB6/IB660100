'***************************************************************************
Sub Set_account()
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password
	SCREEN.Object("obj_jumn.ed_accn").Data = Trim(AN1A.Data)
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
		Exit Sub
	End If
	If Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus
		Exit Sub
	End If
	SCREEN.Object("obj_jumn.ed_accn").Data = AN1A.data
	GUIDE.text = ""
End Sub

Sub order_tab_change()
	Select Case tab_order.ID
		Case "1" : obj_jumn.SetObject("IB660130")
'			If tab_account.ID = "4" Then
'				SCREEN.proc "obj_account.clear", ""
'			End If
		Case "2" : obj_jumn.SetObject("IB660140")
			If tab_account.ID = "4" Then
			'	SCREEN.proc "obj_account.clear", ""
				If SCREEN.Object("obj_account.radio0").checked = True Then
					SCREEN.Object("obj_account.panel38").visible = True
				End If
			End If
		Case "3" : obj_jumn.SetObject("IB660150")
		Case "4" : obj_jumn.SetObject("IB660160")
		Case "5" : obj_jumn.SetObject("IB660170")
	End Select
	If tab_order.ID = 3 Or tab_order.ID = 4 Then
		SCREEN.Object("obj_jumn.ed_ogno").SetFocus
	Else
		SCREEN.Object("obj_jumn.smcd").SetFocus
	End If
End Sub

Sub sise_tab_change()
	Select Case tab_sise.ID
		Case "1" : obj_hoga.SetObject("IB660110")
		Case "2" : obj_hoga.SetObject("IB660120")
		Case "3" : obj_hoga.SetObject("IB660111")
		Case "4" : obj_hoga.SetObject("IB660112")
	End Select
	obj_hoga.Send
End Sub

Sub send_sise()
	obj_hoga.ClearAll 0
	obj_hoga.Send
End Sub

'***************************************************************************
' DESC: 호가가격 Setting
'***************************************************************************
Sub Set_Odrjprc(jprc)
	If  tab_order.ID <> 4 And SCREEN.Object("obj_jumn.ed_jprc").Enable = True Then
		SCREEN.Object("obj_jumn.ed_jprc").Data = jprc

		If tab_account.ID = 4 Then
			SCREEN.Object("obj_account.ordprc").data = jprc
		End If
	End If
End Sub

Sub resend()
	If tab_account.ID = 1 Or tab_account.ID = 2 Then
		obj_account.Proc "send_f", ""
	End If
End Sub


Sub passPW()
	Dim cnt,accn2,pswd1,accn,mkgb2,ii,code,jprc,jmsu,jmna,mcsu,jmgb,dyac
	Dim vonm,etc1,txgb,feee,sycg,sysj,dhbd,unit,addr,cdat,etc2,s_data
	SYSTEM.push "bondpush", SCREEN.GetMapName(1)
	cnt = 0
	accn2 = Mid(AN1A.data, 1, 8)
	pswd1 = ed_pswd.Data
	accn = AN1A.data										'계좌번호
	mkgb2 = ""
	If Odrgubn = 1 Then
		For ii = 1 To SCREEN.Object("obj_account.grid").rows
			If SCREEN.Object("obj_account.grid").GetGridCell(ii ,1) = 1 Then
				cnt = cnt + 1
			    code = SCREEN.Object("obj_account.grid").GetGridCell(ii, 8)   		'종목코드
				jprc = SCREEN.Object("obj_account.grid").GetGridCell(ii, 25)			'주문가격(or 정정가격)
				jmsu = SCREEN.Object("obj_account.grid").GetGridCell(ii, 23)			'주문수량
				jmnu = SCREEN.Object("obj_account.grid").GetGridCell(ii, 6)			'주문번호
				jmna = SCREEN.Object("obj_account.grid").GetGridCell(ii, 9)			'종목명
				mcsu = SCREEN.Object("obj_account.grid").GetGridCell(ii, 21)			'미체결량
				jmgb = SCREEN.Object("parent.obj_jumn.ed_jmgb").data
				dyac = SCREEN.Object("parent.obj_jumn.ed_dyac").data
				vonm = SCREEN.Object("parent.obj_jumn.ed_vonm").data
				etc1 = jmgb & dyac & vonm		'기타입력1

				txgb = SCREEN.Object("parent.obj_jumn.ed_txgb").data
				'feee = SCREEN.Object("parent.obj_jumn.ed_feee").data
