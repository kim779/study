RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Dim Mydata

Function data_split()
	Mydata = Split(s_data.data, "#", -1, 1) 								' 레코드 단위로 자르고 있는중..

	For ii = 0 To NREC.data-1
		Mydata(ii) = Split(Mydata(ii), "|", -1, 1)							' 한 레코드를 개체별로 자르는중..

		GRID.SetGridCell NREC.Data - ii, 1,Trim(Mydata(ii)(0))
		GRID.SetGridCell NREC.Data - ii, 2,Trim(Mydata(ii)(1))
		GRID.SetGridCell NREC.Data - ii, 3,Trim(Mydata(ii)(2))
		GRID.SetGridCell NREC.Data - ii, 4,Trim(Mydata(ii)(3))
		GRID.SetGridCell NREC.Data - ii, 5,Trim(Mydata(ii)(4))
		'------------------------------------------------------------------------ 일방향 암호화
		GRID.SetGridCell NREC.Data - ii, 6,"HEAD"
		'------------------------------------------------------------------------
		'GRID.SetGridCell NREC.Data - ii, 6,Trim(Mydata(ii)(5))
		GRID.SetGridCell NREC.Data - ii, 7,Trim(Mydata(ii)(6))
		GRID.SetGridCell NREC.Data - ii, 8,Trim(Mydata(ii)(7))
		GRID.SetGridCell NREC.Data - ii, 9,Trim(Mydata(ii)(8))
		GRID.SetGridCell NREC.Data - ii, 10,1000*Trim(Mydata(ii)(9))
		GRID.SetGridCell NREC.Data - ii, 11,Trim(Mydata(ii)(10))
		GRID.SetGridCell NREC.Data - ii, 12,Trim(Mydata(ii)(11))
		GRID.SetGridCell NREC.Data - ii, 13,Trim(Mydata(ii)(12))
		GRID.SetGridCell NREC.Data - ii, 14,Trim(Mydata(ii)(13))
		GRID.SetGridCell NREC.Data - ii, 15,Trim(Mydata(ii)(14))
		GRID.SetGridCell NREC.Data - ii, 16,Trim(Mydata(ii)(15))
		GRID.SetGridCell NREC.Data - ii, 17,Trim(Mydata(ii)(16))
	Next
End Function

_AW_ONSTART_AW_
L_CNT.Text = CDbl(NREC.Data)

Call data_split()


If SYSTEM.ConnectBy = 0 Then
	If Trim(pswd.Data) = "9999" Then
		pswd.Data = ""
		pswd.SetFocus
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Hsiz = 44
LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(pswd.Data))


If SYSTEM.ConnectBy = 1 Then
    If LOGIN.Cani = 0 Then
        MsgBox "본사직원은 주문이 불가합니다.",,"IBK투자증권"
        SCREEN.OnSend = False
        Exit Sub
    End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If Left(Trim(LEDGER.Ecod), 1) = "0" Then
	B_SEARCH.Enable = False
	LABEL2.Text = "주문전송을 완료하였습니다."
	L_CNT.Text  = ""
End If

GUIDE.text = LEDGER.Emsg			'메시지

_AW_ONENDSUB_AW_
_AW_ONCLOSE_AW_
Dim map
map = SYSTEM.Pop("bondpush")
SYSTEM.Trigger "sendA","", map

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(B_SEARCH)
_AW_ONCLICK_AW_
SCREEN.Send 0
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(BUTTON0)
