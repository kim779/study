If SCREEN.Key = 13 And Len(Trim(pswd.Data)) > 0  Then
	SCREEN.Object("obj_chkPW.IntaccNo").data = Trim(AN1A.Data)
	SCREEN.Object("obj_chkPW.Pwd").data = Trim(pswd.Data)
	SCREEN.Object("obj_chkPW.chk").data = "3" 						'일괄정정 : 2
	obj_chkPW.Send
End If
