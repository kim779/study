Function GetPwd(val)

	'GetPwd = "0423"
	For ii=1 To acgrid.Rows
		acnt = acgrid.GetGridCell(ii,1)
		If acnt = val Then
			GetPwd = acgrid.GetGridCell(ii,3)
			Exit Function
		End If
	Next
	GetPwd = ""
