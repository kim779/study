		If Trim(grid.GetGridCell(ii,3)) = Trim(acc) Then	'계좌
			GetAccEpswd = Trim(grid.GetGridCell(ii,5))		'암호화비번
'			SYSTEM.Trace "GetAccEpswd[" & GetAccEpswd & "]"
			Exit For
		End If
	Next
