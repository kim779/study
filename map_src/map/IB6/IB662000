Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function

