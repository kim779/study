'고객성향이 상품위험 등급보다 큰지 확인
Function IsCusPrfsmallThanPrdRisk(sCus, sPrdRisk) '789
SYSTEM.Trace "[6620] IsCusPrfsmallThanPrdRisk(고객성향과 상품등급 비교)  sCus = " & sCus & " sPrdRisk = " & sPrdRisk

	If sCus = "안정형" Then
		check_char = 60
	ElseIf sCus = "안정추구형" Then
		check_char = 40
	ElseIf sCus = "위험중립형" Then
		check_char = 30
	ElseIf sCus = "적극투자형" Then
		check_char = 20
	ElseIf sCus = "공격투자형" Then
		check_char = 10
	Else
		check_char = 10
	End If

	If sPrdRisk = "매우낮은위험" Then
		check_pdt = 60
	ElseIf sPrdRisk = "낮은위험" Then
		check_pdt = 50
	ElseIf sPrdRisk = "보통위험" Then
		check_pdt = 40
	ElseIf sPrdRisk = "다소높은위험" Then
		check_pdt = 30
	ElseIf sPrdRisk = "높은위험" Then
		check_pdt = 20
	ElseIf sPrdRisk = "매우높은위험" Then
		check_pdt = 10
	End If


SYSTEM.Trace "[6620] IsCusPrfsmallThanPrdRisk(고객성향과 상품등급 비교) check_char = " & check_char & " |  상품 = " & check_pdt

	If check_char = check_pdt Then
		IsCusPrfsmallThanPrdRisk = True
		Exit Function
	End If

	If check_char < check_pdt Then
		IsCusPrfsmallThanPrdRisk = True
		 'IsCusPrfsmallThanPrdRisk = False  'test
		Exit Function
	End If
	IsCusPrfsmallThanPrdRisk = False

End Function


