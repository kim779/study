SYSTEM.Trace "[6620]RegDay = " & RegDay
SYSTEM.Trace "[6620]GetToday() = " & GetToday()

	If GetToday() <> RegDay Then
SYSTEM.Trace "[6620]  등록 날짜가 금일이 아니다  exit Function"
		Exit Function
	End If
SYSTEM.Trace "[6620]  등록 날짜가 금일이다"

	CheckTodayRegist = True
End Function

