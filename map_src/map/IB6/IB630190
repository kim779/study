	If price.Data = 0 Then
		MsgBox "금액을 입력하여 주십시오", ,"IBK투자증권"
		Exit Sub
	End If
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Out_Dps.Data = Dps.Data
out_AbleAmt.Data = AbleAmt.Data
OUT_OrdAbleQty.Data = OrdAbleQty.Data

Dim input_pirce, danga
Dim temp, ii, sum, data

If RADIO1.Checked = True Then
	danga = OrdPrc.Data
	If danga = 0 Then
		MsgBox "매수가격을 확인하여 주십시오", , "IBk투자증권"
		Exit Sub
	End If
	input_price = price.Data

	out_AbleAmt.Data = price.Data
	temp = input_price / danga * 10000

	If Roundex(temp, -3) < 1000 Then
	 	OUT_OrdAbleQty.Data = 0
	Else
		OUT_OrdAbleQty.Data = roundex(temp, -3)
	End If
Else
	data = Trim(OUT_OrdAbleQty.data)
	If IsNumeric(data) = True Then
		If data < 1000 Then
			OUT_OrdAbleQty.Data = 0
		End If
	End If
End If



