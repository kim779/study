	SCREEN.Object("main.Guide").text = "매수가격을 확인해 주세요."
	SCREEN.Object("main.Guide").Trgb = 94
	OrdPrc.Data = 0
	OrdPrc.SetFocus
	Exit Sub
End If

Dim data, data2
ord_prc.Data = OrdPrc.Data
data = str2flt(ord_prc)
ord_prc.Data = data
data2 = l_zeropad(ord_prc)

orderPrice.Data = sign.data & data2


