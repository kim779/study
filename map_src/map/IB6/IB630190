_AW_ONDECLARE_AW_
Sub BnsType
	If SCREEN.Object("main.tab_order").ID = "1" Then
		BnsTp.Data = "1"		' 매도
	ElseIf SCREEN.Object("main.tab_order").ID = "2" Then
		BnsTp.Data = "2"		' 매수
	End If
End Sub

Sub ChgRadio
	If RADIO0.Checked = True Then
		PANEL2.Visible = False
		price.Visible = False
	Else
		PANEL2.Visible = True
		price.Visible = True
	End If
End Sub

Sub clear()
	Out_Dps.Clear
	out_AbleAmt.Clear
	OUT_OrdAbleQty.clear
End Sub

Function RoundEx(dblNumber, lngNumberDigitAfterDecimal)

	Dim dblRoundValue

    dblRoundValue = 0


    RoundEx = Int((dblNumber * 10 ^ lngNumberDigitAfterDecimal) + dblRoundValue) / 10 ^ lngNumberDigitAfterDecimal

End Function

