'***************************************************************************
Function Error_check()

	Const scr_name = "소액채권 매도"
	SCREEN.Object("main.guide").text = ""
	ed_pswd.Data = SCREEN.Object("main.ed_pswd").Data

	Error_check = False
	If Trim(SCREEN.Object("main.AN1A").Data) = "" Then
		MsgBox "계좌번호를 입력하세요", , scr_name
		SCREEN.Object("main.AN1A").SetFocus
		Exit Function
	End If
	If Trim(SCREEN.Object("main.ed_pswd").Data) = "" Then
		MsgBox "비밀번호를 입력하세요", , scr_name
		SCREEN.Object("main.ed_pswd").SetFocus
		Exit Function
	End If
	If Trim(sycd.Data) = "" Then
		MsgBox "종목을 입력하세요", , scr_name
		sycd.SetFocus
		Exit Function
	End If
	If CDbl(ed_jqty.Data) = 0 Then
		MsgBox "수량을 입력하세요", , scr_name
		ed_jqty.SetFocus
		Exit Function
	End If
	If CDbl(ed_jprc.Data) = 0 Then
		MsgBox "단가를 입력하세요", , scr_name
		ed_jprc.SetFocus
		Exit Function
	End If

	Error_check = True
End Function

Sub ChangeCode(gubn)
	If Len(sycd.Data) <> 12 Then
		sycd.Clear
	End If
	cgname.Data = SCREEN.GetName(105, sycd.Data, 2)
	ed_code.Data = sycd.Data
	If SCREEN.Object("main.sycd").Data <> sycd.Data Then
		SCREEN.Object("main.sycd").Data = sycd.Data
		sycd.Trigger "sycd", True
		sycd.Trigger "cgcd", True
		If gubn = "2" Then
			SCREEN.Proc "main.send_sise", "2"
		Else
			SCREEN.Proc "main.send_sise", "1"
		End If
	End If
	SCREEN.Object("main.obj_spin").send
End Sub

