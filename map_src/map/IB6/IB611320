Sub Order()
	Dim msg, hogb, checkgb

	If Len(Trim(SCREEN.Object("parent.AN50").Data)) < 11 Then
		MsgBox "계좌번호를 확인해 주십시오.", , "IBK투자증권"
		SCREEN.Object("parent.AN50").SetFocus
		Exit Sub
	End If

	If Len(Trim(SCREEN.Object("parent.zPwd").Data)) < 4 Then
		MsgBox "비밀번호를 확인해 주십시오.", , "IBK투자증권"
		SCREEN.Object("parent.zPwd").SetFocus
		Exit Sub
	End If

	If SCREEN.Object("obj1.grid0").Rows < 1 Then
		SCREEN.Proc "obj1.send_f", ""
	End If

	If Len(Trim(zAcntNo.data)) <> 14 Then
		MsgBox "주문할 펀드를 오른쪽에서 선택해 주십시오.", ,"IBK 투자증권"
		Exit Sub
	End If

	If Len(Trim(zIvstfndCode.data)) <> 8 Then
		MsgBox "주문할 펀드를 오른쪽에서 선택해 주십시오.", ,"IBK 투자증권"
		Exit Sub
	End If

	Select Case Trim(zRpPrslPtnTp.Data)
		Case "1" :
					hogb = "금액"
					checkgb = "금액"
		Case "2" :
					hogb = "좌수"
					checkgb = "좌수"
		Case "3" :
					hogb = "전액"
					checkgb = "금액"
		Case "4" :
					hogb = "이자일부"
					checkgb = "금액"
		Case "5" :
					hogb = "이자전액"
					checkgb = "금액"
	End Select

	If zRpPrslPtnTp.Data <> "3" Then
		If Trim(lBuyOrdAmt.data) = "000000000000000" Then
			MsgBox "매도신청" & checkgb & "을 확인해 주십시오.", ,"IBK 투자증권"
			lBuyOrdAmt.SetFocus
			Exit Sub
		End If
	End If

	msg = "o_acno" & vbTab & zAcntNo.data & vbLf &_
		  "o_code" & vbTab & zIvstfndCode.data & vbLf &_
		  "o_hnam" & vbTab & FundName.data & vbLf &_
		  "o_hogb" & vbTab & hogb & vbLf &_
		  "o_jprc" & vbTab & lBuyOrdAmt.data & vbLf

	SCREEN.CreateWindow 2, "IB61132A /p5 /d", msg

	If SYSTEM.Pop("6113fund_mado_order") <> "OK" Then
		SCREEN.OnSend = False
		Exit Sub
	End If

	Call send_o()
End Sub

Sub cls()
	obj0.ClearAll 2
	obj1.ClearAll 2
	zAcntNo.Clear
	zIvstfndCode.Clear
	SCREEN.Object("obj0.ms_tran").data = "9"
	SCREEN.Object("obj0.fd_meta").data = "00"
	SCREEN.Object("obj0.combo1").data = "9"
	SCREEN.Object("obj0.combo2").data = "9"
	SCREEN.Object("obj1.leg").data = "N"
End Sub

Sub send_o()
	LEDGER.Fkey = "5"
	SCREEN.Send 0
End Sub

