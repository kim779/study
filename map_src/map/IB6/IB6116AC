_AW_ONDECLARE_AW_
Sub search_word()
	Dim ii, jj,search, fundnm, seq, num

	jj = 1
	GRID1.Clear

	search = Trim(EDIT1.Data)
	For ii=1 To GRID0.Rows
		fundnm = Trim(GRID0.GetGridCell(ii, 4))
		seq = Trim(GRID0.GetGridCell(ii,2))
		num = Trim(GRID0.GetGridCell(ii,3))

		If InStr(fundnm, search) > 0 Then
			GRID1.InsertRow -1
			GRID1.Setgridcell jj, 2, seq
			GRID1.Setgridcell jj, 3, num
			GRID1.Setgridcell jj, 5, fundnm
			jj = jj+1
		End If
	Next
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'펀드 검색
Sub Find_fund()
	Dim ii, pos
	pos = 0
'	For ii=1 To GRID1.Rows
'		pos = InStr(Trim(GRID1.GetGridCell(ii, 2)), Trim(search_fund.data))
'
'		If pos > 0 Then
'			GRID1.Index = ii - 1
'			GRID1.Setfocus
'			Exit Sub
'		End If
'	Next

	For ii = GRID1.rows To 1 Step -1
		pos = InStr(Trim(GRID1.GetGridCell(ii, 5)), Trim(search_fund.data))
'		SYSTEM.Trace "Pos : " & pos
		If pos = 0 Then
			GRID1.RemoveRow ii-1
		End If
	Next
End Sub

_AW_ONSTART_AW_

LEDGER.Rcnt = "0020"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend = False

searchCode.Data = Trim(SCREEN.Object("parent.fundcode").Data)
zAcntNo.Data = Trim(SCREEN.Object("parent.AN50").Data)

If Len(Trim(zAcntNo.Data)) < 11 Then
	Exit Sub
End If

If Trim(searchCode.Data) = "" Then
	SCREEN.Object("parent.FundName").Text = ""
	Exit Sub
ElseIf Len(Trim(searchCode.Data)) < 8 Then

	MsgBox "펀드코드를 확인하십시오.",0, "IBK투자증권"
	SCREEN.Object("parent.fundcode").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Next = "Y" Then
	send_c()
Else
	If GRID0.Rows < 1 Then
		Exit Sub
	End If

	Dim ii, gridCode

	For ii = 1 To GRID0.Rows
		gridCode = Trim(GRID0.GetGridCell(ii, 3))

		If Trim(gridCode) = Trim(searchCode.Data) Then
			SCREEN.Object("parent.FundName").Text = Trim(GRID0.GetGridCell(ii, 4))
			SCREEN.Object("parent.seqno").data = Trim(GRID0.GetGridCell(ii, 2))
			'SCREEN.Proc "parent.send_f", ""
			Exit Sub
		End If
	Next

	MsgBox "보유하신 펀드가 아닙니다. 펀드코드를 확인하여 주십시오.", 0, "IBK 투자증권"
	SCREEN.Object("parent.fundName").Text = ""
	SCREEN.Object("parent.fundcode").SetFocus
End If

SCREEN.Object("main.guide").text = ""

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Call Find_fund()

