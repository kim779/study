'***************************************************************************
' DESC: 에러체크
'***************************************************************************
Function Error_check()

	Const scr_name = "소매채권 매수"
	SCREEN.Object("main.guide").text = ""
	ed_pswd.Data = SCREEN.Object("main.ed_pswd").Data

	Error_check = False
	If Trim(SCREEN.Object("main.AN1A").Data) = "" Then
		MsgBox "계좌번호를 입력하세요", , scr_name
		SCREEN.Object("main.AN1A").SetFocus
		Exit Function
	End If
	If Trim(SCREEN.Object("main.ed_pswd").Data) = "" Then
		MsgBox "비밀번호를 입력하세요", , scr_name
		SCREEN.Object("main.ed_pswd").SetFocus
		Exit Function
	End If
	If Trim(smcd.Data) = "" Then
		MsgBox "종목을 입력하세요", , scr_name
		smcd.SetFocus
		Exit Function
	End If
	If CDbl(ed_jqty.Data) = 0 Then
		MsgBox "수량을 입력하세요", , scr_name
		ed_jqty.SetFocus
		Exit Function
	End If
	If CDbl(ed_jprc.Data) = 0 Then
		MsgBox "단가를 입력하세요", , scr_name
		ed_jprc.SetFocus
		Exit Function
	End If

	Error_check = True
End Function


Sub ChangeCode()
	Dim name
	name = ""

	If Len(Trim(smcd.Data)) <> 12 Then
		smcd.Clear
	End If

	name = SCREEN.GetName(105, smcd.Data, 0)

	If Trim(name) = "" Then
		cgname.Clear
		smcd.SetFocus
	End If

	cgname.Data = name
	ed_code.Data = Trim(smcd.Data)

	If Trim(SCREEN.Object("main.smcd").Data) <> Trim(smcd.Data) Then
		ed_ogno.Clear
		ed_jqty.Data = 0
		ed_jprc.Data = 0

		SCREEN.Object("main.smcd").Data = Trim(smcd.Data)
		smcd.Trigger "smcd", True
		SCREEN.Proc "main.send_sise", ""
	End If
End Sub

'***************************************************************************
' DESC: 주문후 수량 단가 유지
