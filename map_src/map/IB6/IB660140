Sub QueryOption(when)
	If when = "after" Then
		Dim p1,p2
		If SCREEN.CreateObject("Info") Then
		  	p1 = INFO.PopData("", "bondoption.ini", "jqty", "chk1")
		  	If p1 = "0" Then
		  		ed_jqty.Data = "0"
		  	End If
		  	p2 = INFO.PopData("", "bondoption.ini", "jqty", "chk2")
		  	If p2 = "0" Then
		  		ed_jprc.Data = "0"
		  	End If
	  	End If
'		If OrdCfg.KeepQty = False Then		'-- 수량유지안함
