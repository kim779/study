_AW_ONDECLARE_AW_
Option Explicit

Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj.ClearAll 2

	If Len(Trim(AM99.Data)) = 11 Then
		ACNM.Data = Trim(AM99.Name)
		zPwd.Data = Trim(AM99.Password)

		If SYSTEM.ConnectBy = 1 Then
			If Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If
		End If

		SCREEN.Proc "obj.send_f", ""
	Else
		AM99.SetFocus
		Exit Sub
	End If
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
Call Check_LoginType(zPwd)

zQryDt.Data = change_date("d", -1)

date1.Visible = False
zQryEndDt.Visible = False
zQryEndDt.Skip = True

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AM99)
_AW_ONCHANGE_AW_
Call Set_account()
