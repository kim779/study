_AW_ONDECLARE_AW_
Dim s_btn_masu, s_btn_mado, s_chk_danju, s_group

s_btn_masu = False
s_btn_mado = False
s_chk_danju = False
s_group = ""

Sub order_tab_change()
	Select Case tab_order.ID
		Case "1" : obj_Odr.SetObject("IB650010")
		Case "2" : obj_Odr.SetObject("IB650020")
	End Select
End Sub

'***************************************************************************
' DESC: 호가가격 Setting
'***************************************************************************
Sub Set_Odrjprc(jprc)
	SCREEN.Object("obj_odr.ed_jprc").Data = jprc

	If tab_accn.ID = 3 Then
		SCREEN.Proc "OBJ_accn.SetOdrjprc", jprc
	End If

End Sub

Sub SetAccountToGrid()
	If s_group<>Trim(CB_GROUP.Data) Then
		SCREEN.Proc "OBJ_accn.SetAccount", ""
	End If
End Sub

Sub EndQueryGroup(flag)
	If flag=1 Then
		OBJ_group.Proc "QueryGroupList", "parent.CB_GROUP"
		GetAccounts()
		Call SetAccountToGrid()
	End If
End Sub

Sub OnCheckLimit(limit_yn, ecod, emsg)
	If limit_yn="Y" Then
		msg = "해당 종목(" & Trim(S1301.Data) & ")은 [" & Trim(CB_GROUP.Text) & "]그룹에 매수금지종목으로 등록되어 있습니다."
		msg = msg & vbCrLf & "매매를 원하시면 매수금지종목에서 해제한 후 이용하시기 바랍니다."
		msg = msg & vbCrLf & vbCrLf & "매매제한종목 등록/해지는 [그룹설정]에서 설정하실 수 있습니다."
		MsgBox msg, vbOKOnly, "IBK투자증권"
		Exit Sub
	ElseIf limit_yn="N" Then
		'계좌목록중에 매수금지종목이 있는지 체크
		OBJ_group.Proc "QueryAccountList", CB_GROUP.Data & "," & "parent.GD_ACCNTS"
		For ii = 1 To GD_ACCNTS.rows
			SCREEN.Object("OBJ_limit2.OGRID").SetGridCell ii, 1, GD_ACCNTS.GetGridCell(ii, 1)
		Next

		'SYSTEM.Trace "GD_ACCNTS.rows[" & GD_ACCNTS.rows & "]"

		SCREEN.Proc "OBJ_limit2.QueryLimit",S1301.Data & "," & GD_ACCNTS.rows
	Else
		Call SetOrderGrid_Real()
	End If
End Sub

Sub OnCheckLimit2()
'	For ii = 1 To SCREEN.Object("OBJ_limit2.OGRID").rows
'		SYSTEM.Trace "OGRID[" & SCREEN.Object("OBJ_limit2.OGRID").GetGridCell(ii, 1) & "][" & SCREEN.Object("OBJ_limit2.OGRID").GetGridCell(ii, 2) & "]"
'	Next
	Call SetOrderGrid_Real()
End Sub

Sub GetAllAccounts(cbname)
	Dim grid, item
	item = ""
	Set grid = SCREEN.Object("OBJ_group.grid1")
	For ii=1 To grid.Rows
		acno = Trim(grid.GetGridCell(ii, 3))
		acnm = Trim(grid.GetGridCell(ii, 4))
		If acno="" Then
			Exit For
		End If
		txt = Mid(acno,1,3) & "-" & Mid(acno, 4, 2) & "-" & Mid(acno, 6) & "  " & Split(acnm, "|")(0)
		item = item & acno & txt & vbTab
		If ii=1 Then
			item = Mid(item, 1, 11) & vbTab & item
		End If
	Next
	'MsgBox cbname & vbCrLf & item
	SCREEN.Object(cbname).SetItems item
End Sub

Sub GetAllAccountsToGrid(gridname)
	Dim grid, item
	item = ""
	Set grid = SCREEN.Object("OBJ_group.grid1")
	For ii=1 To grid.Rows
		acno = Trim(grid.GetGridCell(ii, 3))
		acnm = Trim(grid.GetGridCell(ii, 5))
		If acno="" Then
