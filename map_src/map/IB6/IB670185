Function RoundEx(dblNumber, lngNumberDigitAfterDecimal)

	Dim dblRoundValue

    dblRoundValue = 0


    RoundEx = Int((dblNumber * 10 ^ lngNumberDigitAfterDecimal) + dblRoundValue) / 10 ^ lngNumberDigitAfterDecimal

End Function

