RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Sub send_f()
	If Len(Trim(AM99.Data)) < 11 Then
		AM99.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = 1 Then
		If Len(Trim(AcntPwd.Data)) < 4 Then
			AcntPwd.SetFocus
			Exit Sub
		End If
	End If
	SCREEN.ClearAll 0, 2
	ACNM.Data = AM99.Name
	AcntNo1.Data = AM99.data
	INA.Data = "00001"
	QryTp.Data = 0
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_f1()
	QryTp.Data = 1
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
EvalDate.Data = change_date("d", -1)

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
If LEDGER.Ecod = "3669" Then
	SCREEN.ClearAll 1,2
	ACNM.Data = AM99.Name
	AcntPwd.Clear
	AcntPwd.SetFocus
ElseIf Left(Trim(LEDGER.ECod), 1) = "0" Then
	Dim ADD,gubn
	If QryTp.Data = 0 Then
		For ii = 1 To 12
			For i = 1 To GRID2.Rows
				If GRID2.GetGridCell(i,ii) <> "" Then
					If ii > 3 Then
						GRID0.SetGridCell i,ii,CDbl(GRID2.GetGridCell(i,ii))
					Else
						GRID0.SetGridCell i,ii,GRID2.GetGridCell(i,ii)
					End If
				End If
			Next
		Next
		For ii = 4 To 12
			ADD = 0
			For i = 1 To GRID2.Rows
				If GRID2.GetGridCell(i,ii) <> "" Then
					ADD = ADD + CDbl(GRID2.GetGridCell(i, ii))
				End If
			Next
			If ii = 9 Then
				ADD = FormatNumber(ADD/(i-1),2)
			End If
			SCREEN.Object("SUM"&ii).data = ADD
		Next
	Else
		For ii = 6 To 10
			For i = 1 To GRID1.Rows
				If CDbl(GRID1.GetGridCell(i,ii)) <> "" Then
					GRID1.SetGridCell i,ii,CDbl(GRID1.GetGridCell(i,ii))
				End If
			Next
		Next
	End If
	For i = 1 To GRID1.Rows
		If Trim(GRID1.GetGridCell(i,4)) <> "" Then
			gubn = Trim(GRID1.GetGridCell(i,4))
			Select Case gubn
			Case "01"
				GRID1.SetGridCell i,3, "주식"
			Case "02"
				GRID1.SetGridCell i,3, "채권"
			Case "03"
				GRID1.SetGridCell i,3, "수익증권"
			Case "04"
				GRID1.SetGridCell i,3, "CD"
			Case "05"
				GRID1.SetGridCell i,3, "CP"
			Case "06"
				GRID1.SetGridCell i,3, "RP"
			Case "07"
				GRID1.SetGridCell i,3, "선옵"
			Case "08"
				GRID1.SetGridCell i,3, "주식선물"
			Case "09"
				GRID1.SetGridCell i,3, "계탁"
			Case "70"
				GRID1.SetGridCell i,3, "예금"
			Case "72"
				GRID1.SetGridCell i,3, "증금일일예금"
			Case "73"
				GRID1.SetGridCell i,3, "증금기간예금"
			Case "75"
				GRID1.SetGridCell i,3, "콜예금"
			Case "77"
				GRID1.SetGridCell i,3, "특정금전신탁"
			End Select
		End If
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(AM99)
_AW_ONCHANGE_AW_
If Len(Trim(AM99.Data)) < 11 Then
	AM99.SetFocus
