				s_data = mkgb2 & "|" & s_data				'시장구분	2
				s_data = "1" & "|" & s_data					'주문유형	1
				s_data = "1" & "|" & s_data					'CUD
			End If
		Next
		If cnt > 0 Then
			SCREEN.CreateWindow 3, "IB630198 /p5 /d", "s_data" & vbTab & s_data & vbLf & "acct" & vbTab & AN1A.Data & vbLf & "pswd" & vbTab & pswd1 & vbLf _
																 & "NREC" & vbTab & cnt & vbLf & "ACNM" & vbTab & ACNM.Data
			clear_check()
		End If
	Else
		Exit Sub
	End If
End Sub

Sub clear_check()
	SCREEN.Object("obj_account.allCheck").Checked = False
	For ii = 1 To SCREEN.Object("obj_account.GRID").Rows
		If Trim(SCREEN.Object("obj_account.GRID").GetGridCell (ii, 8)) = "" Then
			Exit Sub
		End If
		If SCREEN.Object("obj_account.GRID").GetGridCell(ii, 1) = "1" Then
			SCREEN.Object("obj_account.GRID").SetGridCell ii, 1,"0"
		End If
	Next
	BUTTON1.Enable = False
	BUTTON2.Enable = False
End Sub

