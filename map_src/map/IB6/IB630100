'***************************************************************************
' DESC: 계좌설
'***************************************************************************
Sub Set_account()
	SCREEN.Object("obj_jumn.ed_accn").Data = AN1A.data
	ACNM.Data = AN1A.name
	ed_pswd.Data = AN1A.Password
	If Trim(AN1A.Data) = "" Then
		AN1A.SetFocus
	ElseIf Trim(ed_pswd.Data) = "" Then
		ed_pswd.SetFocus
	Else
		SCREEN.Object("obj_jumn.sycd").SetFocus
	End If

'	SYSTEM.Trace "6301 account ; " & AN1A.name & Trim(ed_pswd.Data)
	GUIDE.text = ""
	If Trim(ed_pswd.Data) <> "" Then
		SCREEN.Proc "obj_account.send_f", ""
		'obj_account.Send
	End If
End Sub

Sub order_tab_change()
	Select Case tab_order.ID
		Case "1" : obj_jumn.SetObject("IB630110")
'			If tab_account.ID = 4 Then
'				SCREEN.proc "obj_account.clear", ""
'			End If
		Case "2" : obj_jumn.SetObject("IB630120")
		If tab_account.ID = 4 Then
			'	SCREEN.proc "obj_account.clear", ""
				If SCREEN.Object("obj_account.radio0").checked = True Then
					SCREEN.Object("obj_account.panel38").visible = True
				End If
		End If
		Case "3" : obj_jumn.SetObject("IB630130")
		Case "4" : obj_jumn.SetObject("IB630140")
		Case "5" : obj_jumn.SetObject("IB630150")
	End Select

	If tab_order.ID = "3" Or tab_order.ID = "4" Then
		SCREEN.Object("obj_jumn.ed_ogno").SetFocus
	Else
		SCREEN.Object("obj_jumn.sycd").SetFocus
	End If
End Sub

Sub send_sise(gubn)
	SCREEN.Object("obj1.obj_sise").ClearAll 0
	SCREEN.Object("obj1.obj_hoga").clearall 0
	SCREEN.Object("obj1.obj_sise").Send
	SCREEN.Object("obj1.obj_hoga").Send
	If gubn = "2" Then
		jgbn.Data = "2"
	Else
		jgbn.Data = "1"
	End If
End Sub

'***************************************************************************
' DESC: 호가가격 Setting
'***************************************************************************
Sub Set_Odrjprc(jprc)

	If  tab_order.ID <> 4 And SCREEN.Object("obj_jumn.ed_jprc").Enable = True Then
		SCREEN.Object("obj_jumn.ed_jprc").Data = jprc
		If tab_account.ID = 4 Then
			SCREEN.Object("obj_account.ordprc").data = jprc
		End If
	End If

End Sub

Sub resend()
	If tab_account.ID = 1 Or tab_account.ID = 2 Then
		SCREEN.SetTimer 5, True
	End If
End Sub

