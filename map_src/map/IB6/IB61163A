Sub Find_fund()
	Dim ii, pos
	pos = 0

	For ii = GRID1.rows To 1 Step -1
		pos = InStr(Trim(GRID1.GetGridCell(ii, 2)), Trim(search_fund.data))

		If pos = 0 Then
			GRID1.RemoveRow ii-1
		End If
	Next
End Sub

