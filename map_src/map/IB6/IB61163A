	For Each aa In objdic.keys
		GRID1.InsertRow -1
		GRID1.Setgridcell GRID1.Rows, 1, Trim(aa)
		GRID1.Setgridcell GRID1.Rows, 2, Trim(objdic.item(aa))
	Next
End Sub

