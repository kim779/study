_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	clearout()
	LastInclnGrdNm.Clear
	zIn.Data = "00001"
	BnsTp.Data = "1"                    '매매구분
	DclsrPrdtCode.Data = "01"           '공시상품코드
	TermTp.Data = "1"                   '기간구분
	BndKindCode.Data = "000"            '채권종류코드
	ZOnlineBnsAbleYn.Data = "1"         '온라인매매가능
	ACNM.Data = AN1A.Name
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub passPW()
	Call send_f()
	OBJECT0.Proc "send_f",""
End Sub

Sub checkpass()
	If Len(Trim(AN1A.Data)) < 11 Then
		AN1A.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		MsgBox "비밀번호를 확인하여 주십시오.", , "IBK투자증권"
		Exit Sub
	End If

	SCREEN.Object("chk_pass.IntaccNo").data = AN1A.data
	SCREEN.Object("chk_pass.Pwd").data = zPwd.data
	chk_pass.Send
End Sub

Sub clearout()
	IsuNo_1.Clear
	IsuNm_1.Clear
	BnsQty_1.Clear
	BnsUprc_1.Clear
	SellErnrat_1.Clear
	InvstrClssNm.Clear
End Sub

