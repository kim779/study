_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim i
If LEDGER.Next = "Y" Then
	Call send_c()
Else
	For i=1 To GRID0.Rows
		If Trim(GRID0.GetGridCell(i,8)) <> "" Then
			GRID0.SetGridCell i	,4, FormatPercent(Trim(GRID0.GetGridCell(i,8)),3)
		End If
		If Trim(GRID0.GetGridCell(i,11)) <> "" Then
			GRID0.SetGridCell i	,9, Trim(GRID0.GetGridCell(i,11))
		End If
	Next
End If

