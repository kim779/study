	Dim mdcg, mscg
	mdcg = Trim(S2118.Data)
	mscg = Trim(S2119.Data)

	If mdcg = "" Then
		mdcg = 0
	End If

	If mscg = "" Then
		mscg = 0
	End If

	TABLE2.SetTableCell 2, CDbl(mdcg) + CDbl(mscg)

End Sub

