'D-2 날짜 구하기
Sub setDate()

	Dim cy_date
	'날짜 컨트롤
	If SCREEN.CreateObject("Info") Then
		cy_date = Trim(INFO.popData (LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "CB_IB693140"))
	End If

	If cy_date <> "" Then
		zAppySrtDt.Data = cy_date
	Else
		Dim cy_d2date
		Dim yy, mm, dd, cday, MyWeek

		cday = DateAdd("d", -2, Date)
		MyWeek = Weekday(cday)
		If MyWeek = 1 Then
			cday= DateAdd("d", -2 , cday)
		ElseIf MyWeek = 7 Then
			cday= DateAdd("d", -1 , cday)
		End If

		yy = Year(cday)
		mm = Month(cday)
		If Len(mm) = 1 Then mm = "0"&mm

		dd = Day(cday)
		If Len(dd) = 1 Then dd = "0"&dd

		cday = yy&mm&dd
		cy_d2date = CDbl(cday)

		zAppySrtDt.Data = cy_d2date
	End If
End Sub

