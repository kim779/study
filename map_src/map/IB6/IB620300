Sub Set_account()
	SCREEN.ClearAll 2, 2
	zOrdDt.Data = getCurrDay()
	i_lRpDays.Clear
	price.Clear

	ACNM.Data = AN51.Name
	zPwd.Data = AN51.Password

	If Len(Trim(AN51.Data)) <> 11 Then
		AN51.SetFocus
		Exit Sub
	End If

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If
End Sub

Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

Sub DoOrder()
	If Error_check() = False Then			'주문전 Error Check
		Exit Sub
	End If

	Dim dmsg, rpGubn

	If RADIO0.Checked = True Then
		rpGubn = "수시"
	ElseIf RADIO1.Checked = True Then
		rpGubn = "일반"
	Else
		rpGubn = "수익자유"
	End If

	dmsg = "o_acno" & vbTab & AN51.Data & vbLf &_
			"o_acnm" & vbTab & ACNM.Data & vbLf &_
			"o_gubn" & vbTab & rpGubn & vbLf &_
			"o_pric" & vbTab & price.data & vbLf

	SCREEN.CreateWindow 2, "IB620302 /p5 /d", dmsg

	If SYSTEM.Pop("rp_mado_order") <> "OK" Then
		Exit Sub
	End If

	SCREEN.Send 0		'주문전송
End Sub

Function Error_check()
	Error_check = False
	If Trim(AN51.Data) = "" Then
		MsgBox "계좌번호를 입력하십시오.", , "IBK투자증권"
		AN51.SetFocus
		Exit Function
	End If


	If Len(Trim(zPwd.Data)) < 4 Then
		MsgBox "비밀번호를 입력하십시오.", , "IBK투자증권"
		zPwd.SetFocus
		Exit Function
	End If


	If CDbl(price.Data) = 0 Then
		MsgBox "매매금액을 확인하십시오.", , "IBK투자증권"
		price.SetFocus
		Exit Function
	End If

	If CDbl(i_lRpDays.Data) = 0 Then
		MsgBox "RP일수를 확인하십시오.", , "IBK투자증권"
		i_lRpDays.SetFocus
		Exit Function
	End If

	Error_check = True
End Function

Sub changeRPGubn()
	Call SetDefault()

	If Len(Trim(zPwd.Data)) < 4 Then
		zPwd.SetFocus
		Exit Sub
	End If

	SCREEN.Proc "OBJ.send_f", ""
End Sub

Sub SetDefault()
	zOrdDt.Data = getCurrDay()
	i_lRpDays.Data = ""
	price.Data = ""

