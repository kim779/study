			workday = Date
			'오늘이 토요일 이거나 일요일 이면 전영업일로 초기화
			If a = 7 Or a = 1 Then
				workday = LOGIN.Day0
			End If
		End If

		nHead  = 1
		nData  = GRID0.rows
		irSize = 14
		drSize = 14
		pday   = workday
		mgap   = "0000"
		xtype  = " "
		xUnit(0)= " "
		xUnit(1)= " "
		xUnit(2)= " "
		tipName = " "
		reserve = " "

		sTot = cp_lpad(nHead,2," ")
		sTot = sTot & cp_lpad(nData ,6 ," ")
		sTot = sTot & cp_lpad(irSize,2 ," ")
		sTot = sTot & cp_lpad(drSize,2 ," ")
		sTot = sTot & cp_rpad(pday  ,8 ," ")
		sTot = sTot & cp_rpad(mgap  ,4 ," ")
		sTot = sTot & xtype
