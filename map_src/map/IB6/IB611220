		sTot = sTot & cp_rpad(rtscode	,12," ")
		sTot = sTot & cp_rpad(symbol,5," ")
		sTot = sTot & rtsSign
		sTot = sTot & cp_rpad(pivot	,14," ")
		sTot = sTot & cp_rpad(reserve2,16," ")

		For idx = 1 To GRID0.Rows 'Step -1  '''val = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 4))
			sTot = sTot & cp_lpad(Replace(Replace(Trim(GRID0.GetGridCell(idx,3)),".",""),",",""),14," ")
		Next

		ctl_C_UserGrp.SetData(sTot)
	End If
