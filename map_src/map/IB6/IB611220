		sTot = sTot & cp_rpad(tipName ,64," ")
		sTot = sTot & cp_rpad(reserve ,32," ")

		Dim idx

		For idx = 1 To GRID0.Rows 'Step -1  '''val = Trim(VIEWGRID.GetGridCell(VIEWGRID.Row, 4))
			sTemp = Trim(GRID0.GetGridCell(idx,1))
			sTot = sTot & cp_rpad(sTemp,14," ")
		Next

