'***************************************************************************
' DESC: 매수단가 상하 셋팅
'***************************************************************************
Sub calc()

	If Len(Trim(ed_lsuNo.Data)) <> 12 Then
	SYSTEM.Trace "[6620][662040] ------------  calc dataclear len = " & Len(Trim(ed_lsuNo.Data))
		Call dataClear()
		Exit Sub
	End If


	If Is_numeric(ed_CdCpErnrat.Data) = False Or ed_CdCpErnrat.Data <= 0 Then
SYSTEM.Trace "[6620][662040] ------------  calc dataclear 할인율 ed_CdCpErnrat = " & ed_CdCpErnrat.Data
		Call dataClear()
		Exit Sub
	End If

	Dim acnt
	acnt = Trim(SCREEN.Object("main.AN1A").Data)

	If acnt = "" Then
		Call dataClear()
		Exit Sub
	End If

	If UnitBnsObjYn.Data = "1" Then '1억단위체크
		Dim dbnum ,ret
		dbnum = CDbl(ed_BnsQty.Data)
		ret = dbnum / 100000000
		If ret <> Int(ret) Then
			MsgBox "1억 단위로만 매수할 수 있는 상품입니다.", , "단기사채 매수"
			ed_BnsQty.Data = ""
			ed_BnsQty.SetFocus
			Exit Sub
		End If
	End If

	buytotal.Data = CDbl(ed_BnsQty.Data - Fix(CDbl(ed_BnsQty.Data * (ed_CdCpErnrat.Data/100) *(ed_RemnDay.Data/365))))

End Sub


