	ed_BnsQty.Data = ""
	buytotal.Data = ""
	ed_CdCpErnrat.Data = ""
	ed_RemnDay.Data = ""
	cgname.Data = ""
	ed_lsuNo.Data = ""
	jmbtclick.Data = 0
	changecode()
