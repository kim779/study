Function Error_check()

	Const scr_name = "단기사채 매수"
	SCREEN.Object("main.guide").text = ""
	ed_pswd.Data = SCREEN.Object("main.ed_pswd").Data

	Error_check = False
	If Trim(SCREEN.Object("main.AN1A").Data) = "" Then
		MsgBox "계좌번호를 입력하세요", , scr_name
		SCREEN.Object("main.AN1A").SetFocus
		Exit Function
	End If
	If Trim(SCREEN.Object("main.ed_pswd").Data) = "" Then
		MsgBox "비밀번호를 입력하세요", , scr_name
		SCREEN.Object("main.ed_pswd").SetFocus
		Exit Function
	End If
	If Trim(ed_lsuNo.Data) = "" Then
		MsgBox "종목을 입력하세요", , scr_name
		ed_lsuNo.SetFocus
		Exit Function
	End If
	If CDbl(ed_BnsQty.Data) = 0 Then
		MsgBox "수량을 입력하세요", , scr_name
		ed_BnsQty.SetFocus
		Exit Function
	End If

	If CDbl(ed_BnsQty.Data) < 100000000 Then
		MsgBox "단기사채 매수 가능한 최소수량은 1억원입니다. 확인 후 다시 입력해 주세요.", , scr_name
		ed_BnsQty.SetFocus
		Exit Function
	End If


	Dim i
	For i =1 To 4
		If SCREEN.Object("chk"&i).checked = False Then
			Select Case i
				Case "1" : MsgBox "주요내용 고객확인을 확인해주세요.", , scr_name
				Case "2" : MsgBox "핵심상품설명서를 확인해주세요.", , scr_name
				Case "3" : MsgBox "신용평가서1를 확인해주세요.", , scr_name
				Case "4" : MsgBox "신용평가서2를 확인해주세요.", , scr_name
			End Select

			SCREEN.Object("chk"&i).SetFocus
			Exit Function

		End If
	Next
	Error_check = True
End Function

