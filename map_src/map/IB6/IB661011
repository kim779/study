_AW_ONDECLARE_AW_
'== 첫 조회
Sub send_f()
	GRID.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
	SCREEN.Object("main.GUIDE").text = "조회내역이 없습니다."

End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID.SetDataPosition(2)
	SCREEN.Send 0
End Sub

Sub FMNum(row,col,pindex)
	If GRID.GetGridCell(row,col) <> "" Then
		GRID.SetGridCell row,col,FormatNumber(Int(GRID.GetGridCell(row,col)*10^pindex)/10^pindex,pindex)
	End If
End Sub

Sub Setcelldata(row, data1, data2, data3, data4, data5, data6)
	'MsgBox row &":"& data1&":"& data2&":"& data3&":"& data4&":"& data5&":"& data6
	GRID.SetGridCell row,1,data1
	GRID.SetGridCell row,2,data2
	GRID.SetGridCell row,3,data3
	GRID.SetGridCell row,4,data4
	GRID.SetGridCell row,5,data5
	GRID.SetGridCell row,6,data6
	GRID.InsertRow row
End Sub

