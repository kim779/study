	d3GrpAppyMgnrt.Data = CDbl(d3GrpAppyMgnrt.Data) * 100
	viewD3GrpAppyMgnrt.Data = FormatNumber(d3GrpAppyMgnrt.Data, 0, 0, 0, 0) & "%"
End If
