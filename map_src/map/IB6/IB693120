			GRID0.Clear
			GRID1.Clear
			next_btn.Enable False
			gridPos.Data = 1
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, cnt
cnt = 1
'SYSTEM.Trace "10"

If GRID1.Rows > 0 Then
	If Trim(lAppyQty.Data) = "000000000000000" Then
		For ii = gridPos.Data To GRID1.Rows
			GRID0.InsertRow -1
			GRID0.SetGridCell ii, 1, Trim(GRID1.GetGridCell(ii, 1))
			GRID0.SetGridCell ii, 2, Trim(GRID1.GetGridCell(ii, 2))
		Next

		gridPos.Data = GRID1.Rows + 1
	Else
		If IsNumeric(lAppyQty.Data) = True Then
			If CDbl(lAppyQty.Data) >= CDbl(GRID1.GetGridCell(GRID1.Rows, 1)) Then
				If LEDGER.Next = "Y" Then
					GRID1.Clear
					gridPos.Data = 1
					Call send_c()
					Exit Sub
				End If
			End If


			For ii = gridPos.Data To GRID1.Rows
				If Trim(GRID1.GetGridCell(ii, 1)) = "" Then
					Exit For
				End If

				If CDbl(lAppyQty.Data) > CDbl(Trim(GRID1.GetGridCell(ii, 1))) Then
					GRID1.RemoveRow ii - 1
					ii = ii - 1
				Else
					Exit For
				End If
			Next

			If GRID1.Rows < 100 Then
				If LEDGER.Next = "Y" Then
					Call send_c()
					Exit Sub
				End If
			End If

			For ii = gridPos.Data To GRID1.Rows
				GRID0.InsertRow -1
				GRID0.SetGridCell ii, 1, Trim(GRID1.GetGridCell(ii, 1))
				GRID0.SetGridCell ii, 2, Trim(GRID1.GetGridCell(ii, 2))
			Next

			gridPos.Data = GRID1.Rows + 1
		End If
	End If
End If
'SYSTEM.Trace "693120-a"
If LEDGER.Next = "Y" Then
	next_btn.Enable = True
	next_btn.SetFocus
Else
	next_btn.Enable = False
End If
