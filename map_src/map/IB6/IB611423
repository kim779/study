Sub Set_account()
	ACNM.Data = Trim(AN55.Name)
	ed_pswd.Data = Trim(AN55.Password)

	If Len(Trim(ed_pswd.Data)) < 4 Then
		ed_pswd.SetFocus
	End If
End Sub


Sub FOrder()
	Dim Omsg, tt, nyr
	Dim jnam, gb, prc
	tt = Date

  If Len(Trim(AN55.Data)) <> 11 Then
		Call alert_msg("계좌번호를 확인하여 주십시오.")
		AN55.SetFocus
		Exit Sub
	End If

	If Len(Trim(ed_pswd.Data)) < 4 Then
		Call alert_msg("비밀번호를 확인하여 주십시오.")
		ed_pswd.SetFocus
		Exit Sub
	End If

	If Fund_Reserve_prc.Visible Then
		If CLng(Fund_Reserve_prc.Data) < 2 Then
			Call alert_msg("가입금액을 입력해 주십시오.")
			Fund_Reserve_prc.SetFocus
			Exit Sub
		End If
	End If

	jnam = "자유적립식"

	If R1.Checked = True Then
		Omsg = "f1" & vbTab & f_name.Data  & vbLf &_
		   "f2" & vbTab & f_tran.Data & vbLf &_
		   "f3" & vbTab & tt & vbLf &_
		   "f4" & vbTab & jnam  & vbLf &_
		   "f5" & vbTab & prc & vbLf &_
		   "f7" & vbTab & Trim(nyear.Data) & vbLf &_
		   "f9" & vbTab & nday.Data
	Else
		Omsg = "f1" & vbTab & f_name.Data  & vbLf &_
		   "f2" & vbTab & f_tran.Data & vbLf &_
		   "f3" & vbTab & tt & vbLf &_
		   "f4" & vbTab & jnam  & vbLf &_
		   "f5" & vbTab & prc & vbLf &_
		   '"f7" & vbTab & Trim(nyear.Data) & vbLf &_
		   "f9" & vbTab & nday.Data
	End If
	SCREEN.CreateWindow 2, "IB498923 /p5 /d", Omsg

	If SYSTEM.Pop("fund_order") <> "OK" Then
		Exit Sub
	End If

	Call Set_OrPrc()
End Sub

Sub Set_OrPrc()
	zHirnkAcntNo.Data = Trim(AN55.Data)			'상위계좌번호
	zAcntPwd.Data = Trim(ed_pswd.Data)			'계좌비밀번호
	zIvstfndCode.Data = Trim(f_num.Data)		'펀드코드

	If JY1.Checked = True Then					'납입방법
		zPayMthdCode.Data = "01"					'임의식
	Else
		zPayMthdCode.Data = "04"				'자유적립식
	End If

'	If Trim(nyear.Data) <> "" Then				'계약기간월수
'		lCvntTermMthQty.Data = nyear.Data
'	Else

'	End If

	zMthPayDt.Data = "00"						'월납입일




	zTaxchrPtnCode.Data = "01"				'과세유형코드 - 일반과세

	If R2.Checked = True Then					'분리과세형
		zSprtaxYn.Data = "1"					'분리과세여부 - 종합과세
		zClrgTrxTp.Data = "2"				 	'현금배당
		lCvntTermMthQty.Data = "00036"			'계약기간월수
		lPayUnitAmt.Data = pprc.Data			'납입단위금액
	Else
		zSprtaxYn.Data = "0"					'분리과세여부
		zClrgTrxTp.Data = "1"					'재투자
		'lCvntTermMthQty.Data = "00000"			'계약기간월수
		lCvntTermMthQty.Data = nyear.Data
		lPayUnitAmt.Data = "000000999999999"
	End If

	zAnutyGivTermVal.Data = ""				'연금지급구분
	lAnutygivTermVal.Data = "00000"			'연금지급기간
	zAnutyGivSrtDt.Data = ""				'연금지급시작일 - 당일자입력. 코스콤에서 알아서 처리함.
	zAnutyGivCyclTp.Data = ""				'연금지급주기구분


	'체크리스트 등록
	SCREEN.Proc "obj_checkList.send_f", ""
End Sub

Sub chk_acctPwd()
	' -- TR 보내기전 입력 필드 확인
	Dim MSG1, MSG2, msg, prc

	If Len(Trim(zLmtRmndAmt.Data)) <= 0 Then
		MsgBox "납인한도를 조회하여 주시기 바랍니다.", ,"IBK 투자증권"
		limit.SetFocus
		Exit Sub
	End If

	If Len(Trim(pprc.Data)) <= 0 Then
		MsgBox "납입총금액을 확인하여 주시기 바랍니다.", ,"IBK 투자증권"
		pprc.SetFocus
		Exit Sub
	Else
		prc = CLng(pprc.Data)
	End If


	If prc > 50000000 Then
		MsgBox "공무부동산 펀드 분리과세 세금후대 총 한도는 1인당 5천만원입니다.", ,"IBK 투자증권"
		pprc.SetFocus
		Exit Sub
	End If

	MSG1="가입가능한 분리과세 한도금액을 초과하였습니다."
	MSG2="납입한도 금액 이내로 입력하시기 바랍니다."
	msg=MSG1 + vbCrLf + MSG2

	If prc > CLng(zLmtRmndAmt.Data) Then
		MsgBox msg, ,"IBK 투자증권"
		pprc.SetFocus
		Exit Sub
	End If

	Call FOrder()
'	Else
'		SCREEN.ClearAll 0, 2
'		pprc.Clear
'		ACNM.Data = AN55.Name
'		ed_pswd.SetFocus
'		Exit Sub
'	End If
End Sub

Sub checkPassword()
	Dim tmpAcct, tmpPwd
	tmpAcct = Trim(AN55.Data)
	tmpPwd = Trim(ed_pswd.Data)

	SCREEN.Object("chk_passwd.IntaccNo").data = tmpAcct
	SCREEN.Object("chk_passwd.Pwd").data = tmpPwd

	chk_passwd.Send
End Sub

