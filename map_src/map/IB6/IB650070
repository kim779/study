Sub EndQueryGroup(Mode)
	If Mode = 1 Then
		SCREEN.Proc "OBJ_GRP.StrQueryGroupList", "COMBO0"
		SCREEN.Proc "OBJ_GRP.StrQueryAcntList", COMBO0.Data&",2,acgrid,cmb_acnt"
	Else
		Call Send_f("")
	End If
End Sub

Sub Send_f(acnt)
	'SCREEN.ClearAll 0, 2

	If Len(acnt) = 0 Then
		GRID1.Clear
		Call SetAcntList()
