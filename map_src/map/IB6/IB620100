_AW_ONDECLARE_AW_
Dim tmpcc, tmp, odat

Function inpot(data, plen)
	Dim tlen, fdat, bdat

	tlen = Len(data)

	fdat = Left(data, tlen - plen)
	bdat = Right(data, plen)

	inpot = fdat & "." & bdat
End Function

Sub send_f()
	SCREEN.clearall 2, 2
	LEDGER.Fkey = "C"

	lBnsAmt.Data = "+" & l_zeropad(aa)
	lRpDays.Data = "+" & l_zeropad(bb)

	'dat.Data = CLng(cc.Data) / 100
	dat.Data = CDbl (cc.Data) / 100
	dRpIntrat.Data = inpot(dat.data, 8)

	If CDbl(bb.Data ) = 0 Then
		Call alert_msg("조건기간을 입력하십시오.")
		bb.SetFocus
		Exit Sub
	End If

	If CDbl(aa.Data) = 0 Then
		Call alert_msg("매매금액을 입력하십시오.")
		aa.SetFocus
		Exit Sub
	End If

	If CDbl(cc.Data) = 0 Then
		Call alert_msg("조건이율을 입력하십시오.")
		cc.SetFocus
		Exit Sub
	End If

	SCREEN.Send 0
End Sub

