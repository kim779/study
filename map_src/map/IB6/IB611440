		Exit Sub
	End If

	If Len(Trim(AN50.Data)) <> 11 Then
		MsgBox "펀드계좌번호(ex.001-53-123456)를 확인하여 주십시오.", , "IBK투자증권"
		Exit Sub
	End If

	Dim url, dmsg
	If LOGIN.Ctyp = "0" Then
	'	MsgBox "투자자 정보 확인서 등록을 하셔야합니다.",,"IBK투자증권"
		SCREEN.CreateWindow 2, "IB820982 /t/s/p5", ""
		SCREEN.CreateWindow 1, "IB821200 /t/s/p5", ""
		Exit Sub
	End If

	dmsg = "f_name" 	  & vbTab & Trim(GRID1.GetGridCell(GRID1.row, 4)) & vbLf &_
		   "f_num" 		  & vbTab & Trim(GRID1.GetGridCell(GRID1.row, 2)) & vbLf &_
		   "f_tran" 	  & vbTab & Trim(GRID1.GetGridCell(GRID1.row, 41)) & vbLf &_
