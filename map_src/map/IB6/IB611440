Sub ecl()
	GRID1.Excel True, True, ""
End Sub

Sub attach()
	Dim ii, tmp

	For ii = 1 To SCREEN.Object("main.GRID0").Rows
		GRID1.InsertRow -1
		GRID1.SetGridCell ii,  1, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 1))
		GRID1.SetGridCell ii,  2, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 2))
		GRID1.SetGridCell ii,  3, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 38))
		GRID1.SetGridCell ii,  4, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 3))
		GRID1.SetGridCell ii,  5, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 4))
		GRID1.SetGridCell ii,  6, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 5))
		GRID1.SetGridCell ii, 25, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 24))
		GRID1.SetGridCell ii, 26, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 25))
		GRID1.SetGridCell ii, 27, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 26))
		GRID1.SetGridCell ii, 32, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 31))
		GRID1.SetGridCell ii, 34, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 33))
		GRID1.SetGridCell ii, 35, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 34))
		GRID1.SetGridCell ii, 40, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 39))
		GRID1.SetGridCell ii, 41, Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 40))

		tmp = Trim(SCREEN.Object("main.GRID0").GetGridCell(ii, 32))

		If Len(tmp) <> 0 Then
			tmp = Mid(tmp, 1, Len(tmp) -1)

			If tmp*1 = 0 Then
				GRID1.SetGridCell ii, 33, 0
			Else
				GRID1.SetGridCell ii, 33, tmp
			End If
		End If
	Next
End Sub

