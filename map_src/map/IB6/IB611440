If GRID1.HitPos = 3 And GRID1.Column = 1 Then
	If Trim(GRID1.GetGridCell(GRID1.Row, 2)) = "" Then
		Exit Sub
	End If

	If AN50.OnlySise = "1" Then	'조회/준회원용 로그인
