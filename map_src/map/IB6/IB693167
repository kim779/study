_AW_ONINDECLARE_AW_
#LOAD IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
obj_serverCheck.Send
'SYSTEM.Trace "zAppyIsuNo = " & zAppyIsuNo.Data

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
zRmnno.Data = LOGIN.Juno
zDlvrDt.Data = getCurrDay()
zDownTime.Data = FormatDateTime(Now, 3)

If Len(Trim(zAppyIsuNo.Data)) = 6 Then
	zAppyIsuNo.Data = "A"&Trim(zAppyIsuNo.Data)
End If

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
'SCREEN.Object("main.GUIDE.GUIDE").Text = LEDGER.Emsg
If Left(LEDGER.Ecod,1) <> "0" Then
	MsgBox Trim(LEDGER.Emsg),,"IBK투자증권"
Else

End If

_AW_ONENDSUB_AW_
_AW_ONTIMER_AW_
Dim code, staff
c_down.protocol = "HTTP"


code = Trim(zAppyIsuNo.Data)

If Len(code) < 3 Then
	MsgBox "종목코드를 확인하시기 바랍니다.",,"IBK투자증권"
	Exit Sub
End If

If SCREEN.CreateObject("Info") Then
		staff = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", "IB0000AX", "staff"))
	End If

If staff = "X" Then
	c_down.address = "http://download.ibks.com/subscribe/"
Else
	c_down.address = "http://www.ibks.com/files/subscribe/"
End If

'code = Mid(code,2,Len(code)-1)
c_down.filename = Trim(zAppySrtDt.Data)&"_"& code & "_1.pdf"

'c_down.filename = "20160928_KR6722302058_1.pdf"

If Trim(SCREEN.Object("obj_serverCheck.output1").data) = "1" Then
	c_down.DoDownload
Else
	alert_msg(Trim(SCREEN.Object("obj_serverCheck.output2").data))
	SCREEN.CloseWindow
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(c_down)
_AW_ONDBLCLK_AW_
If Trim(regYn.Data) = "N" Then

	Dim succ

	If c_down.IsDownload() = "1" Then '다운로드 성공시
		succ = "OK"
'		SYSTEM.Trace "succ"
		If cnt.Data = "4" Then
			SCREEN.Send 0
		End If
	End If

	SYSTEM.Push "Dn_SuccessT", succ
Else
	SYSTEM.Push "Dn_SuccessT", "OK"
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(btnClose)
_AW_ONCLICK_AW_
SCREEN.CloseWindow
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


