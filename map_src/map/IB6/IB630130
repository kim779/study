'***************************************************************************
' DESC: 에러체크
'***************************************************************************
Function Error_check()

	Const scr_name = "소액채권 정정"
	SCREEN.Object("main.guide").text = ""
	ed_pswd.Data = SCREEN.Object("main.ed_pswd").Data

	Error_check = False
	If Trim(SCREEN.Object("main.AN1A").Data) = "" Then
		MsgBox "계좌번호를 입력하세요", , scr_name
		SCREEN.Object("main.AN1A").SetFocus
		Exit Function
	End If
	If Trim(SCREEN.Object("main.ed_pswd").Data) = "" Then
		MsgBox "비밀번호를 입력하세요", , scr_name
		SCREEN.Object("main.ed_pswd").SetFocus
		Exit Function
	End If
	If Trim(sycd.Data) = "" Then
		MsgBox "종목을 입력하세요", , scr_name
		sycd.SetFocus
		Exit Function
	End If
	If ed_jqty.Enable = True Then
		If CDbl(ed_jqty.Data) = 0 Then
			MsgBox "수량을 입력하세요", , scr_name
			ed_jqty.SetFocus
			Exit Function
		End If
	End If
	If CDbl(ed_jprc.Data) = 0 Then
		MsgBox "단가를 입력하세요", , scr_name
		ed_jprc.SetFocus
		Exit Function
	End If

	If Is_numeric(ed_ogno.Data) = False Then
		MsgBox "원주문번호를 확인하십시오.", , "IBK투자증권"
		ed_ogno.SetFocus
		Exit Function
	End If
	Error_check = True
End Function

Sub ChangeCode()
	If Len(sycd.Data) <> 12 Then
		sycd.Clear
	End If
'	ed_jprc.Data = ""
	cgname.Data = SCREEN.GetName(105, sycd.Data, 0)
	ed_code.Data = sycd.Data
	If SCREEN.Object("main.sycd").Data <> sycd.Data Then
		SCREEN.Object("main.sycd").Data = sycd.Data
		sycd.Trigger "sycd", True
		sycd.Trigger "cgcd", True
		SCREEN.Proc "main.send_sise", "1"
	End If
	SCREEN.Object("main.obj_spin").send
End Sub

Sub Set_mdgb()
	If r_mdgb0.Checked = True Then
		ed_mdgb.Data = "2"						'전부
		ed_jqty.Data = ""
		ed_jqty.Enable = False
		ed_ogno.SetFocus
	ElseIf r_mdgb1.Checked = True Then
		ed_mdgb.Data = "1"						'일부
		ed_jqty.Enable = True
		ed_jqty.SetFocus
	End If
End Sub

'***************************************************************************
' DESC: 주문후 수량 단가 유지
'***************************************************************************
Sub QueryOption(when)
	Dim mmgb
	mmgb = Trim(ed_mmgb.Data)

	If when = "after" Then
		If OrdCfg.KeepQty = False Then		'-- 수량유지안함
			ed_jqty.Data = "0"
		End If
		' 금감원 원칙으로 주문후 원주문번호 clear
		Select Case mmgb
		Case "3", "4"
			ed_ogno.Data = ""
		End Select

		If OrdCfg.KeepPrc = False Then		'-- 단가유지안함
			ed_jprc.Data = "0"
		End If
		Exit Sub
	End If
End Sub

