RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Dim gridPos

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 2
	gridPos = 1

	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
LEDGER.Rcnt = "0058"

' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("main.AN51").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	SCREEN.Object("main.AN51").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 And Trim(SCREEN.Object("main.zPwd").Data) = "" Then
	zPwd.Data = "9999"
Else
	zPwd.Data = Trim(SCREEN.Object("main.zPwd").Data)
End If

If Len(Trim(zPwd.Data)) < 4 Then
	SCREEN.Object("main.zPwd").SetFocus
	Exit Sub
End If

zBnsTp.Data = "1"

SCREEN.onsend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
ecod = Trim(LEDGER.Ecod)

If chkNumericData(ecod) = False Then
	Exit Sub
End If

If LEDGER.Next = "Y" Then
	SCREEN.Object("main.next_btn").Enable = True
Else
	SCREEN.Object("main.next_btn").Enable = False
End If

If Left(LEDGER.Ecod, 1) = "0" Then
	Dim ii , val, rpGubn, gridRpGubn
	rpGubn = Trim(SCREEN.Object("main.zRpBnsTp").Text)

	For ii = GRID0.Rows To gridPos Step -1
		gridRpGubn = Trim(GRID0.GetGridCell(ii, 3))

'		SYSTEM.Trace "gridRpGubn = " & gridRpGubn
'		SYSTEM.Trace "rpGUbn = " & rpGubn

		If gridRpGubn <> "" Then
			If Trim(rpGubn) = Trim(gridRpGubn) Then
				val = Trim(GRID0.GetGridCell (ii, 4))

'				SYSTEM.Trace "val = " & val
				If Is_numeric(val) = False Then
					Exit Sub
				End If


				GRID0.SetGridCell ii, 5, FormatNumber(val * 100, 2)
			Else
				GRID0.RemoveRow ii - 1
			End If
		End If
	Next

	gridPos = GRID0.Rows + 1
Else
	If Trim(LEDGER.Ecod) <> "2679" Then
		Call alert_msg(Trim(LEDGER.Emsg))
	End If
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(lTrdNo)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos <> 3 Then
	Exit Sub
End If

If GRID0.Rows < 1 Then
	Exit Sub
End If

Dim OrderNo, rpMmgb, mmAmt
OrderNo = Trim(GRID0.GetGridCell(GRID0.row,1))
rpMmgb = Trim(GRID0.GetGridCell(GRID0.Row, 2))
mmAmt = Trim(GRID0.GetGridCell(GRID0.Row, 10))

If OrderNo = "" Or rpMmgb = "" Then
	Exit Sub
End If

SCREEN.Object("parent.i_SettNo").data = OrderNo
SCREEN.Object("parent.zRpBnsTp").Data = rpMmgb
SCREEN.Object("parent.mmPrc").Data = mmAmt
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(O_rat)
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(OUTPUT1)
_AW_ENDSCRIPT_AW_


}



