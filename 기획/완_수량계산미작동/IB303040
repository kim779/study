_AW_ONDECLARE_AW_
Option Explicit

Dim start_f
start_f = 1

'***************************************************************************
' DESC: 종목코드 변경시 Setting
'***************************************************************************
Sub ChangeCode()
	SCREEN.Object("obj_hnam.1301").Data = S1301.Data
	SCREEN.Object("OBJ_hnam").Send
SCREEN.IgnoreChange True
	SCREEN.Object("main.1301").Data = S1301.Data
SCREEN.IgnoreChange False
	If start_f = 0 Then
		SCREEN.Proc "main.send_sise_all", "jumun"
	Else
		start_f = 0
	End If
	ed_jqty.Data = 0
	If Is_numeric(SCREEN.Object("main.obj_sise.1377").Data) Then
		ed_jqty.SetDelta SCREEN.Object("main.obj_sise.1377").Data
	End If
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
SCREEN.Send 0

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
If Trim(gubn.Data) = "" Then
	obj.Send
	SCREEN.OnSend = False
	Exit Sub
End If

If gubn.Data = "1" Then
	LEDGER.Svcd = "SDPET014"	'지정
Else
	LEDGER.Svcd = "SDPET015"	'해지
End If

SCREEN.Object("Main.GUIDE").Text = ""
ed_accn.data = Trim(SCREEN.Object("main.OBJ_order.AN1A").Data)
ed_pswd.data = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)
code.Data = SCREEN.Object("main.obj_sise.1021").Data
If Trim(ed_accn.data) = "" Then
	SCREEN.Object("Main.GUIDE").Text = "계좌번호를 확인하세요"
	SCREEN.Object("main.OBJ_order.AN1A").SetFocus
	SCREEN.OnSend = False
	Exit Sub
End If

If Trim(AN20.data) = "" Then
	SCREEN.Object("Main.GUIDE").Text = "선물계좌번호를 확인하세요"
	AN20.SetFocus
	SCREEN.OnSend = False
	Exit Sub
End If
'
If Len(Trim(ed_pswd.data)) < 4 Then
	SCREEN.Object("Main.GUIDE").text = "비밀번호를 확인하세요"
	SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
	SCREEN.OnSend = False
	Exit Sub
End If

