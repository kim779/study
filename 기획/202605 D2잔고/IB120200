_AW_ONDECLARE_AW_
Option Explicit

Dim MapName
MapName = "IB120200"

Dim bond,feeGubn, mesuFee, medoFee, medoTax

Sub Set_account()
	SCREEN.ClearAll 0, 2
	obj.ClearAll 0
	OBJECT0.ClearAll 0
	GUIDE.Text = ""

	If SCREEN.GetMapName(1) = "IB170910" Then
		Dim acnt, acntNm
		acnt = Trim(SYSTEM.Pop("1709_accn"))
		acntNm = Trim(SYSTEM.Pop("1709_name"))

		If acnt <> "" Then
			AN1A.Data = acnt
			ACNM.Data = acntNm

			If SYSTEM.ConnectBy = 0 And zPwd.Enable = False And Trim(zPwd.Data) = "" Then
				zPwd.Data = "9999"
			End If

			If SYSTEM.ConnectBy = 1 And Len(Trim(zPwd.Data)) < 4 Then
				zPwd.SetFocus
				Exit Sub
			End If

			SYSTEM.Push "1709_accn", ""
			SYSTEM.Push "1709_name", ""

			Call send_f()
			Exit Sub
		End If
	End If

	If Len(Trim(AN1A.Data)) = 11 Then
		ACNM.Data = Trim(AN1A.Name)
		zPwd.Data = Trim(AN1A.Password)

		If SYSTEM.ConnectBy = 0 And zPwd.Enable = False And Trim(zPwd.Data) = "" Then
			zPwd.Data = "9999"
		End If

		If SYSTEM.ConnectBy = 1 And Len(Trim(zPwd.Data)) < 4 Then
			zPwd.SetFocus
			Exit Sub
		End If

		Call send_f()
	Else
		AN1A.SetFocus
		Exit Sub
	End If
End Sub


Sub send_f()
	If cbLineCNT.Index = 0 Then
		SCREEN.Proc "obj_oneline.send_f", ""
	Else
		SCREEN.Proc "obj.send_f", ""
	End If

	editSearch.Data = "1"
End Sub

Sub p_write_ini()
	If RADIO0.Checked Then
		bond = "0"	'포함
	Else
		bond = "2"	'미포함
	End If

	feeGubn = Trim(cbFeeGubn.Data)

	If Trim(feeGubn) = "0" Then
		mesuFee = "0"
		medoFee = "0"
		medoTax = "0"
	ElseIf Trim(feeGubn) = "1" Then
		mesuFee = "0"
		medoFee = "1"
		medoTax = "1"
	End If

	If SCREEN.CreateObject("INFO") Then
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "bond", Trim(bond)
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "feeGubn", Trim(feeGubn)
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "mesuFee", Trim(mesuFee)
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "medoFee", Trim(medoFee)
		INFO.PushData LOGIN.Name, "userconf.ini", MapName, "medoTax", Trim(medoTax)
	End If
End Sub

Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		bond = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "bond"))
		feeGubn = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "feeGubn"))
		mesuFee = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "mesuFee"))
		medoFee = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "medoFee"))
		medoTax = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", MapName, "medoTax"))
	End If

	If Trim(feeGubn) ="" Then
		feeGubn = "1"
	End If

	cbFeeGubn.Data = feeGubn

	If Trim(bond) = "" Or Trim(bond) = "0" Then
		RADIO0.Checked = True	'포함
	Else
		RADIO1.Checked = True	'미포함
	End If

End Sub

Sub SetOption()

End Sub

