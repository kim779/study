'********************************************************
' 입력값이 숫자인지를 확인
'********************************************************
Function checkInptVal(inpt)
	checkInptVal = False

	Dim num
	num = Trim(inpt)

	If num = "" Then
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Exit Function
	End If

	If CDbl(num) <= 0 Then
		Exit Function
	End If

	Dim ii, char

	For ii = 1 To Len(num)
		char = Mid(num, ii, 1)

		If AscW(char) < 48 Or AscW(char) > 57 Then
			Exit Function
		End If
	Next

	checkInptVal = True
End Function

Function IsValidAcc(accData)
	Dim Prefix
	IsValidAcc = False

	If Len(AccData) < 3 Then
		Exit Function
	End If

	Prefix = Left(accData, 3)

	Select Case Prefix
		Case "551","552","553","554","555","556","557","558","561","571"
			IsValidAcc = True
		Case Else
			IsValidAcc = False
	End Select
	
	Dim slogh , slog
	slogh = "[대체][" & SCREEN.GetMapName(0) & "] IsValidacc accData =" & accData
	slog = slogh & "IsValid Acc = " & IsValidAcc
	SYSTEM.Trace slog
	
End Function

