RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit

Sub send_f()
	SCREEN.ClearAll 0, 0
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition 2
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
LEDGER.Rcnt = "0010"

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
' -- TR 보내기전 입력 필드 확인
SCREEN.OnSend = False
SCREEN.Object("main.GUIDE").Text = ""

Dim slogh , slog
slogh = "[대체][" & SCREEN.GetMapName(0) & "] "
slog = slogh & "OnSend "
SYSTEM.Trace slog

zIn.Data = "00001"
zAcntNo.Data = Trim(SCREEN.Object("parent.CMB_ACCT").Data)

If Len(Trim(zAcntNo.Data)) <> 11 Then
	Call guide_msg("출고계좌를 확인하여 주십시오.")
	SCREEN.Object("main.obj1.CMB_ACCT").SetFocus
	Exit Sub
End If

zPwd.Data = Trim(SCREEN.Object("main.obj1.zPwd").Data)

If Len(Trim(zPwd.Data)) < 4 Then
	Call guide_msg("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("main.obj1.zPwd").SetFocus
	Exit Sub
End If

LEDGER.Hsiz = 44
LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(zPwd.Data))
zPwd.Data = "HEAD"



zBaseDt.Data = getCurrDay()
zQryTp.Data = "0"

SCREEN.OnSend = True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ii, jmcd

Dim slogh , slog
slogh = "[대체][" & SCREEN.GetMapName(0) & "] "
slog = slogh & "OnReceive  msg " &  LEDGER.Emsg
SYSTEM.Trace slog

If LEDGER.Next = "Y" Then
	For ii = GRID0.Rows To 1 Step -1
		jmcd = Trim(GRID0.GetGridCell(ii, 9))

		If Trim(jmcd) <> "" Then
			If Trim(GRID0.GetGridCell(ii, 33)) <> "00" Then
				GRID0.RemoveRow ii - 1
			Else
				If Left(Trim(jmcd), 1) <> "A" And Left(Trim(jmcd), 1) <> "J" And Left(Trim(jmcd), 1) <> "Q" Then
					GRID0.RemoveRow ii - 1
				End If
			End If
		End If
	Next

	Call send_c()
Else
	If GRID0.Rows > 0 Then
		For ii = GRID0.Rows To 1 Step -1
			jmcd = Trim(GRID0.GetGridCell(ii, 9))

			If Trim(jmcd) <> "" Then
				If Trim(GRID0.GetGridCell(ii, 33)) <> "00" Then
					GRID0.RemoveRow ii - 1
				Else
					If Left(Trim(jmcd), 1) <> "A" And Left(Trim(jmcd), 1) <> "J" And Left(Trim(jmcd), 1) <> "Q" Then
						GRID0.RemoveRow ii - 1
					End If
				End If
			End If
		Next

		If Trim(GRID0.GetGridCell(1, 9)) = "" Then
			Exit Sub
		End If

		SCREEN.Proc "obj_getAvailQty.initData", ""
	End If
End If

SCREEN.Object("main.GUIDE").text = LEDGER.Emsg

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(GRID0)
_AW_ONCLICK_AW_
If GRID0.HitPos = 3 Then
	Dim jmcd
	jmcd = Trim(GRID0.GetGridCell(GRID0.Row, 9))

	If Trim(jmcd) <> "" Then
		'종목세팅
		If Len(Trim(jmcd)) = 7 And (Left(Trim(jmcd), 1) = "A" Or Left(Trim(jmcd), 1) = "J" Or Left(Trim(jmcd), 1) = "Q") Then
			SCREEN.Object("parent.tmp_zIsuNo").Data = Mid(Trim(jmcd), 2)
		Else
			SCREEN.Object("parent.tmp_zIsuNo").Data = jmcd
		End If

		SCREEN.Object("parent.zIsuNo").Data = Trim(jmcd)

		'종목명
		SCREEN.Object("parent.jmNm").Data = Trim(GRID0.GetGridCell(GRID0.Row, 1))

		'대체수량
		SCREEN.Object("parent.zTrxQty").Data = Trim(GRID0.GetGridCell(GRID0.Row, 23))
	Else
		Exit Sub
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


}



