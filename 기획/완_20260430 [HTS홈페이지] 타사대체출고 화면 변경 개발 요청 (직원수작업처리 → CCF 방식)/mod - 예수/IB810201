_AW_ONDECLARE_AW_
Option Explicit

'== 첫 조회
Sub send_f()
	SCREEN.ClearAll 0, 0
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

'== 연속 조회
Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

'ISA 계좌(57)은 입출금 불가 계좌
Function chk_ISA(stracc)
	If SCREEN.GetMapName(1) = "IB810200" Then
		stracc = Mid(stracc,4,2)
		If stracc = "57" Or stracc = "37" Then
			chk_ISA = False
			Exit Function
		Else
			chk_ISA = True
		End If
	Else
		chk_ISA = True
	End If
End Function

'================================================
'계좌 조합(본인계좌. 계좌번호 + 상품 + 계좌명)
'================================================
Sub mkAcnt(gubn)
	If SCREEN.Object("parent.UTAB0").ID = 2 Then
		mkTrAcnt(gubn)
		Exit Sub
	End If

	GRID0.Sort 9, True, True

	Dim ii, items, acnm, accnCell, accnText, accnGubn, bchk_ISA

	For ii = GRID0.Rows To 1 Step -1
		If Trim(GRID0.GetGridCell(ii, 11)) <> "1" And Trim(GRID0.GetGridCell(ii, 12)) <> "동일인" Then
			GRID0.RemoveRow ii - 1
		End If
	Next

	For ii = 1 To GRID0.Rows
		accnCell = Trim(GRID0.GetGridCell(ii, 9))
		accnText = Trim(GRID0.GetGridText(ii, 9))
		accnGubn = ""
		acnm 	 = Trim(GRID0.GetGridCell(ii,10))

		bchk_ISA = chk_ISA(Trim(GRID0.GetGridCell(ii, 9)))

		If	bchk_ISA = True Then
			If Len(accnCell) = 11 Then
				If Mid(accnCell, 4, 2) = "10" Or Mid(accnCell, 4, 2) = "11" Or Mid(accnCell, 4, 2) = "12" Or Mid(accnCell, 4, 2) = "30" Or Mid(accnCell, 4, 2) = "19" Then
					If items = "" Then
						items = accnCell
					End If

					Select Case Mid(Trim(accnCell), 4, 2)
						Case "10" : accnGubn = "위탁    "
						Case "11" : accnGubn = "ELW전용 "
						Case "12" : accnGubn = "코넥스  "
						Case "30" : accnGubn = "일반저축"
						Case "19" : accnGubn = "RIA     "
					End Select

					items = items & vbTab & Trim(accnCell) & Trim(accnText) & "  " & accnGubn & "  " & Trim(acnm)
				End If
			End If
		End If
	Next

	If Trim(gubn) = "out" Then
		SCREEN.Object("parent.OBJ1.CMB_ACCT").SetItems(items)
		'SCREEN.Object("parent.OBJPOP.CMB_ACCT").SetItems(items) 팝업창 생성
		SCREEN.Proc "parent.OBJ1.acct_set", ""  '--계좌번호, 계좌명 세팅
		'SCREEN.Proc "parent.OBJPOP.inputdata", "" 팝업창 생성
	ElseIf Trim(gubn) = "in" Then
		SCREEN.Object("parent.OBJ1.CMB_ACCT2").SetItems(items)
	End If
End Sub

Sub mkTrAcnt(gubn)
	Dim slog, agent, agentnm
	GRID0.Sort 9, True, True

	Dim ii, items, acnm, accnCell, accnText, accnGubn, bchk_ISA

	For ii = GRID0.Rows To 1 Step -1
		If Trim(GRID0.GetGridCell(ii, 11)) <> "1" And Trim(GRID0.GetGridCell(ii, 12)) <> "동일인" Then
			GRID0.RemoveRow ii - 1
		End If
	Next

	For ii = 1 To GRID0.Rows
		accnCell = Trim(GRID0.GetGridCell(ii, 9))
		accnText = Trim(GRID0.GetGridText(ii, 9))
		accnGubn = ""
		acnm 	 = Trim(GRID0.GetGridCell(ii,10))
		bchk_ISA = chk_ISA(Trim(GRID0.GetGridCell(ii, 9)))


			agent 	 = Trim(GRID0.GetGridCell(ii,17))
			agentnm 	 = Trim(GRID0.GetGridCell(ii,18))

'	slog = accnCell & " " & accnText & " " & acnm & " " & bchk_ISA & " " & agent  & " " & agentnm
'	SYSTEM.Trace "[대체][IB810201] " & 	slog

		If	bchk_ISA = True And agent = 1 Then
			If Len(accnCell) = 11 Then
				If Mid(accnCell, 4, 2) = "10" Then
					If items = "" Then
						items = accnCell
					End If

					Select Case Mid(Trim(accnCell), 4, 2)
						Case "10" : accnGubn = "위탁    "
					End Select


					items = items & vbTab & Trim(accnCell) & Trim(accnText) & "  " & accnGubn & "  " & Trim(acnm)
				End If
			End If
		End If
	Next

	SCREEN.Object("parent.OBJ1.CMB_ACCT").SetItems(items)
	SCREEN.Proc "parent.OBJ1.acct_set", ""  '--계좌번호, 계좌명 세팅

End Sub

