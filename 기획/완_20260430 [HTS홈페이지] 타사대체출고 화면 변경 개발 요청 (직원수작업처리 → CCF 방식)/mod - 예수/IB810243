Function NormalizeCompanyName(name)
    Dim pos1, pos2, cutPos
    Dim s

    s = Trim(CStr(name))
    cutPos = Len(s) + 1

    pos1 = InStr(s, "(")
    If pos1 > 0 And pos1 < cutPos Then
        cutPos = pos1
    End If

    pos2 = InStr(s, "[")
    If pos2 > 0 And pos2 < cutPos Then
        cutPos = pos2
    End If

    If cutPos <= Len(s) Then
        s = Left(s, cutPos - 1)
    End If

    NormalizeCompanyName = Trim(s)
End Function

