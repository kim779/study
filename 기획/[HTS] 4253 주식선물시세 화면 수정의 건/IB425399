_AW_ONDECLARE_AW_
Sub send()
	'SCREEN.Send 0
End Sub

Dim myFILE, myMAP
myFILE = "userconf.ini"
myMAP = SCREEN.GetMapName(0)


Sub delete_samecode(scode)

SYSTEM.Trace "delete_samecode scode = " & scode

	For ii = 2 To gridcom.Rows
SYSTEM.Trace gridcom.GetGridCell(ii, 1)
	 	If Trim(scode) = Trim(gridcom.GetGridCell(ii, 1)) Then
SYSTEM.Trace "delete row = " & ii
	 		gridcom.RemoveRow(ii)
	 		gridcom.Refresh()
	 	End If
	Next

SYSTEM.Trace "grid row = " & gridcom.Rows
End Sub


Sub addRowToGrid(scode, sval)
	gridcom.InsertRow(0)
	gridcom.SetGridCell 1,1, scode
	gridcom.SetGridCell 1,2, sval
End Sub

Sub Setcombo()
	Dim item, sVal
	JNAM.Clear

	items = "03" & vbTab

	For ii = 1 To gridcom.Rows
	 	sVal = gridcom.GetGridCell(ii, 1) & " " & gridcom.GetGridCell(ii, 2)
	 	items = items & sVal & vbTab
SYSTEM.Trace "[4253] Setcombo sVal = " & sVal	 	
	Next

	JNAM.SetItems(items)
	write_combo_history()
End Sub


Sub write_combo_history()
	Dim item, sVal, nRows
	JNAM.Clear

	items = "03" & vbTab

	nRows = gridcom.Rows
	For ii = 1 To gridcom.Rows
	 	sVal = gridcom.GetGridCell(nRows, 1) & " " & gridcom.GetGridCell(nRows, 2)
	 	items = items & sVal & vbTab
	 	nRows = nRows - 1
SYSTEM.Trace "[4253] write_combo_history sVal = " & sVal
	Next

	If SCREEN.CreateObject("Info") Then
		INFO.pushData LOGIN.Name, myFILE, myMAP, "combohistory", items
	End If
End Sub


Sub read_combo_history()
	SYSTEM.Trace "read_combo_history"
	gridcom.Clear
	JNAM.Clear
	Dim sComhis, arr, code, nam
	If SCREEN.CreateObject("Info") Then
		sComhis = Trim(INFO.popData (LOGIN.Name, myFILE, myMAP, "combohistory"))
SYSTEM.Trace "[4253] read_combo_history myMAP = " & myMAP & "myFILE = " & myFILE
SYSTEM.Trace "[4253] read_combo_history sComhis = " & sComhis
		If Len(Trim(sComhis)) > 0 Then
			arr = Split(sComhis, vbTab)

			For ii = 1 To UBound(arr)
				code = Left(arr(ii),3)
				nam = Mid(arr(ii),4)
				addRowToGrid code, nam
SYSTEM.Trace "[4253] read_combo_history code = " & code & " nam =" & nam  				
			Next

			JNAM.SetItems(sComhis)
		Else
SYSTEM.Trace "on data -> dosomething"
SYSTEM.Trace "[4253] read_combo_history sComhis no"
		'	cx_log.DoSomething "Get_SFCODE_VAL", "sfcode"
		End If

	End If
End Sub

_AW_ONSTART_AW_
SYSTEM.Trace "IB425301 onStart"
read_combo_history()

