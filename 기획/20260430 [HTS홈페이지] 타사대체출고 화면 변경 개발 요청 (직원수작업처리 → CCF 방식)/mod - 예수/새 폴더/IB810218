Function IsValidAcc(accData)
	Dim Prefix
	IsValidAcc = False

	If Len(AccData) < 3 Then
		Exit Function
	End If

	Prefix = Left(accData, 3)

	Select Case Prefix
		Case "551","552","553","554","555","556","557","558","561","571"
			IsValidAcc = True
		Case Else
			IsValidAcc = False
	End Select

	Dim slogh , slog
	slogh = "[대체][" & SCREEN.GetMapName(0) & "] IsValidacc accData =" & accData
	slog = slogh & "IsValid Acc = " & IsValidAcc
	SYSTEM.Trace slog

End Function

