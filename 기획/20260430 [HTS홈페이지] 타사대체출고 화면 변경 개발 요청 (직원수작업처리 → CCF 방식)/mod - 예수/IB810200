	SCREEN.Object("obj2.grid0").SetDataPosition(2)
	obj2.send
End Sub


Sub contract()		'입고계좌 셋팅, 본인계좌 + 약정계좌
	Dim ii, accnData, accnText, accnGubn, accnNm, items, tmpAcntGb, cnt, acnt
	items = ""
	cnt = 0
	acnt = Trim(SCREEN.Object("OBJ1.CMB_ACCT").Data)

	For ii = 1 To SCREEN.Object("OBJ_acct.GRID0").Rows
		accnData = Trim(SCREEN.Object("OBJ_acct.GRID0").GetGridCell(ii, 9))

		If Trim(accnData) = "" Then
			Exit Sub
		End If

		tmpAcntGb = Mid(Trim(accnData), 4, 2)

		If tmpAcntGb = "10" Then
			accnGubn = "위탁    "
		ElseIf tmpAcntGb = "11" Then
			accnGubn = "ELW전용 "
		ElseIf tmpAcntGb = "12" Then
			accnGubn = "코넥스전용 "
		ElseIf tmpAcntGb = "30" Then
			accnGubn = "일반저축"
		End If


		If tmpAcntGb = "10" Or tmpAcntGb = "11"  Or tmpAcntGb = "12" Or tmpAcntGb = "30" Then
			If Trim(accnData) <> Trim(acnt) And Trim(Left(accnData, 3)) = Trim(Left(acnt, 3)) And Trim(Right(accnData, 6)) = Trim(Right(acnt, 6))Then
				If items = "" Then
					items = accnData
				End If

				accnText = Trim(SCREEN.Object("OBJ_acct.GRID0").GetGridText(ii, 9))
				accnNm = Trim(SCREEN.Object("OBJ_acct.GRID0").GetGridCell(ii, 10))

				items = items & vbTab & accnData & accnText & "  " & accnGubn & "  " & accnNm
			End If
		End If
	Next

	For ii = 1 To SCREEN.Object("OBJ_cont.GRID0").Rows
		If Trim(SCREEN.Object("OBJ_cont.GRID0").GetGridCell(ii, 1)) = "1101" Then
			accnData = Trim(SCREEN.Object("OBJ_cont.GRID0").GetGridCell(ii, 5))
			tmpAcntGb = Mid(Trim(accnData), 4, 2)
			If InStr(items, accnData) < 1 Then
				If Trim(tmpAcntGb) = "10" Or Trim(tmpAcntGb) = "11" Or Trim(tmpAcntGb) = "12" Or Trim(tmpAcntGb) = "30" Then
					accnText = Trim(SCREEN.Object("OBJ_cont.GRID0").GetGridText(ii, 5))
					accnNm = Trim(SCREEN.Object("OBJ_cont.GRID0").GetGridCell(ii, 6))

					If tmpAcntGb = "10" Then
						accnGubn = "위탁   "
					ElseIf tmpAcntGb = "11" Then
						accnGubn = "ELW전용"
					ElseIf tmpAcntGb = "12" Then
						accnGubn = "코넥스전용"
					ElseIf tmpAcntGb = "30" Then
						accnGubn = "일반저축"
					End If

					If items = "" Then
						items = accnData
					End If

					items = items & vbTab & accnData & accnText & "  " & accnGubn & "  " & accnNm
				End If
			End If
		End If
	Next

	SCREEN.Object("OBJ1.CMB_ACCT2").SetItems(items)
	SCREEN.Proc "OBJ1.acct2_set", ""
End Sub

Sub chk_echCont(accnt)
	Dim str

	For ii = 1 To SCREEN.Object("OBJ_cont.GRID0").rows
		str = Trim(SCREEN.Object("OBJ_cont.grid0").getGridText(ii, 3))
		If str = accnt Then
			SCREEN.Object("OBJ1.cont").text = "true"
			Exit Sub
		End If
	Next
End Sub

Sub setTransferList()
	If UTAB1.ID = 1 Then
		obj2.SetObject "IB810232"
	Else
		obj2.SetObject "IB810262"
	End If

	If Trim(SCREEN.Object("obj1.isPwdConfirm").Text) = "Y" Then
	'	If UTAB1.ID = 1 Then
		SCREEN.Proc "obj2.send_f", ""
	'	End If
	End If
End Sub



