		Case 2
		        OBJ1.SetObject ("IB810260")
		        UTAB1.ID = 4

		Case 3
				OBJ1.SetObject ("IB810270")

		Case Else
				UTAB0.ID = 1
		        OBJ1.SetObject ("IB810250")
	End Select

	Call setTransferList()

	SCREEN.Proc "obj_acct.mkAcnt", "out"
End Sub

'== 첫 조회
Sub send_f()
	LEDGER.Fkey = "C"
	next_btn.Enable = False
	SCREEN.Object("obj2.GRID0").clear
	SCREEN.Object("obj2.zAcntNo").data = Trim(SCREEN.Object("OBJ1.zAcntNo").data)
	SCREEN.Object("obj2.zPwd").data = Trim(SCREEN.Object("OBJ1.zPwd").Data)
