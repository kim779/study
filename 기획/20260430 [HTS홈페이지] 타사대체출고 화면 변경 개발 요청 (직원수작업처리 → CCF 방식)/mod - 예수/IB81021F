_AW_ONDECLARE_AW_
Function GetToday()
	AYear = Year(Date)
	AMonth = Month(Date)
	If Len(AMonth) = 1 Then
		AMonth = "0" & AMonth
	End If
	ADay = Day(Date)
	If Len(ADay) = 1 Then
		ADay = "0" & ADay
	End If
	GetToday = AYear & AMonth & ADay
End Function

_AW_ONINDECLARE_AW_
#Load IB888833
#Load IB888888

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
