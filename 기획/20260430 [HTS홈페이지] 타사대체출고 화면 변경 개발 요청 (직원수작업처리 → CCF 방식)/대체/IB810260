'********************************************************
' 입력값이 숫자인지를 확인
'********************************************************
Function checkInptVal(inpt)
	checkInptVal = False

	Dim num
	num = Trim(inpt)

	If num = "" Then
		Exit Function
	End If

	If IsNumeric(num) = False Then
		Exit Function
	End If

	If CDbl(num) <= 0 Then
		Exit Function
	End If

	Dim ii, char

	For ii = 1 To Len(num)
		char = Mid(num, ii, 1)

		If AscW(char) < 48 Or AscW(char) > 57 Then
			Exit Function
		End If
	Next

	checkInptVal = True
End Function


'********************************************************
' 출고계좌번호가 은행개설계좌이면서
' 보안등급이 보안비밀번호등급이면 지점이관 여부 확인
' 은행개설계좌이면서 지점으로 이관하면 TRUE 반환
'********************************************************
Function chkBrnBnkAccnt()
	chkBrnBnkAccnt = False

	If Trim(CMB_ACCT.Data) = "" Then
		Exit Function
	End If

	If Left(Trim(CMB_ACCT.Data), 1) <> "5" Then
		Exit Function
	End If

	If Trim(SCREEN.Object("main.OBJ_cert.zOnesfCnfTp").Data) = "" Then
		Exit Function
	End If

	If Trim(SCREEN.Object("main.OBJ_cert.zOnesfCnfTp").Data) <> "0" Then
		Exit Function
	End If

	Dim accnList, acno, brnNo, ii
	Set accnList = SCREEN.Object("main.OBJ_acct.GRID0")

	For ii = 1 To accnList.Rows
		acno = Trim(accnList.GetGridCell(ii, 9))

		If acno = Trim(CMB_ACCT.Data) Then
			brnNo = Trim(accnList.GetGridCell(ii, 7))

			If Is_numeric(brnNo) = False Then
				Exit Function
			End If

			If Left(brnNo, 1) = "5" Then
				chkBrnBnkAccnt = True
				Exit Function
			End If

			Exit For
		End If
	Next

	chkBrnBnkAccnt = True
End Function

