Sub checkCertify()
	Dim certSt
	certSt = Trim(SCREEN.Object("main.obj_cert.zOnesfCnfTp").Data)

	If certSt <> "" Then
		Select Case certSt
			Case 1	'보안카드
				obj_showCerti.SetRect 336,153,526,270
				obj_showCerti.SetObject "IB810253"
			Case 3	'OTP
				OBJ_OTPType.Send
'				obj_showCerti.SetRect 336,75,526,270
'				obj_showCerti.SetObject "IB810255"
'				SCREEN.Object("obj_showCerti.TrdInfo").data = "#고객님의 계좌에서 유가증권을 타사대체출고합니다"
			Case 0	'보안비밀번호
				Dim ErrMsg1, ErrMsg2

				ErrMsg2 = "OTP 또는 보안카드가 필요한 업무입니다." & vbLf & "모바일 OTP를 발급 받거나, 타기관 OTP 등록 또는 당사 영업점에" & vbLf & "방문하셔서 보안카드를 발급 받은 후 이용하여 주시기 바랍니다."

				If Left(Trim(CMB_ACCT.Data), 1) <> "5" Then
					ErrMsg1 = "대체가 불가능합니다."
					Call alert_msg(ErrMsg1 & vbLf & vbLf & ErrMsg2)
					Call guide_msg(ErrMsg1 & ErrMsg2)
					Exit Sub
				Else
					If chkBrnBnkAccnt() = True Then
						ErrMsg1 = "지점으로 이관된 계좌는 대체가 불가능합니다."
						Call alert_msg(ErrMsg1 & vbLf & vbLf & ErrMsg2)
						Call guide_msg(ErrMsg1 & ErrMsg2)
						Exit Sub
					End If
				End If

				obj_showCerti.SetObject "IB810257"
		End Select

		obj_showCerti.Visible = True
		SCREEN.Proc "obj_showCerti.obj_gen.send_f", ""
	Else
		SCREEN.Proc "main.obj_certi.inquery", ""
	End If
End Sub

