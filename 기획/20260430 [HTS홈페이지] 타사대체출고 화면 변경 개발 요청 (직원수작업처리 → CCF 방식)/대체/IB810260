_AW_ONDECLARE_AW_
Option Explicit

'==================================================
' 계좌명 세팅, 화면 클리어
'==================================================
Sub acct_set()
	isPwdConfirm.Text = ""
	ACNM.Text = ""
	zPwd.Clear
	zTelRgno.Clear
	zTelExno.Clear
	zTelSeqno.Clear
	tmp_zIsuNo.Clear
	zIsuNo.Clear
	Dim accnArr
	accnArr = Split(Trim(CMB_ACCT.Text), "  ")
	jmNm.Clear
	zTrxQty.Clear
	obj_jngo.ClearAll 2
	SCREEN.Object("parent.obj2").ClearAll 2
	obj_showCerti.Visible = False
	obj_showCerti.SetObject ""

	If Trim(CMB_ACCT.Text) = "" Then
		Exit Sub
	End If

	ACNM.Text = Trim(accnArr(UBound(accnArr)))

	If chkBrnBnkAccnt() = True Then
		accnAlert.Visible = True
	Else
		accnAlert.Visible = False
	End If

	zPwd.SetFocus
End Sub


'==================================================
' 비밀번호를 바르게 입력했을 때
'==================================================
Sub rightPwd(param)
	isPwdConfirm.Text = "Y"

	If Trim(param) = "up" Then
		SCREEN.Proc "obj_jngo.send_f", ""
		SCREEN.Proc "parent.obj2.send_f", ""

		zTelRgno.SetFocus
	ElseIf Trim(param) = "bottom" Then
		SCREEN.Proc "parent.obj2.send_f", ""
	End If
End Sub


'==================================================
' 비밀번호가 틀렸을 때
'==================================================
Sub wrongPwd()
	isPwdConfirm.Text = "N"
	zPwd.SetFocus
End Sub


'==================================================
' 주식잔고화면
'==================================================
Sub SetJusikType()
	obj_jngo.SetObject "IB810231"

	l_zBkeepQty.Text = "(주)"
	l_zSecoutBuyDate.Visible = False
	zBuyDate.Visible = False
	zTxontTp.Visible = False

	If Trim(isPwdConfirm.Text) = "Y" Then
		SCREEN.Proc "obj_jngo.send_f", ""
	End If
End Sub


'==================================================
' 채권잔고화면
'==================================================
Sub SetChaeType()
	obj_jngo.SetObject "IB810234"

	l_zBkeepQty.Text = "(원)"
	l_zSecoutBuyDate.Visible = True
	zBuyDate.Visible = True
