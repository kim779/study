{


_AW_ONDECLARE_AW_
Option Explicit

''*************************************************
''send ui data
''*************************************************
Sub Send_f()
	GRID0.Clear
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888
#load IB888833

_AW_ONENDSUB_AW_
_AW_ONSEND_AW_
SCREEN.OnSend False

' 기본값[9999] - 09/07/15
If SYSTEM.ConnectBy = "0" And Trim(ed_pswd.Data) = "" Then
   ed_pswd.Data = "9999"
End If

' 계좌번호
ed_AcntNo.Data = SCREEN.Object("Main.AN3A").data	'계좌번호

' 비밀번호
If SYSTEM.ConnectBy = "1" Then	' 직원용
	ed_pswd.Data = SCREEN.Object("Main.pswd").Data

	If  Len(Trim(ed_pswd.Data)) >= 4 Then
		LEDGER.Hsiz = 44
		LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(ed_pswd.Data))
		ed_pswd.Data = "HEAD"
	End If

	If Trim(ed_pswd.Data) = "HEAD" Then
		If Len(Trim(LEDGER.EPwd)) <> 44 Then
			'GUIDE.Text = "일방향암호화에 실패하였습니다. 비밀번호를 다시 입력해 주세요.."
			ed_pswd.Data = ""
			SCREEN.Object("parent.pswd").Data = ""
			ed_pswd.SetFocus
			SCREEN.OnSend = False
			Exit Sub
		End If
	End If
Else
	ed_pswd.Data = Trim(SCREEN.Object("Main.pswd").Data)
End If

If Trim(ed_AcntNo.Data) = "" Then
	Exit Sub
End If


If Trim(ed_pswd.Data) = "" Then
	Exit Sub
End If

' 지점번호
ed_BrnNo.Data = LOGIN.Brno


SCREEN.OnSend True

_AW_ONENDSUB_AW_
_AW_ONRECEIVE_AW_
Dim ecod
Dim ii

If LEDGER.Next = "Y" Then
	b_next.Enable = True
Else
	b_next.Enable = False
End If

ecod = Trim(LEDGER.Ecod)

If Left(ecod, 1) = "0" Then
	For ii = 1 To GRID0.Rows
		GRID0.SetGridCell ii, 1, GRID0.GetGridCell(ii, 11)   	   '환전일자
		GRID0.SetGridCell ii, 2, Trim(GRID0.GetGridCell(ii, 9))   	   '환전번호
		GRID0.SetGridCell ii, 3, Trim(GRID0.GetGridCell(ii, 29))   	   '코드명
		GRID0.SetGridCell ii, 4, GRID0.GetGridCell(ii, 18)   	   '대상통화
		GRID0.SetGridCell ii, 5, GRID0.GetGridCell(ii, 19)         '환전환율
		GRID0.SetGridCell ii, 6, GRID0.GetGridCell(ii, 20)   	   '환전통화
		GRID0.SetGridCell ii, 7, GRID0.GetGridCell(ii, 22)   	   '외화금액
		GRID0.SetGridCell ii, 8, GRID0.GetGridCell(ii, 23)   	   '원화금액
	Next
End If

_AW_ONENDSUB_AW_
_AW_SCRIPT_AW_(ed_pswd)
_AW_ONKEYCHANGE_AW_
'SYSTEM.Trace "OnKey Start"

If SCREEN.Key = 13 Then
	If Len(Trim(pswd.Data)) > 3 Then
		focus.Text = "1"
		Call send_f()
	End If
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_send)
_AW_ONCLICK_AW_
Send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(print)
_AW_ONCLICK_AW_
If editSearch.Data = "1" Then
	Call GetPrintData()

	CONTROL1.StartPrint ""
Else
	GUIDE.Text = "인쇄할 데이터가 없습니다."
End If
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(cal_startdt)
_AW_ONCHANGE_AW_
Call Send_f()
_AW_ONENDSUB_AW_
_AW_ENDSCRIPT_AW_


_AW_SCRIPT_AW_(b_next)
_AW_ONCLICK_AW_
send_c()
