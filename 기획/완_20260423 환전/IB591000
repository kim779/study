RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit


Dim ii,i
Dim list
Set list = CreateObject("Scripting.Dictionary")

'***************************************************************************
' DESC : 계좌 setting
'***************************************************************************
Sub Set_account()
	ACNM.Data = AN3A.Name
	ed_pswd.Data = AN3A.Password

	If Len(Trim(AN3A.Data)) <> 11 Then
		AN3A.SetFocus
		Exit Sub
	End If

	If SYSTEM.ConnectBy = "1" Then
		If Len(Trim(ed_pswd.Data)) < 4 Then
			ed_pswd.SetFocus
			Exit Sub
		End If
	End If

	Call Send_f()
End Sub

''*************************************************
''send ui data
''*************************************************
Sub Send_f()
	GRID0.Clear()
	LEDGER.Fkey = "C"
    ed_PrdtDtlCode.Data = " "
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	GRID0.SetDataPosition(2)
	SCREEN.Send 0
End Sub






Sub GetPrintData()
	Dim GridData
	Dim ii
	Dim TotalData
	Dim INFOData
	Dim sumData
	Dim strTemp
	Dim jj,kk

	If editSearch.Data <> "1" Then
		Exit Sub
	End If

	strTemp = 0

	INFOData = "계좌번호" & vbTab & Trim(AN3A.data) & vbTab & "계좌명" & vbTab & Trim(AN3A.name) & vbTab & "수수료" & vbTab & Trim(cbo_tax.Text) & vbTab &"출력일자" & vbTab & Date & " " & zeropad(Hour(Now), 2) & ":" & zeropad(Minute(Now), 2) & ":" & zeropad(Second(Now), 2) & vbCrLf

    sumData = "매입금액" & vbTab & "평가금액" & vbTab & "평가손익" & vbTab & "수익률" & vbTab & "가능금액" & vbTab & "신용금액" & vbTab & "추정예탁자산" & vbTab & "D+2 예수금" & vbCrLf
	sumData = sumData & RemovePlus(o_migm.text) & vbTab & RemovePlus(o_pggm.Text) & vbTab & RemovePlus(o_pgsi.Text) & vbTab & RemovePlus(o_srat.Text) & vbTab & RemovePlus(SCREEN.Object("objX.out_can").Text) & vbTab & RemovePlus(SCREEN.Object("objX.out_cred").Text)& vbTab & RemovePlus(SCREEN.Object("objX.out_ass").Text) & vbTab & RemovePlus(SCREEN.Object("objX.out_d2").Text) & vbCrLf

    For ii = 1 To GRID0.Rows

		strTemp = Trim(GRID0.GetGridText(ii, 3))
    	GridData = GridData & strTemp


	 	For jj = 4 To 10
    		If jj <> 8 Then
		   		strTemp = Trim(GRID0.GetGridText(ii, jj))
	    		GridData = GridData & ":" & strTemp
	    	End If
       	Next

       	For KK = 14 To 19
       		If KK <> 17 Then
		   		strTemp = Trim(GRID0.GetGridText(ii, KK))
	    		GridData = GridData & ":" & strTemp
	    	End If
       	Next

       	strTemp = Trim(GRID0.GetGridText(ii, 20))
    	GridData = GridData & ":" &strTemp & vbCrLf

