_AW_ONDECLARE_AW_
Sub send_f()
	GRID0.Clear()
	LEDGER.Fkey = "C"
	SCREEN.Send 0
End Sub

Sub send_c()
	LEDGER.Fkey = "7"
	SCREEN.Send 0
End Sub

_AW_ONSEND_AW_
LEDGER.Rcnt = "0008"

SCREEN.OnSend = False
zIn.Data = "00001"
ed_acno.Data = Trim(SCREEN.Object("parent.AN3A").Data)

If Len(Trim(ed_acno.Data)) <> 11 Then
	MsgBox("계좌번호를 확인하여 주십시오.")
	SCREEN.Object("parent.AN3A").SetFocus
	Exit Sub
End If

If SYSTEM.ConnectBy = 0 And Trim(SCREEN.Object("parent.pswd").Data) = "" Then
	ed_pswd.Data = "9999"
Else
	ed_pswd.Data = Trim(SCREEN.Object("parent.pswd").Data)
End If

If Len(Trim(ed_pswd.Data)) < 4 Then
	MsgBox("비밀번호를 확인하여 주십시오.")
	SCREEN.Object("parent.pswd").SetFocus
	Exit Sub
End If

SCREEN.OnSend = True
'------------------------------------------------------------------------ 일방향 암호화
LEDGER.Hsiz = 44
LEDGER.EPwd = SYSTEM.EncryptSHA(Trim(ed_pswd.Data))
'------------------------------------------------------------------------

SCREEN.OnSend = True
GRID0.Clear

