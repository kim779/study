{


_AW_ONDECLARE_AW_
Dim xstr, xvalue, xistrue


Dim upcd_flg
upcd_flg = 1

Const myFILE = "userconf.ini"
Const myMAP = "IB211500"

Sub p_write_com()
If SCREEN.CreateObject("Info") Then
  INFO.PushData LOGIN.Name, myFILE, myMAP, "COMBO1", S200901.Data

End If
End Sub

Sub p_read_com()
If SCREEN.CreateObject("Info") Then
 	S200901.Data = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "COMBO1"))
End If

If Len(Trim(S200901.data)) = 0 Then
	S200901.data = "001"
	c_upgb.DATA = "001"
End If
End Sub

Sub Change_MKGubn_Main(sMKGubn)

SYSTEM.Trace "[IB250400]Change_MKGubn_Main sMKGubn = " & sMKGubn
	cxMarket.sMarket = sMKGubn
	SCREEN.Send 0
End Sub

_AW_ONINDECLARE_AW_
#load IB888888

_AW_ONENDSUB_AW_
_AW_ONSTART_AW_
' 현재 화면의 시장식별자(cxMarket)에 고유 화면번호 부여
cxMarket.Major = SCREEN.Major

If SCREEN.CreateObject("Info") Then
	c_upgb.DATA = Trim(INFO.PopData(LOGIN.Name, myFILE, myMAP, "c_upgb"))
End If
Call p_read_com()
S200901.Data = c_upgb.Data

If S200901.Data = 889 Then
	S200901.Enable = False
