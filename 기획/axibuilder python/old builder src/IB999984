{


_AW_ONDECLARE_AW_
Dim g_gubn, unit, map_name, startf, bun_gap, tick_gap
map_name = Trim(SCREEN.GetMapName(1))
Dim g_gunit
g_gunit = "001"
g_gubn = "1"

Sub change_chart(key)

SYSTEM.Trace "[한금아][CX_DRCAHRT]MAP NAME : " & map_name
	Dim inputData

	Dim    cod2 	'[15];            종목코드
	Dim    sDate 	'[8];             검색시작일
	Dim    nrec		'[4];             조회건수
	Dim    unit		'[3];             조회단위 1분봉, 3분봉
	Dim    gubn		'[1];             조회구분
					'				  0 : 틱, 1 : 분, 2 : 일
					'				  3 : 주, 4 : 월
	Dim    egbn		'[1];             수정주가 구분
	Dim    smod		'[1];             조회모드
	Dim    nkey		'[23];      Next Key
	Dim    bgbn		'[1];             허봉, 실봉구분
					'				  0: 허봉 1: 실봉
	Dim    dgbn		'[1];             당일 구분
	Dim    temp
	Dim    code_type ' 코드 타입 (입력 코드 보정용)
	Dim    prefix	 ' 코드 접두 : A, N.A, M.A, Q, N.Q, M.Q, ...
	Dim    suffix    ' 코드 접미 : Space
	CStr   str

	Select Case key
	Case 1 gubn = "2"
	Case 2 gubn = "3"
	Case 3 gubn = "4"
	Case 4 gubn = "1"
	Case 5 gubn = "0"
	End Select
	g_gubn = key


	code_type = SCREEN.GetCodeType( Trim(SCREEN.Object("Main.1301").Data) )
	prefix = ""
	suffix = "         "

	' INPUT DATA : 입력코드는 다음과 같은 형태임 (한국금융IT 요청)
	' KRX : A005930   or 005930
	' NXT : N.A005930
	' TOT : M.A005930

SYSTEM.Trace "[한금아][CX_DRCAHRT]CODE_TYPE : ---> " & code_type
	' 코드 타입에 따른 접두 세팅
	Select Case code_type
	Case 27	' ETN - ETN종목은 접두가 Q로 시작

		' 시장선택 구분자가 존재하면 시장에 따라 prefix 선택
		If UCase(TypeName( SCREEN.Object("main.1777") )) <> "NOTHING" Then

			Select Case Trim(SCREEN.Object("main.1777").Data)
			Case 1
				prefix = "Q"
				suffix = "        "

			Case 2
				prefix = "N.Q"
				suffix = "      "

			Case 3
				prefix = "M.Q"
				suffix = "      "
			End Select
		End If

	Case 9	' ELW - ELW 종목은 접두가 J로 시작
		prefix = "J"	' ELW는 대체 거래소 없음
		suffix = "        "

	Case Else	' 다른 일반종목은 접두가 A로 시작


		If UCase(TypeName( SCREEN.Object("main.1777") )) <> "NOTHING" Then
			Select Case Trim(SCREEN.Object("main.1777").Data)
			Case 1
				prefix = "A"
				suffix = "        "

			Case 2
				prefix = "N.A"
				suffix = "      "

			Case 3
				prefix = "M.A"
				suffix = "      "

			End Select
		End If

	End Select

	' 입력값 구성
	cod2 = prefix + Trim(SCREEN.Object("Main.1301").Data) + suffix
SYSTEM.Trace "[한금아][CX_DRCAHRT]INPUT CODE ---> [" & cod2 & "]"

	'cod2 = SCREEN.Object("Main.1301").Data & "         "
	sDate  ="        "
	temp = request_count.Text
	nrec=Trim(temp)

	If(Len(nrec)=3) Then
	    str = " "
		nrec = str & nrec
	End If
	If(Len(nrec)=2) Then
	    str = "  "
		nrec = str & nrec
	End If
	If(Len(nrec)=1) Then
	    str = "   "
		nrec = str & nrec
	End If

	If(Len(nrec)=0) Then
		nrec = " 120"
		request_count.Data = 120
	End If

	unit = g_gunit
	egbn = "1"
	smod = "1"
	nkey = "                       "
	bgbn = "1"
	dgbn = "0"

	inputData = cod2 & sDate & nrec & unit & gubn & egbn & smod & nkey & bgbn & dgbn
SYSTEM.Trace "[한금아][CX_DRCAHRT]inputData : [" & inputData & "]"
	' 실시간 KEY : 다음과 같은 형태임
	' A005930
	' N.A005930
	' M.A005930

SYSTEM.Trace "[한금아][CX_DRCAHRT]FINAL RTS SYMBOL FOR CHART ["&cod2&"]"

	Dim szTR
	szTR = "pibf0011"
	drChart.SendTr szTR, Trim(cod2), inputData,1
	'drChart.SendTr szTR, SCREEN.Object("Main.1301").Data, inputData,1

End Sub

Sub Call_sub(data)
	gubn = e_gubn.Data

	Select Case gubn
		Case 1
			Call Query_Chart(gubn, 0)
		Case 2
			Call Query_Chart(gubn, 0)
		Case 3
			Call Query_Chart(gubn, 0)
		Case 6
			Call Query_Chart(gubn, 0)
		Case 4
			unit = bungap.Data
			Call Query_Chart(gubn, unit)
		Case 5
			unit = tickgap.Data
			Call Query_Chart(gubn, unit)
		Case Else
			Exit Sub
	End Select
End Sub

Sub Query_Chart(gubn, unit)
	startf = 1

	Call Bt_Period_Init() '주기 버튼 전체 초기화

	mtgubn.Data = 0   '분/틱 구분 초기화
	e_gubn.Data = gubn  '파일저장용

	Select Case gubn
		Case 1
			Call change_chart(1)
			Call Bt_Period_Set()
			S101308.Data = "01"       '101308 = 일,주,월 구분 Symbol
			b_day.PRgb = 37736184
		Case 2
			Call change_chart(2)
			Call Bt_Period_Set()
			S101308.Data = "02"
			b_week.PRgb = 37736184
		Case 3
			Call change_chart(3)
			Call Bt_Period_Set()
			S101308.Data = "03"
			b_mon.PRgb = 37736184
		Case 4
			Call Bt_Gap_Init()
			Call Set_bgk_Color(unit)
			Call change_chart(4)
			mtgubn.data = 1
			b_min.PRgb = 37736184
		Case 5
			Call Bt_Gap_Init()
			Call Set_bgk_Color(unit)
			Call change_chart(5)
			mtgubn.data = 2
			b_tick.PRgb = 37736184
		Case Else
			Exit Sub
	End Select
End Sub

Sub Set_bgk_Color(unit)

	If e_gubn.Data = 4 Then
		bungap.Data = unit
	ElseIf e_gubn.Data = 5 Then
		tickgap.Data = unit
	End If

	Select Case unit       '해당 Gap 버튼만 눌림표시
		Case 1
			g_gunit = "001"
			COMBO0.Data = "001"
			b_1.PRgb = 37736184

		Case 5
			g_gunit = "005"
			COMBO0.Data = "005"
			b_5.PRgb = 37736184
		Case 10
			g_gunit = "010"
			COMBO0.Data = "010"
			b_10.PRgb = 37736184
		Case 30
			g_gunit = "030"
			COMBO0.Data = "030"
			b_30.PRgb = 37736184
		Case Else
			g_gunit = l_format(unit, "0", 3)
			COMBO0.Data = g_gunit
	End Select
End Sub

Sub Set_Gap(unit)
	S101308.Data = unit       '101308 = 분,틱일 경우 Gap 조절 Symbol

	If e_gubn.Data = 4 Then
		bungap.Data = unit
	ElseIf e_gubn.Data = 5 Then
		tickgap.Data = unit
	End If

	Call Bt_Gap_Init()

	Select Case unit       '해당 Gap 버튼만 눌림표시
		Case 1
			g_gunit = "001"
			COMBO0.Data = "001"
			b_1.PRgb = 37736184
		Case 5
			g_gunit = "005"
			COMBO0.Data = "005"
			b_5.PRgb = 37736184
		Case 10
			g_gunit = "010"
			COMBO0.Data = "010"
			b_10.PRgb = 37736184
		Case 30
			g_gunit = "030"
			COMBO0.Data = "030"
			b_30.PRgb = 37736184
		Case Else
			g_gunit = l_format(unit, "0", 3)
	End Select
	Call Query_Chart(g_gubn, unit)
End Sub

Sub Bt_Period_Set()
	b_1.Visible = False
	b_5.Visible = False
	b_10.Visible = False
	b_30.Visible = False
	COMBO0.Visible = False
End Sub

Sub Bt_Period_Init()
	b_day.PRgb = 208
	b_week.PRgb = 208
	b_mon.PRgb = 208
	b_min.PRgb = 208
	b_tick.PRgb = 208

	b_day.Visible = True
	b_week.Visible = True
	b_mon.Visible = True
	b_min.Visible = True
	b_tick.Visible = True
	COMBO0.Visible = True
End Sub

Sub Bt_Gap_Init()
	b_1.PRgb = 208
	b_5.PRgb = 208
	b_10.PRgb = 208
	b_30.PRgb = 208

	b_1.Visible = True
	b_5.Visible = True
	b_10.Visible = True
	b_30.Visible = True
End Sub

Sub loadconfig()
SYSTEM.Trace "[3600] --------- load_config map = " & SCREEN.GetMapName(0) & "  map_name = " & map_name
	If SCREEN.CreateObject("INFO") Then
