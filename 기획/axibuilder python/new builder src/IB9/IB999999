def P_GetBigCd(fu_upgb):
    c = fu_upgb[:1]     # VBScript Left(fu_upgb, 1)

    if c == "0":
        return "001"    # KOSPI
    elif c == "1":
        return "101"    # KOSPI200
    elif c == "2":
        return "201"    # KOSDAQ
    elif c == "3":
        return "301"    # KOSDAQ50
    elif c == "4":
        return "401"    # KOSPI100
    elif c == "5":
        return "501"    # KONEX
    elif c == "6":
        return "601"    # SECTOR
    elif c == "7":
        return "701"    # 프리보드
    else:
        if fu_upgb == "999" or fu_upgb == "998" or fu_upgb == "997":
            return fu_upgb
        elif c == "8":
            return "801"  # 기타지수
        else:
            return ""
            
