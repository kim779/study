'***************************************************************
'NAME: chk_elw_price
'DESC: ELW종목 주문착오방지.
'      현재가격대비 -50% ~ 100% 를 벗어나는 주문에 대해 확인창 띄움
'***************************************************************
Function chk_elw_price(code)
	Dim	jprice, cprice, prc_a, prc_b
	Dim	rcv_curr, sdata, dmsg
	chk_elw_price = True
	If ed_mkgb.Data <> "1" Then Exit Function
	If Trim(ed_mmgb.Data) = "4" Then Exit Function					'-- 취소주문시 확인안함

	Select Case Left(code, 1)
	Case "5", "6", "7", "8"			'ELW종목
		jprice = Int(ed_jprc.data)
		sdata = "1301" & Chr(127) & code & vbTab & "2023" & vbTab
		rcv_curr = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
		cprice = Abs(Int(rcv_curr))
		'호가한도가격설정기준(현재가) 500원 미만일 경우
		'상한은 MAX(상한값, 500원), 하한은 적용 배제
		prc_a = (Int(cprice) *0.5)
		prc_b = (Int(cprice) * 2)
		If cprice < 500 Then
			prc_a = 0
			If prc_b < 500 Then prc_b = 500
		End If

		If jprice < prc_a Or jprice > prc_b Then
			If jprice > prc_b Then
				dmsg = vbLf & "고객님의 주문가격은 현재가격과 비교하여 현저히 높습니다.   "
			ElseIf jprice < prc_a Then
				dmsg = vbLf & "고객님의 주문가격은 현재가격과 비교하여 현저히 낮습니다.   "
			End If
			dmsg = dmsg & vbLf & Space(58) & "~~~~~~~~~~" & _
					vbLf & "착오주문여부를 한 번 더 확인하시기 바랍니다." & _
					vbLf & vbLf & vbLf & "주문을 전송하시겠습니까?"
			If MsgBox(dmsg, vbYesNo + vbInformation, "ELW종목 주문착오방지") = vbNo Then
				chk_elw_price = False
			End If
		End If
	End Select
End Function

