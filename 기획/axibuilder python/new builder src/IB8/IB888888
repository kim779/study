'분할화면 관심 정렬용
Sub setArrange(data)

	Dim temp(100,2), save(100,2), field, count, ii, jj, strTemp, firstword

	arrangeOK.Data = 1

	For ii=0 To 100
		For jj=0 To 2
			temp(ii,jj) = ""
			save(ii,jj) = ""
		Next
	Next



	If data = "01" Then
		field = 16				'업종코드
	ElseIf data = "02" Then
		field = 6				'종목명
	ElseIf data = "03" Then
		field = 2				'종목코드
	Else
		Exit Sub
	End If

	count = 0

	'데이터 수신
	For ii=1 To S90303.Rows
		If Trim(S90303.GetGridCell(ii,2)) <> "" Then

			temp(count,0) = Trim(S90303.GetGridCell(ii,2))

			If field = 6 Then
				firstword = Trim(Left(S90303.GetGridCell(ii,field),1))
				If firstword = "!" Or firstword = "/" Or firstword = "$" Or firstword = "%" Or firstword = "&" Or firstword = "@" Or firstword = "X" Then
					temp(count,1) = Mid(Trim(S90303.GetGridCell(ii,field)),2)
				Else
					temp(count,1) = Trim(S90303.GetGridCell(ii,field))
				End If
			Else
				temp(count,1) = Trim(S90303.GetGridCell(ii,field))
			End If

			count = count + 1

		End If
	Next

	For ii=1 To SCREEN.Object("OBJ1.90303").Rows
		If Trim(SCREEN.Object("OBJ1.90303").GetGridCell(ii,2)) <> "" Then
			temp(count,0) = Trim(SCREEN.Object("OBJ1.90303").GetGridCell(ii,2))
			If field = 6 Then
				firstword = Trim(Left(SCREEN.Object("OBJ1.90303").GetGridCell(ii,field),1))
				If firstword = "!" Or firstword = "/" Or firstword = "$" Or firstword = "%" Or firstword = "&" Or firstword = "@" Or firstword = "X" Then
					temp(count,1) = Trim(Mid(SCREEN.Object("OBJ1.90303").GetGridCell(ii,field), 2))
				Else
					temp(count,1) = Trim(SCREEN.Object("OBJ1.90303").GetGridCell(ii,field))
				End If
			Else
				temp(count,1) = Trim(SCREEN.Object("OBJ1.90303").GetGridCell(ii,field))
			End If
			count = count + 1

		End If
	Next

	count = count - 1


'	S90303.Clear
'	SCREEN.Object("OBJ1.90303").Clear

	'정렬
	For ii=0 To count-1
		For jj=ii+1 To count
			If temp(ii,1) > temp(jj,1) Then
				strTemp = temp(ii,0)
