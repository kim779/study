'풀화면 관심 정렬용
Sub setArrange2(data)

	Dim temp(100,2), field, count, ii, jj, strTemp, firstword
'	SYSTEM.Trace "arrangeOK.Data : " & arrangeOK.Data
	arrangeOK.Data = 1

	For ii=0 To 100
		For jj=0 To 2
			temp(ii,jj) = ""
		Next
	Next



	If data = "01" Then
		If SCREEN.GetMapName(1) = "IB200000" Then
			field = 22				'업종코드
		ElseIf SCREEN.GetMapName(1) = "IB2000XX" Then
			field = 22				'업종코드
		ElseIf SCREEN.GetMapName(1) = "IB2000YY" Then
			field = 22				'업종코드
		ElseIf SCREEN.GetMapName(1) = "IB300000" Then
			field = 19				'업종코드

		ElseIf SCREEN.GetMapName(1) = "IB500000" Then
			field = 19				'업종코드
		ElseIf SCREEN.GetMapName(1) = "IB2022T0" Then
			field = 19				'업종코드
		End If

	ElseIf data = "02" Then
		field = 6				'종목명
	ElseIf data = "03" Then
		field = 2				'종목코드
	Else
		Exit Sub
	End If

	count = 0

	'데이터 수신
	For ii=1 To S90303.Rows
		If Trim(S90303.GetGridCell(ii,2)) <> "" Then

			temp(count,0) = Trim(S90303.GetGridCell(ii,2))

			If field = 6 Then
				firstword = Trim(Left(S90303.GetGridCell(ii,field),1))
				If firstword = "!" Or firstword = "/" Or firstword = "$" Or firstword = "%" Or firstword = "&" Or firstword = "@" Or firstword = "X" Then
					temp(count,1) = Mid(Trim(S90303.GetGridCell(ii,field)),2)
				Else
					temp(count,1) = Trim(S90303.GetGridCell(ii,field))
				End If
			Else
				temp(count,1) = Trim(S90303.GetGridCell(ii,field))
			End If

			count = count + 1

		End If
	Next

	count = count - 1
'	For ii=0 To count
'		SYSTEM.Trace "temp(" & ii & ")(0) : " & temp(ii,0) & " (1) : " &  temp(ii,1)
'	Next

'	S90303.Clear
'	SCREEN.Object("OBJ1.90303").Clear

	'정렬
	For ii=0 To count-1
		For jj=ii+1 To count
			If temp(ii,1) > temp(jj,1) Then
				strTemp = temp(ii,0)
				temp(ii,0) = temp(jj,0)
				temp(jj,0) = strTemp

				strTemp = temp(ii,1)
				temp(ii,1) = temp(jj,1)
				temp(jj,1) = strTemp
			End If
		Next
	Next








	count = 0

	'재배치
	For ii=1 To S90303.Rows
		S90303.SetGridCell ii,2, temp(count,0)
		count = count + 1
	Next

	SCREEN.Send 0
End Sub

