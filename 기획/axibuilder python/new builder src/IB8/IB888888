'*************************************************************************
' change_date : 시스템 일자에서 원하는만큼 일자를 옮김
' 호출형식 예) change_date("m",-3) -> 시스템일자에서 3달전 일자를 Return
' m : month , d : day , y : year
'*************************************************************************
Public Function change_date(dat,diff)
	Dim cday, yy, mm, dd
	cday = DateAdd(dat, diff, Date)

	yy = Year(cday)
	mm = Month(cday)
	If Len(mm) = 1 Then mm = "0"&mm
	dd = Day(cday)
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd
	change_date = CDbl(cday)
End Function


'*************************************************************************
' week_check : 받아온 일자가 토,일요일일경우 금요일일자로 Return
' Return 형식 : 예) 20040603 의  상수
'*************************************************************************
Public Function week_check(eday)
	Dim MyDate, MyWeek, yy, mm, dd

	If Trim(eday) = "" Then
		Exit Function
	End If

	If IsDate(eday) = False Then
		eday = DateSerial(Mid(eday,1,4),Mid(eday,5,2),Mid(eday,7,2))
	End If
	If IsDate(eday) = False Then Exit Function


	MyWeek = Weekday(eday)
	If MyWeek = 1 Then
		eday= DateAdd("d", -2 , eday)
	ElseIf MyWeek = 7 Then
		eday= DateAdd("d", -1 , eday)
	End If

	yy = Year(eday)
	mm = Month(eday)
	If Len(mm) = 1 Then mm = "0"&mm
	dd = Day(eday)
	If Len(dd) = 1 Then dd = "0"&dd

	eday = yy&mm&dd
	week_check = eday
End Function


'*************************************************************************
' change_indate : 입력일자에서 원하는만큼 일자를 옮김
' 호출형식 예) change_indate("m",-3) -> 입력일자에서 3달전 일자를 Return
' m : month , d : day , y : year
'*************************************************************************
Public Function change_indate(dat,diff, indate)
	Dim cday, yy, mm, dd

	cday = DateAdd(dat, diff, CDate(indate))

	yy = Year(cday)
	mm = Month(cday)
	If Len(mm) = 1 Then mm = "0"&mm
	dd = Day(cday)
	If Len(dd) = 1 Then dd = "0"&dd

	cday = yy&mm&dd
	change_indate = CDbl(cday)
End Function


'*************************************************************************
' getCurrDay : 오늘날짜를 가져옴
'*************************************************************************
Public Function getCurrDay()
	Dim cday, yy, mm, dd
	cday = LOGIN.Day0

	If Trim(cday) = "" Then
		yy = Year(Date)
		mm = Month(Date)

		If Len(mm) = 1 Then
			mm = "0"& mm
		End If

		dd = Day(Date)

		If Len(dd) = 1 Then
			dd = "0"& dd
		End If

		cday = yy&mm&dd
	End If

	getCurrDay = CDbl(cday)
End Function



'*************************************************************************
' getCurrDay : 오늘날짜를 가져옴
'*************************************************************************
Public Function getDateSerial(inptDate)
	Dim cday, yy, mm, dd
	cday = Trim(inptDate)

	yy = Left(cday, 4)
	mm = Mid(cday, 5, 2)
	dd = Right(cday, 2)

	cday = DateSerial(yy, mm, dd)


	getDateSerial = CDbl(cday)
End Function


'***************************************************************************
' DESC: 0보다큰 숫자형식인지 검사. 유효숫자( > 0):true else false
'***************************************************************************
Function Is_numeric(data)
	Dim num
	num = Trim(data)

	If num = "" Then
		num = 0
	End If

	Is_numeric = False
	If IsNumeric(num) = False Then
		Exit Function
	End If
	If CDbl(num) <= 0 Then
		Exit Function
	End If

	Is_numeric = True
End Function


