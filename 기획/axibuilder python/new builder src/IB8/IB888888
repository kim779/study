				tick_limit = (0.02 * tick_2) * 100

				If bSpread = True Then
					sdata = "100301" & Chr(127) & code & vbTab & "101023" & vbTab
					rcv_curr = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
					curr = Mid(rcv_curr, 2, Len(rcv_curr)-1) * 100

					If Trim(curr) <> "" Then
						curr = CDbl(curr)
					End If
				Else
					If Trim(SCREEN.Object("main.OBJ_sise.101023").Data) <> "" Then
						curr = CDbl(Trim(SCREEN.Object("main.OBJ_sise.101023").Data)) * 100.0
					End If
					If hogb = "3" Or hogb = "6" Then
						sdata = "100301" & Chr(127) & code & vbTab & "100319" & vbTab
						rcv_prc = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
						prc = rcv_prc * 100 '기준가로 적용
					End If
				End If

			Case "75", "76", "77", "78"	'---------------------------------------------------통화선물/통화선물 스프레드----------------
				tick_1 = 50
				tick_2 = 100
				If mkty <> "78" Then
					tick_warn = (0.10 * tick_1) * 100
					tick_limit = (0.10 * tick_2) * 100
				Else
					tick_warn = (0.01 * tick_1) * 100
					tick_limit = (0.01 * tick_2) * 100
				End If

				If bSpread = True Then
					sdata = "100301" & Chr(127) & code & vbTab & "101023" & vbTab
					rcv_curr = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
					curr = Mid(rcv_curr, 2, Len(rcv_curr)-1) * 100

					If Trim(curr) <> "" Then
						curr = CDbl(curr)
					End If
				Else
					If Trim(SCREEN.Object("main.OBJ_sise.101023").Data) <> "" Then
						curr = CDbl(Trim(SCREEN.Object("main.OBJ_sise.101023").Data)) * 100.0
					End If

					If hogb = "3" Or hogb = "6" Then
						sdata = "100301" & Chr(127) & code & vbTab & "100319" & vbTab
						rcv_prc = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
						prc = rcv_prc * 100 '기준가로 적용
					End If
				End If

			Case Else
				If ("10" <= mkty And mkty <= "59") Or ("B0" <= mkty And mkty <= "ZZ")  _
							Or ("0A" <= mkty And mkty <= "0Z") Or ("1A" <= mkty And mkty <= "1Z") _
							Or ("2A" <= mkty And mkty <= "2Z") Or ("3A" <= mkty And mkty <= "3Z") _
							Or ("4A" <= mkty And mkty <= "4Z") Or ("5A" <= mkty And mkty <= "5Z") _
							Or ("6A" <= mkty And mkty <= "6Z") Or ("7A" <= mkty And mkty <= "7Z") _
							Or ("8A" <= mkty And mkty <= "8Z") Or ("9A" <= mkty And mkty <= "9Z") Then	'----------------------------------주식선물/주식선물 스프레드---------------------
					If bSpread = False Then
						If hogb = "3" Or hogb = "5" Or hogb = "6" Then
							sdata = "100301" & Chr(127) & code & vbTab & "100319" & vbTab
							rcv_prc = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
							prc = rcv_prc
						End If

						sdata = "100301" & Chr(127) & code & vbTab & "100802" & vbTab    '거래 승수
						rcv_qty = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
						qtyx = rcv_qty

						amount = prc*qty*qtyx
						If amount > 1000000000 Then
							dmsg = "주문금액이 10억원을 벗어난 이상주문입니다."
							msgOpt = vbOKOnly + vbInformation
						ElseIf amount > 500000000 Then
							dmsg = "주문금액이 5억원을 벗어난 이상주문입니다."
						End If
					Else
						diff_code1 = "1"& Mid(code, 2,4) & "000"
						sdata = "100301" & Chr(127) & diff_code1 & vbTab & "100319" & vbTab
						rcv_diff1 = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
						diff_code2 = "1"& Mid(code, 2,2) & Mid(code, 6,2) & "000"
						sdata = "100301" & Chr(127) & diff_code2 & vbTab & "100319" & vbTab
						rcv_diff2 = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)

						If rcv_diff1 < rcv_diff2 Then
							hogaPrc = rcv_diff1
						Else
							hogaPrc = rcv_diff2
						End If

						If Trim(hogaPrc) <> "" Then
							hogaPrc = CDbl(hogaPrc)
						End If

						tick_1 = 50
						tick_2 = 100
						If hogaPrc < 10000 Then
							hogaPrc = 5
						ElseIf hogaPrc < 50000 Then
							hogaPrc = 25
						ElseIf hogaPrc < 100000 Then
							hogaPrc = 50
						ElseIf hogaPrc < 500000 Then
							hogaPrc = 250
						Else
							hogaPrc = 500
						End If

						tick_warn = 50 * hogaPrc
						tick_limit = 100 * hogaPrc
						sdata = "100301" & Chr(127) & code & vbTab & "101023" & vbTab
						rcv_curr = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
						curr = Mid(rcv_curr, 2, Len(rcv_curr)-1)

						If Trim(curr) <> "" Then
							curr = CDbl(curr)
						End If

					End If
				End If
			End Select

			If  tick_warn>0 And tick_limit>0 Then
'				SYSTEM.Trace "Price(" & prc & "), Curr(" & curr & "), tick_warn(" & tick_warn & "), tick_limit(" & tick_limit & ")"
				' 부동소숫점 연산시 오류 발생하여 보정값 처리함
				If (prc < (curr-tick_limit-0.00001)) Or (prc > (curr+tick_limit+0.00001)) Then
					dmsg = "주문가격이 " & tick_2 & "틱을 벗어난 이상주문입니다."
					msgOpt = vbOKOnly + vbInformation
				ElseIf (prc < (curr-tick_warn-0.00001)) Or (prc > (curr+tick_warn+0.00001)) Then
					dmsg = "주문가격이 " & tick_1 & "틱을 벗어난 이상주문입니다."
				End If
			End If



		'-----------------------------------------------------------------------------------------------------------------
		Case "2", "3", "B", "C"	 	'-------------------------------------KOSPI200 콜/풋 옵션-----------------------------------------
			hogb = Right(c_hogb.Data, 1)
			If hogb = "3" Or hogb = "5" Or hogb = "6" Then			'-- 시장가/최유리/조건부
				sdata = "40301" & Chr(127) & code & vbTab & "40348" & vbTab
				rcv_prc = SCREEN.ServiceEx("pooppoop", sdata, Len(sdata), &H02, 5000000)
				prc = rcv_prc * 100	'-- 기준가로 적용
			End If

			If Trim(prc) <> "" Then
				prc = CDbl(prc)
			End If

			If mkty = "05" Then
				amount = qty * prc * 500 	'mini옵션 0.01 = 50,000원
			Else
				amount = qty * prc * 2500 	'옵션 0.01 = 250,000원
			End If
			If amount > 2000000000 And amount <= 5000000000 Then
				dmsg2 = "주문금액이 20억을 초과한 이상주문입니다."
			ElseIf amount > 5000000000 Then
				dmsg2 = "주문금액이 50억을 초과한 이상주문입니다."
				msgOpt = vbOKOnly + vbInformation
			End If
		End Select
		'=========================================================================================================================
	Case Else
		Exit Function
	End Select

	'++++++++++++++++++++++++++++++++++++++++++++++주문착오방지 확인 팝업 ++++++++++++++++++++++++++++++++++++++++++++++++++++
	If Trim(dmsg) = "" And Trim(dmsg2) = "" Then
		chk_mistake_order = True
	Else
		SCREEN.CreateWindow 2, "IB999951 /p5 /d", "EDIT0" & vbTab & dmsg & vbLf & "EDIT1" & vbTab & dmsg2 & vbLf
		dlg_check = SYSTEM.Pop("protectjumun")
		SYSTEM.Push "protectjumun",""
		If dlg_check = "OK" Then
			chk_mistake_order = True
			Exit Function
		End If
	End If
	'++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
End Function


