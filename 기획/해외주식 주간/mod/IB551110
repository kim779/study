Sub CalWon()
SYSTEM.Trace "!!!!!!!!!!!!!!!!!!!!!!!!!CalWon map="& SCREEN.GetMapName(0)
	If Trim(IMAXPRICE.Text) = "" Or Trim(IMAXPRICE.Text) = "0" Then
		out_USD.Data = 0
		out_WON.Data = 0
		Exit Sub
	End If

	'수량 * 외화(가격)  소수점2자리
	out_USD.Data = Round( CDbl(IMAXPRICE.Text) * ed_jqty.Data, 2)

	If Trim(out_ERate.Text) = "" Or Trim(out_ERate.Text) = "0" Then
		out_WON.Data = 0
		Exit Sub
	End If

	If Trim(out_USD.Data) = "" Or Trim(out_USD.Data) = "0" Then
		out_USD.Data = 0
		out_WON.Data = 0
		Exit Sub
	End If

	'수량 * 외화(가격) * 환율
	out_WON.Data = Round( CDbl(out_ERate.Text) * CDbl(IMAXPRICE.Text) * ed_jqty.Data, 0)
End Sub


'***************************************************************
'NAME: chkNumericData(num)
'num이 숫자이면 True, Null이거나 숫자가 아니면 False를 반환
'***************************************************************
Function chkNumericData(num)
	chkNumericData = False

	Dim data
	data = Trim(num)

	If data = "" Then
		Exit Function
	End If

	If IsNumeric(data) = False Then
		Exit Function
	End If

	chkNumericData = True
End Function

'개인 3억이상 주문시 경고창 5억이상 주문시 주문 거부창
'법인 5억이상 주문시 경고차 10억이상 주문시 주문 거부창
Function IsCorporation(stracc)
IsCorporation = False
stracc = Replace(stracc, "-", "")
Dim accList
Dim idx
Dim ii
accList = Split(CX_DTS.GetTypeData ("4","1" ), vbLf, -1, vbTextCompare)  ''accoutcc 로 전계좌 불러오기 0->1
	idx = 1

	For ii=0 To UBound(accList)
		acc = Trim(accList(ii))
		If Len(acc)>11 Then
			acc = Split(acc, "|", -1, vbTextCompare)
			acno = Trim(Mid(acc(0), 1, 11))
			acnm = Mid(acc(0), 12)
			acnm = Replace(acnm, vbTab, "")
			acnm = Trim(acnm)
			acid = Trim(acc(1))
			actp = Mid(acno, 4, 2)
			myAcntFlag = acc(2)


			'계좌플래그 2 또는 3 이면 랩계좌      법인계좌 타입 = 4
			'랩계좌 제외
			If stracc = acno Then
SYSTEM.Trace  acno & "|  " & acnm & "|  " & acid & " | " & actp & " | " & myAcntFlag
				If chkNumericData(myAcntFlag) = True Then
					value = myAcntFlag And 4    '랩계좌 2 와 And 연산
				    If value = 1 Then
						IsCorporation = True
					End If
				End If
			End If
		End If
	Next
End Function

