'SYSTEM.Push "S_Orsjprc", jprc

Sub DoCancel()

	Dim hogb, cPos
	Dim mdgb, dmsg
	Dim stype, hnam
	Dim jprc

	Call init_data()									'매수주문 기본세팅

	If Error_check() = False Then			'주문전 Error Check
		flash_fg.Data = 0
		Exit Sub
	End If

		dmsg = "o_acno" & vbTab & ed_acno.Data & vbLf &_
			"o_acnm" & vbTab & SCREEN.Object("parent.ACNM").Data & vbLf &_
			"o_hnam" & vbTab & o_hnam.Data & vbLf &_
			"o_ogno" & vbTab & ed_ogno.Data & vbLf &_
			"o_mdgb" & vbTab & o_ordtype.Data & vbLf &_
			"o_jqty" & vbTab & ed_jqty.Data & vbLf
		SCREEN.CreateWindow 2, "IB55000C /p5 /d", dmsg
		If SYSTEM.Pop("FOstock_cancel_order") <> "OK" Then
			Exit Sub
		End If

	jmbtclick.Data = 1

	'------------------------------------------------------------------------------------------------
	stmp = ed_mkgb.Data
	If stmp = "71" Or stmp = "72" Or stmp = "73" Then
		ed_ordTp.Data = "1"
		ed_mdgb.Data = "20"
	ElseIf stmp = "81" Or stmp = "82" Or stmp = "87" Then
		ed_ordTp.Data = "2"
		ed_mdgb.Data = "10"
	Else
		MsgBox "시장구분번호를 확인하세요.",,"IBK투자증권"
		Exit Sub
	End If

	ed_mmgb.Data = "08"    					'매매구분 01매도 02매수 08취소 21단주
											'시장구분
	ed_code.Data = Trim(ed_code.Data)		'종목코드
	ed_prc.Data = CDbl(Trim(ed_prc.Data))  * 10000 						'주문가

	If stmp = "71"  Then
		ed_curCode.Data = "009"
	ElseIf stmp = "72" Or stmp = "73" Then
		ed_curCode.Data = "006"
	ElseIf stmp = "81" Or stmp = "82" Or stmp = "87" Then
		ed_curCode.Data = "001"
	Else
		MsgBox "시장구분번호를 확인하세요..",,"IBK투자증권"
		Exit Sub
	End If

	stmp = Trim(o_ordtype.Data)
	If stmp = "지정가" Then
		ed_hogb.Data  = "00"
	ElseIf stmp = "시장가" Then
		ed_hogb.Data  = "03"
	ElseIf stmp = "TWAP" Then
		ed_hogb.Data  = "A2"
	ElseIf stmp = "VWAP" Then
		ed_hogb.Data  = "A3"
	ElseIf stmp = "LIMIT_TWAP" Then
		ed_hogb.Data  = "A4"
	ElseIf stmp = "LIMIT_VWAP" Then
		ed_hogb.Data  = "A5"
	ElseIf stmp = "MOC" Then
		ed_hogb.Data  = "B1"
	ElseIf stmp = "LOC" Then
		ed_hogb.Data  = "B2"
	Else
		ed_hogb.Data  = ""
	End If

'------------------------------------------------------------------------------------------------

	SCREEN.Object("parent.obj_snd").send		'주문전송

End Sub

Sub Set_Orsjmno()
SYSTEM.Trace "IB551030 Set_Orsjmno"
	Get_Orsjmno()
End Sub

