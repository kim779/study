'------------------------접속------------------------------------------------------------------------------------
Sub EAPI_connect()
	'grd_msg.InsertRow 0
	'grd_msg.SetGridCell 1, 1, ""
	ret = ctrl_newphonepad.EAPIConnect(edIP.Data,edport.Data)
	If ret = True Then
		btn_connect.Enable = False
		btn_disconnect.Enable = True
	Else
		btn_connect.Enable = True
		btn_disconnect.Enable = False
	End If
End Sub

'------------------------접속해제------------------------------------------------------------------------------------
Sub EAPI_disconnect()
	'grd_msg.InsertRow 0
	'grd_msg.SetGridCell 1, 1, ""
	ret = ctrl_newphonepad.EAPIDisconnect()

	If ret = True Then
		btn_connect.Enable =True
		btn_disconnect.Enable =  False
		bLogin = False
	Else
		btn_connect.Enable = False
		btn_disconnect.Enable = True
	End If
End Sub

