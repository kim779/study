Sub BalStAfter()
	OUTPUT1.Data = BalstGrid.GetGridCell(BalstGrid.Rows,  7)		'종합 예수금
	OUTPUT2.Data = BalstGrid.GetGridCell(BalstGrid.Rows, 10)		'종합 평가금액
	OUTPUT3.Data = BalstGrid.GetGridCell(BalstGrid.Rows, 19)		'종합 신용대출금액
	OUTPUT4.Data = BalstGrid.GetGridCell(BalstGrid.Rows, 23)		'종합 전체계좌합계

	BalstGrid.RemoveRow(BalstGrid.Rows - 1)

	Dim ii, jj, tmpEvalAmt, tmpLoanAmt
	tmpEvalAmt = 0
	tmpLoanAmt = 0

	For ii = 1 To BalstGrid.Rows
		If Len(Trim(BalstGrid.GetGridCell(ii, 2))) = 14 Then
			BalstGrid.SetFormat ii, 2, "999-99-999999-999"
		End If

		For jj = 8 To 16
			If (jj Mod 2) = 0 Then
				If Trim(BalstGrid.GetGridCell(ii, jj)) <> "" Then
					tmpEvalAmt = tmpEvalAmt + BalstGrid.GetGridCell(ii, jj)	'종합 예수금
				End If
			End If
		Next

		For jj = 19 To 21
			If Trim(BalstGrid.GetGridCell(ii, jj)) <> "" Then
				tmpLoanAmt = tmpLoanAmt + BalstGrid.GetGridCell(ii, jj)
			End If
		Next

		BalstGrid.SetGridCell ii, 18, Trim(tmpEvalAmt)
		BalstGrid.SetGridCell ii, 20, Trim(tmpLoanAmt)

		tmpEvalAmt = 0
		tmpLoanAmt = 0
	Next

End Sub


Sub SaveAllColumnWidth()
	Dim ii
	Dim ival
	Dim allval
	Dim mapname
	Dim section

	For ii = 0 To SecDtlGrid.Columns
		ival = SecDtlGrid.GetColumnWidth(ii)
		If SecDtlGrid.IsColumnVisible(ii) And ival > 0 Then
			'SYSTEM.Trace "[IB170900] column ii = " & ii & "ival = " & ival
			allval = allval & "|" & ival
		End If
	Next
	
	If Len(allval) > 0 Then
		allval = Mid(allval, 2)
	End If
	
	If SCREEN.CreateObject("info") Then
		mapname = SCREEN.GetMapName(0)
		section = "colwidth" & SCREEN.Object("main.tab_subSubHangmok").ID
		INFO.PushData LOGIN.Name, "userconf.ini", mapname, section, allval
