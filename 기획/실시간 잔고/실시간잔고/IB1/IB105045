RESOURCE DIVISION
{


_AW_ONDECLARE_AW_
Option Explicit
Dim ii,i, gridSel
Dim list
Set list = CreateObject("Scripting.Dictionary")

gridSel = "N"
''*************************************************
''send ui data
''*************************************************
Sub f_vSendUiData()
	Dim accn, pass,tax,mmd

	SCREEN.OnSend False
	VIEWGRID.Clear

	If cbo_mmd.Index = 0 Then
		mmd = out_hts.data
	ElseIf cbo_mmd.Index = 1 Then
		mmd = out_call.data
	ElseIf cbo_mmd.Index = 2 Then
		mmd = out_ars.data
	End If

	accn = Trim(AN1A.Data)						'계좌번호
	pass = Trim(pswd.Data)						'비밀번호
	tax = cbo_tax.data

	If Len(Trim(accn)) <> 11 Or pass < 4 Then
		accn = Trim(SCREEN.Object("main.OBJ_order.AN18").Data)
		pass = Trim(SCREEN.Object("main.OBJ_order.ed_pswd").Data)

		If Len(Trim(accn)) <> 11 Then
			Call guide_msg("계좌번호를 확인하여 주십시오.")
			SCREEN.Object("main.OBJ_order.AN18").SetFocus
			Exit Sub
		End If

		If Len(Trim(pass)) < 4 Then
			Call guide_msg("비밀번호를 확인하여 주십시오.")
			SCREEN.Object("main.OBJ_order.ed_pswd").SetFocus
			Exit Sub
		End If
	End If

	CONTROL0.SetMcgb = cbo_mmd.Index

	'Call CONTROL0.Send(accn , pass, tax ,mmd )

	If UCase(TypeName( SCREEN.Object("main.cxMarket"))) <> "NOTHING" Then
		If cxMarket.sMarket = "KRX" Then
			Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, "0", "1")
		ElseIf cxMarket.sMarket = "NXT" Then
			Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, "0", "2")
		ElseIf cxMarket.sMarket = "통합" Then
			Call CONTROL0.SendMarketEx(accn , pass, tax ,mmd, "0", "3")
		End If
	End If

	SCREEN.Wait = True
End Sub


