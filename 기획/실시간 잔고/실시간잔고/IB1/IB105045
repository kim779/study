Sub p_read_ini()
	If SCREEN.CreateObject("INFO") Then
		Dim tax, mcgb, bep, renewal
		tax = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "tax"))
		mcgb = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "mcgb"))
		bep = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "bep"))
		renewal = Trim(INFO.PopData(LOGIN.Name, "userconf.ini", SCREEN.GetMapName(1), "renewal"))

		If tax <> "" Then
			cbo_tax.Index = tax
		Else
			cbo_tax.Index = 0
		End If

		If cbo_tax.Data = 0 Then
			cbo_mmd.Enable = False
		Else
			cbo_mmd.Enable = True
		End If

		If mcgb <> "" Then
			cbo_mmd.Index = mcgb
		Else
			cbo_mmd.Index = 0
		End If

		If bep <> "" Then
			cbo_bep.index = bep
		Else
			cbo_mmd.Index = 0
		End If

		If cbo_bep.Data = 0 Then
			VIEWGRID.SetColumnVisible 7, True
			VIEWGRID.SetColumnVisible 8, False
		Else
			VIEWGRID.SetColumnVisible 7, False
			VIEWGRID.SetColumnVisible 8, True
		End If

		If renewal = "" Then '실시간
			If SYSTEM.ConnectBy <> "1" Then '고객
				renewal = 0
			Else
				renewal = 1
			End If
		End If

		If renewal <> "" Then
			cbo_renewal.index = renewal
		Else
			cbo_renewal.Index = 0
		End If


		If renewal = 0 Then '실시간
			CONTROL0.SetSkipTime(0)
		ElseIf renewal = 1 Then '1초
			CONTROL0.SetSkipTime(1)
		ElseIf renewal = 2 Then  '2초
			CONTROL0.SetSkipTime(2)
		ElseIf renewal = 3 Then  '3초
			CONTROL0.SetSkipTime(3)
		End If
	End If
End Sub

