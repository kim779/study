'***************************************************************************
Sub all_chk(Flag)
	Dim jgyh, jqty, sygb, gcnt, mflag
	gcnt = 0
	mflag = 0

	For ii = 1 To VIEWGRID.Rows
		If Trim(VIEWGRID.GetGridCell (ii, 2)) = "" Then
			Exit Sub
		End If

		jgyh  = Trim(VIEWGRID.GetGridCell (ii,  4))	' 일반/신용/대용 구분
		jqty  = Trim(VIEWGRID.GetGridCell (ii,  6))	' 매도가능수량
		sygb  = Trim(VIEWGRID.GetGridCell (ii, 15))	' 신용구분

		Select Case jgyh
		Case "00", "01" 	' 일반, 신용만 가능
			' 대주잔고가 아니며 매도가능수량이 존재할경우
			If jqty <> "" And sygb <> "05" Then
				VIEWGRID.SetGridCell ii, 1, Flag
			End If
		End Select

		If Trim(VIEWGRID.GetGridCell(ii, 1)) = 1 Then
			gcnt = gcnt + 1

			If gcnt > 9 Then
				Call VIEWGRID.SetGridCell(ii, 1, "0")
				mflag = 1
			End If
		End If
	Next

	If Flag = 1 And mflag = 1 Then
		MsgBox "일괄 주문은 최대 9건 까지만 가능합니다"
	End If

End Sub

'***************************************************************************
' DESC: 0보다큰 숫자형식인지 검사. 유효숫자( > 0):true else false
'***************************************************************************
Function Is_numeric(data)
	Dim number
	number = Trim(data)

	If number = "" Then
		number = 0
	End If

	Is_numeric = False
	If IsNumeric(number) = False Then
		Exit Function
	End If
	If CDbl(number) <= 0 Then
		Exit Function
	End If

	Is_numeric = True
End Function

'***************************************************************************
' DESC : Onalert()함수 : 주식평가금액, 주식평가손익, 주식수익률 계산
'***************************************************************************
Sub Onalert()
	Dim migm, tmigm, pggm, tpggm, pgsi, srat,ii,tmp

	tpggm = 0
	tmigm = 0

	For ii = 0 To VIEWGRID.Rows
		tmp = Trim(VIEWGRID.GetGridCell(ii, 2))
		VIEWGRID.SetGridCell ii,17,Mid(tmp,2)

		migm = VIEWGRID.GetGridCell(ii, 11)				'매입금액의 합
		If Is_numeric(migm) = False Then
		   If Trim(migm) = "" Then
		   migm =0
		   Else
			migm = CDbl(migm)
			End If
		End If
		tmigm = tmigm + migm

		pggm = VIEWGRID.GetGridCell(ii, 12)				'평가금액의 합
		If Is_numeric(pggm) = False Then
			If Trim(pggm) = "" Then
			pggm = 0
			Else
			pggm = CDbl(pggm)
			End If
		End If
		tpggm = tpggm + pggm
	Next

	o_migm.Data = tmigm									'매입금액의 합
	o_pggm.Data = tpggm									'평가금액의 합

	o_pgsi.Data = tpggm - tmigm							'평가손익
	If o_pgsi.Data > 0 Then
		o_pgsi.Data = "+" & o_pgsi.Data
	End If

	If tmigm =< 0 Then									'손익률
		srat = 0
	Else
		srat = CCur((tpggm - tmigm) / tmigm * 100)
	End If

	o_srat.Data = srat

	If srat > 0 Then
		o_srat.Data = "+" & FormatNumber(srat,2,,-2) '&"%"
	Else
		o_srat.Data = "-" & FormatNumber(srat,2,,-2) '&"%"
	End If

'	If srat > 0 Then
'		o_srat.Data = "+" & srat '&"%"
'	Else
'		o_srat.Data = srat
'	End If
End Sub

