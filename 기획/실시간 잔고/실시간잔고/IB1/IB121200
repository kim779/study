''*************************************************
''send ui data
''*************************************************
Sub f_vSendUiData()
	Dim accn, pass,tax,mmd, ctype

	SCREEN.OnSend False
	VIEWGRID.Clear

	If cbo_mmd.Index = 0 Then
		mmd = out_hts.data
	ElseIf cbo_mmd.Index = 1 Then
		mmd = out_call.data
	ElseIf cbo_mmd.Index = 2 Then
		mmd = out_ars.data
	End If

	' 기본값[9999] - 09/07/15
	If SYSTEM.ConnectBy = "0" And Trim(pswd.Data) = "" Then
	   pswd.Data = "9999"
	End If

		accn = Trim(AN1A.Data)						'계좌번호
		pass = Trim(pswd.Data)						'비밀번호
		tax = cbo_tax.data
		ctype = 0		' 신용 융자금 제외

		If Len(Trim(accn)) <> 11 Then
			Call guide_msg("계좌번호를 확인하여 주십시오.")
			AN1A.SetFocus
